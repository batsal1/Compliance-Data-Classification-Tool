    <skos:altLabel xml:lang="he-il">שפה עם התאמה למעשה בעבר</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भूत प्रथा के अनुरूप भाषा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過去の慣行に沿った言葉遣い</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Langage conforme aux pratiques passées</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sprachgebrauch in Übereinstimmung mit der Vergangenheit</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Linguagem consistente com a prática passada</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lenguaje Consistente con la Práctica Pasada</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Lenguaje Consistente con la Práctica Pasada</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">与过去惯例一致的语言</skos:altLabel>
    <skos:definition>A provision in a legal agreement that requires a party to act in accordance with their previous actions or behaviors.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVcQsyiR3zEN86uQG2Onsy"/>
    <rdfs:label>"Consistent with Past Practice" Language</rdfs:label>
  </rdf:Description>
