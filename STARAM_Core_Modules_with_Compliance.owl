    <skos:altLabel xml:lang="pt-br">Divulgação pública de divulgação de aquisição</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Divulgation publique des divulgations d'acquisition</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Divulgación pública de divulgación de adquisición</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Öffentliche Offenlegung von Übernahmeoffenlegungen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חשיפה ציבורית של חשיפת רכישה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Public Disclosure of Acquisition Disclosure</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Divulgación pública de divulgación de adquisición</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">收购披露的公开披露</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिग्रहण खुलासे का सार्वजनिक खुलासा</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t29mcCgDnprofEh5VP2LX"/>
    <rdfs:label>Public Disclosure of Acquisition Disclosure</rdfs:label>
  </rdf:Description>
