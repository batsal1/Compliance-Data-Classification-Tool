  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCzQzQSPRAB9cLkvDtBJFn">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q"/>
    <skos:definition>Water rights are legal entitlements allowing the holder to use water from a particular source (like a river, stream, or underground source). The allocation and usage of water rights can be complex and are often based on historic use, need, and regional laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Water Rights</rdfs:label>
  </rdf:Description>
