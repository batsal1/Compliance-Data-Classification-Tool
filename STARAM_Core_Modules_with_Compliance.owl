  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9KEQLcA3UHtoapzG52lsNf">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Signatory</rdfs:label>
    <skos:definition>A signatory is an individual or entity that has the authority to sign a legal document, such as a contract or agreement, thereby committing to its terms. The act of signing typically signifies consent, approval, or acceptance of the document's conditions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
