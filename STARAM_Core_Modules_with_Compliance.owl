  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8KfFbgcTnhwv1NgFFh92gR">
    <rdfs:label>Carveout for Pandemic Response Language</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3bU74bKrSAyu2rkZ4SZEa"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVcQsyiR3zEN86uQG2Onsy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Exclusión para el Lenguaje de Respuesta a la Pandemia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Carveout for Pandemic Response Language</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'exclusion pour la langue de réponse à la pandémie</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Exceção para a Linguagem de Resposta à Pandemia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पैंडेमिक प्रतिक्रिया भाषा के लिए कार्वआउट</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">パンデミック対応言語の除外条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ausnahme für Pandemieantwortsprache</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">应对流行病语言的例外条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Exclusión para el Lenguaje de Respuesta a la Pandemia</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיצול לשפת תגובה למגפה</skos:altLabel>
    <skos:definition>A carveout for pandemic response language is a provision in a legal agreement that exempts certain obligations or requirements during a pandemic or other public health emergency.</skos:definition>
  </rdf:Description>
