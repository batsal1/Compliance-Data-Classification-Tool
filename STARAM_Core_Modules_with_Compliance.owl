  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC3ERbtKTQuCOsKzB4vUuGm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Regulatory Drafting Practice</rdfs:label>
    <skos:definition>Regulatory Drafting Practice pertains to the specialized process and techniques used to draft rules, regulations, and other official directives issued by regulatory bodies or government agencies. This practice ensures clarity, precision, and legal soundness, while also taking into consideration the policy objectives, compliance challenges, and potential implications for stakeholders</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBAslwjHggAEqEvEC7C8oWJ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDlzJI9mdSvHCyKvBrBOFmp"/>
    <rdfs:subClassOf rdf:nodeID="Ncf9666c46fef4d9e98d0ec6fceb03019"/>
    <skos:altLabel>Regulatory Drafting Service</skos:altLabel>
    <skos:altLabel>Regulatory Drafting</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R89SrB48CRVi2-NK5Evo5tw">
    <rdfs:label>C200 Researching Law</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxX1kaW2JSgeTr8ALPGia2g"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This phase includes all legal research tasks, including internal meetings and consultations with those with special expertise, and computer and on-line research.</skos:definition>
    <skos:prefLabel>C200 Researching Law</skos:prefLabel>
  </rdf:Description>
