  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rk1NNOUpV48T2rXcSuEhJk">
    <skos:altLabel>Synthetic Media Claim</skos:altLabel>
    <skos:altLabel>AI Manipulation Claim</skos:altLabel>
    <skos:definition>A Deepfake Claim refers to a legal assertion involving the use of deepfake technology, which employs artificial intelligence to create or alter video and audio recordings to make them appear real. These claims often arise in the context of defamation, privacy violations, or copyright infringement, as deepfakes can be used to spread false information or unauthorized content.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N410d16b7e75a4517ad9699a8e0746481"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97wNmfHJzkvHQmFjV3GnLo"/>
    <skos:prefLabel>Digital Forgery Claim</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Deepfake Claim</rdfs:label>
  </rdf:Description>
