    <skos:altLabel xml:lang="hi-in">सामान के लीज से लेसी की अवधारणा के अनुरूप व्यवहार</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N5638f5055bd947d595613cfdea3e42e1"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdfs:subClassOf rdf:nodeID="Na335404f71094158b097f4756b10baee"/>
    <rdfs:subClassOf rdf:nodeID="N1a694db9bb6e4a599c51b2f915cd7f43"/>
    <rdfs:label>Lessee’s Default on Lease of Goods</rdfs:label>
    <skos:definition>The Lessee's Default on Lease of Goods refers to the situation where the lessee fails to fulfill their obligations under a lease agreement for goods, resulting in a breach of contract and potential legal action by the lessor or creditor.</skos:definition>
  </rdf:Description>
