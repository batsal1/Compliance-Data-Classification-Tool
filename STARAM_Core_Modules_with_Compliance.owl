  <rdf:Description rdf:about="https://folio.openlegalstandard.org/50Hs2QBS3KQkNd48DLU5g">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsWDLg5JUKHPw6my6QzmoU"/>
    <rdfs:subClassOf rdf:nodeID="N50da54e29c714638ab7fbd3f939f5b1d"/>
    <skos:definition>Risk tolerance is the degree of legal, financial, operational, or strategic uncertainty that a person or organization is willing to accept when choosing among available courses of action. It expresses the decision-maker's acceptable level of potential loss, liability, volatility, or adverse outcome in light of the decision-maker's objectives, duties, and constraints.</skos:definition>
    <skos:altLabel>Risk Acceptance Threshold</skos:altLabel>
    <skos:altLabel>Risk Acceptance Level</skos:altLabel>
    <skos:altLabel>Risk Appetite</skos:altLabel>
    <skos:altLabel>Risk Threshold</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Risk Tolerance</rdfs:label>
  </rdf:Description>
