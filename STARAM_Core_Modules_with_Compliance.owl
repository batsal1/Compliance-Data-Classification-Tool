    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rhpdjd9p358e9Rkel80dvQ"/>
    <skos:definition>A Collective Bargaining Agreement (CBA) is a legally binding contract negotiated between a labor union or employee association and an employer or group of employers. It outlines the terms and conditions of employment for the represented workers, covering aspects such as wages, working hours, benefits, workplace conditions, and dispute resolution procedures.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Collective Bargaining Agreement</rdfs:label>
  </rdf:Description>
