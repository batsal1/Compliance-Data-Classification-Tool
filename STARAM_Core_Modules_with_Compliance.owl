    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDp8cEr3KYyVDenm1P9ejdx"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RkW2gxg1HbGOAANvNTgOzp"/>
    <skos:altLabel xml:lang="hi-in">विशेष अधिकार बेचने के लिए सूची बनाने पर आयोग के लिए कार्रवाई</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ação para a Comissão sobre o direito exclusivo de vender listagens</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Action pour la Commission sur le droit exclusif de vendre des listes</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acción para la Comisión de Derecho Exclusivo de Venta de Listado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Action for Commission on Exclusive Right to Sell Listing</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Maßnahme für die Kommission für das ausschließliche Recht auf Verkaufslisten</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולה עבור הוועדה לזכויות בלעדיות למכירת רשימות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">独家销售清单委员会行动</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acción para la Comisión de Derecho Exclusivo de Venta de Listado</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独占的な販売リストに関する委員会の行動</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A legal claim made by a real estate agent or broker against another agent or broker for the exclusive right to sell a property.</skos:definition>
    <rdfs:label>Action for Commission on Exclusive Right to Sell Listing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/9YeAzv58Qbi4VyO2LgtwtQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=927110"/>
    <skos:definition>This industry comprises government establishments primarily engaged in the administration and operations of space flights, space research, and space exploration. Included in this industry are government establishments operating space flight centers.</skos:definition>
    <rdfs:label>Space Research and Technology</rdfs:label>
