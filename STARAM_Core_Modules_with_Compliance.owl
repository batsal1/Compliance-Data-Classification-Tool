  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9aAEcjxio3H54TB170xMqm">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlZdd14uUrCvqa8YJ7RzNd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Human Authorship</rdfs:label>
    <skos:definition>Human Authorship in copyright law refers to the requirement that a work must be created by a human individual to be eligible for copyright protection. This criterion emphasizes the human intellect and creativity as the fundamental source of copyrightable material, excluding works created by automated processes or non-human entities.</skos:definition>
  </rdf:Description>
