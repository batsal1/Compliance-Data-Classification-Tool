    <skos:altLabel xml:lang="hi-in">जालसाज़ी</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Forgery</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">偽造</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falsificación</skos:altLabel>
