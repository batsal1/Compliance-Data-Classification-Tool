    <skos:altLabel xml:lang="es-es">Cláusula de Ley y Jurisdicción Gobernante</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Governing Law and Jurisdiction Clause</skos:altLabel>
    <skos:definition>A Governing Law and Jurisdiction Clause is a provision in a legal document that specifies the law that will govern the agreement and the jurisdiction where any disputes will be resolved.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Governing Law and Jurisdiction Clause</rdfs:label>
