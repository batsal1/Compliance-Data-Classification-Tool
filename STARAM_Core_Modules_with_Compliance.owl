    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"This is not an actual segment of the file, per se, like the rest of the segments listed above.  This segment contains a list of fields that will be used to represent contact information.  When a contact is requested in a segment, that element will be listed and all fields in this segment will be the children of that element.  

The EXTEND_HEADER segment was purposely omitted from this segment.
"</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3hDYvR4ffxmqJg2F8YGT6"/>
    <rdfs:label>contact_info segment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rwx570qxTQ5CBkQ6RjfCjFA">
