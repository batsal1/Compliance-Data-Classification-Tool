  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9XQBfujFslMMKIqHWCknld">
    <skos:altLabel xml:lang="hi-in">खरीदार सहमति आवश्यकता केवल निर्दिष्ट नकारात्मक अधिबंधों के लिए लागू होती है</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">El requisito de consentimiento del comprador se aplica solo a convenios negativos especificados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">L'exigence de consentement de l'acheteur ne s'applique qu'aux engagements négatifs spécifiés</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Requisito de consentimento do comprador se aplica apenas a determinadas obrigações negativas especificadas</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דרישת ההסכמה של הקונה חלה רק על הבטחונות השליליים המסוימים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Käufer-Zustimmungsanforderung gilt nur für bestimmte negative Verpflichtungen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">买方同意要求仅适用于指定的负面契约</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Buyer Consent Requirement Applies Only to Specified Negative Covenants</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">買手の同意要件は特定の否定的契約にのみ適用されます</skos:altLabel>
    <skos:altLabel xml:lang="es-es">El requisito de consentimiento del comprador se aplica solo a convenios negativos especificados</skos:altLabel>
    <rdfs:label>Buyer Consent Requirement Applies Only to Specified Negative Covenants</rdfs:label>
    <skos:definition>A provision in a contract that requires the buyer's approval only for certain restrictions on the property, rather than all restrictions, as specified in the agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9xgvrUWmxGlvR7ooOgWvo7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7oJAhnRY9sc5jyWHuJDcsJ">
    <skos:altLabel xml:lang="en-gb">Non-fundamental Representations and Warranties</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representações e garantias não fundamentais</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गैर-मौलिक प्रतिनिधित्व और वारंटी</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非基本陈述和保证</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Representaciones y garantías no fundamentales</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nicht wesentliche Darstellungen und Gewährleistungen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representaciones y garantías no fundamentales</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Représentations et garanties non fondamentales</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">非基本的表明および保証</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצהרות ואזרויות לא-יסודיות</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCV40j08zvRl2faFV72w9aQ"/>
    <rdfs:label>Non-fundamental Representations and Warranties</rdfs:label>
    <skos:definition>Non-fundamental representations and warranties are the less essential or non-core statements made by a party in a contract, typically pertaining to the condition of a business, assets, or the accuracy of certain information. While important, these representations and warranties are generally considered less critical to the overall transaction than fundamental representations and warranties, which relate to crucial aspects such as the seller's ownership, authority, and the validity of the contract itself.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
