  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Litigation Criminal Defenses</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Litigation Criminal Defenses</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विधिक दलों की अपराधिक रक्षा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défenses pénales en litige</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Strafverteidigung in Gerichtsverfahren</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">刑事訴訟の弁護</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגנות פליליות בליטיגציה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Defensas Penales en Litigios</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Defensas Penales en Litigios</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">刑事诉讼辩护</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Defesas criminais em litígios</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7vJPxcT40MjEfNZkBK1tKH"/>
    <skos:definition>A criminal defense used in a legal proceeding to protect an individual accused of a crime from prosecution or punishment, specifically in the context of litigation.</skos:definition>
  </rdf:Description>
