  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Gb3dVBy5POvEQPuNpy0A9">
    <rdfs:label>Senior Credit Ranking</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Senior Debt Ranking</skos:altLabel>
    <skos:definition>Senior Credit Ranking refers to the priority status of senior debts, which are ranked above senior subordinated, junior, and junior subordinated debts in the event of liquidation. This ranking ensures that senior creditors are paid first from the proceeds of the liquidated assets, providing them with a higher level of security and reducing their risk exposure.</skos:definition>
    <skos:prefLabel>Senior Debt Priority</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
  </rdf:Description>
