  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBSyY8hOhTJFVVp812YuMel">
    <skos:definition>An ethics claim is a formal allegation that an individual or organization has violated ethical standards or principles within a specific profession or field. These claims can arise in various contexts, such as legal ethics, medical ethics, or government ethics, and often lead to investigations and disciplinary actions.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N5a49004bd5044dc2b9c664411531a082"/>
    <rdfs:subClassOf rdf:nodeID="N9ebb73ed62264b12891197615e203173"/>
