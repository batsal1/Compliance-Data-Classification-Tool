  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8GXZxWsugTGgVmMyhrFO20">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB5tNYSDrxEoYAqZ3sy0rae"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Employment-Based Immigration Request</rdfs:label>
    <skos:definition>An Employment-Based Immigration Request is a type of immigration application in which an individual seeks entry or residency in a destination country based on a job offer or employment opportunity. The sponsoring employer usually files petitions and necessary documents on behalf of the employee, and the process often involves labor certifications and other prerequisites to prove the employment need.</skos:definition>
  </rdf:Description>
