    <rdfs:label>Appellant</rdfs:label>
    <skos:definition>An appellant is a person, company or entity that applies to a higher court for a reversal of the decision of a lower court.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
