  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8zIooy4NyqKStWR91EK91P">
    <rdfs:label>Right of Integrity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Right of Integrity, a key aspect of moral rights in copyright law, allows the creator to object to any modification of their work that could harm their reputation or honor. This right protects the personal connection between the creator and their work, ensuring that their artistic vision remains unaltered without their consent.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ICeOg6A95qwBlvRoew3Br"/>
  </rdf:Description>
