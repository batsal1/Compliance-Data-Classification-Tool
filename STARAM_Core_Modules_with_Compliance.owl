    <skos:altLabel xml:lang="de-de">Mietverträge für Immobilien</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Baux immobiliers</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रियल प्रॉपर्टी लीज़</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Arrendamientos de bienes raíces</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Arrendamientos de bienes inmuebles</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Real Property Leases</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Locações de imóveis</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不动产租赁</skos:altLabel>
