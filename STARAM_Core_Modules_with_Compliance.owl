  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RnhiP8VAnxlbxEca8ffZln">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
    <skos:altLabel xml:lang="ja-jp">明確かつ説得力のある証拠</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klare und überzeugende Beweise</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Prueba clara y convincente</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्पष्ट और प्रभावशाली साक्ष्य</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Preuve claire et convaincante</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Clear and Convincing Evidence</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ראיות ברורות ומשכנעות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">明确有力的证据</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prova clara e convincente</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Prueba clara y convincente</skos:altLabel>
    <skos:definition>Clear and Convincing Evidence is a standard of proof that requires evidence to be highly and substantially more probable to be true than not, and leaves no serious or substantial doubt in the mind of the factfinder.</skos:definition>
    <rdfs:label>Clear and Convincing Evidence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/REuZBD25lQC59CdA7Zp3KN">
    <skos:definition>Derivative Work in copyright law refers to a new creation that includes or is based on a pre-existing work, such as translations, adaptations, or transformations. This concept requires that derivative works must add originality beyond the original work to qualify for copyright protection.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7mMPoEuA9Ja4rODr1LGXcR"/>
    <rdfs:label>Derivative Work</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8avLLi0FIwwE86oa8rEeN5">
    <skos:altLabel xml:lang="ja-jp">特別管轄権</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विशिष्ट अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción Específica</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jurisdição específica</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Jurisdicción Específica</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סמכויות מסוימות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juridiction spécifique</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Besondere Gerichtsbarkeit</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Specific Jurisdiction</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">特定管辖权</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Specific Jurisdiction refers to the authority of a court to hear and decide a case involving a defendant who has minimum contacts with the forum state, but only with respect to the specific claims at issue in the case.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RinqHf65TtUhr762WKqN6R"/>
    <rdfs:label>Specific Jurisdiction</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/TvwWH-LhTdWKOOiYZkZJNQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=492210"/>
    <rdfs:label>Local Messengers and Local Delivery</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in providing local messenger and delivery services of small items within a single metropolitan area or within an urban center. These establishments generally provide point-to-point pick-up and delivery and do not operate as part of an intercity courier network.</skos:definition>
    <skos:example>Letters, documents, or small parcels local delivery services</skos:example>
    <skos:example>Grocery delivery services (i.e., independent service from grocery store)</skos:example>
    <skos:example>Restaurant meals order and delivery services (i.e., independent order and delivery services)</skos:example>
    <skos:example>Alcoholic beverages delivery services</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/rL76OmlVTRquklsstlOlHg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQcRw3hlSYfKCU8zKKQ9R0">
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Proc-B-USCHAP12</ns2:legacyIdentifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdfs:subClassOf rdf:nodeID="N5ac3a1068f4e4c058cb38754fd547f73"/>
