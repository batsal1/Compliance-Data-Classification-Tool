    <skos:altLabel xml:lang="fr-fr">Licenciement répressif</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Rescisão retaliatória</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Retaliatory Termination</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रतिशोधात्मक समाप्ति</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">报复性解雇</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vergeltungskündigung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Terminación retaliatoria</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Terminación retaliatoria</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7irtksGAUxreU1oxQJBon8"/>
    <skos:definition>The act of firing an employee in response to their protected activity, such as reporting discrimination or harassment, or participating in a legal investigation or proceeding.</skos:definition>
