    <skos:altLabel xml:lang="fr-fr">Privilège de confidentialité des informateurs</skos:altLabel>
    <skos:definition>The Confidential Informant Privilege is a legal protection that allows individuals who provide information to law enforcement agencies to remain anonymous and keep their identities confidential.</skos:definition>
    <rdfs:label>Confidential Informant Privilege</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
  </rdf:Description>
