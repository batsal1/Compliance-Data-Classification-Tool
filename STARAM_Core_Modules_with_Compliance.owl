  <rdf:Description rdf:about="https://folio.openlegalstandard.org/L8obp7ggQYiujie0LjDJPA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=211130"/>
    <rdfs:label>Natural Gas Extraction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/QIIpu0kORxysab4UkuBBuw"/>
    <skos:definition>This industry comprises establishments primarily engaged in (1) the exploration, development, and/or the production of natural gas from wells in which the hydrocarbons will initially flow or can be produced using normal or enhanced drilling and extraction techniques or (2) the recovery of liquid hydrocarbons from oil and gas field gases. Establishments primarily engaged in sulfur recovery from natural gas are included in this industry.</skos:definition>
  </rdf:Description>
