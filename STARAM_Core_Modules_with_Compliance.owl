  <rdf:Description rdf:about="https://folio.openlegalstandard.org/T3L_rvXVTVqvaXB0P70vmA">
    <skos:example>Professional sports instructors (i.e., not participating in sporting events)</skos:example>
    <skos:example>Martial arts instruction, camps or schools</skos:example>
    <skos:example>Gymnastics instruction</skos:example>
    <skos:example>Camps, sports instruction</skos:example>
    <skos:example>Swimming instruction</skos:example>
    <skos:example>Riding instruction academies or schools</skos:example>
    <skos:example>Cheerleading instruction</skos:example>
    <skos:example>Sports (e.g., baseball, basketball, football, golf) instruction</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/9nZAmdwhQ46kVlp9HQ_uaQ"/>
    <rdfs:label>Sports and Recreation Instruction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments, such as camps and schools, primarily engaged in offering instruction in athletic activities. Overnight and day sports instruction camps are included in this industry.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=611620"/>
  </rdf:Description>
