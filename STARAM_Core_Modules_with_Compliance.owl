    <skos:altLabel xml:lang="es-es">Registro de Patente de Utilidad</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">实用新型专利注册</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Registro de Patente de Utilidad</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Registro de patente de utilidade</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यूटिलिटी पेटेंट पंजीकरण</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Enregistrement d'un brevet d'utilité</skos:altLabel>
