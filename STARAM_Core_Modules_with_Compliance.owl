  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCZdG7bztfQT8BuzFadwgir">
    <rdfs:label>Opacity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
    <skos:definition>Opacity in an AI system refers to the condition where one or more features, such as processes, the provenance of datasets, functions, output, or behavior, are unavailable or incomprehensible to all stakeholders. Opacity is usually considered an antonym for transparency and can hinder understanding, trust, and accountability in AI systems.</skos:definition>
  </rdf:Description>
