    <rdfs:label xml:lang="en">Annexed Material</rdfs:label>
    <rdfs:comment xml:lang="en">Material appended to a legislative text rather than forming part of its running body.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RKj3panTdxsJ7nFn11CPGT">
    <skos:altLabel xml:lang="fr-fr">Réclamation de 8ème amendement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">第八修正案索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על התיקון השמיני</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da 8ª Emenda</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">8वीं संशोधन दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">8. Änderungsantrag Anspruch</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">8th Amendment Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Octava Enmienda</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Octava Enmienda</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">第8修正案の主張</skos:altLabel>
    <skos:altLabel>Eighth Amendment Claim</skos:altLabel>
    <skos:definition>An Eighth Amendment claim is a legal argument asserting that an individual's constitutional protection against cruel and unusual punishment, as guaranteed by the Eighth Amendment of the United States Constitution, has been violated. Such claims typically involve disputes over the conditions of confinement, the use of excessive force, or the imposition of excessive fines or bail, and aim to protect the basic human rights and dignity of individuals subject to punishment or detention.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>8th Amendment Claim</rdfs:label>
    <skos:prefLabel>Eighth Amendment Claim</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDZD8z35laaMMzT4c2ImnT4">
    <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
    <skos:altLabel>Organizational Transformation Risk</skos:altLabel>
    <skos:definition>The threats and opportunities associated with significant structural or behavioral change within an organization related to mandate, operating context, leadership, and strategic direction.</skos:definition>
    <skos:definition>Change Management Risk refers to the potential for negative outcomes or disruptions when an organization undergoes transformations, such as implementing new processes, technology, or organizational structures. These risks may arise from poor planning, ineffective communication, resistance to change, or inadequate training, ultimately impacting employee morale, productivity, and the overall success of the change initiative</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
    <rdfs:label>Change Management Risk</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/buG6U9NbTpOlfyvNR7_7-g">
    <skos:example>General purpose-type sieves and screening equipment manufacturing</skos:example>
    <skos:example>Cremating ovens manufacturing</skos:example>
    <skos:example>Hydraulic and pneumatic jacks manufacturing</skos:example>
    <skos:example>Bridge and gate lifting machinery manufacturing</skos:example>
    <skos:example>Industrial and general purpose-type filters (except internal combustion engine, warm air furnace) manufacturing</skos:example>
    <skos:example>Automatic fire sprinkler systems manufacturing</skos:example>
    <skos:example>Centrifuges, industrial and laboratory-type, manufacturing</skos:example>
    <skos:example>Baling machinery (e.g., paper, scrap metal) manufacturing</skos:example>
    <skos:example>Scales and balances manufacturing</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing general purpose machinery (except ventilating, heating, air-conditioning, and commercial refrigeration equipment; metalworking machinery; engines, turbines, and power transmission equipment; pumps and compressors; material handling equipment; power-driven handtools; welding and soldering equipment; packaging machinery; industrial process furnaces and ovens; fluid power cylinders and actuators; and fluid power pumps and motors).</skos:definition>
    <rdfs:label>All Other Miscellaneous General Purpose Machinery Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/z92pj9hTTd2-Vgl3rH8XfQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333998"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RN4GuH3ZCW5jNVC1pl3kSs">
