    <rdfs:label>Governmental Law Division</rdfs:label>
    <skos:definition>A Governmental Law Division is a legal entity within a government, responsible for providing legal services to government agencies, officials, and the public. It ensures legal compliance, represents the government in legal matters, and offers legal advice on policy and administrative issues.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Government Legal Department</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ra12OYzEcXANwkxxmK1q23">
    <skos:altLabel xml:lang="pt-br">Exposição negligente de outra pessoa a doenças ou substâncias tóxicas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रोग या विषाक्त पदार्थों के अन्य के लिए लापरवाहीपूर्ण अनावरण</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חשיפה של עודף למחלות או חומרים רעילים באופן שלא נאמן</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Exposure of Another to Disease or Toxic Substances</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Exposición negligente de otra persona a enfermedades o sustancias tóxicas</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Exposición negligente de otra persona a enfermedades o sustancias tóxicas</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exposition négligente d'une autre personne à des maladies ou substances toxiques</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">对他人的疾病或有毒物质的疏忽暴露</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">他者への病気や有害物質の過失による露出</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Exposition eines anderen gegenüber Krankheiten oder toxischen Substanzen</skos:altLabel>
    <skos:definition>Negligent Exposure of Another to Disease or Toxic Substances: The failure to exercise reasonable care in preventing the exposure of another person to a disease or toxic substance, resulting in harm or injury to that person.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdfs:label>Negligent Exposure of Another to Disease or Toxic Substances</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
