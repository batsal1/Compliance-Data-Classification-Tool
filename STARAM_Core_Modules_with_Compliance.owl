    <skos:altLabel xml:lang="hi-in">स्थान चयन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de choix de juridiction</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Choice of Venue Clause is a provision in a contract that specifies the location or jurisdiction where any disputes arising from the contract will be resolved.</skos:definition>
    <rdfs:label>Choice of Venue Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXDxuYOR20sbhobsDjIlcZ"/>
