    <skos:altLabel xml:lang="de-de">Konservator</skos:altLabel>
    <skos:altLabel xml:lang="he-il">משמר</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Conservador</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保存者</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Conservador</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Conservator</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Conservateur</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保护者</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संरक्षक</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Conservador</skos:altLabel>
    <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
    <skos:definition>A guardian, protector, or preserver - the modern equivalent of guardian. Collins v. Mnuchin, 938 F.3d 553 (5th Cir. 2019)</skos:definition>
    <rdfs:label>Conservator</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCConKYMn2K3j1lIh9I66QB">
    <skos:altLabel xml:lang="pt-br">Cláusula de violação material</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Incumplimiento Material</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">实质违约条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de violation substantielle</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Material Breach Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur wesentlichen Vertragsverletzung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Incumplimiento Material</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הפרת חוזה מהותית</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大違約条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामग्री उल्लंघन धारा</skos:altLabel>
    <skos:definition>A Material Breach Clause is a specific type of clause found in a contract that outlines the conditions under which a party's failure to perform a significant obligation will be considered a breach of the contract.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Material Breach Clause</rdfs:label>
