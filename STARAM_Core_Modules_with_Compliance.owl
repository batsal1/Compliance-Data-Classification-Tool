  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBsVewe5WXuB0ltZtb5Y5cN">
    <rdfs:label>E102 Outside printing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of E102 Outside printing refers to the expenses incurred for printing services that are outsourced to a third-party vendor, and is a subcategory of the broader concept of E100 Expenses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
  </rdf:Description>
