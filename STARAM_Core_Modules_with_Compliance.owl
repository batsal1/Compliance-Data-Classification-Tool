    <rdfs:subClassOf rdf:nodeID="Nec12b960aea94f8ba809446a9773b1f0"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <skos:prefLabel>Debt Recovery Claims</skos:prefLabel>
    <skos:definition>Debt Collection Claims refer to legal actions initiated by creditors to recover unpaid debts from borrowers. These claims encompass various legal grounds and causes of action used to pursue debt recovery through the courts.</skos:definition>
    <rdfs:label>Debt Collection Claims</rdfs:label>
    <skos:altLabel>Collection Claims</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/0d6929e9-6c5f-465b-a929-ba9f1a95995d7fbe891f-65ee-493f-bfb5-893efcef6caf">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/dee4c3fe-fb17-4e56-bed7-6ae3eb6acf96982b1ad5-5b20-40c6-852d-15348064436e"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Claim for Dishonor of Check</rdfs:label>
    <skos:definition>Payee can claim amount of dishonored check along with penalty and legal costs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8i5wsZqO6Iek2omJedateE">
    <rdfs:label>Process Mapping Management</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBPerly9Ql2EqjR3jCfB37"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Process Mapping Management refers to the systematic documentation, analysis, and improvement of legal processes in order to increase efficiency and effectiveness, and reduce costs and errors.</skos:definition>
  </rdf:Description>
