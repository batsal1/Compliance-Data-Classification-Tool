    <skos:altLabel xml:lang="hi-in">बच्चों की हुजूम के साथ दखल देना</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Subtração de Menor</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interference with the Custody of Children</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Soustraction de mineur</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת זכויות הורים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">児童の監護権に対する干渉</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kindesentziehung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia en la custodia de menores</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia en la custodia de los niños</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">干涉儿童监护权</skos:altLabel>
    <rdfs:label>Interference with the Custody of Children</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Interference with the Custody of Children" refers to the act of intentionally taking, withholding, or concealing a child from their legal guardian or custodian without permission, which is considered a crime against individuals under the law.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MbuFEaL6NyU9tM2AXk7lk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDbbUJ2GU3xWVdXFDTfVMPf">
    <skos:altLabel xml:lang="ja-jp">女性参政権要求</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo del sufragio femenino</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação do sufrágio feminino</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo del sufragio femenino</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת הזכות לבחירות של הנשים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Frauenwahlrecht</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Women's Suffrage Claim</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication du suffrage des femmes</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">महिला सुफ़्रेज़ का दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">妇女选举权要求</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBV7sRG5Rn12K0LqLOhxdRz"/>
    <rdfs:label>Women's Suffrage Claim</rdfs:label>
    <skos:definition>A Women's Suffrage claim is a legal assertion that a government has denied or restricted the right to vote to citizens on the basis of sex, effectively providing women the right to vote.</skos:definition>
  </rdf:Description>
