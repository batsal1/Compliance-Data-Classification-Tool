    <skos:altLabel xml:lang="pt-br">Análise de gestão de caixa</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Analysis of Cash Management</rdfs:label>
    <skos:definition>Analysis of Cash Management: A process of examining and evaluating the flow and use of cash within an organization, including the identification of areas for improvement and the development of strategies to optimize cash management.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9S2EhOfmkyvLAnWE5nnULo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD1f4iUneQLhtbc32uIpavm">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="ja-jp">残りのページは意図的に空白の条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף של דף שנותר ריק בכוונה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पृष्ठ के शेष भाग को इच्छापूर्वक रिक्त छोड़ा गया क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de página intencionalmente deixada em branco</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de página intencionalmente en blanco restante</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de página intencionalmente en blanco restante</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de la page intentionnellement laissée en blanc</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Absichtlichen Leerlassung des Rests der Seite</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">页面剩余部分故意留空条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Remainder of Page Intentionally Left Blank Clause</skos:altLabel>
    <skos:definition>A Remainder of Page Intentionally Left Blank Clause is a provision in a contract that indicates intentional blank space on a page and serves as evidence that no additional terms or provisions were intended to be added to the contract on that page.</skos:definition>
    <rdfs:label>Remainder of Page Intentionally Left Blank Clause</rdfs:label>
  </rdf:Description>
