    <skos:altLabel xml:lang="fr-fr">Promesse de faire un testament</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वसीयत बनाने का वादा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Promesa de hacer un testamento</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Promise to Make a Will</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">遺言作成の約束</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3SDQBy4KfjSgp3bgpb4Fx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Promise to Make a Will is a legal concept within Trust and Estate Claims that refers to a commitment made by one party to another to create a will in the future.</skos:definition>
  </rdf:Description>
