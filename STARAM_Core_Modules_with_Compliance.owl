    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDigDgTiLFmt7iX3436yCOT"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <skos:definition>Settlement and Demand Practice refers to the legal work performed in the course of a legal matter related to resolving disputes and negotiating settlements, including the drafting and sending of demand letters and the negotiation of settlement agreements, as well as collection of debts and judgments.</skos:definition>
    <skos:definition>Settlement and Demand Practice refers to the legal work performed in the course of a legal matter related to resolving disputes and negotiating settlements, including the drafting and sending of demand letters and the negotiation of settlement agreements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
