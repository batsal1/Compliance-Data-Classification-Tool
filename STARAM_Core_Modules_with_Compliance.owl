  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBEtSbHUfDI2kqG46oM2uBJ">
    <skos:altLabel xml:lang="en-gb">Good Faith Deposit Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Depósito de Buena Fe</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de dépôt de bonne foi</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de depósito de boa fé</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Depósito en Garantía</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הפקדת אמון טובה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Hinterlegung einer guten Glaubensleistung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अच्छी निष्ठा जमा क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">善意保証金条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">善意保证金条款</skos:altLabel>
    <skos:definition>A Good Faith Deposit Clause is a provision in a contract that requires one party to provide a deposit as a demonstration of good faith in fulfilling their obligations under the agreement.</skos:definition>
    <rdfs:label>Good Faith Deposit Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9n7zgPfjWgz6T9XnL0goDx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
