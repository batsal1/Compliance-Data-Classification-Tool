    <rdfs:label>Universal Life Insurance</rdfs:label>
    <skos:definition>Universal life insurance is a type of permanent life insurance that offers both a death benefit and a cash value component, similar to whole life insurance. However, it differs in its flexibility, allowing policyholders to adjust the premiums and death benefit within certain limits, and it often has an investment element where the cash value can be invested for potential growth.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
