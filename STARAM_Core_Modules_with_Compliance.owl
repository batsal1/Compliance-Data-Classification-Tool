  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCzYNAC22dds0d4cDTCJCzl">
    <skos:prefLabel>Unsecured</skos:prefLabel>
    <skos:prefLabel>Non-Collateralized Credit Arrangement</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="N171c264d6bd74731a9ce40d9d4d29f90"/>
    <rdfs:subClassOf rdf:nodeID="N7ebbd376c52b4eccb17722c799133398"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
    <rdfs:label>Unsecured Credit Arrangement</rdfs:label>
    <skos:definition>An Unsecured Credit Arrangement is a financial agreement where the borrower does not pledge any assets as collateral for the loan. This type of loan relies on the borrower's creditworthiness and often results in higher interest rates and stricter borrowing terms due to the increased risk for the lender.</skos:definition>
    <skos:altLabel>Unsecured Financing Arrangement</skos:altLabel>
    <skos:altLabel>Unbacked Credit</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
