  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RtVEoiPl048ZfSUppj1Cy2">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOQpX5t5sVf55UPK2CfZTy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bonded Labor Claim</rdfs:label>
    <skos:definition>A bonded labor claim alleges that an individual is forced to work under a debt or other obligation that they cannot repay and that limits their freedom. This practice is a form of modern-day slavery and is illegal under international law and in many national jurisdictions.</skos:definition>
  </rdf:Description>
