  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8iaSMweBcBegYYI9g2byVW">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <skos:prefLabel>Hereditary-Restricted Property Ownership</skos:prefLabel>
    <skos:definition>A Fee Tail Estate is a form of property ownership in which land is granted to an individual and the heirs of their body, limiting inheritance to direct descendants and preventing the property from being sold or transferred outside the family line. This archaic legal concept was designed to keep estates within families for generations.</skos:definition>
    <rdfs:label>Fee Tail Estate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N43a6b67df79148bf92f482dd71fd4de8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermUnrestrictedSubsidiary"/>
  </rdf:Description>
