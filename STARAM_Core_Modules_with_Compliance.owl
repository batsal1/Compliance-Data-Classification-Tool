  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBULKQI6L28MSLKVkiNU7uo">
    <skos:altLabel xml:lang="ja-jp">ファウルボール責任請求</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת אחריות כדור עקום</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftungsanspruch bei Foul Ball</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de responsabilidad por bola mala</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de responsabilidade por bola suja</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Foul Ball Liability Claim</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de responsabilité pour balle fautive</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de responsabilidad por bola sucia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">犯规球责任索赔</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फौल बॉल लाभांश दावा</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdfs:label>Foul Ball Liability Claim</rdfs:label>
    <skos:definition>A foul ball liability claim is a legal claim for damages resulting from a personal injury caused by a foul ball at a sporting event.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC7iFPOfl3KJh6mavLqVZd7">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ODLnhxFt38FQNV4BUbRSD"/>
    <rdfs:subClassOf rdf:nodeID="Nc3857fcbecb642c980522fa9e482aeaf"/>
    <skos:altLabel>Customs Control Objective</skos:altLabel>
    <skos:altLabel>Immigration Control Objective</skos:altLabel>
    <skos:altLabel>Border Management Objective</skos:altLabel>
    <rdfs:label>Border Control Objective</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Border Control refers to the measures and regulations implemented by a country to monitor and regulate the movement of people, goods, and animals across its borders. It involves immigration enforcement, customs checks, and security protocols to prevent illegal entry, smuggling, and other border-related offenses.</skos:definition>
  </rdf:Description>
