    <skos:altLabel xml:lang="hi-in">नवीनीकरण विकल्पों के लिए किरायेदार न्यायमूलक सहायता</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Recours équitable du locataire pour les options de renouvellement</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Tenant Equitable Relief for Renewal Options</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indenização equitativa do locatário para opções de renovação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租户因续约选择获得公平补偿</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Alivio Equitativo del Inquilino para Opciones de Renovación</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סיוע הוגן לשוכר לאפשרויות חידוש</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">更新オプションに対するテナントの公正な救済</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Mietergerechte Entschädigung für Verlängerungsoptionen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Alivio Equitativo del Arrendatario para Opciones de Renovación</skos:altLabel>
    <rdfs:label>Tenant Equitable Relief for Renewal Options</rdfs:label>
    <skos:definition>Tenant Equitable Relief for Renewal Options: A legal claim made by a tenant seeking a court order to enforce a renewal option in a lease agreement, based on principles of fairness and justice.</skos:definition>
  </rdf:Description>
