  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R823glDLgYxwmTy40ur3kxA">
    <skos:prefLabel>Illegal Hunting</skos:prefLabel>
    <skos:altLabel>Unauthorized Hunting</skos:altLabel>
    <skos:altLabel>Illegal Wildlife Harvesting</skos:altLabel>
    <skos:altLabel>Unauthorized Wildlife Harvesting</skos:altLabel>
    <skos:definition>Poaching is the illegal hunting, capturing, or killing of wildlife, often in violation of local, national, or international conservation laws. This activity typically targets endangered or protected species for their meat, fur, or body parts.</skos:definition>
    <rdfs:label>Poaching</rdfs:label>
