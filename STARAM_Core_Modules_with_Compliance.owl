    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Signature Page Clause</rdfs:label>
    <skos:definition>A Signature Page Clause is a specific type of clause found within a contractual agreement that outlines the location and manner in which the parties involved will sign the document.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
