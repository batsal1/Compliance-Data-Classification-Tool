  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Em9KDDX1TzOfQWiI0_AlwQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) surface mining of bituminous coal, lignite, and anthracite coal; (2) developing bituminous coal, lignite, and anthracite coal surface mine sites; (3) surface mining and beneficiating (e.g., cleaning, washing, screening, and sizing) of bituminous coal, lignite, and anthracite coal; or (4) beneficiating (e.g., cleaning, washing, screening, and sizing), but not mining, bituminous coal, lignite, and anthracite coal.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=212114"/>
    <rdfs:label>Surface Coal Mining</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/DdTcr0IXSRq1sIEeV1eXNg"/>
  </rdf:Description>
