  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7NPSSODp2sRYDRSQ2hvF3b">
    <skos:altLabel xml:lang="en-gb">Breach of Warranty</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保証違反</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de garantie</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वारंटी का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת אחריות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保证违约</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de garantia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der Gewährleistung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de garantía</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de garantía</skos:altLabel>
    <skos:altLabel>Warranty Claims</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nfb6eb925af2b427dbe56c664eaa35209"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <skos:definition>Breach of Warranty refers to a legal claim made by a party against another party for failing to fulfill the terms of a warranty, either express or implied, related to a product or service.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Breach of Warranty</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/LpsUnBsfTt2F6SCN_RK1jQ">
    <skos:example>Green bean farming</skos:example>
    <skos:example>Watermelon farming</skos:example>
    <skos:example>Melon farming (e.g., cantaloupe, casaba, honeydew, watermelon)</skos:example>
    <skos:example>Pepper farming (e.g., bell, chili, green, red, sweet peppers)</skos:example>
    <skos:example>Vegetable (except potato) farming</skos:example>
    <skos:example>Squash farming</skos:example>
    <skos:example>Carrot farming</skos:example>
    <skos:example>Tomato farming</skos:example>
    <rdfs:label>Other Vegetable (except Potato) and Melon Farming</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) growing melons and/or vegetables (except potatoes; dry peas; dry beans; field, silage, or seed corn; and sugar beets); (2) producing vegetable and/or melon seeds; and (3) growing vegetable and/or melon bedding plants.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=111219"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/meUnRFxmSLy56fcs2FlPxA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
