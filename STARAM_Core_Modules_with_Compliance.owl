    <skos:example>Enameled iron and metal sanitary ware manufacturing</skos:example>
    <skos:example>Foil containers (except bags) manufacturing</skos:example>
    <skos:example>Fabricated pipe and pipe fittings made from purchased metal pipe</skos:example>
