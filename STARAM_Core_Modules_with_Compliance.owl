    <ns2:legacyIdentifier>http://lmss.sali.org/RBXB8p1FPkxWNG8PG77UuRr</ns2:legacyIdentifier>
    <skos:definition>An out-of-court restructuring or workout is a nonjudicial process through which a financially troubled company and its significant creditors reach an agreement for adjusting the company's obligations.</skos:definition>
  </rdf:Description>
