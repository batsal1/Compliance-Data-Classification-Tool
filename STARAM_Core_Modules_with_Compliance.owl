    <rdfs:label>Buyer's Jurisdiction</rdfs:label>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
    <skos:definition>The Buyer's Jurisdiction refers to the legal authority or geographic location in which a company or individual purchasing another company has the power to enforce their rights and obligations related to the acquisition.</skos:definition>
  </rdf:Description>
