    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQZfWGxOZnZAvQ3ghLRvae"/>
    <rdfs:label>Shoplifting Theft</rdfs:label>
    <skos:altLabel xml:lang="pt-br">Furto em lojas</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ladendiebstahl</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Hurto en tiendas</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Robo en tiendas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शॉपलिफ्टिंग चोरी</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Vol à l'étalage</skos:altLabel>
    <skos:altLabel xml:lang="he-il">גניבת חנויות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">万引き</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Shoplifting Theft</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商店行窃</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The theft, by someone other than an employee of the victim, of goods or merchandise exposed for sale.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/cuUymJQcQaSHwgqA3GiBIg">
    <rdfs:label>Language Schools</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in offering foreign language instruction (including sign language). These establishments are designed to offer language instruction ranging from conversational skills for personal enrichment to intensive training courses for career or educational opportunities.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=611630"/>
