    <rdfs:label>Standstill Provision Clause</rdfs:label>
    <skos:definition>A Standstill Provision Clause is a contractual clause that temporarily suspends legal action or obligations between parties, often used in the context of mergers and acquisitions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/3scvMZ_HTTiwTo7ZenrSdA">
