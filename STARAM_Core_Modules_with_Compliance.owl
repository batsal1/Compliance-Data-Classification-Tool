  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Eq21fpzUIBqpXfAaS2Xbo">
    <skos:altLabel xml:lang="fr-fr">Représentation frauduleuse</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">欺诈性陈述</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betrügerische Falschdarstellung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representação fraudulenta</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不正確な表示</skos:altLabel>
    <rdfs:label>Fraudulent Misrepresentation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRC3CmU6w2he0zPcqr6J7p"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7JKVOM2aFkvG1yiLzF7ndA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Fraudulent Misrepresentation is a type of misrepresentation where one party intentionally makes a false statement to another party, with the intention of inducing them to enter into a contract or take some other action, and the other party relies on that false statement to their detriment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCwBGQNvK9xlDeKYVj9mQoo">
    <skos:definition>End-to-end CLM Management refers to the comprehensive management of the entire contract lifecycle, from creation to execution and beyond, within the context of Contract Management.</skos:definition>
