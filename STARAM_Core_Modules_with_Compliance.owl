  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBc09F49xi1kJWJxboFxFhg">
    <skos:altLabel xml:lang="pt-br">Responsabilidade da cidade</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות העיר</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">城市责任</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad de la ciudad</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad de la ciudad</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शहर की दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">市の責任</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité de la ville</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Stadtverantwortlichkeit</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">City Liability</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>City Liability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlgFAjqizwHVxH4GdLhb1J"/>
    <skos:definition>City Liability refers to the legal responsibility of a municipality for any harm or damage caused to individuals or property due to the actions or negligence of the city or its employees.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ZUMQE0dhR7S3nXcYzism_A">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in arranging transportation of freight between shippers and carriers. These establishments are usually known as freight forwarders, marine shipping agents, or customs brokers and offer a combination of services spanning transportation modes but do not directly provide shipping services.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/GRDEFA-xTYW-6dT4jMO9EQ"/>
    <rdfs:label>Freight Transportation Arrangement</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=488510"/>
  </rdf:Description>
