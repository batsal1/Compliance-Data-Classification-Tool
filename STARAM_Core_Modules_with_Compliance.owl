  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDgZFYp1iCuW1Tod7uoMWjE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9yi9EljTLvrh7N74L460ye"/>
    <skos:definition>A Non-Hearsay Out-of-Court Statement Objective refers to a purpose for admitting an out-of-court statement into evidence that does not rely on the truth of the content of the statement itself. This includes statements not offered for the truth of the matter asserted, nonassertive conduct, non-propositions, verbal acts, and "statements" made by a declarant that is not a person, such as a machine or device.</skos:definition>
    <dc:source>Fed. R. Evid. 801(a)</dc:source>
    <rdfs:label>Non-Hearsay Out-of-Court Statement Objective</rdfs:label>
  </rdf:Description>
