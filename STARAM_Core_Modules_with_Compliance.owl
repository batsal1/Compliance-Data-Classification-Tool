    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R80NoHVw0eTQZ51VwGaj5sM">
    <skos:altLabel xml:lang="de-de">Nichtantragstellender Ehepartner</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">非申請配偶</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cónyuge no declarante</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בן זוג לא מגיש דוח</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Non-Filing Spouse</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非申请配偶</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cónyuge no declarante</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cônjuge não requerente</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गैर-फाइलिंग पति</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Conjoint non-demandeur</skos:altLabel>
    <rdfs:label>Non-Filing Spouse</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77pHybcEdlO9OmqSuiyWi1"/>
    <skos:definition>A person who is the spouse of someone in bankruptcy, but who is not a part of that bankruptcy.</skos:definition>
    <skos:definition>From U.S. Bankruptcy Court PACER</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCKMwXz0wuzyPBBh8PISg6I">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOQpX5t5sVf55UPK2CfZTy"/>
    <rdfs:label>Domestic Servitude Claim</rdfs:label>
    <skos:definition>A domestic servitude claim is a legal allegation that a person is being forced to work in a household setting against their will, often through manipulation or coercion. This is a form of human trafficking and is considered a violation of labor laws and human rights.</skos:definition>
  </rdf:Description>
