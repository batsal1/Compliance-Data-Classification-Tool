    <rdfs:subClassOf rdf:nodeID="Nc6d2fc07fae94196b23fea1286d980ff"/>
    <skos:definition>A fact witness is a person who provides testimony in a trial based on their personal knowledge of the events or facts in question.</skos:definition>
    <rdfs:label>L410 Fact Witnesses</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N890390b05b404f698bfb4826bf2e9735">
