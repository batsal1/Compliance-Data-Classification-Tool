    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/PV3ZR2NvSIOv8lsU_cl7uQ"/>
    <rdfs:label>Home and Garden Equipment Repair and Maintenance</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in repairing and servicing home and garden equipment without retailing new home and garden equipment, such as lawnmowers, handheld power tools, edgers, snowblowers, leaf blowers, and trimmers.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDvd595QjUByS6fw9LeWBTA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RMo0rWec8owXGDAYl6PGNG"/>
    <rdfs:label>Tenancy in Common</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Tenancy in Common is a form of concurrent property ownership where multiple individuals hold separate and undivided interests in the same property. Each tenant in common has the right to sell, transfer, or bequeath their individual share without the consent of the other co-owners, and upon death, their interest passes to their heirs rather than the remaining co-owners.</skos:definition>
  </rdf:Description>
