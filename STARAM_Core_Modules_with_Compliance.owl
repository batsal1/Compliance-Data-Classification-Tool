    <skos:prefLabel>EULA</skos:prefLabel>
    <ns1:contractFamily xml:lang="en">Intellectual Property &amp; Licensing</ns1:contractFamily>
    <rdfs:label>End User License Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An End User License Agreement is a legal contract between a software application author or publisher and the user of that application. The EULA details how the software can be used and any restrictions on its use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBmCWxUTSB7HPq6seMEOCft">
    <skos:altLabel xml:lang="hi-in">इंट्यूइटू पर्सोने क्लॉज</skos:altLabel>
