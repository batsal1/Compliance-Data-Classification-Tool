  <rdf:Description rdf:about="https://folio.openlegalstandard.org/HMqTmz8ERzm_xfXmdc6yWA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=334412"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/h3GjRS3mT76GlOkN0SlOrg"/>
    <rdfs:label>Bare Printed Circuit Board Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing bare (i.e., rigid or flexible) printed circuit boards without mounted electronic components. These establishments print, perforate, plate, screen, etch, or photoprint interconnecting pathways for electric current on laminates.</skos:definition>
  </rdf:Description>
