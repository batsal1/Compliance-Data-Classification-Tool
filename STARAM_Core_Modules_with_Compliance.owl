  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBZ5IuV0gTh73KJm144lOoR">
    <skos:altLabel xml:lang="hi-in">अधिकारीक क्षेत्र अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gerichtsstandsklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de juridiction</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סמכויות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de jurisdicción</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de jurisdicción</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">管轄条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de jurisdição</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">管辖条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Jurisdiction Clause</skos:altLabel>
    <rdfs:label>Jurisdiction Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A jurisdiction clause is a provision in a contract that specifies the court or legal system that will have jurisdiction over any disputes arising from the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDKAbM3LW2xY7EihJPQ0hih">
    <skos:altLabel>Registered Instruments</skos:altLabel>
    <skos:altLabel>Recorded Securities</skos:altLabel>
    <skos:altLabel>Registered Financial Instruments</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCa0GJrngclDdSJ8dRAueqB"/>
    <rdfs:label>Registered Securities</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Registered Assets</skos:prefLabel>
    <skos:definition>Registered Securities are financial instruments recorded in the name of the owner on the books of the issuer or the issuer's registrar. Normally, these securities can only be transferred to another owner when endorsed by the registered owner, ensuring a clear record of ownership.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9GzNUToNbpmO2ZBdTqwkgT">
    <skos:definition>The failure of an employer to obtain an insurance policy that provides benefits to employees who suffer work-related injuries or illnesses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
    <rdfs:subClassOf rdf:nodeID="Ncb13702556f64bb2995ac54af84094b8"/>
    <skos:altLabel xml:lang="ja-jp">雇用者が労災保険の保険証を取得しなかった場合</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">雇主未能获得工伤保险政策</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नियोक्ता की श्रमिक रक्षा बीमा नीति प्राप्त करने में विफलता</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versäumnis des Arbeitgebers, eine Arbeitsunfallversicherung abzuschließen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha do empregador em obter uma apólice de seguro de acidentes de trabalho</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta del empleador de obtener una póliza de seguro de compensación laboral</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כישלון המעסיק לקבל פוליסת ביטוח תאונות עבודה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta del empleador de obtener una póliza de seguro de compensación laboral</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaut de l'employeur de souscrire une assurance accidents du travail</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Employer's Failure to Obtain Workers' Compensation Insurance Policy</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Employer's Failure to Obtain Workers' Compensation Insurance Policy</rdfs:label>
  </rdf:Description>
