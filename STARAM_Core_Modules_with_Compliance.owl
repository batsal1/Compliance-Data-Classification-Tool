  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBfi3eGJmdDDpV4EDEf8lVL">
    <skos:prefLabel>Hallucination</skos:prefLabel>
    <skos:definition>Confabulations, also known as "hallucinations," occur when generative AI systems produce inaccurate or false responses that appear plausible to the user. This phenomenon often involves the invention of erroneous information, such as historical or biographical details, and results from statistical prediction, repetition of training data, or learned patterns.</skos:definition>
    <rdfs:label>Confabulation</rdfs:label>
    <skos:altLabel>AI Hallucination</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
  </rdf:Description>
