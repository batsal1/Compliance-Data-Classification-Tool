    <skos:altLabel>Eco-Conscious Market Segment</skos:altLabel>
    <skos:altLabel>Green Market Segment</skos:altLabel>
    <skos:altLabel>Environmentally Friendly Segment</skos:altLabel>
    <skos:definition>The sustainable and eco-friendly segment refers to a portion of the market that is characterized by consumers who prioritize environmental sustainability and ethical practices in their purchasing decisions. This segment includes products and services that are designed with a focus on reducing environmental impact, using renewable resources, and promoting social responsibility.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N93f4e3a11fa540c98235a7ae6898136d">
    <owl:hasValue rdf:resource="https://staram.in/ontology/epc/taxonomy#impact-dispute"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/epc#hasConsequence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/2A-BXFaYS4aaPb9hUzIjNA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/GlEIq1JJSwqYPT3JUXUZgg"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=21311"/>
    <rdfs:label>Support Activities for Mining</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing support services, on a contract or fee basis (except geophysical surveying and mapping, mine site preparation, construction, and transportation activities), required for the mining and quarrying of minerals and for the extraction of oil and gas.  Drilling, taking core samples, and making geological observations at prospective sites for minerals, on a contract or fee basis, are included in this industry.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8P36P1R5mabdOkGBYMILet">
    <skos:altLabel>Business Issuer</skos:altLabel>
    <skos:altLabel>Enterprise Issuer</skos:altLabel>
    <skos:altLabel>Corporate Entity Issuer</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDM4k8t0O3hy93vQwQzEcpg"/>
    <skos:prefLabel>Company Issuer</skos:prefLabel>
    <skos:definition>A Corporate Issuer refers to a corporation that issues debt or equity securities to raise capital for various purposes, such as expanding operations, financing acquisitions, or refinancing existing debt. These securities can include corporate bonds, stocks, and commercial paper, and are sold to investors in the capital markets.</skos:definition>
    <rdfs:label>Corporate Issuer</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
