  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBWEcEhY9UhMFCPiyb7IsCi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Co-Guarantee</skos:altLabel>
    <skos:altLabel>Joint Obligation Guarantee</skos:altLabel>
    <skos:altLabel>Shared Guarantee</skos:altLabel>
    <rdfs:label>Joint Guarantee</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
    <skos:definition>A Joint Guarantee is a financial arrangement where an entity other than the issuer, typically a corporation, provides an assurance to fulfill the obligations of a debt instrument if the primary obligor defaults. This type of guarantee creates a shared responsibility for the debt, with both the issuer and the guarantor being jointly liable for the repayment, thus enhancing the creditworthiness of the instrument.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9JkqKed1jktjgwaeiLc7ru">
    <skos:altLabel xml:lang="zh-cn">清算破产</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falência de liquidação</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Liquidation judiciaire</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">清算型破産</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Liquidationsinsolvenz</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This is a type of bankruptcy where an individual's or company's assets are sold to pay off creditors. The debtor is typically absolved of further responsibility for the debts once the assets are liquidated, and the proceeds are distributed amongst the creditors.</skos:definition>
    <rdfs:label>Liquidation Bankruptcy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCjcn4XaW7DNZHGDFX1D4LN">
    <skos:altLabel xml:lang="pt-br">Viver separado de acordo com o acordo de separação</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חיים מתגרשים לפי הסכם הפרדה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विवाह विच्छेद समझौते के अनुसार अलग रहना</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Living Apart Pursuant to Separation Agreement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">根据分居协议分居</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">別居合意に基づく別居</skos:altLabel>
