  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD0aZP7ft4vKJPvLQnZ6tNP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>California Consumer Privacy Act</skos:example>
    <skos:example>CCPA</skos:example>
    <skos:example>GDPR</skos:example>
    <skos:example>Health Insurance Portability and Accountability Act</skos:example>
    <skos:example>General Data Protection Regulation</skos:example>
    <skos:example>HIPAA</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RrECTdM9f5ml4sac9MFrSC"/>
    <rdfs:label>Data Protection Regulation</rdfs:label>
    <skos:altLabel>Data Security Regulations</skos:altLabel>
    <skos:altLabel>Information Protection Regulations</skos:altLabel>
    <skos:altLabel>Privacy Protection Legislation</skos:altLabel>
    <skos:altLabel>Data Privacy Laws</skos:altLabel>
    <skos:prefLabel>Data Privacy Regulation</skos:prefLabel>
    <skos:definition>Data Protection Regulation refers to laws and policies designed to safeguard personal and sensitive information from unauthorized access, use, disclosure, alteration, and destruction. These regulations ensure that organizations (e.g., companies, nonprofits, governments) implement appropriate measures to protect data privacy and security, complying with legal standards such as the GDPR, CCPA, and HIPAA.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCO3L5hcD4bjMazJRF882MA">
    <skos:altLabel xml:lang="pt-br">Cláusula de confidencialidade mútua</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">相互保密条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de confidencialidad mutua</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gegenseitige Vertraulichkeitsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de confidencialidad mutua</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">相互機密保持条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de confidentialité mutuelle</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סודיות משותף</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mutual Confidentiality Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सहयोगी गोपनीयता शर्त</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mutual Confidentiality Clause</rdfs:label>
    <skos:definition>A mutual confidentiality clause is a provision in a contract that requires both parties to keep certain information confidential and not disclose it to third parties without consent.</skos:definition>
  </rdf:Description>
