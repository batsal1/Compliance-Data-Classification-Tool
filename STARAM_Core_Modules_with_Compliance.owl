  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RSAIWX8LNImanB6naIxX5g">
    <skos:altLabel>Fixed Sentence</skos:altLabel>
    <skos:altLabel>Prescribed Punishment</skos:altLabel>
    <skos:altLabel>Legislatively Determined Penalty</skos:altLabel>
    <skos:altLabel>Mandatory Minimum Sentence</skos:altLabel>
    <skos:altLabel>Compulsory Penalty</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8fFf9YNTCtz4Q15Jjj7AXF"/>
    <rdfs:label>Mandatory Sentence</rdfs:label>
    <skos:definition>A Mandatory Sentence is a predetermined punishment specified by law for a particular criminal offense, leaving the judge with no discretion to individualize the sentence. This type of sentence requires the court to impose a specific penalty upon conviction, regardless of mitigating factors or the judge's personal assessment of the case.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RcyQuaYdvmOmAVROvfH6sk">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWS7oVs9s2563KGt41Lsta"/>
    <rdfs:subClassOf rdf:nodeID="Nc398fbf0bfde4a1aae058f098cbc8e78"/>
    <rdfs:subClassOf rdf:nodeID="Nd6a7b33e8d2d4f1aacd4ceaf9ca5623f"/>
    <skos:altLabel xml:lang="hi-in">ऋण चुकाने के लिए संपत्ति को जब्त करना</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Saisie de biens pour payer une dette</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Embargo de propiedad para pagar deudas</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beschlagnahme von Eigentum zur Begleichung von Schulden</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Apreensão de propriedade para pagar dívida</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">扣押财产以偿还债务</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Embargo de bienes para pagar deudas</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">債務の支払いのための財産の差し押さえ</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Impounding Property to Pay Debt</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מילוי פקדון על נכסים לשם תשלום חוב</skos:altLabel>
    <skos:definition>The concept of "Impounding Property to Pay Debt" refers to the legal process of seizing and holding property as collateral to satisfy a debt owed by the property owner, typically in cases of equitable claims.</skos:definition>
    <rdfs:label>Impounding Property to Pay Debt</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCNAtjkDm3rutL4bPBsEz1I">
    <skos:altLabel xml:lang="es-mx">Secuestro</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חטיפה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Secuestro</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">誘拐</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Sequestro</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Kidnapping</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Enlèvement</skos:altLabel>
    <skos:altLabel>Abduction</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Entführung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अपहरण</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">绑架</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOQpX5t5sVf55UPK2CfZTy"/>
    <rdfs:label>Kidnapping</rdfs:label>
    <skos:definition>The act of unlawfully taking or confining a person, typically for ransom or as a means of coercion, and is considered a crime against individuals.</skos:definition>
    <rdfs:isDefinedBy>The unlawful seizure, transportation, and/or detention of a person against his/her will, or of a minor without the consent of his/her custodial parent(s) or legal guardian.</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbd61f89543b543c38a60e70553758e66">
    <owl:onProperty rdf:resource="https://staram.in/ontology/epc#hasConsequence"/>
    <owl:hasValue rdf:resource="https://staram.in/ontology/epc/taxonomy#impact-dispute"/>
