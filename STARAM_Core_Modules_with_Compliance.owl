    <skos:altLabel xml:lang="de-de">BBPLC-Klausel</skos:altLabel>
    <rdfs:label>BBPLC Clause</rdfs:label>
    <skos:definition>A BBPLC Clause is a specific type of contractual clause that is used in legal agreements drafted by the law firm Berwin Leighton Paisner (BLP).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
