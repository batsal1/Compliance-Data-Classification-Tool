    <skos:altLabel xml:lang="en-gb">Breach of No-Shop Covenant</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento del convenio de no compras</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ノーショップ契約違反</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת הסכם לא לקניות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação da cláusula de não compras</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verstoß gegen die No-Shop-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反禁止购物契约</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la clause de non-shopping</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento del convenio de no compras</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नो-शॉप कवेनेंट का उल्लंघन</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Ne873952e32be42c38d016cf57cc12f4f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDa7IsUxl4AA7e5KylzJYK"/>
    <rdfs:label>Breach of No-Shop Covenant</rdfs:label>
    <skos:definition>The Breach of No-Shop Covenant refers to the violation of a contractual agreement between parties involved in a business transaction, where one party agrees not to solicit or entertain offers from other potential buyers for a specified period of time.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
