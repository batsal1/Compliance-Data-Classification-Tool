  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCa0GJrngclDdSJ8dRAueqB">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Asset Negotiability and Transmission refer to the characteristics and methods by which ownership of an asset can be transferred. This includes assets with registered ownership, where the owner's identity is recorded, and bearer assets, where ownership is transferred by possession without registration.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
    <skos:altLabel>Transferability of Assets</skos:altLabel>
    <rdfs:label>Asset Negotiability and Transmission</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7PX1rDXmNgCrkuDqtGGkIS">
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/courts#VehicleType"/>
    <skos:definition>A bus is a large, motorized vehicle designed to transport multiple passengers. It is commonly used for public transportation and can vary in size and configuration, including city buses, school buses, and long-distance coaches.</skos:definition>
    <rdfs:label>Bus</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
