  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8mw82M2JL2CAKqkzh6FeSG">
    <skos:definition>Freedom from discrimination is a fundamental human right that entails the equal treatment of all individuals, regardless of race, gender, religion, nationality, disability, or other characteristics. This right is upheld by various international treaties and national laws, aiming to prevent unjust or prejudicial treatment based on a person's inherent traits or beliefs.</skos:definition>
    <dc:source>International Bill of Human Rights</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcUv6cuttcRWxmaQw6M1N4"/>
    <rdfs:subClassOf rdf:nodeID="Ndbdc3e5de21c44c58f7a697cac2edb96"/>
    <rdfs:subClassOf rdf:nodeID="N7f7ba7cf050748cd9824ab9c6ebc3742"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Freedom from Discrimination</rdfs:label>
  </rdf:Description>
