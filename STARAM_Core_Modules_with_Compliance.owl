  <rdf:Description rdf:about="https://folio.openlegalstandard.org/16d49732-e637-4637-8369-7a4876d93b5d49efd793-18c9-4ed9-aca5-99ea01221e8a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/dee4c3fe-fb17-4e56-bed7-6ae3eb6acf96982b1ad5-5b20-40c6-852d-15348064436e"/>
    <skos:definition>Holder can claim the amount specified in promissory note along with interest and legal costs if it's dishonored.</skos:definition>
    <rdfs:label>Claim for Payment of Promissory Note</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7mL8NoasPohW19RcS9oqik">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Senior Subordinated Credit Ranking</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
    <skos:prefLabel>Senior Subordinated Debt Priority</skos:prefLabel>
    <skos:definition>Senior Subordinated Credit Ranking refers to the priority status of senior subordinated debts, which are ranked above junior and junior subordinated debts but below senior debts in the event of liquidation. This ranking ensures that senior subordinated creditors are paid before junior creditors from the proceeds of the liquidated assets, providing them with a moderate level of security and reduced risk compared to junior debts.</skos:definition>
  </rdf:Description>
