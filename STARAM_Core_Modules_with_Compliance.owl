  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCtLOuj6Tcw6HFDYYKdAI6q">
    <skos:altLabel xml:lang="de-de">Haftungsausschlussklausel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver of Liability Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">免責条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation à la responsabilité</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור מאחריות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia de responsabilidade</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दायित्व से मुक्ति अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia de responsabilidad</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">免责条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de exención de responsabilidad</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Waiver of Liability Clause</rdfs:label>
    <skos:definition>A waiver of liability clause is a provision in a legal document that releases a party from responsibility for any harm or injury that may occur as a result of participating in an activity or using a product, typically signed by the participant or user.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
  </rdf:Description>
