    <skos:altLabel xml:lang="en-gb">Nondisparagement Agreement</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Nondisparagement Agreement</rdfs:label>
    <skos:definition>A Nondisparagement Agreement is a legal contract in which parties agree not to make negative or critical comments about each other, often used in settlement agreements or employment contracts.</skos:definition>
