    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZisChrUg3JTZGhCXcya78"/>
    <skos:definition>A settlement or non-binding alternative dispute resolution (ADR) process that is used to resolve a legal case without a formal decision or judgment, and falls under the broader category of case assessment, development, and administration.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>L160 Settlement/Non-Binding ADR</rdfs:label>
  </rdf:Description>
