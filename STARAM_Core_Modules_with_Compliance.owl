  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RIl8s2tEaoYUUYasF92UWc">
    <skos:altLabel xml:lang="ja-jp">徘徊</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Herumlungern</skos:altLabel>
