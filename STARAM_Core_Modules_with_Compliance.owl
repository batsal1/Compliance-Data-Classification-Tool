    <rdfs:label>Performance Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Performance Clause is a provision in a contract that outlines the obligations and responsibilities of the parties involved in fulfilling their contractual duties, including the consequences of failing to meet those obligations.</skos:definition>
  </rdf:Description>
