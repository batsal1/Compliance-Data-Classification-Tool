    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDAtxH1BfFkPhZbCV8MchSz">
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-ENVT-FSHG</ns2:legacyIdentifier>
    <skos:altLabel xml:lang="zh-cn">渔猎法</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fisch- und Wildtiergesetz</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei de Pesca e Caça</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">漁猟法</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Loi sur la pêche et la chasse</skos:altLabel>
    <skos:altLabel>Fish and Game</skos:altLabel>
    <skos:hiddenLabel>FSHG</skos:hiddenLabel>
    <rdfs:label>Fish and Game Law</rdfs:label>
    <skos:definition>Laws regulating the right to pursue and take or kill certain kinds of fish and wild animal (game).</skos:definition>
    <skos:prefLabel>Fish and Game Law</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRfuF3AuewVT4SR15di375"/>
