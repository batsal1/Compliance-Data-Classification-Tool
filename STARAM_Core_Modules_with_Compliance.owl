  <rdf:Description rdf:about="https://folio.openlegalstandard.org/yxGBugvDSQ2aTK6cRyU7xQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=324121"/>
    <rdfs:label>Asphalt Paving Mixture and Block Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/r78yIFiZQrCFnspcr2BSqA"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing asphalt and tar paving mixtures and blocks from purchased asphaltic materials.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/SGXQgcwnQya4ZEyToBb7_Q">
