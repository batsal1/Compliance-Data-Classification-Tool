  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rr5M6D8bfZysKMRt3I0I5">
    <rdfs:label>Panel Management</rdfs:label>
    <skos:definition>Panel Management refers to the process of selecting and overseeing a group of individuals or entities who provide legal services to a company or organization, and falls under the broader category of Legal Operations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QcJpEJ19eAN8glCzxd4Wo"/>
  </rdf:Description>
