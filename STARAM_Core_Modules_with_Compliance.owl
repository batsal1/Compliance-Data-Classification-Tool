  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RNUiEzpRIjQmJpv69ijYuE">
    <rdfs:label>Redemption Claim</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N25bfe034f1fa4daf84346f593e9fd485"/>
    <rdfs:subClassOf rdf:nodeID="Nbcff2bdf0e4047b9b4998ba783d0e479"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A redemption claim is a legal action in which a party seeks to regain ownership or rights to property that has been foreclosed upon or sold due to nonpayment of a debt or other financial obligations. In some cases, property owners or debtors have the opportunity to "redeem" their property by paying off the outstanding debt, including associated costs and fees, within a specified period defined by law. Redemption claims can be part of the foreclosure process, allowing individuals or entities to reclaim their property under certain conditions.</skos:definition>
  </rdf:Description>
