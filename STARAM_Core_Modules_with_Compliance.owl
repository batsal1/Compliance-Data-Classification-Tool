    <skos:altLabel xml:lang="pt-br">Apropriação indébita de ideias - Reivindicação de propriedade</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ideenunterschlagung - Eigentumsanspruch</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RdJQsU95Vq3NCs4Q7326F5"/>
    <skos:definition>The wrongful taking or use of someone else's idea or intellectual property, with a legal claim made specifically regarding ownership of the idea.</skos:definition>
    <rdfs:label>Idea Misappropriation - Property Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
