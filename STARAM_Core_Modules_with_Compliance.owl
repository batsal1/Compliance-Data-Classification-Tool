  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9EyU5kaEIa7RwDT1cE6lt">
    <rdfs:label>General Terms and Conditions Clause</rdfs:label>
    <skos:altLabel xml:lang="en-gb">General Terms and Conditions Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Términos y Condiciones Generales</skos:altLabel>
