  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8A6gE3VknQJF8fHGm9ltkV">
    <skos:altLabel xml:lang="ja-jp">安全でない職場</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unsicherer Arbeitsplatz</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不安全的工作场所</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Lieu de travail dangereux</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Local de trabalho inseguro</skos:altLabel>
