  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7LQAM6H8WDBexXwLl2Si3f">
    <skos:altLabel>Special Committee</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Comité Independiente</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Comité indépendant</skos:altLabel>
