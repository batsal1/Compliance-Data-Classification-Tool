    <skos:altLabel xml:lang="de-de">Zukünftige Erwerbsfähigkeit</skos:altLabel>
    <rdfs:label>Future Earning Capacity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RouKBMqFNMZxi21EPh6JJ6"/>
    <rdfs:subClassOf rdf:nodeID="Nde5221b8e2f647f287b570b4e7c3f31e"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Future Earning Capacity" refers to the potential income that an individual could have earned in the future, had they not been injured or suffered damages, and is used to calculate economic damages in legal cases.</skos:definition>
  </rdf:Description>
