    <skos:altLabel xml:lang="ja-jp">未成年者の限定後見</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Tutela limitada de menores</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Guarda limitada de menores</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Tutelle limitée des mineurs</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Limited Guardianship of Juvenile</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Begrenzte Vormundschaft für Minderjährige</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कम संरक्षणाधीन नाबालिग की अधिकारपत्र</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未成年人有限监护</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Tutela limitada de menores</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אפוטרופוס מוגבל של קטין</skos:altLabel>
    <rdfs:label>Limited Guardianship of Juvenile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBk6ifsoekQHMhcCs8IVWuo"/>
    <skos:definition>A Limited Guardianship of Juvenile is a legal arrangement where a guardian is appointed to care for a minor child, but the guardian's authority is limited to specific areas, such as education or medical decisions, while the parents retain their rights and responsibilities in other areas.</skos:definition>
  </rdf:Description>
