    <skos:altLabel xml:lang="he-il">שפת דרישת הסכמת הקונה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Langage des exigences de consentement de l'acheteur</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार सहमति आवश्यकता भाषा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Käufer-Zustimmungsanforderungssprache</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Linguagem de requisitos de consentimento do comprador</skos:altLabel>
    <skos:definition>A requirement for the buyer's explicit agreement to certain terms or conditions, which is included in an affirmative covenant.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Buyer Consent Requirement Language</rdfs:label>
