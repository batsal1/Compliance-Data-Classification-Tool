  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RuIG2rEI5t49RfIVJsH0IX">
    <skos:altLabel xml:lang="es-mx">Futilidad de la Demanda</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Futilidade da demanda</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">需求无效</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मांग निष्फलता</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">需要の無効</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פסולת דרישה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nachfrageaussichtslosigkeit</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Futilité de la demande</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Demand Futility</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Futilidad de la Demanda</skos:altLabel>
    <rdfs:label>Demand Futility</rdfs:label>
    <skos:definition>Demand futility is a legal concept within corporate and partnership liability claims that allows shareholders to bring a lawsuit on behalf of the company without first making a demand on the board of directors if doing so would be futile.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
