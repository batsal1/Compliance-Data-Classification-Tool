  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8VWI7MXtnSXaP6rHFs1Tbh">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBeZkopwGsxt3K5BXOgNBNF"/>
    <rdfs:label>Environmental Permit Violation Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Environmental Permit Violation Claim is a legal action alleging that an individual, company, or entity has failed to comply with the terms and conditions of an environmental permit issued by a regulatory authority. Such claims typically assert that the permit holder has exceeded allowed emission levels, discharged prohibited substances, or failed to implement required environmental protection measures.</skos:definition>
  </rdf:Description>
