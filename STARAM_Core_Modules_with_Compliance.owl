  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8mBLAvdwmc4l41eWBKzkVi">
    <skos:prefLabel>Prison Director</skos:prefLabel>
    <skos:definition>A Warden is the chief administrative officer of a correctional facility, responsible for overseeing all aspects of the facility's operations, including security, inmate management, staff supervision, and compliance with regulations. The Warden ensures the effective and humane treatment of inmates while maintaining order and safety within the institution.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9SAKPHWeGi7uZqUG6EMlt"/>
    <skos:altLabel>Prison Superintendent</skos:altLabel>
    <skos:altLabel>Chief Correctional Officer</skos:altLabel>
    <skos:altLabel>Corrections Chief</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Warden</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9KNE3Vhztz4VzYxRhTxMcH">
    <skos:altLabel xml:lang="es-es">Responsabilidad del ascensor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिफ्ट दायित्व</skos:altLabel>
