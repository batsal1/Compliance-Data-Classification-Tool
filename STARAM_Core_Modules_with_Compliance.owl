  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDyrNzqI8aN6BeNnA5w2pSx">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="zh-cn">会计准则语言变更</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Änderungen in der Sprache der Rechnungslegungsgrundsätze</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cambios en el lenguaje de los principios contables</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लेखा सिद्धांत भाषा में परिवर्तन</skos:altLabel>
    <skos:altLabel>Change in GAAP Principles</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שינויים בשפת עקרונות החשבון</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cambios en el lenguaje de los principios contables</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Mudanças na linguagem dos princípios contábeis</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Changes in Accounting Principles Language</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Changements dans le langage des principes comptables</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">会計原則言語の変更</skos:altLabel>
    <skos:definition>Changes in Accounting Principles (e.g., GAAP) Language refers to modifications made to the Generally Accepted Accounting Principles (GAAP) or other accounting standards that are used to prepare financial statements, and the impact of such changes on legal agreements or contracts that reference them.</skos:definition>
    <rdfs:label>Changes in Accounting Principles Language</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
  </rdf:Description>
