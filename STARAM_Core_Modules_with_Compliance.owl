  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9eW4sfeFepDiQThY7iRxkq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Coupe</skos:altLabel>
    <skos:altLabel>Sports Car</skos:altLabel>
    <skos:altLabel>Hatchback</skos:altLabel>
    <skos:altLabel>Sedan</skos:altLabel>
    <skos:altLabel>Convertible</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/courts#VehicleType"/>
    <skos:definition>A car is a motorized vehicle designed for the transportation of passengers or cargo. It comes in various body styles, including sedan, coupe, convertible, and hatchback, each with distinct features and configurations.</skos:definition>
    <rdfs:label>Car</rdfs:label>
  </rdf:Description>
