    <skos:hiddenLabel>LOA</skos:hiddenLabel>
    <rdfs:subClassOf rdf:nodeID="N6037ae479e9e4594a855c02cd4122a2d"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZGfmXsIBYoRaOo5gXdeTP"/>
    <skos:definition>A transaction whereby property is lent or given to another on condition of return or, where the loan is of money, repayment. In a loan of money, the money lent becomes the property of the borrower during the period of the loan against an undertaking to return a sum of an equivalent amount either on demand or on a specified date or in accordance with an agreed schedule of repayments.</skos:definition>
  </rdf:Description>
