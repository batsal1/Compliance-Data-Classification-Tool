  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RLFy69g18M213jDVncEVvs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N3c717b23125d498fabf9a000496c2c2e"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <skos:altLabel xml:lang="de-de">Arbeitgeber behandelt Mitarbeiterlöhne unsachgemäß</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">雇用者が従業員の賃金を不適切に処理している</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Employeur manipulant incorrectement les salaires des employés</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Employer Improperly Handling Employee Wages</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Empleador que maneja de forma inadecuada los salarios de los empleados</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नियोक्ता कर्मचारी वेतन को गलत ढंग से संभाल रहा है</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Empleador que maneja de forma inadecuada los salarios de los empleados</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">雇主不当处理员工工资</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Empregador manuseando indevidamente os salários dos funcionários</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעסיק מטפל בצורה לא תקינה בשכר העובדים</skos:altLabel>
    <rdfs:label>Employer Improperly Handling Employee Wages</rdfs:label>
    <skos:definition>Employer Improperly Handling Employee Wages: The act of an employer mishandling or failing to properly pay an employee for their work, which may include withholding wages, failing to pay overtime, or other violations of wage and hour laws.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/YD11v-rcTW2wtk8CgOGDBg">
    <rdfs:label>Other Accounting Services</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541219"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NmIMYURUTcetuQgVtrZrwA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments (except offices of CPAs) engaged in providing accounting services (except tax return preparation services only or payroll services only). These establishments may also provide tax return preparation or payroll services. Accountant (except CPA) offices, bookkeeper offices, and billing offices are included in this industry.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCw8IC5TbjkV1rxNruwttNL">
    <rdfs:subClassOf rdf:nodeID="N878577a6625b4a57b88797eddbacff76"/>
