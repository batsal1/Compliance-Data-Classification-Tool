    <skos:altLabel xml:lang="fr-fr">Clause de signatures de contrepartie</skos:altLabel>
    <rdfs:label>Counterpart Signatures Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Counterpart Signatures Clause is a provision in a contract that allows for multiple copies of the same document to be signed separately, but still be considered as one original document.</skos:definition>
  </rdf:Description>
