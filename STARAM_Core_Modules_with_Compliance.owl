    <skos:prefLabel>Comprehensive Coverage</skos:prefLabel>
    <rdfs:label>Comprehensive Auto Insurance Coverage Policy</rdfs:label>
    <skos:definition>Comprehensive auto insurance provides coverage for damage to the insured vehicle that is not caused by a collision with another vehicle. This includes events like theft, vandalism, natural disasters, and damage from animals. Comprehensive coverage is usually optional and comes with a deductible.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
