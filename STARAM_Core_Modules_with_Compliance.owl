  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBvfJW4HbL3Y7Guu9ENS7w2">
    <skos:altLabel xml:lang="es-es">Separación Legal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Legal Separation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">別居</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कानूनी अलगाव</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Séparation de corps</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">法律分居</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Getrenntleben</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Separação judicial</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Separación Legal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרדה משפטית</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Legal Separation: A legal process that allows a married couple to live apart while remaining legally married, often involving court orders regarding property division, child custody, and support.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs"/>
    <rdfs:label>Legal Separation</rdfs:label>
  </rdf:Description>
