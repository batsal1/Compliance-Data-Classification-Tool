    <skos:altLabel xml:lang="he-il">אכיפת פסק דין</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
    <skos:definition>The enforcement of judgment refers to the legal process of ensuring that a court's decision is carried out, often through methods such as seizing assets or placing liens on property.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Enforcement of Judgment</rdfs:label>
