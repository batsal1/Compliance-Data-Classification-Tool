  <rdf:Description rdf:about="https://folio.openlegalstandard.org/XmPn9qdqRNCrNlvwItWVMw">
    <skos:definition>This industry comprises establishments primarily engaged in converting paperboard into containers without manufacturing paperboard.  These establishments use corrugating, cutting, and shaping machinery to form paperboard into containers.  Products made by these establishments include boxes, corrugated sheets, pads, pallets, paper dishes, and fiber drums and reels.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_tQlht4ETRKrwll0G13vfw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32221"/>
