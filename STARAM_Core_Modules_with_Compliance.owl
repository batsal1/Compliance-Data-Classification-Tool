    <skos:prefLabel>Investment Management Agreement</skos:prefLabel>
    <skos:definition>An Investment Advisory Agreement is a contract between an investor and an advisor, where the advisor provides investment recommendations, portfolio management, or other advisory services. The agreement specifies fees, the scope of advice, and fiduciary responsibilities.</skos:definition>
    <rdfs:label>Investment Advisory Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Investment &amp; Financial Services</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVmjCRgjA2bEt3UKK0ZM44">
    <skos:altLabel xml:lang="en-gb">Failure to Exhaust Administrative Remedy</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रशासनिक उपाय को खत्म करने में विफलता</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta de Agotamiento del Recurso Administrativo</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta de Agotamiento del Recurso Administrativo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaut d'épuisement des recours administratifs</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versäumnis der Erschöpfung des Verwaltungsrechtsbehelfs</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">行政救済手続きの尽力怠慢</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha em esgotar o recurso administrativo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未尽行政救济程序</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כישלון בהרתעה מנהלית</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXfDG78SSnJOuZPWGq21Ab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Failure to Exhaust Administrative Remedy</rdfs:label>
    <skos:definition>The Failure to Exhaust Administrative Remedy is a legal defense in civil litigation where the plaintiff has not completed all required administrative procedures before filing a lawsuit.</skos:definition>
  </rdf:Description>
