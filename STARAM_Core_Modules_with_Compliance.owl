  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCU0BYJMl0DPrYYohwA8Uto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Perpetual Asset</rdfs:label>
    <skos:altLabel>Perpetual Security</skos:altLabel>
    <skos:altLabel>No Maturity Asset</skos:altLabel>
    <skos:altLabel>Indefinite Duration Asset</skos:altLabel>
    <skos:altLabel>Perpetual Instrument</skos:altLabel>
    <skos:definition>A Perpetual Asset is a financial instrument that does not have a fixed maturity date, allowing it to exist indefinitely without a predetermined end. This attribute is common in certain types of equity and debt instruments, providing ongoing returns or obligations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Q8Ra8XyYj14cKvu35plq">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="de-de">Klausel zu Zahlungsbedingungen</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de modalités de paiement</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भुगतान शर्तें शब्दांश</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">付款条款条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de termos de pagamento</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">支払条件条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאי תשלום</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Términos de Pago</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Payment Terms Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Términos de Pago</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Payment Terms Clause is a provision in a contract that outlines the specific conditions and requirements for payment between parties involved in the agreement.</skos:definition>
    <rdfs:label>Payment Terms Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9fslqJlcJW7E5ey4lzHMF5">
    <skos:altLabel xml:lang="de-de">Partnerschaftsanspruch</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de parceria</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de partenariat</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">パートナーシップ請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合伙索赔</skos:altLabel>
    <skos:definition>A Partnership Claim is a legal action brought by one or more partners against the partnership or other partners for breach of partnership agreement or other wrongdoing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
