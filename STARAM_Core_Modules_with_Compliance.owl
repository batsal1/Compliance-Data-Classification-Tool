    <skos:altLabel xml:lang="fr-fr">Clause de responsabilité solidaire et indivisible</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">連帯債務条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אחריות משותפת ומספקת</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de responsabilidad solidaria mancomunada</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">连带责任条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur gemeinsamen und mehrfachen Haftung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de responsabilidade solidária e indivisível</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संयुक्त और एकाधिकारी दायित्व शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de responsabilidad solidaria</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Joint and Several Liability Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Joint and Several Liability Clause</rdfs:label>
    <skos:definition>A joint and several liability clause is a provision in a contract that holds multiple parties responsible for fulfilling the obligations of the contract, either individually or collectively.</skos:definition>
  </rdf:Description>
