  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9TkHhfOprsHvGvowsJApV">
    <skos:altLabel xml:lang="en-gb">Name and Likeness Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de nombre e imagen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שם ודמות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">名前と肖像権条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de nombre e imagen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">姓名和肖像条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नाम और चेहरे की अनुमति शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de nom et d'image</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Nome e Imagem</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Namen und Bildnis</skos:altLabel>
    <skos:definition>A Name and Likeness Clause is a provision in a contract that allows one party to use the name and image of another party for commercial purposes, subject to certain limitations and conditions.</skos:definition>
    <rdfs:label>Name and Likeness Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
