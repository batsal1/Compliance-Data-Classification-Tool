    <skos:altLabel xml:lang="es-es">Negligencia del agente de depósito y fraude constructivo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">エスクローエージェントの過失と建設的詐欺</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence et fraude constructive de l'agent d'entiercement</skos:altLabel>
    <skos:altLabel xml:lang="he-il">השגת הסוכן להפקיד והונאה מבנית</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Escrow Agent's Negligence and Constructive Fraud</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia del agente de fideicomiso y fraude constructivo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">托管代理人的疏忽和建设性欺诈</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDp8cEr3KYyVDenm1P9ejdx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Escrow Agent's Negligence and Constructive Fraud</rdfs:label>
  </rdf:Description>
