  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9v2UUDvT1VZX1aTmVuP1V5">
    <skos:altLabel xml:lang="he-il">כשל במניעת הפלילה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">差別の防止義務違反</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versäumnis der Diskriminierungsprävention</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta de prevención de la discriminación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaut de prévention de la discrimination</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta de prevención de la discriminación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भेदभाव रोकने में विफलता</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未能防止歧视</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha na prevenção da discriminação</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure to Prevent Discrimination</skos:altLabel>
    <skos:definition>Failure to prevent discrimination refers to a situation in which an employer, organization, or entity neglects to take appropriate steps to address and deter discriminatory actions or practices within their environment. This may include not establishing and enforcing clear policies, failing to provide training or education on discrimination and harassment, or neglecting to investigate and remedy complaints of discrimination.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Failure to Prevent Discrimination</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdfs:subClassOf rdf:nodeID="Na2abd98f8a3045a6954a996dffcd7948"/>
    <rdfs:subClassOf rdf:nodeID="N0c971a083b704dbda487555c0c7dd8a8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/WVjbLimvS3OOpJKjhHWZLg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Wzrpb2ZxSzmXaj5XrU-9fQ"/>
    <skos:example>Steering columns, automotive, truck, and bus, manufacturing</skos:example>
    <skos:example>Struts, automotive, truck, and bus, manufacturing</skos:example>
    <skos:example>Steering wheels, automotive, truck, and bus, manufacturing</skos:example>
    <skos:example>Rack and pinion steering assemblies manufacturing</skos:example>
    <skos:example>Shock absorbers, automotive, truck, and bus, manufacturing</skos:example>
    <skos:example>Power steering pumps manufacturing</skos:example>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing and/or rebuilding motor vehicle steering mechanisms and suspension components (except springs).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Motor Vehicle Steering and Suspension Components (except Spring) Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=336330"/>
  </rdf:Description>
