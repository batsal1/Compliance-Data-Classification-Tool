  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs">
    <rdfs:subClassOf rdf:nodeID="N37cffb9e1e10461db592975b98f0f1f6"/>
    <rdfs:subClassOf rdf:nodeID="N7d396b219c9e4069b7706b6062e205b9"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUXzL8Z4Ddh2CK6TBhofjU"/>
    <skos:altLabel xml:lang="hi-in">तलाक दावे</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Divorce Claims</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de divórcio</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">離婚請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">离婚索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות גירושין</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Demandes de divorce</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandas de divorcio</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Scheidungsansprüche</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de divorcio</skos:altLabel>
    <rdfs:label>Divorce Claims</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Divorce Claims refer to legal actions taken by a party to end a marriage and obtain a legal dissolution of the marital relationship, including issues related to property division, spousal support, and child custody.</skos:definition>
  </rdf:Description>
