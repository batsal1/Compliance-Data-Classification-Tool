  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8pfSLBOfyMtqZrnVbVcArS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Physiotherapie-Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">物理治疗过失行为</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Physical Therapy Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em fisioterapia</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בפיזיותרפיה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en kinésithérapie</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शारीरिक थेरेपी नष्टाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">理学療法の過失行為</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en Fisioterapia</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en Terapia Física</skos:altLabel>
    <skos:definition>Physical Therapy Malpractice refers to a type of medical malpractice claim that arises from the negligent or improper actions of a physical therapist, resulting in harm or injury to a patient.</skos:definition>
    <rdfs:label>Physical Therapy Malpractice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/X4eXQ9PgTsqEWQks2H2P6g">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333991"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/z92pj9hTTd2-Vgl3rH8XfQ"/>
    <rdfs:label>Power-Driven Handtool Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing power-driven (e.g., battery, corded, pneumatic) handtools, such as drills, screwguns, circular saws, chain saws, staplers, and nailers.</skos:definition>
  </rdf:Description>
