  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RvYz3orfLlfDkyq7oyLoox">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBMlUtTtbQUQxrZrkeF8Fpm"/>
    <skos:prefLabel>Collateral Issue Objection</skos:prefLabel>
    <dc:source>Fed. R. Evid. 613</dc:source>
    <skos:altLabel>Unlawful Discrediting Objection</skos:altLabel>
    <skos:altLabel>Inadmissible Impeachment Objection</skos:altLabel>
    <skos:altLabel>Objection to Unauthorized Witness Attack</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Improper Impeachment Objection</rdfs:label>
    <skos:definition>An Improper Impeachment Objection is raised when a party in a legal proceeding believes that the opposing counsel is attempting to discredit a witness in a manner that is not allowed by the rules of evidence. This objection aims to protect the integrity of the witness's testimony and ensure that any challenge to their credibility is conducted appropriately.</skos:definition>
  </rdf:Description>
