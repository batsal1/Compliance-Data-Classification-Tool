  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RLZaLo9ThQG-7pr07XwzegQ">
    <skos:definition>All action associated with completing a quasi-judicial proceeding before an administrative tribunal associated with the Patent Office of the home country of the applicant in connection with an application filed under PA300, including Appeals, Oppositions, Interferences, and other ex-parte and inter-partes proceedings. Includes collecting evidence, preparing and filing motions, briefs, responses, replies, surreplies, and other documents, attending conferences, depositions, hearings, and other proceedings. Does not include requests for supervisory action ("Petitions" in the U.S.) under PA430. Note that external expenses (or "disbursements" in the U.S.) are included under E100.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>PA440 Quasi-Judicial Administrative Proceedings - Domestic</skos:prefLabel>
    <rdfs:label>PA440 Quasi-Judicial Administrative Proceedings - Domestic</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqZ7vY-cmRNOGHw53EESO8Q"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/MKt5e3XIQTa8KMNCLkoKYw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD56727CABa3aB066e948fc1"/>
    <rdfs:label>Agencies, Brokerages, and Other Insurance Related Activities</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry group comprises establishments primarily engaged in (1) acting as agents (i.e., brokers) in selling annuities and insurance policies or (2) providing other employee benefits and insurance related services, such as claims adjustment and third party administration.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5242"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDY5JkSXEk1XWFQZSGtmCeL">
    <skos:altLabel xml:lang="en-gb">Psychiatrist Negligence</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">精神科医の過失</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">精神科医生疏忽</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Psychiaterische Fahrlässigkeit</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence du psychiatre</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia del psiquiatra</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मनोचिकित्सक लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência do psiquiatra</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia del psiquiatra</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובתו של רופא פסיכיאטר</skos:altLabel>
    <rdfs:label>Psychiatrist Negligence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <skos:definition>Psychiatrist Negligence refers to a legal claim of medical negligence against a psychiatrist, where the patient alleges that the psychiatrist failed to provide the appropriate standard of care resulting in harm or injury.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
