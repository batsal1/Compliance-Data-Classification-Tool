  <rdf:Description rdf:about="https://folio.openlegalstandard.org/t4gtVuHeT_ycSz-KK5rGTg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541870"/>
    <rdfs:label>Advertising Material Distribution Services</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in the direct distribution or delivery of advertisements (e.g., circulars, coupons, handbills) or samples. Establishments in this industry use methods, such as delivering advertisements or samples door-to-door, placing flyers or coupons on car windshields in parking lots, or handing out samples in retail stores.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/tHb_wMTiQzCKk3djnDdgrg"/>
  </rdf:Description>
