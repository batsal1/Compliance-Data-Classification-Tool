  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7KGGhirGUj2y81W5Kp7TT2">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GqVQ7wf48MBB7IuqjSfOk"/>
    <rdfs:label>Warrant Claim</rdfs:label>
    <skos:altLabel xml:lang="pt-br">Reivindicação de garantia</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת אחריות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de garantía</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">担保索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Garantieanspruch</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de garantía</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de garantie</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Warrant Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保証請求</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वारंट क्लेम</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A warrant claim refers to a legal assertion involving the issuance, execution, or validity of a warrant, which is an official document issued by a judicial officer that authorizes law enforcement to perform certain acts, such as an arrest, a search, or a seizure. A warrant claim can take many forms, including claims that a warrant was improperly issued, executed, or lacked sufficient cause.</skos:definition>
  </rdf:Description>
