    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Clawback Provision Clause</rdfs:label>
    <skos:definition>A Clawback Provision Clause is a contractual clause that allows a party to recover previously paid compensation or benefits from an employee or executive in certain circumstances, such as a financial restatement or misconduct.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R929rvDHCLJCS0qADsTizQ9">
