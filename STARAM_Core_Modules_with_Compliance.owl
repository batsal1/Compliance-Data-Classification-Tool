  <rdf:Description rdf:about="https://folio.openlegalstandard.org/cNdeVL-5QIqgO_uNW3gEIg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBpV7a4XyvWmCSvE8cMGfWK"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=1124"/>
    <rdfs:label>Sheep and Goat Farming</rdfs:label>
    <skos:definition>This industry group comprises establishments primarily engaged in raising sheep, lambs, and goats, or feeding lambs for fattening.</skos:definition>
