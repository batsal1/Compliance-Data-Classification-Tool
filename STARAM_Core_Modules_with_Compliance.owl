  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBk6ifsoekQHMhcCs8IVWuo">
    <skos:altLabel xml:lang="en-gb">Guardianship of Juvenile</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">किशोर की प्रत्यक्ष परिचर्चा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">未成年者の保護</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未成年人监护</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Tutela de Menores</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אפוטרופוס של נוער</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Tutelle des mineurs</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Tutela de Menores</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Guarda de Menores</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vormundschaft für Minderjährige</skos:altLabel>
    <skos:definition>The concept of Guardianship of Juvenile refers to the legal arrangement where a court appoints a guardian to take care of a minor's personal and financial affairs when the parents are unable to do so.</skos:definition>
    <rdfs:label>Guardianship of Juvenile</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDuglENJJNibMF8YDtmXkpE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/e70ywqyARo6N9awfXhCvvA">
    <skos:example>LCD (liquid crystal display) unit screens manufacturing</skos:example>
    <skos:example>Electron tubes manufacturing</skos:example>
    <skos:example>Crystals and crystal assemblies, electronic, manufacturing</skos:example>
    <skos:example>Piezoelectric devices manufacturing</skos:example>
    <skos:example>Printed circuit laminates manufacturing</skos:example>
    <skos:example>Microwave components manufacturing</skos:example>
    <skos:example>Switches for electronic applications manufacturing</skos:example>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing electronic components (except bare printed circuit boards; semiconductors and related devices; electronic capacitors; electronic resistors; coils, transformers, and other inductors; connectors; and loaded printed circuit boards).</skos:definition>
    <skos:definition>Transducers (except pressure) manufacturing</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Other Electronic Component Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=334419"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/h3GjRS3mT76GlOkN0SlOrg"/>
  </rdf:Description>
