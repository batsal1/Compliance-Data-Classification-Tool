    <skos:prefLabel>Collateralized Debt Obligation</skos:prefLabel>
    <skos:prefLabel>CLO</skos:prefLabel>
    <skos:definition>A CLO is a type of structured finance instrument backed by a pool of loans. These loans are bundled together and then sliced into tranches with varying degrees of risk and reward, which are then sold to investors.</skos:definition>
    <rdfs:label>Collateralized Loan Obligation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
