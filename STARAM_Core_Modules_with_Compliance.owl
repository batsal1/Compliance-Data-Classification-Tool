    <rdfs:label>Violation of Probation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The violation of probation is a breach of the terms and conditions set forth by a court order that requires an individual to comply with certain rules and regulations as a result of a prior criminal misdemeanor offense.</skos:definition>
