    <skos:altLabel xml:lang="ja-jp">賃貸借契約期間延長オプション条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लीज़ अवधि को बढ़ाने के लिए विकल्प शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'option de prolongation de la durée du bail</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Option to Extend Lease Term Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Opção de Prorrogação do Prazo do Contrato de Locação</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Opción de Extensión del Plazo de Arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אפשרות להאריך את תקופת השכירות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Verlängerung der Mietdauer-Option</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租期延长选项条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Opción de Prórroga del Plazo de Arrendamiento</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Option to Extend Lease Term Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Option to Extend Lease Term Clause is a provision in a contract that grants one or both parties the right to extend the lease agreement for a specified period of time beyond the original lease term.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/8CPDrE98Tu-my3xS8OJc1A">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Plastics Packaging Film and Sheet (including Laminated) Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/cW-wZtcFTXuDlNYs96bTZA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=326112"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in converting plastics resins into plastics packaging (flexible) film and packaging sheet.</skos:definition>
  </rdf:Description>
