  <rdf:Description rdf:about="https://folio.openlegalstandard.org/7h_ZAiafR1OGmih72Z50XA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3112"/>
    <rdfs:label>Grain and Oilseed Milling</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCaeZbTg74NX3xyNzskpVH8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry group comprises establishments primarily engaged in milling flour or meal from grains or vegetables, manufacturing malt, wet milling corn and other vegetables, crushing oilseeds and tree nuts, refining and/or blending vegetable oils, and manufacturing breakfast cereals.</skos:definition>
  </rdf:Description>
