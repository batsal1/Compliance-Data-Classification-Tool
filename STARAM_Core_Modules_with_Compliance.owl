  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCMbCsfImEf6Qw94nFcIfw5">
    <rdfs:label>Business Executive</rdfs:label>
    <skos:definition>A business executive is someone holding a senior management position within a company or organization, responsible for making strategic decisions and overseeing the implementation of the company's policies and objectives. Executives typically include roles such as Chief Executive Officer (CEO), Chief Information Officer (CIO), Senior Vice President (SVP), and Vice President (VP), among others.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Executive</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RkIejtiO3CUzgQe98NWyPq"/>
  </rdf:Description>
