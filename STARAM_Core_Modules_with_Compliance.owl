    <skos:altLabel xml:lang="ja-jp">食品、医薬品、化粧品法の請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações da Lei de Alimentos, Medicamentos e Cosméticos</skos:altLabel>
