    <skos:altLabel xml:lang="zh-cn">顾问赔偿条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de indemnización del consultor</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de indemnización del consultor</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">コンサルタントの免責条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de indenização do consultor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פיצויי ייעוץ</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">परामर्शदाता शर्त का भरण-पोषण</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'indemnisation du consultant</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A clause in a contract that requires one party to compensate and protect a consultant from any losses, damages, or liabilities that may arise from their work on the project.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9oz08cWJcI23x0nYU1h0it"/>
