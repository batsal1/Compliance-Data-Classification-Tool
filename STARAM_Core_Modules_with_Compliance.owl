  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9nScyslqPFi8SLLbzFmp7a">
    <skos:altLabel xml:lang="en-gb">Effective Date of Resignation Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Data Efetiva de Rescisão</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wirksamkeitsdatum der Rücktrittsklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">辞职条款生效日期</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इस्तीफ़ा की प्रभावी तिथि धारा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de fecha efectiva de renuncia</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תאריך התפטרות יעיל</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">辞任条項の効力発生日</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de date d'effet de démission</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de fecha efectiva de renuncia</skos:altLabel>
    <skos:definition>An Effective Date of Resignation Clause is a provision in a contract that specifies the date on which a resignation will become effective.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCu23ODfsnYICpdMNOQUDJV"/>
    <rdfs:label>Effective Date of Resignation Clause</rdfs:label>
  </rdf:Description>
