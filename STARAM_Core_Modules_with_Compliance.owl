  <rdf:Description rdf:about="https://folio.openlegalstandard.org/4aVTFB2KRyiXg_2OC2xxKg">
    <rdfs:label>Forest Nurseries and Gathering of Forest Products</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in (1) growing trees for reforestation and/or (2) gathering forest products, such as gums, barks, balsam needles, rhizomes, fibers, Spanish moss, ginseng, and truffles.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=113210"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_GX1xrnES226fbq1FpHXxw"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R78bV0IQasgnKfZBYYexReQ">
    <skos:definition>A Dormant Commerce Clause claim is a legal argument asserting that a state law or regulation violates the United States Constitution by burdening or discriminating against interstate commerce. This claim is based on the interpretation that the Commerce Clause not only grants Congress the power to regulate commerce but also implies a limitation on state interference with interstate commerce.</skos:definition>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Comercio Inactivo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निष्क्रिय वाणिज्य अनुबंध दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">休眠商业条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dormant Commerce Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da cláusula de comércio inativo</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Comercio Inactivo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de la clause de commerce dormant</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף המסחר המיושן</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">休眠商業条項クレーム</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klage wegen Verstoßes gegen die Handelsklausel im Ruhezustand</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwipRpN2mP7u4u1N74MVzK"/>
    <rdfs:subClassOf rdf:nodeID="N4da6b660c9444611a7d2a5bd15631d25"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dormant Commerce Clause Claim</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-scope-specifications">
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-pre-award"/>
    <skos:prefLabel xml:lang="en">Scope of Work &amp; Specifications</skos:prefLabel>
    <skos:broadMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-site-design"/>
    <skos:definition xml:lang="en">Risks arising from what the contractor is deemed to have priced and designed, covering the boundaries of the scope, the split of design responsibility, the order of priority among specifications, items supplied by the employer, and reliance on tender data.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <rdfs:label xml:lang="en">Scope of Work &amp; Specifications</rdfs:label>
    <skos:notation>LR-02</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBzyAZSWSminpeYOtt7zD3F">
    <rdfs:label>Dispositive Motion Practice</rdfs:label>
    <skos:altLabel xml:lang="hi-in">डिस्पोजिटिव मोशन प्रैक्टिस</skos:altLabel>
    <skos:altLabel>Dispositive Motion</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול תנועות זכות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de mociones dispositivas</skos:altLabel>
    <skos:altLabel>Dispositive Motion Service</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">裁定性动议程序</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">判決的動議手続き</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de mociones dispositivas</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Procédure de motion dispositive</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de movimento dispositivo</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dispositive Motion Practice</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Bewegungsverfahren zur Entscheidung über den Streitgegenstand</skos:altLabel>
    <skos:definition>Dispositive Motion Practice refers to the legal process of requesting a court to make a final decision on a case before trial, based on the evidence and arguments presented in pretrial motion practice.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCYi6mS48NndWCB54a2jYhR"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/3oStfX6KTNC8RhcgP7idZQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/izHd477aT66zkGjiRDvi4Q"/>
    <skos:definition>See industry description for 112930.</skos:definition>
    <rdfs:label>Fur-Bearing Animal and Rabbit Production</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=11293"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N58b79a3f767849dbaa8d4a7e344718d0">
