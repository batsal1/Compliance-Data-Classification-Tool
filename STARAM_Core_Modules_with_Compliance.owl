  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCEvn4X1QQvn9BjOTtKwPzC">
    <rdfs:label>"Constructive Knowledge - Knowledge Limited to Identified Persons" Language</rdfs:label>
    <rdfs:label>Material Adverse Effect Definition - "Knowledge Limited to Identified Persons" Language</rdfs:label>
    <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Lenguaje "Conocimiento Limitado a Personas Identificadas"</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">实质不利影响定义 - "知识仅限于已确定人员"语言</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de l'effet indésirable important - Langue "Connaissance limitée aux personnes identifiées"</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Linguagem "Conhecimento Limitado a Pessoas Identificadas"</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-「特定の人物に限定された知識」言語</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मददगार विपरीत प्रभाव परिभाषा - "पहचानी गई व्यक्तियों तक सीमित ज्ञान" भाषा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Lenguaje "Conocimiento Limitado a Personas Identificadas"</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition des wesentlichen nachteiligen Effekts - Sprache "Wissen beschränkt auf identifizierte Personen"</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - "Knowledge Limited to Identified Persons" Language</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת השפעה נזיקה חומרית - שפת "ידיעה מוגבלת לאנשים מזוהים"</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCrshoNA9Tc4Xswrj0v8nqX"/>
    <skos:definition>A Material Adverse Effect (MAE) Definition - "Knowledge Limited to Identified Persons" Language refers to a clause in a legal agreement that limits the scope of knowledge to only those individuals who have been identified in the agreement, and defines the circumstances under which a material adverse effect can occur.</skos:definition>
    <skos:definition>"Knowledge Limited to Identified Persons" Language refers to a clause in a legal agreement that limits the scope of knowledge to only those individuals who have been identified in the agreement, and defines the circumstances under which a material adverse effect can occur.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RepzuKaD1tTAVt1HZzq1U4">
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdfs:label>Indigent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source rdf:resource="https://taxonomy.legal/"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nREeU6lB0zs0dt9N339nm"/>
    <skos:altLabel>Destitute</skos:altLabel>
    <skos:altLabel>Impoverished</skos:altLabel>
    <skos:definition>Indigent refers to an individual who is financially unable to afford the basic necessities of life, including the costs associated with legal proceedings. In a legal context, indigent status may qualify a person for free legal representation or the waiver of court fees under the principle of in forma pauperis.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/slpOVd0CQrmGGWLSAj38kA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333514"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/tEn-M7tEQwSDoAaEWhntrQ"/>
    <skos:definition>This U.S. industry comprises establishments, known as tool and die shops, primarily engaged in manufacturing special tools and fixtures, such as cutting dies and jigs.</skos:definition>
    <rdfs:label>Special Die and Tool, Die Set, Jig, and Fixture Manufacturing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb6d7d78d6c154a18a3bbd56b55180cba">
