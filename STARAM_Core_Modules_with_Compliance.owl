  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7tmFaJ5bsx906wMXGpQxWf">
    <skos:altLabel xml:lang="zh-cn">地役权协议条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de acuerdo de servidumbre</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इज़्ज़मेंट समझौता धारा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Easement Agreement Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de acordo de servidão</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Dienstbarkeitsvereinbarungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">地役権契約条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכם זכות עבר</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de acuerdo de servidumbre</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'accord de servitude</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Easement Agreement Clause</rdfs:label>
    <skos:definition>A provision in a contract that grants a non-possessory interest in another's land, allowing the holder to use the land for a specific purpose.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbf306f993b1c48f2baacb1a45ddaf8d2">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
