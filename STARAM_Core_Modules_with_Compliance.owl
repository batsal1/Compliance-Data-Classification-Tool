  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RoA3iT57OSgVnM982fPGUE">
    <skos:altLabel xml:lang="es-es">Refutación de la Presunción de Dificultad Excesiva</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרעון של הנחת הקשיים המופרזים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réfutation de la présomption de difficultés excessives</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Widerlegung der Vermutung unangemessener Härte</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">驳回不当困难推定</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過度な困難の推定の反論</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Refutação da Presunção de Dificuldade Excessiva</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुचित कठिनाई के प्रति अनुमान का खंडन</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Rebuttal of Presumption of Undue Hardship</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Refutación de la Presunción de Dificultad Excesiva</skos:altLabel>
    <skos:definition>The Rebuttal of Presumption of Undue Hardship is a legal argument made in the context of bankruptcy and restructuring proceedings by a debtor seeking to prove that they are not able to repay their debts without experiencing undue hardship, despite the presumption that they are able to do so.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Rebuttal of Presumption of Undue Hardship</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RXjDfewdQzKTt5d3klR5N6">
    <skos:altLabel xml:lang="ja-jp">純利益条項の定義</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de la cláusula de beneficios netos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de la cláusula de beneficios netos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">净利润条款定义</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Definition of Net Profits Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition der Nettogewinnklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नेट लाभ शर्त की परिभाषा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת סעיף רווחי נטו</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de la clause de bénéfice net</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição da cláusula de lucro líquido</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Net Profits Clause is a provision in a contract that specifies how profits will be calculated and distributed among parties involved, after deducting expenses and taxes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Definition of Net Profits Clause</rdfs:label>
  </rdf:Description>
