  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP">
    <skos:altLabel xml:lang="en-gb">Material Adverse Effect Language</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Efeito Material Adverso</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause sur les effets défavorables importants</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव भाषा</skos:altLabel>
    <skos:altLabel>Deal Language</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Lenguaje de Efecto Adverso Material</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שפת השפעה נגדית חומרית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu wesentlichen nachteiligen Auswirkungen</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lenguaje de Efecto Adverso Material</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大な不利益事象に関する条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">重大不利影响条款</skos:altLabel>
    <rdfs:label>Deal Language</rdfs:label>
    <rdfs:label>Material Adverse Effect Language</rdfs:label>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDRCaFxX4hpUklgNnVS9D8C"/>
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
    <skos:definition>Material Adverse Effect (MAE) Language refers to a legal provision in mergers and acquisitions contracts that outlines specific circumstances or events that would have a significant negative impact on the value or operations of the target company, and may allow the acquiring party to terminate the agreement or renegotiate the terms.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9hhrrXatORR9EqD2UdC83r">
    <skos:altLabel xml:lang="de-de">Vermeidung von gesetzlichen Pfandrechten</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Evitación de gravámenes estatutarios</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">避免法定留置权</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法定抵当権の回避</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Evitación de gravámenes estatutarios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विधायी लियन्स से बचाव</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Avoidance of Statutory liens</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Evitação de ônus estatutários</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Évitement des privilèges légaux</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הימנעות מטעני חוקיים</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx"/>
    <skos:definition>The concept of "Avoidance of Statutory Liens" refers to the legal action taken to prevent the enforcement of liens that are created by statute.</skos:definition>
    <rdfs:label>Avoidance of Statutory liens</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Q9UwwMRvTKulazK8X3L2WQ">
    <rdfs:label>All Other Specialty Food Retailers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Spice retailers</skos:example>
    <skos:example>Water (i.e., bottled) retailers</skos:example>
    <skos:example>Gourmet food retailers</skos:example>
    <skos:example>Coffee and tea (i.e., packaged) retailers</skos:example>
    <skos:example>Dairy product retailers</skos:example>
    <skos:example>Soft drink (i.e., bottled) retailers</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/n2Xua3toTk-SP2X5h4LEPg"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in retailing miscellaneous specialty foods (except fruit and vegetables, meat, fish, seafood, confections, nuts, popcorn, and baked goods) not for immediate consumption and not made on the premises.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=445298"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9yAfEbh23CiaQybRUqwIpB">
    <skos:altLabel xml:lang="ja-jp">単一共同鑑定人</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Expert unique commun</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מומחה משותף יחיד</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">单一共同专家</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Single Joint Expert</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Experto Único Conjunto</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Einzelner gemeinsamer Sachverständiger</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Experto Único Conjunto</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Perito Único Comum</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एकल संयुक्त विशेषज्ञ</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Single Joint Expert</rdfs:label>
    <skos:definition>An expert who prepares a report or testimony on behalf of two or more parties.</skos:definition>
