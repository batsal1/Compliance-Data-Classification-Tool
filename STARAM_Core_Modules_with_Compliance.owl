  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9NiI0Gvzg2pByWBg0Auf4s">
    <skos:altLabel xml:lang="es-es">Ayudar o Fomentar</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Auxílio ou incentivo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">援助または励まし</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Assisting or Encouraging</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unterstützung oder Ermutigung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">协助或鼓励</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סיוע או עידוד</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Asistir o Fomentar</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सहायता या प्रोत्साहन</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Assistance ou encouragement</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5jFFdAx82IJWPe4JDkFqg"/>
    <skos:definition>Assisting or Encouraging refers to the act of aiding or abetting someone in the commission of a crime or wrongdoing.</skos:definition>
    <rdfs:label>Assisting or Encouraging</rdfs:label>
  </rdf:Description>
