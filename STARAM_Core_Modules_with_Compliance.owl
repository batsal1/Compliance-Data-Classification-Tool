  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC0mco4vTHaJiBJtqbaq90J">
    <rdfs:label>Human-Centric AI</rdfs:label>
    <skos:prefLabel>Human-Centered AI</skos:prefLabel>
    <skos:altLabel>User-Centric AI</skos:altLabel>
    <skos:altLabel>Human-Oriented AI</skos:altLabel>
    <skos:altLabel>People-Centric AI</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Human-Centric AI, also known as human-centered AI, is an approach to designing, deploying, and using AI systems that considers them as integral components of socio-technical environments where humans maintain meaningful agency. This approach prioritizes enhancing human capabilities rather than replacing them and is promoted in policy, research, and engineering to develop AI systems that serve human beings and increase human and environmental well-being by upholding human rights, the rule of law, democratic values, and sustainable development.</skos:definition>
  </rdf:Description>
