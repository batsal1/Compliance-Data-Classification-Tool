    <skos:prefLabel>wasInvolvedIn</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition>"Participated in" within a legal framework refers to active involvement in a legal proceeding or activity, such as a hearing, deposition, or negotiation. This term encompasses not just physical presence but also engagement in the process, contributing through actions like presenting arguments, giving testimony, or collaborating in discussions.</skos:definition>
    <skos:notation>folio:contributedTo</skos:notation>
    <skos:notation>folio:tookPartIn</skos:notation>
