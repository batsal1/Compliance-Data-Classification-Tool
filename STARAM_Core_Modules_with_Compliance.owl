    <skos:definition>A Noncompete Agreement is a legal contract between an employer and an employee that restricts the employee from working for a competitor or starting a competing business for a certain period of time after leaving the employer.</skos:definition>
    <rdfs:label>Noncompete Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Restrictive Covenants &amp; Confidentiality</ns1:contractFamily>
