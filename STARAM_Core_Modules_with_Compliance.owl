  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R6GdImTfvAkLWGgffIApLX">
    <skos:altLabel xml:lang="es-es">Reclamación de cláusula de disposición</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विनियोजन धारा दावा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Disposing Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verfügungsklauselanspruch</skos:altLabel>
