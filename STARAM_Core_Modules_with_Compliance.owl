    <rdfs:label>LINE_ITEM_TAX_RATE</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The LINE_ITEM_TAX_RATE concept refers to the tax rate applied to a specific line item in a legal invoice, as defined in the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
  </rdf:Description>
