  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Khki8ppxTRGAhcG41_WwVg">
    <skos:example>Optometric equipment and supplies merchant wholesalers</skos:example>
    <skos:example>Ophthalmic lenses merchant wholesalers</skos:example>
    <skos:example>Binoculars merchant wholesalers</skos:example>
    <skos:example>Sunglasses merchant wholesalers</skos:example>
    <skos:example>Ophthalmic frames merchant wholesalers</skos:example>
    <rdfs:label>Ophthalmic Goods Merchant Wholesalers</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of professional equipment, instruments, and/or goods sold, prescribed, or used by ophthalmologists, optometrists, and opticians.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423460"/>
