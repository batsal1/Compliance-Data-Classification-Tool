    <skos:altLabel>Chapter 15</skos:altLabel>
    <skos:altLabel>US Chapter 15</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">米国第15章破産</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">美国第15章破产</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falência do Capítulo 15 dos EUA</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यूएस अध्याय 15 दिवाला</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">US Chapter 15 Bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פשיטת רגל פרק 15 של ארצות הברית</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Quiebra del Capítulo 15 de Estados Unidos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faillite du chapitre 15 des États-Unis</skos:altLabel>
    <skos:altLabel xml:lang="de-de">US-Kapitel 15 Insolvenz</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Quiebra del Capítulo 15 de los Estados Unidos</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Proc-B-USCHAP15</ns2:legacyIdentifier>
    <skos:definition>Chapter 15 bankruptcy provides a way of dealing with cases that involve more than one country. The main goal of chapter 15 is to provide cooperation between a foreign debtor, foreign courts and the U.S. bankruptcy courts.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdfs:label>US Chapter 15 Bankruptcy</rdfs:label>
