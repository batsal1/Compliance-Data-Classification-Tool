  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R92ZtAE3Z0T99TYMcgS3wfY">
    <rdfs:label>Sound Recording Industry</rdfs:label>
    <skos:altLabel xml:lang="he-il">תעשיית הקלטת צלילים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">音频录制产业</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de la grabación de sonido</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie de l'enregistrement sonore</skos:altLabel>
