  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC2JPrQA6cnTxlMCLiWYuCP">
    <skos:altLabel xml:lang="zh-cn">相互豁免所有索赔条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur gegenseitigen Freistellung von allen Ansprüchen</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">全請求相互放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सभी दावों के संबंध में सहमति रिहाई धारा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שחרור משותף מכל טענות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mutual Release of All Claims Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Liberación Mutua de Todas las Reclamaciones</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Liberación Mutua de Todas las Reclamaciones</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de liberação mútua de todas as reivindicações</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de libération mutuelle de toutes les revendications</skos:altLabel>
    <skos:definition>A Mutual Release of All Claims Clause is a legal provision that releases both parties from any and all claims against each other, as specified in a contract or agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mutual Release of All Claims Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97MkMdKZEGmlgj6msDMIkq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rd7uelGFqCTWSgf9lWki5N">
    <skos:prefLabel>Surveillance Claims</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="N6bc01917e53d4610a1363efee58591bc"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:nodeID="Nd706351fe4c4485aa1f892e254ceaa41"/>
    <rdfs:subClassOf rdf:nodeID="N144bd83bd6a34909baa1d038fede9915"/>
    <skos:altLabel xml:lang="es-es">Reclamaciones de privacidad</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">プライバシー主張</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गोपनीयता दावे</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de privacidade</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Datenschutzansprüche</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Privacy Claims</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">隐私权主张</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות פרטיות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendications de confidentialité</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandas de privacidad</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Privacy Claims</rdfs:label>
    <skos:definition>A Privacy Claim is a civil claim that seeks to protect an individual's right to privacy, including claims related to the unauthorized disclosure of personal information, invasion of privacy, and violations of confidentiality by healthcare providers.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RRtrQww7hpTBnO6oSm7Bj1">
    <skos:prefLabel>Nursing and Residential Care Facilities Industry</skos:prefLabel>
    <skos:altLabel xml:lang="he-il">תעשיית מתן שירותי סיעוד וטיפול בבתי מגורים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pflege- und Altenheimbranche</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de cuidados residenciales y de enfermería</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de cuidados residenciales y de enfermería</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">介護施設および居住施設産業</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie des établissements de soins infirmiers et résidentiels</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Nursing and Residential Care Facilities Industry</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de cuidados de enfermagem e residenciais</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नर्सिंग और आवासीय देखभाल संस्थाओं उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">护理和养老院行业</skos:altLabel>
    <skos:altLabel>Nursing and Residential Care Facilities</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <rdfs:label>Nursing and Residential Care Facilities Industry</rdfs:label>
    <dc:identifier>IN-INDUSTRY-9.3</dc:identifier>
    <dc:identifier>HTC-RESC</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Industries in this group provide residential care combined with either nursing, supervisory, or other types of care as required by the residents. In this subsector, the facilities are a significant part of the production process and the care provided is a mix of health and social services with the health services being largely some level of nursing services.</skos:definition>
    <skos:hiddenLabel>RESC</skos:hiddenLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-HTC-RESC</ns2:legacyIdentifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSG4k3ah1Pu5YgPexPgOmL"/>
  </rdf:Description>
