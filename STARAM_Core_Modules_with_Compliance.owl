  <rdf:Description rdf:about="https://folio.openlegalstandard.org/K6yDqdA2RZ6ghPqUEFA-ng">
    <rdfs:label>Direct Mail Advertising</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541860"/>
    <skos:definition>This industry comprises establishments primarily engaged in (1) creating and designing advertising campaigns for the purpose of distributing advertising materials (e.g., coupons, flyers, samples) or specialties (e.g., keychains, magnets, pens with customized messages imprinted) by mail or other direct distribution and/or (2) preparing such advertising materials or specialties for mailing or other direct distribution. These establishments may also compile, maintain, sell, and rent mailing lists.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/wLAgU8Z_RtusJm-rni0-MA"/>
  </rdf:Description>
