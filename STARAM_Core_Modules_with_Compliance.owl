    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <skos:altLabel>Financially Motivated Buyer</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वित्तीय प्रायोजक</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Financial Sponsor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מממן פיננסי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Finanzsponsor</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">財政スポンサー</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Patrocinador financiero</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Patrocinador financiero</skos:altLabel>
    <skos:altLabel>Financially Driven Buyer</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Parrain financier</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Patrocinador financeiro</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">财务赞助商</skos:altLabel>
    <skos:definition rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
    <skos:definition>An M&amp;A financially driven buyer is an individual or entity, such as a private equity firm or an investment fund, that pursues mergers and acquisitions with the primary goal of generating financial returns on their investment.</skos:definition>
    <rdfs:label>Financial Sponsor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
