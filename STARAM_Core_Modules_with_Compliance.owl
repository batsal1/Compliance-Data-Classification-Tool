  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4LpdDnZFT9aL3g1mpg4AK">
    <skos:altLabel xml:lang="de-de">Persönliche Zuständigkeit durch Erscheinen</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">出廷による個人管轄権</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपस्थिति द्वारा व्यक्तिगत अधिकरण</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción personal por comparecencia</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Jurisdicción personal por comparecencia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Appearance</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">出庭个人管辖权</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par comparution</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por comparecimento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שיפוט אישי על ידי הופעה</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Personal Jurisdiction by Appearance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7X4vuBVsbGf69DAu7Xotdw"/>
    <skos:definition>The concept of "Personal Jurisdiction by Appearance" refers to the authority of a court to hear a case against a defendant who has voluntarily appeared before the court, even if they do not have a physical presence in the court's jurisdiction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6587bf1f5a5a4e35bb7be1f9c54eb1e5">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCDa7IsUxl4AA7e5KylzJYK"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDdz3J6xqNZfHwiRt3aSLCr">
    <rdfs:label>Property Surface Right</rdfs:label>
    <skos:definition>Property Surface Right refers to the legal entitlement to use and control the surface of a piece of land, but not the air above it or the minerals below it. This right is often relevant in land leasing situations, such as when the subsurface rights are leased for mineral extraction while the surface rights are used for agricultural or residential purposes</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R75Bx0QJin6XW4ki2c8pJGw"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <skos:altLabel>Surface Right</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6a4d1dbd56ac48748c05cb64cca498b9">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Severability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/WE8R2zm6TZ6Et7qfPN-BvQ">
    <skos:example>Roof trusses, wood, manufacturing</skos:example>
    <skos:example>Waferboard manufacturing</skos:example>
    <skos:example>Fabricated structural wood members manufacturing</skos:example>
    <skos:example>Veneer mills</skos:example>
    <skos:example>Oriented strandboard (OSB) manufacturing</skos:example>
    <skos:example>Laminated structural wood members manufacturing</skos:example>
    <skos:example>Reconstituted wood sheets and boards manufacturing</skos:example>
    <skos:example>Medium density fiberboard (MDF) manufacturing</skos:example>
    <skos:example>Particleboard manufacturing</skos:example>
    <skos:example>Plywood manufacturing</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing veneer and/or plywood; (2) manufacturing engineered wood members; and (3) manufacturing reconstituted wood products.  This industry includes manufacturing plywood from veneer made in the same establishment or from veneer made in other establishments, and manufacturing plywood faced with nonwood materials, such as plastics or metal.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/mzdEFGAxSlGIr0T3i4lKlw"/>
    <rdfs:label>Veneer, Plywood, and Engineered Wood Product Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32121"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/kdlpY0RtSFq1KzyPx48fCw">
    <rdfs:label>Other Marine Fishing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/feRSrU7jSMuNLYyfCK3qcg"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=114119"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in the commercial catching or taking of marine animals (except finfish and shellfish).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf57c30a29c824ba69623b46f22e876b6">
