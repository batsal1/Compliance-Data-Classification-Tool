  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDV2029Q3Zi4LQ1ehMJNj3w">
    <skos:definition>Patent Concept Objectives encompass key criteria like Novelty, Obviousness, and Inventive Step that an invention must satisfy to be patentable. These objectives ensure the invention is new, non-obvious, and represents a significant step beyond existing knowledge or technology.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzy5rvrKtuL8AwKrBTFfBQ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:label>Patent Concept Objectives</rdfs:label>
  </rdf:Description>
