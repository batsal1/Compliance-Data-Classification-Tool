  <rdf:Description rdf:about="https://folio.openlegalstandard.org/XeptDScoS8CB-Ifcp_X52g">
    <skos:definition>This industry comprises establishments primarily engaged in cutting, forming, and joining heavy gauge metal to manufacture tanks, vessels, and other containers.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=332420"/>
    <rdfs:label>Metal Tank (Heavy Gauge) Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_Rr8AO61RoSSxoIg4WjR5A"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
