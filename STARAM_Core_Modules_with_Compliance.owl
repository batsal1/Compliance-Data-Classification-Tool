  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBgbDi79oDGxVYXpQrVf2PW">
    <rdfs:label>Demonstrative Bequest</rdfs:label>
    <skos:altLabel>Source-Specified Bequest</skos:altLabel>
    <skos:altLabel>Fund-Designated Bequest</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3OI7nrib1LEPtUfn5G5CH"/>
    <skos:definition>A Demonstrative Bequest is a provision in a will or trust that designates a specific monetary amount or asset to be paid or distributed from a particular source within the estate. This type of bequest combines elements of both specific and general bequests, specifying the source while also ensuring a fixed amount is given to the beneficiary.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
