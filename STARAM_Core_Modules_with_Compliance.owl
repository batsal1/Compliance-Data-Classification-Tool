  <rdf:Description rdf:about="https://folio.openlegalstandard.org/MyQL1VP2RnyEZR-OEZsF6g">
    <skos:example>Acupuncturists' (except MDs or DOs) offices</skos:example>
    <skos:example>Hypnotherapists' offices</skos:example>
    <skos:example>Naturopaths' offices</skos:example>
