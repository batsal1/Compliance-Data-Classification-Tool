  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9rzAcb98kMv9DcfxdeGaYW">
    <rdfs:label>bill_to_cl_name</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHfeijrOTjaF7qpuoGIGkR"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"The name of the party being billed on the invoice.  

The legal name of the party being billed may be different from the CLIENT.cl_name, and the INVOICE.tax_invoice_cl_name.  In some jurisdictions it may be required by law to provide this information.
"</skos:definition>
  </rdf:Description>
