  <rdf:Description rdf:about="https://folio.openlegalstandard.org/gYrwkWHETsSEhTvtP8Bb2Q">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=7223"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8RJIpODageO9V5kZNQgKns"/>
    <rdfs:label>Special Food Services</rdfs:label>
    <skos:definition>This industry group comprises establishments primarily engaged in providing food services at one or more of the following locations: (1) the customer's location; (2) a location designated by the customer; or (3) from motorized vehicles or nonmotorized carts.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9jNLx5iR4vOfU2Gp8bOZ3K">
    <skos:altLabel xml:lang="en-gb">Negligent Interference with Good Samaritan</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Ingérence négligente avec le bon samaritain</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過失による善意の行為妨害</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia negligente con el buen samaritano</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Störung des guten Samariters</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התערבות שלא ברצון עם סמרטן טוב</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia negligente con el buen samaritano</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência negligente com o bom samaritano</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उत्तीर्ण समरितन के साथ लापरवाही संबंधी</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过失干涉善意施行者</skos:altLabel>
    <rdfs:label>Negligent Interference with Good Samaritan</rdfs:label>
    <skos:definition>Negligent Interference with Good Samaritan: A claim of negligence that arises when a person who is rendering aid to another is prevented from doing so by the negligent actions of a third party.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdfs:subClassOf rdf:nodeID="Nc0dcf35ef8764f3c86da9fb086d54013"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
