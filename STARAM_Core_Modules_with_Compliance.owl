    <rdfs:subClassOf rdf:nodeID="N7926323149d34ca79a1911c449a642c6"/>
    <rdfs:subClassOf rdf:nodeID="Ne5918c3db8ca4ab39db375efd9926ac4"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCGW5RFfjJ95ygeSCJLaJQT"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdfs:subClassOf rdf:nodeID="Naf3d96c458504c6492a067ec841b0379"/>
    <rdfs:subClassOf rdf:nodeID="N6d812bc7caad436fbc000b51e65e60f5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The liability of a principal or promoter for a real estate broker's commission due to bad faith, where the principal or promoter acted with dishonesty or deceit in the transaction, resulting in the broker not receiving the commission they were entitled to.</skos:definition>
  </rdf:Description>
