    <skos:altLabel xml:lang="es-es">Ley de Protección al Consumidor</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei de Proteção ao Consumidor</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Loi sur la protection des consommateurs</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verbraucherschutzgesetz</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <skos:definition>Law that creates a more equitable balance for buyers in the marketplace and prevents sellers from using dishonest tactics.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:hiddenLabel>CSMR</skos:hiddenLabel>
