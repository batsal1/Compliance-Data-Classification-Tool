  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCJnPLsPjR3hyvnxdMnNOZ2">
    <skos:altLabel xml:lang="de-de">Vertragsbruch wegen Nichterfüllung der Gegenleistung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de contrato por falta de contraprestación</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוזה עקב כשל בתמורה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Contract for Failure of Consideration</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">対価不履行による契約違反</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未履行合同违约</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विचार की कमी के कारण अनुबंध उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de contrat pour défaut de contrepartie</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Quebra de contrato por falha na contraprestação</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato por falta de contraprestación</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC2fjcpsEbrVvVymvt4oASx"/>
    <skos:definition>The Breach of Contract for Failure of Consideration refers to a situation where one party fails to fulfill their contractual obligations due to a lack of consideration from the other party.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Breach of Contract for Failure of Consideration</rdfs:label>
  </rdf:Description>
