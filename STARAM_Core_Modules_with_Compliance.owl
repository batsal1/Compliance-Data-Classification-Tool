    <skos:altLabel xml:lang="he-il">סעיף אבטחת מידע</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de seguridad de datos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de segurança de dados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Data Security Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de sécurité des données</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Datensicherheitsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de seguridad de datos</skos:altLabel>
    <rdfs:label>Data Security Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
