    <skos:altLabel>Repo</skos:altLabel>
    <rdfs:label>Repurchase Agreement</rdfs:label>
    <skos:definition>Often referred to as a "repo," a Repurchase Agreement is a short-term borrowing mechanism where one party sells a security with an agreement to repurchase it at a later date at a specified price. It's effectively a secured loan.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">M&amp;A / Transactional</ns1:contractFamily>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4eff8d57a7544b9d8a788f8a378358a4">
    <owl:hasValue rdf:resource="https://staram.in/ontology/epc/taxonomy#impact-cost"/>
