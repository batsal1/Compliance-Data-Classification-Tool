    <skos:altLabel xml:lang="es-mx">Acuerdo de outsourcing</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Acordo de terceirização</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de externalización</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">アウトソーシング契約</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord d'externalisation</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">外包协议</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם חיצוניות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आउटसोर्सिंग समझौता</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Outsourcing Agreement</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Outsourcing-Vereinbarung</skos:altLabel>
    <rdfs:label>Outsourcing Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Services &amp; Outsourcing</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Outsourcing Agreement is a legal contract between two parties where one party hires another to perform a specific task or service on their behalf, typically involving the transfer of certain responsibilities or functions outside of the organization.</skos:definition>
  </rdf:Description>
