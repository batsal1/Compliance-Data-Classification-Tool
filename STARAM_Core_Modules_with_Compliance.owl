    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8uoc2fGReblZYERcaEgDBS"/>
    <skos:definition>A Hostile Work Environment is a type of work environment harassment where an employee is subjected to unwelcome and discriminatory behavior or conduct that is severe or pervasive enough to create an intimidating, hostile, or offensive work environment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
