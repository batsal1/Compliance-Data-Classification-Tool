  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9xrJpkUfwWXkTHxpfpQti8">
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo Completo</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכם מלא</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'accord complet</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo Completo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur vollständigen Vereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">完全合意条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de acordo completo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">完整协议条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Complete Agreement Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्ण समझौता शर्त</skos:altLabel>
    <skos:definition>A Complete Agreement Clause is a provision in a contract that states that the written agreement represents the entire understanding between the parties and supersedes any prior negotiations or agreements.</skos:definition>
    <rdfs:label>Complete Agreement Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDxzg63NGLFwNerYan92uQp">
    <skos:altLabel xml:lang="pt-br">Cláusula de garantia de desempenho</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">履约保证条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">履行保証条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de garantie de performance</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הבטחת ביצועים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Leistungsgarantie</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Performance Guarantee Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de garantía de desempeño</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de garantía de rendimiento</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रदर्शन गारंटी शर्त</skos:altLabel>
    <skos:definition>A Performance Guarantee Clause is a provision in a contract that ensures the completion of a specific task or obligation, with a promise to compensate the other party if the task is not completed as agreed.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9AWyeN2nDxzohSVj4jX8ho"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RClEPD3LQVJMcRPGY9oXVXU"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Performance Guarantee Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8ce20bccaee547848848cbe7fb5ac5e0">
