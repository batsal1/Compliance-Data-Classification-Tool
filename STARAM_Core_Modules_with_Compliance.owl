  <rdf:Description rdf:about="https://folio.openlegalstandard.org/MxqCpjotTOOzWUyA1OUjww">
    <skos:example>Motorcycle dealers</skos:example>
    <skos:example>All-terrain vehicle (ATV) dealers</skos:example>
    <skos:example>Utility trailer dealers</skos:example>
    <skos:example>Aircraft dealers</skos:example>
    <skos:example>Snowmobile dealers</skos:example>
    <skos:example>Motorcycle parts and accessories dealers</skos:example>
    <skos:example>Personal watercraft dealers</skos:example>
    <skos:example>Moped dealers</skos:example>
    <skos:example>Powered golf cart dealers</skos:example>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in retailing new and/or used motorcycles, motor scooters, motorbikes, mopeds, off-road all-terrain vehicles (ATV), personal watercraft, utility trailers, and other motor vehicles (except automobiles, light trucks, recreational vehicles, and boats) or retailing these new vehicles in combination with activities, such as repair services and selling replacement parts and accessories.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=441227"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/aHmszoloS-yGNU0lp8sTYg"/>
    <rdfs:label>Motorcycle, ATV, and All Other Motor Vehicle Dealers</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDN7bio8UsCmImnSv1JZL6D">
    <rdfs:label>Negligent Retention</rdfs:label>
    <skos:altLabel xml:lang="hi-in">लापरवाह रखरखाव</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Retenção negligente</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Retención negligente</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Rétention négligente</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Retention</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过失保留</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Retención negligente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過失保持</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שמירה שלא ראויה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Aufbewahrung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Negligent Retention refers to a legal claim that an employer was negligent in retaining an employee who they knew or should have known posed a risk of harm to others.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RsYpnraUs1U88jsurZg4il">
    <skos:altLabel xml:lang="he-il">הוצאות פקס</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Faxkosten</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फैक्स खर्च</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Frais de télécopie</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Despesa de fax</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Facsimile Expense</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Gasto de fax</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הוצאות פקסימילי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ファクシミリ費用</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">传真费用</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Gasto de fax</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
    <skos:definition>A facsimile expense is a type of expense that refers specifically to the cost of sending or receiving documents via fax, and is considered a subcategory of general expenses.</skos:definition>
    <rdfs:label>Facsimile Expense</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ttttUKP_Q12sjEBKqykahA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=562111"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/k29SeRbeSnSCZ2dV8f6XVQ"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) collecting and/or hauling nonhazardous solid waste (i.e., garbage) within a local area; (2) operating nonhazardous solid waste transfer stations; and (3) collecting and/or hauling mixed recyclable materials within a local area.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Solid Waste Collection</rdfs:label>
  </rdf:Description>
