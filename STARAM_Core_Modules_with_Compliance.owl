  <rdf:Description rdf:nodeID="Ne5806c4ebc26499391f8bc3d0d8e185b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:hasValue rdf:resource="https://staram.in/ontology/epc/taxonomy#defect-onerous"/>
