    <skos:altLabel xml:lang="fr-fr">Industrie de la pêche, de la chasse et du piégeage</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मछली पकड़ने, शिकार और फंसाने की उद्योग</skos:altLabel>
    <skos:altLabel>Fishing, Hunting and Trapping</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">渔业、狩猎和捕捉行业</skos:altLabel>
