  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RsN5jMsiqL57uIZtgve6CB">
    <skos:definition>A Withdrawal of Union Shop Authority (UD) Claim is a legal action initiated by an employer or labor organization to terminate or modify a union shop arrangement, which requires all employees in a bargaining unit to become union members as a condition of employment. This claim often arises in the context of changes in labor relations or challenges to the legality of union security clauses.</skos:definition>
    <rdfs:label>Withdrawal of Union Shop Authority Claim</rdfs:label>
    <skos:prefLabel>Union Deauthorization Claim</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
  </rdf:Description>
