  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCvQU2fvoNVPyE33SCK0d9Q">
    <rdfs:label>Wiretap Claims</rdfs:label>
    <skos:altLabel xml:lang="he-il">תביעות חקירת תקשורת</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de escuta telefônica</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वायरटैप दावे</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Abhöransprüche</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">窃听索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de escuchas telefónicas</skos:altLabel>
    <skos:altLabel>Illegal Recording Claims</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ワイヤータップ請求</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendications d'écoute électronique</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones de intervención de comunicaciones</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Wiretap Claims</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rd7uelGFqCTWSgf9lWki5N"/>
    <skos:definition>A wiretap claim is a civil claim that alleges the illegal interception of electronic communications, such as phone calls or emails.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RriGmZKwv4jK5icHz7p0Ws">
    <skos:altLabel xml:lang="es-es">No uso del cinturón de seguridad</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Não utilização do cinto de segurança</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未使用安全带</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Non-utilisation de la ceinture de sécurité</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוסר שימוש בחגורת הבטיחות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">No uso del cinturón de seguridad</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure To Use a Seatbelt</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">シートベルトの着用怠り</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nichtanlegen des Sicherheitsgurts</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सीटबेल्ट का उपयोग न करना</skos:altLabel>
    <rdfs:label>Failure To Use a Seatbelt</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:subClassOf rdf:nodeID="N3b919bc6b83f4bcba674dc969b03036a"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The failure to use a seatbelt refers to the act of not wearing a safety belt while driving or riding in a vehicle, which can be used as a defense in civil litigation cases.</skos:definition>
  </rdf:Description>
