  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7HpHL4HNvWhmv9GMhimDmR">
    <skos:definition>A service agreement is an agreement between two persons or businesses where one agrees to provide a specified service to the other. It can also be an express undertaking of employment signed by both the employer and the employee detailing therein the explicit terms and conditions of service. A service agreement is different from a bond. A service agreement binds both the parties to the agreement, whereas bond is one sided and binds the employee to the agreement only.</skos:definition>
    <skos:altLabel xml:lang="he-il">תרגול הסכם שירותים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Services Agreement Practice</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de Acordo de Serviços</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de l'accord de services</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">サービス契約実務</skos:altLabel>
    <skos:altLabel>Services Agreement Service</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">服务协议实践</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de Acuerdo de Servicios</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Dienstleistungsvertragspraxis</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de Acuerdo de Servicios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सेवा समझौता अभ्यास</skos:altLabel>
    <skos:altLabel>Services Agreement</skos:altLabel>
    <skos:hiddenLabel>SVC</skos:hiddenLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKzL5nW7IGg4mvAPFX2MUL"/>
    <rdfs:label>Services Agreement Practice</rdfs:label>
    <dc:identifier>T-SVC</dc:identifier>
