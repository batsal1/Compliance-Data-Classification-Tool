  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ShaHrE3JSuSw8d_CotFIiQ">
    <rdfs:label>Administration of Conservation Programs</rdfs:label>
    <skos:definition>This industry comprises government establishments primarily engaged in the administration, regulation, supervision, and control of land use, including recreational areas; conservation and preservation of natural resources; erosion control; geological survey program administration; weather forecasting program administration; and the administration and protection of publicly and privately owned forest lands. Government establishments responsible for planning, management, regulation, and conservation of game, fish, and wildlife populations, including wildlife management areas and field stations; and other administrative matters relating to the protection of fish, game, and wildlife are included in this industry.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=924120"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ve8HJKf9R-G2JKTbxDoTGA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
