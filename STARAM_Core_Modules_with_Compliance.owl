  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RChyLUYm0W5R3E1yQl08Id9">
    <skos:definition>The female market segment refers to a division of the market that is specifically targeted towards female consumers. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of women, taking into account factors such as lifestyle, life stage, and purchasing behavior.</skos:definition>
    <skos:example>Women's Health Product</skos:example>
    <skos:example>Women's Clothing Retailer</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9DCJMzRXnPZMWQqQuPLECx"/>
    <skos:prefLabel>Women's Market Segment</skos:prefLabel>
    <rdfs:label>Female Market Segment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7pJCQXsV8QEAd6Wp4NzVh0">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHfeijrOTjaF7qpuoGIGkR"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"For mixed currency situations only where it is mandated that the total tax must also be reported in a different currency ISO.  The sum of all MATTER.matter_tax_on_fees + MATTER.matter_tax_on_exp + the sum of all TAX_TIER_SUMMARY.tax_tier_total_amount for this inv_id in the ISO required by law as identified in INVOICE.inv_other_iso. 

This figure includes Withholding Taxes and Tiered Taxes applicable to this invoice.</skos:definition>
    <rdfs:label>inv_total_tax_other_iso</rdfs:label>
  </rdf:Description>
