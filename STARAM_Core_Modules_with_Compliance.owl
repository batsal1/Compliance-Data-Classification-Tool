    <skos:definition>A Student Loan, also known as an Educational Loan, is a type of loan designed to help students pay for post-secondary education and associated fees, such as tuition, books, and living expenses. These loans typically offer favorable terms such as lower interest rates and flexible repayment options to assist borrowers in managing educational costs.</skos:definition>
    <skos:definition>University Loan</skos:definition>
    <skos:prefLabel>Educational Loan</skos:prefLabel>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <rdfs:label>Student Loan</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>College Loan</skos:altLabel>
  </rdf:Description>
