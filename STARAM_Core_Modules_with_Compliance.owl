  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7qjvUfvWoLEUPk8i4rR3Sz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7mMPoEuA9Ja4rODr1LGXcR"/>
    <rdfs:label>Collective Work</rdfs:label>
    <skos:definition>Collective Work in copyright law refers to a work consisting of individual contributions assembled into a collective whole, where each contribution retains its individual copyright but the collection as a whole is also protected. This concept is common in anthologies, encyclopedias, and periodicals, where the collective arrangement is subject to copyright, separate from the individual works.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8YJTRhHvp1SM1F3trynODK">
    <skos:altLabel xml:lang="es-es">Fraude Constructivo del Corredor de Bienes Raíces</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रियल एस्टेट ब्रोकर का निर्माणात्मक धोखाधड़ी</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">房地产经纪人的建设性欺诈</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Konstruktiver Betrug des Immobilienmaklers</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הונאה בניהול עסקי של תיווך נדל״ן</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Real Estate Broker's Constructive Fraud</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fraude construtiva do corretor de imóveis</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude constructive de l'agent immobilier</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不動産ブローカーの建設的詐欺</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fraude Constructivo del Corredor Inmobiliario</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC98GOWmR2IGsSWxcwMf82O"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDp8cEr3KYyVDenm1P9ejdx"/>
    <rdfs:label>Real Estate Broker's Constructive Fraud</rdfs:label>
    <skos:definition>Real Estate Broker's Constructive Fraud: A type of constructive fraud that occurs when a real estate broker misrepresents or conceals material facts with the intent to deceive, causing harm to the client.</skos:definition>
  </rdf:Description>
