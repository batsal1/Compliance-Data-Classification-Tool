  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBmdeshVFbo6mEH3zVVXEuM">
    <skos:altLabel xml:lang="es-es">Industria de vehículos motorizados</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kraftfahrzeugindustrie</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मोटर वाहन उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית רכבים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">汽车工业</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Motor Vehicles Industry</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自動車産業</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de vehículos motorizados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie automobile</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de veículos automotores</skos:altLabel>
    <skos:altLabel>Motor Vehicles</skos:altLabel>
    <skos:hiddenLabel>MVPM</skos:hiddenLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8q7pmb15BQ563KmqZxMC3W"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-MFG-TRMF-MVPM</ns2:legacyIdentifier>
    <dc:identifier>MFG-TRMF-MVPM</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3361"/>
    <skos:prefLabel>Motor Vehicles Industry</skos:prefLabel>
    <rdfs:label>Motor Vehicle Manufacturing</rdfs:label>
    <skos:definition>This industry group comprises establishments primarily engaged in (1) manufacturing complete automobiles, light duty motor vehicles, and heavy duty trucks (i.e., body and chassis or unibody) or (2) manufacturing motor vehicle chassis only.</skos:definition>
