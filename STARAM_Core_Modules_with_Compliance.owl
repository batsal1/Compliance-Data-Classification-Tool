  <rdf:Description rdf:about="https://folio.openlegalstandard.org/UIsrIt8uQ5Sca4Pm80Y7qg">
    <rdfs:label>Guided Missile and Space Vehicle Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/OHRgpwVGRR2OOs9XZgkEgA"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) manufacturing complete guided missiles and space vehicles and/or (2) developing and making prototypes of guided missiles or space vehicles.</skos:definition>
