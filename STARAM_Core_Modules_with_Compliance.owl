  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7ppLbcG1r1qmn9k8nklNEb">
    <skos:altLabel>Inadmissible Lay Testimony Objection</skos:altLabel>
    <skos:altLabel>Objection to Unauthorized Non-Expert Opinion</skos:altLabel>
    <skos:altLabel>Unqualified Non-Expert Opinion Objection</skos:altLabel>
    <rdfs:label>Improper Lay Opinion Objection</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Improper Lay Opinion Objection is raised when a party believes that a non-expert witness is offering an opinion without sufficient basis, exceeding the bounds of their direct perception or not aiding in understanding or determining a fact in issue (e.g., Federal Rule of Evidence 701). Lay witnesses can offer opinions if they have personal knowledge and a rational basis for their conclusions, such as describing someone's appearance without speculating on their thoughts. However, they may not testify to someone else's thoughts, specific medical conditions, or other technical matters beyond their knowledge.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jIR8iqxwPvaiF10RkWcgO"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8HiaQwD5TdQYvaB230T5jy">
    <skos:altLabel xml:lang="pt-br">Cláusula de garantia padrão</skos:altLabel>
