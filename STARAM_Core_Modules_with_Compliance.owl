  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC8VGAXjvsdE24lKxIBe673">
    <rdfs:label>Fair Credit Reporting Claim</rdfs:label>
    <skos:altLabel xml:lang="fr-fr">Réclamation de rapport de crédit équitable</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Informe de Crédito Justo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf faire Kreditberichterstattung</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fair Credit Reporting Claim</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公平信用报告索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת דיווח נאות על נתוני אשראי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reclamação de relatório de crédito justo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फेयर क्रेडिट रिपोर्टिंग क्लेम</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de Informe de Crédito Justo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公正なクレジットレポート請求</skos:altLabel>
    <skos:definition>A Fair Credit Reporting Claim is a legal action taken by a consumer against a credit reporting agency or creditor for violating the consumer's rights under the Fair Credit Reporting Act.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KRLFkDC6ycyN3FyXivt7D"/>
