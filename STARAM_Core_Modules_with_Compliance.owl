    <skos:altLabel xml:lang="fr-fr">Diffamation commerciale</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trade Libel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">商業中傷</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Difamación comercial</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业诽谤</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגיעה במוניטין מסחרי</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यापार अपमान</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Difamação comercial</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Difamación comercial</skos:altLabel>
    <skos:altLabel>Injurious Falsehood</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Handelsverleumdung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JBjakDIsSF91IjI8v4skI"/>
    <rdfs:label>Trade Libel</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Trade Libel, also known as Injurious Falsehood, is a type of defamation that involves making false statements about a business or its products or services, which results in financial harm to the business.</skos:definition>
  </rdf:Description>
