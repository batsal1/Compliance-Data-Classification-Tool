    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Default Interest Rate Clause is a provision in a contract that specifies the interest rate that will apply if one party fails to fulfill their obligations under the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg">
    <skos:altLabel>Creditor Priority Classification</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nc8396fe35d484f78a62be689ac2894d3"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e"/>
    <skos:prefLabel>Investment Guarantee or Ranking</skos:prefLabel>
    <rdfs:label>Credit Arrangement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Credit Arrangement (also known as Creditor Priority or Investment Guarantee or Ranking) refers to the security, priority, or guarantee associated with a financial instrument, determining the order and likelihood of repayment in various scenarios, particularly in case of default or liquidation. This classification encompasses a range of assurances and hierarchical positions, from secured arrangements to government-backed guarantees to various levels of seniority and subordination in the capital structure.</skos:definition>
  </rdf:Description>
