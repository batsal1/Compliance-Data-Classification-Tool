  <rdf:Description rdf:about="https://folio.openlegalstandard.org/HKB4DZ_OTrCAWQrg_EnR8Q">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541110"/>
    <rdfs:label>Offices of Lawyers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Oy1WTPF3RlWkCrJP4GTPKA"/>
    <skos:definition>This industry comprises offices of legal practitioners known as lawyers or attorneys (i.e., counselors-at-law) primarily engaged in the practice of law. Establishments in this industry may provide expertise in a range or in specific areas of law, such as criminal law, corporate law, family and estate law, patent law, real estate law, or tax law.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
