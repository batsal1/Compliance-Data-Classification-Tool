  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBe3wpR5ZicE4QYklVEqSMR">
    <skos:altLabel>Tax Write-Off</skos:altLabel>
    <skos:altLabel>Allowable Expense</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJ7P2VbioQVexfXhjLwsBI"/>
    <rdfs:label>Tax Deduction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Tax Deduction is a reduction of a taxpayer's taxable income, lowering the amount of income subject to taxation. It operates by subtracting specific expenses or allowances from gross income, thereby decreasing the tax base before the tax rate is applied</skos:definition>
    <skos:prefLabel>Income Reduction Allowance</skos:prefLabel>
  </rdf:Description>
