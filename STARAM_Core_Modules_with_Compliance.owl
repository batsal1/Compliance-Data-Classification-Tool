    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Term Extension Clause is a provision in a contract that allows for the extension of the agreement beyond its original expiration date.</skos:definition>
  </rdf:Description>
