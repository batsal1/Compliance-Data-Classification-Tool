  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9PuBFQqCIJcjnUuBJi5RUr">
    <skos:altLabel xml:lang="fr-fr">Représentation inexacte par négligence</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Representación negligente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過失による虚偽の陳述</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצגת שגיאה שלא בכוונה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Misrepresentation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लापरवाह भ्रामक बयान</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Falschdarstellung</skos:altLabel>
    <skos:altLabel>Negligent Misrepresentation Causing Harm</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representação negligente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representación negligente</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过失虚假陈述</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7JKVOM2aFkvG1yiLzF7ndA"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRC3CmU6w2he0zPcqr6J7p"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdfs:label>Negligent Misrepresentation</rdfs:label>
    <skos:definition>Negligent Misrepresentation is a legal claim that arises when a party makes a false statement or omits important information, which they should have known was false or misleading, and that causes harm to another party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RZL_iiE98TD2gIYVMd0pCqw">
    <skos:definition>This code includes all non-hourly or other alternative fee arrangements for tasks and activities in this phase.</skos:definition>
