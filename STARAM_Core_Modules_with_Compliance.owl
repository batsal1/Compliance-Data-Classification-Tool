  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDLJFOLdDrD89A25lPqcgrR">
    <skos:altLabel xml:lang="fr-fr">Doctrine de la frustration de l'objet</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Lehre der Zweckvereitelung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Doctrina de la Frustración del Propósito</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">目的挫败原则</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">目的不履行教義</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תאוריה של כשלון המטרה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Doutrina da Frustração do Propósito</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Doctrina de la Frustración del Propósito</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Frustration of Purpose Doctrine</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उद्देश्य का निराश्रय डॉक्ट्रिन</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Frustration of Purpose Doctrine is a legal defense in civil litigation that allows a party to be excused from performing their contractual obligations when an unforeseen event occurs that completely undermines the purpose of the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:label>Frustration of Purpose Doctrine</rdfs:label>
  </rdf:Description>
