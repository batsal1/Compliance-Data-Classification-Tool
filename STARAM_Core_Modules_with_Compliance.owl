  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R84WSMY4efMvESQh729h2Kp">
    <dc:source>State v. Davis, 2021 Ohio 237 (Ohio Ct. App. Jan. 29, 2021).</dc:source>
    <dc:source>New Mexico Criminal Jury Instruction 14-5106</dc:source>
    <dc:source>Oklahoma Jury Instructions, Ouji-cr 8-42</dc:source>
    <rdfs:label>Involuntary Intoxication</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
    <skos:definition>Involuntary intoxication is a legal defense where the defendant claims they were forced or unknowingly induced to consume intoxicating substances, rendering them unable to understand the nature of their actions. This defense can negate criminal liability if the intoxication prevented the formation of intent or awareness necessary to commit the crime.</skos:definition>
  </rdf:Description>
