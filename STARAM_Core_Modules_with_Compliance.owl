    <rdfs:label>Statute of Frauds</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A legal defense that requires certain types of contracts to be in writing in order to be enforceable in court.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCiVizZP7WcAx3V1sRhugzG">
