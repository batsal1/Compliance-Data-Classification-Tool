    <skos:altLabel xml:lang="zh-cn">无转让条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-attribution</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">譲渡禁止条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de No Asignación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Assignment Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אין העברת זכויות</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>No Assignment Clause</rdfs:label>
    <skos:definition>A No Assignment Clause is a provision in a contract that prohibits one party from transferring their rights or obligations under the contract to a third party without the consent of the other party.</skos:definition>
  </rdf:Description>
