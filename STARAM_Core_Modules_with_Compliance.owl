  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/bVTxfmrNRFuZC3l21ZDU6w">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=922120"/>
    <skos:definition>This industry comprises government establishments primarily engaged in criminal and civil law enforcement, police, traffic safety, and other activities related to the enforcement of the law and preservation of order. Combined police and fire departments are included in this industry.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/u-ZpjnbvRnydeklYTtZEBg"/>
    <rdfs:label>Police Protection</rdfs:label>
  </rdf:Description>
