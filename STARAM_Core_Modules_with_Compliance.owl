    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtpnOBk4lRnWigpEBBKYUDQ"/>
    <skos:prefLabel>X103 Copy Service (External)</skos:prefLabel>
    <rdfs:label>X103 Copy Service (External)</rdfs:label>
    <skos:definition>Any black &amp; white or color copy, binding and reassembly charges when that service is performed by an external party and paid by the law firm or legal vendor</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
