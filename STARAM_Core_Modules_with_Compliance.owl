    <skos:altLabel xml:lang="he-il">זנות ציבורית</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Public Lewdness</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exhibitionnisme</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Exhibicionismo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公共猥亵</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Atentado ao pudor</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Öffentliche Unzucht</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公然わいせつ行為</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Exhibicionismo en público</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सार्वजनिक अश्लीलता</skos:altLabel>
    <rdfs:label>Public Lewdness</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Ndda6cf72f460409086d55e4faffd5038"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Public Lewdness is a criminal offense that involves engaging in sexual activity or indecent exposure in a public place, which is considered offensive to the public's decency and morals.</skos:definition>
  </rdf:Description>
