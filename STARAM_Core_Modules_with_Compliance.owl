    <skos:definition>"MATTER_DISC_CRED.disc_cred_percent where MATTER_DISC_CRED.disc_credit_type equals ""Percent"" and MATTER_DISC_CRED.disc_credit_category equals ""Fee"" and MATTER_DISC_CRED.disc_cred equals ""MISF""  
"</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>matter_perc_shar_fees</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9CFyriAc6mYKoNAwyAPwuO">
    <skos:definition>Employee Rights Campaigns Practice involves strategic efforts by labor unions and other worker advocacy groups to influence corporate behavior and policy, often through public relations, media, legal, and political pressure. These campaigns aim to improve working conditions, secure collective bargaining rights, and address labor-related grievances within corporations.</skos:definition>
    <skos:altLabel>Employee Rights Campaigns</skos:altLabel>
    <skos:altLabel>Worker Advocacy Campaign Practice</skos:altLabel>
    <skos:altLabel>Employee Rights Campaigns Service</skos:altLabel>
    <skos:altLabel>Workforce Advocacy Initiatives</skos:altLabel>
    <skos:prefLabel>Union Campaign Practice</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxNwDQ5PLYnwvIGnKx1FwR"/>
    <rdfs:label>Employee Rights Campaigns Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
