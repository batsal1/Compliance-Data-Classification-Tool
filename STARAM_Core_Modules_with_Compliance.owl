    <skos:example>Race cars manufacturing</skos:example>
    <skos:example>All-terrain vehicles (ATVs), wheeled or tracked, manufacturing</skos:example>
    <skos:example>Gocarts (except children's) manufacturing</skos:example>
    <skos:example>Golf carts and similar motorized passenger carriers manufacturing</skos:example>
    <skos:example>Animal-drawn vehicles and parts manufacturing</skos:example>
