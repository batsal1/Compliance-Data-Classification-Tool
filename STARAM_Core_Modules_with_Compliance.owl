  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8hg3JEhptyxPqtE1M05N2D">
    <skos:definition>The "Right to be Forgotten" refers to an individual's legal ability to request the removal of personal information from digital platforms or search engine results. Originating in the European Union, this right aims to allow people to control their digital footprint by deleting or delisting information that is outdated, irrelevant, or no longer applicable.</skos:definition>
    <rdfs:label>Right to be Forgotten</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na5667d6067764dcdbfbaae792d7bb0b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#BalloonPayment"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasStandardClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8jIR8iqxwPvaiF10RkWcgO">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s"/>
    <rdfs:subClassOf rdf:nodeID="N991f8e4650f64dcc94a6c31c894bdadc"/>
    <rdfs:label>Improper Opinion Objection</rdfs:label>
    <skos:definition>An Improper Opinion Objection is raised when a party in a legal proceeding believes that a witness is offering an opinion or conclusion that is not based on their expertise or is not permissible under the rules of evidence. This objection aims to ensure that opinions presented in court are relevant, based on proper expertise, and allowed by law.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
