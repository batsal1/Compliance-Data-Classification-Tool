  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R72tkCdm2glmCGkZ7hQTTEt">
    <skos:definition>A financing contingency clause is a provision in a contract that allows a party to back out of the agreement if they are unable to secure financing for the transaction.</skos:definition>
    <skos:altLabel xml:lang="hi-in">वित्त प्रतिबंधिता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de contingencia de financiación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de contingência de financiamento</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">融资附条件条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de contingence de financement</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Financing Contingency Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאי מימון מותנה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Finanzierungsbedingungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de contingencia de financiamiento</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">資金調達条件条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Financing Contingency Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R79xc5zAwyWmOjHbe5m6p26">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Jv88vklSkqJGJCJCeVItp"/>
    <rdfs:label>Managed Services</rdfs:label>
    <skos:definition>Managed Services: A type of alternative legal service that involves the outsourcing of legal work to a third-party provider who manages and performs the work on behalf of the client.</skos:definition>
