  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9cB1UdsSPUHqk2F6LnDU4s">
    <rdfs:label>Actions Taken by Buyer Language</rdfs:label>
    <skos:altLabel xml:lang="pt-br">Ações tomadas pelo comprador</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acciones Tomadas por el Comprador</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">买方采取的行动</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">買い手による措置</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולות שננקטו על ידי הקונה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acciones Tomadas por el Comprador</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Actions prises par l'acheteur</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Actions Taken by Buyer Language</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vom Käufer ergriffene Maßnahmen</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार भाषा द्वारा की गई कार्रवाई</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Actions Taken by Buyer Language refers to the specific provisions and clauses included in a contract by the buyer to protect themselves from any negative consequences that may arise after the acquisition of a company, and which are exempted from the Material Adverse Effect definition.</skos:definition>
  </rdf:Description>
