    <rdfs:subClassOf rdf:nodeID="N5f9057761b0348adaffd9c69ce11265b"/>
    <rdfs:label>No Exclusivity Clause</rdfs:label>
    <skos:definition>A "No Exclusivity Clause" is a provision in a contract that states that the parties involved are not restricted from entering into similar agreements with other parties.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
