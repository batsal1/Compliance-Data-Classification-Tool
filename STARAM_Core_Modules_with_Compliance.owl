  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDhXPkOAHznKvU1lxwLTqZw">
    <skos:altLabel xml:lang="de-de">Verwendungszwecksklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपयोग धन क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'utilisation des produits</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">資金使用条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">资金用途条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de uso dos recursos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שימוש בכספים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de uso de los recursos</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de uso de los fondos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Use of Proceeds Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Use of Proceeds Clause is a provision in a contract that specifies how the funds received from a transaction will be allocated and used.</skos:definition>
    <rdfs:label>Use of Proceeds Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/QSbLqMDSRYCLzlFaEKWnuw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/XyZ6m8jkTemBuzuW-cAHCA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=212322"/>
    <rdfs:label>Industrial Sand Mining</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) operating industrial grade sand pits; (2) dredging for industrial grade sand; and (3) washing, screening, or otherwise preparing industrial grade sand.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#submitted_by">
    <rdfs:label>submittedBy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RGhcPktpuzKTEKWsL4kdPM">
    <skos:altLabel xml:lang="pt-br">Violação da confidencialidade do paciente pelo médico</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת סודיות המטופל על ידי הרופא</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation du secret médical par un médecin</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der ärztlichen Schweigepflicht</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">चिकित्सक रोगी गोपनीयता का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Violación de la confidencialidad del paciente por parte del médico</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">医生违反患者保密</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Violación de la confidencialidad del paciente por parte del médico</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Physician Violation of Patient Confidentiality</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">医師による患者の機密保持違反</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rd7uelGFqCTWSgf9lWki5N"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdfs:label>Physician Violation of Patient Confidentiality</rdfs:label>
    <skos:definition>The concept of Physician Violation of Patient Confidentiality refers to the breach of trust by a medical professional who discloses private information about a patient without their consent, potentially resulting in legal claims for medical malpractice and privacy violations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RY5ufSFTqChUTFowO4Xdz5">
    <rdfs:label>Alternative Dispute Resolution Management</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
    <skos:altLabel>ADR Management</skos:altLabel>
    <skos:definition>Alternative Dispute Resolution Management refers to the process of resolving legal disputes outside of the traditional court system, such as through mediation or arbitration, and involves managing the various stages of the ADR process.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>ADR Management</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2d32f00fcf964b0296fc6dab301282f5">
