  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R99ZxCckM9gZrtJaPVrtwHy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Abortion Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCidddiy9X9fqxmBCyYguuE"/>
    <skos:definition>Abortion claims pertain to legal actions or challenges concerning the right to access or perform abortions. These claims can arise from disputes over the constitutionality of abortion restrictions, the rights of individuals seeking abortions, the obligations of medical providers, or the legal framework governing abortion procedures within a jurisdiction.</skos:definition>
  </rdf:Description>
