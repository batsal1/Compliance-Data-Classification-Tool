  <rdf:Description rdf:about="https://folio.openlegalstandard.org/niRhADDITxWzhXqGbi6dwQ">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in performing support activities, on a contract or fee basis, for oil and gas operations (except geophysical surveying and mapping, site preparation, construction, and transportation activities). Services included are exploration; excavating slush pits and cellars, well surveying; running, cutting, and pulling casings, tubes, and rods; cementing wells, shooting wells; perforating well casings; acidizing and chemically treating wells; and cleaning out, bailing, and swabbing wells.</skos:definition>
    <rdfs:label>Support Activities for Oil and Gas Operations</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=213112"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/2A-BXFaYS4aaPb9hUzIjNA"/>
  </rdf:Description>
