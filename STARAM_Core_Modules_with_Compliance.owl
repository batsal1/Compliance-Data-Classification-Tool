  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R845hSkIeHE4QF5ItHg8vTT">
    <rdfs:label>Right to Collect Rent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7zOJlSftSahbSm5hUyywxU"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Right to Collect Rent refers to the legal authority granted to a property owner or designated agent to receive a specified sum from tenants in exchange for the use of a property. This right is typically outlined in a lease agreement, and failure by the tenant to pay rent may result in legal actions such as eviction, subject to terms of the lease and applicable law</skos:definition>
  </rdf:Description>
