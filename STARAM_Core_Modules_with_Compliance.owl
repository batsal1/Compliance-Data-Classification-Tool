  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8X3VQ45MijCh9tDdajbchl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Health Rights</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N7cbc9bfd13b4413fb5521567cfcd123b"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <rdfs:subClassOf rdf:nodeID="N53c3ff122a8e4aa1a237e9b9118a2640"/>
    <rdfs:subClassOf rdf:nodeID="N52ec12239a7e47959b65e12067649020"/>
    <rdfs:subClassOf rdf:nodeID="Ncf1eb7180a60408eae42b63f297a3dda"/>
    <skos:definition>Health rights refer to the legal and ethical entitlements aimed at ensuring access to a minimum standard of healthcare and well-being for individuals. These rights can include access to medical treatment, preventative care, and essential medications, and are often supported by both international treaties and national healthcare policies.</skos:definition>
  </rdf:Description>
