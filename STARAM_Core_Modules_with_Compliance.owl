  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R89Oik9BkKNt7jrD9SBvrIo">
    <skos:altLabel xml:lang="pt-br">Extinção do poder familiar (remédio)</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">親権の剥奪（救済）</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפסקת זכויות הוריות (תיקון)</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privación de la patria potestad (remedio)</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Retrait des droits parentaux (recours)</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Terminación de la patria potestad (remedio)</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मातृ-पितृ अधिकारों के समाप्ति (उपचार)</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Entziehung der elterlichen Rechte (Rechtsmittel)</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Termination of Parental Rights (Remedy)</skos:altLabel>
    <skos:altLabel>TPR</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">终止父母权利（救济）</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9gqzNBOvSSiVGWHH7ZIXzM"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Termination of Parental Rights (Remedy)</rdfs:label>
    <skos:definition>The Termination of Parental Rights (TPR) is a legal process that permanently ends the legal relationship between a parent and their child, typically due to abuse, neglect, or abandonment, and allows for the child to be adopted or placed in a permanent home.</skos:definition>
    <skos:prefLabel>Termination of Parental Rights</skos:prefLabel>
  </rdf:Description>
