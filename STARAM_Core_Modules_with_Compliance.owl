    <skos:altLabel xml:lang="ja-jp">食品汚染請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reclamação por contaminação de alimentos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch wegen Lebensmittelkontamination</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour contamination alimentaire</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על זיהום מזון</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por contaminación de alimentos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Food Contamination Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por contaminación de alimentos</skos:altLabel>
