  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCgliWPJTXfVXyK1p9ERyG9">
    <rdfs:label>Child Labor Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A child labor claim is a legal assertion that a minor has been employed in violation of labor laws that regulate the age, conditions, and hours of work for minors. Such claims often seek remedies for the exploitation or harm suffered by the child due to illegal employment practices.</skos:definition>
    <skos:altLabel>Underage Labor Complaint</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
  </rdf:Description>
