  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDifpD5IXarDdCKxCD7GVkX">
    <rdfs:label>Property Right to Profit</rdfs:label>
    <skos:definition>In civil law systems, the Right to Profit ("droit de prendre") refers to a real right that allows an individual or entity to enter another's land to extract resources like minerals, timber, or fish. This right is usually granted through a contract or license and is subject to the terms and conditions specified therein, as well as overarching legal regulations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q"/>
    <skos:altLabel>Droit de Prendre</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
