  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8E6QHpQYJdff646657OF1S">
    <skos:altLabel xml:lang="pt-br">Decisão de custo ou taxa - Percentual reduzido</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עלות או דמי מענק - אחוז מורד</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">費用または手数料の決定 - パーセンテージ削減</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लागत या फी अवार्ड - प्रतिशत कम हुआ</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Costo o tarifa otorgada - Porcentaje reducido</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Décision de coûts ou de frais - Pourcentage réduit</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">成本或费用裁决 - 百分比减少</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kosten- oder Gebührenentscheidung - Prozentual reduziert</skos:altLabel>
