    <skos:altLabel xml:lang="de-de">Fusion/Akquisition ohne Zustimmung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Voto en contra de la fusión/adquisición</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fusion/Acquisition sans vote</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDa7IsUxl4AA7e5KylzJYK"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
