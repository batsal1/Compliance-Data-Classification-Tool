  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-ip-data-confidentiality">
    <skos:definition xml:lang="en">Risks relating to intangible assets, covering ownership of intellectual property in deliverables, licensing back of pre-existing intellectual property, indemnity against third-party infringement, data protection, and survival of confidentiality obligations.</skos:definition>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <ns5:mappingGapNote xml:lang="en">Weak mapping: the 7-term allocation taxonomy has no category for risk to intangible assets. A possible eighth allocation category is 'Information, IP &amp; Data Risk'.</ns5:mappingGapNote>
    <rdfs:label xml:lang="en">IP, Data &amp; Confidentiality</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">IP, Data &amp; Confidentiality</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:notation>LR-14</skos:notation>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-legal-liability"/>
  </rdf:Description>
