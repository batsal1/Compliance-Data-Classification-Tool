  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7QtA1XEvYBttW8LUvBN7OB">
    <skos:altLabel xml:lang="zh-cn">解除条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de liberação</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रिलीज क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Freigabeklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de liberación</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de liberación</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שחרור</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">解除条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Release Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de libération</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Release Clause</rdfs:label>
    <skos:definition>A Release Clause is a contractual provision that relieves one party from liability or obligation, typically in exchange for a payment or other consideration, and may take various forms such as Release of All Claims Clause, Release of Liability Clause, Release of Security Interest Clause, Release of Obligations Clause, Release and Indemnity Clause, or Release Agreement Clause.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na32f488c7ba946019b3c2614fe0b7972">
