    <skos:altLabel xml:lang="pt-br">Cláusula de opção de recompra</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Buy Back Option Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीद वापस विकल्प शर्त</skos:altLabel>
