    <rdfs:label>Promissory Note</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A promissory note is a written agreement in which one party promises to pay a specific amount of money to another party at a future date or on demand.</skos:definition>
