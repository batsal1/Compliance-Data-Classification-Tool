  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDQ4H6Mofyz6JJD4n1ASHIZ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hWq9dSn0Su2Y59JE48V3H"/>
    <rdfs:subClassOf rdf:nodeID="Ne98ae7243f004256bb65cc551ec46128"/>
    <rdfs:label>Seed Investor</rdfs:label>
    <skos:definition>A Seed Investor provides initial capital to a startup or early-stage business in exchange for equity or convertible debt, often taking significant risks with the expectation of high returns. This funding typically supports product development, market research, and initial operations before larger investments are secured.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBKhb3AMMOBaiFMfEwhiTxJ">
    <skos:altLabel xml:lang="ja-jp">貢献請求</skos:altLabel>
