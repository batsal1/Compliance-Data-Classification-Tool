    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/legislation#LegalWork"/>
    <rdfs:label xml:lang="en">Judgement Work</rdfs:label>
    <rdfs:comment xml:lang="en">A court decision considered as an abstract work. Reserved for the precedent layer.</rdfs:comment>
