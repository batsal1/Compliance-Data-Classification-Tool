  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBHxaoG50eKk8vBltedqqt4">
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק אגר חובות הוגנת</skos:altLabel>
