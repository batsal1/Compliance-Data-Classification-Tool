  <rdf:Description rdf:about="https://folio.openlegalstandard.org/tdQcf1rQQoiNc9ouPR6L5A">
    <rdfs:label>Lessors of Miniwarehouses and Self-Storage Units</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in renting or leasing space for self-storage. These establishments provide secure space (i.e., rooms, compartments, lockers, containers, or outdoor space) where clients can store and retrieve their goods.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=531130"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/30EZWVzXRPaRzGXkeCdtFA"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70">
    <skos:prefLabel>Call Option Asset</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
    <rdfs:label>Callable Asset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Callable Instrument</skos:altLabel>
    <skos:altLabel>Callable Financial Instrument</skos:altLabel>
    <skos:definition>A Callable Asset is a financial instrument that can be redeemed or repaid by the issuer before its specified maturity date, at the issuer's discretion. This feature allows the issuer to take advantage of favorable interest rate movements or other financial conditions, often resulting in the repayment of the principal and cessation of interest payments prior to the original maturity date.</skos:definition>
  </rdf:Description>
