    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Deceptive Advertising</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9seb5qQstcsgRm3UE8hV5t"/>
    <skos:definition>Deceptive Advertising refers to the act of promoting a product or service through false or misleading statements or representations, with the intention of deceiving or misleading consumers.</skos:definition>
  </rdf:Description>
