  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RKoMhHeiuDB6Js7z1UVM7x">
    <skos:altLabel xml:lang="he-il">סעיף תרומה והפצה מנוחץ</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de contribution et de distribution présumée</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Contribuição e Distribuição Presumida</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Contribución y Distribución Presunta</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Contribución y Distribución Presunta</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">見なされた出資および分配条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Deemed Contribution and Distribution Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">被视为出资和分配条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur fiktiven Einlage und Verteilung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुमानित योगदान और वितरण धारा</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Deemed Contribution and Distribution Clause is a provision in a contract that specifies how contributions and distributions will be treated as if they were made on a certain date, regardless of when they were actually made.</skos:definition>
    <rdfs:label>Deemed Contribution and Distribution Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndeb252f4df0a41948f731d2be9e59939">
