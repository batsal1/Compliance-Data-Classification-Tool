  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDjfaOqGD56LVxjz7Cg18uj">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Cláusula de Director Emérito</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">名誉理事条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Director Emérito</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निदेशक एमेरिटस शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de Directeur Émérite</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מנכ"ל אמריטוס</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Director Emeritus Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Diretor Emérito</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Direktor Emeritus Klausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">名誉董事条款</skos:altLabel>
    <skos:definition>A Director Emeritus Clause is a provision in a contract that grants a former director of a company an honorary title and certain privileges, such as attending board meetings, without having any voting rights or responsibilities.</skos:definition>
    <rdfs:label>Director Emeritus Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7gzXxHYGOLSEudb6n1QFWm">
    <skos:altLabel xml:lang="pt-br">Execução hipotecária</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hypotheken Zwangsvollstreckung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ejecución Hipotecaria</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mortgage Repossession</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ejecución Hipotecaria</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">抵押清偿</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऋण अधिकार जब्ती</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Saisie immobilière</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מימוש משכנתא</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">抵当フォアクロージャー</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsCr2ffuxk4pqU5CQ8SAxq"/>
