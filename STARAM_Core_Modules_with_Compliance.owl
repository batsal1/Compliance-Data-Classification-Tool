  <rdf:Description rdf:about="https://folio.openlegalstandard.org/lbAOULfzSrKceTPk6sGRHQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/67ndUHFyQze8OuwCMzRTTQ"/>
    <skos:example>Community foundations</skos:example>
    <skos:example>Grantmaking foundations</skos:example>
    <skos:example>Philanthropic trusts</skos:example>
    <skos:example>Corporate foundations, awarding grants</skos:example>
    <skos:example>Scholarship trusts</skos:example>
    <skos:definition>This U.S. industry comprises establishments known as grantmaking foundations or charitable trusts. Establishments in this industry award grants from trust funds based on a competitive selection process or the preferences of the foundation managers and grantors; or fund a single entity, such as a museum or university.</skos:definition>
    <rdfs:label>Grantmaking Foundations</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=813211"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
