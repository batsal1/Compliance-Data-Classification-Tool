    <skos:definition>A legal right to use someone else's property for a specific purpose, which is gained through continuous and uninterrupted use of the property for a certain period of time without the owner's permission.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBL2dkoVYGusm7xhxvHK2kG">
