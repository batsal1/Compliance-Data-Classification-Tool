    <skos:altLabel xml:lang="he-il">אחריות סגן-מנהל</skos:altLabel>
    <skos:definition>The legal concept of Vice-Principal Liability refers to the responsibility of a person or entity, such as a company, for the actions of their subordinates or agents, even if the person in charge did not directly participate in the wrongdoing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCGW5RFfjJ95ygeSCJLaJQT"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Vice-Principal Liability</rdfs:label>
