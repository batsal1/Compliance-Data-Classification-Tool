    <skos:altLabel xml:lang="de-de">Interpleader</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इंटरप्लीडर</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interpleader</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Interpleader</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">Interpleader</skos:altLabel>
    <skos:definition>From U.S. Bankruptcy Court PACER</skos:definition>
    <skos:definition>A person who compels other parties making the same claim against him to litigate the matter between themselves to prove whose claim is good.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8J6o3hDRmGD4O3MCMAAGGt">
    <skos:altLabel xml:lang="pt-br">Indícios razoáveis</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">योग्य संकेत</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Angemessene Anhaltspunkte</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Indications raisonnables</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reasonable Indications</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מפניות סבירות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合理的な示唆</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Indicios Razonables</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Indicios Razonables</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合理迹象</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
    <skos:definition>Reasonable Indications refer to the level of evidence required to shift the burden of proof in a legal matter, specifically in litigation, where the party with the burden of proof must provide evidence to support their claim.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Reasonable Indications</rdfs:label>
  </rdf:Description>
