  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R3JSBxP8r1OUSNgxHhgv9">
    <skos:definition>A Journalist is a professional who researches, writes, and reports on news and current events for various media outlets, including newspapers, magazines, television, radio, and online platforms. Journalists play a critical role in gathering information, conducting interviews, and delivering news to the public in an accurate and unbiased manner.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <skos:altLabel>News Writer</skos:altLabel>
    <skos:altLabel>Reporter</skos:altLabel>
    <skos:altLabel>News Correspondent</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Journalist</rdfs:label>
  </rdf:Description>
