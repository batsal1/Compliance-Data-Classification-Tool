    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bring-down of Representations and Warranties</rdfs:label>
    <skos:definition>Representations and Warranties are statements made by a party in a legal matter regarding the accuracy and completeness of certain facts or conditions, which are relied upon by the other party, and may be subject to legal remedies if found to be untrue.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UELEvq0EkRnKE9zMt5IfZ"/>
