    <rdfs:label>Driver</rdfs:label>
    <skos:altLabel>Operator</skos:altLabel>
    <skos:altLabel>Automobile Driver</skos:altLabel>
    <skos:altLabel>Vehicle Operator</skos:altLabel>
    <skos:definition>A driver is an individual who operates a motor vehicle, controlling its direction and speed on public or private roads. This role requires adherence to traffic laws and regulations to ensure safety and order on thoroughfares.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Motorist</skos:prefLabel>
  </rdf:Description>
