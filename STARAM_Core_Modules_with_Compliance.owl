  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8COEm2tr0t8u1k12Sr16Nn">
    <rdfs:subClassOf rdf:nodeID="Na12dc32c98534b11b6d78f51fa860e7c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <skos:altLabel xml:lang="en-gb">Act of God Doctrine</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">天災責任原則</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भगवान की कृपा नीति</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Doctrina del Caso Fortuito</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Act of God Doktrin</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Doctrine de la force majeure</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Doctrina de la Fuerza Mayor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תפיסת כוח מעלה</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">天灾责任原则</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Doutrina do caso fortuito</skos:altLabel>
    <skos:definition>The Act of God Doctrine is a legal defense in civil litigation that excuses a party from liability for damages or injuries caused by natural events that are beyond human control, such as earthquakes, floods, or lightning strikes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Act of God Doctrine</rdfs:label>
  </rdf:Description>
