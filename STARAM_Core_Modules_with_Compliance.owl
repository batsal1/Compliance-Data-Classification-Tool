  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8moeCg3i0lZQ5CEjooCIAY">
    <rdfs:subClassOf rdf:nodeID="N0aeceadc22a24f2b8187805af3e3bf2e"/>
    <rdfs:subClassOf rdf:nodeID="N606d8a0d2e2c422a8205d15774a6786c"/>
