  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8F4nBqUmZ27jOdViue5mxp">
    <skos:definition>A Plea Agreement Evidence Objection is raised when a party in a legal proceeding believes that evidence of a plea agreement or negotiation is being used inappropriately, such as to prove guilt or liability. This objection aims to protect the plea negotiations and agreements, ensuring that they are not used prejudicially.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8R7UAZpzIQTdqNtctKj3XY"/>
    <skos:prefLabel>Objection to Evidence of Plea Discussions</skos:prefLabel>
    <dc:source>Fed. R .Evid. 410</dc:source>
    <skos:altLabel>Plea Bargain Evidence Objection</skos:altLabel>
    <skos:altLabel>Guilty Plea Negotiation Objection</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Plea Agreement Evidence Objection</rdfs:label>
  </rdf:Description>
