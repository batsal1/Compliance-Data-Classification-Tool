    <rdfs:label>Intellectual Property License Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Intellectual Property &amp; Licensing</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Intellectual Property License Agreement grants a party the right to use a specific intellectual property owned by another party under specified conditions. It doesn't transfer ownership but allows for certain usages, often in exchange for compensation.</skos:definition>
  </rdf:Description>
