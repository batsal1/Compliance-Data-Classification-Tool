  <rdf:Description rdf:about="https://folio.openlegalstandard.org/rFxiFFIgR0e-HtHVgb0d9Q">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/k2PELw1fQ1Skibbx-oujJg"/>
    <skos:example>Milo farming</skos:example>
    <skos:example>Oat farming</skos:example>
    <skos:example>Oilseed and grain combination farming</skos:example>
    <skos:example>Sorghum farming</skos:example>
    <skos:example>Wild rice farming</skos:example>
    <skos:example>Barley farming</skos:example>
    <skos:example>Rye farming</skos:example>
    <skos:definition>This industry comprises establishments primarily engaged in (1) growing grain(s) and/or producing grain seeds (except wheat, corn, and rice) or (2) growing a combination of grain(s) and oilseed(s) with no one grain (or family of grains) or oilseed (or family of oilseeds) accounting for one-half of the establishment's agricultural production (i.e., value of crops for market).  Combination grain(s) and oilseed(s) establishments may produce oilseed(s) and grain(s) seeds and/or grow oilseed(s) and grain(s).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Other Grain Farming</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=11119"/>
  </rdf:Description>
