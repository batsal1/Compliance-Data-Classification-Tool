    <skos:altLabel xml:lang="zh-cn">毒丸条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פיל הרעל</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de pilule empoisonnée</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Poison Pill Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">जहरीली गोली धारा</skos:altLabel>
    <rdfs:label>Poison Pill Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A poison pill clause is a provision in a contract that is designed to deter or prevent a hostile takeover by making the target company less attractive to the acquiring company.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/fadc774VQCqpSPzpFfiiOA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in renting or leasing, without drivers, one or more of the following: trucks, truck tractors, buses, semi-trailers, utility trailers, or RVs (recreational vehicles).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=532120"/>
    <rdfs:label>Truck, Utility Trailer, and RV (Recreational Vehicle) Rental and Leasing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/T9ZFMFADSVG3dMO9tIAR6A"/>
  </rdf:Description>
