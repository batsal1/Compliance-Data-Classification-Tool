    <skos:altLabel xml:lang="pt-br">Monitor</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Monitor</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">显示器</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Moniteur</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Monitor</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Monitor</skos:altLabel>
    <skos:altLabel>Monitor</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Monitor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मॉनिटर</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">モニター</skos:altLabel>
    <skos:hiddenLabel>MNTR</skos:hiddenLabel>
    <dc:identifier>MNTR</dc:identifier>
    <rdfs:label>Monitor</rdfs:label>
    <skos:definition>Under Canadian Companies' Creditors Arrangement Act (CCAA), a Monitor is an independent third party who is appointed by the Court to monitor the company's ongoing operations and assist with the filing and voting on the Plan of Arrangement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-MNTR</ns2:legacyIdentifier>
  </rdf:Description>
