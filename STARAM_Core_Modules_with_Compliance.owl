  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBlP4jPWT9e54PHs0Uib1qN">
    <skos:altLabel>Net Cash Settlement</skos:altLabel>
    <skos:altLabel>Cash-Settled Settlement</skos:altLabel>
    <skos:altLabel>Cash Payment Settlement</skos:altLabel>
    <skos:altLabel>Monetary Settlement</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Cash Asset Delivery refers to the settlement of a contract through the payment or receipt of a net cash amount instead of the actual delivery of the underlying assets. This method is commonly used in financial instruments and derivatives to simplify the settlement process and avoid the logistics of transferring physical assets.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSx31xBISrYHFCYIgupzdB"/>
    <rdfs:label>Cash Asset Delivery</rdfs:label>
    <skos:prefLabel>Cash Settlement Mode</skos:prefLabel>
  </rdf:Description>
