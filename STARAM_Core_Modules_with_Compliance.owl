  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8p2FPLcIUbqCDah7JqnJjj">
    <skos:altLabel xml:lang="en-gb">Covenant Not to Compete Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de no competencia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不竞争条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wettbewerbsverbotklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-concurrence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de no competencia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de não concorrência</skos:altLabel>
    <skos:altLabel>Noncompete Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वादा नहीं करता कि प्रतिस्पर्धा क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף לא להתחרות בברית</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">競業禁止条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Covenant Not to Compete Clause, also known as a Noncompete Clause, is a contractual clause that prohibits an individual from engaging in certain competitive activities with another party for a specified period of time and within a specific geographic area.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Covenant Not to Compete Clause</rdfs:label>
  </rdf:Description>
