  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7m7hUozBtx7JODLD9VRxlY">
    <skos:definition>A motorcycle driver is an individual who operates a motorcycle, controlling its mechanisms to navigate roads and other environments. This role entails a distinct set of skills and adherence to specific traffic laws to ensure the safety of the driver and other road users.</skos:definition>
    <skos:altLabel>Biker</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bNzp6lTyATfctRVnXr5rl"/>
    <rdfs:label>Motorcyclist</rdfs:label>
    <skos:prefLabel>Motorcycle Driver</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
