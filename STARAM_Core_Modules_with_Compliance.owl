  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB2xHmzy83UmUKqFoA6qW0j">
    <skos:altLabel xml:lang="fr-fr">Bénéficiaire en vertu de la "Clause de bénéficiaire"</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">根据“接收方条款”的接收方</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">"受信者条項"に基づく受信者</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">"रिसीवर क्लॉज" के तहत रिसीवर</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Receiver Under "Receiver Clause"</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Receptor bajo la "Cláusula de Receptor"</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Empfänger gemäß "Empfängerklausel"</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Receptor nos termos da "Cláusula de receptor"</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Receptor bajo la "Cláusula de Receptor"</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מקבל תחת "סעיף מקבל"</skos:altLabel>
    <skos:definition>A "Receiver Under Receiver Clause" is a person or entity appointed by a court to take possession and control of property or assets specified in a receiver clause of a legal document, such as a contract or mortgage, in order to protect the interests of a party to the document.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R96NpUUsxlbrpJSPTQxDoH9"/>
    <rdfs:label>Receiver Under "Receiver Clause"</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
