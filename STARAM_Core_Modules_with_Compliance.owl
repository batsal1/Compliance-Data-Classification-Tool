    <skos:altLabel xml:lang="he-il">ספק שירותי משפט - אדם</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prestador de serviços jurídicos - Pessoa</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Legal Services Provider - Person</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法律サービスプロバイダー - 個人</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">法律服务提供者 - 个人</skos:altLabel>
    <skos:definition>A Legal Services Provider - Person is an individual who provides legal services and is associated with specific invoice data, including their provider level, timekeeper ID, first name, and last name.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Na84ff2b15ab942fe95a2095c2ba1d0ce"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9x6yqzHQfo3MF4rxIcPupm"/>
