    <skos:altLabel xml:lang="es-mx">Acuerdo de Apoyo a la Reestructuración</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de soutien à la restructuration</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unterstützungsvereinbarung zur Restrukturierung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de Apoyo a la Reestructuración</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם תמיכה במבנה מחדש</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Acordo de apoio à reestruturação</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">再編支援契約</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पुनर्गठन समर्थन समझौता</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Restructuring Support Agreement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">重组支持协议</skos:altLabel>
    <rdfs:label>Restructuring Support Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <skos:definition>Document where parties agree to terms that will expedite the restructuring process.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCnYAcY56qvSzuXZr7IwhJ8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Fraude por terceiros fora do contrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הונאה על ידי אחרים מחוץ לחוזה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約外の第三者による詐欺行為</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fraude por terceros fuera del contrato</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同外他人的欺诈行为</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude par des tiers en dehors du contrat</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fraude por terceros fuera del contrato</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अन्यों द्वारा ढिलासे के बाहर धोखाधड़ी</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fraud by Others Outside Contract</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betrug durch Dritte außerhalb des Vertrags</skos:altLabel>
    <rdfs:label>Fraud by Others Outside Contract</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <skos:definition>Fraud by Others Outside Contract refers to a claim of deceitful conduct by a party who is not a party to the contract, but whose actions have caused harm to one of the parties to the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N58eb386d1d674b4ca53b96b059f30419">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Confidentiality"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/olyubYKMS-ijBYzsgFPdEg">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) custom mixing and blending plastics resins made elsewhere or (2) reformulating plastics resins from recycled plastics products.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/kyN-KUDNTweyrC4jbi9QXw"/>
    <rdfs:label>Custom Compounding of Purchased Resins</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325991"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDEsNxpV351E5TtKBHJvCAJ">
    <rdfs:label>Specific Bequest</rdfs:label>
    <skos:altLabel>Designated Gift</skos:altLabel>
    <skos:prefLabel>Specific Testamentary Gift</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Specific Bequest is a provision in a will or trust that designates a particular item or specific piece of property to be given to a designated beneficiary. This type of bequest clearly identifies the asset to ensure the precise distribution of that item upon the testator's death.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3OI7nrib1LEPtUfn5G5CH"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Vr8LHaWSHlOwgKd2pLgCZ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="ja-jp">株式伝説条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Aktienlegenden</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de leyendas de acciones</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Stock Legends Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אגדות מניות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de légendes d'actions</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">股票传奇条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de leyendas de acciones</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de lendas de ações</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्टॉक लेजेंड्स क्लॉज</skos:altLabel>
    <rdfs:label>Stock Legends Clause</rdfs:label>
    <skos:definition>A Stock Legends Clause is a provision in a contract that requires the disclosure of certain information related to the sale or transfer of securities, such as restrictions on resale or ownership.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8kzhwTd7KeEPjyAyHRAkAb">
    <skos:altLabel xml:lang="es-mx">Defensa de deposición</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Defensa de deposición</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Defesa da deposição</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verteidigung der Zeugenaussage</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Defending Deposition</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">辩护证言</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">証言の弁護</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגנה על הפסקת עדות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बचाव गवाही</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défense de la déposition</skos:altLabel>
    <rdfs:label>Defending Deposition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvtywUiDKBUTbufifIxsAh"/>
    <skos:definition>Defending Deposition refers to the legal process of representing a party in a deposition and protecting their interests, typically in response to a legal dispute or claim.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVd315wFUPDWLD0jxW01ba">
    <skos:altLabel xml:lang="es-es">Indemnización por parte de la persona que ordena el delito</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Indemnification from Person Ordering Tort</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">侵害を命じた人からの補償</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Indemnisation de la personne ayant commandé le délit</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Entschädigung von der Person, die den Schaden verursacht hat</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यक्ति द्वारा घटना के आदेश देने से भरपाई</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיצוי מהאדם המזמין עוול</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indenização da pessoa que ordenou o ato ilícito</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">从下令侵权的人获得赔偿</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Indemnización por parte de la persona que ordena el delito</skos:altLabel>
    <rdfs:label>Indemnification from Person Ordering Tort</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Indemnification from Person Ordering Tort: A legal concept that refers to the compensation or protection provided to a party who is held liable for a tortious act, but is entitled to be reimbursed by the person who ordered or directed the act.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLNlm7nXyJQLJmk8qYnaPQ"/>
  </rdf:Description>
