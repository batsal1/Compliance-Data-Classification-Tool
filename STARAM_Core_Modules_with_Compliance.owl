  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RFCom7HmbLadGcpGO751NZ">
    <rdfs:label>Guarantee Clause Claim</rdfs:label>
    <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Garantía</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de garantia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गारंटी शर्त दावा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Guarantee Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de clause de garantie</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Garantieanspruch</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保证条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף הגנה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Garantía</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保証条項請求</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5bITZZ0taJOXwcwS314VU"/>
    <skos:definition>A Guarantee Clause claim refers to a legal argument based on the Guarantee Clause of the United States Constitution, asserting that the federal government has a duty to guarantee a republican form of government to each state. It aims to ensure that states are protected against domestic insurrection or the imposition of undemocratic forms of government.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
