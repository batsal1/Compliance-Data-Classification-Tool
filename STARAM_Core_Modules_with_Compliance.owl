    <skos:altLabel xml:lang="ja-jp">最高経営責任者</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Director Ejecutivo</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מנכ״ל</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Chief Executive Officer</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Diretor executivo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मुख्य कार्यकारी अधिकारी</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Director General</skos:altLabel>
