    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Amendment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RwJIQy6QbfofSLqbRRp1pw">
    <skos:altLabel xml:lang="pt-br">Reclamação de seguro injustamente atrasada ou negada</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बीमा दावा गलती से देरी से या अस्वीकृत किया गया</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de seguro injustamente retrasada o denegada</skos:altLabel>
    <skos:altLabel>Late Payment of Claims</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de seguro injustamente retrasado o denegado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insurance Claim Wrongfully Delayed or Denied</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versicherungsanspruch zu Unrecht verzögert oder abgelehnt</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保险索赔被错误地延迟或拒绝</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation d'assurance injustement retardée ou refusée</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת ביטוח שגויה ומתעכבת או נדחית</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保険請求が不当に遅延または拒否されました</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
    <rdfs:label>Insurance Claim Wrongfully Delayed or Denied</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Insurance Claim Wrongfully Delayed or Denied refers to a situation where an insurance company unjustly postpones or denies payment to a policyholder for a claim that is covered under the policy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8n48IxRrEtKzQbaRVbwqr">
    <skos:altLabel xml:lang="hi-in">गवाही न देने वाला विशेषज्ञ</skos:altLabel>
    <skos:altLabel xml:lang="de-de">nicht aussagender Experte</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">especialista não testemunhante</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">expert non-témoignant</skos:altLabel>
    <skos:altLabel>Retained Expert</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">証言しない専門家</skos:altLabel>
    <skos:altLabel>Specially Employed Expert</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非证人专家</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Non-Testifying Expert</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Experto no testificante</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Experto no testificante</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מומחה לא מעיד</skos:altLabel>
    <skos:definition>An expert whom a party retains for consultation, but the expert does not provide oral testimony or a written report.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Non-Testifying Expert</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmpvD4XLJx0kkUTZ3QIadI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7OtUosForl1Zon7KU3gQQR">
    <skos:definition>A Real Estate Operator is a professional or entity responsible for the day-to-day management, maintenance, and operations of real estate properties. This role includes overseeing property functions, ensuring tenant satisfaction, handling leasing activities, and maintaining the physical condition of the property.</skos:definition>
    <skos:altLabel>Real Estate Manager</skos:altLabel>
    <skos:altLabel>Property Operator</skos:altLabel>
    <rdfs:label>Real Estate Operator</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDm4rfXgHt9wIDHbrUUGCGL"/>
    <skos:prefLabel>Property Manager</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBRlAHjnoCfJOEnSFMbVyHB">
    <rdfs:label>No Smoking Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="he-il">הוראת אי-עישון</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de No Fumar</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">禁煙条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">禁止吸烟条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Smoking Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de não fumar</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">धूम्रपान निषेध अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rauchverbot-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-fumeur</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de No Fumar</skos:altLabel>
    <skos:definition>A No Smoking Clause is a provision in a contract that prohibits smoking in a certain area or premises.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/u3vWIxTJSVuTaMFWrzwtCw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/2aiCfNVQQ26656V64RKYqg"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=45619"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Sick room supply retailers</skos:example>
    <skos:example>Convalescent supply retailers</skos:example>
    <skos:example>Vitamin retailers</skos:example>
    <skos:example>Wheelchair retailers</skos:example>
    <skos:example>Hearing aid retailers</skos:example>
    <rdfs:label>Other Health and Personal Care Retailers</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in retailing health and personal care items (except drugs, medicines, cosmetics, beauty supplies, perfumes, and optical goods).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/VtvaT5V-TRukXG3kI9MxYA">
    <rdfs:label>Record Production and Distribution</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=512250"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/fPQmRxu2Q7Sg6_Dz_jDu5w"/>
    <skos:definition>This industry comprises establishments primarily engaged in record production and/or releasing, promoting, and distributing sound recordings to wholesalers, retailers, or directly to the public. These establishments contract with artists, arrange and finance the production of original master recordings, and/or produce master recordings themselves, such as digital music and compact discs. Establishments in this industry hold the copyright to the master recording, or obtain reproduction and distribution rights to master recordings produced by others, and derive most of their revenues from the sales, leasing, licensing, or distribution of master recordings.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/uF5peA3LSQStw_jNvwgv8g">
    <skos:definition>This industry comprises establishments primarily engaged in underwriting, originating, and/or maintaining markets for issues of securities, or acting as agents (i.e., brokers) between buyers and sellers in buying or selling securities on a commission or transaction fee basis. Investment bankers act as principals (i.e., investors who buy or sell on their own account) in firm commitment transactions or act as agents in best effort and standby commitments. This industry also includes establishments acting as principals in buying or selling securities generally on a spread basis, such as securities dealers or stock option dealers.</skos:definition>
    <skos:example>Securities brokerages</skos:example>
    <skos:example>Securities underwriting</skos:example>
    <skos:example>Stock options dealing</skos:example>
    <skos:example>Stock brokerages</skos:example>
    <skos:example>Bond dealing (i.e., acting as a principal in dealing securities to investors)</skos:example>
    <skos:example>Mutual fund agencies (i.e., brokerages)</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/wdSRFtURSqSleECvfQUS_g"/>
    <rdfs:label>Investment Banking and Securities Intermediation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=523150"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#arisesInPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://staram.in/ontology/epc#Risk"/>
    <rdfs:range rdf:resource="https://staram.in/ontology/epc#ProjectPhase"/>
    <rdfs:label xml:lang="en">arises in phase</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBhkRzl30PudT2hM5OESMlu">
    <skos:altLabel xml:lang="es-es">Violación de equipo de drogas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Drug Equipment Violation</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de l'équipement de drogue</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ड्रग उपकरण उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Violación de equipo de drogas</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">麻薬器具違反</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">毒品设备违规</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת ציוד סמים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verstoß gegen das Betäubungsmittelgesetz</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de equipamento de drogas</skos:altLabel>
    <rdfs:label>Drug Equipment Violation</rdfs:label>
    <skos:definition>The unlawful manufacture, sale, purchase, possession, or transportation of equipment or devices utilized in preparing and/or using drugs or narcotics.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ra8NCYdJb9YwmAxaOmLDbI"/>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/agent">
    <rdfs:comment>an entity that acts or has the capability to act.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R738y5iEyY6bm1AGMZeNq4A"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RysulJVLLFPkPX8Y2gHIAp"/>
    <rdfs:label>oasis:agent</rdfs:label>
    <skos:definition>An "oasis:agent" is a type of agent or actor within the context of the OASIS standard, which is used to represent individuals or organizations that are involved in some way in a particular activity or process.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5gr74UUVFLxDfxLBxIGlG">
    <skos:altLabel xml:lang="de-de">Kosten der Verteidigung gegen Derivateklagen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עלות הגנה מפני תביעה נגדית מגזרית</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Coste de defensa contra demanda derivada</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Custo da defesa contra ação derivativa</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Costo de defensa contra demanda derivada</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Coût de la défense contre les actions dérivées</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">डेरिवेटिव सूट के खिलाफ बचाव का खर्च</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">派生訴訟に対する防御費用</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Cost of Defending Against Derivative Suit</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">防御衍生诉讼的成本</skos:altLabel>
    <rdfs:label>Cost of Defending Against Derivative Suit</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N4ff10c469797434b8f9b4fb3e0c3b2f0"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <skos:definition>The cost incurred by a corporation or partnership in defending against a lawsuit brought by its shareholders alleging wrongdoing by the company's management.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4e5794e0ff7541b7a0851c9374dd6a18">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#NoWaiver"/>
