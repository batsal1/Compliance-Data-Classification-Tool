  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9OfZsgy3e7BzLDC7wsjuKA">
    <skos:altLabel xml:lang="es-es">Mala praxis endocrinológica</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">内分泌学医疗事故</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Endocrinology Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica em endocrinologia</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגיעה רפואית באנדוקרינולוגיה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एंडोक्रिनोलॉजी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en endocrinología</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Endokrinologiefehler</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en endocrinologie</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">内分泌学の医療過誤</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <skos:definition>Endocrinology Malpractice refers to a type of medical malpractice claim that arises from the failure of an endocrinologist to provide appropriate care or treatment to a patient, resulting in harm or injury.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Endocrinology Malpractice</rdfs:label>
  </rdf:Description>
