  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCRmBhsFFN7w3ofoVeU7mZp">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
    <skos:altLabel xml:lang="ja-jp">財産の損害からの保護</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">财产损害保护</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Protection des biens contre les dommages</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schutz des Eigentums vor Schäden</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Proteção da propriedade contra danos</skos:altLabel>
    <skos:definition>The Protection of Property from Damage is a legal objective within the context of Bankruptcy and Restructuring, aimed at safeguarding assets from harm or destruction.</skos:definition>
    <rdfs:label>Protection of Property from Damage</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.canb.uscourts.gov/ecf/manuals/chapter-12-miscellaneous"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RByqj7xAcBT7mYPxL41urdQ">
    <skos:altLabel xml:lang="es-mx">Cláusula de Propiedad Propietaria</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">专有财产条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de propriedade exclusiva</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रोप्राइटरी संपत्ति शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Propiedad Propietaria</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de propriété exclusive</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel für Eigentumsvorbehalte</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Proprietary Property Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף רכוש פרטי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独占的な財産条項</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UB332003aHlAfQeAxehdN"/>
    <rdfs:label>Proprietary Property Clause</rdfs:label>
    <skos:definition>A Proprietary Property Clause is a provision in a contract that grants exclusive ownership rights to a specific property or asset to one party, typically the seller or licensor, and restricts the use or transfer of that property by the other party, typically the buyer or licensee.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/t7qluLs1Q5OIKECnjpqKGw">
    <skos:definition>See industry description for 623990.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/hks8PuKNQ_eNEb-i7HVpJA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=62399"/>
    <rdfs:label>Other Residential Care Facilities</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDJKYhVrQurg0zQmBqlGpTE">
    <skos:altLabel xml:lang="pt-br">Reivindicação de transferência pós-petição</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Créance de transfert post-pétition</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Forderung aus einer Übertragung nach Insolvenzantragstellung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">破産申請後の譲渡請求債権</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Post-Petition Transfer Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de transferencia posterior a la petición</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת העברת חובות לאחר הפטיציה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de transferencia posterior a la petición</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पोस्ट-पिटीशन ट्रांसफर दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">申请后转移索赔</skos:altLabel>
    <rdfs:label>Post-Petition Transfer Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A post-petition transfer claim is a type of avoidance action claim in bankruptcy law that seeks to recover property or assets transferred by a debtor after the filing of a bankruptcy petition.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx"/>
  </rdf:Description>
