  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9urXqVYLqwUXpAConC0lYj">
    <skos:altLabel xml:lang="de-de">Vormundschaft für Minderjährige</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצמתות של קטין</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">未成年者の保護</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">किशोर की संरक्षणशीलता</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未成年人监护</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Conservatorship of Juvenile</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Curatela de Menores</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Tutela de Menores</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Tutelle des mineurs</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Tutela de Menores</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDuglENJJNibMF8YDtmXkpE"/>
    <skos:definition>A conservatorship of juvenile is a legal arrangement where a court appoints a responsible adult to care for a minor's personal and financial needs when the minor's parents are unable to do so.</skos:definition>
    <rdfs:label>Conservatorship of Juvenile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBn1mzQybXv3GivDTfKnPoC">
    <skos:altLabel xml:lang="en-gb">Offset Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de compensación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">抵消条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऑफसेट क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de compensación</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">オフセット条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de compensação</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Offset-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התאמה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de compensation</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Offset Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>An offset clause is a provision in a contract that requires one party to purchase goods or services from the other party in order to balance out payments owed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDXYJseFmtwJ0dEJIJej2Q5">
    <skos:altLabel xml:lang="hi-in">इंटरस्टेट वाणिज्य धारा दावा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Comércio Interestadual</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch aus dem Interstate Commerce Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Comercio Interestatal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Comercio Interestatal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de la clause de commerce inter-États</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">州际商务条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interstate Commerce Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף המסחר בין המדינות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">州間商取引条項クレーム</skos:altLabel>
    <rdfs:label>Interstate Commerce Clause Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwipRpN2mP7u4u1N74MVzK"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Interstate Commerce Clause claim is a legal argument asserting that a state law or regulation violates the authority of the federal government to regulate commerce among the states. This claim is based on the interpretation that the Interstate Commerce Clause grants Congress the power to regulate trade and commerce that crosses state boundaries, thereby restricting state interference in this domain.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBvhPeoPwTNYsc19VBpYjSV">
    <skos:definition>Government Immunity is a legal concept that shields government officials and entities from being held liable for certain actions or omissions in the course of their official duties.</skos:definition>
    <skos:altLabel xml:lang="es-mx">Inmunidad del Gobierno</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חסינות ממשלתית</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Crown Immunity</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Government Immunity</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सरकारी सुरक्षा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Inmunidad del Gobierno</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Immunité gouvernementale</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">政府豁免权</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">政府免責</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Regierungsimmunität</skos:altLabel>
    <skos:altLabel xml:lang="en-ca">Crown Immunity</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Imunidade governamental</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Government Immunity</rdfs:label>
    <rdfs:seeAlso>Sovereign Immunity</rdfs:seeAlso>
  </rdf:Description>
