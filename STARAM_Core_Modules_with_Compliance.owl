    <skos:definition>Orthodontics Malpractice refers to a type of medical malpractice claim that arises from negligent or improper orthodontic treatment by a healthcare professional.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
