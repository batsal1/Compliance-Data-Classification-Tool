  <rdf:Description rdf:about="https://folio.openlegalstandard.org/25jlu29ESRmkWUkx3vBeRg">
    <rdfs:label>Assisted Living Facilities for the Elderly</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=623312"/>
    <skos:example>Rest homes without nursing care</skos:example>
    <skos:example>Assisted living facilities for the elderly without nursing care</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing residential and personal care services without nursing care for (1) the elderly or other persons who are unable to fully care for themselves and/or (2) the elderly or other persons who do not desire to live independently. The care typically includes room, board, supervision, and assistance in daily living, such as housekeeping services.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ftUhDsNlSI679HpQb0H4Ig"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7r9vjnfkpI0wCKJXlxidAp">
    <rdfs:label>Time and Materials Clause</rdfs:label>
    <skos:altLabel xml:lang="he-il">סעיף זמן וחומרים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de temps et de matériaux</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Tiempo y Materiales</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Tiempo y Materiales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Time and Materials Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zeit- und Materialklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">時間と材料条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">时间和材料条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समय और सामग्री शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de tempo e materiais</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Time and Materials Clause is a provision in a contract that specifies that the client will pay for the actual time and materials used by the contractor to complete the project, rather than a fixed price.</skos:definition>
  </rdf:Description>
