  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDthEl0nJJi9RkvBWQqXsQz">
    <skos:altLabel xml:lang="es-es">Práctica de Requisitos posteriores al cierre, disputas y ajustes de M&amp;A J</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de Requisitos, Disputas e Ajustes Pós-Fechamento de M&amp;A J</skos:altLabel>
