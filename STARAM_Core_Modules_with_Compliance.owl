  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDwd5PDZ9zTHHMKlx2ypxmf">
    <skos:altLabel>AI System Reviewability</skos:altLabel>
    <skos:altLabel>AI Assessability</skos:altLabel>
    <skos:altLabel>AI Evaluation Capability</skos:altLabel>
    <skos:altLabel>AI System Inspectability</skos:altLabel>
    <skos:altLabel>AI System Auditability</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7iR8rxIoymNuxMi7I0oh1d"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Auditability of an AI System</rdfs:label>
    <skos:definition>Auditability refers to the ability of an AI system to undergo an assessment of its algorithms, data, and design processes to determine whether the system is functioning as intended. Auditability does not necessarily imply that information about business models and intellectual property must always be openly available, but ensuring traceability and logging mechanisms from the early design phase can help enable the system's auditability</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCH2WttNe5K5xi0HS74SOhs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Technology Procurement Services refers to the process of acquiring technology products and services for an organization, typically involving consulting and management services.</skos:definition>
    <rdfs:label>Technology Procurement Services</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9EU57yyGYQyG3GeOJ1VgMr"/>
  </rdf:Description>
