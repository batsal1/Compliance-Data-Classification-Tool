    <rdfs:label>Tenant Improvement Allowance Clause</rdfs:label>
    <skos:definition>A Tenant Improvement Allowance Clause is a provision in a contract that specifies the amount of money a landlord will contribute towards the cost of improving a tenant's leased space.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#RemedyTier">
    <rdfs:label xml:lang="en">Remedy Tier</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#EPCContractRiskModule"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Position of a drafting remedy in a negotiation ladder: preferred, first fallback, second fallback, walk-away.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDTAI65vxZkLEnbmYBMZ7uU">
    <skos:altLabel xml:lang="de-de">Friedensrichter</skos:altLabel>
