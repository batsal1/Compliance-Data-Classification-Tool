  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RIq5KFUvDX7zWNSq4HzB8C">
    <skos:inSchema>UK</skos:inSchema>
    <skos:definition>The Castle Doctrine is a legal principle derived from English Common Law that gives individuals the right to use force, including deadly force, to protect themselves against an intruder in their home. This doctrine essentially states that a person's home is their castle, and they have the right to defend it without the duty to retreat first, under certain conditions depending on jurisdiction.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en-gb">Reasonable Force in Home Defense</skos:altLabel>
    <rdfs:label>Castle Doctrine</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC3dl9vmBgaZ6Ywk4RCTN7r">
    <rdfs:label>Non-Deliverable Asset</rdfs:label>
    <skos:prefLabel>Non-Deliverable Financial Instruments</skos:prefLabel>
    <skos:altLabel>Synthetic Instruments</skos:altLabel>
    <skos:altLabel>Non-Deliverable Instruments</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSx31xBISrYHFCYIgupzdB"/>
    <skos:definition>Non-Deliverable Assets are financial instruments for which physical delivery of the underlying asset is not permitted or feasible. These assets often involve synthetic options or forwards on foreign exchange (FX) rates for non-convertible or thinly traded currencies.</skos:definition>
  </rdf:Description>
