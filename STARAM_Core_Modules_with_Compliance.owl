  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R996WtCH3h9VroTEbPc4hpS">
    <rdfs:label>Suspension</rdfs:label>
    <skos:definition>Suspension refers to the temporary removal of a person or entity from a position, privilege, or right as a disciplinary measure or precaution. This can occur in various contexts, including education, employment, and government contracts, often pending further investigation or resolution of an issue.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6DLuG3VglXIci9EJ3MwAK"/>
  </rdf:Description>
