    <skos:definition>The concept of Retaliatory Discharge refers to the act of an employer firing an employee in response to the employee engaging in a protected activity, such as reporting discrimination or harassment, in violation of employment laws.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/5JF3YgjGQrOoDLcv7KlIHg">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561730"/>
    <rdfs:label>Landscaping Services</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/qQMZ_3o0R2K_eZJ9FBlF7Q"/>
    <skos:definition>This industry comprises (1) establishments primarily engaged in providing landscape care and maintenance services and/or installing trees, shrubs, plants, lawns, or gardens and (2) establishments primarily engaged in providing these services along with the design of landscape plans and/or the construction (i.e., installation) of walkways, retaining walls, decks, fences, ponds, and similar structures.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
