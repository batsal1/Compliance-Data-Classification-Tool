  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-benchmarking-integrity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Risks that can only be identified by comparison with a standard form, covering undisclosed departures from FIDIC or another model form, particular conditions that contradict the general conditions, cross-reference and numbering errors, copy-and-paste mistakes, and inconsistent figures.</skos:definition>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-legal-liability"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-pre-award"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <rdfs:label xml:lang="en">Benchmarking Against Standard Forms &amp; Drafting Integrity</rdfs:label>
    <skos:notation>LR-20</skos:notation>
    <skos:prefLabel xml:lang="en">Benchmarking Against Standard Forms &amp; Drafting Integrity</skos:prefLabel>
  </rdf:Description>
