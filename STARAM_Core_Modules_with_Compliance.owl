  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5G2alI4BL0BEEMwALfymJ">
    <skos:prefLabel>Single-Lender Loan</skos:prefLabel>
    <rdfs:label>Bilateral Loan</rdfs:label>
    <skos:altLabel>Unilateral Loan</skos:altLabel>
    <skos:altLabel>Direct Loan</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
    <skos:definition>A Bilateral Loan is a loan agreement between a single borrower and a single lender, typically used for straightforward financing needs. Unlike syndicated loans, bilateral loans involve direct negotiation and agreement on terms between the two parties, offering simplicity and flexibility in loan structuring.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
