    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <skos:definition>A homeowner's insurance policy is a contract between a homeowner and an insurance provider that offers financial protection against damages to the home, its contents, and liability claims arising from injuries on the property. The policy typically covers a range of perils such as fire, theft, and natural disasters. Premiums are usually required for the coverage to remain active.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Homeowner's Insurance Policy</rdfs:label>
  </rdf:Description>
