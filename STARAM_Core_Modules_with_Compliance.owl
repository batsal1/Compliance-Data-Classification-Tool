  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDP6SvRGkT1utijCoVroEkK">
    <skos:altLabel xml:lang="es-mx">Incumplimiento del Acuerdo de Joint Venture</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verstoß gegen die Joint-Venture-Vereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת הסכם שותפות משותפת</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Joint Venture Agreement</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento del Acuerdo de Joint Venture</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de l'accord de coentreprise</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">जॉइंट वेंचर समझौते का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合弁契約違反</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação do Acordo de Joint Venture</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反合资协议</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Ne5bf4f27d0e94ed1adaa23f5719b0af2"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC2fjcpsEbrVvVymvt4oASx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The violation of a legally binding agreement between two or more parties to work together on a specific business venture.</skos:definition>
    <rdfs:label>Breach of Joint Venture Agreement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8M6SdXk6zaD07SLJB9PrbT">
    <rdfs:label>taxing_jurisdiction_locality</rdfs:label>
    <skos:definition>"The locality of the taxing jurisdiction.  Use accepted abbreviations for state or province mandated by the country's postal service.  For Canadian PST, taxing_jurisdiction_locality for Ontario would be ""ON""; for Local tax in New York City, taxing_jurisdiction_locality would be ""New York, NY""; for state tax in Georgia (USA), taxing_jurisdiction_locality would be ""GA""; for VAT tax in France, taxing_jurisdiction_locality would be null.
"</skos:definition>
