  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RsHKmukY8RoJdJO1gsTCxN">
    <skos:altLabel xml:lang="zh-cn">建设性解雇</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Licenciement constructif</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Konstruktive Kündigung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Dimisión Constructiva</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Dimisión Inducida</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיטורים מבוססי עצבים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निर्माणात्मक छोड़ देना</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">建設的解雇</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Constructive Dismissal</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dispensa construtiva</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Constructive Discharge</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJYLQ3woaBs6FkT7wMbB4U"/>
    <skos:definition>Constructive Discharge: A legal claim that arises when an employer makes working conditions intolerable for an employee, forcing them to resign, as a result of discrimination or retaliation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBF8uUZ4p08orUeuKLXuVCo">
    <skos:altLabel xml:lang="de-de">Klausel ohne Pfandrechte</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कोई लियन्स क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Liens Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula sin gravámenes</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula sin gravámenes</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">抵当権なし条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause sans privilèges</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula sem ônus</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">无留置权条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ללא משיכות</skos:altLabel>
    <rdfs:label>No Liens Clause</rdfs:label>
    <skos:definition>A No Liens Clause is a provision in a contract that states that the property or assets involved in the agreement are free from any claims or encumbrances by third parties.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ROWsW3Tkpc2YQmbHQehntm">
    <skos:definition>The Mining and Natural Resources Extraction industry group comprises establishments that extract naturally occurring mineral solids, such as coal and ores; liquid minerals, such as crude petroleum; and gases, such as natural gas. The term mining is used in the broad sense to include quarrying, well operations, beneficiating (e.g., crushing, screening, washing, and flotation), and other preparation customarily performed at the mine site, or as a part of mining activity.</skos:definition>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:altLabel xml:lang="es-mx">Industria minera y de extracción de recursos naturales</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית החציבה והחקלאות הטבעית</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria minera y de extracción de recursos naturales</skos:altLabel>
    <skos:altLabel>Mining and Natural Resources Extraction</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">鉱業および天然資源採取産業</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie minière et d'extraction des ressources naturelles</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">采矿和自然资源开采行业</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mining and Natural Resources Extraction Industry</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de mineração e extração de recursos naturais</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खनन और प्राकृतिक संसाधन निष्कर्षण उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Bergbau- und Rohstoffextraktionsindustrie</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
    <rdfs:subClassOf rdf:nodeID="N155b55d6fdb54ee3b753b9f4f2a45d87"/>
    <skos:prefLabel>Mining and Natural Resources Extraction Industry</skos:prefLabel>
    <dc:identifier>IN-INDUSTRY-13</dc:identifier>
    <dc:identifier>NRS</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=21"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:hiddenLabel>NRS</skos:hiddenLabel>
    <rdfs:label>Mining and Natural Resources Extraction Industry</rdfs:label>
