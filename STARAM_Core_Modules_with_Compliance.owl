    <skos:altLabel xml:lang="hi-in">एसेट ड्यू डिलिजेंस प्रैक्टिस</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">資産デューデリジェンスの実践</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de Due Diligence de Activos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Asset Due Diligence Practice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">资产尽职调查实践</skos:altLabel>
