    <rdfs:subClassOf rdf:nodeID="Ne8819eec8e104b96bfcff88eb9dc02ac"/>
    <skos:altLabel xml:lang="hi-in">दिवालियापन छूट</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Exenciones de quiebra</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exemptions de faillite</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">破産免責</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bankruptcy Exemptions</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עמלות פשיטת רגל פשיטת רגל</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Insolvenzfreistellungen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">破产豁免</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Isenções de falência</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Exenciones de bancarrota</skos:altLabel>
    <skos:definition>Bankruptcy Exemptions are legal protections that allow individuals filing for bankruptcy to keep certain assets, such as a primary residence or personal property, from being seized by creditors to satisfy outstanding debts.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bankruptcy Exemptions</rdfs:label>
  </rdf:Description>
