  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC8DXJ0GNORoB93dQNoiSpb">
    <skos:definition>A failure to engage in the interactive process claim is a legal action brought by an employee against their employer, alleging that the employer failed to participate in a collaborative, good-faith effort to determine reasonable accommodations for the employee's disability, religious beliefs, or other protected characteristics. Under anti-discrimination laws like the Americans with Disabilities Act (ADA) and Title VII of the Civil Rights Act of 1964, employers are required to engage in an interactive process with employees seeking accommodations to identify and implement appropriate adjustments that allow the employee to perform their job effectively.</skos:definition>
    <rdfs:label>Failure to Engage in Interactive Process Claim</rdfs:label>
    <skos:altLabel xml:lang="he-il">תביעה על כשל בהשתתפות בתהליך אינטראקטיבי</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure to Engage in Interactive Process Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de Falha em Engajar no Processo Interativo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por Falta de Participación en el Proceso Interactivo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इंटरैक्टिव प्रक्रिया में शामिल न होने का दावा असफलता</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de non-engagement dans le processus interactif</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未能参与互动过程索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por Falta de Participación en el Proceso Interactivo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Nichtdurchführung des interaktiven Prozesses</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">相互プロセスへの参加の失敗の主張</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdfs:subClassOf rdf:nodeID="N463772a236aa4fbfbd50da2f42e33987"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
