    <skos:altLabel xml:lang="hi-in">सिफारिश निवेदन का बदलाव</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Changement de la clause de recommandation</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Alteração da Cláusula de Recomendação</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Änderung der Empfehlungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">建议变更契约</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שינוי ברית ההמלצה</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL"/>
    <rdfs:label>Change of Recommendation Covenant</rdfs:label>
    <skos:definition>A Change of Recommendation Covenant is a provision in a deal protection agreement that requires a target company's board to recommend a new offer to its shareholders, even if it is less favorable than a previous offer, in exchange for certain protections for the acquirer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8NaWaVnkBqgo4SQa0idAnx">
    <skos:altLabel xml:lang="es-es">Autoridad aparente</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">表见授权</skos:altLabel>
    <skos:altLabel xml:lang="he-il">רשות נראית</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pouvoir apparent</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Apparent Authority</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Scheinbare Vollmacht</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रतीत प्राधिकरण</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Autoridad aparente</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Autoridade aparente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">明白な権限</skos:altLabel>
    <rdfs:label>Apparent Authority</rdfs:label>
    <skos:definition>The concept of Apparent Authority refers to the legal principle that holds a principal liable for the actions of an agent who appears to have the authority to act on their behalf, even if the agent does not actually have such authority.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCGW5RFfjJ95ygeSCJLaJQT"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
