    <skos:prefLabel xml:lang="en">Safety Obligation Allocation Onerous</skos:prefLabel>
    <skos:notation>RH-151</skos:notation>
    <ns5:classificationMethod xml:lang="en">Category and serial number were taken directly from the source register. Drafting defect type, project phase and impact type were assigned automatically using keyword rules applied to the risk head name and its category.</ns5:classificationMethod>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8eyrMKsBdxrPX1h0KIqExG">
    <skos:altLabel xml:lang="en-gb">Sweeping Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף כללי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula General</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula abrangente</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur umfassenden Anspruchserhebung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वीपिंग क्लॉज क्लेम</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de revendication globale</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">全面条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">包括的な条項主張</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Cláusula General</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
    <skos:definition>A Sweeping Clause claim is a legal argument asserting that a law or action exceeds the authority granted by a broad clause in a constitution or statute, contending that it goes beyond what is expressly stated or implied. The claim challenges the constitutionality or validity of the law or action based on the interpretation that it exceeds the scope of the sweeping clause.</skos:definition>
    <rdfs:label>Sweeping Clause Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RS6Pedvqd6vX99HwyhZIlP">
    <skos:definition>Limitations on Antitrust Efforts Standards refer to specific provisions or rules that restrict the extent to which antitrust efforts can be pursued in a legal matter, such as dollar-based, materiality-based, or MAE-based standards, among others.</skos:definition>
    <skos:altLabel xml:lang="pt-br">Padrões de limitações aos esforços antitruste</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Limitaciones en los Estándares de Esfuerzos Antimonopolio</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Limitaciones en los Estándares de Esfuerzos Antimonopolio</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Limitations on Antitrust Efforts Standards</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट प्रयास मानकों पर सीमाएं</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beschränkungen der Bemühungen im Bereich des Wettbewerbsrechts</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">競争法の努力に対する制限基準</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגבלות על מדדי מאמץ אנטיטרוסטיים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Normes limitant les efforts en matière d'antitrust</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反垄断努力标准的限制</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Limitations on Antitrust Efforts Standards</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwjUss6QZVzUsfsKBJ0kHX"/>
  </rdf:Description>
