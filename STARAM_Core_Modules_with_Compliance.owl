    <rdfs:label>Notice and Right to Cure Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Notice and Right to Cure Clause is a provision in a legal agreement that requires a party to provide notice of a breach and an opportunity to cure the breach before taking legal action.</skos:definition>
  </rdf:Description>
