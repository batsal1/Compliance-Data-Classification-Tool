    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Research and Development in the Social Sciences and Humanities</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ttp4GbyJQRiufXdqBE3Ifw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541720"/>
    <skos:definition>This industry comprises establishments primarily engaged in conducting research and analyses in cognitive development, sociology, psychology, language, behavior, economic, and other social science and humanities research.</skos:definition>
