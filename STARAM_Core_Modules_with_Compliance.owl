  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R97IBWgfGo1Wqm1BS8iC7Sf">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="en-gb">General Release Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula General de Liberación</skos:altLabel>
