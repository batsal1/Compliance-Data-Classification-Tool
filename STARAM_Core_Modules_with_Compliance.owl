  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R85PmuqV6ngjn65DDOJI1Di">
    <skos:prefLabel>Elderly Market Segment</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ6hoxQD6Sa9Hi4bnv1jgC"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The senior market segment refers to a division of the market that is specifically targeted towards senior citizens or older adults as consumers. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of seniors, taking into account factors such as health, mobility, and lifestyle.</skos:definition>
    <rdfs:label>Senior Market Segment</rdfs:label>
  </rdf:Description>
