    <ns1:functionalCategory xml:lang="en">4. Covenants &amp; Conduct of Parties</ns1:functionalCategory>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8AUKvbXRK8jOHSQaqxcAtD">
    <rdfs:subClassOf rdf:nodeID="N378697d1020f4683be9b9050c4e5af41"/>
    <rdfs:subClassOf rdf:nodeID="N098aa4f9d3bc4a14aaf2bd36a6433ae3"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDhSx7fl9qS0ezDVJuZHX4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Legal Determination</rdfs:label>
    <skos:definition>"Litigation determination" refers to the final outcome or verdict reached in a legal dispute or trial. It can include findings such as "guilty" in a criminal case or "liable" in a civil case when a party is held responsible, or "acquitted" when a defendant is found not guilty in a criminal trial. A single matter's legal determination can be split between claims (e.g., liable for one claim; not liable for another claim).</skos:definition>
  </rdf:Description>
