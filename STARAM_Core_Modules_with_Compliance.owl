  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/WEmfMdZSRJye75jPt8niEQ">
    <rdfs:label>Metal Ore Mining</rdfs:label>
    <skos:definition>This industry group comprises establishments primarily engaged in developing mine sites or mining metallic minerals, and establishments primarily engaged in ore dressing and beneficiating (i.e., preparing) operations, such as crushing, grinding, washing, drying, sintering, concentrating, calcining, and leaching. Beneficiating may be performed at mills operated in conjunction with the mines served or at mills, such as custom mills, operated separately.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=2122"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7OA1fGV1VIu5tK8bsCx3SE"/>
  </rdf:Description>
