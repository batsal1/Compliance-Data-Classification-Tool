  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDUpsTyXQ0DzRptj7UYlc3Z">
    <skos:altLabel xml:lang="ja-jp">単独救済条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">唯一救济条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur ausschließlichen Abhilfe</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एकमात्र उपाय शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de único recurso</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de remédio exclusivo</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de único remedio</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פיצול ויחיד</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de recours exclusif</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Sole Remedy Clause</skos:altLabel>
    <skos:definition>A Sole Remedy Clause is a provision in a contract that limits the available remedies to only those specified in the clause, thereby excluding any other legal remedies that may be available.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBhmDmdZWNMpZfSRDHWVP2v"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sole Remedy Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="hi-in">एजेंसी और विकारी दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">代理和代理责任</skos:altLabel>
    <skos:altLabel>Agency Claims</skos:altLabel>
    <skos:altLabel>Vicarious Liability</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Agence et responsabilité vicariante</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Agentur und Stellvertreterhaftung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">代理店と代理責任</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סוכנות ואחריות חלופית</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Agencia y responsabilidad vicaria</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Agency &amp; Vicarious Liability</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Agência e responsabilidade vicária</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Agencia y responsabilidad vicaria</skos:altLabel>
    <skos:definition>Agency &amp; Vicarious Liability refers to the legal responsibility of one party for the actions of another party who is acting on their behalf or under their control, such as an employer being held liable for the actions of their employee.</skos:definition>
    <rdfs:label>Agency &amp; Vicarious Liability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
  </rdf:Description>
