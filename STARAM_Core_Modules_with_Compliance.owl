    <skos:altLabel>Appellate Argument</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de l'argumentation en appel</skos:altLabel>
    <skos:altLabel>Oral Argument</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de argumentación de apelación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Appellate Argument Practice</skos:altLabel>
    <rdfs:label>Appellate Argument Practice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKT1I6J8ce2Gs6xwwFcUTr"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Appellate Argument Practice refers to the specialized legal practice of preparing and presenting arguments before an appellate court, with the aim of persuading the court to overturn or modify a lower court's decision.</skos:definition>
  </rdf:Description>
