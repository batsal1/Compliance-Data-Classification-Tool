  <rdf:Description rdf:about="https://folio.openlegalstandard.org/qHP1aBSyQemSFOUkgAawCg">
    <skos:definition>This industry comprises establishments primarily engaged in providing credit by issuing credit cards. Credit card issuance provides the funds required to purchase goods and services in return for payment of the full balance or payments on an installment basis. Credit card banks are included in this industry.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NSuHU9KfQAyMsU7Yjh1k1g"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Credit Card Issuing Industry</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=522210"/>
  </rdf:Description>
