  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RGCpbuNOHtlNDogCc7dOLY">
    <skos:altLabel xml:lang="de-de">Angemessener Glaube</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उचित विश्वास</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אמון סביר</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合理信念</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Creencia razonable</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reasonable Belief</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合理的信念</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Creencia razonable</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Crença razoável</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Croyance raisonnable</skos:altLabel>
    <skos:definition>A reasonable belief is a standard of proof in litigation where a party must demonstrate that they held a belief that was objectively reasonable under the circumstances, in order to meet their burden of proof.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Reasonable Belief</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R06Sp88qagFiEJOw6rbB8W">
    <skos:altLabel xml:lang="ja-jp">請求放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">放弃索赔条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver of Claim Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation à la réclamation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia de reclamo</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור מתביעה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दावा अधिनियम धारा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia de reivindicação</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia de reclamación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzichtsklausel</skos:altLabel>
    <skos:definition>A Waiver of Claim Clause is a provision in a legal agreement where one party agrees to relinquish their right to pursue a claim against the other party for a specific matter.</skos:definition>
    <rdfs:label>Waiver of Claim Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
  </rdf:Description>
