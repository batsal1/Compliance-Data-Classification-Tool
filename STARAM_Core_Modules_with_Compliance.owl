    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Ti8xGiWI5NzMSs5upZUo6"/>
    <skos:definition>This industry group comprises establishments primarily engaged in one of the following: (1) investigation, guard, and armored car services; (2) selling security systems, such as burglar and fire alarms and locking devices, along with installation, repair, or monitoring services; or (3) remote monitoring of electronic security alarm systems.</skos:definition>
    <rdfs:label>Investigation and Security Services</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5616"/>
  </rdf:Description>
