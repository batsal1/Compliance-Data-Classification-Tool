    <skos:altLabel xml:lang="en-gb">Mistake in Contract</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Error en el contrato</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Erro no contrato</skos:altLabel>
