  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Aq6t-PNYQ_K8Ch4JzoS9cA">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) milling flour or meal from grains (except rice) or vegetables and/or (2) milling flour and preparing flour mixes or doughs.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/oS3ZjajvSPWy2t8a-D2yAQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311211"/>
    <rdfs:label>Flour Milling</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBDu2ulMPR4euCCHct7husV">
    <rdfs:subClassOf rdf:nodeID="N60bed8a52a904911bb843354fd69ee14"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RS1hG7BxbLQktXIrO1Rro"/>
    <skos:definition>A Regulatory Petitioner refers to an individual or entity formally requesting legal or official approval from a regulatory body, often through a structured application process. This encompasses a wide array of requests, from immigration status changes to the issuance of permits for business operations or environmental actions.</skos:definition>
    <rdfs:label>Regulatory Petitioner</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/TQN-9LhNROaet25g6dvHwg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/67ndUHFyQze8OuwCMzRTTQ"/>
    <rdfs:label>Other Grantmaking and Giving Services</rdfs:label>
    <skos:definition>United fund councils</skos:definition>
    <skos:definition>This U.S. industry comprises establishments (except voluntary health organizations) primarily engaged in raising funds for a wide range of social welfare activities, such as educational, scientific, cultural, and health.</skos:definition>
    <skos:definition>Community chest fundraising organizations</skos:definition>
    <skos:definition>Federated charities</skos:definition>
    <skos:definition>Illustrative Examples:</skos:definition>
    <skos:definition>United funds for colleges</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=813219"/>
  </rdf:Description>
