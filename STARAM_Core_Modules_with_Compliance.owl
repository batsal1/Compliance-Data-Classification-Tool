  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCZ0OXujsRfaR7EjgilzFHa">
    <skos:altLabel xml:lang="ja-jp">作物生産産業</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anbauindustrie</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">农作物生产行业</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de produção de culturas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Crop Production Industry</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית ייצור צמחייה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फसल उत्पादन उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de producción de cultivos</skos:altLabel>
    <skos:altLabel>Crop Production</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie de la production de cultures</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de producción de cultivos</skos:altLabel>
    <skos:hiddenLabel>CROP</skos:hiddenLabel>
    <dc:identifier>IN-INDUSTRY-2.2</dc:identifier>
    <dc:identifier>AGR-CROP</dc:identifier>
    <rdfs:label>Crop Production Industry</rdfs:label>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-AGR-CROP</ns2:legacyIdentifier>
    <skos:definition>Industries in this group grow crops mainly for food and fiber. The subsector comprises establishments, such as farms, orchards, groves, greenhouses, and nurseries, primarily engaged in growing crops, plants, vines, or trees and their seeds.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:prefLabel>Crop Production Industry</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R92xsHpdHu6BJjtepuRu"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC1urpPzVe8K0KWD91BzGKP">
    <rdfs:label>Contract in Force Clause</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Contract in Force Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फोर्स में कर्तव्य अनुबंध धारा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約有効条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Vertragsdurchsetzung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de mise en vigueur du contrat</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">生效条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Contrato en Vigor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף חוזה בתוקף</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Contrato en Vigor</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de vigência do contrato</skos:altLabel>
    <skos:definition>A Contract in Force Clause is a provision in a contract that specifies the conditions under which the agreement remains valid and enforceable.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9IkFUwMggGV4EMZUJMmcMo">
    <rdfs:label>Novelty</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV2029Q3Zi4LQ1ehMJNj3w"/>
    <skos:definition>Novelty in legal terms signifies that an invention must be new or original, not previously known or used, to be patentable. It ensures that patents are granted only for genuinely new advancements, not for modifications of existing ones.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8kmkbl5tqKfNDvX5GK5erz">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Cláusula de bônus de assinatura</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de prime de signature</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">署名ボーナス条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de bonificación por firma</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">签署奖金条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בונוס חתימה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Signing Bonus Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de bonificación por firma</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Unterzeichnungsprämie</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">साइनिंग बोनस क्लॉज</skos:altLabel>
    <rdfs:label>Signing Bonus Clause</rdfs:label>
    <skos:definition>A signing bonus clause is a provision in a contract that provides for an additional payment to be made to an individual upon signing the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfc4566c3e34c48879dbc8bc61da2495e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RLNlm7nXyJQLJmk8qYnaPQ"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDTMM3ZoEewjTi905Xi6esX">
    <skos:altLabel xml:lang="zh-cn">修订和重新制定的协议条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संशोधित और पुनर्स्थापित समझौता धारा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Geänderte und neu gefasste Vertragsklausel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Amended and Restated Agreement Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Acordo Alterada e Restabelecida</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo Modificado y Reestablecido</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'accord amendée et révisée</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo Modificado y Reestablecido</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכם מתוקן ומחודש</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">改訂および再締結された契約条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UiQA8gafbU8G6XKu27y62"/>
    <skos:definition>An Amended and Restated Agreement Clause is a provision in a legal document that outlines the changes made to an existing agreement and replaces it in its entirety with a new agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Amended and Restated Agreement Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCjV94XrA98iWZaM3e1b2da">
    <skos:altLabel xml:lang="en-gb">Lodestar Fee Methodology</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שיטת תעריף לודסטאר</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">极星费用计算方法</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Lodestar-Gebührenmethodik</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ロードスター手数料方式</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Metodologia de taxas de estrela guia</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Metodología de tarifas Lodestar</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लोडेस्टार फी मेथडोलॉजी</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Méthodologie des frais de l'étoile polaire</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Metodología de tarifas Lodestar</skos:altLabel>
    <rdfs:label>Lodestar Fee Methodology</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlDwAh4h0X7Sosy5SLccvX"/>
    <skos:definition>A lodestar fee methodology is a system used to calculate attorney fees based on the number of hours worked multiplied by an hourly rate, which is then adjusted based on various factors such as the complexity of the case and the experience of the attorney.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9ZnPQz0FrHlGYSKC7WWuY">
    <skos:altLabel xml:lang="pt-br">Reivindicação por queda de escadas</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על נפילה מהמדרגות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por caída por las escaleras</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सीढ़ियों से गिरने के लिए दावा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">階段で転倒した場合の請求</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Claim for Falling Down Stairs</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por caída en las escaleras</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Sturz von Treppen</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour une chute dans les escaliers</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">跌倒楼梯索赔</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3"/>
    <rdfs:label>Claim for Falling Down Stairs</rdfs:label>
    <skos:definition>A claim for falling down stairs is a legal action brought by a plaintiff who has suffered injuries as a result of a slip-and-fall incident on a staircase, and is based on the legal theory of negligence.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3e0b08f611b04a859914a063db198d6d">
