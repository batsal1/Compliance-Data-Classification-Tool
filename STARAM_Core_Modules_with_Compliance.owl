  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RxPxADB12qeAIDAFEgWRsz">
    <skos:altLabel xml:lang="zh-cn">私募股权、对冲基金和风险投资法律</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gesetzgebung für Private Equity, Hedgefonds und Risikokapital</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ley de Capital Privado, Fondos de Cobertura y Capital de Riesgo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">プライベートエクイティ、ヘッジファンド、ベンチャーキャピタル法</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit des fonds d'investissement, des fonds spéculatifs et du capital-risque</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ley de Capital Privado, Fondos de Cobertura y Capital de Riesgo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्राइवेट इक्विटी, हेज फंड और वेंचर कैपिटल कानून</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei de Private Equity, Hedge Funds e Venture Capital</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוק הון פרטי, קרנות השתלמות והון סיכון</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Private Equity, Hedge Funds and Venture Capital Law</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCF0BMeSwppddfM6cp6AUBK"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RF0Bb0267149dFC8b5e349a1"/>
    <skos:definition>Private Equity, Hedge Funds, and Venture Capital Law encompasses the legal frameworks governing private equity investments, hedge funds, and venture capital financing. It involves regulations related to fund formation, management, investment, compliance, investor rights, and financial transactions within these sectors.</skos:definition>
    <skos:definition>Private Equity, Hedge Funds and Venture Capital Law refers to the legal principles and regulations governing the formation, operation, and investment activities of private equity, hedge funds, and venture capital firms.</skos:definition>
    <dc:identifier>IN-LAW-9.4</dc:identifier>
    <skos:prefLabel>Private Equity, Hedge Funds and Venture Capital Law</skos:prefLabel>
    <ns2:RDztYH7do2tyqzcXc0HSMnk xml:lang="en-ca">Canada</ns2:RDztYH7do2tyqzcXc0HSMnk>
    <ns2:RDztYH7do2tyqzcXc0HSMnk>Canada</ns2:RDztYH7do2tyqzcXc0HSMnk>
    <rdfs:label>Private Equity, Hedge Funds and Venture Capital Law</rdfs:label>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
