  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9p2y1nt52ThtYwlyLA7oKp">
    <skos:altLabel xml:lang="pt-br">Aplicação de Forward-Looking MAE - Linguagem "Impacto adverso na capacidade de consumar"</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Forward-looking MAE Application - "Adverse impact on ability to consummate" Language</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Application de Forward-Looking MAE - Langue "Impact négatif sur la capacité à mener à bien"</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फॉरवर्ड-लुकिंग एमएई एप्लिकेशन - "कन्समेट करने की क्षमता पर नकारात्मक प्रभाव" भाषा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">前瞻性 MAE 应用 - "对完成能力的不利影响" 语言</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Solicitud de MAE prospectivo - Lenguaje de "Impacto adverso en la capacidad de consumar"</skos:altLabel>
    <skos:altLabel xml:lang="he-il">יישום MAE המבטיח - שפת "השפעה שלילית על היכולת להשלים"</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">Forward-Looking MAE アプリケーション - "完了能力への不利な影響" 言語</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anwendung von Forward-Looking MAE - Sprache "Adverse Auswirkungen auf die Fähigkeit zur Durchführung"</skos:altLabel>
    <skos:altLabel>"Adverse impact on ability to consummate" Language</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Solicitud de MAE prospectivo - Lenguaje de "Impacto adverso en la capacidad de consumar"</skos:altLabel>
    <skos:definition>The "Adverse impact on ability to consummate" Language refers to a provision in a legal agreement that outlines the potential negative effects on the ability to complete a transaction, and is part of the Forward-looking Material Adverse Effect (MAE) Standard.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDpizZcACsM7yyhWpT5tJaM"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Forward-looking MAE Application - "Adverse impact on ability to consummate" Language</rdfs:label>
  </rdf:Description>
