  <rdf:Description rdf:about="https://folio.openlegalstandard.org/r1kVSeBJSy6M05k9Bom5bA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NxFQNeidROq0oYR7MPdqGw"/>
    <rdfs:label>Cyclic Crude, Intermediate, and Gum and Wood Chemical Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) distilling wood or gum into products, such as tall oil and wood distillates; (2) distilling coal tars; (3) manufacturing wood or gum chemicals, such as naval stores, natural tanning materials, charcoal briquettes, and charcoal (except activated); and (4) manufacturing cyclic crudes or cyclic intermediates (i.e., hydrocarbons, except aromatic petrochemicals) from refined petroleum or natural gas.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325194"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
