    <skos:altLabel xml:lang="pt-br">Violação da obrigação de não concorrência</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der Verpflichtung zur Nicht-Konkurrenz</skos:altLabel>
    <skos:altLabel>Competition With Employer or Principal</skos:altLabel>
    <skos:altLabel>Breach of Noncompete</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反不竞争条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de convenio de no competencia</skos:altLabel>
    <skos:altLabel>Noncompete Claim</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Covenant Not to Compete</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de l'obligation de non-concurrence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de convenio de no competencia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">競業禁止契約違反</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध उल्लंघन नहीं करना</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת הבטחת אי-התחרות</skos:altLabel>
    <skos:altLabel>Breach of Noncompete Convenant</skos:altLabel>
    <skos:definition>The Breach of Covenant Not to Compete refers to a violation of an agreement between an employee and employer or principal, where the employee agrees not to engage in competitive activities with the employer or principal after leaving their employment or business relationship.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N6a68af7ebd4e43e9a15cd8d9e2d51b47"/>
