  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/VppQhq4XQsq9cx8oNshQzg">
    <skos:example>Street lighting fixtures (except traffic signals) manufacturing</skos:example>
    <skos:example>LED (light emitting diode) light bulbs manufacturing</skos:example>
    <skos:example>Fireplace logs, electric, manufacturing</skos:example>
    <skos:example>Insect lamps, electric, manufacturing</skos:example>
