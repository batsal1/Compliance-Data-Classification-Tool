    <rdfs:label>Credit Card Agreement</rdfs:label>
    <skos:altLabel>Credit Card Contract</skos:altLabel>
    <skos:altLabel>Cardholder Agreement</skos:altLabel>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <skos:definition>A Credit Card Agreement is a legally binding contract between a credit card issuer and a cardholder outlining the terms and conditions under which the cardholder may use the credit card. This agreement specifies the interest rates, fees, billing processes, and cardholder obligations associated with the card.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8xhTgEOLxauZ6mN68JsaoD">
    <skos:altLabel xml:lang="he-il">שקר בנשים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Perjurio</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falso testimonio</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Perjury</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">伪证罪</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">偽証罪</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Meineid</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Parjure</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">झूठी शपथ</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Perjúrio</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N1f05e5e741874245ab77c60af3ef35d3"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSRxb9psAJdqf8rppoiYI8"/>
    <skos:definition>The intentional act of lying or giving false testimony under oath in a legal proceeding, which is considered a crime against the government and can result in judicial and procedural tort claims.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Perjury</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/4J-2ZNAARq6JHyH5LSqh5Q">
    <skos:example>Additive manufacturing machinery manufacturing</skos:example>
    <skos:example>Bookbinding machines manufacturing</skos:example>
    <skos:example>Tannery machinery manufacturing</skos:example>
    <skos:example>Plastics working machinery manufacturing</skos:example>
    <skos:example>Petroleum refining machinery manufacturing</skos:example>
    <skos:example>Glass making machinery (e.g., blowing, forming, molding) manufacturing</skos:example>
    <skos:example>Printing presses manufacturing</skos:example>
    <skos:example>Textile making machinery manufacturing</skos:example>
    <skos:example>Cigarette making machinery manufacturing</skos:example>
    <skos:example>Sewing machines (including household-type) manufacturing</skos:example>
    <skos:example>Shoe making and repairing machinery manufacturing</skos:example>
    <skos:example>Chemical processing machinery and equipment manufacturing</skos:example>
    <skos:example>Rubber working machinery manufacturing</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333248"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing industrial machinery (except agricultural and farm-type; construction and mining machinery; food manufacturing-type machinery; semiconductor making machinery; and sawmill, woodworking, and paper making machinery).</skos:definition>
    <rdfs:label>All Other Industrial Machinery Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/rm6Op71TRZKqO_wE7EHJEA"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/5ACgObudQIuSoVBakqHRJA">
    <skos:example>Fiber cans and drums (i.e., all-fiber, nonfiber ends of any material) made from purchased paperboard</skos:example>
    <skos:example>Sanitary food containers (except folding) made from purchased paper or paperboard</skos:example>
    <skos:example>Milk cartons made from purchased paper or paperboard</skos:example>
    <skos:example>Setup (i.e., not shipped flat) boxes made from purchased paperboard</skos:example>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in converting paperboard into paperboard containers (except corrugated, solid fiber, and folding paperboard boxes) without manufacturing paperboard.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=322219"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Other Paperboard Container Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/XmPn9qdqRNCrNlvwItWVMw"/>
  </rdf:Description>
