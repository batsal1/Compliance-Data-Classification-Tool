  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDSTWxMJK0mcdxB1oQtK7jC">
    <skos:altLabel xml:lang="hi-in">आयु भेदभाव</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">年龄歧视</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Discrimination liée à l'âge</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפליה עקב גיל</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">年齢差別</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Discriminación por edad</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Age Discrimination</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Discriminação por idade</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Discriminación por edad</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Altersdiskriminierung</skos:altLabel>
    <skos:definition>Discrimination against an individual or group based on their age, typically in the workplace or other professional settings.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
    <rdfs:label>Age Discrimination</rdfs:label>
  </rdf:Description>
