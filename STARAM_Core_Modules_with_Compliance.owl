  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBXpZKEtUb90P79zVvnHHsH">
    <skos:altLabel xml:lang="pt-br">Reivindicação de acordo com a Lei de Mortes no Alto Mar</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur les décès en haute mer</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación por la Ley de Muerte en Alta Mar</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק מוות בים גבוה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऊंची समुद्र में मृत्यु अधिनियम दावा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Death on High Seas Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">高海上死亡法案索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch nach dem Gesetz über Todesfälle auf hoher See</skos:altLabel>
    <skos:altLabel>DOHSA Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">高海上死亡法に基づく請求</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por el Acta de Muerte en Alta Mar</skos:altLabel>
    <skos:definition>The Death on High Seas Act (DOHSA) is a legal concept that falls under the categories of Statutory and Regulatory Claims, as well as Admiralty and Maritime Claims. It provides a framework for compensation in cases of death that occur on the high seas.</skos:definition>
    <rdfs:label>Death on High Seas Act Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqHLQbqYW16CtZ6TSKOZPz"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
