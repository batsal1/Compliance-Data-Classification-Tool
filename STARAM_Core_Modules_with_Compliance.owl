    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
    <skos:definition>The concept of Mortgage Foreclosure refers to the legal process by which a lender takes possession of a property when the borrower fails to make mortgage payments, and sells it to recover the outstanding debt.</skos:definition>
    <rdfs:label>Mortgage Foreclosure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Foreclosure Claim</skos:prefLabel>
  </rdf:Description>
