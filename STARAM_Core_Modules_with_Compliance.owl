  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP">
    <skos:altLabel xml:lang="es-mx">Demandas por discriminación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">歧视索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de discriminação</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भेदभाव दावे</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Diskriminierungsklagen</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations pour discrimination</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Discrimination Claims</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">差別待遇申立</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות רסיסה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones por discriminación</skos:altLabel>
    <rdfs:label>Discrimination Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC4Pdxi5qe0Is3sCmIHT4ju"/>
    <rdfs:subClassOf rdf:nodeID="N1aaaf4d61b8e4225992d925428dcff69"/>
    <rdfs:subClassOf rdf:nodeID="N851fba102e7d49e695464d9fce96e319"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:nodeID="Ndeeb5d63e1e6453bb0b25d524dfae541"/>
    <skos:definition>Discrimination Claims refer to legal actions taken by individuals who have been subjected to unfair treatment based on their protected characteristics, such as race, gender, religion, disability, or age, in various contexts such as employment, housing, or public accommodations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7yKB3SkQ5bQZsUOV5R0jT1">
    <skos:altLabel xml:lang="zh-cn">盗窃财物罪</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Delitos de propiedad robada</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Delitos de propiedad robada</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עבירות רכוש גנוב</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Diebstahl von Eigentum</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">盗品犯罪</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">चोरी की संपत्ति के अपराध</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Stolen Property Offenses</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Infractions liées aux biens volés</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ofensas de propriedade roubada</skos:altLabel>
    <skos:definition>Receiving, buying, selling, possessing, concealing, or transporting any property with the knowledge that it has been unlawfully taken, as by Burglary, Embezzlement, Fraud, Larceny, Robbery, etc.</skos:definition>
    <rdfs:label>Stolen Property Offenses</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4DhauAKgAkWtnyFXhCePi"/>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R88F8xOhAo5eYT6HVWicTaV">
    <skos:altLabel xml:lang="he-il">סעיף חופשה מתאים לחברה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de licença por conveniência da empresa</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कंपनी सुविधा अवकाश धारा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de congé d'absence de commodité de l'entreprise</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公司便利请假条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">企業便宜休暇条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur bequemen Freistellung von Unternehmen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de ausencia por conveniencia de la empresa</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de ausencia por conveniencia de la empresa</skos:altLabel>
