    <rdfs:label>Sex Offenses</rdfs:label>
    <skos:prefLabel>Sex Crimes</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MbuFEaL6NyU9tM2AXk7lk"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8BLgPtZOuKFI8MtZNTaT0u"/>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <skos:definition>Any sexual act directed against another person, without the consent of the victim including instances where the victim is incapable of giving consent.</skos:definition>
  </rdf:Description>
