  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe">
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7"/>
    <skos:definition>Public benefits are government programs designed to provide financial or material aid to individuals or families who meet certain eligibility criteria, usually based on need or income. These benefits can include healthcare, food assistance, housing subsidies, and unemployment compensation, among others, and are intended to improve the well-being and stability of a society</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Public Benefits</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCku8MnUeFcXo6OenJPhNAh">
    <skos:altLabel xml:lang="hi-in">नर्सिंग लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת טיפול רפואי על ידי אחות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">护理疏忽</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia de enfermería</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência de enfermagem</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia de enfermería</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Nursing Negligence</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence en soins infirmiers</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">看護過失</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pflegefehler</skos:altLabel>
    <skos:definition>Nursing Negligence refers to a breach of duty by a nurse that results in harm or injury to a patient, and is a specific type of Medical Negligence Claim.</skos:definition>
    <rdfs:label>Nursing Negligence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
  </rdf:Description>
