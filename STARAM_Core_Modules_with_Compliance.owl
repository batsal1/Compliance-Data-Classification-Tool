    <skos:example>Fire escape installation</skos:example>
    <skos:example>Forms for poured concrete, erecting and dismantling</skos:example>
    <skos:example>Decorative steel and wrought iron work installation</skos:example>
    <skos:example>Ornamental metal work installation</skos:example>
    <skos:example>Curtain wall, metal, installation</skos:example>
    <rdfs:label>Other Foundation, Structure, and Building Exterior Contractors</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
