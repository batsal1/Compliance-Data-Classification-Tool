  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5ks6eYBkfLh4Fgv1Zusal">
    <skos:altLabel xml:lang="es-mx">Fraude Penal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">刑事欺诈</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fraude Penal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Criminal Fraud</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הונאה פלילית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Straftäuschung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">刑事詐欺</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fraude criminal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude criminelle</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आपराधिक धोखाधड़ी</skos:altLabel>
    <rdfs:label>Criminal Fraud</rdfs:label>
    <skos:definition>The intentional perversion of the truth for the purpose of inducing another person, or other entity, in reliance upon it to part with something of value or to surrender a legal right.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBpSXv8uOXDikW5jk944sRN"/>
  </rdf:Description>
