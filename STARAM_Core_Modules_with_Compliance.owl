  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R94gDxMezQBU6wop953l6By">
    <skos:altLabel xml:lang="fr-fr">Dommages criminels</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Daños criminales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">刑事破坏罪</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">器物損壊罪</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פשע מזיקה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Criminal Damage</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dano criminal</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sachbeschädigung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अपराधिक उपद्रव</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Daño criminal</skos:altLabel>
    <skos:definition>The intentional damaging or destruction of another person's property without their consent, which is classified as a criminal offense of a lesser degree than a felony and falls under the broader category of crimes against property.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ldDGTh6RHzt0IDL7p597U"/>
    <rdfs:subClassOf rdf:nodeID="N5c39ebc60df44a23a2a4ecc508aade39"/>
    <rdfs:label>Criminal Mischief</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDX5p4uoAPpgs9Kpcvu7IoE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Life Estate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <skos:definition>A Life Estate is a form of property ownership where an individual holds the rights to use, occupy, and benefit from a property for the duration of their life. Upon the individual's death, ownership of the property reverts back to the original owner or a designated remainderman, as stipulated in the life estate agreement</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCBPerly9Ql2EqjR3jCfB37">
    <skos:definition>Legal Process Improvement: The systematic approach of identifying, analyzing, and improving legal processes to enhance efficiency, reduce costs, and increase quality of legal services.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Legal Process Improvement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDNOTESvIFXoyO4t8nSz2xD">
    <skos:altLabel>School Area Traffic Violation Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1mmZgj9s6vqgxrWeEM82m"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>School Zone Violation Claim</rdfs:label>
    <skos:definition>A School Zone Violation Claim involves allegations that a driver has failed to adhere to specific traffic rules in a school zone, such as speed limits or stopping requirements, endangering the safety of children and other pedestrians.</skos:definition>
    <skos:prefLabel>School Traffic Regulation Offence Claim</skos:prefLabel>
  </rdf:Description>
