    <skos:altLabel>State's Attorney</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Crown Prosecutor</skos:altLabel>
    <skos:altLabel>DA</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RjlqATUhoynMsnhAf0Wdcs">
    <skos:definition>The national segment refers to a portion of the market that is focused on consumers and businesses within the entire geographical boundaries of a specific country. This segment encompasses products, services, and marketing strategies that are tailored to meet the needs and preferences of the national population, regardless of regional differences.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBSftPgkpTWJ4IzuvXyLBVG"/>
    <skos:altLabel>Countrywide Segment</skos:altLabel>
    <rdfs:label>National Market Segment</rdfs:label>
    <skos:prefLabel>Nationwide Market Segment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
