    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Crimes Against People (Individuals) refers to a category of criminal offenses that involve harm or injury to an individual, including but not limited to assault, battery, sexual offenses, kidnapping, and false imprisonment.</skos:definition>
    <skos:prefLabel>Offences Against the Person</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7u1GstOpfAmZ3mI7yFcbgU"/>
  </rdf:Description>
