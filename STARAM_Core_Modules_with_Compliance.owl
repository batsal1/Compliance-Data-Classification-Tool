    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept CLIENT_ADDRESS_1 refers to the first line of the address of a client in the LEDES98BI V5 Format Rev 1-2020 standard for legal electronic data exchange.</skos:definition>
    <rdfs:label>CLIENT_ADDRESS_1</rdfs:label>
  </rdf:Description>
