    <rdfs:label>Parent-Child Liability</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">父母子女责任</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">親子責任</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות הורה-ילד</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad paterno-filial</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Parent-Child Liability</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité parent-enfant</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad paterno-filial</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Eltern-Kind-Haftung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade pai-filho</skos:altLabel>
