    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=332992"/>
    <rdfs:label>Small Arms Ammunition Manufacturing</rdfs:label>
  </rdf:Description>
