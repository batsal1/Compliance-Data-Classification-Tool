    <rdfs:subClassOf rdf:nodeID="N52a5f9fa2011403ca54878b983577ffd"/>
    <skos:altLabel xml:lang="de-de">US-Kapitel-12-Insolvenz</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faillite du chapitre 12 aux États-Unis</skos:altLabel>
    <skos:altLabel>US Chapter 12</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Quiebra del Capítulo 12 de EE. UU.</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">米国第12章破産</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Quiebra del Capítulo 12 de EE. UU.</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דיוקנאות פשיטת רגל פרק 12 של ארה״ב</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falência do Capítulo 12 dos EUA</skos:altLabel>
    <skos:altLabel>Chapter 12</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यूएस अध्याय 12 दिवाली</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">US Chapter 12 Bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">美国第12章破产</skos:altLabel>
    <skos:hiddenLabel>USCHAP12</skos:hiddenLabel>
    <skos:definition>This form of bankruptcy is designed for 'family farmers' and 'family fisherman' that are under financial distress. Under chapter 12, the person in debt comes up with a plan to pay back creditors over three to five years.</skos:definition>
    <dc:identifier>B-USCHAP12</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>US Chapter 12 Bankruptcy</rdfs:label>
  </rdf:Description>
