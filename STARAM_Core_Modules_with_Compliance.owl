  <rdf:Description rdf:about="https://folio.openlegalstandard.org/AIN5HVSNSXG0TZmN9CNK7w">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing frozen specialty foods (except seafood), such as frozen dinners, entrees, and side dishes; frozen pizza; frozen whipped topping; and frozen waffles, pancakes, and French toast.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
