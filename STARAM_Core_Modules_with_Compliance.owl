    <skos:altLabel xml:lang="es-mx">Cláusula de no derechos de beneficiarios de terceros</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsQrw7ploG6C5BFKKNiJc"/>
    <rdfs:label>No Third Party Beneficiary Rights Clause</rdfs:label>
    <skos:definition>A No Third Party Beneficiary Rights Clause is a provision in a contract that explicitly states that no third party, other than the parties involved in the contract, has any rights or benefits under the contract.</skos:definition>
