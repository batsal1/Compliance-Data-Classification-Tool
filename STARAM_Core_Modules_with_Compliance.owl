    <skos:example>Turbine generator set units manufacturing</skos:example>
    <skos:example>Plain bearings (except internal combustion engine) manufacturing</skos:example>
    <skos:example>Internal combustion engines for hybrid drive systems (except automotive) manufacturing</skos:example>
