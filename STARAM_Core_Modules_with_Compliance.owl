  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC5RK4Beoxturh6V8lBfWfZ">
    <skos:definition>A Familial Role defines an individual's position or relationship within a family structure based on genetic ties, marriage, or legal definitions. Examples include roles such as parent, child, grandparent, sibling, or spouse, each carrying specific relational dynamics, responsibilities, and societal expectations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</dc:source>
    <rdfs:subClassOf rdf:nodeID="Ne72b11306e594208b315cdf600c0511a"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Familial Role</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9SAKPHWeGi7uZqUG6EMlt">
    <skos:altLabel>Correctional Facility Staff</skos:altLabel>
    <skos:altLabel>Jail Official</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Correctional Facility Official</rdfs:label>
    <skos:definition>A Prison Official is an individual responsible for the management, oversight, and operation of a correctional facility, ensuring security, order, and compliance with regulations. These officials oversee the staff, inmate population, and administrative functions, playing a critical role in maintaining the safety and rehabilitation efforts within the prison.</skos:definition>
    <skos:prefLabel>Prison Official</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
