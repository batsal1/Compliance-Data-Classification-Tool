    <skos:altLabel xml:lang="de-de">Vieh, das Schaden verursacht, betritt widerrechtlich das Grundstück</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מקרים של בעלי חיים שפורצים וגורמים נזק</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">侵入する家畜による被害</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Intrusión de ganado causando daño</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Intrusión de ganado causando daño</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Animaux domestiques causant des dommages par effraction</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非法入侵的牲畜造成伤害</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Animais domésticos causando danos por invasão</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trespassing Livestock Causing Harm</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हानि का कारण बनने वाले अतिक्रमण करने वाले पशु</skos:altLabel>
    <rdfs:label>Trespassing Livestock Causing Harm</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Trespassing Livestock Causing Harm refers to the legal claim that arises when someone's animals enter another person's property without permission and cause damage or injury.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCwxVWPUdbPjn2tWtFJg6IZ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8XMs89zuZc9chn6WQ9Fgbm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RaYhztvtpscasYcvEpQB8U">
    <skos:altLabel xml:lang="hi-in">रिटेंशन बोनस क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Retention Bonus Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Aufbewahrungsprämie</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בונוס החזקה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de prime de rétention</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">留任奖金条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de bônus de retenção</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de bonificación por retención</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de bonificación por retención</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">留任ボーナス条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A retention bonus clause is a provision in a contract that offers an incentive payment to an employee to encourage them to remain with the company for a specified period of time.</skos:definition>
    <rdfs:label>Retention Bonus Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9bM7KjhnQvFcxAv6Z1u8aq">
