    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8wXGWJTzR57bI6XTE3mxaa">
    <skos:altLabel xml:lang="fr-fr">Dommage indivisible causé par des torts distincts</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">由不同侵权人造成的不可分割的损害</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Indivisible Harm Caused by Separate Tortfeasors</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Daño indivisible causado por diferentes responsables de un delito</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अलग-अलग टॉर्टफीजर्स द्वारा उत्पन्न अविभाज्य हानि</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unteilbarer Schaden verursacht durch separate Schädiger</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נזק בלתי-חלקי שנגרם על ידי פושעים נפרדים</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dano indivisível causado por tortfeasors separados</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Daño indivisible causado por diferentes responsables de un delito</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">別々の不法行為者によって引き起こされた不可分割な損害</skos:altLabel>
    <skos:definition>Indivisible Harm Caused by Separate Tortfeasors: A legal concept where multiple parties are responsible for causing harm to an individual, and the harm cannot be divided or attributed to any one party individually.</skos:definition>
    <rdfs:label>Indivisible Harm Caused by Separate Tortfeasors</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
  </rdf:Description>
