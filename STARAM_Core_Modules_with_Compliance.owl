  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBFV1dXu2aXDzaGfasJbnsa">
    <rdfs:label>Involuntary Debtor</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77pHybcEdlO9OmqSuiyWi1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An involuntary debtor is an individual or entity against whom creditors initiate bankruptcy proceedings, often because the debtor has failed to meet financial obligations. The involuntary bankruptcy process is initiated by the filing of a petition by the creditors, rather than the debtor themselves</skos:definition>
  </rdf:Description>
