    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <skos:definition>This refers to immediate healthcare services provided in urgent or life-threatening situations. Coverage for emergency medical assistance is often a component of general health insurance policies and is also commonly included in travel insurance plans.</skos:definition>
    <rdfs:label>Emergency Medical Assistance Coverage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/k1--YiHSSZyZN1utWHa5xQ">
    <rdfs:label>Veterinary Services</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Veterinarians' offices</skos:example>
    <skos:example>Veterinary testing laboratories</skos:example>
    <skos:example>Veterinary clinics</skos:example>
    <skos:example>Animal hospitals</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541940"/>
    <skos:definition>This industry comprises establishments of licensed veterinary practitioners primarily engaged in the practice of veterinary medicine, dentistry, or surgery for animals; and establishments primarily engaged in providing testing services for licensed veterinary practitioners.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/xiRvMBuZQ2Wqd5-r2rGPUw"/>
  </rdf:Description>
