  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8WNt4LgRbEedk4Xv38eNC3">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9kj3rbJwO4aZsqQhukBD7y"/>
    <skos:altLabel xml:lang="he-il">הוצאות רפואיות עתידיות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Gastos Médicos Futuros</skos:altLabel>
