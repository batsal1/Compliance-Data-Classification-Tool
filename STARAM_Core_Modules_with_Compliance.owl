  <rdf:Description rdf:about="https://folio.openlegalstandard.org/2jv1xxW3SbymtCXHKC9jgg">
    <rdfs:label>Plastics Plumbing Fixture Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/GtNxbapGRL26_Ki-0ZpxOA"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing plastics or fiberglass plumbing fixtures. Examples of products made by these establishments are plastics or fiberglass bathtubs, hot tubs, portable toilets, and shower stalls.</skos:definition>
