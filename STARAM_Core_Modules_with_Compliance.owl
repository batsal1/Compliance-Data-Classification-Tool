  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RGPW9vXuCzRuL2YAyHpldd">
    <skos:altLabel xml:lang="hi-in">अतिरिक्त किराया शर्त</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שכירות נוסף</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur zusätzlichen Miete</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">追加賃料条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">额外租金条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de aluguel adicional</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de loyer supplémentaire</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Renta Adicional</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Additional Rent Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Renta Adicional</skos:altLabel>
    <rdfs:label>Additional Rent Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Additional Rent Clause is a provision in a contract that requires a tenant to pay for expenses beyond the base rent, such as property taxes or maintenance costs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBFAn1xyfuXmMiWDnpSsuU2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en-gb">Utilities Industry</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie des services publics</skos:altLabel>
    <skos:altLabel>Utilities</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公益事業産業</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपयोगिता उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公用事业行业</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de servicios públicos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versorgungsunternehmen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית תועלת</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de serviços públicos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de servicios públicos</skos:altLabel>
    <dc:identifier>IN-INDUSTRY-19</dc:identifier>
    <dc:identifier>UTL</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=22"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-UTL</ns2:legacyIdentifier>
    <skos:definition>This group comprises establishments engaged in the provision of the following utility services: electric power, natural gas, steam supply, and water supply. Within this sector, the specific activities associated with the utility services provided vary by utility: electric power includes generation, transmission, and distribution; natural gas includes distribution; steam supply includes provision and/or distribution; water supply includes treatment and distribution.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
    <rdfs:subClassOf rdf:nodeID="N2f8f827757c14fe1bd9e99d287180bbc"/>
    <rdfs:subClassOf rdf:nodeID="N3b4c1cab751343d1b7ac00b24895d6b1"/>
    <skos:prefLabel>Utilities Industry</skos:prefLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:hiddenLabel>UTL</skos:hiddenLabel>
    <rdfs:label>Utilities Industry</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nceadc12cd257450ea03dae2658473927">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermAffiliate"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
