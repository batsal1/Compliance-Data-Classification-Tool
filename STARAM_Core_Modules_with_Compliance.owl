  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0N9Jb5nI2blGeLMJLTGSm">
    <skos:altLabel>Deceased Individual</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:nodeID="Nd234d599fc074850bd32649cd77bc32d"/>
    <rdfs:subClassOf rdf:nodeID="N51eb536ccfc34d7c8635cc2e4e446690"/>
    <rdfs:subClassOf rdf:nodeID="Nb88ea36c038742abbc416ab95b45cc7a"/>
    <skos:definition>A decedent is a legal term used to refer to a deceased person, particularly in the context of estate planning and probate law. The decedent's estate encompasses all assets, liabilities, rights, and obligations left behind, which are subject to administration and distribution according to the decedent's will or state intestacy laws.</skos:definition>
    <rdfs:label>Decedent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Deceased Person</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8jGpN7qLoTzazjzwCUdsfz">
    <skos:altLabel xml:lang="zh-cn">无过错离婚</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Scheidung ohne Verschulden</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No-Fault Divorce</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Divórcio sem culpa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Divorcio sin culpa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">גירושין ללא תלונה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नो-फॉल्ट तलाक</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Divorcio sin culpa</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Divorce sans faute</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">無過失離婚</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDhTbfA9WACnFGtRuw8v57e"/>
    <skos:definition>A type of divorce where neither party is required to prove fault or wrongdoing in order to obtain a divorce, but rather the marriage is dissolved due to irreconcilable differences or other specified reasons.</skos:definition>
    <rdfs:label>No-Fault Divorce</rdfs:label>
  </rdf:Description>
