    <skos:altLabel xml:lang="pt-br">Reivindicação de contribuição</skos:altLabel>
    <skos:altLabel>Recovery Claim</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de contribution</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">योगदान दावा</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
    <rdfs:subClassOf rdf:nodeID="Nc1054770d41a4ffdad74d3971ed351de"/>
    <skos:definition>A Contribution Claim is a legal claim made by a defendant seeking to recover a portion of damages paid to a plaintiff from another party who is also responsible for the same harm.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Contribution Claim</rdfs:label>
  </rdf:Description>
