  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9XbvULiDU6Lhqax71LzThw">
    <rdfs:subClassOf rdf:nodeID="Nc330a6c73abe4fdd9681fc57d95cd519"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
    <skos:definition>Overpayment of public benefit occurs when an individual or family receives more financial assistance or services than they are entitled to under a specific public benefit program. This can happen due to administrative errors, fraud, or changes in the recipient's eligibility status, and often necessitates actions like repayment plans or legal proceedings to recover the excess funds.</skos:definition>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Overpayment of Public Benefit</rdfs:label>
  </rdf:Description>
