  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC79HqYiJtTjZEdzBMeEB2L">
    <skos:altLabel xml:lang="es-es">Interrupción ilegal del servicio público de suministro de servicios</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unlawful Interruption of Utility Service</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">違法な公共サービスの中断</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Interruption illégale de service public</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非法中断公用事业服务</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוק בהפרעה בשירות תשלומי כלי חשמל</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interrupción ilegal del servicio público de suministro de servicios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपयोगिता सेवा के अवैध रुकावट</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unzulässige Unterbrechung von Versorgungsdiensten</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interrupção ilegal de serviço público</skos:altLabel>
    <skos:definition>The Unlawful Interruption of Utility Service refers to the illegal act of a landlord intentionally cutting off or disrupting essential utility services, such as electricity or water, to a tenant's rental property.</skos:definition>
    <rdfs:label>Unlawful Interruption of Utility Service</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCowVIHOrj3HPKMUTJdMo3O">
    <skos:altLabel xml:lang="he-il">סעיף היפותקציה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de hipoteca</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">抵当条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Hypothecation Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">抵押条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hypothekarklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de hipoteca</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिकृत गिरवी क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de hipoteca</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'hypothèque</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A hypothecation clause is a provision in a contract that allows a lender to use the borrower's property as collateral for a loan, giving the lender the right to seize the property if the borrower defaults on the loan.</skos:definition>
    <rdfs:label>Hypothecation Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1c64150b1b8749c6a9764e6f0ac49e19">
