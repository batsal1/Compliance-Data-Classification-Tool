    <skos:altLabel xml:lang="zh-cn">刑事藐视</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">刑事蔑視</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בוז פלילי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Strafverachtung</skos:altLabel>
