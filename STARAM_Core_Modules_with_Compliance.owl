    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBlW5OLfCbqfO3PmxrRqwG"/>
    <rdfs:subClassOf rdf:nodeID="N249c354208534a23ab2d90c57777cb8d"/>
