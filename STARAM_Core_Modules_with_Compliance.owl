  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9HRq0jDT4IJcj5e27xtcHS">
    <skos:altLabel>Transport Sector Labor Relations Claim</skos:altLabel>
    <skos:altLabel>Rail and Air Transport Labor Dispute</skos:altLabel>
    <skos:altLabel>Railway Labor Dispute</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nee7833d50e064424b4a6f006ef4ac752"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
    <skos:prefLabel>RLA Claim</skos:prefLabel>
    <skos:definition>A Railway Labor Act Claim involves legal proceedings or disputes arising under the Railway Labor Act (RLA), which governs labor relations in the railway and airline industries in the United States. These claims typically address issues such as collective bargaining, union representation, and the resolution of labor disputes.</skos:definition>
    <rdfs:label>Railway Labor Act Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
