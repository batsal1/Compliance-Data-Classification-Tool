  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8k7Nk5pFGXNNV0rDCN83wV">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGOU62BPz1QTVsWRE2Nodz"/>
    <rdfs:label>Employment Title</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Employment Title refers to the formal designation given to a specific job position within an organization, such as "Software Engineer," "Marketing Manager," or "Legal Counsel." The title is often used to signify the roles and responsibilities of the position, and may also indicate the employee's rank or level within the organizational hierarchy</skos:definition>
  </rdf:Description>
