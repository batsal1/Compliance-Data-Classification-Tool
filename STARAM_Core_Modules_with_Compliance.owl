    <rdfs:label>Manufacturing Agreement</rdfs:label>
    <skos:altLabel xml:lang="pt-br">Contrato de fabricação</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם ייצור</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Contrato de Fabricación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विनिर्माण समझौता</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Herstellungsvertrag</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Manufacturing Agreement</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de fabrication</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">制造协议</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">製造契約</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de Fabricación</skos:altLabel>
    <ns1:contractFamily xml:lang="en">Supply, Manufacturing &amp; Distribution</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Manufacturing Agreement is a legal contract between two parties that outlines the terms and conditions for the production of goods by one party on behalf of the other.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCrY0WmfjbMJnGXxC460UCO">
