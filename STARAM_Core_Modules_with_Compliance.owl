    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=49"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transportation and Logistics Industry</skos:prefLabel>
  </rdf:Description>
