  <rdf:Description rdf:about="https://folio.openlegalstandard.org/XyZ6m8jkTemBuzuW-cAHCA">
    <rdfs:label>Sand, Gravel, Clay, and Ceramic and Refractory Minerals Mining and Quarrying</rdfs:label>
    <skos:definition>This industry comprises (1) establishments primarily engaged in developing the mine site and/or mining, quarrying, dredging for sand and gravel, or mining clay (e.g., china clay, paper clay and slip clay) or ceramic and refractory minerals and (2) preparation plants primarily engaged in beneficiating (e.g., washing, screening, and grinding) sand and gravel, clay, and ceramic and refractory minerals.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Pfnjjx26SsKDkbLVMoJtXQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=21232"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb7fac8bbf3df4718a2a15eab8434575f">
