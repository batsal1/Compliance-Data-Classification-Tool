    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing expertise in the field of information technologies through one or more of the following activities: (1) writing, modifying, testing, and supporting software to meet the needs of a particular customer; (2) planning and designing computer systems that integrate computer hardware, software, and communication technologies; (3) on-site management and operation of clients' computer systems and/or data processing facilities; and (4) other professional and technical computer related advice and services.</skos:definition>
    <rdfs:label>Computer Systems Design and Related Services</rdfs:label>
    <skos:example>Custom computer programming services</skos:example>
    <skos:example>Software installation services</skos:example>
    <skos:example>Computer systems integration design services</skos:example>
    <skos:example>Computer facilities management services</skos:example>
    <skos:example>Computer hardware or software consulting services</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=54151"/>
  </rdf:Description>
