  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDlMwQ5nSrgZMByjzjtXnUO">
    <rdfs:label>Government Representative</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD2KAbcnrk0vfpUCEog3N9F"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Government Representative refers to any individual who acts on behalf of a governmental body, whether they are an elected official, an appointed official, or a regular employee. The term encompasses a wide range of roles, from high-ranking government officials who make policy decisions to government employees who carry out administrative tasks, all serving the interests of the state or public they represent.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCq5P6B48aD8hFbkiFcp5Cm">
    <skos:definition>An affiliate debtor is a company or entity that is related to another debtor through common ownership, control, or a significant financial interest. In bankruptcy proceedings, affiliate debtors may file jointly or have their cases consolidated to streamline the process and address interrelated financial issues.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Affiliate Debtor</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nec7c3b6ced374e269938b68cfcee7d3a"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77pHybcEdlO9OmqSuiyWi1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/_crxh8bbQZ2JjEKYpy3Ziw">
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) roasting coffee; (2) manufacturing coffee and tea concentrates (including instant and freeze-dried); (3) blending tea; (4) manufacturing herbal tea; and (5) manufacturing coffee extracts, flavorings, and syrups.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311920"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/eqSChrLqRZKwBr_oG87w0A"/>
    <rdfs:label>Coffee and Tea Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
