    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות רפואית בניתוח</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">外科疏忽</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia quirúrgica</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Surgical Negligence</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência cirúrgica</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">外科手術の過失</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Chirurgisches Verschulden</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <rdfs:label>Surgical Negligence</rdfs:label>
    <skos:definition>Surgical Negligence refers to a type of medical malpractice where a surgeon fails to provide the expected standard of care during a surgical procedure, resulting in harm or injury to the patient.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RXHQZK42pRQWHk3hrKfF6Ag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKcU29Hc3QmmKCxPZ6oPpcQ"/>
    <skos:definition>Activities and actions related to ensuring that the process and practices used to perform analysis meet an acceptable level of defensibility.</skos:definition>
    <skos:prefLabel>L619 Quality assurance and control</skos:prefLabel>
    <rdfs:label>L619 Quality assurance and control</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCg1B2nsOeXLLmWDxZEu0ZF">
    <skos:altLabel xml:lang="fr-fr">Dissolution d'une société à responsabilité limitée</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिमिटेड लिएबिलिटी कंपनी का विघटन</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Auflösung einer GmbH</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">有限责任公司解散</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dissolução de uma sociedade de responsabilidade limitada</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dissolution of Limited Liability Company</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Disolución de Sociedad de Responsabilidad Limitada</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">有限責任会社の解散</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פירוק חברה בעלת מגבלת אחריות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Disolución de Sociedad de Responsabilidad Limitada</skos:altLabel>
    <rdfs:label>Dissolution of Limited Liability Company</rdfs:label>
    <skos:definition>The Dissolution of Limited Liability Company refers to the legal process of ending the existence of a company that has been formed with limited liability, which may involve the distribution of assets, payment of debts, and termination of contracts.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD0r8VrjvX5kJXEu110odzx">
    <skos:altLabel xml:lang="es-mx">Cláusula de derecho a gravar</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit de grever</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Belastungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכות לעמוד במשכורת</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">担保権条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right to Encumber Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de derecho a gravar</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">设定负担权条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बोझ डालने का अधिकार शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de direito de ônus</skos:altLabel>
    <rdfs:label>Right to Encumber Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Right to Encumber Clause is a provision in a contract that grants the right to create a lien or mortgage on the subject property as security for a debt or obligation.</skos:definition>
  </rdf:Description>
