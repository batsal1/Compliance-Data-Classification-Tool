  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC7JyMSuj0UjWRKW8pGv9ih">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LINE_ITEM_UNIT_COST</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
    <skos:definition>The concept of LINE_ITEM_UNIT_COST refers to the cost of a single unit of a particular item or service, as defined within the LEDES98BI V5 Format Rev 1-2020 standard for legal electronic data exchange.</skos:definition>
  </rdf:Description>
