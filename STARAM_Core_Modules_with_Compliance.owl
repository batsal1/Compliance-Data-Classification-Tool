  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9CviKLACLe1HEP2cShDoPW">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The non-hearsay document objective is the legal principle that certain documents are admissible as evidence in court without being considered hearsay, due to their inherent reliability. These documents, such as business records, public records, and learned treatises, are deemed trustworthy because they are created and maintained in the regular course of activities and are used for important purposes.</skos:definition>
    <skos:altLabel>Document Reliability Principle</skos:altLabel>
    <skos:prefLabel>Reliable Document Standard</skos:prefLabel>
    <rdfs:label>Non-Hearsay Document Objective</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4nwMYlRLa9aP9pKWIZEE"/>
  </rdf:Description>
