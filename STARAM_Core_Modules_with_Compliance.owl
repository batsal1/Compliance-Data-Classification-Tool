  <rdf:Description rdf:about="https://folio.openlegalstandard.org/-uics1YTQhK4gZLQRSV2FQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Emergency and Other Relief Services</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in providing food, shelter, clothing, medical relief, resettlement, and counseling to victims of domestic or international disasters or conflicts (e.g., wars).</skos:definition>
