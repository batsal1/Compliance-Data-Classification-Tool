  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rbjf6IGvMubNB3VG6OHa2J">
    <skos:definition>A right to audit clause is a provision in a contract that allows one party to inspect and review the financial records of the other party to ensure compliance with the terms of the agreement.</skos:definition>
    <skos:altLabel xml:lang="de-de">Prüfungsrecht-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de derecho a auditoría</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit d'audit</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right to Audit Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de derecho a auditoría</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">監査権条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">审计权条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכות לבדיקת חשבונות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऑडिट करने का अधिकार अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de direito de auditoria</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Right to Audit Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/z92pj9hTTd2-Vgl3rH8XfQ">
    <skos:example>Automatic fire sprinkler systems manufacturing</skos:example>
    <skos:example>Welding equipment manufacturing</skos:example>
    <skos:example>Hydraulic and pneumatic jacks manufacturing</skos:example>
    <skos:example>Bridge and gate lifting machinery manufacturing</skos:example>
    <skos:example>Scales and balances manufacturing</skos:example>
    <skos:example>Fluid power cylinders manufacturing</skos:example>
    <skos:example>Fluid power pumps manufacturing</skos:example>
    <skos:example>Power-driven handtools manufacturing</skos:example>
    <skos:example>Packaging machinery manufacturing</skos:example>
    <skos:example>Industrial-type furnaces manufacturing</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33399"/>
    <rdfs:label>All Other General Purpose Machinery Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/S0aqiIi5Q4WHMwEpiXDtkA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing general purpose machinery (except ventilation, heating, air-conditioning, and commercial refrigeration equipment; metalworking machinery; engines, turbines, and power transmission equipment; pumps and compressors; and material handling equipment).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC9SDfps89aNrslbRQX5xy8">
    <skos:definition>A Commodity Pool Operator (CPO) is an individual or firm that manages and operates a commodity pool, a collective investment vehicle that pools together investor funds to trade in commodity futures, options, and other derivatives. CPOs are required to register with the Commodity Futures Trading Commission (CFTC) and comply with specific regulatory requirements to protect investors.</skos:definition>
    <rdfs:label>Commodity Pool Operator</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBEfQXg8uUIsk2iZbk8Z2gR"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>CPO</skos:altLabel>
  </rdf:Description>
