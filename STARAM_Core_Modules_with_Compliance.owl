    <skos:altLabel xml:lang="en-gb">In Pari Delicto</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">In Pari Delicto</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בפרי דליקטו</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">In Pari Delicto</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">In Pari Delicto</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">In Pari Delicto</skos:altLabel>
    <skos:altLabel xml:lang="es-es">In Pari Delicto</skos:altLabel>
    <skos:altLabel xml:lang="de-de">In Pari Delicto</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इन पारी डेलिक्टो</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>In Pari Delicto</rdfs:label>
    <skos:definition>A defense in civil litigation that asserts that both parties are equally at fault and therefore neither can recover damages from the other.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBy3yrWNiZvC1lNhV5RNWID">
