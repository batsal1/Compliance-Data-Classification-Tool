    <skos:altLabel xml:lang="zh-cn">转让条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Assignment Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף העברת זכויות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Abtretungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de cession</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Assignment Clause</rdfs:label>
    <skos:definition>An Assignment Clause is a provision in a contract that allows one party to transfer their rights or obligations to another party.</skos:definition>
  </rdf:Description>
