  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCc7iDhMaikuzxNI08HCgQW">
    <rdfs:label>Freedom from Torture</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <dc:source>International Bill of Human Rights</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Freedom from torture is a fundamental human right that prohibits the use of torture and other cruel, inhuman, or degrading treatment or punishment against individuals. This right is enshrined in various international treaties, such as the United Nations Convention Against Torture, and is considered a non-derogable right, meaning it cannot be suspended under any circumstances.</skos:definition>
  </rdf:Description>
