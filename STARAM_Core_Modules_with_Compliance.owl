    <skos:altLabel xml:lang="hi-in">तकनीकी और व्यापार विद्यालय उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">技術・貿易学校産業</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Technical and Trade Schools Industry</skos:altLabel>
