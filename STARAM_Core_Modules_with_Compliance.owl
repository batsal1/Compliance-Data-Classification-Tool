  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R72GBhwvMfwYwRlCJvrITMF">
    <skos:definition>Regulatory application service refers to legal services related to governmental or regulatory administrative bodies for reviewing and processing applications related to various regulated activities or benefits. These can include applications for licenses, permits, public benefits, or intellectual property rights like patents and trademarks, and involve steps like form submission, documentation verification, and legal review to determine eligibility or compliance.</skos:definition>
    <rdfs:label>Regulatory Application Service</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCC2GjmZO3mWrOPOcd9r0Lc"/>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/QKOFQ3DNRNKUsI9URjlvPQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=711120"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/wP9HQFPJQ8i1L1JwEUuZGg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dance Companies</rdfs:label>
    <skos:definition>This industry comprises companies, groups, or theaters primarily engaged in producing all types of live theatrical dance (e.g., ballet, contemporary dance, folk dance) presentations. Dance companies or groups may or may not operate their own theater or other facility for staging their shows.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBV7sRG5Rn12K0LqLOhxdRz">
    <skos:altLabel xml:lang="hi-in">19वीं संशोधन दावा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת התיקון התשיעי עשר</skos:altLabel>
    <skos:altLabel xml:lang="de-de">19. Änderungsantrag</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">19改正請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da 19ª Emenda</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de la Enmienda 19</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication du 19ème amendement</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de la Enmienda 19</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">19th Amendment Claim</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">第19修正案索赔</skos:altLabel>
    <skos:definition>A 19th Amendment claim is a legal assertion related to the Nineteenth Amendment of the United States Constitution, which grants citizens the right to vote regardless of sex, effectively giving women the right to vote.</skos:definition>
    <rdfs:label>19th Amendment Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
