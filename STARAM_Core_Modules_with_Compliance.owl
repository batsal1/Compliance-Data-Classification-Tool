    <skos:altLabel xml:lang="hi-in">विचार क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">对价条款</skos:altLabel>
    <rdfs:label>Consideration Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A consideration clause is a provision in a contract that outlines the exchange of something of value between parties, which is necessary for the contract to be legally binding.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
