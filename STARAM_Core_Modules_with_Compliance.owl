  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDlbGQZTZoVQjWgt84HaCAm">
    <skos:altLabel xml:lang="es-mx">Cónyuge responsable de las deudas del otro cónyuge</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दूसरे पति के कर्ज के लिए पत्नी उत्तरदायी</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Spouse Liable for Other Spouse’s Debt</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cónyuge responsable de las deudas del otro cónyuge</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בן/בת זוג אחראי על חובות הבן/בת זוג השני</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Conjoint responsable de la dette de l'autre conjoint</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cônjuge responsável pela dívida do outro cônjuge</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ehepartner haftet für Schulden des anderen Ehepartners</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">配偶对另一配偶的债务负责</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">配偶は他の配偶者の債務に責任を負う</skos:altLabel>
    <skos:definition>When one spouse is responsible for the debt of the other spouse, typically due to a joint account or co-signing a loan.</skos:definition>
    <rdfs:label>Spouse Liable for Other Spouse’s Debt</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1nnn4DzR2LNHjHoEzypXC"/>
  </rdf:Description>
