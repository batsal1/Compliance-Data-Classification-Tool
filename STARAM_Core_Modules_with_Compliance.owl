    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">Litigation, Settlement &amp; Release</ns1:contractFamily>
    <skos:definition>A Settlement Agreement is a legal document that outlines the terms and conditions agreed upon by parties to resolve a dispute or legal matter outside of court.</skos:definition>
    <skos:altLabel xml:lang="en-gb">Settlement Agreement</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם פשרה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de liquidación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">和解协议</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समझौता समझौता</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Acordo de Transação</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">和解契約</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de règlement</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acuerdo de conciliación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vergleichsvereinbarung</skos:altLabel>
    <rdfs:label>Settlement Agreement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8gVw3PYPaZJ9kce3wE60ag">
    <skos:altLabel xml:lang="ja-jp">違約金条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Daños y Perjuicios Liquidados</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de penalidades</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Liquidated Damages Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Daños y Perjuicios Liquidados</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsstrafenklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违约赔偿条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פיצויים מקובלים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिक्विडेटेड डैमेज क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de pénalités</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Liquidated Damages Clause</rdfs:label>
    <skos:definition>A liquidated damages clause is a provision in a contract that specifies the amount of damages that will be paid in the event of a breach of contract, where the actual damages are difficult to determine.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
