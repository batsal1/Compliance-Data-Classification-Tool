  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RZhMpDZzDSS42qnN2RTYta">
    <skos:altLabel xml:lang="es-mx">Renta implícita por la ocupación del arrendatario</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Loyer implicite de l'occupation du locataire</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שכירות המתחייבת על ידי הכונן של השוכר</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Aluguel implícito pela ocupação do inquilino</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租户占用所暗示的租金</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Miete, die sich aus der Besetzung durch den Mieter ergibt</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">किराया जो किरायेदार के व्यवसाय से संबंधित हो</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Renta implícita por la ocupación del inquilino</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">入居者によって暗示される賃料</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Rent Implied by Tenant's Occupation</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Rent Implied by Tenant's Occupation</rdfs:label>
    <skos:definition>A legal concept where a tenant is obligated to pay rent to the landlord, even if there is no written agreement, because the tenant is occupying the landlord's property.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nedb8955ec6ef4e928ccb0193dbfe0d26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
