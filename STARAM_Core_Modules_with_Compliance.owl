    <skos:altLabel xml:lang="zh-cn">不当行为条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de comportement répréhensible</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Conducta Objetable</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Objectionable Conduct Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आपत्तिजनक आचरण धारा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Conducta Objetable</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu unangemessenem Verhalten</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התנהגות מעורבת</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de conduta objetável</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不適切な行為条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Objectionable Conduct Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Objectionable Conduct Clause is a provision in a contract that allows one party to terminate the agreement if the other party engages in behavior that is deemed unacceptable or offensive.</skos:definition>
  </rdf:Description>
