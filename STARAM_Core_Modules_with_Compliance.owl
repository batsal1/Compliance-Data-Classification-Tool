    <ns1:contractFamily xml:lang="en">Equipment &amp; Asset Use</ns1:contractFamily>
    <skos:definition>An Equipment Related Agreement is a legally binding contract that governs the use, rental, purchase, or maintenance of specific equipment or machinery. These agreements detail terms such as ownership, responsibilities for maintenance and repair, payment arrangements, and conditions for returning or replacing the equipment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Equipment Agreements</rdfs:label>
  </rdf:Description>
