  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9D3DJs75EXlnkhqjYzyoas">
    <skos:altLabel xml:lang="de-de">Definition von "Material Adverse Effect" - Ausnahmen - unverhältnismäßige Auswirkungen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת "השפעה נזילה חומרית" - יוצאים מן הכלל - השפעה לא מתאימה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de "Efecto Adverso Material" - Excepciones - Impacto Desproporcionado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">"Material Adverse Effect" Definition - Exceptions - Disproportionate Impact</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">"Material Adverse Effect" 定义 - 例外 - 不成比例的影响</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">"Material Adverse Effect" の定義 - 例外 - 不釣り合いな影響</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de "Efecto Adverso Material" - Excepciones - Impacto Desproporcionado</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">"मटेरियल एडवर्स इफेक्ट" की परिभाषा - अपवाद - असमान प्रभाव</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição de "Material Adverse Effect" - Exceções - Impacto desproporcional</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de "Material Adverse Effect" - Exceptions - Impact disproportionné</skos:altLabel>
    <rdfs:label>"Material Adverse Effect" Definition - Exceptions - Disproportionate Impact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74IJAT8MHMqUZeBJR7txV1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/glrS_5ZYRxCFkpHNCbg3_A">
    <skos:definition>This industry comprises (1) establishments primarily engaged in operating golf courses (except miniature) and (2) establishments primarily engaged in operating golf courses, along with dining facilities and other recreational facilities that are known as country clubs. These establishments often provide food and beverage services, equipment rental services, and golf instruction services.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/jKtAo2ceSnmGa6DWoMsMHQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Golf Courses and Country Clubs</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=713910"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCwEVoFW90PLN1eL6JToOMt">
    <rdfs:label>Accredited Investor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hWq9dSn0Su2Y59JE48V3H"/>
    <skos:definition>Individuals or entities that meet certain requirements set by regulatory authorities, such as a specific net worth or income level.</skos:definition>
  </rdf:Description>
