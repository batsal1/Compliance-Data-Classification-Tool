  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8etCsd1CHh9aGsjvWAgKrR">
    <skos:altLabel xml:lang="fr-fr">Clause d'earnout</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de earnout</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अर्नआउट क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ארנאוט</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Earnout Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">业绩补偿条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula earnout</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Earnout-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">アーノート条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de earnout</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Earnout Clause</rdfs:label>
    <skos:definition>An earnout clause is a provision in a contract that allows for additional payments to be made based on the performance of the subject of the contract, typically a business or asset.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/mHigNWxlQDaRZFGLd8cblQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/AYNsJbHmSB-0T4g03WW3WA"/>
    <rdfs:label>Polystyrene Foam Product Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=326140"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing polystyrene foam products.</skos:definition>
  </rdf:Description>
