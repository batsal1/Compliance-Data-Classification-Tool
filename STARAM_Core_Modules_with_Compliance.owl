  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RuYatR0GQCBDUpS0WtbxAv">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="hi-in">वाणिज्यिक उचित प्रयास मानक</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Commercially Reasonable Efforts Standard</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业上合理努力标准</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Padrão de esforços comercialmente razoáveis</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Norme d'efforts commercialement raisonnables</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">商業上合理な努力基準</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Estándar de Esfuerzos Comercialmente Razonables</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estándar de Esfuerzos Comercialmente Razonables</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תקן מאמץ מסחרי סביר</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Standard für kommerziell angemessene Anstrengungen</skos:altLabel>
    <rdfs:label>Commercially Reasonable Efforts Standard</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xBgB4PfVczsw05VoUobOY"/>
    <skos:definition>The Commercially Reasonable Efforts Standard is a legal concept that refers to the level of effort that a party must exert in order to fulfill their obligations under a contract or agreement. This standard requires the party to act in a manner that is reasonable and consistent with industry practices and standards.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8uW7tSElnScC1uC2CnZTIL">
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão de contrato</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation de contrat</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Termination of Contract Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同终止条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध समाप्ति धारा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הפסקת החוזה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Terminación del Contrato</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Terminación del Contrato</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約解除条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigungsklausel</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Termination of Contract Clause</rdfs:label>
    <skos:definition>A Termination of Contract Clause is a provision in a contract that outlines the circumstances under which the agreement may be ended by one or both parties.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R355Le1zLujnXiHMmYqQNM"/>
  </rdf:Description>
