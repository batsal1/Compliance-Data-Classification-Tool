    <skos:definition>Any communication by letter, fax, email, telephone, meetings and conferences with experts associated with the legal matter</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>A114 Communicate (experts)</skos:prefLabel>
