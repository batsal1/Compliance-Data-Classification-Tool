  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R88m06glAkTkIFNVlAF30zy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source rdf:resource="https://digital-strategy.ec.europa.eu/en/library/eu-us-terminology-and-taxonomy-artificial-intelligence-second-edition"/>
    <dc:source rdf:resource="https://ec.europa.eu/newsroom/dae/redirection/document/104120"/>
    <skos:altLabel>Computational Intelligence Structure</skos:altLabel>
    <skos:altLabel>AI Conceptual Framework</skos:altLabel>
    <skos:altLabel>AI System Classification</skos:altLabel>
    <skos:prefLabel>AI System Taxonomy</skos:prefLabel>
    <skos:note>Derived from the EU-U.S. Terminology and Taxonomy for Artificial Intelligence (Second Edition)</skos:note>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9B8sRCK209t5Y8LlU4f62a"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlNFgB3TQfMzV26V4V7u4E"/>
    <rdfs:label>Artificial Intelligence System Taxonomy</rdfs:label>
    <skos:definition>Artificial Intelligence System Taxonomy is the hierarchical classification and organization of AI systems and related concepts. This taxonomy provides a structured framework for understanding the various components, relationships, and characteristics of AI systems, facilitating analysis, research, and development across diverse AI domains.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB9kHJwRBkXjBRaeSNiyPWY">
    <skos:altLabel xml:lang="zh-cn">不购物公约 - 受托人标准</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pacto de não-compra - Padrão fiduciário</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kein-Shop-Pakt - Treuhänderstandard</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No-Shop Covenant - Fiduciary Standard</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם לא לקנות - תקן פידוציארי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Covenant de no compras - Estándar fiduciario</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ノーショップ契約 - 受託者基準</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नो-शॉप कवेनेंट - फिडूशियरी मानक</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-shopping - Norme fiduciaire</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Covenant de no compras - Estándar fiduciario</skos:altLabel>
    <dc:source>ABA Deal Points Study</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rmv3aWwfnLGj1avQvTQulY"/>
    <rdfs:label>No-Shop Covenant - Fiduciary Standard</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A No-Shop Covenant - Fiduciary Standard is a legal agreement that prohibits a party from seeking or accepting offers from other parties during a specified period of time, while also requiring the party to act in good faith and with loyalty towards their fiduciary duties.</skos:definition>
  </rdf:Description>
