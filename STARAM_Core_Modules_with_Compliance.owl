  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7zqQn3T6kJzQIHOII6r3Oc">
    <skos:altLabel>Inclusion Measures</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Positive Discrimination</skos:altLabel>
    <skos:altLabel>Social Integration Program - Brazil</skos:altLabel>
    <skos:altLabel>Equal Opportunity Employment</skos:altLabel>
    <skos:altLabel>Balanced Representation</skos:altLabel>
    <skos:altLabel>Diversity Policy</skos:altLabel>
    <skos:altLabel xml:lang="en-ca">Employment Equity</skos:altLabel>
    <skos:altLabel>Reservation Policy - India</skos:altLabel>
    <skos:altLabel>Special Measures for Equality</skos:altLabel>
    <skos:definition>An affirmative action claim is a legal assertion or case related to the enforcement of policies that promote opportunities for historically excluded groups in employment, education, and other areas, often involving allegations of discrimination or non-compliance with governmental regulations on diversity and equal opportunity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:nodeID="N8f9da96f1a444550a9551afeae416fa6"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Affirmative Action Claim</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDP2t75tSvlsq1GCrOZlInL">
    <skos:altLabel>Contract Rescission</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Rescisão</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">撤回</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rücktritt</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Résolution</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">撤销</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N03a3297ce78d4819a941857e3f2ff5e1"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9iUJ1YX0zK3V9D0RbQKTP4"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Rescission</rdfs:label>
    <skos:definition>Rescission is the act of canceling or voiding a contract, typically due to factors such as duress, unconscionability, or fraud, and is a type of equitable relief available in contract and quasi-contract claims.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDkMsDzhDxQxUN8FKhOhozQ">
    <skos:prefLabel>Unpaid Share Subscription Rights</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Nil Paid Letters, also known as Unpaid Share Subscription Rights, are temporary documents issued by a company offering new shares to existing shareholders. These letters allow shareholders to trade the rights to subscribe to the new shares before payment is required, but they do not represent ownership until the shares are fully paid.</skos:definition>
    <rdfs:label>Nil Paid Letters</rdfs:label>
    <skos:altLabel>Rights Issue Letters</skos:altLabel>
    <skos:altLabel>Unpaid Share Rights</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
  </rdf:Description>
