  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7UFW7IONSy0FtRqWsms7Tx">
    <skos:altLabel xml:lang="fr-fr">Représentations et garanties fondamentales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fundamental Representations and Warranties</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representaciones y Garantías Fundamentales</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">基本的表明と保証</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मौलिक प्रतिनिधित्व और वारंटी</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Grundlegende Darstellungen und Gewährleistungen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ייצוגים ואחריות בסיסיים</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representações e garantias fundamentais</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Representaciones y Garantías Fundamentales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">基本陈述和保证</skos:altLabel>
    <skos:definition>A Fundamental Representation and Warranty is a legally binding statement made by one party to another in a contract, which guarantees the accuracy and completeness of certain information or facts that are fundamental to the agreement, and which cannot be waived or modified without the consent of both parties.</skos:definition>
    <rdfs:label>Fundamental Representations and Warranties</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCV40j08zvRl2faFV72w9aQ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8h7iX0cG97aNHhEzak0e3U"/>
  </rdf:Description>
