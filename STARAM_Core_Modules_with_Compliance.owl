  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9romGwkcHJisYP8pjKnggr">
    <skos:altLabel xml:lang="ja-jp">覆された法律</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Aufgehobenes Gesetz</skos:altLabel>
