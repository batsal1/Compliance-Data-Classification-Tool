  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RutXSExAWlagMSiMY90GyJ">
    <skos:altLabel xml:lang="es-mx">Cláusula de Cuadrícula de Precios</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de grade de preços</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">定价网格条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף רשת מחירים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pricing Grid Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Preisgestaltungsrasterklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Cuadrícula de Precios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मूल्य ग्रिड क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">価格グリッド条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de grille tarifaire</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Pricing Grid Clause is a provision in a contract that outlines the pricing structure for goods or services, typically presented in a grid format.</skos:definition>
    <rdfs:label>Pricing Grid Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N521639557cc548a39abe2578507bc528">
