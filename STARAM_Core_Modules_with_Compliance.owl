    <skos:altLabel xml:lang="he-il">הונאת ביטוחים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versicherungsbetrug</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude à l'assurance</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insurance Fraud</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fraude de seguro</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fraude de Seguros</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बीमा धोखाधड़ी</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fraude de Seguros</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保険詐欺</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保险欺诈</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:label>Insurance Fraud</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Insurance Fraud refers to the intentional deception or misrepresentation made by an individual or entity to an insurance company for the purpose of obtaining benefits or compensation to which they are not entitled, including the fraudulent acquisition of life or health insurance policies.</skos:definition>
  </rdf:Description>
