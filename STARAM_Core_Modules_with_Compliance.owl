  <rdf:Description rdf:about="https://folio.openlegalstandard.org/qf3aLRCaRsKFAA_IZ6aO_A">
    <skos:definition>This industry comprises establishments known as publishers (except newspaper, magazine, book, directory, mailing list, music, and software publishers).  These establishments may publish works in print or electronic form, including exclusively on the Internet.</skos:definition>
    <skos:example>Greeting card publishers</skos:example>
    <skos:example>Calendar publishers</skos:example>
    <skos:example>Art publishers</skos:example>
