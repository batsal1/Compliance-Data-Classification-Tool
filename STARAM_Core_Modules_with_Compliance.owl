  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8OnUCufrh95zFJBYQV8Rbg">
    <rdfs:label>Unauthorized Practice of Medicine</rdfs:label>
    <skos:altLabel>Unlicensed Medical Practice</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N1d12d3753bac4a10959eb7740e2ed5a7"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCbHJpvKBcjSxgneNJVgeb2"/>
    <skos:definition>The Unauthorized Practice of Medicine occurs when an individual or entity engages in medical activities, such as diagnosis, treatment, or offering medical advice, without the necessary medical qualifications, licensure, or authorization in a particular jurisdiction. This practice poses significant risks to public health and safety, as it involves providing medical care without the required expertise and credentials.</skos:definition>
  </rdf:Description>
