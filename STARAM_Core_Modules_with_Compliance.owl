    <skos:altLabel xml:lang="es-mx">Cláusula de duración del contrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף משך החוזה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約期間条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवधि शर्त शब्द</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Contract Duration Clause</rdfs:label>
    <skos:definition>A Contract Duration Clause is a provision in a contract that specifies the length of time that the contract will remain in effect.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
