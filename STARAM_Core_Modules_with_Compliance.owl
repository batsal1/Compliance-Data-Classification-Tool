  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7zFDSz9BjpVwMtwSqsOTsY">
    <skos:prefLabel>Contingent Convertible Bond</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R2OdJWZ0azNvrSJ7DPl0gU"/>
    <skos:altLabel>CoCo bond</skos:altLabel>
    <skos:altLabel>Contingent Convertible Instrument</skos:altLabel>
    <skos:altLabel>Convertible Contingent Security</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Contingent Convertible Share, often referred to as a CoCo bond, is a type of debt security that automatically converts into equity when a predefined trigger event occurs, typically related to the issuer's financial health or regulatory capital thresholds. These instruments are designed to provide additional capital to the issuer during periods of financial stress, thereby enhancing financial stability.</skos:definition>
    <rdfs:label>Contingent Convertible Share</rdfs:label>
  </rdf:Description>
