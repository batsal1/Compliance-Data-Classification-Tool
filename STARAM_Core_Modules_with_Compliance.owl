  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9zgcjBBIdWMnwIR8nqsoS8">
    <dc:identifier>D-ADR-MED</dc:identifier>
    <skos:altLabel xml:lang="fr-fr">Pratique de la médiation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de Mediación</skos:altLabel>
    <skos:altLabel>Mediations</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de Mediación</skos:altLabel>
    <skos:altLabel>Mediation Service</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Mediationspraxis</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mediation Practice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मध्यस्थता अभ्यास</skos:altLabel>
    <skos:altLabel>Mediation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">調停実践</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול בישום פתרונות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de mediação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">调解实践</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85H4hDZWq92xwwBFP7WCtM"/>
    <skos:hiddenLabel>MED</skos:hiddenLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mediation Practice</rdfs:label>
    <skos:definition>Mediation is a process wherein the parties meet with a mutually selected impartial and neutral person who assists them in the negotiation of their differences. Mediation leaves the decision power totally and strictly with the parties.</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Proc-D-ADR-MED</ns2:legacyIdentifier>
  </rdf:Description>
