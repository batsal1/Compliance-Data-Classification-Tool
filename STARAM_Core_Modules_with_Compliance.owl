  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBJHLOZetGcv6GWkosBeFsq">
    <skos:altLabel>Spontaneous Exclamation</skos:altLabel>
    <skos:altLabel>Startled Statement</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Excited Utterance is a statement relating to a startling event or condition made while the declarant was under the stress of excitement caused by the event or condition. This hearsay exception is based on the idea that statements made under the influence of excitement or shock are unlikely to be fabricated due to the lack of time for reflection or deliberation.</skos:definition>
    <rdfs:label>Excited Utterance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsA0EjhyOEG9HBBGLsyj0G"/>
  </rdf:Description>
