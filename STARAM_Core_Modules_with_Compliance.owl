  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RuihYLprF6BAYRiY7f0c4K">
    <skos:definition>A joint and several obligations clause is a provision in a contract where two or more parties are jointly and individually responsible for fulfilling the obligations outlined in the agreement.</skos:definition>
    <skos:altLabel xml:lang="es-mx">Cláusula de Obligaciones Conjuntas y Solidarias</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">连带责任条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de obrigações solidárias e indivisíveis</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Joint and Several Obligations Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संयुक्त और एकाधिकारिक दायित्व शब्दावली</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">連帯債務条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'obligations conjointes et solidaires</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התחייבויות משותפות ומסתמכות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Obligaciones Conjuntas y Solidarias</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu gemeinsamen und mehrfachen Verpflichtungen</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Joint and Several Obligations Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
