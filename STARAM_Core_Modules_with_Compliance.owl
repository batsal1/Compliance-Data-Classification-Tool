  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RGwortSox0oBPyp9H9dcEw">
    <skos:altLabel xml:lang="de-de">Matching-Rechte-Zeitraum</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Período de direitos correspondentes</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मिलान अधिकार अवधि</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">マッチング権利期間</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Periodo de Derechos de Adquisición Preferente</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Période de droits correspondants</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Periodo de Derechos de Adquisición Preferente</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Matching Rights Period</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תקופת זכויות התאמה</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">匹配权利期</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQgpAo5GFhGAvTuB5ZwKO3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Matching Rights Period</rdfs:label>
    <skos:definition>A Matching Rights Period is a specific period of time during which a party has the right to match the terms of a proposed transaction or agreement, as outlined in the Matching Rights Language.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/lVMSo6T2SKu4U93-_6y-5w">
    <skos:definition>This industry comprises establishments primarily engaged in accepting deposits, making mortgage, real estate, and other consumer and commercial loans, and investing in high-grade securities (except commercial banking and credit unions). Savings and loan associations, savings banks, private banks (i.e., unincorporated banks), and establishments known as industrial banks or Morris Plans and primarily engaged in accepting deposits are included in this industry.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Savings Institutions and Other Depository Credit Intermediation Industry</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/4_ZVNBAMQd27OtK4BOVO5Q"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=522180"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9INwIwwIifomch7DOeSFDg">
    <skos:altLabel xml:lang="fr-fr">Arrestation civile</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prisão civil</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Civil Arrest</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">民事拘束</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zivilhaft</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Arresto Civil</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">民事拘留</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नागरिक गिरफ्तारी</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עיכוב אזרחי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Arresto Civil</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Civil Arrest refers to the act of detaining a person by legal authority in order to enforce a civil judgment against them.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pQxz2fUIrk1LjvVP8hikg"/>
    <rdfs:label>Civil Arrest</rdfs:label>
  </rdf:Description>
