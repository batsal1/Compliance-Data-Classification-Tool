  <rdf:Description rdf:about="https://folio.openlegalstandard.org/T25EgplyTE-bGCTqpq3lUw">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in sawing dimension lumber, boards, beams, timbers, poles, ties, shingles, shakes, siding, and wood chips from logs or bolts. Sawmills may plane the rough lumber that they make with a planing machine to achieve smoothness and uniformity of size.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/BPceootDSmSNz2Nt6FtVuA"/>
    <rdfs:label>Sawmills</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=321113"/>
  </rdf:Description>
