  <rdf:Description rdf:about="https://folio.openlegalstandard.org/7VdrsPcJSM-7g4UJZoCgPA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/X025JE1YTUCnIQsk66o_Zg"/>
    <skos:example>Mortgage companies</skos:example>
    <skos:example>Secondary market financing</skos:example>
    <skos:example>International trade financing</skos:example>
    <skos:example>Consumer finance companies (i.e., unsecured cash loans)</skos:example>
    <rdfs:label>Other Nondepository Credit Intermediation Industry</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=52229"/>
    <skos:definition>This industry comprises establishments primarily engaged in making cash loans or extending credit through credit instruments (except credit cards and sales finance agreements).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7qxVfcFITBa22T7miUZb0x">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Bulls</skos:altLabel>
    <skos:altLabel>Bovines</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KMTMyVwMFJ4uhm95DFM9y"/>
    <rdfs:label>Cattle</rdfs:label>
    <skos:prefLabel>Cows</skos:prefLabel>
    <skos:definition>Cattle are domesticated bovine animals that belong to the species Bos taurus, commonly raised for their meat, milk, and hides, as well as for labor. This group includes both cows (females) and bulls (males), and they play a significant role in agriculture and human economies.</skos:definition>
  </rdf:Description>
