  <rdf:Description rdf:about="https://folio.openlegalstandard.org/MZVP9G7GTmGFVoi11ORu3w">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing nitrogenous fertilizer materials; (2) manufacturing fertilizers from sewage or animal waste; and (3) manufacturing nitrogenous materials and mixing with other ingredients into fertilizers.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325311"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
