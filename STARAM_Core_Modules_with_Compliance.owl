  <rdf:Description rdf:about="https://folio.openlegalstandard.org/alJ2Li0FQNCIHX-tugTuuw">
    <rdfs:label>Legislative Bodies</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=921120"/>
