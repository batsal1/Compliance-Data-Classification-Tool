  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCvkZk031Sc99Sezqknyjqm">
    <skos:altLabel xml:lang="he-il">החזר פונה לפלילים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Restitución penal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">刑事赔偿</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आपराधिक पुनर्प्राप्ति</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Restitución penal</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Restituição criminal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Criminal Restitution</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Strafrechtliche Wiedergutmachung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">刑事賠償</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Restitution pénale</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl"/>
    <skos:definition>The concept of Criminal Restitution refers to the court-ordered payment made by a convicted criminal to their victim(s) as compensation for the harm caused by the criminal act.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Criminal Restitution</rdfs:label>
  </rdf:Description>
