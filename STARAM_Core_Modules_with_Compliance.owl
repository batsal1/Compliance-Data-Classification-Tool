    <rdfs:label>Compensation Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Employment &amp; Labour</ns1:contractFamily>
    <skos:definition>A Compensation Related Agreement is a legally binding contract that specifically focuses on the structure and details of an employee's compensation, including elements like base salary, bonuses, stock options, and other financial incentives. These agreements serve to outline how an employee's pay is determined, disbursed, and adjusted over time, ensuring clarity and fairness in compensation arrangements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7XjMoxjqIUftkOYtnzzbAu">
    <skos:altLabel>Exclusion from Inheritance</skos:altLabel>
    <skos:altLabel>Heir Exclusion</skos:altLabel>
    <skos:altLabel>Estate Exclusion</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDP2t75tSvlsq1GCrOZlInL"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8M0UJWeEVpeK5gMPLTQSl2"/>
    <skos:definition>Disinheritance is the legal act of deliberately excluding an heir from receiving property or assets from a deceased person's estate, typically through the terms specified in a will or trust. This action can be taken for various personal, financial, or relational reasons, and must comply with legal statutes to be effective.</skos:definition>
    <rdfs:label>Disinheritance</rdfs:label>
    <skos:prefLabel>Disownment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDXXLndQ4d5yLcQlwSa5XwH">
    <skos:altLabel xml:lang="es-mx">Incumplimiento de la garantía implícita de servicios buenos y bien ejecutados - Reparación y modificación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反默示的良好和工艺服务保证 - 修理和修改</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Good &amp; Workmanlike Services - Repair &amp; Modification</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite de services bons et de qualité - Réparation et modification</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung für gute und fachgerechte Dienstleistungen - Reparatur und Modifikation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">黙示の善良かつ適切なサービスの保証違反 - 修理および改造</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अच्छी और दक्ष सेवाओं की निहित वारंटी का उल्लंघन - मरम्मत और संशोधन</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de la garantía implícita de servicios buenos y bien ejecutados - Reparación y modificación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de serviços bons e de qualidade - Reparo e modificação</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת האחריות המשתלמת המשתלמת והמקצועית - תיקון ושינוי</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCh6Oc8mbSkrdPsFW4zrL6F"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Breach of Implied Warranty of Good &amp; Workmanlike Services - Repair &amp; Modification refers to a violation of the implied promise that a service provider will perform repairs or modifications in a competent and skillful manner, resulting in harm or damages to the recipient of the service.</skos:definition>
    <rdfs:label>Breach of Implied Warranty of Good &amp; Workmanlike Services - Repair &amp; Modification</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBOjgvcq6Z33XxMhTxWiiDS">
    <skos:altLabel xml:lang="es-mx">Industria manufacturera</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">制造业</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fertigungsindustrie</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">製造業</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de manufatura</skos:altLabel>
    <skos:altLabel>Manufacturing</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie manufacturière</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית ייצור</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria manufacturera</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Manufacturing Industry</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विनिर्माण उद्योग</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=31"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33"/>
    <skos:prefLabel>Manufacturing Industry</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-MFG</ns2:legacyIdentifier>
    <skos:definition>The Manufacturing industry group comprises establishments engaged in the mechanical, physical, or chemical transformation of materials, substances, or components into new products. The assembling of component parts of manufactured products is considered manufacturing. This industry group does not include construction.</skos:definition>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
    <rdfs:label>Manufacturing Industry</rdfs:label>
    <dc:identifier>IN-INDUSTRY-12</dc:identifier>
    <dc:identifier>MFG</dc:identifier>
    <skos:hiddenLabel>MFG</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ywHYoNtB4XPHaSB4QPez2">
    <skos:altLabel xml:lang="en-gb">Collecting Bank Late Objection to Negotiable Instrument</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">集金銀行の手形不受理遅延異議</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Objeção tardia do banco coletor ao instrumento negociável</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">收款银行对可转让票据的迟延异议</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नेगोशिएबल इंस्ट्रुमेंट के लिए कलेक्टिंग बैंक द्वारा देरी से आपत्ति</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Objeción tardía del banco cobrador al instrumento negociable</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Objeción tardía del banco recaudador al instrumento negociable</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Einspruch der Inkassobank gegen ein verzögertes Verhandlungsinstrument</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התנגדות מאוחרת של הבנק המגביה לכלי נגיש</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Opposition tardive de la banque de recouvrement à l'instrument négociable</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Collecting Bank Late Objection to Negotiable Instrument</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <skos:definition>A Collecting Bank Late Objection to Negotiable Instrument is a claim made by a bank that collected a negotiable instrument after the deadline for objections has passed, and is related to banking, commercial paper, and creditor claims.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N83c94b9840fb4a6881afdb56178e1368">
