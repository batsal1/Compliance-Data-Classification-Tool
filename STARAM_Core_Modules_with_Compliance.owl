  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCXmZbkCGNYfkmZHX1WWCqW">
    <skos:altLabel xml:lang="pt-br">Interferência nas relações prospectivas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भविष्य के संबंधों में हस्तक्षेप</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">見込み取引妨害</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interference with Prospective Relations</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia con Relaciones Prospectivas</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beeinträchtigung von Geschäftsbeziehungen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרעה ביחסים עתידיים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia con Relaciones Prospectivas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">干扰未来关系</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Obstruction aux relations commerciales</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFs8eqGTlY90gkX2NFNLTH"/>
    <rdfs:label>Interference with Prospective Relations</rdfs:label>
    <skos:definition>The concept of Interference with Prospective Relations refers to the intentional and unjustified interference with a party's potential or anticipated business relationships or economic advantages, causing harm or loss to that party.</skos:definition>
  </rdf:Description>
