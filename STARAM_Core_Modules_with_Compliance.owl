    <rdfs:subClassOf rdf:nodeID="Nab1c303300ab473090610c8eb41b615c"/>
    <rdfs:subClassOf rdf:nodeID="N15fe6b13abbb48358a4f78e5972827cd"/>
    <skos:definition>A "General Contractor" is a construction professional or company responsible for overseeing and managing the entire construction project. They are typically hired by the client or property owner and are responsible for coordinating all aspects of the project, including hiring subcontractors, managing schedules, budgets, and ensuring that the project is completed according to the specified plans and requirements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>General Contractor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8VLSa5QRfIn3avjigeu5rn">
