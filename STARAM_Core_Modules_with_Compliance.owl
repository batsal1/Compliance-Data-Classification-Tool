  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RO6KuY2FLub0BPWNMabpGQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Cláusula de bônus EBITDA</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">EBITDAボーナス条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de bonificación EBITDA</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">EBITDA Bonus Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">EBITDA-Bonusklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">EBITDA奖金条款</skos:altLabel>
