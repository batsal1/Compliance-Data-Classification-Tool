  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9lIayMMbGtBfT0O6Gmf2p7">
    <rdfs:label>Sales Tax Practice</rdfs:label>
    <skos:altLabel>Sales Tax Service</skos:altLabel>
    <skos:altLabel>Sales Tax</skos:altLabel>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <skos:definition>Sales tax practice refers to the specialized legal service in which lawyers advise businesses on the collection, remittance, and reporting of sales tax, as well as represent them in disputes with tax authorities. The practice covers understanding jurisdictional differences, ensuring compliance with state and local regulations, and managing audits or assessments.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R527Rr0DAZ1Lu9VPx6QRbj"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/FcewVqeOSPybXkvVw-SuNQ">
    <skos:example>Ultrasound imaging centers</skos:example>
    <skos:example>Dental or medical X-ray laboratories</skos:example>
    <skos:example>Computer tomography (CT-scan) centers</skos:example>
    <skos:example>Magnetic resonance imaging (MRI) centers</skos:example>
    <skos:example>Medical radiological laboratories</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/dN2iD83iS9eNVDIF5FKpEw"/>
    <skos:definition>This U.S. industry comprises establishments known as diagnostic imaging centers primarily engaged in producing images of the patient generally on referral from a health practitioner.</skos:definition>
    <rdfs:label>Diagnostic Imaging Centers</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=621512"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
