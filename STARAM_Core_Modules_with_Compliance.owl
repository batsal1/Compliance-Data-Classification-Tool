    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RcP9tLiIhGT0pZaCrB0Qih">
    <skos:altLabel xml:lang="en-gb">Contract Duration Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de duração do contrato</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同期限条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsdauerklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de durée de contrat</skos:altLabel>
