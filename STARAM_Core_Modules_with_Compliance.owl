    <skos:definition>See industry description for 922160.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7UYJUZ3D37DD8nEuNUXXti">
    <rdfs:label>Refugee</rdfs:label>
    <skos:definition>In the context of immigration law, a "Refugee" is someone who has been forced to flee their home country due to a well-founded fear of persecution. That fear is often based on race, religion, nationality, political opinion, or membership in a particular social group.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GuYn7yMmfL0coiNQ0OE8f"/>
    <rdfs:subClassOf rdf:nodeID="N8e9ae70c76cc48ed9ae9ca3da587ea1e"/>
    <rdfs:subClassOf rdf:nodeID="N426d75f3b8ea4c73b43e77393e738a82"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
