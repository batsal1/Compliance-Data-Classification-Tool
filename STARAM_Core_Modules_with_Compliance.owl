    <skos:altLabel xml:lang="pt-br">Desprezo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Mépris</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Desprecio</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Contempt</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verachtung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">蔑视</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Desprecio</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवमान</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSRxb9psAJdqf8rppoiYI8"/>
    <skos:definition>Contempt refers to the intentional disobedience or disregard of a court order or authority, which can result in criminal or civil penalties.</skos:definition>
    <rdfs:label>Contempt</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
