  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9qNwyOrzjiccsqggU9qkhh">
    <skos:definition>Inactive Employment refers to a temporary or prolonged period during which an employee remains on the payroll but is not actively performing job duties. This can occur for various reasons such as medical leave, furlough, or sabbatical, and usually entails a change in benefits or compensation during the inactive period.</skos:definition>
    <rdfs:label>Inactive Employment Status</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RgcYpZhkBQt5qL99YT6jP7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
