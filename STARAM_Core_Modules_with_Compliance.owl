    <rdfs:label>National Health Service Coverage</rdfs:label>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Under a National Health Service model, healthcare services are funded by general taxation and are provided by government-run facilities. An example is the National Health Service (NHS) in the United Kingdom, which provides healthcare services free at the point of use for residents.</skos:definition>
  </rdf:Description>
