  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBHP1IDvzEGAyQ545DElniE">
    <skos:altLabel>Private Bond Placement</skos:altLabel>
    <skos:altLabel>Private Bond Distribution</skos:altLabel>
    <skos:altLabel>Direct Debt Sale</skos:altLabel>
    <skos:altLabel>Private Debt Placement</skos:altLabel>
    <skos:altLabel>Private Debt Offering</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCTOKjYuZWSDY4D5arHFPci"/>
    <rdfs:label>Private Offering</rdfs:label>
    <skos:definition>Private Debt Offering refers to the sale of debt securities directly to a small group of private investors, typically without the need for public registration or regulatory approval. This method is often used by companies seeking to raise capital more quickly and with greater confidentiality than through public offerings.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBML32OU09Dl72mx9f3cck2">
    <skos:altLabel xml:lang="en-gb">Car Renter Liable for Injury</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">車のレンタル業者は負傷に対して責任を負う</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Autovermieter haftet für Verletzungen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Locatário de carro responsável por lesão</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Arrendatario del coche responsable de lesiones</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कार किराएदार घायली के लिए जिम्मेदार</skos:altLabel>
    <skos:altLabel xml:lang="he-il">השוכר של הרכב אחראי לפגיעה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Le loueur de voiture est responsable des blessures</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租车人对伤害负责</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Arrendatario del auto responsable de lesiones</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nbbfe0f4608734b42b0f9f1cb39ac7665"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
    <skos:definition>A legal principle that holds a person who rents a car responsible for any injuries or damages caused by the car while it is in their possession.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Car Renter Liable for Injury</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBxqZs1JzyYftyuWzx1yHib">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="zh-cn">旁观者情感困扰</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">傍観者の感情的苦痛</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Angústia emocional de espectadores</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Détresse émotionnelle des témoins</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Emotionale Belastung von Zuschauern</skos:altLabel>
    <skos:definition>The concept of Bystander Emotional Distress refers to the legal claim that a person who witnesses the harm caused to another person can also suffer emotional distress and can seek compensation for it, under the Infliction of Emotional Distress claim.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9IldpgAfUyz3upHKvXdn8y"/>
    <rdfs:subClassOf rdf:nodeID="N23e291c415a04e70ade8050fba20a25f"/>
    <rdfs:label>Bystander Emotional Distress</rdfs:label>
  </rdf:Description>
