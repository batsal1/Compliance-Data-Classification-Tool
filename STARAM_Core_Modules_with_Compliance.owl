  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9XMkpoA6wauWR4rhCZghBC">
    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo Sustitutivo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Ersetzung von Vereinbarungen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Superseding Agreement Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Substituição de Acordo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">取代协议条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सुपरसीडिंग अधिनियम धारा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo Sustitutivo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">置換契約条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכם מחליף</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de remplacement d'accord</skos:altLabel>
    <skos:definition>A Superseding Agreement Clause is a provision in a contract that states that any previous agreements between the parties are no longer valid and that the current contract is the only binding agreement between them.</skos:definition>
    <rdfs:label>Superseding Agreement Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
