  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7mMPoEuA9Ja4rODr1LGXcR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy"/>
    <rdfs:label>Copyright Work Types</rdfs:label>
    <skos:definition>Copyright Work Types encompass various forms of creative works such as Derivative Work, Collective Work, and Joint Work, each with unique characteristics and legal implications. Derivative Works are based on pre-existing works, Collective Works involve the assembly of independent works into a single publication, and Joint Works are created by collaboration with merged contributions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rq7yrbwVSqS8fuRtnzDx6g">
    <skos:definition>Telecommunications, Media, and Entertainment Law involves the legal principles, regulations, and issues that govern the entertainment industry and media enterprises, including film, music, publishing, and digital media. It encompasses various areas such as Advertising Law, Sports Law, and Entertainment Law.</skos:definition>
    <rdfs:label>Telecommunications, Media, and Entertainment Law</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSYBzf149Mi5KE0YtmpUmr"/>
  </rdf:Description>
