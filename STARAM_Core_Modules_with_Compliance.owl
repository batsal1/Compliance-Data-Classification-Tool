  <rdf:Description rdf:about="https://folio.openlegalstandard.org/cW-wZtcFTXuDlNYs96bTZA">
    <rdfs:label>Plastics Packaging Materials and Unlaminated Film and Sheet Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in (1) converting plastics resins into unsupported plastics film and sheet and/or (2) forming, coating, or laminating plastics film and sheet into plastics bags.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32611"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/P2ahRVjlQwyn4knwwoIQvw"/>
