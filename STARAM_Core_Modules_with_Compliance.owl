    <skos:altLabel xml:lang="pt-br">Instrumento negociável fraudulento pago ou tomado</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כלי כתיבה נגושים מזויפים ששולמו או נלקחו</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不正な交換可能な証書が支払われたまたは取得された</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">欺诈性可转让票据已付或被接受</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Instrument négociable frauduleux payé ou pris</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Instrumento negociable fraudulento pagado o tomado</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">धोखाधड़ी संबंधी नेगोशिएबल दस्तावेज भुगतान या लिया गया</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betrügerisches zahlungsfähiges Instrument bezahlt oder genommen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Instrumento negociable fraudulento pagado o tomado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fraudulent Negotiable Instrument Paid or Taken</skos:altLabel>
    <skos:definition>A fraudulent negotiable instrument paid or taken refers to a claim of fraud involving a negotiable instrument, such as a check or promissory note, that has been paid or accepted by a party who knew or should have known of the fraud.</skos:definition>
    <rdfs:label>Fraudulent Negotiable Instrument Paid or Taken</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7yFvjE3c7XNyrKkiFPHUUs">
    <skos:altLabel xml:lang="ja-jp">公証人および保証人の過失</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公证人和保证人的疏忽</skos:altLabel>
