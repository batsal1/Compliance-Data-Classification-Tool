    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>To "Impress a Trust" means to create an equitable claim on property by demonstrating that it was intended to be held in trust, even if it was not formally declared as such.</skos:definition>
  </rdf:Description>
