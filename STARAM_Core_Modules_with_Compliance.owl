  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RLNc7gzywoZLESpwFH8Q7M">
    <skos:altLabel xml:lang="ja-jp">カイロプラクティック医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle d'un chiropracteur</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Chiropraktiker-Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Chiropractor Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia profesional de quiropráctico</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאת מקצוע של כירופרקטיקאי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência de quiropraxia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">脊医过失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कायरोप्रैक्टर लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia profesional de quiropráctico</skos:altLabel>
    <skos:definition>Chiropractor Malpractice refers to a type of medical malpractice claim that arises from the negligent or intentional actions of a chiropractor, resulting in harm or injury to a patient.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdfs:label>Chiropractor Malpractice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbb425050b6eb443e96f607e4701aea80">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermChangeOfControl"/>
