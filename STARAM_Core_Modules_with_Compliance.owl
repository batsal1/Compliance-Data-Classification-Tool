  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RgHKgBYfidbNNddNK2ube4">
    <skos:altLabel>Contract-Based Restructuring</skos:altLabel>
    <skos:altLabel>Contractual Debt Adjustment</skos:altLabel>
    <skos:altLabel>Private Negotiated Restructuring</skos:altLabel>
    <skos:altLabel>Private Debt Restructuring</skos:altLabel>
    <skos:definition>Individualized restructuring involves private negotiations between a debtor and one or more creditors to modify the terms of existing debt agreements. This process allows parties to tailor solutions to their specific needs without court intervention, often resulting in revised payment schedules, reduced interest rates, or partial debt forgiveness.</skos:definition>
    <rdfs:label>Individualized Restructuring</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG"/>
  </rdf:Description>
