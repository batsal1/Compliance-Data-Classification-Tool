  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7fLMEsGHS8Z3LKqXkoVCQA">
    <skos:definition>A Stop Sign Violation Claim involves a legal allegation that a driver has failed to make a complete stop at a stop sign as required by traffic regulations, potentially leading to administrative or legal penalties. Such claims are integral to traffic law enforcement and often necessitate evidence review and legal proceedings to resolve.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <rdfs:label>Stop Sign Violation Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Failure to Stop Claim</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R819RNz2UNTDhwmdljqZlHN">
    <skos:altLabel xml:lang="hi-in">कोई वारंटी क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">无担保条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">免責条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Sin Garantías</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Warranties Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-garantie</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de isenção de garantias</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ללא אחריות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftungsausschlussklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Sin Garantías</skos:altLabel>
    <skos:definition>A No Warranties Clause is a provision in a contract that disclaims any guarantees or assurances regarding the quality or performance of a product or service, and places the risk of use solely on the user.</skos:definition>
    <rdfs:label>No Warranties Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
