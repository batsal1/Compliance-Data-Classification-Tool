    <rdfs:label>JA00 Funding (UK J-CODE)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCAZQP6AHCQX7HNZqzV7oIR"/>
    <skos:definition>All work relating to reviewing funding options, securing funding and reports to funders during the life of the case</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N889a95afef3b4bd4ab5e4f8bf9f9fecb">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#OptionToExtendLeaseTerm"/>
