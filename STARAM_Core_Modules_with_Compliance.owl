  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9ZlcWw9hSKW6ufbTbaLF7c">
    <skos:definition>A baseball arbitration clause is a specific type of contractual clause that requires disputes to be resolved through a process similar to baseball salary arbitration, where each party submits a proposed resolution and an arbitrator chooses one of the proposals without modification.</skos:definition>
    <skos:altLabel xml:lang="hi-in">बेसबॉल विवाद-सुलझान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">棒球仲裁条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schiedsklausel im Baseball-Stil</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de arbitragem de beisebol</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'arbitrage de baseball</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">野球仲裁条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de arbitraje de béisbol</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פילוג בייסבול</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Baseball Arbitration Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de arbitraje de béisbol</skos:altLabel>
    <rdfs:label>Baseball Arbitration Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
