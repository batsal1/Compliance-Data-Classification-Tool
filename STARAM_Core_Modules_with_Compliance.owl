  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9q6K9SQAWS0tjXvWLtIGli">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Face Value</skos:altLabel>
    <skos:altLabel>Nominal Value</skos:altLabel>
    <skos:prefLabel>Par Value</skos:prefLabel>
    <skos:definition>Par refers to the face value of a financial instrument, such as a bond or loan, at the time of issuance or redemption. It is the nominal value that does not account for interest rates or market fluctuations</skos:definition>
    <rdfs:label>Par</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCn46eIc5j39dfkp4HLA5jB">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>INVOICE_TAX_CURRENCY</rdfs:label>
    <skos:definition>A standardized format for invoices that includes information on taxes and currency, as defined by the LEDES98BI V5 Format Rev 1-2020.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
  </rdf:Description>
