  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RsdwEwu7LYvKqhaVWlHZok">
    <dc:source>International Bill of Human Rights</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Right to Fair Wages</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDb7mHsQQLLSVsxIdQivBMB"/>
    <skos:definition>The right to fair wages refers to the human right that ensures workers receive just and favorable remuneration for their labor, sufficient for a decent standard of living. This right is often protected by international instruments like the International Covenant on Economic, Social and Cultural Rights and national labor laws, which may set minimum wage standards and regulate working conditions.</skos:definition>
  </rdf:Description>
