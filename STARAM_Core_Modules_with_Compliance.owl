  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDbhplt4ns4BXyfsWO3fleK">
    <skos:altLabel xml:lang="ja-jp">契約違反条項の責任</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Liability for Breach of Contract Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध उल्लंघन शर्त के लिए दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad por Cláusula de Incumplimiento de Contrato</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade por cláusula de quebra de contrato</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad por Cláusula de Incumplimiento de Contrato</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违约条款的责任</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung für Vertragsbruchklausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות על סעיף הפרת החוזה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité pour clause de rupture de contrat</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZVXNAbvbm2JirFGPT4Ihy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Liability for Breach of Contract Clause</rdfs:label>
    <skos:definition>Liability for Breach of Contract Clause refers to the legal responsibility that arises when a party fails to fulfill their obligations as outlined in a specific clause within a contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBdKXCm8frrbLMsPb8cKHBL">
    <rdfs:label>410 Antitrust (PACER NoS)</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N3915a4939daf4ee0910049983763e08b"/>
    <rdfs:subClassOf rdf:nodeID="N6d9d9e4953684684a1a23b85aee8305f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCLxFZZvTWZmKpUYJa6UMmO"/>
    <skos:definition>Action brought under the Clayton Act 15 U.S.C. § 12 - 27 alleging undue restriction of trade and commerce by designated methods that limit free competition in the market place amongst consumers such as anti-competitive price discrimination, corporate mergers, interlocking directorates or tying and exclusive dealing contracts.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQbVKPVl5dj5nW6aXoNxx4">
    <skos:definition>Price-based segments refer to divisions of the market that are categorized based on the pricing and affordability of products and services. These segments include luxury, budget, and mass market, each targeting consumers with different levels of purchasing power and preferences for price versus quality.</skos:definition>
    <rdfs:label>Price-Based Market Segments</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KxYUBMSAuzPHdBhWfPSv7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
