  <rdf:Description rdf:about="https://folio.openlegalstandard.org/A4LbRW8qSeOadwyg-otSwQ">
    <skos:definition>This industry comprises establishments primarily engaged in (1) converting paper and paperboard into products (except containers, bags, coated and treated paper and paperboard, and stationery products) or (2) converting pulp into pulp products, such as disposable diapers, or molded pulp egg cartons, food trays, and dishes.  Processes used include laminating or lining purchased paper or paperboard.</skos:definition>
    <skos:example>Sanitary products made from purchased sanitary paper stock</skos:example>
    <skos:example>Molded pulp products (e.g., egg cartons, food containers, food trays) manufacturing</skos:example>
    <skos:example>Crepe paper made from purchased paper</skos:example>
    <skos:example>Paper novelties made from purchased paper</skos:example>
    <skos:example>Die-cut paper products (except for office use) made from purchased paper or paperboard</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_tQlht4ETRKrwll0G13vfw"/>
    <rdfs:label>Other Converted Paper Product Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32229"/>
  </rdf:Description>
