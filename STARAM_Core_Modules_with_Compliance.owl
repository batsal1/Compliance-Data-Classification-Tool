    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=532412"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ak3ztgoSRkaxVyoKBEWvHA"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in renting or leasing heavy equipment without operators that may be used for construction, mining, or forestry, such as bulldozers, earthmoving equipment, well drilling machinery and equipment, or cranes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
