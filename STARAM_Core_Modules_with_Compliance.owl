  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RybmPQiRqfCkemZ2x04CRv">
    <skos:altLabel>Driving Without Proof of Insurance</skos:altLabel>
    <skos:altLabel>Operating Without Coverage</skos:altLabel>
