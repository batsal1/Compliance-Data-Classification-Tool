  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8pNPutX0TN6DlEqkyZuxSw">
    <rdfs:label>Lessor</rdfs:label>
    <skos:altLabel xml:lang="de-de">Vermieter</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃貸人</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lessor</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Arrendador</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Arrendador</skos:altLabel>
    <skos:altLabel xml:lang="he-il">משכיר</skos:altLabel>
    <skos:altLabel>Landlord</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Bailleur</skos:altLabel>
    <skos:altLabel>Lessor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लेसर</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">出租人</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Locador</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Na1b14e99b94f41e591346c13145f47b5"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:nodeID="N59cba36247c04ac6a730caacb911e142"/>
    <skos:definition>A lessor is a person or entity that leases or lets a property to another; a landlord.</skos:definition>
    <dc:identifier>LESR</dc:identifier>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-LESR</ns2:legacyIdentifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:hiddenLabel>LESR</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBTRFpp0FjlLGnwG1WxiYqv">
    <skos:altLabel xml:lang="zh-cn">中止条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विराम अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">解除条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Resolución</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בדיקת פסק וחזרה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Break Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Terminación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Break Clause</rdfs:label>
    <skos:definition>A break clause is a provision in a contract that allows one or both parties to terminate the agreement before the end of its term.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R88AyeTaNAW6dW1MxsSG0rF">
    <skos:altLabel xml:lang="zh-cn">工作成果所有权条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בעלות על מוצרי עבודה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Eigentumsübertragung des Arbeitsergebnisses</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">काम उत्पाद के स्वामित्व अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de propriedade do produto do trabalho</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de propriété du produit du travail</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Ownership of Work Product Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">作業成果物の所有権条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de propiedad del producto del trabajo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de propiedad del producto del trabajo</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZAAssp8e4tsWUO6B4rcab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Ownership of Work Product Clause</rdfs:label>
    <skos:definition>Ownership of Work Product Clause: A provision in a legal agreement that specifies the ownership rights of the work product created by an individual or entity in the course of their employment or engagement.</skos:definition>
