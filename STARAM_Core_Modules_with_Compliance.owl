  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Scl6Rq9sPzgThnTlkTZ8C">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfBdQ771UMEZMpb5zTUXAZ"/>
    <skos:altLabel xml:lang="he-il">הסתברות לתוצאה שלילית</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不良结果的可能性</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुकूलता की संभावना</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Probabilidade de Resultado Adverso</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不良結果の可能性</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Probabilité de résultat défavorable</skos:altLabel>
    <skos:altLabel>Likelihood of Adverse Result</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Likelihood of Adverse Result</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Probabilidad de resultado adverso</skos:altLabel>
    <skos:altLabel>Likelihood of Liability</skos:altLabel>
    <skos:altLabel>Likelihood of Conviction</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Probabilidad de resultado adverso</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wahrscheinlichkeit eines ungünstigen Ergebnisses</skos:altLabel>
    <skos:definition>Likelihood of an adverse result (e.g., client liability, client convicted) — sometimes expressed as a percentage, and sometimes expressed as a classification (e.g., Very High, High, Medium, Low)</skos:definition>
    <rdfs:label>Likelihood of Adverse Result</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDvqI3YurzXDXZKeOIl6qzM">
    <rdfs:label>Role in Project Management</rdfs:label>
    <skos:definition>An individual's role in the matter in project management terms.</skos:definition>
    <skos:altLabel xml:lang="ja-jp">プロジェクトマネジメントにおける役割</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Role in Project Management</skos:altLabel>
