  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R75Bx0QJin6XW4ki2c8pJGw">
    <skos:definition>Nonpossessory Interest refers to a type of property interest that grants certain rights to use or enjoy the property without possessing it. This includes interests such as easements, covenants, and profits à prendre, where the holder has limited rights related to the property owned by another person.</skos:definition>
    <skos:altLabel>Property Incumbrances</skos:altLabel>
    <rdfs:label>Nonpossessory Interest</rdfs:label>
    <skos:prefLabel>Non-Possession Property Rights</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
  </rdf:Description>
