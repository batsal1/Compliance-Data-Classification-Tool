    <rdfs:subClassOf rdf:nodeID="N70877fa9081c4703a1e256a21f9c1d49"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Escape from Correctional Facility</rdfs:label>
  </rdf:Description>
