  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9g0tsF68ZfL1dvdj4jdg1t">
    <rdfs:label>Contractual Standardization</rdfs:label>
    <skos:definition>Contractual Standardization refers to the extent to which the terms of a contract are standardized or custom-tailored. Standardized contracts have predefined terms and conditions that are universally applied, facilitating easier trading and regulatory compliance, while non-standardized contracts are customized to meet specific needs of the contracting parties.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source rdf:resource="https://nna.jse.co.za/Help/cfi.htm"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e"/>
  </rdf:Description>
