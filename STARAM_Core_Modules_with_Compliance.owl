  <rdf:Description rdf:about="https://folio.openlegalstandard.org/3hLWHHZURAm2-7s6lKYwOg">
    <skos:example>Amusement park equipment merchant wholesalers</skos:example>
    <skos:example>Beauty parlor equipment and supplies merchant wholesalers</skos:example>
    <skos:example>Upholsterers' equipment and supplies (except fabrics) merchant wholesalers</skos:example>
    <skos:example>Water treatment equipment, municipal, merchant wholesalers</skos:example>
    <skos:example>Voting machines merchant wholesalers</skos:example>
    <skos:example>Drycleaning equipment and supplies merchant wholesalers</skos:example>
    <skos:example>Car wash equipment and supplies merchant wholesalers</skos:example>
    <skos:example>Undertakers' equipment and supplies merchant wholesalers</skos:example>
    <skos:example>Janitorial equipment and supplies merchant wholesalers</skos:example>
    <rdfs:label>Service Establishment Equipment and Supplies Merchant Wholesalers</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of specialized equipment and supplies of the type used by service establishments (except specialized equipment and supplies used in offices, stores, hotels, restaurants, schools, health and medical facilities, photographic facilities, and specialized equipment used in transportation and construction activities).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/0bwbqpSMSGGJlyYAfFjSlA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423850"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R75XNpcAhlxR5GFSURD7uC7">
    <rdfs:label>Indefinite Term Clause</rdfs:label>
    <skos:altLabel xml:lang="hi-in">अनिश्चित अवधि शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de plazo indefinido</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不定期条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de prazo indeterminado</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel für unbestimmte Laufzeit</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תקופה בלתי מוגבלת</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">无限期条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de durée indéterminée</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de plazo indefinido</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Indefinite Term Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An indefinite term clause is a provision in a contract that does not specify a specific duration or end date for the agreement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R17JpTFShx66kn5Fq73uQk">
    <skos:altLabel xml:lang="es-mx">Cláusula de cantidad máxima no excedida</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिकतम राशि अधिवेशन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de valor máximo não excedido</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de cantidad máxima no excedida</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de montant maximal ne devant pas être dépassé</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不得超过金额条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סכום לא לחרוג</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">超過しない金額条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Höchstgrenze des Betrags</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Not to Exceed Amount Clause</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Not to Exceed Amount Clause</rdfs:label>
    <skos:definition>A Not to Exceed Amount Clause is a provision in a contract that sets a maximum limit on the amount of money that can be spent on a particular project or service, ensuring that costs do not exceed a certain threshold.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDfeGpPrijZkvT8pR4lT1aC">
    <rdfs:label>Underage Betting</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Underage Gambling</skos:altLabel>
    <skos:altLabel>Juvenile Gambling</skos:altLabel>
    <skos:altLabel>Minor Betting</skos:altLabel>
    <skos:definition>Underage Betting refers to the illegal practice of individuals below the legal age limit participating in gambling activities, either online or at physical venues. This activity violates gambling laws and regulations designed to protect minors from the risks associated with gambling.</skos:definition>
    <skos:prefLabel>Youth Gambling</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB45dXxacmQbbLYaT8gCptW"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncdc817cb6e7a41b5b569e66cd1bb2edf">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7yiK6hR6BkuiTgbsV5u1CC"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7oPtqGQSFLbuj4sBCAVVz8">
    <skos:altLabel>Customs and Import Controls Service</skos:altLabel>
    <skos:altLabel>Border Control Practice</skos:altLabel>
    <skos:altLabel>Import Regulatory Practice</skos:altLabel>
    <skos:altLabel>Customs and Import Controls</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N281aad5a64b642aa8e56810ce88e34f8"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8x520MB0xME0o4Wrg2o1so"/>
    <rdfs:subClassOf rdf:nodeID="Nac20ed1618e64c3696a2a3472de5bd5a"/>
    <rdfs:label>Customs and Import Controls Practice</rdfs:label>
    <skos:definition>Customs and Import Controls Practice encompasses the legal frameworks and regulations governing the importation of goods into a country. This practice area includes compliance with customs laws, import duties, tariffs, import restrictions, and procedures for resolving disputes related to customs and import controls.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBcSS6JJPoCbbKqlNnoIQJB">
    <skos:definition>Privacy Risk refers to the potential for negative consequences arising from an organization's failure to protect the privacy and confidentiality of personal or sensitive information entrusted to it by individuals or other organizations. These risks can result from inadequate data security measures, cyber attacks, or noncompliance with privacy regulations, potentially leading to data breaches, loss of trust, or legal liabilities, ultimately impacting the organization's overall performance, reputation, and sustainability.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N64471eebdf3a4fe487e753c93fad35b4"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xla5mpMCkDl1t6YAR0Eoh"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHsUy15guQC3jWrIYrwRsH"/>
    <rdfs:subClassOf rdf:nodeID="Ne924a292701a4fbca8a657844c580160"/>
    <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
    <rdfs:label>Privacy Risk</rdfs:label>
    <skos:altLabel>Information Stewardship Risk</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8hTuQBrWujQeiTDrPH1tbQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Furniture, Home Furnishings, Electronics, and Appliance Retailers Industry</rdfs:label>
    <rdfs:label>Furniture, Home Furnishings, Electronics, and Appliance Retailers</rdfs:label>
    <skos:altLabel xml:lang="es-mx">Industria de tiendas de electrónica y electrodomésticos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie des magasins d'électronique et d'appareils électroménagers</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इलेक्ट्रॉनिक्स और उपकरण स्टोर उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Elektronik- und Haushaltsgerätehandel</skos:altLabel>
    <skos:altLabel>Electronics and Appliance Stores</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">电子和家电商店行业</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">電子製品および家電店業界</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de tiendas de electrónica y electrodomésticos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Electronics and Appliance Store Industry</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית חנויות אלקטרוניקה ומכשירי חשמל</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de lojas de eletrônicos e eletrodomésticos</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP"/>
    <dc:identifier>IN-INDUSTRY-17.5</dc:identifier>
    <dc:identifier>RET-ELAP</dc:identifier>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=449"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-RET-ELAP</ns2:legacyIdentifier>
    <skos:definition>Industries in the Furniture, Home Furnishings, Electronics, and Appliance Retailers subsector retail new furniture, home furnishings, electronics, and appliances.  Establishments in this subsector with fixed point-of-sale locations may operate from showrooms or other locations that have substantial areas for the presentation or demonstration of their products.  Establishments in this subsector may provide incidental services, including interior decorating, product assembly, installation, or repair services.</skos:definition>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:hiddenLabel>ELAP</skos:hiddenLabel>
    <skos:prefLabel>Furniture, Home Furnishings, Electronics, and Appliance Retailers Industry</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/HqyNwM1wRPCobcjlHnVtDQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Fertility clinics</skos:example>
    <skos:example>Pregnancy counseling centers</skos:example>
    <skos:example>Childbirth preparation classes</skos:example>
    <skos:example>Birth control clinics</skos:example>
    <skos:definition>This industry comprises establishments with medical staff primarily engaged in providing a range of family planning services on an outpatient basis, such as contraceptive services, genetic and prenatal counseling, voluntary sterilization, and therapeutic and medically induced termination of pregnancy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ReQxdHikSX67zsflLGUpwQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=621410"/>
    <rdfs:label>Family Planning Centers</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/rA2-MYutQTWJEyHJJoxWdg">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=335999"/>
    <rdfs:label>All Other Miscellaneous Electrical Equipment and Component Manufacturing</rdfs:label>
    <skos:example>Extension cords made from purchased insulated wire</skos:example>
    <skos:example>Door opening and closing devices, electrical, manufacturing</skos:example>
    <skos:example>Battery chargers, solid-state, manufacturing</skos:example>
    <skos:example>Surge suppressers manufacturing</skos:example>
    <skos:example>Inverters manufacturing</skos:example>
    <skos:example>Appliance cords made from purchased insulated wire</skos:example>
    <skos:example>Electric bells manufacturing</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Uninterruptible power supplies (UPS) manufacturing</skos:definition>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing industrial and commercial electric apparatus and other equipment (except lighting equipment, household appliances, transformers, motors, generators, switchgear, relays, industrial controls, batteries, communication and energy wire and cable, wiring devices, and carbon and graphite products). Examples of products made by these establishments are power converters (i.e., AC to DC and DC to AC), power supplies, surge suppressors, and similar equipment for industrial-type and consumer-type equipment.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/mNcLJvWOTFaGZevzn_LXQA"/>
  </rdf:Description>
