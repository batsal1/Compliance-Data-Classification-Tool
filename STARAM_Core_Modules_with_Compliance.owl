    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão automática</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An automatic termination clause is a provision in a contract that specifies the circumstances under which the agreement will end without the need for further action by either party.</skos:definition>
    <rdfs:label>Automatic Termination Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
