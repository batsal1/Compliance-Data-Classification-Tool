  <rdf:Description rdf:about="https://folio.openlegalstandard.org/fhgj0A_rT2yLAtqVkbCvhg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/hncqZ2XEQgCapENT5DIm_A"/>
    <rdfs:label>Cheese Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) manufacturing cheese products (except cottage cheese) from raw milk and/or processed milk products and/or (2) manufacturing cheese substitutes from soybean and other nondairy substances.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311513"/>
  </rdf:Description>
