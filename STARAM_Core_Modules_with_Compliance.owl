  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDbyX1SuwIsejbZGgdJSKaT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Responsabilidad del agente por la obligación del principal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Agent’s Liability for Principal’s Obligation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रधान के अधिकार के लिए एजेंट की जिम्मेदारी</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad del agente por la obligación del principal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité de l'agent pour les obligations du mandant</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">代理人对委托人义务的责任</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung des Agenten für die Verpflichtungen des Prinzipals</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות הסוכן על התחייבות המנהל</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">代理人の委託者の義務に対する責任</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade do agente pelas obrigações do principal</skos:altLabel>
    <rdfs:label>Agent’s Liability for Principal’s Obligation</rdfs:label>
    <skos:definition>The concept of "Agent's Liability for Principal's Obligation" refers to the legal responsibility of an agent to fulfill the obligations of their principal, such as paying debts or fulfilling contracts, and being held liable for any failure to do so.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
  </rdf:Description>
