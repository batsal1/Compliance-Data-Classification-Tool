  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB2Yc4Pe5s6z8QBiydyzCTZ">
    <skos:altLabel xml:lang="zh-cn">买方同意要求适用于所有负面契约</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">El requisito de consentimiento del comprador se aplica a todas las cláusulas restrictivas</skos:altLabel>
    <skos:altLabel xml:lang="es-es">El requisito de consentimiento del comprador se aplica a todas las cláusulas restrictivas</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">L'exigence de consentement de l'acheteur s'applique à toutes les clauses restrictives</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דרישת הסכמת הקונה חלה על כל ההתחייבויות השליליות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">買手の同意要件はすべてのネガティブカバナントに適用されます</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार सहमति आवश्यकता सभी नकारात्मक अटूट शर्तों के लिए लागू होती है</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Requisito de consentimento do comprador se aplica a todas as cláusulas restritivas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Buyer Consent Requirement Applies to All Negative Covenants</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Käufer-Zustimmungserfordernis gilt für alle negativen Verpflichtungen</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9xgvrUWmxGlvR7ooOgWvo7"/>
    <skos:definition>A legal principle that mandates the buyer's approval for all negative covenants, which are contractual obligations that prohibit certain actions, in a transaction or agreement.</skos:definition>
    <rdfs:label>Buyer Consent Requirement Applies to All Negative Covenants</rdfs:label>
  </rdf:Description>
