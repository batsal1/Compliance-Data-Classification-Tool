  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8XbDT15o2VgPwJQmeNM4Y">
    <skos:definition>Financial Reporting Law encompasses the regulations and standards governing the disclosure of financial information by entities. It ensures transparency, accuracy, and consistency in financial statements, facilitating informed decision-making by stakeholders.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7pLfw7zqXtd20kKg7EcOA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Financial Reporting Law</rdfs:label>
    <skos:altLabel>Accounting Standards Law</skos:altLabel>
    <skos:altLabel>Financial Disclosure Law</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCU0vhYMGrdY9EsjmN2mkqQ">
    <skos:definition>In the context of AI, data leakage refers to the introduction of information into the training data that the system is expected to infer but should not legitimately have access to during model training. This results in a model that appears to perform well during evaluation on the test set but demonstrates poor performance during deployment when evaluated on new data sets.</skos:definition>
    <skos:altLabel>Data Contamination</skos:altLabel>
    <skos:altLabel>Model Contamination</skos:altLabel>
    <skos:altLabel>Unintended Data Inclusion</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
    <rdfs:label>Data Leakage</rdfs:label>
  </rdf:Description>
