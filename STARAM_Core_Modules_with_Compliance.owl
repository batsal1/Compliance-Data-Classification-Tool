  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9vaSQKqYGzvWB6jGlLx3Vg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="fr-fr">Clause de non-responsabilité des dommages</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף כלי רישום של פגמים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हानि के अस्वीकरण अनुबंध</skos:altLabel>
