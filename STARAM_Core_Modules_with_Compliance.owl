    <skos:altLabel xml:lang="es-es">Análisis de acuerdos de deuda previos a la petición</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Analyse von Vereinbarungen über Voranmeldungsverbindlichkeiten</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">事前債務契約の分析</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Analyse des accords de dettes pré-pétition</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्व-याचिका ऋण समझौतों का विश्लेषण</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDrxLQS4WPXUa6tUdBGdu2r"/>
    <rdfs:subClassOf rdf:nodeID="N995c192d55ea44c5b2cdf3125ccf5da9"/>
    <skos:definition>Analysis of Pre-Petition Debt Agreements refers to the examination and evaluation of agreements related to debts that were made before the filing of a bankruptcy petition.</skos:definition>
    <rdfs:label>Analysis of Pre-Petition Debt Agreements</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RqiDHswc43JoKvLEHWMGvR">
    <skos:altLabel xml:lang="es-es">Reclamo por violación del salario prevaleciente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por violación del salario mínimo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de violation du salaire prévalent</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">普遍工资违规索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de violação do salário prevalecente</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Verletzung des vorherrschenden Lohns</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रबल वेतन उल्लंघन दावा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">支配賃金違反請求</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Prevailing Wage Violation Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על הפרת שכר מתחרה</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <skos:prefLabel>Davis-Bacon Act Claim</skos:prefLabel>
    <skos:definition>A prevailing wage violation claim is a legal action initiated by an employee against their employer for not paying the required prevailing wage for work performed on a government-funded construction project or a project subject to prevailing wage laws. Prevailing wage laws require contractors and subcontractors to pay workers on public works projects the prevailing wage rate for their job classification in the local area where the work is performed. The claim typically arises when an employer pays workers less than the applicable prevailing wage rate or does not properly classify workers for the purposes of determining their prevailing wage rate.</skos:definition>
    <rdfs:label>Prevailing Wage Violation Claim</rdfs:label>
  </rdf:Description>
