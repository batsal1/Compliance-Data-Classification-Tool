  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDpizZcACsM7yyhWpT5tJaM">
    <skos:altLabel xml:lang="en-gb">Forward-looking Material Adverse Effect Standard</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">将来的な重大な不利な影響基準</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फॉरवर्ड-लुकिंग मटेरियल एडवर्स इफेक्ट स्टैंडर्ड</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Estándar de Efecto Adverso Material Prospectivo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Padrão de Efeito Adverso Material Prospectivo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estándar de Efecto Adverso Material Prospectivo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Norme d'effet indésirable matériel prospectif</skos:altLabel>
    <skos:altLabel>Material Adverse Effect (MAE) Standard - Forward-looking</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תקן להשפעה נזיפה חומרית מתבטאת במבט קדימה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Standard für nach vorne gerichtete wesentliche nachteilige Auswirkungen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">前瞻性实质不利影响标准</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
    <skos:definition>A Forward-looking Material Adverse Effect (MAE) Standard is a legal language used in contracts that refers to a future event or circumstance that could have a negative impact on a party's ability to fulfill their obligations under the contract.</skos:definition>
    <rdfs:label>Forward-looking Material Adverse Effect Standard</rdfs:label>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
  </rdf:Description>
