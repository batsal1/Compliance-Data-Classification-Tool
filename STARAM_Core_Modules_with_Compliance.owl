    <skos:altLabel xml:lang="zh-cn">项目管理中的角色</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Rôle dans la gestion de projet</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">परियोजना प्रबंधन में भूमिका</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rolle im Projektmanagement</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תפקיד בניהול פרויקטים</skos:altLabel>
