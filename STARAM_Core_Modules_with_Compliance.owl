  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9X7OBYaVxJd7DtjBSy384C">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RgcYpZhkBQt5qL99YT6jP7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Leave of Absence Status</rdfs:label>
    <skos:definition>Leave of Absence Status refers to a period during which an employee is formally allowed to be away from work for a specific reason, such as medical issues, maternity leave, or personal matters. During this time, the employment relationship is maintained, but the employee may or may not receive full benefits and compensation, depending on company policy and the nature of the leave</skos:definition>
  </rdf:Description>
