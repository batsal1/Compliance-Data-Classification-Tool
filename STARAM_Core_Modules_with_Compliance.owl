    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Business Associate Agreement (BAA) is a legally binding document required under the Health Insurance Portability and Accountability Act (HIPAA). It ensures that business associates (entities or individuals that perform certain functions or activities involving the use or disclosure of protected health information on behalf of a covered entity) will uphold the same standards of privacy and security as the covered entity itself.</skos:definition>
    <rdfs:label>Business Associate Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Data Protection &amp; Privacy</ns1:contractFamily>
    <skos:altLabel>BAA</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RkTW6noLv5Ycc4Hxw7zVZ9">
    <skos:altLabel xml:lang="zh-cn">公司营销人员</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फर्म मार्केटिंग कार्मिक</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">企業マーケティング担当者</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pessoal de marketing da empresa</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Marketing-Personal der Firma</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Firm Marketing Personnel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फर्म मार्केटिंग कर्मचारी</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Personnel de marketing de l'entreprise</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Personal de Marketing de la Empresa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">צוות שיווק בחברה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Personal de Marketing de la Empresa</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQxwZ0byxdnIYBnX6xystH"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7"/>
    <skos:definition>Firm Marketing Personnel refers to individuals within a legal organization who are responsible for promoting the firm's services and brand, and who are not involved in the direct provision of legal services.</skos:definition>
    <rdfs:label>Firm Marketing Personnel</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
