    <skos:altLabel xml:lang="ja-jp">発見コストシフト</skos:altLabel>
    <skos:altLabel xml:lang="he-il">העברת עלויות גילוי</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खोज लागत-शिफ्टिंग</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Discovery Cost-shifting</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Transferência de custos de descoberta</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Disclosure Cost-shifting</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Desplazamiento de costos de descubrimiento</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Transfert de coûts de découverte</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kostenverlagerung bei Entdeckung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Desplazamiento de costos de descubrimiento</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">发现成本转移</skos:altLabel>
    <rdfs:label>Discovery Cost-shifting</rdfs:label>
    <skos:definition>The concept of Discovery Cost-shifting refers to the allocation of expenses related to the process of obtaining evidence in a legal case, where the burden of paying for the discovery is shifted from one party to another.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
