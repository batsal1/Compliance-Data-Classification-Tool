  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RZ6hoxQD6Sa9Hi4bnv1jgC">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KxYUBMSAuzPHdBhWfPSv7"/>
    <skos:definition>Age-based market segments refer to divisions of the market that are categorized based on the age of consumers. These segments allow businesses to tailor their products, services, and marketing strategies to specific age groups, taking into account their unique preferences, lifestyles, and purchasing behaviors.</skos:definition>
    <rdfs:label>Age-Based Market Segment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
