  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RYNZHBKgntHZwOi84zRXwi">
    <skos:altLabel xml:lang="es-mx">Cláusula de cesión de licencia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">License Back Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rücklizenzklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लाइसेंस बैक क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">许可证回转条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de rétrocession de licence</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ライセンスバック条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף החזר רישיון</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de cesión de licencia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de retrocessão de licença</skos:altLabel>
    <skos:definition>A License Back Clause is a clause in a contract that grants the licensor the right to use any modifications or improvements made by the licensee to the licensed technology or intellectual property.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>License Back Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
