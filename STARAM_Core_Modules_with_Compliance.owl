  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9CPDrfJ7JlM6AylZm3RngF">
    <rdfs:label>Not Work Authorized</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
    <skos:definition>In the context of immigration law, "Not Work Authorized" refers to an individual who does not have the legal permission to be employed in a specific country. Under U.S. law, individuals in certain visa categories or those without legal status are considered "not work authorized," and employers could face penalties for employing such individuals.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC9MyQokqi26lix0igSUuVQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Private Placement</skos:altLabel>
    <skos:altLabel>Private Placements</skos:altLabel>
    <skos:altLabel>Private Placement Service</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5mVKmojg3FKSzxupI6FLy"/>
    <skos:definition>A private placement practice refers to the sale of securities directly to a select group of investors, bypassing the public markets. This method allows companies to raise capital more quickly and with fewer regulatory requirements compared to an initial public offering (IPO).</skos:definition>
    <rdfs:label>Private Placement Practice</rdfs:label>
  </rdf:Description>
