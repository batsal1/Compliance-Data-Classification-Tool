  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCJ2hw3ecSD661nokWmTT1u">
    <rdfs:label>Lifecycle of an AI System</rdfs:label>
    <skos:altLabel>AI System Lifecycle</skos:altLabel>
    <skos:altLabel>AI Development Cycle</skos:altLabel>
    <skos:altLabel>Intelligent System Lifecycle</skos:altLabel>
    <skos:altLabel>Automated System Development Cycle</skos:altLabel>
    <skos:definition>The Lifecycle of an AI System encompasses the series of phases involved in the development, deployment, and maintenance of an AI system. These phases include planning and design, data collection and processing, model building, testing, evaluation, verification, validation, deployment, and operation and monitoring, often occurring iteratively, rather than sequentially.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
  </rdf:Description>
