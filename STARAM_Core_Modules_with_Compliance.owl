    <skos:altLabel>LPA</skos:altLabel>
    <ns1:contractFamily xml:lang="en">Corporate Governance &amp; Formation</ns1:contractFamily>
    <skos:definition>A Limited Partnership Agreement is a legal contract that outlines the terms, conditions, and structure of a limited partnership (LP). It specifies the roles, responsibilities, rights, and obligations of the general and limited partners, as well as details regarding profit distribution, capital contributions, and the management of the partnership.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Limited Partnership Agreement</rdfs:label>
    <skos:prefLabel>LP Agreement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDVtW9pxx7DVUlXOsBrOUEO">
    <skos:altLabel xml:lang="hi-in">अंतर्लेखक</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Suscriptor</skos:altLabel>
