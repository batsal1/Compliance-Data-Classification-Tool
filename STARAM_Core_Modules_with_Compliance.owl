  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9PxiCptV9cYtmVkS4ffHgl">
    <rdfs:label>Anesthesiology Malpractice</rdfs:label>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית באנסתזיה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Anaesthesia Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anästhesiefehlerhaftigkeit</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia médica en anestesiología</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">麻酔医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en anestesiología</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em anestesiologia</skos:altLabel>
