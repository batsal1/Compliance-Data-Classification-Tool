    <skos:altLabel xml:lang="es-es">Negligencia en la extracción de sangre</skos:altLabel>
    <skos:definition>Phlebotomy Malpractice refers to a type of medical malpractice claim that arises from errors or negligence committed during the process of drawing blood from a patient.</skos:definition>
    <rdfs:label>Phlebotomy Malpractice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
