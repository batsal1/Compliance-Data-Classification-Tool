    <skos:altLabel xml:lang="en-gb">Deferral Agreement Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo de Diferimiento</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'accord de report</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Stundung von Vereinbarungen</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">猶予契約条項</skos:altLabel>
