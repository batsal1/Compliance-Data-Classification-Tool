  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDRT3PxWR7SGOSRucoSQNba">
    <skos:definition>Termination of public benefit refers to the cessation of financial assistance or services provided to an individual or family under a specific public benefit program. This can occur for various reasons, including exceeding income or asset limits, failing to meet ongoing eligibility requirements, or fraudulent activity, and generally requires formal notification and may offer an appeals process.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Termination of Public Benefit</rdfs:label>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9sWq4GZgSr0TD7iVfbCNtZ">
    <skos:definition>Cruise Ship Negligence refers to the legal concept of a cruise ship operator's failure to exercise reasonable care in ensuring the safety of its passengers, resulting in harm or injury to those passengers.</skos:definition>
    <skos:altLabel xml:lang="pt-br">Negligência em navios de cruzeiro</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">クルーズ船の過失</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit auf Kreuzfahrtschiffen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Cruise Ship Negligence</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en Cruceros</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">游轮疏忽</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות בספינות תענוגה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence sur les navires de croisière</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en Cruceros</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्रूज जहाज लापरवाही</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nd1000303d8904a36bea454350589e1e8"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWNAwJemBq0gDs7LXfCjnE"/>
    <rdfs:subClassOf rdf:nodeID="Ne3536dd6aa394b35968b6e32e5280007"/>
    <rdfs:label>Cruise Ship Negligence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RjGC9ag68KwoZVYSjOBbJI">
    <rdfs:label>Fixation in a Tangible Medium</rdfs:label>
    <skos:definition>Fixation in a Tangible Medium, a cornerstone of copyright law, requires that a work must be fixed in a medium of expression from which it can be perceived, reproduced, or otherwise communicated. This concept ensures that copyright protects not the idea itself but its expression in a form that can be physically or digitally captured and reproduced.</skos:definition>
    <skos:definition>Tangible Expression</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy"/>
    <skos:altLabel>Material Embodiment</skos:altLabel>
    <skos:prefLabel>Fixation</skos:prefLabel>
  </rdf:Description>
