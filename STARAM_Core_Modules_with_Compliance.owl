  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8QdULAkvnPR1GddKH1bDFa">
    <skos:altLabel xml:lang="en-gb">Intervening Event - Reasonable Foreseeable at Signing</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Événement intervenant - Raisonnablement prévisible lors de la signature</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Evento Interveniente - Razoavelmente previsível na assinatura</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">干预事件 - 在签署时合理可预见</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אירוע מתערב - ניתן לצפות בו בצורה סבירה בעת החתימה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हस्ताक्षर करने पर संभावित तर्कसंगत घटना - विधिगत</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Evento Interviniente - Razonablemente Previsible en la Firma</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Einschreitendes Ereignis - Zum Zeitpunkt der Unterzeichnung vernünftigerweise vorhersehbar</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Evento Interviniente - Razonablemente Previsible en la Firma</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">介入するイベント-署名時に合理的に予見可能</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7YcudBFwMUS1r7BcWje7Ly"/>
    <rdfs:label>Intervening Event - Reasonable Foreseeable at Signing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An "Intervening Event - Reasonable Foreseeable at Signing" refers to a circumstance that occurs after the signing of a legal agreement, which was reasonably foreseeable at the time of signing and may affect the terms of the agreement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/JCIrz7g3SPCsw1TVxFKW7g">
    <rdfs:label>Rolling and Drawing of Purchased Steel</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in rolling and/or drawing steel shapes, such as plate, sheet, strip, rod, and bar, from purchased steel.</skos:definition>
