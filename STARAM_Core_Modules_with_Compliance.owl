  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9ABG3dfhVDQUvRmg24IImI">
    <skos:altLabel xml:lang="es-mx">Quiebra del Capítulo 13 de los Estados Unidos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">US-Kapitel 13 Insolvenz</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Quiebra del Capítulo 13 de los Estados Unidos</skos:altLabel>
    <skos:altLabel>US Chapter 13</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">美国第13章破产</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">US Chapter 13 Bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falência do Capítulo 13 nos EUA</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faillite du chapitre 13 aux États-Unis</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דיונים בפשיטת רגל פרק 13 בארצות הברית</skos:altLabel>
    <skos:altLabel>Chapter 13</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">米国第13章破産</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यूएस चैप्टर 13 दिवाला</skos:altLabel>
    <skos:definition>In chapter 13 bankruptcy, or a 'wage earner plan', an individual that has regular income is allowed to develop a plan to pay back parts, or all, of their debts. One advantage of chapter 13 is it allows individuals to avoid foreclosure on their houses.</skos:definition>
    <skos:hiddenLabel>USCHAP13</skos:hiddenLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBnSXvwm8EPPRhNuxQD8avo"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Jo3gp8LjhpdJNXYE9ow95"/>
    <rdfs:subClassOf rdf:nodeID="N0219ce50b1f1467d974e058f2fb3b077"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Proc-B-USCHAP13</ns2:legacyIdentifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>US Chapter 13 Bankruptcy</rdfs:label>
    <dc:identifier>B-USCHAP13</dc:identifier>
  </rdf:Description>
