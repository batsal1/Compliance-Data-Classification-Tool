  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBEhDoiBEDPhk2x8xwQ1i6A">
    <skos:altLabel xml:lang="es-es">Cláusula de elección de sede</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בחירת מקום</skos:altLabel>
