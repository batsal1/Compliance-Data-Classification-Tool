    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Announcements Clause</rdfs:label>
    <skos:definition>An Announcements Clause is a provision in a contract that requires one or both parties to provide notice to the other party before taking certain actions or making certain announcements.</skos:definition>
  </rdf:Description>
