    <skos:altLabel xml:lang="hi-in">लेमन कानून दावे</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche aus dem Lemon Law</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations en vertu de la loi sur les véhicules défectueux</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות חוק הלימון</skos:altLabel>
    <rdfs:label>Lemon Law Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDgjhbmB7dyOPIvBHKksez6"/>
    <skos:definition>A Lemon Law Claim is a legal action taken by a consumer against a motor vehicle dealership or manufacturer for selling a defective vehicle that fails to meet the standards of quality and performance.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
