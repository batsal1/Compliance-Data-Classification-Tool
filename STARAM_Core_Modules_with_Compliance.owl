    <skos:altLabel xml:lang="es-mx">Reclamaciones estatutarias y regulatorias</skos:altLabel>
    <skos:altLabel>Statutory Civil Claims</skos:altLabel>
    <skos:altLabel>Statutory Claims</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות חוקיות ותקנותיות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações estatutárias e regulatórias</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Statutory and Regulatory Claims</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वैधानिक और विनियामक दावे</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法定および規制請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">法定和监管索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones estatutarias y regulatorias</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations légales et réglementaires</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche aus Gesetzen und Vorschriften</skos:altLabel>
    <skos:definition>Statutory and Regulatory Claims are legal claims that arise from violations of specific laws or regulations, such as the False Claims Act or the Health Insurance Portability and Accountability Act (HIPAA).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Statutory and Regulatory Claims</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDo81N034NYuEZm3nSNabUV">
    <skos:altLabel xml:lang="pt-br">Interferência em Relação Comercial Prospectiva</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interference with Prospective Business Relationship</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beeinträchtigung von Geschäftsbeziehungen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia con la Relación Comercial Prospectiva</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרעה בקשר עסקי צפוי</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Entrave aux relations commerciales</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्वानुमानित व्यापार संबंध में हस्तक्षेप</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">干扰预期商业关系</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">見込み商取引妨害</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia con la Relación Comercial Prospectiva</skos:altLabel>
    <rdfs:label>Interference with Prospective Business Relationship</rdfs:label>
    <skos:definition>The Interference with Prospective Business Relationship is the intentional or negligent interference with a party's potential economic advantage by a third party, causing harm to the party's business relationship.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCXmZbkCGNYfkmZHX1WWCqW"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDhvWIsvqcsGHZCNoyqb9OQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Regulatory Investigation</rdfs:label>
    <skos:altLabel>Compliance Investigation</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7"/>
    <rdfs:subClassOf rdf:nodeID="N226a5464c64b4758a6ce5c2c5f2ceed9"/>
    <rdfs:subClassOf rdf:nodeID="Ne93bee1b5e164d84bec5b0d25d7c560a"/>
    <skos:prefLabel>Regulatory Inquiry</skos:prefLabel>
    <skos:definition>A regulatory investigation is a formal inquiry conducted by a governmental or regulatory agency to examine whether laws, regulations, or industry standards have been violated. It aims to ensure compliance, enforce rules, and protect public interests in various sectors such as finance, healthcare, and environmental protection.</skos:definition>
  </rdf:Description>
