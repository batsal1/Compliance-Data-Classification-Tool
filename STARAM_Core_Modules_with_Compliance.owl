  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R-sT9wuPNQk2MgJvh6Q_vDQ">
    <skos:prefLabel>A115 Medical Record and Medical Bill Management</skos:prefLabel>
    <rdfs:label>A115 Medical Record and Medical Bill Management</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Any services associated with the review, compilation, digesting, summary or processing of medical records or bills when performed in-house only</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnTEPb_LCSNqAkQqrfte8zg"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RLIvW0w85MZ3NIl5JwPbbe">
    <skos:definition>A Paternity/Parentage Claim is a legal action brought to establish the identity of a child's biological father or mother, typically in the context of family law or matrimonial claims.</skos:definition>
    <skos:altLabel xml:lang="de-de">Vaterschaftsklage / Elternschaftsklage</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Action en paternité / filiation</skos:altLabel>
    <skos:altLabel>Parentage Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת הורות / הוריות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Paternity / Parentage Claim</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">父权 / 亲权索赔</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पितृत्व / मातृत्व दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de paternidad / filiación</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de paternidad / filiación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ação de paternidade / filiação</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">父親 / 親子関係の請求</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUXzL8Z4Ddh2CK6TBhofjU"/>
    <rdfs:subClassOf rdf:nodeID="N5e32e3e50d9746eca42ae662dd21a013"/>
    <rdfs:label>Paternity / Parentage Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Paternity Claim</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDqKmIZtUArhFb6sGnVoi16">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCX3HwOMFSz6vLwgDSWfkvt"/>
    <rdfs:subClassOf rdf:nodeID="Nac14a101669f4d3a9f43d1b52e47c185"/>
    <skos:prefLabel>Clothing and Equipment Claim</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A "Donning and Doffing Claim" is a legal term typically used in employment and labor law. It refers to a situation where employees claim that they should be compensated for the time spent putting on (donning) and taking off (doffing) specialized work attire or equipment required by their job, such as uniforms, safety gear, or tools. These claims often involve disputes over whether such activities should be considered part of the workday and eligible for compensation.</skos:definition>
    <rdfs:label>Donning and Doffing Claim</rdfs:label>
  </rdf:Description>
