  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8W0wmOCkGm2cd9BD6A5lrd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Consultor</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Consultor</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">コンサルタント</skos:altLabel>
    <skos:altLabel xml:lang="he-il">יועץ</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Consultor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">परामर्शदाता</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Berater</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Consultant</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">顾问</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Consultant</skos:altLabel>
    <skos:definition>One who gives professional advice or services in the field of that person's special knowledge or training, such as a consulting physician or engineer. Montgomery County v. MicroVote Corp., 175 F.3d 296 (3rd Cir. 1999)</skos:definition>
    <rdfs:label>Consultant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t7u58Bmu2hmFFto8S64nx"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8QA8463ZVLrPCfw6Jjdwd4">
    <skos:definition>Physical Asset Delivery refers to the settlement of a contract, financial instruments, or assets through the receipt or delivery of the actual underlying instruments instead of cash. This method is common in derivative contracts, where fulfilling the settlement obligation involves the transfer of the physical underlying asset.</skos:definition>
    <skos:altLabel>Actual Delivery</skos:altLabel>
    <skos:altLabel>Physically-Delivered Settlement</skos:altLabel>
    <skos:altLabel>Tangible Asset Settlement</skos:altLabel>
    <skos:altLabel>Underlying Instrument Delivery</skos:altLabel>
    <skos:altLabel>Physical Delivery Settlement</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSx31xBISrYHFCYIgupzdB"/>
    <rdfs:label>Physical Asset Delivery</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCvUeqSzQeb2dseyMDNAJxp">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rt7TTPXJ7WX1Jrjufs0Mdr"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Legatee</rdfs:label>
    <skos:altLabel>Personal Property Beneficiary</skos:altLabel>
    <skos:definition>A legatee is an individual or entity named in a will to receive personal property or money from the estate of the deceased. This term differentiates from a devisee, who inherits real property.</skos:definition>
  </rdf:Description>
