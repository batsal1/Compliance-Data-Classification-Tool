    <skos:altLabel xml:lang="ja-jp">機密保持条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de confidencialidad</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de confidentialité</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de confidencialidad</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertraulichkeitsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de confidencialidade</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סודיות</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A confidentiality clause is a provision in a contract that requires one or more parties to keep certain information confidential and not disclose it to others.</skos:definition>
    <rdfs:label>Confidentiality Clause</rdfs:label>
  </rdf:Description>
