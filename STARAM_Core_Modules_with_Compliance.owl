  <rdf:Description rdf:about="https://folio.openlegalstandard.org/AKbiNvq0SJquriQ5LfwLEw">
    <rdfs:label>Fish and Seafood Merchant Wholesalers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/BWPuh4YOSEqfI3IWii_ywQ"/>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of fish and seafood (except canned or packaged frozen).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424460"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9sxVMDOgOIRK17x5PGvWu4">
    <skos:definition>Right of Habitation</skos:definition>
    <skos:definition>In civil law jurisdictions, the Right of Property Habitation refers to a real right that allows an individual to reside in a dwelling for life or a specified period, without owning the property outright. This right is personal in nature and typically cannot be transferred, leased, or inherited, distinguishing it from more complete forms of ownership like fee simple or leasehold</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <rdfs:label>Property Right of Habitation</rdfs:label>
  </rdf:Description>
