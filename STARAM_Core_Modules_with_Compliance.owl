  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RehKvgKHQ6yqWnBYOfxzMO">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxq2qQYpdo9stHOBIQhub7"/>
    <rdfs:subClassOf rdf:nodeID="N2f272f8fea114a2693d03254d6c7cfaa"/>
    <rdfs:subClassOf rdf:nodeID="N2648023082e849f5bea29f050331312e"/>
    <rdfs:subClassOf rdf:nodeID="N7972c831ee9e48d2bb54d4ec7db09303"/>
    <rdfs:subClassOf rdf:nodeID="N1628eeb3a398433baf8a0b2c39d7a1be"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Clearing title refers to the process of resolving legal issues, claims, or encumbrances that could cloud the ownership status or legal rights associated with a particular property or piece of real estate. This process typically involves investigating and addressing any outstanding liens, disputes, or defects in the property's title to establish a clean and unambiguous ownership status. Clearing title is often necessary when buying or selling real estate to ensure that the buyer receives clear and marketable title to the property.</skos:definition>
    <rdfs:label>Clearing Title</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RzvrxtR6CPkYd2N1FZ4eJ9">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFXc2NtinmfJhHDBnbVgVN"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en-gb">Stay Execution of Judgment or Order</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Suspensión de la Ejecución de la Sentencia o la Orden</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फैसले या आदेश के अंदरूनी लागूता को रोकना</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Suspension de l'exécution d'un jugement ou d'une ordonnance</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">暂缓执行判决或命令</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Suspensión de la Ejecución de la Sentencia o la Orden</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">判決または命令の執行停止</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עיכוב בביצוע פסק דין או הוראה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Suspensão da Execução de Sentença ou Ordem</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फैसले या आदेश के अंदरूनी विधिक कार्य को रोकना</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Aufschub der Vollstreckung eines Urteils oder einer Anordnung</skos:altLabel>
    <rdfs:seeAlso>Vacatur</rdfs:seeAlso>
    <rdfs:label>Stay Execution of Judgment or Order</rdfs:label>
    <skos:definition>A Stay Execution of Judgment or Order is a legal concept that refers to a request made by a party to temporarily suspend the enforcement of a court's decision or order, typically while an appeal or other legal action is pending.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8fRbeigfBc3e17lwcgFHkD">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
