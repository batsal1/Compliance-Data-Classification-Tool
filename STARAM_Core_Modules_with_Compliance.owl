    <skos:altLabel xml:lang="de-de">Datenschutzklausel</skos:altLabel>
    <rdfs:label>Data Privacy Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Data Privacy Clause is a provision in a contract that outlines the obligations and rights of parties with respect to the collection, use, and protection of personal data.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/diWuW6jcRmyt0AiiCTgOlQ">
    <skos:example>Small arms and other ordnance manufacturing</skos:example>
