    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <skos:altLabel xml:lang="pt-br">Falência involuntária</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faillite involontaire</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非自愿破产</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unfreiwilliges Insolvenzverfahren</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自己破産</skos:altLabel>
    <rdfs:label>Involuntary Bankruptcy</rdfs:label>
    <skos:definition>Involuntary Bankruptcy refers to a legal process where creditors file a petition to force an individual or entity into bankruptcy, typically due to unpaid debts, and is a subcategory of the Bankruptcy and Financial Restructuring Practice.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
