    <skos:example>Parking garage construction</skos:example>
    <skos:example>Hospital construction</skos:example>
    <skos:example>Farm building construction</skos:example>
    <skos:example>Arena construction</skos:example>
    <skos:example>Restaurant construction</skos:example>
    <skos:example>Fire station construction</skos:example>
    <skos:example>Grain elevator or bin construction</skos:example>
    <skos:example>Indoor swimming facility construction</skos:example>
    <skos:example>Warehouse construction (e.g., commercial, industrial, manufacturing, private)</skos:example>
