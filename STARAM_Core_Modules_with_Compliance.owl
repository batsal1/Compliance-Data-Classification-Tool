  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDspRIwoJTlopUDjSgLRduf">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q7GJc1zsYT0P4Xdp6l9Oz"/>
    <skos:altLabel xml:lang="de-de">Anspruchselemente</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אלמנטים של טענה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Elementos de la Demanda</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Elementos da reivindicação</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दावे के तत्व</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Elementos de la Demanda</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Éléments de la demande</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">請求要素</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">要素要求</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Elements of Claim</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Elements of Claim</rdfs:label>
    <skos:definition>Elements of Claim: The essential components that must be proven in a legal action in order to establish a valid claim, including but not limited to the specific facts, legal theories, and evidence necessary to support the claim.</skos:definition>
  </rdf:Description>
