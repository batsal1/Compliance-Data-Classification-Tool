  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R2Q48cAXD981QF99sStHLf">
    <skos:altLabel xml:lang="hi-in">देरी किराया शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renta por demora</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">遅延家賃条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Verzugszinsen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שכירות עיכוב</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de alquiler por demora</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de aluguel em atraso</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de loyers différés</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Delay Rentals Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">滞纳金条款</skos:altLabel>
    <rdfs:label>Delay Rentals Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Delay Rentals Clause is a provision in a contract that requires one party to pay a specified amount of money to the other party if there is a delay in the performance of the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9NAqx3ulc9dcdzFyip2ZjU">
    <skos:altLabel xml:lang="es-mx">Cláusula de selección de foro</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בחירת פורום</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de juridiction</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Forum Selection Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">管轄選択条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फोरम चयन डिबेट</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de eleição de foro</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de selección de foro</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">论坛选择条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gerichtsstandsvereinbarung</skos:altLabel>
    <skos:definition>A forum selection clause is a contractual provision that designates a specific jurisdiction or court where any disputes arising from the contract will be resolved.</skos:definition>
    <rdfs:label>Forum Selection Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
