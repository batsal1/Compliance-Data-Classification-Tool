  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTvhgnc8JDUg9dP9sFve9K">
    <skos:definition>A European Call Option Style is a type of option contract that can only be exercised for a short, specified period just prior to its expiration, usually on a single day. This restriction contrasts with American-style options, which can be exercised at any time before expiration.</skos:definition>
    <skos:prefLabel>European-Style Call Option</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70"/>
