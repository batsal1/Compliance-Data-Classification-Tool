  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCb88Obc8Qsh6J0JJ3hy8Gj">
    <skos:altLabel xml:lang="zh-cn">违反默示的良好和工匠服务保证 - 住宅建筑</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">暗黙の保証違反 - 住宅建設における善良かつ熟練したサービス</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अच्छी और कुशल सेवाओं की निहित वारंटी का उल्लंघन - होम कंस्ट्रक्शन</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Good &amp; Workmanlike Services - Home Construction</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de la garantía implícita de servicios buenos y bien ejecutados - Construcción de viviendas</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de serviços bons e de qualidade - Construção de casa</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung für gute und fachgerechte Dienstleistungen - Hausbau</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de la garantía implícita de servicios buenos y bien ejecutados - Construcción de viviendas</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite de services bons et de qualité - Construction de maison</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת האחריות המשתלמת המשתלמת והמקצועית - בניית בית</skos:altLabel>
    <rdfs:label>Breach of Implied Warranty of Good &amp; Workmanlike Services - Home Construction</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCh6Oc8mbSkrdPsFW4zrL6F"/>
    <rdfs:subClassOf rdf:nodeID="N93e70116dea5417a8feb1a931d77ef0f"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Breach of Implied Warranty of Good &amp; Workmanlike Services in Home Construction refers to a violation of the implied promise that a contractor will provide services that meet industry standards and are of a quality that a reasonable person would expect in the construction of a home.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDdyFBvyLgKcKdg3zfvPAfw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
