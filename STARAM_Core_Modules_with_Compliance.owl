  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7kTIsHFUyjNAAK9Hh3xqmK">
    <skos:altLabel xml:lang="zh-cn">干涉合同权</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרעה בזכות החוזית</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ठेकेदारी अधिकार में हस्तक्षेप</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interference with Contractual Right</skos:altLabel>
    <skos:altLabel>Malicious Interference with Contract Rights</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約権の妨害</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Störung des Vertragsrechts</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia con el derecho contractual</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência no Direito Contratual</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation du droit contractuel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia con el derecho contractual</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFs8eqGTlY90gkX2NFNLTH"/>
    <rdfs:label>Interference with Contractual Right</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Interference with Contractual Right refers to the intentional and unjustified interference with a contractual relationship between two parties by a third party, causing harm or damages to one of the parties involved.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2f2a4973b2844414ae0abb67838c9663">
