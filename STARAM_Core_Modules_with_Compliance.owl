  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDG7lQkIHDmB4JptSZIEZNG">
    <skos:altLabel xml:lang="en-gb">Emotional Incapacity</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">情感无能力</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Incapacidade emocional</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incapacidad emocional</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Incapacité émotionnelle</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">感情的な無力</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אי יכולת רגשית</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भावनात्मक अशक्तता</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Emotionale Unfähigkeit</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incapacidad emocional</skos:altLabel>
    <skos:definition>Emotional incapacity refers to an individual's inability to manage or cope with their emotions effectively, often resulting in difficulty forming or maintaining relationships, making decisions, or participating in daily activities. Emotional incapacity may be considered in certain legal contexts, such as family law or mental health-related cases, to assess a person's competence or decision-making abilities.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDETD6YVYGhLGZbM1fBnsfj"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Emotional Incapacity</rdfs:label>
  </rdf:Description>
