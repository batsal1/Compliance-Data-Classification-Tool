    <skos:altLabel xml:lang="he-il">תמורה - מזומן ומניות מעורבים</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKXEdlGEMzeuinxEdRGBF5"/>
    <rdfs:label>Consideration - Mixed Cash and Stock</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <skos:definition>A mixed cash and stock consideration is a type of payment made in a legal matter that includes both cash and stock components.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
