  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8KRbvSFG2MLCQiR7x5ZvKl">
    <skos:altLabel xml:lang="zh-cn">原告的比较过失</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Culpa comparativa del demandante</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Comparative Fault of Plaintiff</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אשמת השוואה של התובע</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Culpa comparativa del demandante</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Culpa comparativa do autor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रतिकूल दायित्व वाले प्रतिवादी की तुलनात्मक दोष</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vergleichbares Verschulden des Klägers</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute comparative du demandeur</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">原告の比較過失</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rt4T1FlyWPLKcpZDSAspuG"/>
    <skos:definition>The concept of "Comparative Fault of Plaintiff" refers to the legal principle that allows a plaintiff's recovery to be reduced in proportion to their own degree of fault or negligence in causing their own injuries, as compared to the fault of the defendant.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Comparative Fault of Plaintiff</rdfs:label>
  </rdf:Description>
