  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RdJQsU95Vq3NCs4Q7326F5">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJL4HDUmZp1VEEZ7lCwSSF"/>
    <skos:altLabel xml:lang="he-il">התאגדות רעיונות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Appropriation d'idées</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विचार अनधिकृत उपयोग</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Apropriação indébita de ideias</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ideenunterschlagung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Apropiación indebida de ideas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">创意侵占</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Idea Misappropriation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Apropiación indebida de ideas</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">アイデア盗用</skos:altLabel>
    <rdfs:label>Idea Misappropriation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The unauthorized use or theft of someone else's original idea, without their permission or compensation, which can be claimed as a violation of intellectual property rights.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne8bdb42faae8459383e84d526063b2c4">
