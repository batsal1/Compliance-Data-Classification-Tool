  <rdf:Description rdf:about="https://folio.openlegalstandard.org/166174c1-c328-4e71-9217-0560024041f8cdb4012d-0575-4649-8a68-01de4d7443e7">
    <skos:definition>This concept prevents the maker of a promissory note and the acceptor of a bill of exchange payable to order from denying the payee's capacity to endorse the instrument in a suit by a holder in due course.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
