  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBguYnVVl5fmAxjW2p0fNkw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>High-end Market</skos:altLabel>
    <skos:altLabel>Premium Market Segment</skos:altLabel>
    <skos:altLabel>Luxury</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQbVKPVl5dj5nW6aXoNxx4"/>
    <skos:prefLabel>Premium Market</skos:prefLabel>
    <skos:example>Private Jet Services</skos:example>
    <skos:example>Gourmet Foods</skos:example>
    <skos:example>Yacht Manufacturer</skos:example>
    <rdfs:label>Luxury Market Segment</rdfs:label>
    <skos:definition>The luxury segment refers to a specific portion of the market that is characterized by consumers who seek high-end, premium products and services. This segment is associated with luxury goods that offer exclusivity, superior quality, and a high level of craftsmanship, catering to consumers who are willing to pay a premium for these attributes.</skos:definition>
  </rdf:Description>
