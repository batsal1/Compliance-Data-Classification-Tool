    <skos:altLabel xml:lang="zh-cn">实质上不公平允许合同撤销</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Substantive Unconscionability Permitting Contract Rescission</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Inconsciencia Substantiva Permitiendo la Rescisión del Contrato</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Inconsciencia Substantiva Permitiendo la Rescisión del Contrato</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वास्तविक अविवेकशीलता जो अनुबंध रद्दी की अनुमति देती है</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約解除を許可する実質的な不当性</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Iniquidade substancial permitindo a rescisão do contrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אי הגיון מוחלט המאפשר ביטול חוזה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Substantielle Unbilligkeit, die Vertragsrücktritt ermöglicht</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Iniquité substantielle permettant la résiliation du contrat</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A legal concept that refers to the presence of unfair or oppressive terms in a contract that allow for the contract to be cancelled or rescinded.</skos:definition>
    <rdfs:label>Substantive Unconscionability Permitting Contract Rescission</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8o77OqyndqK7R237rr61yE"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/14w2pAy-QWyJFZQKQ4bXxA">
    <skos:definition>This industry comprises government establishments primarily engaged in one or more of the following: (1) the administration, regulation, and enforcement of air and water resource programs; (2) the administration and regulation of solid waste management programs; (3) the administration and regulation of water and air pollution control and prevention programs; (4) the administration and regulation of flood control programs; (5) the administration and regulation of drainage development and water resource consumption programs; (6) the administration and regulation of toxic waste removal and cleanup programs; and (7) coordination of these activities at intergovernmental levels.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/0JTGodjHQ5WWOcSuPyuSRw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Water control and quality program administration, public administration</skos:example>
    <skos:example>Waste management program (except sanitation districts) administration, public administration</skos:example>
    <skos:example>Environmental protection program administration, public administration</skos:example>
    <skos:example>Pollution control program administration, public administration</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=924110"/>
    <rdfs:label>Administration of Air and Water Resource and Solid Waste Management Programs</rdfs:label>
  </rdf:Description>
