    <skos:altLabel xml:lang="zh-cn">胃肠病学疏忽</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em gastroenterologia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गैस्ट्रोएंटेरोलॉजी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en gastroenterología</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הזנחת גסטרואנטרולוגיה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence en gastro-entérologie</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Gastroenterology Negligence</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">消化器病学の過失</skos:altLabel>
    <skos:definition>Negligence in the field of gastroenterology, which involves the failure of a medical professional to provide the appropriate standard of care in the diagnosis, treatment, or management of gastrointestinal conditions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC7bLBSXzftkulSSqeDISss">
    <skos:altLabel xml:lang="es-es">Práctica de reuniones y comunicación con acreedores</skos:altLabel>
    <skos:altLabel>Creditor Meeting and Communication</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">债权人会议和沟通实践</skos:altLabel>
