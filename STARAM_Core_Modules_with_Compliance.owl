  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9A5MrBIsjK4fGFwdsUSQO0">
    <rdfs:label>Trade Agreements Act Claim</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nddbbe2e6f80441fdabe227a6e7ca8290"/>
    <rdfs:subClassOf rdf:nodeID="Nbe13e52e45d64fcaa57a71f2d2d5ca19"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <skos:altLabel xml:lang="de-de">Anspruch nach dem Handelsabkommen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">贸易协定索赔</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trade Agreements Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Acordos Comerciais</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק הסכמי מסחר</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यापार समझौते अधिनियम दावा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">貿易協定法主張</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de la Ley de Acuerdos Comerciales</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de l'accord commercial</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Acuerdos Comerciales</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Trade Agreements Act Claim is a legal claim made under the Trade Agreements Act statute, which requires that certain products purchased by the government be manufactured in the United States or in designated countries with which the US has trade agreements.</skos:definition>
  </rdf:Description>
