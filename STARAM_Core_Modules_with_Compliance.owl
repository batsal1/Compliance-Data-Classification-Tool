  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8o8R9PeSk7N1xIeNEkvOlS">
    <skos:altLabel xml:lang="de-de">Gebühren des Gerichtsreporters</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Frais du sténographe judiciaire</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">法院记录员费用</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Honorários do taquígrafo do tribunal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">裁判所記録係の費用</skos:altLabel>
    <skos:definition>Fees of Court Reporter: The charges incurred for the services provided by a court reporter, such as recording and transcribing court proceedings, which are included in the overall court costs.</skos:definition>
    <rdfs:label>Fees of Court Reporter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGrP50kf21RhCVFzDgipcp"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9rEOlPrMiUpUlQrMe18m1X">
    <skos:altLabel xml:lang="ja-jp">コストシフトと料金シフト</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Transferência de custos e transferência de honorários</skos:altLabel>
    <skos:altLabel xml:lang="he-il">העברת עלויות והעברת דמי עורכי דין</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Transfert de coûts et transfert de frais</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लागत शिफ्टिंग और फी शिफ्टिंग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Desplazamiento de costes y desplazamiento de honorarios</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kostenverlagerung und Gebührenverlagerung</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Cost Shifting and Fee Shifting</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">成本转移和费用转移</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Desplazamiento de costos y desplazamiento de honorarios</skos:altLabel>
    <rdfs:label>Cost Shifting and Fee Shifting</rdfs:label>
    <skos:definition>Cost Shifting and Fee Shifting refers to the legal practice of transferring the responsibility of paying litigation costs or attorney fees from one party to another, typically as a result of a court order or settlement agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/--siJUzaRTGX0W0PqH06lw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sg6ZiCdJPHi2EUyh7BiZf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry group comprises establishments primarily engaged in one of the following: (1) collecting, preparing, and delivering food for the needy; (2) providing short-term emergency shelter, temporary residential shelter, transitional housing, volunteer construction or repair of low-cost housing, and/or repair of homes for individuals or families in need; or (3) providing food, shelter, clothing, medical relief, resettlement, and counseling to victims of domestic or international disasters or conflicts (e.g., wars).</skos:definition>
    <rdfs:label>Community Food and Housing, and Emergency and Other Relief Services</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=6242"/>
  </rdf:Description>
