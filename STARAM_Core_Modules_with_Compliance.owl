  <rdf:Description rdf:about="https://folio.openlegalstandard.org/hncqZ2XEQgCapENT5DIm_A">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/awby5NefSmiuoZHrFnZZQg"/>
    <rdfs:label>Dairy Product (except Frozen) Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing dairy products (except frozen) from raw milk and/or processed milk products; (2) manufacturing dairy substitutes (except frozen) from soybeans and other nondairy substances; and (3) manufacturing dry, condensed, concentrated, and evaporated dairy and dairy substitute products.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=31151"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
