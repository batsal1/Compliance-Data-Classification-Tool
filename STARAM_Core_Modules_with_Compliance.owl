  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9MPprGb87PoCwsjs0PuCst">
    <skos:altLabel xml:lang="de-de">Bankfehler bei der Überweisung von Geldern</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Mauvaise gestion de transfert de fonds par la banque</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">銀行による資金移転の誤処理</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बैंक धन बंटवारे को गलत ढंग से संचालित करना</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bank Mishandling Funds Transfer</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Transferência de fundos mal gerenciada pelo banco</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Transferencia de fondos mal gestionada por el banco</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Transferencia de fondos mal gestionada por el banco</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">银行处理资金转移不当</skos:altLabel>
    <skos:altLabel xml:lang="he-il">העברת כספים שגויה על ידי הבנק</skos:altLabel>
    <skos:definition>Bank Mishandling Funds Transfer refers to a legal claim made by a creditor against a bank for improperly handling the transfer of funds, which may involve commercial paper and banking regulations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bank Mishandling Funds Transfer</rdfs:label>
  </rdf:Description>
