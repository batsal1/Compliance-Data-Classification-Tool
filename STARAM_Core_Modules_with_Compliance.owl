    <skos:altLabel xml:lang="en-gb">Future Medical Expenses</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">将来の医療費用</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भविष्य के चिकित्सा खर्च</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Gastos Médicos Futuros</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zukünftige medizinische Ausgaben</skos:altLabel>
    <skos:definition>Future Medical Expenses: Costs for medical treatment or care that are anticipated to be incurred by an individual at a later time due to an injury or illness.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Future Medical Expenses</rdfs:label>
  </rdf:Description>
