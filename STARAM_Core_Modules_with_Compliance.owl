  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9twyHb3yZtdEWn4hwBuoLk">
    <rdfs:label>Treatise</rdfs:label>
    <dc:source>Fed. R. Evid. 803(18)</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSEc3J4h5XdVfKKWBG7u08"/>
    <skos:definition>A treatise is a comprehensive and systematic written work that provides an in-depth analysis of a particular legal subject or area of law. It is often used as a reference by legal professionals and scholars to gain a deeper understanding of legal principles, case law, and statutory interpretations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Learned Treatise</skos:prefLabel>
  </rdf:Description>
