  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBW19bsnBOwINS8K601XYsz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>sali:attended</rdfs:label>
    <rdfs:label>attended</rdfs:label>
    <skos:altLabel>attended</skos:altLabel>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <skos:notation>folio:attended</skos:notation>
    <skos:definition>In a legal context, "attended" refers to the act of being present at a legal event, such as a court hearing, meeting, or negotiation. This presence, whether physical or virtual, signifies participation or observation in legal proceedings or discussions, which is often crucial for understanding, contributing to, or complying with legal processes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCQ8C2RHvj6SEiptxRWSg8L">
