  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RsHuW5MLfrGGruc6e9rJZC">
    <skos:definition>Material Adverse Effect (MAE) is a legal term that refers to a significant negative change or event that affects the financial condition, business operations, or assets of a company, and is used in legal agreements to define the circumstances under which a party can terminate or modify the agreement.</skos:definition>
    <skos:altLabel xml:lang="he-il">הגדרת השפעה שלילית חומרית</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">重大不利影响定义</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव की परिभाषा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition d'un effet défavorable important</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition eines wesentlichen nachteiligen Effekts</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Material Adverse Effect Definition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
  </rdf:Description>
