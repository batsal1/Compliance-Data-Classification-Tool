  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBw4nW47AeaVOJH6ZYLj3TU">
    <skos:prefLabel>Co-Conspirator</skos:prefLabel>
    <skos:note>Trump as unindicted co-conspirator: https://apnews.com/article/michigan-fake-electors-2020-election-1b65f10b04a7baedebfd5138ed5997e9</skos:note>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFgxBbypUKKsDDOJ1iOk36"/>
    <skos:definition>A Conspirator is an individual who participates in an agreement with one or more persons to commit an illegal act. The person actively engages in planning or executing the crime with others. Often, a Conspirator is not a Defendant (e.g., unindicted coconspirator).</skos:definition>
    <skos:altLabel>Schemer</skos:altLabel>
    <skos:altLabel>Plotter</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Conspirator</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nde0ef39e17a74ec58055a9f901758fbe">
