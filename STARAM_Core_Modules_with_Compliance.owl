    <skos:altLabel xml:lang="ja-jp">判決前利息</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vorprozessuale Zinsen</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Intérêts pré-judiciaires</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Juros pré-julgamento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ריבית לפני פסק דין</skos:altLabel>
    <rdfs:label>Pre-Judgment Interest</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2CEA5hNfHnNl8DMKIfK5F"/>
    <skos:definition>Pre-Judgment Interest refers to the interest that accrues on a monetary award from the time the cause of action arose until the judgment is entered, and is intended to compensate the plaintiff for the loss of use of the money during that period.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
