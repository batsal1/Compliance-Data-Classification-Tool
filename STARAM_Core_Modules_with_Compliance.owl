    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Tenth Amendment claim is a legal argument asserting that a federal action or law has violated the Tenth Amendment of the United States Constitution, which reserves powers not delegated to the federal government to the states or the people. Such claims typically involve disputes over the balance of power between federal and state governments and aim to protect state sovereignty and autonomy.</skos:definition>
  </rdf:Description>
