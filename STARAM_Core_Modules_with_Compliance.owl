  <rdf:Description rdf:nodeID="N20e1c8bcbd5f4e8f81c04bd1177df7aa">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBl2WJxJ69U7TybdQRUInbs"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
