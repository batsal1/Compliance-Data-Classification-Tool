    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBV3MQlbGLIUVo5fSiBZ2V4"/>
    <rdfs:label>Forfeiture Proceeding</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A forfeiture proceeding is a legal process in which the government seeks to take possession of property that is believed to have been used in or obtained through criminal activity.</skos:definition>
  </rdf:Description>
