  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDe37IpVB41x5rfauvnusv3">
    <skos:altLabel xml:lang="hi-in">क्लॉबैक प्रावधान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de recuperación</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">クローバック条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de récupération</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף החזר כפול</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Clawback Provision Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">收回条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rückforderungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de recuperação</skos:altLabel>
