  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R78P63bt8qx54WQ5xBdBOdm">
    <skos:definition>Nordic Law is a legal system found in Scandinavian countries, characterized by a blend of civil law principles with elements of customary and case law. It emphasizes codified statutes while also allowing judicial decisions to influence the interpretation and application of laws.</skos:definition>
    <rdfs:label>Nordic Law System</rdfs:label>
    <skos:prefLabel>Scandinavian Law</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ"/>
    <skos:altLabel>Northern European Law</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
