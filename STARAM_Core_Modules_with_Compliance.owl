  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC8uxZ3wNFtreIXMuXDmR6a">
    <rdfs:label>Principal’s/Promoter’s Bad Faith Liability for Real Estate Broker’s Commission</rdfs:label>
