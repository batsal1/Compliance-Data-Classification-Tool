    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rmo6lH3rho7iT8enAYSTSe"/>
    <skos:definition>A Severance Pay Clause is a provision in a contract that outlines the compensation an employee will receive upon termination of employment, typically due to layoffs or restructuring.</skos:definition>
  </rdf:Description>
