    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/CEjDss3RQsOiM2GQlgZ_PA"/>
    <skos:definition>This industry comprises establishments primarily engaged in the operation of timber tracts for the purpose of selling standing timber.</skos:definition>
    <rdfs:label>Timber Tract Operations</rdfs:label>
  </rdf:Description>
