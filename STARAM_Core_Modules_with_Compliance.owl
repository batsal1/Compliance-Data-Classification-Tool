  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RfVOK1xj9nh3Tk5dRZ5iN0">
    <skos:altLabel xml:lang="es-mx">Cláusula de proveedor exclusivo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de fornecedor exclusivo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">独家供应商条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक्सक्लूसिव आपूर्तिकर्ता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur exklusiven Lieferantenvereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Exclusive Supplier Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独占的なサプライヤー条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de fournisseur exclusif</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ספק בלעדי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de proveedor exclusivo</skos:altLabel>
    <skos:definition>An Exclusive Supplier Clause is a provision in a contract that grants one party the exclusive right to supply goods or services to another party, thereby prohibiting the other party from obtaining those goods or services from any other source.</skos:definition>
    <rdfs:label>Exclusive Supplier Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDgEiiX23zftUP0Mggfc68n"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBPeXt0dsiWqYS2ICgfvplu">
    <rdfs:label>Ambassador</rdfs:label>
    <skos:definition>An ambassador is a diplomatic representative who serves as the highest-ranking official of their home country's government in a foreign nation. The ambassador is responsible for managing diplomatic relations, representing their country's interests, and overseeing the activities of their nation's embassy or consulate in the host country.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD0eI0kZbrRDzdWWH6WoOGN"/>
  </rdf:Description>
