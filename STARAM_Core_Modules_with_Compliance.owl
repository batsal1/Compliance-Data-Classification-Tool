  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7OGr396bNkl4sseQ1bBCA6">
    <skos:altLabel xml:lang="he-il">זכות מעצר</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Lien</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">留置权</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pfandrecht</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लियन</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">抵当権</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Gravamen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Penhor</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lien</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Gravamen</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pQxz2fUIrk1LjvVP8hikg"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDKm1RXP9FfvhLzWjynAfpS"/>
    <rdfs:label>Lien</rdfs:label>
    <skos:definition>A lien is a legal claim or right that a creditor has over a debtor's property as security for a debt or obligation, which can be enforced through court action or other legal means.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RqvvHQUa3gfya33UyLlCqS">
    <skos:altLabel xml:lang="hi-in">गलत तरह से बंदी बनाना</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Emprisonnement illégal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不当拘束</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הכרעה שווא במעצר</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Falsche Inhaftierung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privación ilegal de la libertad</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">错误监禁</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">False Imprisonment</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prisão ilegal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Detención ilegal</skos:altLabel>
    <skos:definition>The concept of False Imprisonment refers to a tort claim where a person is unlawfully restrained or confined against their will, without any legal justification or authority.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>False Imprisonment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDqSn32zsjxExcBFzIYxT2D"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs"/>
  </rdf:Description>
