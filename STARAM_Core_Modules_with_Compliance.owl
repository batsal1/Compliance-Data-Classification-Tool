    <skos:altLabel>Biker</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A cyclist is a person who rides a bicycle, utilizing it for transportation, recreation, or competitive purposes on various types of terrain and roads. This includes adhering to specific traffic laws and cycling regulations to maintain safety and coordination with other road users.</skos:definition>
    <skos:prefLabel>Bicycle Rider</skos:prefLabel>
    <rdfs:label>Cyclist</rdfs:label>
  </rdf:Description>
