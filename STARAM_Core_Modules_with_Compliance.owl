    <skos:altLabel xml:lang="en-gb">Merger/Acquisition No-Vote</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विलय / अधिग्रहण नहीं-वोट</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצבעה נגד מיזוג / רכישה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合併/買収の否決</skos:altLabel>
