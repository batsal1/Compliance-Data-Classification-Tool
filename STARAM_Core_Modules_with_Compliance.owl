    <skos:scopeNote xml:lang="en">Relational risk head: assess it by comparing document components using epc:conflictsWith, epc:amends and epc:crossReferences, not by reviewing a single clause in isolation.</skos:scopeNote>
    <rdfs:label xml:lang="en">Conflicting Effective Dates Across Amendments</rdfs:label>
    <skos:prefLabel xml:lang="en">Conflicting Effective Dates Across Amendments</skos:prefLabel>
    <ns5:classificationMethod xml:lang="en">Category and serial number were taken directly from the source register. Drafting defect type, project phase and impact type were assigned automatically using keyword rules applied to the risk head name and its category.</ns5:classificationMethod>
    <skos:notation>RH-009</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="https://staram.in/ontology/epc/register"/>
  </rdf:Description>
