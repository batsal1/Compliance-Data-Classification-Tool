  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R79ZnCKDSoLOn17LGjAF6G6">
    <rdfs:label>Patent Subject-Matter Classifications</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rzy5rvrKtuL8AwKrBTFfBQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Patent Subject-Matter Classifications are a system of categorizing patents and patent applications based on the technical fields or subject matter they pertain to, such as chemical, mechanical, electrical, and life sciences. This classification system facilitates the organization, search, and examination of patents by grouping similar inventions together.</skos:definition>
  </rdf:Description>
