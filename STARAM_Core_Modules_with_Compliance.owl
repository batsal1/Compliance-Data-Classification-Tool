    <skos:altLabel>Conduct Violation</skos:altLabel>
    <skos:altLabel>Ethical Misconduct</skos:altLabel>
    <skos:altLabel>Professional Ethics Violation Claim</skos:altLabel>
    <skos:altLabel>Ethical Infraction</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Ethics Claim</rdfs:label>
  </rdf:Description>
