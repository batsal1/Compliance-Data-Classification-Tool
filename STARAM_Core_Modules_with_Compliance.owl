  <rdf:Description rdf:about="https://staram.in/ontology/compliance#ComplianceModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Compliance</rdfs:label>
    <rdfs:comment xml:lang="en">Module root for statutory compliance. Models every distinct, actionable legal compliance derived from a connected legislative corpus (Act, Rules, Regulations, Schedules, Forms, Notifications, Circulars) together with its actor, applicability, legal basis, timing, evidence, penalty, deterministic risk, classification and review status, following the Universal Legislation-to-Compliance Extraction Master Prompt. Existing STARAM/FOLIO entities that serve these roles are kept in their original branches and are additionally placed under this module.</rdfs:comment>
    <skos:altLabel xml:lang="en">Compliance (module root)</skos:altLabel>
    <skos:altLabel xml:lang="en">Compliance Module</skos:altLabel>
    <cmp:sourceRule>Universal Legislation-to-Compliance Extraction Master Prompt</cmp:sourceRule>
    <cmp:competencyQuestion xml:lang="en">WHO must act? (actor / legal addressee)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHAT must they do? (legal action and object)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHEN must they do it? (periodicity, relevant period, statutory due date, On Date)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">UNDER WHAT CONDITIONS must they do it? (applicability, thresholds, triggers, AND/OR logic)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHAT exceptions, exclusions or exemptions apply?</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">IN WHAT FORM or manner must they do it?</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">TO WHOM must they report, file, submit or pay? (statutory authority)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHAT evidence is generated or required? (attachment, proof of compliance)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHAT provision creates the penalty for failure, and what is the penalty?</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHAT risk follows from the penalty? (deterministic risk engine)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">UNDER WHICH provision(s) does the compliance arise? (Act, Section, Rule, Schedule, Notification)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">IS the obligation already represented elsewhere in the corpus? (duplicate / club / split)</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHICH law category, compliance nature, S/R/I classification and State apply?</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHICH compliances are flagged NEEDS_MASTER_REVIEW and why?</cmp:competencyQuestion>
    <cmp:competencyQuestion xml:lang="en">WHICH amendment, notification or circular inserted, substituted or modified the compliance?</cmp:competencyQuestion>
  </rdf:Description>
