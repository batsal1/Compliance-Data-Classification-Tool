  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCIktlKyYGqZda2w0eQsJNW">
    <skos:altLabel>Lower-Priority Creditor</skos:altLabel>
    <skos:altLabel>Junior Creditor</skos:altLabel>
    <skos:altLabel>Subordinated Lender</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7PHFZzZmVmczzNQl6iZKsa"/>
    <skos:definition>A Subordinated Creditor holds a claim or loan against a debtor that ranks below other debts in terms of repayment priority, often arising when creditors agree to lesser priority in exchange for potential higher returns. In bankruptcy, these creditors are paid only after senior debts have been settled, making their recovery prospects less certain.</skos:definition>
    <rdfs:label>Subordinated Creditor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neb722d3c32694eb09f593a4b4e12c12a">
