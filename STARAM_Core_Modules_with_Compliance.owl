    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:subClassOf rdf:nodeID="Ne2af3efbdc4f4241a7a94ccf3fcba554"/>
    <rdfs:subClassOf rdf:nodeID="N065cd42c12d04a908a7f1fda14003cbb"/>
    <rdfs:label>Consumer Contract Claims</rdfs:label>
    <skos:definition>Consumer Contract Claims are legal claims made by a party in a contract with a consumer, including claims related to billing errors, unlawful provisions, unconscionable circumstances, and improper actions by loan brokers.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7xjtdjCK8LoDNrx5EwqIJa">
    <skos:definition>A Data Security Clause is a provision in a contract that outlines the measures and responsibilities for protecting sensitive information from unauthorized access, use, disclosure, modification, or destruction.</skos:definition>
