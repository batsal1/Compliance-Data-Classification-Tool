    <skos:altLabel xml:lang="he-il">ראש ממשלתי לפרטיות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Leiter/in für Datenschutz</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Director de Privacidad</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Chief Privacy Officer</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">最高プライバシー責任者</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मुख्य गोपनीयता अधिकारी</skos:altLabel>
