    <skos:altLabel xml:lang="en-gb">Co-Branding Agreement</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">को-ब्रांडिंग समझौता</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם שיתוף מותגים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acuerdo de Co-Branding</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Acordo de co-branding</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de co-marquage</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同ブランディング契約</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de Co-Branding</skos:altLabel>
