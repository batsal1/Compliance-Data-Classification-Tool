  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ZQ0Km97U2Wut7s0UERyPR">
    <rdfs:label>Levy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDKm1RXP9FfvhLzWjynAfpS"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
    <rdfs:subClassOf rdf:nodeID="N9eb3e2b84800445a8405213693691f21"/>
    <skos:definition>A Levy is a legal seizure of property to satisfy a debt, usually initiated by a governmental authority such as the Internal Revenue Service (IRS) for unpaid taxes. The process involves officially taking possession of assets like bank accounts, wages, or physical property, and is typically executed after a court order or other legal authorization</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
