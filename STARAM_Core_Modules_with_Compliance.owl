  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8bgCR9HG0WR7RqfQHi45ET">
    <skos:altLabel xml:lang="fr-fr">Abstention plus jeune</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यंगर अब्स्टेंशन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Abstenção mais jovem</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">若手棄権</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Abstención de la jurisdicción por razones de conveniencia</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abstención de la jurisdicción por razones de conveniencia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Younger Abstention</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">年轻人弃权</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Jüngere Abstinenz</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פטור משפטי צעיר</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Younger Abstention</rdfs:label>
    <skos:definition>A legal doctrine known as Younger Abstention, which falls under the category of Abstention Doctrines, requires federal courts to abstain from hearing cases that involve ongoing state court proceedings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RuliWeVDE8CQi4AATMNab1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8uaHVA5sLFEVE1yOEiABIM">
    <skos:altLabel xml:lang="zh-cn">货车疏忽</skos:altLabel>
