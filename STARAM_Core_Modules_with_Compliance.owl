  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R83Ucy9EpZ0CdpCAKctT0N8">
    <skos:altLabel xml:lang="pt-br">Renúncia à cláusula de isenção de residência</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">豁免住所条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ホームステッド条項の放棄</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">होमस्टेड क्लॉज का इनकार</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Renuncia a la Cláusula de Protección de Hogar</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Renuncia a la Cláusula de Protección de Vivienda</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Renonciation à la clause d'exemption de résidence principale</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver of Homestead Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פטור מסעיף הבית המוגן</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzicht auf Homestead-Klausel</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Waiver of Homestead Clause is a legal provision that relinquishes the right to claim a homestead exemption in a property, typically used in mortgage agreements.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
    <rdfs:label>Waiver of Homestead Clause</rdfs:label>
