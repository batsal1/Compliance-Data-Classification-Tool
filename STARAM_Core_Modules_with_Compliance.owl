  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R76qvSDUqHT3U3jz0wOw1y1">
    <skos:definition>The use of an electric or electronic communications facility to intentionally transmit a false and/or deceptive message in furtherance of a fraudulent activity.</skos:definition>
    <skos:altLabel xml:lang="zh-cn">电信诈骗</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fraude por transferencia electrónica</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Wire Fraud</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betrug per Draht</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude par fil</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fraude eletrônica</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הונאת חוטים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वायर धोखाधड़ी</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fraude por transferencia electrónica</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">電線詐欺</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5ks6eYBkfLh4Fgv1Zusal"/>
