  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBtPRWx3uk0VHvFqhjk6354">
    <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-建設的な知識-役割ベースの言語</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de l'effet indésirable matériel - Connaissance constructive - Langage basé sur les rôles</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Conhecimento Construtivo - Linguagem Baseada em Funções</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition des wesentlichen nachteiligen Effekts - Konstruktives Wissen - Rollenbasierte Sprache</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - "निर्माणात्मक ज्ञान - भूमिका आधारित" भाषा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - "Constructive Knowledge - Role-based" Language</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת פגיעה חומרית משמעותית - שפת "ידע בונה - מבוססת תפקיד"</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Lenguaje de "Conocimiento Constructivo - Basado en Roles"</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Lenguaje de "Conocimiento Constructivo - Basado en Roles"</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">实质不利影响定义 - 建设性知识 - 基于角色的语言</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>"Constructive Knowledge - Role-based" Language</rdfs:label>
    <rdfs:label>Material Adverse Effect Definition - "Constructive Knowledge - Role-based" Language</rdfs:label>
    <skos:definition>A Material Adverse Effect (MAE) is a legal term that refers to a negative change or event that has a significant impact on a party's ability to fulfill their obligations under a contract or agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCrshoNA9Tc4Xswrj0v8nqX"/>
  </rdf:Description>
