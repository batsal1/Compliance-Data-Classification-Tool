  <rdf:Description rdf:about="https://folio.openlegalstandard.org/aHmszoloS-yGNU0lp8sTYg">
    <skos:definition>This industry comprises establishments primarily engaged in retailing new and used motorcycles, boats, and other vehicles (except automobiles, light trucks, and recreational vehicles), or retailing these new vehicles in combination with activities, such as repair services and selling replacement parts and accessories.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/4rtApGTMRZmzNeItpwQvRA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=44122"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Boat dealers, new and used</skos:example>
    <skos:example>Motorcycle dealers</skos:example>
    <skos:example>Aircraft dealers</skos:example>
    <skos:example>All-terrain vehicle (ATV) dealers</skos:example>
    <skos:example>Utility trailer dealers</skos:example>
    <rdfs:label>Motorcycle, Boat, and Other Motor Vehicle Dealers</rdfs:label>
  </rdf:Description>
