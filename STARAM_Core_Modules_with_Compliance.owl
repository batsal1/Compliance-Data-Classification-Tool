  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ItOPdbcc8mA2sYecRl3cu">
    <rdfs:label>Criminal Incarceration</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Criminal Incarceration</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Encarceramento criminal</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Encarcelamiento Criminal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הכלאה הפלילית</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">刑事监禁</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Strafhaft</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Incarcération criminelle</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">刑務所収容</skos:altLabel>
