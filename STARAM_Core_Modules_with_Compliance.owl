  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7x6g9iAXmUiJlXphvLtQcO">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
    <rdfs:subClassOf rdf:nodeID="N9517e2607133436996f1aa3b21935167"/>
    <skos:altLabel>Court-Ordered Damages Increase</skos:altLabel>
    <skos:altLabel>Enhanced Damages Award</skos:altLabel>
    <skos:altLabel>Judicial Increase In Damages</skos:altLabel>
    <rdfs:label>Additur</rdfs:label>
    <skos:definition>Additur refers to a court's power to increase the amount of damages awarded by a jury if the judge finds the award insufficient. This practice is primarily used in the United States and is not recognized in federal courts due to constitutional concerns regarding the Seventh Amendment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBisl4Hku74Euy3AAAODOj2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Paroled Refugee is an individual who has been allowed entry into a country on a temporary basis for urgent humanitarian reasons or significant public benefit, even though they do not meet the regular admission requirements for refugees. This status provides temporary legal presence in the host country while the individual’s case is reviewed or until more permanent arrangements can be made.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UYJUZ3D37DD8nEuNUXXti"/>
    <skos:altLabel>Humanitarian Parolee</skos:altLabel>
    <rdfs:label>Paroled Refugee</rdfs:label>
  </rdf:Description>
