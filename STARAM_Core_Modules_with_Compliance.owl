  <rdf:Description rdf:about="https://folio.openlegalstandard.org/z3eGBnnvTVCJueg7ceHZdQ">
    <rdfs:label>Radio and Television Broadcasting Stations</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry group comprises establishments operating radio or television broadcasting stations for the programming and transmission of programs to the public. Programming may originate in their own studio, from an affiliated network, or from external sources.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5161"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9YFJkZPmIaTVmf1YJ89hSq"/>
  </rdf:Description>
