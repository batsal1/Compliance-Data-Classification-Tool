    <skos:altLabel xml:lang="he-il">תביעה על פי חוק הגנת פרטיות הנהגים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Drivers Privacy Protection Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Protección de la Privacidad de los Conductores</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Protección de la Privacidad de los Conductores</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">驾驶员隐私保护法索赔</skos:altLabel>
