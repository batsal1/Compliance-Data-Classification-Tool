    <skos:definition>The term BILLING_START_DATE refers to the date on which a billing period begins, as defined in the LEDES98BI V5 Format Rev 1-2020 standard for electronic legal invoicing.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RFanQiAnBUnqQS4PNIuJao">
    <skos:altLabel xml:lang="hi-in">विस्तार अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Extensión</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Erweiterungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הארכה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Extension Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Extensão</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'extension</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">拡張条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Extensión</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">扩展条款</skos:altLabel>
    <skos:definition>An Extension Clause is a provision in a contract that allows for the continuation of the agreement beyond its original term.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Extension Clause</rdfs:label>
