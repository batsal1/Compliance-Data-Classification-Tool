    <skos:definition xml:lang="en">Risk relating to money, covering whether the contract price is sufficient, the amount and finality of termination payments, shortfalls in insurance cover, and security instruments.</skos:definition>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#AllocationRiskTaxonomy"/>
    <skos:notation>AL-4</skos:notation>
