    <rdfs:label>Unlawful Gaming and Lotteries</rdfs:label>
    <skos:definition>Unlawful Gaming and Lotteries refers to the illegal act of participating in games of chance or lotteries that are not authorized by law, and is considered a crime against the public.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBYu7mrAChLYwfT9Szd5d2x">
