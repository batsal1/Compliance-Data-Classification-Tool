  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCszNUWTj3EZU1PyqBZGakC">
    <skos:altLabel xml:lang="es-mx">Negligencia de la partera</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Midwife Negligence</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence de la sage-femme</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia de la comadrona</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hebammenpflichtverletzung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">助产士疏忽</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência da parteira</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובתה של המיילדת</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">助産師の過失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दाई लापरवाही</skos:altLabel>
    <rdfs:label>Midwife Negligence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <skos:definition>Negligent actions or omissions by a midwife during the provision of care to a mother and/or baby, resulting in harm or injury, and giving rise to a legal claim for compensation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ruiy0zsIf3NYCzYWb5tsLa">
    <rdfs:subClassOf rdf:nodeID="N53f43ab25b384cc792a75e46265460a8"/>
    <rdfs:subClassOf rdf:nodeID="N708086a97e574e10bc5c968ba94c3399"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Voter</rdfs:label>
    <skos:definition>A voter, also known as an Elector, is an individual who is eligible to vote in an election. This term can also refer to a member of an electoral college, who has the formal responsibility to cast votes for the selection of certain public officials, such as the President of the United States.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Registered Voter</skos:altLabel>
    <skos:altLabel>Eligible Voter</skos:altLabel>
    <skos:altLabel>Constituency Member</skos:altLabel>
    <skos:prefLabel>Elector</skos:prefLabel>
  </rdf:Description>
