    <skos:altLabel xml:lang="ja-jp">独占禁止法 - 結合主張</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反垄断 - 捆绑索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wettbewerbsbeschränkung - Koppelungsvorwürfe</skos:altLabel>
