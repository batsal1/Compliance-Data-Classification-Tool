    <skos:altLabel xml:lang="ja-jp">プロバイダータイムキーパーレベル</skos:altLabel>
    <skos:altLabel xml:lang="he-il">רמת מדי זמן של תורם</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रदाता समय रखरखाव स्तर</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anbieter-Zeitnehmer-Ebene</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Provider Timekeeper Level</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Niveau de chronométreur de fournisseur</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7tihKK0L440nkLIrRcdCkh"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Provider Timekeeper Level refers to the classification of legal service providers based on their level of expertise and experience, including paralegals, lawyers, and limited license legal technicians (LLLTs).</skos:definition>
    <rdfs:label>Provider Timekeeper Level</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncb07088a8d0445e7b1f302c7aca1bbf2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
