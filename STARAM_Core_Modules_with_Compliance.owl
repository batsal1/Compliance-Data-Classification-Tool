    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Permission refers to the formal consent or authorization granted by an authority, allowing an individual or entity to perform a certain action that would otherwise be illegal or against the rules.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RClhbl4E1TJp9LygIXewIhn"/>
