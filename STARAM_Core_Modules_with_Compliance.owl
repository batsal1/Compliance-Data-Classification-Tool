  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R91HsPtyqfSCi9kIWxQX8p">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3bd7cR1Bts9PPsYe8AyFi"/>
    <skos:altLabel xml:lang="ja-jp">メンバー死亡条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de décès d'un membre</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Fallecimiento de un Miembro</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מוות של חבר</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Fallecimiento de un Miembro</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zum Tod eines Mitglieds</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सदस्य की मृत्यु धारा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">成员死亡条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de morte de um membro</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Death of A Member Clause</skos:altLabel>
    <skos:definition>A Death of A Member Clause is a provision in a legal document that outlines the consequences and procedures to be followed in the event of the death of a specific member of a group or organization.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Death of A Member Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTVkevOi2bFkhjrdwtSpBs">
    <skos:altLabel xml:lang="de-de">Einschließlich ohne Einschränkungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">制限なし条項を含む</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Inclusión Sin Limitación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'inclusion sans limitation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף כולל ללא הגבלה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Including Without Limitation Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">包括无限制条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सीमा के बिना समेत क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de inclusão sem limitação</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Inclusión Sin Limitación</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>An "Including Without Limitation Clause" is a provision in a contract that clarifies that the listed items are not an exhaustive list and that other items may also be included.</skos:definition>
    <rdfs:label>Including Without Limitation Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/nHlbwZaXTimMtAZGrwl0Yw">
    <skos:example>Independent art restorers</skos:example>
    <skos:example>Independent cartoonists</skos:example>
    <skos:example>Independent dancers</skos:example>
    <skos:example>Independent recording technicians</skos:example>
    <skos:example>Independent technical writers</skos:example>
    <skos:example>Independent theatrical costume designers</skos:example>
    <skos:example>Independent producers</skos:example>
    <skos:example>Independent theatrical lighting technicians</skos:example>
    <skos:example>Independent journalists</skos:example>
    <skos:example>Independent speakers</skos:example>
    <skos:example>Independent artists (except musical, commercial, medical)</skos:example>
    <skos:example>Independent actors or actresses</skos:example>
    <skos:definition>This industry comprises independent (i.e., freelance) individuals primarily engaged in performing in artistic productions, in creating artistic and cultural works or productions, or in providing technical expertise necessary for these productions. This industry also includes athletes and other celebrities exclusively engaged in endorsing products and making speeches or public appearances for which they receive a fee.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=711510"/>
    <rdfs:label>Independent Artists, Writers, and Performers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/6GjQ1MBXRxeI8N0qMlyEPg"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N73a45b5756c24e23a728e28eb7903f81">
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8a69mb9gzRyUSQsZdwSiA8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8xskhmQUaxebZTP4l8HAw4">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV"/>
    <skos:altLabel xml:lang="es-mx">Mayor riesgo de daño</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סיכון גבוה יותר לפגיעה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">被害の増加リスク</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Increased Risk of Harm</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हानि का बढ़ता खतरा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Risque accru de préjudice</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Mayor riesgo de daño</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Erhöhtes Risiko von Schäden</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">增加的危害风险</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Risco aumentado de dano</skos:altLabel>
    <rdfs:label>Increased Risk of Harm</rdfs:label>
    <skos:definition>Increased Risk of Harm: A legal concept that refers to the likelihood of harm or injury occurring in the future as a result of a defendant's actions or negligence, even if the harm has not yet occurred.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7mshiJbRkzS94zhlvnkwK6">
    <skos:altLabel>Objection to Disputatious Question</skos:altLabel>
    <skos:altLabel>Confrontational Question Objection</skos:altLabel>
    <skos:altLabel>Provocative Inquiry Objection</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBMlUtTtbQUQxrZrkeF8Fpm"/>
    <skos:prefLabel>Badgering</skos:prefLabel>
    <rdfs:label>Argumentative Objection</rdfs:label>
    <skos:definition>An Argumentative Objection is raised when a party in a legal proceeding believes that a question posed by the opposing counsel is designed to provoke an argument rather than elicit factual information. This objection seeks to maintain the proceeding's decorum, ensuring that questions are neutral and focused on obtaining relevant evidence.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>Fed. R. Evid. 611(a)</dc:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1953811a1a2c4bc28f06478782887078">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermPermittedAcquisitions"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDk3UTfEayPKDVhy9Disg52">
    <skos:altLabel xml:lang="fr-fr">Processeur</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Procesador</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">プロセッサ</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Processor</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Prozessor</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Processador</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Procesador</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">处理器</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रोसेसर</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעבד</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74IJAT8MHMqUZeBJR7txV1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>"Processor" Definition</rdfs:label>
