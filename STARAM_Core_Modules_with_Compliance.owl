  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB7s65L4gymOdYbTVr3onXt">
    <skos:altLabel xml:lang="he-il">זכות למשפט עם לועזים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">陪审团审判权</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Recht auf ein Geschworenengericht</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">陪審裁判権</skos:altLabel>
    <skos:altLabel>Trial by Jury Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito a um julgamento por júri</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit à un procès devant un jury</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right to a Jury Trial</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ज्यूरी ट्रायल का अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Derecho a un juicio por jurado</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho a un juicio por jurado</skos:altLabel>
    <rdfs:label>Right to a Jury Trial</rdfs:label>
    <rdfs:seeAlso>The right to a jury trial is a legal principle that guarantees an individual facing criminal charges the opportunity to have their case decided by a group of impartial citizens, typically selected from the community. In the United States, this right is protected by the Sixth Amendment to the Constitution and applies to federal cases, as well as state cases under the Fourteenth Amendment's due process clause.</rdfs:seeAlso>
    <rdfs:subClassOf rdf:nodeID="Nc5818a4eb8614611ac28cd61fb1a0a29"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQRg4Bv481hOyPBNKLCj8m"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9DvHEUtANGcKLft0SFDni4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#ConfidentialInformation">
