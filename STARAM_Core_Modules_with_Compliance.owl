    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises American Indian and Alaska Native governing bodies. Establishments in this industry perform legislative, judicial, and administrative functions for their American Indian and Alaska Native lands. Included in this industry are American Indian and Alaska Native councils, courts, and law enforcement bodies.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=921150"/>
    <rdfs:label>American Indian and Alaska Native Tribal Governments</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/AknsKLe4T9u7mEk5DTxIfA"/>
  </rdf:Description>
