    <skos:altLabel xml:lang="he-il">תקופת זכויות התאמה ראשונית</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">初始匹配权期</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Período de Direitos de Correspondência Inicial</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Période de droits de correspondance initiale</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zeitraum für das initiale Matching-Recht</skos:altLabel>
    <rdfs:label>Initial Matching Rights Period</rdfs:label>
    <skos:definition>The Initial Matching Rights Period refers to the specific period of time at the beginning of a Matching Rights Period during which a party has the right to match any offer made by a third party to purchase a particular asset or property.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGwortSox0oBPyp9H9dcEw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
