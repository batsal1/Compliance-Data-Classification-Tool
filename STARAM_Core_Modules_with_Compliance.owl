    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Equity Distribution Agreement is an agreement between a company and a distribution agent detailing the terms and conditions under which the company's equity securities may be sold or distributed to the public or private investors.</skos:definition>
    <rdfs:label>Equity Distribution Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Supply, Manufacturing &amp; Distribution</ns1:contractFamily>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7TUl56ig2yKtcpa1sarAdH">
    <skos:altLabel xml:lang="hi-in">डिजाइन दोष</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">设计缺陷</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Konstruktionsfehler</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגם תכנון</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Defeito de projeto</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaut de conception</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Defecto de diseño</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">設計上の欠陥</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Defecto de diseño</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Design Defect</skos:altLabel>
    <rdfs:label>Design Defect</rdfs:label>
    <skos:definition>A design defect is a legal concept within strict product liability that refers to a flaw in the design of a product that makes it unreasonably dangerous for its intended use.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8p15egW5el3Go9V1L4obop"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDXUybCuh7RaAROZhhNF1wL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>matter_total_detail_fees</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCdJG6uCwl9vj0GwxJe7mez"/>
    <skos:definition>"Sum of all FEE.total_amounts billed to this matter/invoice.  
"</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb82865f07ab5480d9cbaa9bfff887466">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TimeIsOfTheEssence"/>
