    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Responses to Claims refer to the various legal actions taken by a party in response to a claim made against them, including denial, counterclaim, and admission.</skos:definition>
    <rdfs:label>Responses to Claims</rdfs:label>
  </rdf:Description>
