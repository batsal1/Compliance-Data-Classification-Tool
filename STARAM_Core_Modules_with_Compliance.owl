  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBartzGrOte2TVksxcDR8iH">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Birth Parent</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9EOkKjFMzLEwh7coNAwXjX"/>
    <dc:source>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</dc:source>
    <rdfs:label>Biological Parent</rdfs:label>
    <skos:definition>A Biological Parent, also known as a birth parent, is an individual from whom a child inherits their genetic material. This refers to the mother, from whom a child is born, and the father, who contributes to the child's conception, distinguishing them from adoptive or step-parents.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5jvQ_BLqSuyuZL93vGTi4A">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R2etzY8EzTfSM3lnjARkdpg"/>
    <skos:prefLabel>P260 Intellectual Property</skos:prefLabel>
    <skos:definition>This task includes all fact investigation/due diligence from an intellectual property (patent, trademarks, copyrights) perspective.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>P260 Intellectual Property</rdfs:label>
  </rdf:Description>
