  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCH6QfDmL0LVgc1n4uJvwKk">
    <skos:definition>Recognition of foreign insolvency involves a domestic court acknowledging and giving effect to an insolvency proceeding initiated in another country. This legal process facilitates cooperation between jurisdictions, enabling efficient administration and resolution of cross-border insolvency cases.</skos:definition>
    <rdfs:label>Recognition of Foreign Insolvency</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs"/>
  </rdf:Description>
