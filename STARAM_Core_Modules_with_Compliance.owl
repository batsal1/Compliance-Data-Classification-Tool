  <rdf:Description rdf:about="https://folio.openlegalstandard.org/yItUS00QRmee_d_m5cptMQ">
    <skos:example>Electronic funds transfer services, including peer-to-peer payment services</skos:example>
    <skos:example>Automated clearinghouses, bank or check (except central bank)</skos:example>
    <skos:example>Check clearing services (except central bank)</skos:example>
    <skos:example>Credit card processing services</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/rjaaDbt8RO65Jhr9DNSzNw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=522320"/>
    <rdfs:label>Financial Transactions Processing, Reserve, and Clearinghouse Activities Industry</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in providing one or more of the following: (1) financial transaction processing (except central bank); (2) reserve and liquidity services (except central bank); and/or (3) check or other financial instrument clearinghouse services (except central bank).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9FDZSAiMlqHEjuoXH0WV29">
    <skos:altLabel xml:lang="hi-in">आवास के लिए हस्ताक्षरित नेगोशिएबल इंस्ट्रुमेंट</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">为担保签署的票据</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Begünstigte Orderpapiere</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כלי כתיבה נגושיים חתום למטרת ייחוס</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保証のために署名された交換手形</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negotiable Instrument Signed for Accommodation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Instrumento Negociable Firmado por Alojamiento</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Instrumento Negociable Firmado por Alojamiento</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Instrumento Negociável Assinado para Acomodação</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Effets de commerce signés pour l'hébergement</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A negotiable instrument signed for accommodation is a type of commercial paper that is endorsed by a third party as a favor to the borrower, and is used as a means of obtaining credit or financing.</skos:definition>
    <rdfs:label>Negotiable Instrument Signed for Accommodation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/FZ96mGGURwGgM8lCvKvnnA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=484121"/>
    <rdfs:label>General Freight Trucking, Long-Distance, Truckload</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/5a3MB0kHRTK6yiNRFYKcjQ"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing long-distance general freight truckload (TL) trucking. These long-distance general freight truckload carrier establishments provide full truck movement of freight from origin to destination. The shipment of freight on a truck is characterized as a full single load not combined with other shipments.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RV2ZQoSTHhim67C40O9xPo">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3"/>
    <skos:altLabel xml:lang="ja-jp">商業歩道での転倒に対する請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação por queda em calçada comercial</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על נפילה במדרכה מסחרית</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业人行道上跌倒索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour chute sur un trottoir commercial</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Sturz auf einem kommerziellen Gehweg</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वाणिज्यिक ट्रोटवे पर गिरने के दावे के लिए</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por caída en acera comercial</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Claim for Falling on Commercial Sidewalk</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por caída en acera comercial</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A claim for falling on a commercial sidewalk is a legal action brought by an individual who has suffered injuries due to a slip-and-fall accident caused by the negligence of a commercial property owner.</skos:definition>
    <rdfs:label>Claim for Falling on Commercial Sidewalk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2d4d29c776644014b71f544c0ad1734d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
