  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7MYwAlvWYNhF8Ai1QGKY3J">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Objection to Privileged Evidence</skos:altLabel>
    <skos:altLabel>Protected Communication Objection</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Bk5v9AAJmhb4WcgIQjy29"/>
    <rdfs:subClassOf rdf:nodeID="N68004d75194b4a8d8c6d3d6916b01104"/>
    <rdfs:label>Privilege Objection</rdfs:label>
    <skos:definition>A Privilege Objection is raised when a party in a legal proceeding believes that the evidence being sought or presented is protected by a legal privilege, such as attorney-client privilege or spousal privilege. This objection seeks to uphold the confidentiality and integrity of certain relationships, preventing the disclosure of privileged communications.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RJ1zSdR52W8L2gNWWyqMuI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-mx">Cláusula de Modificación del Contrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שינוי חוזה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Modificación del Contrato</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de modificação do contrato</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Contract Amendment Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約変更条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsänderungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध संशोधन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同修改条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de modification de contrat</skos:altLabel>
    <rdfs:label>Contract Modification Clause</rdfs:label>
    <skos:definition>A contract modification clause is a provision in a contract that allows for changes to be made to the original agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCDpHB1Jd3pFWbgGl1ioIDF">
    <skos:altLabel>Multiple Non-Transferable Vote</skos:altLabel>
    <skos:altLabel>Multi-Winner Plurality System</skos:altLabel>
    <skos:altLabel>Plurality Block Voting</skos:altLabel>
    <skos:prefLabel>Block Voting System</skos:prefLabel>
    <skos:definition>The plurality-at-large electoral system, also known as block voting or plurality block voting, is a multi-winner voting method where each voter can cast as many votes as there are seats to be filled, and the candidates with the highest number of votes win. This system is often used in local elections and can result in the overrepresentation of the majority group.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RV8mJWGZnQhe2gDARKvAiF"/>
    <rdfs:label>Plurality-at-Large Electoral System</rdfs:label>
    <dc:source rdf:resource="https://en.wikipedia.org/wiki/Plurality_block_voting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
