  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBWTNMvqynzbuBEvo2wGHe7">
    <skos:altLabel xml:lang="en-gb">Securities Law Claims</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">証券法クレーム</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सुरक्षा कानून दावे</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות חוק ניירות ערך</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations en droit des valeurs mobilières</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de derecho de valores</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de direito de valores mobiliários</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">证券法索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche aus Wertpapierrecht</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones de derecho de valores</skos:altLabel>
    <skos:definition>Securities Law Claims refer to legal claims arising from violations of laws and regulations related to securities, such as buying securities improperly during a corporate takeover or committing securities fraud.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nc1f3b5068c30467abcdf32b728b735dd"/>
    <rdfs:subClassOf rdf:nodeID="Nee35adb5188d4e97874e800722a24fbd"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:subClassOf rdf:nodeID="Nb831e7e60f42456e8587357566a4df9e"/>
    <rdfs:subClassOf rdf:nodeID="Na2a36d703feb4d5a93c890a901fb6b14"/>
    <rdfs:label>Securities Law Claims</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8NkyPiBO4cDYNheqxFYHqF">
    <skos:altLabel xml:lang="es-es">Reclamación de libertad de asociación</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">結社の自由の主張</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">结社自由权利主张</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de la liberté d'association</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת חופש הקישור</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Freedom of Association Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संघर्ष की स्वतंत्रता दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de libertad de asociación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da liberdade de associação</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Vereinigungsfreiheit</skos:altLabel>
    <skos:definition>A freedom of association claim is a legal action initiated by an individual or group alleging that their right to freedom of association, as protected by the First Amendment of the United States Constitution, has been violated by the government or a government actor. The First Amendment guarantees the right to associate with others for the expression of ideas, beliefs, and collective action, including the right to form and join groups and organizations. A freedom of association claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts the right to associate or form organizations, when a government actor interferes with the right to join or participate in a group or organization, or when an individual or group is discriminated against or punished based on their association with a particular group or organization.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8vAEBB4vqpklciwq0MiMSa"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UZkDXz7Wg2AtyHFQEeySC"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Freedom of Association</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCPzgUvmfPZ0spb7uALcBe0">
    <skos:definition>Agent's Negligence Causing Harm to Others: The legal concept where an individual or entity is held responsible for causing harm or injury to another person or entity due to their failure to exercise reasonable care or caution.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="ja-jp">代理人の過失による他者への被害</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एजेंट की लापरवाही से दूसरों को हानि पहुंचना</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence de l'agent causant un préjudice à autrui</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência do agente causando dano a terceiros</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">代理人疏忽导致他人受害</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit des Agenten, die anderen Schaden zufügt</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Agent’s Negligence Causing Harm to Others</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia del agente causando daño a terceros</skos:altLabel>
    <skos:altLabel xml:lang="he-il">השגיאה של הסוכן גורמת נזק לאחרים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia del agente causando daño a terceros</skos:altLabel>
    <rdfs:label>Agent’s Negligence Causing Harm to Others</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
  </rdf:Description>
