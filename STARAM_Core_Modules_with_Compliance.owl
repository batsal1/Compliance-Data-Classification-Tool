    <rdfs:label>Statutory Fraud</rdfs:label>
    <skos:definition>The concept of Statutory Fraud refers to a type of fraud that involves a violation of a specific statute or regulation, and is often used in legal claims related to fraudulent activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/-ETiJxzDR46hSADYcR63-g">
    <skos:example>Bird or wildlife sanctuaries</skos:example>
