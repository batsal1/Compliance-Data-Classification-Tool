  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9WIzSXUBJgCc1GwyT1LZla">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JJWlci2GwDGSMqF9e5IiW"/>
    <skos:altLabel>Unlawful Window Tinting Claim</skos:altLabel>
    <skos:altLabel>Window Tint Infraction Claim</skos:altLabel>
    <skos:altLabel>Excessive Tinting Claim</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Tinted Windows Violation Claim involves allegations that a vehicle's window tinting exceeds the legally allowed darkness or reflectivity, violating regulations that ensure driver visibility and law enforcement's ability to see inside vehicles for safety reasons. Such claims typically result in fines and may require the removal or replacement of the window tint.</skos:definition>
    <rdfs:label>Tinted Windows Violation Claim</rdfs:label>
  </rdf:Description>
