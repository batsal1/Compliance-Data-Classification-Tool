    <skos:altLabel xml:lang="fr-fr">Industrie de l'hébergement et de la restauration</skos:altLabel>
    <skos:altLabel>Accommodation and Food Services</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">宿泊業および飲食サービス業</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de Alojamiento y Servicios de Alimentación</skos:altLabel>
