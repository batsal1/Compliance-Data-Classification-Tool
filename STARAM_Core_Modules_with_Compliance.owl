  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8GRLVVkKApMEMmleQyPj1Z">
    <rdfs:label>Lottery</rdfs:label>
    <skos:prefLabel>Sweepstakes</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Xjkk7EkIgiSA3LmsPofVx"/>
    <skos:definition>A Lottery is a form of gambling where participants purchase tickets for a chance to win a prize, typically determined by a random draw. This type of gambling is often regulated by government authorities and can support public projects or charitable causes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Raffle</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDDmzFedWDpLN1Xtuy3FiLh">
    <skos:altLabel xml:lang="pt-br">Coação</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">強要</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Coacción</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">胁迫</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הכרזה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nötigung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Contrainte</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दबाव</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Duress</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Coacción</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBAoFbSK8WP6xJyVrgQd5PZ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Duress is a legal defense that can be used in civil litigation to excuse or justify a party's actions when they were performed under the threat of harm or coercion.</skos:definition>
    <rdfs:label>Duress</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8bb1ac15a8f249fbb3a57101884e4984">
