  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCSRe5gA8rHlqeKGEVst9Z9">
    <rdfs:label>Negligent Infliction of Emotional Distress</rdfs:label>
    <skos:altLabel xml:lang="es-mx">Negligencia en la Causación de Angustia Emocional</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en la Causación de Angustia Emocional</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Inflição negligente de sofrimento emocional</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence dans l'infliction de détresse émotionnelle</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过失造成情感伤害</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過失による感情的苦痛の負担</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Infliction of Emotional Distress</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Zufügung von seelischem Leid</skos:altLabel>
    <skos:altLabel xml:lang="he-il">גרימת נזק רגשי בשל אי הקפדה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपेक्षापूर्ण भावनात्मक दुख का उत्पादन</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9IldpgAfUyz3upHKvXdn8y"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Negligent Infliction of Emotional Distress refers to a legal claim that arises when a person suffers emotional harm due to the negligent actions of another party, either as a direct victim or as a bystander.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5UNdK19vGcNxeuLfEy4Dd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Roman-Dutch Law System</rdfs:label>
    <skos:altLabel>Roman-Dutch Law is a hybrid legal system that combines Roman law principles with Dutch customary law, prevalent in some former Dutch colonies. This system is characterized by its detailed legal codes and the influence of scholarly legal writings.</skos:altLabel>
    <skos:altLabel>Dutch-Roman Law</skos:altLabel>
    <skos:altLabel>Romano-Dutch Law</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ"/>
  </rdf:Description>
