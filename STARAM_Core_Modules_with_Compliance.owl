    <rdfs:label>Beef Cattle Ranching and Farming</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in raising cattle (including cattle for dairy herd replacements).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=112111"/>
  </rdf:Description>
