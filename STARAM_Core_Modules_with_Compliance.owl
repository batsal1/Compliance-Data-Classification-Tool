    <skos:altLabel xml:lang="es-es">Acuerdo de Confidencialidad</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Confidentiality Agreement</skos:altLabel>
    <skos:definition>A Confidentiality Agreement is a legal contract between parties that outlines the terms and conditions for keeping certain information confidential and not disclosing it to third parties.</skos:definition>
    <ns1:contractFamily xml:lang="en">Restrictive Covenants &amp; Confidentiality</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
