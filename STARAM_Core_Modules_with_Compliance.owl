  <rdf:Description rdf:about="https://folio.openlegalstandard.org/LEzlVrgDRnaTtBNBU2tCzA">
    <skos:example>Employee assessment consulting services</skos:example>
    <skos:example>Personnel management consulting services</skos:example>
    <skos:example>Benefit or compensation consulting services</skos:example>
    <skos:example>Human resources consulting services</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541612"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing advice and assistance to businesses and other organizations in one or more of the following areas: (1) human resource and personnel policies, practices, and procedures; (2) employee benefits planning, communication, and administration; (3) compensation systems planning; and (4) wage and salary administration.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/n_hXChI-SfOC55gHGN7KqA"/>
    <rdfs:label>Human Resources Consulting Services</rdfs:label>
  </rdf:Description>
