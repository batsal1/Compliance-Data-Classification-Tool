  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDGjZdpYvY4ShyRaUk4RHkH">
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en podologie</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em podologia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">足病医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Podologie-Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">足病医疗事故责任</skos:altLabel>
    <skos:definition>Podiatry Malpractice refers to a type of medical malpractice claim that arises from the negligence or wrongdoing of a podiatrist in the treatment of a patient's foot or ankle.</skos:definition>
