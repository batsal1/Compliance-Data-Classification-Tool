    <rdfs:label>EXP/FEE/INV_ADJ_TYPE</rdfs:label>
    <skos:definition>A type of adjustment made to an invoice or fee statement, as defined within the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
  </rdf:Description>
