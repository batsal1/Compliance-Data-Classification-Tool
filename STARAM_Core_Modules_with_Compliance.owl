  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVuDnK7AiYmwBIiwrvktM1">
    <skos:definition>The concept of "Product Misuse or Use Beyond Scope of Product" refers to a defense in product liability cases where the defendant argues that the plaintiff's injury was caused by using the product in a way that was not intended or foreseeable by the manufacturer.</skos:definition>
    <skos:altLabel xml:lang="pt-br">Uso indevido do produto ou uso além do escopo do produto</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Uso indebido del producto o uso fuera del alcance del producto</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">製品の誤用または製品の範囲を超えた使用</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उत्पाद दुरुपयोग या उत्पाद के दायरे से बाहर उपयोग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Uso indebido del producto o uso fuera del alcance del producto</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Mauvaise utilisation du produit ou utilisation en dehors de la portée du produit</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שימוש לא תקין במוצר או שימוש מעבר לטווח המוצר</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Product Misuse or Use Beyond Scope of Product</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">产品误用或超出产品范围使用</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Produktmissbrauch oder Nutzung außerhalb des Produktumfangs</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCc50c8MA7S8aeFuufxdksV"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Product Misuse or Use Beyond Scope of Product</rdfs:label>
  </rdf:Description>
