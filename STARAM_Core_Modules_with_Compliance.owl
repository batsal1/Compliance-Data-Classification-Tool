  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8zVMDBAo2aRDyknQDZjMfs">
    <rdfs:subClassOf rdf:nodeID="N8f8aa46cb58b4aa8963e25fa72606f8a"/>
