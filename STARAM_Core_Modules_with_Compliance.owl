    <skos:altLabel xml:lang="fr-fr">Procédure de confiscation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">没収手続き</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">没收程序</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ज़ब्ती कार्यवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Procedimiento de decomiso</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verfallverfahren</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Forfeiture Proceeding</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Procedimiento de decomiso</skos:altLabel>
