  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBYjEVQYN2eWNPHqVk6LlZu">
    <skos:example>Home Fitness Equipment</skos:example>
    <skos:example>Wearable Fitness Trackers</skos:example>
    <skos:example>Yoga and Pilates Studios</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBXoCwCeY64Ow60nWKSZCC"/>
    <rdfs:subClassOf rdf:nodeID="N001786c4ab764c2b890770edccc36b62"/>
    <skos:altLabel>Workout Market Segment</skos:altLabel>
    <skos:prefLabel>Health &amp; Fitness Market</skos:prefLabel>
    <rdfs:label>Fitness &amp; Exercise Market Segment</rdfs:label>
    <skos:definition>The fitness &amp; exercise market segment refers to a division of the market that is specifically targeted towards consumers who are interested in physical fitness and exercise. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek to maintain or improve their physical health, fitness level, and overall well-being through various forms of exercise.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7smhlh2jRwfrXXBMcHVxK3">
    <skos:altLabel xml:lang="zh-cn">隐瞒欺诈</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fraud by Nondisclosure</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הונאה על ידי חשיפה לא מספקת</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude par omission</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betrug durch Verschweigen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fraude por omisión</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गोपनीयता न करने से धोखाधड़ी</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fraude por omisión</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">隠し持った詐欺</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fraude por omissão</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:label>Fraud by Nondisclosure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Fraud by Nondisclosure refers to a type of fraud claim where one party intentionally fails to disclose important information to another party, which causes harm or damages to the other party.</skos:definition>
  </rdf:Description>
