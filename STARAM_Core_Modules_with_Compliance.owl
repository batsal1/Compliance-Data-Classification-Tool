  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB225Fr8BeyqZIG3hy3W8JG">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Estate Administration</skos:altLabel>
    <skos:altLabel>Estate Administration Service</skos:altLabel>
    <skos:altLabel>Estate Settlement Practice</skos:altLabel>
    <skos:altLabel>Estate Execution Practice</skos:altLabel>
    <skos:definition>Estate Administration Practice refers to the process of managing and settling an individual's estate after their death, including distributing assets to beneficiaries, paying debts, and handling legal and tax obligations. It involves probate proceedings, inventorying assets, and ensuring the deceased's wishes as outlined in their will are fulfilled.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9bCaZjWhV1f2PgQiwzAkDm"/>
    <rdfs:label>Estate Administration Practice</rdfs:label>
    <skos:prefLabel>Probate Administration</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0efa4ec74e0649dea6e8f1f778df8f75">
