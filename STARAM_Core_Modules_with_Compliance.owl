    <skos:altLabel xml:lang="es-mx">Condiciones para el cierre</skos:altLabel>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <rdfs:label>Conditions to Closing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDRCaFxX4hpUklgNnVS9D8C"/>
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
    <skos:definition>Conditions to Closing refer to the specific requirements and obligations that must be fulfilled by parties involved in a merger or acquisition in order for the transaction to be completed, including obtaining clearance from CFIUS, ensuring the absence of litigation, complying with covenants, and providing representations and warranties.</skos:definition>
  </rdf:Description>
