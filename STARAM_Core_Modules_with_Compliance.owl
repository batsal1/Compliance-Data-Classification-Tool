    <rdfs:label>Tax Agreements</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Tax Related Agreement is a contract outlining the terms, conditions, and responsibilities of parties concerning taxation matters. This agreement can address issues like the allocation of tax liabilities, indemnifications, and procedures for handling tax-related disputes or inquiries.</skos:definition>
    <ns1:contractFamily xml:lang="en">Tax</ns1:contractFamily>
  </rdf:Description>
