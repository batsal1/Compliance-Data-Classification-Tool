  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8H6juVpaeXuliJoxIUxXdS">
    <skos:altLabel xml:lang="es-es">Condición de cierre de efecto adverso material "Back-Door"</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Back-Door" Material Adverse Effect Closing Condition</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Condition de clôture pour les effets indésirables matériels par la porte dérobée</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Closing-Bedingung für Material Adverse Effects durch Hintertür</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תנאי סגירת השפעה נזקית חומרית "Back-Door"</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">"बैक-डोर" सामग्री अधिकारी असाधारण प्रभाव समापन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">バックドアの重大な不利な影響のクロージング条件</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Condición de cierre de efecto adverso material "Back-Door"</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Condição de fechamento para Efeitos Adversos Materiais por meio de Porta dos Fundos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">通过后门的重大不利影响关闭条件</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>"Back-Door" Material Adverse Effect Closing Condition</rdfs:label>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <skos:definition>A "Back-Door" Material Adverse Effect (MAE) Closing Condition is a provision in a legal agreement that allows a party to back out of the agreement if an adverse event occurs that was not specifically listed as a condition for termination.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2U69tYGz8WI47zMgaCP"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UELEvq0EkRnKE9zMt5IfZ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8P1ofmH8rlGJmCYCSYvJuJ">
    <skos:altLabel xml:lang="fr-fr">Clause de facturation et de stockage</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף חשבונית והחזקה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de faturamento e armazenamento</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बिल और होल्ड क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de facturación y retención</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">账单和保留条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">請求書と保留条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de facturación y retención</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bill and Hold Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Rechnungsstellung und Lagerung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Bill and Hold Clause is a provision in a contract that allows a seller to bill a buyer for goods that have not yet been delivered, but are being held by the seller for the buyer's future delivery instructions.</skos:definition>
    <rdfs:label>Bill and Hold Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Pu8m28ECQOaO2gJ573WbWw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/F0ZuOpBBQameXhSNJBFSaQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Surgical and Medical Instrument Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing medical, surgical, ophthalmic, and veterinary instruments and apparatus (except electrotherapeutic, electromedical, and irradiation apparatus). Examples of products made by these establishments are syringes, hypodermic needles, anesthesia apparatus, blood transfusion equipment, catheters, surgical clamps, and medical thermometers.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=339112"/>
  </rdf:Description>
