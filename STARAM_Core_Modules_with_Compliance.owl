  <rdf:Description rdf:about="https://folio.openlegalstandard.org/X7FMkmXIRJKiBccPWovViA">
    <skos:example>Model supply services</skos:example>
    <skos:example>Temporary employment or temporary staffing services</skos:example>
    <skos:example>Help supply services</skos:example>
    <skos:example>Labor (except farm) contractors (i.e., personnel suppliers)</skos:example>
    <skos:example>Manpower pools</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561320"/>
    <rdfs:label>Temporary Help Services</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in supplying workers to clients' businesses for limited periods of time to supplement the working force of the client. The individuals provided are employees of the temporary help services establishment. However, these establishments do not provide direct supervision of their employees at the clients' work sites.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/pPoU5hb0SUCeM_3OZxPs8g"/>
  </rdf:Description>
