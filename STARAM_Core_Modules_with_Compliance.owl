  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDsrcjpWqEjihjiv3xWGMAA">
    <skos:altLabel xml:lang="es-mx">Prestamistas descalificados</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition von "Disqualified Lenders": Kreditgeber, die aufgrund von regulatorischen oder rechtlichen Gründen nicht in der Lage sind, Kredite zu vergeben.</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de "Disqualified Lenders": Les prêteurs qui ne sont pas en mesure de prêter en raison de raisons réglementaires ou juridiques.</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">"Disqualified Lenders" 的定义：由于监管或法律原因无法发放贷款的贷款人。</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הלווים מושבתים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Prestamistas descalificados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Disqualified Lenders</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição de "Disqualified Lenders": Credores que não são capazes de emprestar devido a razões regulatórias ou legais.</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अयोग्य ऋण देने वाले</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">"Disqualified Lenders" の定義：規制上または法的な理由により、融資ができない貸し手。</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74IJAT8MHMqUZeBJR7txV1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>"Disqualified Lenders" Definition</rdfs:label>
  </rdf:Description>
