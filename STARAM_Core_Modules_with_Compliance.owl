    <rdfs:label>Contract Negotiation Management</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Contract Negotiation Management refers to the process of managing and overseeing the negotiation of terms and conditions between parties involved in a contract, with the aim of reaching a mutually beneficial agreement.</skos:definition>
