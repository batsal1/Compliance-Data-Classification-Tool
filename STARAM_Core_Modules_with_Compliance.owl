  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDuf39SqsoMEvQNTewHYHcK">
    <skos:altLabel xml:lang="hi-in">नेगोशिएबल इंस्ट्रुमेंट के बैंक द्वारा गलत अस्वीकृति</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negativa injustificada del banco a pagar un instrumento negociable</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Recusa indevida do banco em honrar um instrumento negociável</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">银行错误拒付票据</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negativa injustificada del banco a pagar un instrumento negociable</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bank’s Wrongful Dishonor of Negotiable Instrument</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">銀行による交渉可能な手形の不当な拒否</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סירוב לפעול של הבנק בפריקת כתב ערבות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Refus injustifié de paiement d'un instrument négociable par la banque</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unberechtigte Verweigerung der Einlösung eines Zahlungsinstruments durch die Bank</skos:altLabel>
    <skos:definition>The Bank's Wrongful Dishonor of Negotiable Instrument refers to the act of a bank refusing to pay a negotiable instrument, such as a check or promissory note, without a valid reason, resulting in damages to the party presenting the instrument.</skos:definition>
    <rdfs:label>Bank’s Wrongful Dishonor of Negotiable Instrument</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
  </rdf:Description>
