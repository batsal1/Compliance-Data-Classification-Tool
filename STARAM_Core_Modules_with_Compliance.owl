    <rdfs:subClassOf rdf:nodeID="N8349f1094b39405f9c30e631e81e045e"/>
    <skos:definition>Professional liability insurance, often called "errors and omissions" insurance, protects against claims of negligence or harm caused by professional advice or services. This is particularly important for professions such as doctors, lawyers, and consultants, where the service provided could potentially lead to financial loss or harm for the client.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Errors and Omissions Insurance Policy</skos:prefLabel>
    <rdfs:label>Professional Liability Insurance Policy</rdfs:label>
  </rdf:Description>
