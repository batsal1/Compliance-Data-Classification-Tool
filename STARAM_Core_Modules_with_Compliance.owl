  <rdf:Description rdf:about="https://staram.in/ontology/epc#DocumentComponent">
    <rdfs:subClassOf rdf:nodeID="N14c35b2d8e4248efbf2cc56dc4eb7ca6"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#EPCContractRiskModule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An addressable division of a legal document: a part, article, clause, sub-clause, paragraph, schedule paragraph, annex or definition. Clause identity is scoped to its document, because clause numbers repeat across an agreement and its technical schedules.</skos:definition>
    <owl:disjointWith rdf:resource="https://staram.in/ontology/epc#LegalDocument"/>
