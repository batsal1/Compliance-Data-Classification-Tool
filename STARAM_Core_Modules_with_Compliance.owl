  <rdf:Description rdf:about="https://folio.openlegalstandard.org/BjqO6tO8Sgma6h5U-qGG5w">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541713"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in conducting nanotechnology research and experimental development. Nanotechnology research and experimental development involves the study of matter at the nanoscale (i.e., a scale of about 1 to 100 nanometers). This research and development in nanotechnology may result in development of new nanotechnology processes or in prototypes of new or altered materials and/or products that may be reproduced, utilized, or implemented by various industries.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/JO9pD1pURsu08gubfQb1pw"/>
    <rdfs:label>Research and Development in Nanotechnology</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#impact-termination">
