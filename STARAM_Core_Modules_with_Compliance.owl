  <rdf:Description rdf:about="https://folio.openlegalstandard.org/PAbS1dpgTX6-DRfynCf-Cg">
    <skos:example>Ship scaling services</skos:example>
    <skos:example>Marine cargo checkers and surveyors</skos:example>
    <skos:example>Floating drydocks (i.e., routine repair and maintenance of ships)</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing services to water transportation (except port and harbor operations; marine cargo handling services; and navigational services to shipping).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/c1fUc7gzS62EMOwzvOPstw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=488390"/>
    <rdfs:label>Other Support Activities for Water Transportation</rdfs:label>
  </rdf:Description>
