  <rdf:Description rdf:about="https://folio.openlegalstandard.org/OHRgpwVGRR2OOs9XZgkEgA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33641"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing complete aircraft, missiles, or space vehicles; (2) manufacturing aerospace engines, propulsion units, auxiliary equipment, or parts; (3) developing and making prototypes of aerospace products; (4) aircraft conversion (i.e., major modifications to systems); and (5) complete aircraft or propulsion systems overhaul and rebuilding (i.e., periodic restoration of aircraft to original design specifications).</skos:definition>
    <rdfs:label>Aerospace Product and Parts Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/lCKj6LFVQSWbn596eMGWmA"/>
  </rdf:Description>
