  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8xsn4ZNTKUSww8wUrawqHA">
    <rdfs:label>False Light</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rd7uelGFqCTWSgf9lWki5N"/>
    <skos:altLabel xml:lang="es-es">Falsa luz</skos:altLabel>
