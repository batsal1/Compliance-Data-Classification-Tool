  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB7HZqoX4yOfyrODM2gIpnN">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Klausel zur Rechnungsstellung und Abrechnungsforderung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">明細書および請求条項クレーム</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de extrato e reivindicação de conta</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">结算和账户条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de relevé de compte et de demande de paiement</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
    <skos:definition>A Statement and Account Clause claim is a legal argument asserting that a government entity has failed to provide an accurate and detailed statement of financial accounts or failed to be transparent and accountable in financial matters, thereby violating the obligations outlined in the Statement &amp; Account Clause. This claim contends that the government entity has breached its duty to provide a comprehensive and accurate account of public funds and expenditures as required by the relevant constitutional provision or statutory requirement</skos:definition>
    <rdfs:label>Statement and Account Clause Claim</rdfs:label>
  </rdf:Description>
