  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R87M97iEkZoIZm400nVmw8v">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8JVOGBEzEQHWl2bYk4uQam"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Prior Art Search Process</rdfs:label>
    <skos:definition>The prior art search process is a methodical examination conducted to identify existing knowledge, inventions, or technologies relevant to a new invention or patent application. This process helps determine the novelty and non-obviousness of the invention by uncovering prior art that may impact its patentability.</skos:definition>
  </rdf:Description>
