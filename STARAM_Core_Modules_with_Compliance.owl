  <rdf:Description rdf:about="https://folio.openlegalstandard.org/kgNqfc5QQH21ebNgUflj5w">
    <skos:definition>This U.S. industry comprises establishments known as line-haul railroads primarily engaged in operating railroads for the transport of passengers and/or cargo over a long distance within a rail network. These establishments provide for the intercity movement of trains between the terminals and stations on main and branch lines of a line-haul rail network (except for local switching services).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Qfg7k82rSDq-ySL8nIBPuQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=482111"/>
    <rdfs:label>Line-Haul Railroads</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8IOUPmT1PKfdHbXL0tORqG">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Ethical AI</rdfs:label>
    <skos:prefLabel>Morally Aligned AI</skos:prefLabel>
    <skos:altLabel>Value-Based AI</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMmocc9Ine34BK9vSksb0k"/>
    <skos:definition>Ethical AI refers to AI systems that demonstrate respect for and adherence to ethical principles and values. These systems are designed to operate in a manner consistent with moral standards, ensuring fairness, transparency, accountability, and respect for human rights and societal norms.</skos:definition>
  </rdf:Description>
