    <skos:altLabel xml:lang="he-il">הטרדה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Nuisance</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Molestia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Incomodo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Molestia</skos:altLabel>
