  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8xwNRZSntBjDSHWTLTABhP">
    <rdfs:label>Country Risk</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R98HKldfU8zFYR50z1T3Yn4"/>
    <skos:definition>The risk that a foreign government will default on its bonds or other financial commitments. Country risk also refers to the broader notion of the stability of the country's financial system.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R2Ocimo6ph9ym7bvUywOEb">
    <skos:definition>A Residuary Bequest is a provision in a will or trust that designates the distribution of the remainder of an estate after all specific, general, and demonstrative bequests have been fulfilled. This type of bequest ensures that any leftover assets are passed to the named beneficiary or beneficiaries.</skos:definition>
    <rdfs:label>Residuary Bequest</rdfs:label>
    <skos:altLabel>Residual Testamentary Gift</skos:altLabel>
    <skos:altLabel>Residual Bequest</skos:altLabel>
    <skos:altLabel>Remainder Bequest</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3OI7nrib1LEPtUfn5G5CH"/>
  </rdf:Description>
