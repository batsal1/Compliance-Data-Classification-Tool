    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Data Analytics Management refers to the process of collecting, organizing, and analyzing data to gain insights and make informed decisions, within the broader context of Data Management.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/K7j9IkouTt-j6yfCBAMJSg">
