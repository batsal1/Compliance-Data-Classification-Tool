  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8zMbvy16kcHWsrWq4KaT58">
    <skos:altLabel xml:lang="es-es">Incumplimiento de garantía implícita de título</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite de titre</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung des Eigentumstitels</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反隐含的所有权保证</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">暗黙の権利保証違反</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de garantía implícita de título</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Title</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de título</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת אחריות מתיחסת לכותר משתמעת</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शीर्षक की निहित वारंटी का उल्लंघन</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Breach of Implied Warranty of Title is a legal concept that occurs when a seller of property fails to transfer clear and marketable title to the buyer, despite not making any express warranties about the title.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NPSSODp2sRYDRSQ2hvF3b"/>
    <rdfs:label>Breach of Implied Warranty of Title</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rr7oz8XcZCBEq0V1LIL5VA">
    <skos:altLabel>AI-Based Autonomous System</skos:altLabel>
    <skos:altLabel>Independent AI System</skos:altLabel>
    <skos:altLabel>Self-Governing AI System</skos:altLabel>
    <skos:altLabel>Intelligent Autonomous System</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Autonomous AI System is an artificial intelligence system capable of performing tasks with minimal human intervention, relying on its ability to analyze data and make decisions independently. These systems are designed to learn and adapt to new situations without explicit programming, enabling them to function in dynamic environments</skos:definition>
    <rdfs:label>Autonomous AI System</rdfs:label>
    <skos:prefLabel>Self-Operating AI</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#ContractualRight">
    <rdfs:label xml:lang="en">Contractual right</rdfs:label>
    <rdfs:comment xml:lang="en">An entitlement held by a party under a contract that entails a correlative obligation on another party.</rdfs:comment>
