  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RS9mRCkEGyE2dgW38uDMVe">
    <skos:altLabel xml:lang="zh-cn">双重危险</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Autrefois Acquit</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סכנת כפולה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Doble Jeopardy</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Doppelte Strafverfolgung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Doble Jeopardy</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dupla Jeopardia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">डबल जेपर्डी</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">二重の危険</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Autrefois Acquit</skos:altLabel>
    <skos:altLabel>Double Jeopardy Claim</skos:altLabel>
    <skos:definition>The concept of Double Jeopardy refers to the legal principle that prohibits an individual from being prosecuted or punished twice for the same offense after a final judgment has been made.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCvD6VheGrBYqJhgQDfMbrV"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
    <rdfs:label>Double Jeopardy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R97IAAj73aQDTLnBU1eL5zB">
    <skos:altLabel xml:lang="pt-br">Cláusula de sobrevivência</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de supervivencia</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de supervivencia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">生存条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Survival Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Überlebensklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">生存条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बचत क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de survie</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הישרדות</skos:altLabel>
    <rdfs:label>Survival Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A survival clause is a provision in a contract that specifies which obligations and rights of the parties will continue to be in effect after the termination or expiration of the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
