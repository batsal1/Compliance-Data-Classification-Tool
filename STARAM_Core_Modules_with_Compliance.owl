    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzvtNXIrDJF8xkmOoc6JKH"/>
    <skos:definition>Reduction in Force (RIF) law pertains to the legal framework and regulations governing the process of reducing an organization's workforce, typically due to budgetary constraints, restructuring, or downsizing. It includes provisions related to employee rights, notice requirements, severance packages, and discrimination laws to ensure fair and lawful implementation of workforce reductions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Reduction in Force Law</rdfs:label>
    <skos:prefLabel>Workforce Reduction Law</skos:prefLabel>
  </rdf:Description>
