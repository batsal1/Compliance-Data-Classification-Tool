  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB2sCkb5dZ38tzkavJZPazV">
    <skos:altLabel xml:lang="en-gb">Presentation of Documents Practice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दस्तावेज़ अभ्यास का प्रस्तुतिकरण</skos:altLabel>
    <skos:altLabel>Presentation of Documents</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">文書のプレゼンテーション実践</skos:altLabel>
    <skos:altLabel>Presentation of Documents Service</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול הצגת מסמכים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de presentación de documentos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de presentación de documentos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de apresentação de documentos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Präsentation von Dokumentenpraxis</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de présentation de documents</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">文件展示实践</skos:altLabel>
    <skos:definition>Presentation of Documents Practice refers to the specific legal practice of organizing and displaying relevant documents in a clear and effective manner during legal proceedings, and is a subcategory of the broader Document Collection and Production Practice.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB5lx7xpeCS48DusHwMKcU3"/>
    <rdfs:label>Presentation of Documents Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
