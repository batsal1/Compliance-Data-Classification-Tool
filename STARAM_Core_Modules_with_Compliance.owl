    <skos:altLabel xml:lang="fr-fr">Clause de bonus EBITDA</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ईबीआईटीडीए बोनस क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de bonificación EBITDA</skos:altLabel>
    <skos:definition>A provision in a contract that entitles a party to receive a bonus based on the calculation of earnings before interest, taxes, depreciation, and amortization (EBITDA).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>EBITDA Bonus Clause</rdfs:label>
  </rdf:Description>
