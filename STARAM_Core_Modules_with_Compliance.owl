  <rdf:Description rdf:about="https://folio.openlegalstandard.org/qEWHBaPGQtqyhD5hN876dA">
    <rdfs:label>Wood Container and Pallet Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=321920"/>
