    <skos:definition>A Purchase Agreement is a legally binding contract between two or more parties that outlines the terms and conditions of a transaction involving the sale of goods or services.</skos:definition>
    <skos:altLabel xml:lang="pt-br">Contrato de compra</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">购买协议</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Contrato de Compra</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Purchase Agreement</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीद अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kaufvertrag</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Contrat d'achat</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם רכישה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Contrato de Compra</skos:altLabel>
