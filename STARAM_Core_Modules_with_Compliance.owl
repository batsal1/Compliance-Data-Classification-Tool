  <rdf:Description rdf:about="https://folio.openlegalstandard.org/FQRPl0mWQw6wcgApCjO-iA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3279"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Other Nonmetallic Mineral Product Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/1fwWe7gBQpieS5cknXqvIg"/>
    <skos:definition>This industry group comprises establishments manufacturing nonmetallic mineral products (except clay products, refractory products, glass products, cement and concrete products, lime, and gypsum products).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RlmyXsj3s6KHsLHBGEG2AD">
