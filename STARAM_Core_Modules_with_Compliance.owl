    <ns1:contractFamily xml:lang="en">Services &amp; Outsourcing</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Service Level Agreement</rdfs:label>
    <skos:definition>An SLA is a commitment between a service provider and a client detailing the standards and quality of service the client can expect. It often specifies response times, uptime percentages, and remedies for failing to meet agreed-upon benchmarks.</skos:definition>
    <skos:prefLabel>SLA</skos:prefLabel>
  </rdf:Description>
