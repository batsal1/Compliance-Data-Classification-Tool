  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCMZqt2BD3qRRYlj61ssnIZ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRTsPoZhucp80NJy00WHwY"/>
    <skos:prefLabel>Party-Based Proportional System</skos:prefLabel>
    <rdfs:label>Party-List Proportional Representation System</rdfs:label>
    <skos:definition>The Party-List Proportional Representation System is an electoral method where voters cast their ballots for a party rather than individual candidates, and seats are allocated to each party in proportion to the number of votes received. The party then fills its allocated seats with candidates from a pre-determined list.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source rdf:resource="https://en.wikipedia.org/wiki/Party-list_proportional_representation"/>
  </rdf:Description>
