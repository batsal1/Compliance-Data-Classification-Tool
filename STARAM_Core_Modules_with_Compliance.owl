    <rdfs:label>Pooling and Servicing Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Structured Finance &amp; Derivatives</ns1:contractFamily>
    <skos:definition>A Pooling and Servicing Agreement sets the rights, obligations, and responsibilities of the parties involved in a securitization, especially concerning the collection and distribution of cash flows from pooled assets, typically loans.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
