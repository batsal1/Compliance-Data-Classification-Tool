  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCMjc7vlpo6lmTOxvekbZYL">
    <skos:altLabel xml:lang="en-gb">Enforcement of Security Interest Delegating Seller’s Performance</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Delegação da execução da venda com reserva de domínio</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">转让卖方履行担保利益</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ejecución de la garantía delegando el rendimiento del vendedor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बिक्रेता के प्रदर्शन को समर्थन देने के सुरक्षा हित के प्रवर्तन</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Übertragung der Durchsetzung von Sicherungsrechten auf den Verkäufer</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">売主の履行を委任する担保権の強制執行</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ejecución de la garantía delegando el rendimiento del vendedor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ביצוע הבטחת האבטחה על ידי העברת ביצוע המוכר</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Délégation de l'exécution de la vente avec réserve de propriété</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Enforcement of Security Interest Delegating Seller’s Performance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <skos:definition>The Enforcement of Security Interest Delegating Seller's Performance refers to the legal process of ensuring that a seller who has delegated their performance to a third party is still held responsible for fulfilling their obligations to a creditor who has a security interest in the property being sold.</skos:definition>
  </rdf:Description>
