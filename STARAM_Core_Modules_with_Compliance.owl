    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>An Outstanding Fees Clause is a provision in a contract that requires one party to pay any unpaid fees or charges to the other party before the contract can be terminated or enforced.</skos:definition>
