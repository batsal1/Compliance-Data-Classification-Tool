    <skos:altLabel xml:lang="zh-cn">有吸引力的危险物</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Peligro atractivo</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Occupier's Liability</skos:altLabel>
    <skos:definition>A legal concept that refers to a hazardous condition or object on a property that is likely to attract children and may cause them harm, for which the property owner may be held liable.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
