    <skos:altLabel xml:lang="de-de">Vertriebsvereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">分销协议</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Distributor Agreement</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वितरक समझौता</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם מפיץ</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Contrato de Distribución</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de Distribución</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">販売契約</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de distribution</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Contrato de distribuição</skos:altLabel>
    <skos:prefLabel>Distribution Agreement</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Distributor Agreement</rdfs:label>
    <skos:definition>A Distribution Agreement is a contractual arrangement between a supplier or manufacturer and a distributor that outlines the terms and conditions for the distribution of goods or services. The agreement typically covers issues like pricing, delivery, and geographic territory, as well as the responsibilities and obligations of both parties.</skos:definition>
    <ns1:contractFamily xml:lang="en">Supply, Manufacturing &amp; Distribution</ns1:contractFamily>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R83Du1u25vUg5RpyqZ1KgW1">
    <skos:altLabel xml:lang="de-de">Handlung oder Unterlassung durch einen öffentlichen Angestellten</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公职人员的行为或不作为</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acto u Omisión de Servidor Público</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Acte ou omission d'un employé public</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公務員による行為または不作為</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acto u Omisión de Empleado Público</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Act or Omission by Public Employee</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सार्वजनिक कर्मचारी द्वारा किया गया कार्य या अपराध</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולה או השמטה על ידי עובד ציבורי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ato ou Omissão de Funcionário Público</skos:altLabel>
    <skos:definition>An act or failure to act by a government employee that results in harm or injury to another person, which may give rise to a legal claim for damages under the doctrine of governmental tort liability.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBREngQZS9QIgeWCOMPBLIo"/>
    <rdfs:subClassOf rdf:nodeID="N4608baf6f2b14b5285c02d01c9ed3fef"/>
    <rdfs:label>Act or Omission by Public Employee</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
