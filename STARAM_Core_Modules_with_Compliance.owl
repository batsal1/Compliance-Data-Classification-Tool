    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBVUyb38XelMKIl06TX139">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-mx">Cláusula de Reembolso de Colegiatura</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">学费报销条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de remboursement des frais de scolarité</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף החזר דמי לימודים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">授業料払い戻し条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Reembolso de Matrícula</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Studiengebührenerstattung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शिक्षा भर्ती शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de reembolso de mensalidades</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Tuition Reimbursement Clause</skos:altLabel>
    <rdfs:label>Tuition Reimbursement Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A tuition reimbursement clause is a provision in a contract that requires one party to pay for the educational expenses of another party, typically an employee, in exchange for certain conditions being met.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBUtAfKXfMN4dku9MsqeFjW">
    <skos:definition>A Purchase Price Adjustment Mechanism is a contractual provision in M&amp;A transactions that allows for changes to the initial purchase price based on the target company's financial performance or position as of the closing date. It ensures that the final price reflects the actual value of the target, protecting the interests of both buyer and seller.</skos:definition>
    <rdfs:label>Purchase Price Adjustment Mechanism</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL"/>
    <skos:prefLabel>Transaction Price Adjustment Mechanism</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Price Adjustment Clause</skos:altLabel>
  </rdf:Description>
