  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQHOmkOaGlrYDX5xdhYgAT">
    <skos:altLabel xml:lang="ja-jp">法律上暗示された契約違反</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Implied-in-Law Contract</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反默示合同</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung eines impliziten Vertrags</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de contrato implícito en la ley</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवधारणा-इन-कानून अनुबंध का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de contrato implícito em lei</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוזה משפטי משתמע מהחוק</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato implícito en la ley</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de contrat implicite en droit</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDplPdJJQ6YnEbE1gSXm51T"/>
    <rdfs:label>Breach of Implied-in-Law Contract</rdfs:label>
    <skos:definition>The Breach of Implied-in-Law Contract refers to a situation where a party fails to fulfill an obligation that is not explicitly stated in a contract, but is implied by law.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R72p6HAKCuvyIWvgxuoCM9R">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGOU62BPz1QTVsWRE2Nodz"/>
    <rdfs:label>Employment Hierarchical Role</rdfs:label>
    <skos:definition>Employment Hierarchical Role refers to an employee's position within the organizational structure in terms of authority and responsibility. Common hierarchical roles include managers, who have oversight and decision-making responsibilities for a team, and individual contributors, who are subject matter experts or skilled workers that focus on executing specific tasks without direct managerial duties.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/LEtKyTuXSUOIRJIgP5822Q">
    <rdfs:label>Flavoring Syrup and Concentrate Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311930"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/xcm4U9_ORtS_aIF7dGyzAg"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing flavoring syrup drink concentrates and related products for soda fountain use or for the manufacture of soft drinks.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
