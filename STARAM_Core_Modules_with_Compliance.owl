  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RrTw7gZ2F0N6WBdARbUMAg">
    <rdfs:subClassOf rdf:nodeID="N75aa3dd84f21467dbe898feee9b859ac"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RepzuKaD1tTAVt1HZzq1U4"/>
    <skos:definition>In forma pauperis (also known as "Fee Waiver") is a legal status granted to individuals who cannot afford the costs associated with legal proceedings, allowing them to proceed without paying fees. Courts typically require proof of indigency, and if granted, this status may cover court costs and other associated expenses</skos:definition>
    <skos:definition>In forma pauperis is a legal status granted to individuals who cannot afford the costs associated with legal proceedings, allowing them to proceed without paying fees. Courts typically require proof of indigency, and if granted, this status may cover court costs and other associated expenses</skos:definition>
    <skos:altLabel>Court Fee Exemption</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source rdf:resource="https://taxonomy.legal/"/>
    <skos:prefLabel>Fee Waiver</skos:prefLabel>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdfs:label>In Forma Pauperis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCP0d1k1Zn9Z7wweXZB1rCw">
