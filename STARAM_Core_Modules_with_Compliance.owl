  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RE9s7r2JlXT0Er8ow5jUPj">
    <skos:definition>Educational or vocational training refers to structured programs designed to provide individuals with the skills, knowledge, and certifications needed for specific careers or professions. While educational training typically focuses on broader academic knowledge, vocational training is more specialized and career-oriented, aiming to prepare individuals for specific trades or occupations. Both types of training are often requirements in individual responsibility plans for public benefits.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDNsW4JqaHcQ9KPtpXLzCPc"/>
    <rdfs:label>Educational or Vocational Training</rdfs:label>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDMTIY9dbpdtPFxH3BMILDE">
    <skos:altLabel xml:lang="zh-cn">场所使用条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de uso das instalações</skos:altLabel>
