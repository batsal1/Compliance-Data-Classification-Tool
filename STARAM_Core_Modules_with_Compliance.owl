    <skos:altLabel xml:lang="de-de">Störung von Verträgen und Geschäftsbeziehungen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interference with Contracts and Business Relationships</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרעה בחוזים וביחסי עסקים</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHSZPHkLvnB6N4bgIo6kuX"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCcQHyZbjBHsXsm0zrZGme5"/>
    <skos:definition>Interference with Contracts and Business Relationships refers to the intentional and unjustified interference with a contractual or business relationship between two parties, resulting in economic harm to one or both parties.</skos:definition>
    <rdfs:label>Interference with Contracts and Business Relationships</rdfs:label>
    <skos:prefLabel>Tortious Interference with Contratual Relations</skos:prefLabel>
  </rdf:Description>
