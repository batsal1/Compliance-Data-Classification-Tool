  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDWM2ZTf9fWHTXZodULdGte">
    <skos:altLabel xml:lang="es-es">Seguro de vida o de salud obtenido mediante fraude</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Assurance vie ou santé obtenue par fraude</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">詐欺によって取得された生命保険または健康保険</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Lebens- oder Krankenversicherung durch Betrug erlangt</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Seguro de vida ou saúde obtido por fraude</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Life or Health Insurance Obtained by Fraud</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">धोखाधड़ी से प्राप्त जीवन या स्वास्थ्य बीमा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Seguro de vida o de salud obtenido por fraude</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ביטוח חיים או בריאות הואטל על ידי הונאה</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">通过欺诈获得的人寿保险或健康保险</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Na688e0e2f9e743deaec3c614de67cca2"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBH1NIeHTs7myQf1RgQXCWy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Life or Health Insurance Obtained by Fraud</rdfs:label>
    <skos:definition>Life or Health Insurance Obtained by Fraud: Insurance policies for life or health that are acquired through deceitful means, such as providing false information or concealing relevant facts, with the intention of obtaining benefits that would not have been granted otherwise.</skos:definition>
  </rdf:Description>
