  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBbCFtSgYl1mKuI8SNcMtPO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Gap Financing</skos:prefLabel>
    <rdfs:label>Bridge Loan</rdfs:label>
    <skos:definition>A Bridge Loan is a short-term financing option used to bridge the gap between the purchase of a new asset and the sale of an existing one. Typically utilized in real estate transactions, bridge loans provide immediate cash flow for the borrower until permanent financing can be arranged or the existing asset is sold.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
    <skos:altLabel>Short-Term Financing</skos:altLabel>
    <skos:altLabel>Interim Loan</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Necadebffe804428d817a3a132b7a02ff">
