  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD1gM37TNzqcVTb6DLOlF8j">
    <skos:altLabel xml:lang="es-mx">Interferencia Negligente con una Relación Comercial Prospectiva</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia Negligente con una Relación Comercial Prospectiva</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Interference with Prospective Business Relationship</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्वानुमानित व्यापारिक संबंध में लापरवाहीपूर्वानुमानित व्यापारिक संबंध में लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过失干涉未来商业关系</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">将来のビジネス関係に対する過失的な干渉</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência negligente em uma relação comercial prospectiva</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Ingérence négligente dans une relation commerciale prospective</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Beeinträchtigung einer zukünftigen Geschäftsbeziehung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות בהפרעה מבקשת עסקית צפויה</skos:altLabel>
    <rdfs:label>Negligent Interference with Prospective Business Relationship</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDo81N034NYuEZm3nSNabUV"/>
    <skos:definition>The Negligent Interference with Prospective Business Relationship is a legal concept that refers to the unintentional disruption of a potential business relationship by a party who fails to exercise reasonable care, resulting in economic harm to the other party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8IDj7WyH271GZ9doQJUak5">
