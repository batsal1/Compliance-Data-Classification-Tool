    <rdfs:subClassOf rdf:nodeID="Nb53215f4c06a48f2a3308103d94171dc"/>
    <skos:altLabel>Archbishop</skos:altLabel>
    <skos:altLabel>Sheikh</skos:altLabel>
    <skos:altLabel>Pujari</skos:altLabel>
    <skos:altLabel>Priest</skos:altLabel>
    <skos:altLabel>Minister</skos:altLabel>
    <skos:altLabel>Swami</skos:altLabel>
    <skos:altLabel>Pastor</skos:altLabel>
    <skos:altLabel>Deacon</skos:altLabel>
    <skos:altLabel>Bishop</skos:altLabel>
    <skos:altLabel>Rabbi</skos:altLabel>
    <skos:altLabel>Imam</skos:altLabel>
    <rdfs:label>Clergy</rdfs:label>
    <skos:definition>Clergy refers to religious leaders, ordained individuals authorized to perform religious duties, ceremonies, and provide spiritual guidance within a religious community. These individuals often hold specific titles and roles depending on their religious tradition.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Religious Leader</skos:prefLabel>
  </rdf:Description>
