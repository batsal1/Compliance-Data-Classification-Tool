  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rda1ZRiT8b4PHJQncWMMaJ">
    <skos:altLabel xml:lang="zh-cn">违反默示的善意和公平原则的侵权行为</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsbruch aus unerlaubter Handlung durch implizite Treuepflicht und fairen Umgang</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação culposa da obrigação implícita de boa-fé e lealdade</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">善意と公正な取引の暗黙の契約違反による不法行為</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation délictuelle de l'obligation implicite de bonne foi et de loyauté</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R49sp0iRvML6Mzkr06Bimd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Tortious Breach of Implied Covenant of Good Faith and Fair Dealing refers to a legal claim that arises when one party to a contract violates the implied duty of good faith and fair dealing, resulting in harm or damages to the other party.</skos:definition>
    <rdfs:label>Tortious Breach of Implied Covenant of Good Faith and Fair Dealing</rdfs:label>
  </rdf:Description>
