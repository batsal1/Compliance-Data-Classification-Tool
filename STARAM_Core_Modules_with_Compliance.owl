    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <skos:definition>Negligence in the practice of internal medicine, which involves a breach of duty of care by a medical professional resulting in harm or injury to a patient.</skos:definition>
