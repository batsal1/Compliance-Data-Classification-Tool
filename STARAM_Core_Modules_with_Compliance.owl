    <skos:altLabel xml:lang="es-es">Responsabilidad comparativa de otros</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vergleichbares Verschulden Dritter</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">他人比较过失</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute comparée d'autres</skos:altLabel>
