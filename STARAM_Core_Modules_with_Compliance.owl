    <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - टाईंग दावे</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Antitrust - Tying Claims</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de ataduras</skos:altLabel>
