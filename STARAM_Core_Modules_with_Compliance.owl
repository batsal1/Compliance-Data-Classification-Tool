  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBfZA58JH88QrVPUBjsLg9j">
    <skos:definition>The right to liberty refers to the fundamental human right to freedom from unlawful or arbitrary arrest, detention, or other forms of physical restraint. This right is enshrined in international legal instruments such as the Universal Declaration of Human Rights and the International Covenant on Civil and Political Rights, and aims to protect individual autonomy and freedom from state interference.</skos:definition>
    <rdfs:label>Right to Liberty</rdfs:label>
    <dc:source>International Bill of Human Rights</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcUv6cuttcRWxmaQw6M1N4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
