  <rdf:Description rdf:nodeID="Nfd140da2c92744ceb6c4736e1f43696b">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#EntireAgreement"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
