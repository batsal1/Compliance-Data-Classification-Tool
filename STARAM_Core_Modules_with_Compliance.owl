    <skos:altLabel xml:lang="de-de">Störung von Wirtschaftsbeziehungen</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आर्थिक संबंधों में हस्तक्षेप</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">経済関係の妨害</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência nas relações econômicas</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFs8eqGTlY90gkX2NFNLTH"/>
    <skos:definition>The concept of Interference with Economic Relations refers to the intentional and unjustified interference with a business relationship or contract, resulting in economic harm to one or more parties involved.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCE6IwMsuIAPTTC6MfnZin7">
    <skos:altLabel xml:lang="es-mx">Negligencia en el tratamiento de diálisis</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence dans le traitement de la dialyse</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">透析治療の過失</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">透析治疗疏忽</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en el tratamiento de diálisis</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">डायलिसिस उपचार लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הזנחת טיפול בכירורטים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Dialysebehandlungsfehler</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dialysis Treatment Negligence</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência no tratamento de diálise</skos:altLabel>
    <skos:definition>Negligent provision of dialysis treatment by a medical professional, resulting in harm or injury to the patient.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dialysis Treatment Negligence</rdfs:label>
  </rdf:Description>
