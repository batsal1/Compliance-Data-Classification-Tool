    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#DefinitionsOfTerms"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RZXGxM4fa30zVwZUseJNcS">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Cláusula de direito de sublocação</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכות לכפות תת-השכרה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right to Sublet Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zum Untervermietungsrecht</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de derecho a subarrendar</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de derecho a subarrendar</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">転貸借権条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">转租权条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit de sous-location</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सबलेट करने का अधिकार शर्त</skos:altLabel>
    <rdfs:label>Right to Sublet Clause</rdfs:label>
    <skos:definition>The Right to Sublet Clause is a provision in a contract that grants the tenant the legal right to sublet the property to another person for a specified period of time.</skos:definition>
  </rdf:Description>
