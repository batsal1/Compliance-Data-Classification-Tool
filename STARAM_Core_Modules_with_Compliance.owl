  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBsBXvBV1L5NIzFFrigLRVH">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Entity Management</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD2xwWqnYhIj0tyrPJrmege"/>
    <skos:definition>Entity Management refers to the process of organizing and maintaining legal entities, such as corporations or partnerships, within a business or organization.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6e7458c641394682a156f077e5afc9af">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Nondisturbance"/>
