    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Procedural Unconscionability Permitting Contract Rescission</rdfs:label>
    <skos:definition>Procedural Unconscionability Permitting Contract Rescission: A legal concept that allows a contract to be cancelled due to unfair or oppressive terms or conditions that were imposed upon one party during the formation of the contract.</skos:definition>
