  <rdf:Description rdf:about="https://folio.openlegalstandard.org/AIbdJqP1Qv6lQtdGBv8GDQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/F0ZuOpBBQameXhSNJBFSaQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=339115"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing ophthalmic goods. Examples of products made by these establishments are prescription eyeglasses (except grinding lenses in a retail setting), contact lenses, sunglasses, eyeglass frames, reading glasses made to standard powers, and protective eyewear.</skos:definition>
    <rdfs:label>Ophthalmic Goods Manufacturing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/4gYRyTiLRSueXp6YsEzPOw">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=336415"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/OHRgpwVGRR2OOs9XZgkEgA"/>
    <rdfs:label>Guided Missile and Space Vehicle Propulsion Unit and Propulsion Unit Parts Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) manufacturing guided missile and/or space vehicle propulsion units and propulsion unit parts and/or (2) developing and making prototypes of guided missile and space vehicle propulsion units and propulsion unit parts.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
