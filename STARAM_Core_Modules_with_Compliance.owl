    <skos:definition>The violation of laws or ordinances prohibiting the manufacture, publishing, sale, purchase, or possession of sexually explicit material, e.g., literature, photographs, etc.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R97DdQGgeUgH9OJAvTnJreN">
    <skos:altLabel xml:lang="pt-br">Cláusula de beneficiário terceiro</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">第三方受益人条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de bénéficiaire tiers</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Drittbegünstigungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">第三者受益条項</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N61138a2ba7c8426f88277135ce91c084"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:subClassOf rdf:nodeID="N70b1fc2dc8ef49eb895724d556085faa"/>
    <rdfs:label>Third Party Beneficiary Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A third party beneficiary clause is a provision in a contract that grants a specific right or benefit to someone who is not a party to the contract but is intended to benefit from it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8l6PNZlEOv8nFmdeHbUk8P">
    <skos:altLabel xml:lang="hi-in">क्रेडिट जारीकर्ता अस्वीकार या अस्वीकृति</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento o Repudio del Emisor de Crédito</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מנפיק האשראי מפר או מכחיש</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Emissor de crédito desonrando ou repudiando</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nichterfüllung oder Ablehnung des Kreditgebers</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Credit Issuer Dishonouring or Repudiating</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento o Repudio del Emisor de Crédito</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">クレジット発行者の不履行または拒否</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">信用发行人违约或否认</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Non-respect ou répudiation de l'émetteur de crédit</skos:altLabel>
    <skos:definition>The concept of "Credit Issuer Dishonoring or Repudiating" refers to the act of a bank or other entity failing to honor or refusing to acknowledge a debt or obligation owed to a creditor, typically involving commercial paper or other financial instruments.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Credit Issuer Dishonoring or Repudiating</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
  </rdf:Description>
