    <skos:altLabel xml:lang="hi-in">वकील कार्य उत्पाद संरक्षण</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">律师工作产品保护</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">弁護士の作業成果物保護</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
    <skos:definition>Attorney Work Product Protection is a legal privilege that shields materials prepared by an attorney or their team in anticipation of litigation from discovery by opposing parties.</skos:definition>
    <rdfs:label>Attorney Work Product Protection</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfb284cf562974589a4db53e69e326f2f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermMaterialAdverseEffect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7qgJwhdyqvE8u175RN80fT">
    <skos:definition>A reprieve is a temporary delay or suspension of a punishment or sentence, especially in the context of the death penalty. It serves as a postponement of the execution of a sentence, often to allow the defendant more time to seek a new trial, appeal, or another form of relief. However, a reprieve does not change the underlying conviction or sentence; it only delays its enforcement.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N035e8a50658f4c6a9c2f243d136efc30"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCRVBAzI4EaLARuVLhgDBTB"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Reprieve</rdfs:label>
  </rdf:Description>
