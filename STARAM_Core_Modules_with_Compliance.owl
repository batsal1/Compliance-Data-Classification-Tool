  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBF5KuECPEHv8VWSLweEKTH">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7n6xn6CbnvekygNrB5DsJM"/>
    <rdfs:subClassOf rdf:nodeID="N104218ab8a1c4a46b84d070814fb872f"/>
    <skos:altLabel xml:lang="es-es">Bienes de consumo arrendados en circunstancias abusivas</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Bienes de consumo arrendados en circunstancias abusivas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">在不公平情况下租赁的消费品</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verbrauchsgüter, die unter unangemessenen Umständen geleast wurden</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不当な状況下でリースされた消費財</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Consumer Goods Leased Under Unconscionable Circumstances</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סחורות לצרכן שהושכרו בנסיבות לא הוגנות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Biens de consommation loués dans des circonstances abusives</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Bens de consumo alugados em circunstâncias abusivas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अन्यायपूर्ण परिस्थितियों के तहत लीजे गए उपभोक्ता वस्तु</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Consumer Goods Leased Under Unconscionable Circumstances</rdfs:label>
    <skos:definition>Consumer Goods Leased Under Unconscionable Circumstances refers to the situation where a consumer leases goods from a party who has taken advantage of the consumer's vulnerability, lack of bargaining power, or inability to understand the terms of the lease agreement, resulting in an unfair and unreasonable contract.</skos:definition>
  </rdf:Description>
