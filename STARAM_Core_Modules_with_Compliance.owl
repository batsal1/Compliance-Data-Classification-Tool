  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R2Q4bVPVcokOXs24Jj2I6r">
    <skos:altLabel xml:lang="en-gb">Monetary Consideration Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur monetären Gegenleistung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Consideración Monetaria</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Consideración Monetaria</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de contrepartie monétaire</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">金銭的考慮条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התחשבנות מוניטרית</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मौद्रिक विवेचना शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">货币考虑条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de contraprestação monetária</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Monetary Consideration Clause is a provision in a contract that outlines the specific amount of money that one party agrees to pay to the other party in exchange for goods or services rendered.</skos:definition>
    <rdfs:label>Monetary Consideration Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
