    <rdfs:label>L300 Discovery</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The L300 Discovery concept refers to the process of obtaining evidence and information through various methods such as depositions, written discovery, expert discovery, and document production, among others, as categorized under the UTBMS Litigation code set.</skos:definition>
  </rdf:Description>
