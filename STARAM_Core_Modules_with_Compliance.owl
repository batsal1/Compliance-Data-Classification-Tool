  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9I5NnI41F5zvaAiT1AdU7I">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
    <rdfs:label>Asset Distribution Policy</rdfs:label>
    <skos:definition>Asset Distribution Policy refers to the strategy a fund employs to manage and allocate its investment profits. This policy includes income funds, which regularly distribute profits to investors; accumulation funds, which reinvest profits back into the fund; and mixed funds, which combine both strategies by partially distributing and partially reinvesting profits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8z6Guwq50ERL2mAT13V7E">
    <skos:altLabel xml:lang="en-gb">Opt Out Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">退出条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de exclusión</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">オプトアウト条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de exclusão</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऑप्ट आउट क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de exclusión</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף יציאה מהסכם</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Opt-Out-Klausel</skos:altLabel>
    <rdfs:label>Opt Out Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An opt-out clause is a provision in a contract that allows one or more parties to withdraw from the agreement under certain circumstances.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB9zpRJFhAzcELy6OTNxqNT">
    <skos:example>Judge Ruled Upon Motion</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
    <rdfs:label>ruledUpon</rdfs:label>
    <rdfs:label>sali:ruledUpon</rdfs:label>
    <skos:definition>"Ruled Upon" in legal contexts refers to the act of making a formal decision or judgment by a judicial authority, such as a judge, on a particular matter or motion presented in court. This involves the application of legal principles and reasoning to reach a conclusion that resolves a legal question or directs the course of legal proceedings.</skos:definition>
    <skos:altLabel>ruled upon</skos:altLabel>
    <rdfs:subPropertyOf rdf:resource="https://folio.openlegalstandard.org/RCTNn1zYwKrZiAMp1rQkjx2"/>
    <skos:notation>folio:ruledUpon</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCzr3ZpFWv2ixqL0OkHtiK7">
    <skos:altLabel xml:lang="de-de">Klausel zu früheren Erfindungen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף המציין תגליות קודמות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Prior Inventions Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause sur les inventions antérieures</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">先行発明条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Invenciones Previas</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de invenções anteriores</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">先前发明条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Invenciones Previas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्व आविष्कार शर्त</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Prior Inventions Clause</rdfs:label>
    <skos:definition>A Prior Inventions Clause is a contractual clause that requires an employee to disclose any inventions they have created prior to their employment with the company.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9ha5Zbl8m0uLHHAJObkO9H">
    <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Tratado</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף הסכם</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de tratado</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संधि धारा दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">条约条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Tratado</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de clause de traité</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch aus Vertragsklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">条約条項クレーム</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Treaty Clause Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdZDW8VIPVbM8gI4n7Ippf"/>
    <rdfs:label>Treaty Clause Claim</rdfs:label>
    <skos:definition>A Treaty Clause claim is a legal argument asserting that a particular action or law violates the Treaty Clause of the United States Constitution. This claim contends that the action or law undermines or contradicts the authority granted to the President and the Senate in making and implementing treaties, which requires Senate approval and compliance with the constitutional procedures outlined in the Treaty Clause.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
