  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCn9LUvz0qRZZwYVwFfUzEm">
    <skos:example>Regional Open List: Sweden's Riksdag elections</skos:example>
    <skos:example>National Open List: Finland's Eduskunta elections</skos:example>
    <skos:example>Local Open List: Switzerland's National Council elections</skos:example>
    <skos:altLabel>Voter-Determined List System</skos:altLabel>
    <rdfs:label>Party-List Proportional Representation System - Open List</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Open List Party-List Proportional Representation System allows voters to influence the order of candidates on a party's list by indicating their preference for specific candidates. The number of seats each party wins is determined by the proportion of votes received, and candidates are selected based on their popularity within the party list.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMZqt2BD3qRRYlj61ssnIZ"/>
    <dc:source rdf:resource="https://en.wikipedia.org/wiki/Open_list"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDwq7PYH0atP5hCMh8Bi2KQ">
    <skos:altLabel xml:lang="es-mx">Impedimento Equitativo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estoppel Equitativo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Treu und Glauben basierte Verwirkung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公正な制止</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Estoppel équitable</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायसंगत रोक</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אסטופל חוקי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Estoppel por equidade</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Equitable Estoppel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公平制止</skos:altLabel>
    <skos:definition>Equitable Estoppel is a legal principle that prevents a party from denying or asserting a right, claim, or fact that is inconsistent with their previous conduct or representations, when such denial or assertion would result in injustice or harm to another party.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoKNrz23ylFaWAaoPC3ECY"/>
    <rdfs:label>Equitable Estoppel</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB0XzEfSI8oqgbcFjT74NDl">
    <skos:altLabel xml:lang="es-mx">Cláusula de Terminación por Cualquiera de las Partes</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Termination by Either Party Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">任何一方终止条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigungsklausel durch eine der Parteien</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दोनों पक्षों द्वारा समाप्ति अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Terminación por Cualquiera de las Partes</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הפרדה על ידי כל מצד</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão por qualquer uma das partes</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation par l'une ou l'autre partie</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">いずれかの当事者による終了条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R355Le1zLujnXiHMmYqQNM"/>
    <rdfs:label>Termination by Either Party Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Termination by Either Party Clause is a provision in a contract that allows either party to terminate the agreement without cause or reason.</skos:definition>
  </rdf:Description>
