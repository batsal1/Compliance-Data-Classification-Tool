    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/sKdN7nmxRPWH5-E2V3C2wQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/eH5B3b-8TVewUkbdCnLCrw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Chicken Egg Production</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in raising chickens for egg production. The eggs produced may be for use as table eggs or hatching eggs.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=112310"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCdC2rTRkY2tgCKDkEvc5J">
    <rdfs:label>Federal Preemption</rdfs:label>
    <skos:altLabel xml:lang="fr-fr">Préemption fédérale</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Federal Preemption</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">联邦优先权</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פרימפשן פדרלי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Bundesrecht bricht Landesrecht</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Preemción Federal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">連邦優先権</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Preemción Federal</skos:altLabel>
    <skos:altLabel>Preemption Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फेडरल प्रीम्प्शन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Preempção federal</skos:altLabel>
    <skos:definition>The concept of Federal Preemption refers to the legal principle that federal law takes precedence over state law in cases where there is a conflict between the two.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBoyPCQL9cRuwbjeNvSO55y"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
