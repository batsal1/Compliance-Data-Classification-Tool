    <skos:altLabel xml:lang="es-es">Rescate de prisionero</skos:altLabel>
    <rdfs:label>Rescue of Prisoner</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nac620b7d9b39412aad9677c1be933a12"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
    <rdfs:subClassOf rdf:nodeID="N4e84e4f559a845ef90810e2bb226b5ab"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Rescue of Prisoner is a criminal act against the government that involves the unlawful liberation of a person who is being held in custody.</skos:definition>
  </rdf:Description>
