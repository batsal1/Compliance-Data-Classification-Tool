  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7XyscaXi5Cnm09a2Eu2TyI">
    <skos:altLabel>Present State of Mind or Body</skos:altLabel>
    <skos:altLabel>Then-Existing Mental, Emotional, or Physical Condition</skos:altLabel>
    <rdfs:label>Existing Mental, Emotional, Physical Condition</rdfs:label>
    <dc:source>Fed. R. Evid. 803(3)</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1EbxjQwzgikspixQygdfK"/>
    <skos:definition>Existing Mental, Emotional, or Physical Condition is a hearsay exception that allows the admission of statements that describe the declarant's then-existing state of mind, feeling, sensation, or bodily health. This exception is based on the belief that such statements are reliable because they are made in the moment and are unlikely to be fabricated.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/legislation#prescribesForm">
