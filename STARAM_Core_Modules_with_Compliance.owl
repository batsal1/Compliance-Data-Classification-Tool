  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC3euDMxqhEPP2QEmyvpTyz">
    <skos:altLabel xml:lang="fr-fr">Clause de bonus de performance</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">業績ボーナス条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Performance Bonus Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Leistungsbonusklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">绩效奖金条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de bonificación por desempeño</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रदर्शन बोनस क्लॉज</skos:altLabel>
