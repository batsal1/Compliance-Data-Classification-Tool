  <rdf:Description rdf:about="https://folio.openlegalstandard.org/6UpqETxiSjC4olDuqoHFrg">
    <skos:example>Paper bags merchant wholesalers</skos:example>
    <skos:example>Wrapping paper (except gift wrap) merchant wholesalers</skos:example>
    <skos:example>Plastics foam products, disposable (except packaging, packing), merchant wholesalers</skos:example>
    <skos:example>Paper and disposable plastics tableware (e.g., utensils, dishes, cups) merchant wholesalers</skos:example>
    <skos:example>Paper and disposable plastics shipping supplies merchant wholesalers</skos:example>
    <skos:example>Plastics bags merchant wholesalers</skos:example>
    <skos:example>Sanitary paper products merchant wholesalers</skos:example>
    <skos:example>Corrugated paper merchant wholesalers</skos:example>
    <skos:example>Paper napkins merchant wholesalers</skos:example>
    <skos:example>Waxed paper merchant wholesalers</skos:example>
    <skos:example>Paperboard and disposable plastics boxes and containers merchant wholesalers</skos:example>
    <skos:example>Paper towels merchant wholesalers</skos:example>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of kraft wrapping and other coarse paper, paperboard, converted paper (except stationery and office supplies), and/or related disposable plastics products.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/8U0OpbqaR263dfEgM9qnpA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424130"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Industrial and Personal Service Paper Merchant Wholesalers</rdfs:label>
  </rdf:Description>
