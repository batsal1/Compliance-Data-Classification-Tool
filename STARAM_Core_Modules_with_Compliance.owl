  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9K0T0vCgJCDtLMy4AnuJfQ">
    <skos:definition>In immigration law, refugee parole refers to the temporary admission of a foreign national into a country for humanitarian reasons, urgent medical treatment, or other special circumstances, without formally admitting them as permanent residents.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCjf3VBil5V7nwAGjhEkGIC"/>
    <rdfs:label>Refugee Parole Claim</rdfs:label>
  </rdf:Description>
