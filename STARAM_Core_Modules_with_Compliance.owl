  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7l492OzFfZUEluIFBwy3xI">
    <skos:altLabel xml:lang="de-de">Zivilprozessrechtliche Theorien</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">民事诉讼法律理论</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Litigation Civil Legal Theories</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Teorías legales civiles de litigio</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Teorías legales civiles de litigación</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">民事訴訟法的法的理論</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Teorias jurídicas civis de litígio</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Théories juridiques civiles en matière de litiges</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תאוריות משפטיות אזרחיות של תביעה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिटिगेशन सिविल कानूनी सिद्धांत</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Litigation Civil Legal Theories</rdfs:label>
    <skos:definition>Litigation Civil Legal Theories refer to the various legal arguments and principles that are used in civil litigation cases, such as the doctrine of collateral estoppel or comparative negligence, to support a party's claim or defense.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7g6hIlYwNHcKfQtP7NoXaO">
    <skos:altLabel xml:lang="es-es">Gastos de proveedores de apoyo a litigios</skos:altLabel>
