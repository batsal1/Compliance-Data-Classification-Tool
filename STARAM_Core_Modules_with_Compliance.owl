    <skos:altLabel xml:lang="es-es">Negligencia médica del médico de familia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">家庭医生过失行为</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">家庭医師の医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle du médecin de famille</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית של רופא משפחתי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fehlerhafte Behandlung durch Familienmediziner</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">परिवार वैद्यकीय लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica del médico familiar</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Family Practitioner Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica do médico de família</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdfs:label>Family Practitioner Malpractice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Negligent or wrongful actions or omissions committed by a family practitioner in the course of providing medical care to a patient, resulting in harm or injury to the patient or a failure to diagnose or treat a medical condition.</skos:definition>
  </rdf:Description>
