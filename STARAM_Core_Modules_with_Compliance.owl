    <skos:altLabel xml:lang="es-mx">Estoppel in Pais</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">Estoppel in Pais</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Estoppel in Pais</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אסטופל בפייס</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estoppel in Pais</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">Estoppel in Pais</skos:altLabel>
    <rdfs:label>Estoppel in Pais</rdfs:label>
    <skos:definition>A legal principle that prevents a party from denying or asserting something contrary to what they previously represented or allowed to be assumed, when such representation or assumption was relied upon by another party to their detriment.</skos:definition>
