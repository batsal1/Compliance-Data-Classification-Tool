  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Bu0U5ru3yBeWZ0x4zE6XA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdfs:label>Public Benefit Diversion Objective</rdfs:label>
    <skos:definition>Public Benefit Diversion Objective refers to policy goals aimed at reducing dependency on long-term public assistance by encouraging alternative means of support, such as employment or private aid. Methods can include offering lump-sum payments, vouchers, or services like job training and placement to encourage individuals to transition away from ongoing public benefit programs.</skos:definition>
  </rdf:Description>
