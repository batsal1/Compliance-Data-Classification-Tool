  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7fGGaO3fruO5xNWT14tbky">
    <skos:definition>Hospice Negligence refers to a legal claim for damages resulting from the failure of a hospice provider to provide adequate care and treatment to a patient who is terminally ill or in need of end-of-life care.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit im Hospiz</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ホスピスの過失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हॉस्पिस लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en hospicio</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Hospice Negligence</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en cuidados paliativos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence en hospice</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em hospice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">临终关怀疏忽</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות במוסד סיעודי לסובלנות</skos:altLabel>
    <rdfs:label>Hospice Negligence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTfuHMNjRRfSojEjNSX2d5w">
    <skos:prefLabel>X114 Local Travel</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtpnOBk4lRnWigpEBBKYUDQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Any ground transportation (taxi, subway), mileage and parking associated with local travel. Excludes billable travel time (A115). If client requires a more granular breakdown, law firm or legal vendor should submit separate itemized expense line items.</skos:definition>
    <rdfs:label>X114 Local Travel</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8sP07TrV8J1AcB5noaSWua">
    <skos:altLabel xml:lang="ja-jp">医療輸送の過失</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en el transporte médico</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência no transporte médico</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">医疗运输过失</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Medical Transport Negligence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en el transporte médico</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मेडिकल ट्रांसपोर्ट लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence dans le transport médical</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות בהובלה רפואית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit im medizinischen Transport</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <skos:definition>Medical transport negligence refers to a claim of medical malpractice that arises from the negligent transportation of a patient, such as by ambulance or air transport.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Medical Transport Negligence</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBPBR40owNZHgrPtNxN4jXd">
    <skos:altLabel xml:lang="de-de">Schutz des Anwaltsgeheimnisses</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Protection du travail de l'avocat</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Protección del trabajo del abogado</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגנת מוצר עבודת עורך דין</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Attorney Work Product Protection</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Proteção do trabalho do advogado</skos:altLabel>
