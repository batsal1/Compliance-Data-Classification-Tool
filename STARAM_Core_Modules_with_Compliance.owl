    <skos:altLabel xml:lang="fr-fr">Clause de médiation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Mediación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schiedsklausel</skos:altLabel>
    <skos:definition>A mediation clause is a provision in a contract that requires the parties to attempt to resolve any disputes through mediation before pursuing legal action.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Mediation Clause</rdfs:label>
