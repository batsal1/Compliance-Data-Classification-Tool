  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9HvPWWjPpu4MmrQybmynCG">
    <skos:altLabel xml:lang="ja-jp">物的損害条項の定義</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मटेरियल डैमेज क्लॉज की परिभाषा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de la cláusula de daño material</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição da cláusula de danos materiais</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Definition of Material Damage Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de la cláusula de daños materiales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">物质损害条款定义</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de la clause de dommages matériels</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת סעיף נזק חומרי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition der Klausel für materielle Schäden</skos:altLabel>
    <skos:definition>A Material Damage Clause is a provision in a contract that outlines the responsibilities and liabilities of the parties involved in the event of physical harm or destruction to the subject matter of the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Definition of Material Damage Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
