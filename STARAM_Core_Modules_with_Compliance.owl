    <skos:altLabel xml:lang="zh-cn">案件评估、开发、管理</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Evaluación, Desarrollo y Administración de Casos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Case Assessment, Development, Administration</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Evaluación, Desarrollo y Administración de Casos</skos:altLabel>
