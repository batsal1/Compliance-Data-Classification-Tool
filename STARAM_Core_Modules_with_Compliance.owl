  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBgKnOpRzmN0EAjwIwILJoc">
    <skos:altLabel xml:lang="zh-cn">刑事索赔要素</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Elements of Criminal Claim</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Éléments de la demande pénale</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Elementos de la Demanda Penal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आपराधिक दावे के तत्व</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">刑事請求の要素</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אלמנטים של תביעה פלילית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Elemente des Strafanspruchs</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Elementos de la Demanda Penal</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Elementos da ação penal</skos:altLabel>
    <rdfs:label>Elements of Criminal Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDspRIwoJTlopUDjSgLRduf"/>
    <skos:definition>The Elements of Criminal Claim refer to the specific components that must be proven in a criminal case, including the harm caused, the intent of the accused, and the causal link between the two.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N563191fcbf3744bf932b23e57a59d912">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
