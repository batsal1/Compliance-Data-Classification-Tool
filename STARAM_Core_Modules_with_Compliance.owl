    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4pYCvaJ8nADRG8NCwgCoa"/>
    <skos:definition>This industry group comprises establishments primarily engaged in the merchant wholesale distribution of sporting, recreational, toy, hobby, and jewelry goods and supplies, and precious stones and metals.</skos:definition>
    <rdfs:label>Miscellaneous Durable Goods Merchant Wholesalers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
