  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Reh0yxWlrRrqdF73F5by0ig">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>WC340 Expert Discovery</rdfs:label>
    <skos:prefLabel>WC340 Expert Discovery</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rtk9_RnfyT9yacC_QKTzn8Q"/>
    <skos:definition>Preparing expert discovery and deposition notices, Communicating with expert and opposing counsel, Preparing subpoena to secure experts (vocational/ medical/other) appearance at deposition/trial, Discussing deposition strategy, Preparation for and consultation with expert, Reviewing expert documents/records and/or films review, Drafting expert summaries, Preparation for and consultation with expert, Arranging and scheduling Independent Medical Examinations (IME) and Impairment Rating Evaluations (IRE), Review &amp; Analysis of Independent medical examination (IME) &amp; impairment rating evaluation (IRE), Communicating with expert (vocation/medical and other) and obtaining vocational documents</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#RiskCategory">
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#EPCContractRiskModule"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A concept used to classify risks. Categories live in SKOS concept schemes; two schemes are shipped with this ontology (a 21-term legal-review taxonomy and a 7-term allocation/lifecycle taxonomy) and are related to each other by SKOS mapping properties.</skos:definition>
    <rdfs:label xml:lang="en">Risk Category</rdfs:label>
  </rdf:Description>
