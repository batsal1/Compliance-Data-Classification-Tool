  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB0w4uJmnEFVNgvqYNUi79a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en-gb">Amicable Resolution Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Resolución Amistosa</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Resolución Amistosa</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">友好解决条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résolution amiable</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פתרון ידידותי</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मैत्रीपूर्ण समाधान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">円満解決条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur einvernehmlichen Lösung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de resolução amigável</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>An Amicable Resolution Clause is a provision in a contract that requires the parties to attempt to resolve any disputes or disagreements through peaceful and cooperative means before resorting to legal action.</skos:definition>
    <rdfs:label>Amicable Resolution Clause</rdfs:label>
  </rdf:Description>
