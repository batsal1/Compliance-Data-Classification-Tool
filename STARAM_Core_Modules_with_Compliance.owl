    <rdfs:label>Banking, Commercial Paper, and Creditor Claims</rdfs:label>
    <skos:definition>Banking, Commercial Paper, and Creditor Claims refer to legal claims and disputes related to banking transactions, commercial paper, and creditor rights, including issues such as dishonored checks, wrongful foreclosures, and fraudulent transfers.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
