    <skos:definition>Actor or party in the litigation who is also an expert in the field at issue.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R79RiYiW56ZpJMZgfwpJxFB">
    <rdfs:label>Pregnancy Discrimination</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Pregnancy Discrimination</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schwangerschaftsdiskriminierung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Discriminação por gravidez</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Discriminación por embarazo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गर्भावस्था भेदभाव</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Discriminación por embarazo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">怀孕歧视</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">妊娠差別待遇</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Discrimination liée à la grossesse</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפלה דיסקרימינציה</skos:altLabel>
