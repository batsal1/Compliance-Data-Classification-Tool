  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDMmocc9Ine34BK9vSksb0k">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Dependable AI</skos:altLabel>
    <skos:altLabel>Credible AI</skos:altLabel>
    <rdfs:label>Trustworthy AI</rdfs:label>
    <skos:prefLabel>Reliable AI</skos:prefLabel>
    <skos:definition>Trustworthy AI is an AI system characterized by three main components: (1) it must be lawful, ensuring compliance with all applicable laws and regulations, (2) it should be ethical, demonstrating respect for and adherence to ethical principles and values, and (3) it should be robust, both technically and socially, to prevent unintentional harm. Trustworthy AI concerns the trustworthiness of the AI system itself and includes all processes and actors involved in the AI system's life cycle, emphasizing respect for human rights and democratic values.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Roz2YupppM6kRN8NwAhQ4x">
    <skos:altLabel xml:lang="pt-br">Linguagem de violação de deveres fiduciários mais provável do que não</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wahrscheinlicher als nicht verstoßen gegen Treuepflichtsprache</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">「おそらく違反する」信託義務違反の言語</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Langage de violation des devoirs fiduciaires plus probable que non</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">“更可能违反”违反受托责任语言</skos:altLabel>
    <rdfs:label>"More likely than not" Violate Fiduciary Duties Language</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDnJ5pHeJZuA0vHQXYalZO6"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9kHJwRBkXjBRaeSNiyPWY"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDxvjss5OK7lnAY9w2RaGeB"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ksYmaNhrwE6VL9r0qV1sL"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"More likely than not" Violate Fiduciary Duties Language refers to a specific phrase or wording used in legal documents that suggests a high probability of breaching fiduciary duties by a party, which may result in legal consequences.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Xnvf9ThDb99RM1dpQnH2L">
    <skos:altLabel xml:lang="hi-in">सुविधाजनक कार्य या सुधार के लिए अनुमोदन या अनुपस्थिति</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ato ou omissão razoável para correção</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acto o Omisión Razonable para Corregir</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合理な行為または過失の修正</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合理行为或不作为以纠正</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reasonable Act or Omission to Correct</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Acte ou omission raisonnable pour corriger</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acto u Omisión Razonable para Corregir</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Angemessene Handlung oder Unterlassung zur Korrektur</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולה או התעלמות סבירה לתיקון</skos:altLabel>
    <rdfs:label>Reasonable Act or Omission to Correct</rdfs:label>
    <skos:definition>A "Reasonable Act or Omission to Correct" refers to a legal concept within the larger framework of "Governmental Immunity for Condition of Public Property," which allows a government entity to avoid liability for injuries caused by a dangerous condition on public property if they can show that they acted reasonably in attempting to correct the condition or that their decision not to correct the condition was also reasonable.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCHbjppawvAlt5WcUyfjeN8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBiZ9niDrCJlY0UyvdZ1v3m">
    <skos:altLabel xml:lang="en-gb">Classes of Goods and Services</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Waren- und Dienstleistungsklassen</skos:altLabel>
