  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9pjDPV7ETWS05AjZIOlqil">
    <skos:altLabel xml:lang="he-il">סעיף זכות לפיצויים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de derecho a indemnización</skos:altLabel>
