  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7eATaojOKUvWDxLLinFIxg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
    <rdfs:label>Stakeholders and Partnerships Risk</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
    <skos:definition>The threats and opportunities associated with an organization's partners and stakeholder demographics, characteristics, and activities. This includes the potential for negative consequences arising from an organization's inability to effectively manage relationships with key stakeholders, such as customers, suppliers, investors, or partners. Causes can include poor communication, misaligned expectations, or unaddressed concerns, potentially leading to diminished trust, reduced collaboration, or loss of support, ultimately impacting the organization's overall performance, reputation, and growth opportunities</skos:definition>
  </rdf:Description>
