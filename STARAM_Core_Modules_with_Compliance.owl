  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCpk7MQaCVMmCF57e1nm8PJ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="en-gb">Agreement Null and Void Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פסולת הסכם ובטלויות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">协议无效条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Nulidade de Acordo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de nulidad y anulación del acuerdo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de nullité d'accord</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de nulidad y anulación del acuerdo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Nichtigkeitserklärung von Vereinbarungen</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समझौता निरस्त और अमान्य धारा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">協定の無効条項</skos:altLabel>
    <skos:definition>An agreement null and void clause is a provision in a contract that declares the entire agreement to be invalid and unenforceable if a specific condition or event occurs, such as a breach of contract or illegality of the agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Agreement Null and Void Clause</rdfs:label>
  </rdf:Description>
