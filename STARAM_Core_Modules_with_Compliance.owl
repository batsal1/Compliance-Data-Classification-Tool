  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RH_1AK1sfSsWwaT-fpEG2WQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqWEj2n_aQXyfLT5Z4KzCow"/>
    <skos:prefLabel>TR250 Publication Watches</skos:prefLabel>
    <skos:definition>All actions associated with planning, completing, and reporting the results of periodic searches for conflicting trademarks. For example, this may include monitoring the file history of trademark applications, and/or publication for opposition. Work of outside vendors in conducting searches or otherwise assisting the investigation should be expensed under E100.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>TR250 Publication Watches</rdfs:label>
  </rdf:Description>
