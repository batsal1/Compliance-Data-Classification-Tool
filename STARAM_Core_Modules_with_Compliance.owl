  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8SBI3x3TFVnxpSe2TLwn7">
    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo de Diferimiento Salarial</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेतन अवरण समझौता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">給与支払い先延期契約条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכם העברת שכר</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Gehaltsabtretungsvereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Acordo de Adiamento Salarial</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">工资推迟协议条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'accord de report de salaire</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo de Diferimiento Salarial</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Salary Deferral Agreement Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Salary Deferral Agreement Clause</rdfs:label>
    <skos:definition>A Salary Deferral Agreement Clause is a provision in a contract that allows an employee to defer a portion of their salary to a later date, typically for retirement savings purposes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nda74162564db4c6694a5c96ae2058b26">
