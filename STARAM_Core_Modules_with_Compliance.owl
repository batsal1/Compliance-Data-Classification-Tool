  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9qhyZbQlG5lHtijZL6Kt3l">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Idea-Expression Dichotomy</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe"/>
    <rdfs:label>Idea-Expression Distinction</rdfs:label>
    <skos:definition>The Idea-Expression Dichotomy in copyright law distinguishes between ideas, which are free for all to use, and the expression of those ideas, which may be protected. This principle asserts that copyright does not extend to ideas, procedures, concepts, or methods of operation, but only to their particular expression.</skos:definition>
  </rdf:Description>
