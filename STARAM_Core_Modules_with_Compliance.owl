  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn">
    <skos:altLabel xml:lang="es-es">Reclamaciones de responsabilidad de propiedad e instalaciones</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations pour responsabilité des biens et des locaux</skos:altLabel>
    <skos:altLabel>Premises Liability Claims</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">财产和场所责任索赔</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संपत्ति और स्थान दायित्व दावे</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות אחריות נכסים ומתקנים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche wegen Sach- und Gebäudehaftung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de responsabilidade por propriedade e instalações</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones de responsabilidad de propiedad e instalaciones</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Property &amp; Premises Liability Claims</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">財産および敷地責任請求</skos:altLabel>
    <skos:altLabel>Property Claims</skos:altLabel>
    <skos:definition>Property &amp; Premises Liability Claims refer to legal claims made against a property owner or occupier for injuries or damages suffered by individuals on their property due to unsafe or hazardous conditions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:nodeID="N702c40d53aef4248ad93865779aeddb2"/>
    <skos:prefLabel>Real Estate Claims</skos:prefLabel>
    <rdfs:label>Property &amp; Premises Liability Claims</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9mAcao22ayeGuvXlq5mfs">
    <skos:altLabel xml:lang="en-gb">Federal Trade Commission Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de la Ley Federal de Comercio</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Lei da Comissão Federal de Comércio</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फेडरल ट्रेड कमीशन एक्ट दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de la Ley de la Comisión Federal de Comercio</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">联邦贸易委员会法索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch nach dem Bundesgesetz über die Handelskommission</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la Commission fédérale du commerce</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">連邦取引委員会法クレーム</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק המחוזי של הוועד למסחר הפדרלי</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N93d9c9f92f2e4e27a40a26230ad31c4a"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB"/>
    <skos:definition>A Federal Trade Commission Act Claim is a legal claim that alleges a violation of the laws and regulations enforced by the Federal Trade Commission, which is responsible for protecting consumers from unfair or deceptive business practices.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Federal Trade Commission Act Claim</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#amendsComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">The component the remedy would rewrite, insert after, or delete.</skos:definition>
