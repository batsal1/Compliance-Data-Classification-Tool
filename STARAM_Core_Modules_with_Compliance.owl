    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Joint and Several Liability is a legal concept where multiple parties can be held responsible for the same damages or debt, and each party can be held liable for the entire amount.</skos:definition>
  </rdf:Description>
