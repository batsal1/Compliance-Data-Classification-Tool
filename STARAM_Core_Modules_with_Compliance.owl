    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermEnvironmentalReports"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9ytmPdgahEqzmq3LfI7ak">
    <skos:altLabel xml:lang="pt-br">Prática de Processamento de Documentos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de traitement de documents</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दस्तावेज़ प्रसंस्करण अभ्यास</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">文件处理实践</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול עיבוד מסמכים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Processing of Documents Practice</skos:altLabel>
    <skos:altLabel>Processing of Documents Service</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de Procesamiento de Documentos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verarbeitung von Dokumentenpraxis</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de Procesamiento de Documentos</skos:altLabel>
    <skos:altLabel>Processing of Documents</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">文書処理の実践</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N16d96ba4cda04567880b4c1634e6aa76"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB5lx7xpeCS48DusHwMKcU3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Processing of Documents Practice</rdfs:label>
    <skos:definition>The Processing of Documents Practice refers to the specific legal work involved in collecting and producing documents in the course of a legal matter, and is a subcategory of the Document Collection and Production Practice.</skos:definition>
  </rdf:Description>
