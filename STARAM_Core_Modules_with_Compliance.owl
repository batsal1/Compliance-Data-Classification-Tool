    <rdfs:label>Incest</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8TvbewYypS9Uy4y5JGIwEH"/>
    <skos:definition>Nonforcible sexual intercourse between persons who are related to each other within the degrees wherein marriage is prohibited by law.</skos:definition>
