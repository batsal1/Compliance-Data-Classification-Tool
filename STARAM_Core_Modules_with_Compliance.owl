    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvtywUiDKBUTbufifIxsAh"/>
    <rdfs:label>Observing Deposition</rdfs:label>
    <skos:definition>Observing Deposition: The act of attending and watching a deposition, without actively participating, in a manner consistent with the posture of a deposition.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB75twqAG4g7h0XQODTRwNA">
    <skos:altLabel xml:lang="en-gb">Corporate Separateness Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法人分離条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de separação corporativa</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Unternehmensabgrenzung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कॉर्पोरेट अलगाव शर्त</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הפרדה תאגידית</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de séparation des entreprises</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Separación Corporativa</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公司分离条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Separación Corporativa</skos:altLabel>
    <rdfs:label>Corporate Separateness Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Corporate Separateness Clause is a provision in a contract that establishes the legal independence of a corporation from its shareholders and directors, shielding them from personal liability for the corporation's debts and obligations.</skos:definition>
  </rdf:Description>
