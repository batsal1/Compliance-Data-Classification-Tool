    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBY4j5UKZ7L8gp0q9Wrxyge"/>
    <skos:definition>A volunteer is an individual who offers services or time without the expectation of monetary compensation. Volunteers typically work for charitable, nonprofit, or public organizations to support causes or communities they care about.</skos:definition>
    <rdfs:label>Volunteer</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
