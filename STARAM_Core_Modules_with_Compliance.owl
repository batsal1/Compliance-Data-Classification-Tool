  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RhBvOCNsTuHs1L1cRSwWuL">
    <skos:prefLabel>Parole</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="Nf88b45105efc482c9a8ca5c152ae58ef"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl"/>
