  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC2P0YZS5Ku67wmSwN4OxWs">
    <dc:identifier>PUB</dc:identifier>
    <dc:identifier>IN-INDUSTRY-15</dc:identifier>
    <skos:altLabel xml:lang="fr-fr">Industrie de l'administration publique</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Public Administration Industry</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Öffentliche Verwaltung</skos:altLabel>
    <skos:altLabel>Public Administration</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公共行政産業</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公共行政产业</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית המנהל הציבורי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de la Administración Pública</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de Administração Pública</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de la Administración Pública</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सार्वजनिक प्रशासन उद्योग</skos:altLabel>
    <rdfs:label>Public Administration Industry</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=92"/>
    <skos:hiddenLabel>PUB</skos:hiddenLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Public Administration Industry</skos:prefLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-PUB</ns2:legacyIdentifier>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
    <skos:definition>The Public Administration industry group consists of establishments of federal, state, and local government agencies that administer, oversee, and manage public programs and have executive, legislative, or judicial authority over other institutions within a given area. These agencies also set policy, create laws, adjudicate civil and criminal legal cases, provide for public safety and for national defense.</skos:definition>
  </rdf:Description>
