  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RClpyzYDnwYUrhdxex3JJJx">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="he-il">סעיף התחייבות ברירת מחדל מצטברת</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kreuz-Verfallsklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">交叉违约条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de défaut croisé</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्रॉस डिफॉल्ट प्रावधान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de incumplimiento cruzado</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de incumplimiento cruzado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Cross Default Provision Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">クロスデフォルト条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Inadimplência Cruzada</skos:altLabel>
    <skos:definition>A Cross Default Provision Clause is a clause in a contract that allows a creditor to declare a default if the debtor defaults on any other debt.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cross Default Provision Clause</rdfs:label>
  </rdf:Description>
