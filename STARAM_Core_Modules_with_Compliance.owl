    <rdfs:subClassOf rdf:nodeID="Nd492eabb7d4f4734b6861a2f59c7155d"/>
    <skos:definition>The Analysis of Documents Practice is a legal service that involves the examination and evaluation of documents in the context of a legal matter, and is a subset of the Document Collection and Production Practice.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Analysis of Documents Practice</rdfs:label>
  </rdf:Description>
