    <skos:altLabel xml:lang="he-il">תהליך הגשת בקשת תשלום</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">费用申请流程</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फी आवेदन प्रक्रिया</skos:altLabel>
    <skos:altLabel>Bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fee Application Process</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Proceso de solicitud de tarifas</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">手数料申請プロセス</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Processus de demande de frais</skos:altLabel>
    <rdfs:label>Fee Application Process</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Fee Application Process (Bankruptcy) refers to the procedure for requesting payment of fees incurred during a bankruptcy case, including attorney fees and other expenses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7rEmc9PaAz1JI1YpYZGaDg"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7XItu3tE7QqpQuiRvkS06U">
    <skos:altLabel xml:lang="hi-in">पेटेंट-एजेंट विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège de l'agent de brevets</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Patent-Agent Privilege</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">专利代理人特权</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio del Agente de Patentes</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">特許代理人特権</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Patentanwaltsprivileg</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות הסוכן לפטנטים</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio do agente de patentes</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privilegio del Agente de Patentes</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy>In re Queen's Univ. at Kingston, 820 F.3d 1287, 118 U.S.P.Q.2d 1221 (Fed. Cir. 2016)</rdfs:isDefinedBy>
    <skos:definition>The Patent-Agent Privilege is a legal protection that allows communications between a patent agent and their client to remain confidential and not be disclosed in court, similar to attorney-client privilege.</skos:definition>
    <rdfs:label>Patent-Agent Privilege</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7kD4ePZmjNDaw2a1pWIDds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Transaction Negotiation Dynamics</rdfs:label>
    <skos:definition>Transaction negotiation dynamics refer to the processes and interactions involved in negotiating the terms and conditions of a business transaction between parties. These dynamics encompass various strategies, styles, and behaviors that influence the negotiation's outcome, including the degree of cooperation, conflict, and communication between the parties involved.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e"/>
    <skos:altLabel>Transactional Bargaining Dynamics</skos:altLabel>
  </rdf:Description>
