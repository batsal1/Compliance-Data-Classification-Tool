  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMDFW4aA6Bbtce0T9sqGZX">
    <skos:altLabel xml:lang="es-mx">Presunción de muerte por ausencia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुपस्थिति से मृत्यु की पूर्वाभास</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不在による死亡推定</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Presumption of Death From Absence</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Presunción de muerte por ausencia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vermutung des Todes durch Abwesenheit</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">失踪死亡推定</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הנחת מוות מהיעדרות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Presunção de morte por ausência</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Présomption de décès par absence</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Presumption of Death From Absence</rdfs:label>
    <skos:definition>A legal presumption that a person is deceased when they have been absent for a certain period of time without any evidence of being alive, often used in trust and estate claims.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3SDQBy4KfjSgp3bgpb4Fx"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCeMeMkbzNzWOKmp6XaitcC">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxq2qQYpdo9stHOBIQhub7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Roadway Dedication</rdfs:label>
    <skos:definition>Roadway Dedication is the legal process by which a private entity or individual transfers land to a public entity for the specific purpose of constructing or expanding a public road. This act typically requires formal documentation, legal agreements, and may involve negotiations between private and public parties to meet local planning and zoning requirements.</skos:definition>
  </rdf:Description>
