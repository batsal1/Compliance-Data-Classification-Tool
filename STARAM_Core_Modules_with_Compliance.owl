  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBmedei8nsbLYt6jAvuKQJ6">
    <skos:altLabel xml:lang="de-de">Auslieferung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Extradition</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रत्यर्पण</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Extradição</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">引き渡し</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">引渡</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Extradición</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Extradición</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגרלה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Extradition</skos:altLabel>
    <skos:definition>The concept of Extradition refers to the legal process of transferring an individual who has been accused or convicted of a crime from one jurisdiction to another for the purpose of facing trial or punishment.</skos:definition>
    <rdfs:label>Extradition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBV3MQlbGLIUVo5fSiBZ2V4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBULGg2FFyRHBhJSE0GP8n3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <skos:prefLabel>Social Security Benefits</skos:prefLabel>
    <rdfs:label>Old Age Public Benefits</rdfs:label>
    <skos:definition>Old Age Public Benefits refer to government programs designed to provide financial assistance, healthcare, and other forms of support to individuals who have reached retirement age. These programs aim to ensure a reasonable standard of living and access to necessary services for elderly citizens.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
  </rdf:Description>
