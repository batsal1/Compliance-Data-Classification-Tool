  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Q0Apwmq4R0C0PGdxFiso7Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=8111"/>
    <rdfs:label>Automotive Repair and Maintenance</rdfs:label>
    <skos:definition>This industry group comprises establishments involved in providing repair and maintenance services for automotive vehicles, such as passenger cars, trucks, and vans, and all trailers. Establishments in this industry group employ mechanics with specialized technical skills to diagnose and repair the mechanical and electrical systems for automotive vehicles, repair automotive interiors, and paint or repair automotive exteriors.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pJlgZDelUlrPrZ9dZ6GM2"/>
  </rdf:Description>
