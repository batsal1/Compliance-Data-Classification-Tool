  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy"/>
    <rdfs:label>Originality</rdfs:label>
    <skos:altLabel>Creative</skos:altLabel>
    <skos:definition>Originality in copyright law requires that a work must be independently created and possess a minimum degree of creativity. This concept ensures that copyright protection is granted only to works that reflect the author's own intellectual effort and not mere copies or trivial variations of existing works.</skos:definition>
  </rdf:Description>
