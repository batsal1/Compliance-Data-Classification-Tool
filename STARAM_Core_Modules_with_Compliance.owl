  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rt7y5QJoXmShB4OEPQ8Ysl">
    <skos:example>Nutrition Counseling Programs</skos:example>
    <skos:example>Health Food Stores</skos:example>
    <skos:example>Allergy-Friendly Foods</skos:example>
    <skos:example>Dietary Supplements</skos:example>
    <skos:example>Gluten-Free Products</skos:example>
    <skos:prefLabel>Dietary Health Market</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The nutrition market segment refers to a division of the market that is specifically targeted towards consumers who are interested in dietary and nutritional health. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek to maintain or improve their health through balanced and healthy eating habits, dietary supplements, and nutrition-focused products.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBXoCwCeY64Ow60nWKSZCC"/>
    <rdfs:label>Nutrition Market Segment</rdfs:label>
  </rdf:Description>
