  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCG4QF2vhgY9jI81Z8dII42">
    <skos:altLabel xml:lang="hi-in">वाणी की स्वतंत्रता का दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de Libertad de Expresión</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">言论自由主张</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Meinungsfreiheit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">言論の自由主張</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de la liberté d'expression</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת חופש הביטוי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da liberdade de expressão</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de Libertad de Expresión</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Freedom of Speech Claim</skos:altLabel>
    <skos:prefLabel>Freedom of Expression</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Freedom of Speech</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UZkDXz7Wg2AtyHFQEeySC"/>
    <skos:definition>A freedom of speech claim is a legal action initiated by an individual or entity alleging that their right to freedom of speech, as protected by the law (e.g., First Amendment of the United States Constitution), has been violated by the government or a government actor. The freedom of speech guarantees that the government shall not abridge the freedom of speech, which includes the right to express opinions, ideas, and beliefs without censorship or restraint. A freedom of speech claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts speech, when a public employee is disciplined for exercising their speech rights, or when a public forum is improperly restricted.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDdLo2isiJ66JtQdLPnEOOr">
    <skos:example>Games and Puzzles Market</skos:example>
    <skos:example>Collectibles Market</skos:example>
    <skos:example>Sci-Fi and Fantasy Market</skos:example>
    <skos:example>Birdwatching Market</skos:example>
    <skos:example>Genealogy and Ancestry Market</skos:example>
    <skos:example>Crafting Market</skos:example>
    <skos:example>Antiquing and Antiques</skos:example>
    <skos:definition>The hobbies market segment refers to a division of the market that is specifically targeted towards consumers who are interested in activities and products related to leisure and recreational pursuits. This segment encompasses products and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek to engage in hobbies for relaxation, enjoyment, and personal fulfillment.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Tktpdf3HuYd3nI7nf9xQU"/>
    <rdfs:subClassOf rdf:nodeID="Na773c3e655a846e2808e1b26abfe2825"/>
    <rdfs:subClassOf rdf:nodeID="N6a4f3bd7a8064f60b27f257f6ab1b2c2"/>
    <rdfs:label>Hobbies Market Segment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Leisure Activities Market</skos:prefLabel>
  </rdf:Description>
