    <skos:altLabel xml:lang="he-il">סעיף הסכם נוזקות נזילות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Liquidity Covenant Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिक्विडिटी कवेनेंट क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de convenant de liquidez</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Liquidity Covenant Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Liquidity Covenant Clause is a provision in a contract that requires a party to maintain a certain level of liquidity or cash reserves to ensure their ability to meet financial obligations.</skos:definition>
  </rdf:Description>
