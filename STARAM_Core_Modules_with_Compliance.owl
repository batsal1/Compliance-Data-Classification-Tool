    <skos:altLabel xml:lang="fr-fr">Clause de modification de nom</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">更名修正条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नाम बदलाव संशोधन शर्त</skos:altLabel>
