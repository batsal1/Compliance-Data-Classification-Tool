  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8QJDc8SCwsfsJARkyevIJ0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>UTBMS Litigation refers to the standardized codes used to categorize legal activities and expenses related to the litigation process, including discovery, pre-trial pleadings and motions, trial preparation and trial, and appeal.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDGDqe9RukedToMQPIHmwJe"/>
    <rdfs:subClassOf rdf:nodeID="N193d3b7a99c64b65a1a93b39583ac9e8"/>
    <rdfs:label>UTBMS Litigation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCd74urSVFTnw2GfIuxk39D">
    <skos:altLabel xml:lang="he-il">ייצוגים ואחריות ביניים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Intermediate Representations and Warranties</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representações e garantias intermediárias</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">中間表現と保証</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zwischenrepräsentationen und Garantien</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Représentations et garanties intermédiaires</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Representaciones y Garantías Intermedias</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representaciones y Garantías Intermedias</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">中间表述和保证</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इंटरमीडिएट प्रतिनिधित्व और वारंटी</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Intermediate Representations and Warranties</rdfs:label>
    <skos:definition>Intermediate Representations and Warranties refer to the statements and assurances made by parties involved in a contract or agreement that fall between standard and extensive warranties. These representations often cover specific aspects of the transaction or product, providing a moderate level of protection and assurance for both parties.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCV40j08zvRl2faFV72w9aQ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCL6FYZn8Qt6m4Z71arBnIb">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R981K5l1Ju5uHj4jVRSUCJQ"/>
    <skos:altLabel xml:lang="pt-br">Reivindicação de Falha em Fornecer Registros de Salário</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure to Provide Wage Records Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por falta de entrega de registros salariales</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Nichtvorlage von Lohnunterlagen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על חוסר הספקת רשומות שכר</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未提供工资记录索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour non-fourniture de relevés de salaire</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃金記録提出請求の不履行</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेतन रिकॉर्ड प्रदान न करने का दावा फेल</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por falta de entrega de registros salariales</skos:altLabel>
    <skos:prefLabel>Pay Stub Violation Claim</skos:prefLabel>
    <skos:definition>A failure to provide wage records claim is a legal action brought by an employee against their employer for not complying with the legal obligation to furnish access to or copies of the employee's wage-related documents. Wage records may include payroll records, pay stubs, and timekeeping data, and the claim typically arises when an employer either refuses or neglects to provide the requested information within the specified time frame mandated by applicable laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Failure to Provide Wage Records Claim</rdfs:label>
  </rdf:Description>
