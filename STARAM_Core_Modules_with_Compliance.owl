    <skos:example>Butcher shops</skos:example>
    <skos:example>Frozen meat retailers</skos:example>
    <skos:example>Poultry dealers</skos:example>
    <skos:example>Baked ham retailers</skos:example>
    <skos:example>Meat retailers</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=445240"/>
    <skos:definition>This industry comprises establishments primarily engaged in retailing fresh, frozen, or cured meats and poultry not for immediate consumption. Delicatessen-type establishments primarily engaged in retailing fresh meat are included in this industry.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/LiFH4W-PS0C0a2Xig-l1fA"/>
