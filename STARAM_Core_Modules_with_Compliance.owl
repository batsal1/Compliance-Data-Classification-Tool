  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9OQgWwumb1SAaSfzauESQ1">
    <skos:altLabel>Cooperative Co-Party</skos:altLabel>
    <skos:altLabel>Supportive Co-Party</skos:altLabel>
    <skos:altLabel>Aligned Counterparty</skos:altLabel>
    <skos:altLabel>Allied Co-Party</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N9784341eb9e4430baede9c067aced86f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFgxBbypUKKsDDOJ1iOk36"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Friendly Co-Party</rdfs:label>
    <skos:definition>A co-party in a legal or transactional matter whose interests and actions align with those of a specific client, even though they may be formally independent. Friendly co-parties generally cooperate and collaborate to achieve shared or mutually supportive outcomes within the matter.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
