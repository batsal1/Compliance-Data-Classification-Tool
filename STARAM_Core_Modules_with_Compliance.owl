  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7On4VWw10rNMziVMsyhnz9">
    <skos:altLabel>Objection to Overbroad Testimony</skos:altLabel>
    <skos:altLabel>No question before witness</skos:altLabel>
    <skos:altLabel>Narrative Response Objection</skos:altLabel>
    <dc:source>Fed. R. Evid. 611</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Narrative Objection</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NB9WJzAFK6tIIGmfIj5Ay"/>
    <skos:definition>An objection to a narrative is raised when a party in a legal proceeding believes that a witness's response or a question posed by the opposing counsel is too lengthy, lacks focus, or provides information beyond what was requested. This objection aims to prevent the introduction of irrelevant or prejudicial details into the record.</skos:definition>
  </rdf:Description>
