  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDmZbwmBBKWQ3vGof1sh1kB">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMIFgVwND9pPCV8Mb2eseF"/>
    <rdfs:label>Commitment to a Mental Health Facility</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Commitment to a mental health facility refers to the legal process by which an individual is placed into a psychiatric hospital or clinic for treatment. This can be voluntary, with the individual's consent, or involuntary, often due to concerns about the person's safety or the safety of others, based on established legal criteria and medical evaluations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBQrcxBTtrwdy4wTOfIm4XT">
    <rdfs:label>Accountant-Client Privilege</rdfs:label>
    <skos:definition>A legal protection that allows communication between an accountant and their client to remain confidential and not be disclosed in court without the client's consent.</skos:definition>
    <skos:altLabel xml:lang="zh-cn">会计师客户特权</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פרטיות בין רואה חשבון ללקוח</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privilegio de confidencialidad entre el contable y el cliente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio de confidencialidad entre el contador y el cliente</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verschwiegenheitspflicht des Wirtschaftsprüfers gegenüber dem Mandanten</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Secret professionnel de l'expert-comptable envers le client</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अकाउंटेंट-क्लाइंट विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Sigilo profissional do contador em relação ao cliente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">会計士・顧客特権</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Accountant-Client Privilege</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/IfUfZn-2QYCQPv8nuQZxew">
    <skos:example>Ear piercing services</skos:example>
    <skos:example>Day spas</skos:example>
    <skos:example>Tattoo parlors</skos:example>
    <skos:example>Depilatory or electrolysis (i.e., hair removal) salons</skos:example>
    <skos:example>Saunas</skos:example>
    <skos:example>Hair replacement (except by offices of physicians) or weaving services</skos:example>
    <skos:example>Tanning salons</skos:example>
    <skos:example>Steam baths</skos:example>
    <skos:example>Permanent makeup salons</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=812199"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing personal care services (except hair, nail, facial, nonpermanent makeup, or non-medical diet and weight reducing services).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/lM5S8xnEQnK7K0V56QXmxw"/>
    <rdfs:label>Other Personal Care Services</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
