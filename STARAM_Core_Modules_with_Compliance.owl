    <rdfs:subClassOf rdf:nodeID="N0499d9ca874a4feb93ce15ed657742f6"/>
    <skos:prefLabel>Alien</skos:prefLabel>
    <rdfs:label>Immigrant</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RByhWBQBS3KV6tj8TwFXRPd">
    <rdfs:label>fee_item_disc_cred segment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3hDYvR4ffxmqJg2F8YGT6"/>
    <skos:definition>"All discounts, credits and Alternate Fee Agreement items applied to the parent fee line item.  There will be 0 or more FEE_ITEM_DISC_CRED segments per FEE item.  

Note that the EXTEND_HEADER option was purposely omitted from this segment.
  "</skos:definition>
  </rdf:Description>
