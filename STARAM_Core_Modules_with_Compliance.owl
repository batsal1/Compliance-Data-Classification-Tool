    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Appliances Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A clause in a contract that specifies the appliances or equipment included in the agreement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#statesContractualNorm">
    <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
