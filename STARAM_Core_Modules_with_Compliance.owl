  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R_h5LrUKRtCgncaMMz_yVQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Telephone Apparatus Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing wire telephone and data communications equipment. These products may be stand-alone or board-level components of a larger system. Examples of products made by these establishments are central office switching equipment, cordless and wire telephones (except cellular), PBX equipment, telephone answering machines, LAN modems, multi-user modems, and other data communications equipment, such as bridges, routers, and gateways.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=334210"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/6OA2yfFNSw-nd97JTKTF_g"/>
  </rdf:Description>
