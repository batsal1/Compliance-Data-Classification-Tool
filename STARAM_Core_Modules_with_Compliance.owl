  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBf8HVq9mGPrjgDLsuLpfox">
    <rdfs:label>Limited Warranty Clause</rdfs:label>
    <skos:altLabel xml:lang="hi-in">सीमित वारंटी क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de garantie limitée</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">限定保証条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gewährleistungsausschlussklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de garantía limitada</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de garantía limitada</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אחריות מוגבלת</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Limited Warranty Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">有限保修条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de garantia limitada</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
    <skos:definition>A limited warranty clause is a provision in a contract that specifies the extent to which a seller is responsible for repairing or replacing a product that fails to meet certain standards within a specified period of time.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
