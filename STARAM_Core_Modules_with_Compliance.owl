    <rdfs:label>Preferential Transfer Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx"/>
    <skos:definition>A Preferential Transfer Claim is a legal claim made by a creditor seeking to recover payments made by a debtor to a preferred creditor before filing for bankruptcy, in order to ensure equal distribution of assets among all creditors.</skos:definition>
  </rdf:Description>
