  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0MoavyBgkozkTUjvdvqth">
    <skos:altLabel xml:lang="zh-cn">虚假索赔法案索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Reclamaciones Falsas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फ़ॉल्स क्लेम्स एक्ट का दावा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק התביעות המזוייפות</skos:altLabel>
