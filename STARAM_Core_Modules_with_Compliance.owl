  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDOq8HJJl8YdcwBdCZmjlOW">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="zh-cn">保密条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Confidentiality Clause</skos:altLabel>
