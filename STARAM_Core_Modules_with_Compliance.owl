  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8C21XIcxp9SGBNeg8jgUaU">
    <skos:altLabel xml:lang="zh-cn">娱乐、赌博和休闲产业</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Freizeit-, Glücksspiel- und Erholungsbranche</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मनोरंजन, जुआ और मनोरंजन उद्योग</skos:altLabel>
    <skos:altLabel>Amusement, Gambling, and Recreation Industries</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית הבידור, ההימורים והפנאי</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie des loisirs, des jeux d'argent et de la détente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">娯楽、ギャンブル、レクリエーション産業</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria del entretenimiento, juego y recreación</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria del ocio, juego y recreación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de Entretenimento, Jogos de Azar e Recreação</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Amusement, Gambling, and Recreation Industry</skos:altLabel>
    <skos:hiddenLabel>AMUS</skos:hiddenLabel>
    <dc:identifier>IN-INDUSTRY-3.1</dc:identifier>
    <dc:identifier>MEN-AMUS</dc:identifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7BZzP16LxkLJjYqRNwWXP"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-MEN-AMUS</ns2:legacyIdentifier>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:prefLabel>Amusement, Gambling, and Recreation Industry</skos:prefLabel>
    <skos:definition>Industries in this group include establishments that: operate facilities where patrons can primarily engage in sports, recreation, amusement, or gambling activities and/or; provide other amusement and recreation services, such as supplying and servicing amusement devices in places of business operated by others; operating sports teams, clubs, or leagues engaged in playing games for recreational purposes; and guiding tours without using transportation equipment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Amusement, Gambling, and Recreation Industry</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9WeLPiEbGoOavw05ow5nev">
    <skos:altLabel xml:lang="es-mx">Análisis de acuerdos de deuda previos a la petición</skos:altLabel>
