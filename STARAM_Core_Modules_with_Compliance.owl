  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7wFa2OWTbJrSusNQEtRNTx">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s"/>
    <rdfs:subClassOf rdf:nodeID="Nf420725722f44bda96619335598cfd1c"/>
    <skos:prefLabel>Objection to Out-of-Court Statement</skos:prefLabel>
    <skos:altLabel>Indirect Statement Objection</skos:altLabel>
    <skos:altLabel>Secondhand Testimony Objection</skos:altLabel>
    <rdfs:label>Hearsay Objection</rdfs:label>
    <skos:definition>A Hearsay Objection is raised when a party in a legal proceeding believes that a statement being offered as evidence was made outside of the current trial or hearing and is being used to prove the truth of the matter asserted. This objection aims to exclude secondhand information that has not been subjected to cross-examination and may not be reliable.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>Fed. R. Evid. 802</dc:source>
  </rdf:Description>
