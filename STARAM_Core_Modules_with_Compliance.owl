    <rdfs:subClassOf rdf:nodeID="Nb618c48e93ce4e6d8dac8b99ba6c89f5"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:functionalCategory xml:lang="en">4. Covenants &amp; Conduct of Parties</ns1:functionalCategory>
    <skos:prefLabel>Non-Encumbrance Covenant</skos:prefLabel>
    <skos:definition>A Negative Pledge is a covenant in a loan agreement where the borrower agrees not to pledge any assets as collateral if doing so would result in less security for the agreement's bondholders. This provision aims to protect the interests of the bondholders by ensuring that the borrower does not take actions that would dilute the security or increase the risk associated with the debt.</skos:definition>
    <rdfs:label>Negative Pledge</rdfs:label>
  </rdf:Description>
