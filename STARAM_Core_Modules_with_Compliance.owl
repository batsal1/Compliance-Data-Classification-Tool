  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RuliWeVDE8CQi4AATMNab1">
    <skos:altLabel xml:lang="es-mx">Doctrinas de Abstención</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अल्पविराम नीतियाँ</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תאוריות המניעה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Doctrines d'abstention</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Doctrinas de Abstención</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">棄権主義</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Enthaltungsdoktrinen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">弃权原则</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Doutrinas de abstenção</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Abstention Doctrines</skos:altLabel>
    <rdfs:label>Abstention Doctrines</rdfs:label>
    <skos:definition>Abstention Doctrines refer to legal theories that allow federal courts to abstain from exercising jurisdiction over a case in deference to state court proceedings, including Pullman Abstention, Brillhart-Wilton Abstention, Younger Abstention, Burford Abstention, and Colorado River Abstention.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/zZrNgdPqRCyQxuIj0b5U6g">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/shCPBqDZQECbiqTGp4dA2Q"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33592"/>
    <skos:definition>This industry comprises establishments primarily engaged in insulating fiber optic cable, and manufacturing insulated nonferrous wire and cable from nonferrous wire drawn in other establishments.</skos:definition>
    <rdfs:label>Communication and Energy Wire and Cable Manufacturing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0cUTmr54fU7MnCdySv1jM">
    <rdfs:label>Tropical Market Segment</rdfs:label>
    <skos:prefLabel>Equatorial Market Segment</skos:prefLabel>
    <skos:definition>The tropical market segment encompasses consumers or businesses located in regions characterized by hot and humid climates, typically near the equator. Businesses targeting this segment often focus on products and services that cater to the unique needs of individuals living in tropical climates, such as cooling solutions, lightweight clothing, and sun protection products.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDN8CVqeiDlOeHJO8Oeltq6"/>
  </rdf:Description>
