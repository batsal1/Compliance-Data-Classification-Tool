  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R85duVZEHXyts6z5ITtUAyz">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Renewal Option Clause</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">续约选项条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אפשרות חידוש</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Opción de Renovación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Renewal Option Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'option de renouvellement</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verlängerungsoption Klausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">更新オプション条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Opción de Renovación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de opção de renovação</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नवीनीकरण विकल्प शर्त</skos:altLabel>
    <skos:definition>A Renewal Option Clause is a provision in a contract that grants one or both parties the right to extend the term of the agreement for an additional period of time upon the expiration of the initial term.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
