  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDoqFy7w8Dr7R9MC1LSxNgv">
    <skos:altLabel xml:lang="fr-fr">Estoppel par promesse</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estoppel por promesa</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Promissory Estoppel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Estoppel por promesa</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">承诺禁止反言</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אסטופל על פי הבטחה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Estoppel promissório</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रतिज्ञा निषेध</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">約束禁止反言</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertrauensprinzip</skos:altLabel>
    <rdfs:label>Promissory Estoppel</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoKNrz23ylFaWAaoPC3ECY"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <skos:definition>A legal doctrine that prevents a party from going back on a promise made to another party, even if the promise was not supported by consideration, when the other party relied on the promise to their detriment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBfw7E7dyTONmLhhs6h2Ruk">
    <rdfs:label>Dealer</rdfs:label>
    <skos:altLabel xml:lang="hi-in">डीलर</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dealer</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סוחר</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Distribuidor</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Revendedor</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Concessionnaire</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ディーラー</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">经销商</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Distribuidor</skos:altLabel>
    <skos:altLabel>Dealer</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Händler</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-DLER</ns2:legacyIdentifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:nodeID="N363dac2ff65b488ba5a02532fd2c63af"/>
    <skos:hiddenLabel>DLER</skos:hiddenLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>DLER</dc:identifier>
    <skos:definition>A dealer is a person, company, or entity that buys and sells securities for his or her or its own account and not for others.</skos:definition>
  </rdf:Description>
