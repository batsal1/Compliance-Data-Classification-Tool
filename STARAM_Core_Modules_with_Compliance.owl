  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBix5fW3COPX4xfo2aJNBZa">
    <skos:altLabel xml:lang="zh-cn">受托人违反信托责任</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der Treuepflicht durch den Treuhänder</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विश्वासवार्ता के द्वारा न्यायाधीश का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת האמון על ידי הנאמן</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">受託者による信託義務違反</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Fiduciary Duty by Trustee</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation du devoir de fiduciaire par le fiduciaire</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação do dever fiduciário pelo fiduciário</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento del deber fiduciario por parte del fiduciario</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento del deber fiduciario por parte del fiduciario</skos:altLabel>
    <skos:definition>The breach of fiduciary duty by trustee refers to a situation where a trustee fails to act in the best interest of the beneficiaries of a trust, violating their legal obligation to manage the trust assets and affairs with loyalty, honesty, and good faith.</skos:definition>
    <rdfs:label>Breach of Fiduciary Duty by Trustee</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3SDQBy4KfjSgp3bgpb4Fx"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtmRdqzdG4lddVrtCToiL1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/k-5fQrhLS6ydE0yJrKrtLQ">
    <rdfs:label>Administration of Housing Programs</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NKOHU6qzQXuk0H15zSpCDQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises government establishments primarily engaged in the administration and planning of housing programs.</skos:definition>
