    <skos:altLabel xml:lang="de-de">Haftung für Korrekturen</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सुधार दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">訂正責任</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">更正责任</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad de correcciones</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad de correcciones</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Corrections Liability</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade por correções</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות תיקונים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité des corrections</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The legal responsibility for damages or harm caused by a correctional facility or its employees, including but not limited to negligence, abuse, or mistreatment of inmates.</skos:definition>
    <rdfs:label>Corrections Liability</rdfs:label>
