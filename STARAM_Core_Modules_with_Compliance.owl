    <dc:identifier>IN-INDUSTRY-17.11.1</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Other Miscellaneous Retailers Industry</skos:prefLabel>
    <rdfs:label>Other Miscellaneous Retailers Industry</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCOcm3mbIT9w7KMXFzQWjb6">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8v8NL73OspceQ5ouLmSZwF"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Restricted Ownership refers to the limitations and special conditions imposed on the ownership, transfer, or sale of assets (e.g., securities). These restrictions can include country-specific regulations, legal requirements, and contractual obligations that govern who can own or transfer these assets and under what conditions.</skos:definition>
    <rdfs:label>Restricted Asset Ownership</rdfs:label>
  </rdf:Description>
