  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCWcxRUlvh0IiaM4DKjIK8s">
    <skos:altLabel xml:lang="ja-jp">ベンチマーキング条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Benchmarking Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בנצ'מרקינג</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de referencia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Benchmarking-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de comparación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बेंचमार्किंग बंदोबस्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de benchmarking</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'étalonnage</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">基准条款</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Benchmarking Clause</rdfs:label>
    <skos:definition>A benchmarking clause is a provision in a contract that allows for the comparison of a company's performance or costs against those of other similar companies in the industry.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Y09dMEpmgMiRHyRz2U1aC">
    <rdfs:label>Voluntary Manslaughter</rdfs:label>
    <skos:altLabel xml:lang="es-mx">Homicidio Voluntario</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Homicide volontaire</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自発的殺人</skos:altLabel>
    <skos:altLabel xml:lang="he-il">רצח רצון</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वैच्छिक मानसिक रोष हत्या</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Totschlag auf Verlangen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Homicídio voluntário</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Homicidio Voluntario</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">自愿杀人</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Voluntary Manslaughter</skos:altLabel>
    <skos:definition>The unlawful killing of a person without malice aforethought, committed intentionally but in the heat of passion or under adequate provocation, and without premeditation or deliberation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBt6PLnwAaeJLOUww0swcdQ"/>
  </rdf:Description>
