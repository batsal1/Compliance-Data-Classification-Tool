  <rdf:Description rdf:about="https://folio.openlegalstandard.org/TfrCYTtGTaCrbhjnoTIUvg">
    <skos:example>Community action advocacy organizations</skos:example>
    <skos:example>Human rights advocacy organizations</skos:example>
    <skos:example>Environmental advocacy organizations</skos:example>
    <skos:example>Firearms advocacy organizations</skos:example>
    <skos:example>Conservation advocacy organizations</skos:example>
    <skos:example>Wildlife preservation organizations</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Social Advocacy Organizations</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81331"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/7dledmVRT7ijU7zmHuGdOQ"/>
    <skos:definition>This industry comprises establishments primarily engaged in promoting a particular cause or working for the realization of a specific social or political goal to benefit a broad or specific constituency.  These organizations may solicit contributions and offer memberships to support these goals.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7NSOpfI2rIDYuhJrfuca1J">
    <rdfs:label>Fair Labor Standards Act Claim</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">公平劳动标准法索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公正労働基準法クレーム</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק תקנות עבודה הוגנות</skos:altLabel>
    <skos:altLabel>Fair Labor Standards Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Normas Justas de Trabajo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch nach dem Fair Labor Standards Act</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Normas Trabalhistas Justas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फेयर लेबर स्टैंडर्ड्स एक्ट का दावा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fair Labour Standards Act Claim</skos:altLabel>
    <skos:altLabel>FLSA Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Normas Justas de Trabajo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur les normes équitables du travail</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nfbd3131695614c42bafc83475d0c11b2"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rfw7NfMHyrhfFQj8ob4M4U"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Fair Labor Standards Claim is a legal claim made by an employee against an employer for violations of federal labor laws related to minimum wage, overtime pay, and other employment standards.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB8sJgJULV5fZr0pI7KVHHJ">
    <skos:definition>Crisis Communications Practice involves providing legal advice and services related to managing and disseminating information during crises, aimed at protecting and maintaining an entity's reputation and legal standing. This practice addresses communication strategies, media relations, and stakeholder engagement in high-pressure situations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Crisis Information Management</skos:altLabel>
    <skos:altLabel>Crisis Communications Service</skos:altLabel>
    <skos:altLabel>Crisis Communications</skos:altLabel>
    <skos:altLabel>Reputation Management Advisory</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBibKbig5QuS9ec9M3W5136"/>
    <rdfs:subClassOf rdf:nodeID="Nedfb3cffb0404c62bb0f27a8d6d9d48e"/>
    <skos:prefLabel>Emergency Public Relations Practice</skos:prefLabel>
    <rdfs:label>Crisis Communications Practice</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N33faf6e3b70d4654874ac795809dd9c9">
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
