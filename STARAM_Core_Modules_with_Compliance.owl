  <rdf:Description rdf:about="https://folio.openlegalstandard.org/fkIG2JilQkisNvGeu-koIQ">
    <rdfs:label>Fuel Dealers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in retailing heating oil, liquefied petroleum (LP) gas, and other fuels via direct selling (i.e., home delivery).</skos:definition>
