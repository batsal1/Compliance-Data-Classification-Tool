    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Member</rdfs:label>
    <skos:altLabel>Participant</skos:altLabel>
    <skos:altLabel>Stakeholder</skos:altLabel>
    <skos:definition>A Member is an individual or entity that holds an ownership or participatory interest in an organization or association. In business contexts, such as in a Limited Liability Company (LLC), members contribute capital or assets, and share in the management and profits according to organizational agreements.</skos:definition>
  </rdf:Description>
