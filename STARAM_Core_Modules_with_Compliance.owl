  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9XltHfg2vgFJINhOJ5a7bK">
    <skos:altLabel xml:lang="zh-cn">具有约束力的仲裁条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बाध्यकारी विवाद-सुलझाव धारा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פילוח חובה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Binding Arbitration Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">拘束力のある仲裁条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause compromissoire</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schiedsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Arbitraje Vinculante</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de arbitragem vinculativa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Arbitraje Vinculante</skos:altLabel>
    <skos:definition>A binding arbitration clause is a specific type of contractual clause that requires parties to resolve disputes through arbitration rather than through the court system.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Binding Arbitration Clause</rdfs:label>
  </rdf:Description>
