    <rdfs:label>Pregnancy and Maternal Healthcare Coverage</rdfs:label>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <skos:definition>This specialized form of healthcare coverage provides medical services related to pregnancy, childbirth, and postpartum care. Many standard health insurance plans offer this coverage as a part of their package, and specialized plans may offer more comprehensive benefits.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9E9DMpMmBUkSNCwS8dpv9X">
    <skos:altLabel>Zoning Boundary Modifications</skos:altLabel>
    <skos:altLabel>Zoning Map Revisions</skos:altLabel>
    <skos:altLabel>Zoning District Redesignations</skos:altLabel>
    <skos:altLabel>Land Use Map Changes</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UmIB7M3FM4ZjzKbv8zbId"/>
    <skos:definition>Zoning Map Amendments involve the modification of an official zoning map, which visually represents land-use classifications within a jurisdiction. These changes can shift boundaries, reclassify areas, or add new zones and are generally subjected to public hearings, environmental reviews, and regulatory approvals.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Zoning Map Amendments</rdfs:label>
  </rdf:Description>
