    <rdfs:subClassOf rdf:nodeID="Ndd422d90ac214693a80050cf22daef7c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwvY8XJvIEvQJbUOBLJgtD"/>
    <rdfs:subClassOf rdf:nodeID="N2815fea99948438fbd848ec7578e23b7"/>
    <rdfs:subClassOf rdf:nodeID="N96761ee444d44664b66a6cabe6eaf1e9"/>
    <rdfs:subClassOf rdf:nodeID="Nded51261a6d549a6b1b84e4a1a19aaf9"/>
    <rdfs:subClassOf rdf:nodeID="Nd3f5b26d81024e9a8d64882c441dedb7"/>
    <rdfs:subClassOf rdf:nodeID="N342b1522d6b54543a0e7cb0061322a99"/>
    <rdfs:label>Information Technology Outsourcing Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>ITO Agreement</skos:altLabel>
    <skos:definition>An Information Technology Outsourcing Agreement is a contractual arrangement where a company engages an external service provider to manage and deliver its information technology services. This agreement may specify the scope of IT services, performance standards, and data security measures.</skos:definition>
    <ns1:contractFamily xml:lang="en">Services &amp; Outsourcing</ns1:contractFamily>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCArJvLMmeG63hAKd1Az51Q">
    <skos:altLabel xml:lang="he-il">תביעה חוזרת</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Widerklage</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">contrapedido</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">反訴</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">demande reconventionnelle</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反诉</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">काउंटरक्लेम</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reconvención</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reconvención</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Counterclaim</skos:altLabel>
    <rdfs:label>Counterclaim</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N9ab3ff899b5044d492cfa957ae7d1be3"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8C54zmV0Z524i5HvGoq7p9"/>
    <rdfs:subClassOf rdf:nodeID="Nbb17d4effed74098a7f8f58432b5dba3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A counterclaim is a legal action brought by a defendant against a plaintiff, in response to the plaintiff's claim, seeking relief or damages.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rge32jTsMN77AeMorfnU83">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>AAA Rating</skos:example>
    <skos:example>AA Rating</skos:example>
    <skos:example>Aaa Rating</skos:example>
    <skos:example>Baa3 Rating</skos:example>
    <skos:example>BBB Rating</skos:example>
    <skos:example>A Rating</skos:example>
    <rdfs:label>Investment Grade</rdfs:label>
    <skos:altLabel>Low-Risk Bond</skos:altLabel>
    <skos:altLabel>High-Quality Debt</skos:altLabel>
    <skos:altLabel>Prime Credit Rating</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RjVgVOLkDyEKic8xZS06iB"/>
    <skos:definition>Investment Grade refers to a credit rating assigned to debt securities that are considered to have a relatively low risk of default. This classification indicates that the issuer of the security is likely to meet its payment obligations, making it suitable for more conservative investors. These ratings are assigned by credit rating agencies and generally include ratings from AAA to BBB on the Standard &amp; Poor's and Fitch scales, and Aaa to Baa3 on the Moody's scale.</skos:definition>
    <skos:prefLabel>High-Grade Debt</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDDbjcXPqVS6CAMYrXYhFEM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nb49c8752cbe442acb7d7af4e0ff56053"/>
    <rdfs:subClassOf rdf:nodeID="N6f6d76af77de466c9ec4d63eb887c5fb"/>
    <rdfs:subClassOf rdf:nodeID="N3005db2f61a646089b2b01acea8fdcbd"/>
    <rdfs:subClassOf rdf:nodeID="N77fbcc3869c6495097d08138b927022d"/>
    <rdfs:subClassOf rdf:nodeID="N9184ab1d413241e69cf9a59306854316"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <skos:definition>A franchisor is a company or individual who grants a license to a third party for the conducting of a business under their brand, following a specific business model, usually in exchange for a fee or percentage of sales.</skos:definition>
    <rdfs:label>Franchisor</rdfs:label>
  </rdf:Description>
