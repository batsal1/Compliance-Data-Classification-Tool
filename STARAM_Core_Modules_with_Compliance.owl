  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCFPWMbdFLbplboOqvI77Jh">
    <skos:altLabel xml:lang="pt-br">Reivindicações antitruste</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations antitrust</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独占禁止法クレーム</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones antimonopolio</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wettbewerbsbeschwerden</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones antimonopolio</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट दावे</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Antitrust Claims</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反垄断索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות אנטיטראסט</skos:altLabel>
    <rdfs:label>Antitrust Claims</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N89a8f95b964b459aa878954af421eb15"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7u1GstOpfAmZ3mI7yFcbgU"/>
    <rdfs:subClassOf rdf:nodeID="N35882e4b2f564d7692ab7f4c718bd7c0"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <skos:definition>Antitrust Claims refer to legal claims made against individuals or companies for engaging in anti-competitive behavior, such as market allocation, vertical or horizontal agreements, pricing, or conspiracy.</skos:definition>
  </rdf:Description>
