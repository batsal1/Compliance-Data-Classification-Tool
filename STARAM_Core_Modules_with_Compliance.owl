    <skos:altLabel xml:lang="he-il">סוורנות שקר עדות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">偽証の教唆</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Subornation of Perjury</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Subornation de faux témoignage</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Suborno de perjúrio</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Soborno de falso testimonio</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">झूठी गवाही के लिए घूसखोरी</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Soborno de falso testimonio</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anstiftung zur Falschaussage</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N8e803f1bb1cb4fdd8cf9baabe24c55ef"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Subornation of Perjury</rdfs:label>
    <skos:definition>The act of persuading someone to commit perjury, which is giving false testimony under oath, with the intention of obstructing justice or misleading the court.</skos:definition>
  </rdf:Description>
