  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCUqAm74lUE8pmrNqTadcrl">
    <skos:altLabel xml:lang="fr-fr">Dispositions opérationnelles intérimaires</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interim Operations Provisions</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Disposições Operacionais Interinas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अंतरिम ऑपरेशन प्रावधान</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">临时运营规定</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Disposiciones Provisionales de Operaciones</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הוראות תפעול ביניים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">暫定運用規定</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vorläufige Betriebsbestimmungen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Disposiciones Provisionales de Operaciones</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Interim Operations Provisions are legal clauses that are included in a contract to regulate the actions of parties during the period between the signing of the contract and its completion, often to protect the interests of one or more parties.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHZTIZfN6Fbrf6azRExLaD"/>
    <rdfs:label>Interim Operations Provisions</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8TcoZums6Bey9dc1v7qDZc">
