  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCPvkWuRYuJnVkrp50ODImF">
    <skos:prefLabel>Deficient Representation</skos:prefLabel>
    <skos:altLabel xml:lang="ja-jp">弁護士の無効な援助</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unwirksame Verteidigung</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Ineffective Assistance of Counsel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">律师无效辩护</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Assistance inefficace d'un avocat</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Asistencia Inefectiva del Abogado</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वकील की असफल सहायता</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Asistencia Inefectiva del Abogado</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Assistência jurídica ineficaz</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סיוע לא יעיל של עו"ד</skos:altLabel>
    <rdfs:label>Ineffective Assistance of Counsel</rdfs:label>
    <skos:definition>Ineffective Assistance of Counsel refers to a claim made by a defendant that their attorney's performance during a criminal trial or appeal was so deficient that it deprived them of their constitutional right to a fair trial.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
  </rdf:Description>
