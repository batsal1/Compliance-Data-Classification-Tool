    <skos:altLabel xml:lang="ja-jp">プロバイダー非タイムキーパーレベル</skos:altLabel>
    <rdfs:label>Provider Non-Timekeeper Level</rdfs:label>
    <skos:definition>A Provider Non-Timekeeper Level is a category of personnel within a law firm who do not bill clients for their time, such as knowledge managers, pricing personnel, discovery personnel, accounting personnel, assistants/secretaries, administrators, and marketing personnel.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7tihKK0L440nkLIrRcdCkh"/>
  </rdf:Description>
