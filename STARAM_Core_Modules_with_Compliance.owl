    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Indigenous and Tribal Religious Laws</skos:prefLabel>
    <skos:definition>Indigenous and Tribal Religious Laws are the traditional rules, customs, and practices developed and followed by indigenous and tribal communities, often based on spiritual beliefs and ancestral teachings, that govern various aspects of their communal and personal lives.</skos:definition>
  </rdf:Description>
