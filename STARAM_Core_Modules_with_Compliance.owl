  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDrZfl9rDyGVk1ikSmx5TRd">
    <skos:altLabel xml:lang="ja-jp">個人財産の売却</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verkauf von persönlichem Eigentum</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Venta de Bienes Personales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Sale of Personal Property</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Venta de Bienes Personales</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Vente de biens personnels</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यक्तिगत संपत्ति की बिक्री</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Venda de propriedade pessoal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מכירת נכסים אישיים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">个人财产出售</skos:altLabel>
    <rdfs:label>Sale of Personal Property</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t5CSqYvG6L6Cl86vQeMRA"/>
    <skos:definition>The sale of personal property refers to the transfer of ownership of tangible items that are not considered goods under the law, such as vehicles or furniture, in exchange for payment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Zfrb3QY4Pk4E7DQnFEpyZ">
    <skos:example>Social media posts that demean and spread false information about a religious community, leading to platform bans and legal repercussions.</skos:example>
    <skos:example>A public speech inciting violence against a minority ethnic group, resulting in legal action for inciting racial hatred.</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7fCP2EQY8XQ5fxqiYaKPQA"/>
    <rdfs:label>Hate Speech</rdfs:label>
    <skos:definition>Hate Speech refers to communication, whether spoken, written, or behavioral, that attacks or discriminates against a person or group based on attributes such as race, religion, ethnicity, sexual orientation, disability, or gender. This type of speech is intended to incite hatred, violence, or prejudice against the targeted group and is often subject to legal restrictions and penalties.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Incendiary Speech</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBwZjjQmoJgjgi1yx1YBOm7">
    <skos:definition>An unpaid wages claim is a legal action initiated by an employee against their employer for not paying the employee their earned wages. The claim typically arises when an employer does not comply with applicable laws, which require employers to pay employees for all hours worked and to pay at least the minimum wage rate. The claim can include allegations of employers failing to pay the employee their regular pay, overtime pay, earned commissions, or other forms of compensation. Employees may also bring unpaid wages claims for non-payment of bonuses or other benefits owed to them.</skos:definition>
    <skos:altLabel xml:lang="pt-br">Reclamação de salários não pagos</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de salarios impagados</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf unbezahlten Lohn</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unpaid Wages Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">未払い賃金請求</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de salaires impayés</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על שכר לא משולם</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de salarios no pagados</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवैतनिक वेतन दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未付工资索赔</skos:altLabel>
    <rdfs:label>Unpaid Wages Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <rdfs:subClassOf rdf:nodeID="N3109739765a4434ca67fdfe125369967"/>
    <rdfs:subClassOf rdf:nodeID="N57c68a45f89c4c62b2d74ff8238f57a9"/>
  </rdf:Description>
