  <rdf:Description rdf:about="https://folio.openlegalstandard.org/CgdXO1wUSkOA1QvrQOkQNg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/0o5hdV03RtKfKqXq0oed6Q"/>
    <skos:definition>This industry comprises (1) companies, groups, or theaters primarily engaged in producing the following live theatrical presentations: musicals; operas; plays; and comedy, improvisational, mime, and puppet shows and (2) establishments, commonly known as dinner theaters, engaged in producing live theatrical productions and in providing food and beverages for consumption on the premises. Theater groups or companies may or may not operate their own theater or other facility for staging their shows.</skos:definition>
    <skos:example>Live theatrical productions (except dance)</skos:example>
    <skos:example>Musical theater companies</skos:example>
    <skos:example>Opera companies</skos:example>
    <skos:example>Theatrical stock or repertory companies</skos:example>
    <skos:example>Comedy troupes</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Theater Companies and Dinner Theaters</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=711110"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N26811332c4044a34bb1b537e40a190e7">
    <owl:onProperty rdf:resource="https://staram.in/ontology/epc#hasConsequence"/>
    <owl:hasValue rdf:resource="https://staram.in/ontology/epc/taxonomy#impact-cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDajhASEYQna0SEDI7AbFEO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A community property claim relates to the legal concept of community property in certain jurisdictions. In divorce or dissolution of a marriage, community property refers to assets and debts acquired during the marriage that are considered jointly owned by both spouses. A community property claim involves asserting a legal right to an equitable division of these shared assets and liabilities between the divorcing parties</skos:definition>
    <skos:altLabel>Conjugal Property Claim</skos:altLabel>
    <skos:altLabel>Communal Property Claim</skos:altLabel>
    <rdfs:label>Community Property Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUXzL8Z4Ddh2CK6TBhofjU"/>
    <skos:prefLabel>Marital Property Claim</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDE3T1alvOrbulBGXly259z">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RYS2M2cunzcjtIHPdPzmUy"/>
    <skos:altLabel>Radiation Injury Claim</skos:altLabel>
    <skos:altLabel>Radiological Injury Claim</skos:altLabel>
    <skos:altLabel>A Radiation Exposure Claim is a legal claim arising from harm or injury caused by exposure to ionizing radiation. It typically involves seeking compensation for health issues such as cancer, radiation burns, or other medical conditions resulting from such exposure.</skos:altLabel>
    <skos:altLabel>Nuclear Exposure Claim</skos:altLabel>
    <rdfs:label>Radiation Exposure Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDdMucRftztKt4Ag7WzUxX">
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-INTP</ns2:legacyIdentifier>
    <skos:altLabel xml:lang="zh-cn">知识产权法</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit de la propriété intellectuelle</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ley de Propiedad Intelectual</skos:altLabel>
    <skos:altLabel>Intellectual Property Law</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito de Propriedade Intelectual</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बौद्धिक संपदा कानून</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Geistiges Eigentumsrecht</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוק קניין רוחני</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">知的財産法</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho de Propiedad Intelectual</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Intellectual Property Law</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Law protecting the legal rights to inventions, designs, and artistic works.</skos:definition>
    <skos:hiddenLabel>INTP</skos:hiddenLabel>
    <dc:identifier>INTP</dc:identifier>
    <dc:identifier>IN-LAW-20</dc:identifier>
    <rdfs:label>Intellectual Property Law</rdfs:label>
