  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RkcDCEktixCPSnjvyoYGpJ">
    <skos:altLabel xml:lang="hi-in">सरकारी साइडवॉक पर गिरने के लिए दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por caída en la acera del gobierno</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">政府歩道での転倒に対する請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação por queda na calçada do governo</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Claim for Falling on Government Sidewalk</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על נפילה במדרכת ממשלתית</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">在政府人行道上摔倒的索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por caída en la acera del gobierno</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Sturz auf Regierungsbürgersteig</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour chute sur le trottoir du gouvernement</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3"/>
    <rdfs:label>Claim for Falling on Government Sidewalk</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A claim for falling on a government sidewalk is a legal action brought by an individual who has suffered injuries due to a slip-and-fall incident caused by the negligence of a government entity responsible for maintaining the sidewalk.</skos:definition>
  </rdf:Description>
