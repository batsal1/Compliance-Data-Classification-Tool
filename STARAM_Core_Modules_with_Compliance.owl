  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBZvzjymwe5Jdu4nFAuDUNO">
    <skos:altLabel xml:lang="he-il">סעיף חובת הקטנת נזקים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">損害軽減義務条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de dever de mitigação de danos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">减轻损失责任条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नुकसान कम करने का दायित्व अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Duty to Mitigate Damages Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de deber de mitigar daños</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de devoir de mitigation des dommages</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de deber de mitigar daños</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Pflicht zur Schadensminderung</skos:altLabel>
    <skos:definition>A Duty to Mitigate Damages Clause is a provision in a contract that requires the injured party to take reasonable steps to minimize their losses or damages resulting from a breach of contract by the other party.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Duty to Mitigate Damages Clause</rdfs:label>
  </rdf:Description>
