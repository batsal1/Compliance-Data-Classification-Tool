  <rdf:Description rdf:about="https://folio.openlegalstandard.org/P1cdNMlaQpKT21kBpuolzg">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) rolling, drawing, or extruding shapes (except flat rolled sheet, plate, foil, and welded tube) from purchased aluminum and/or (2) recovering aluminum from scrap and rolling, drawing, or extruding shapes (except flat rolled sheet, plate, foil, and welded tube) in integrated mills.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Nails, aluminum, made in wire drawing plants</skos:example>
    <skos:example>Tube made by drawing or extruding purchased aluminum</skos:example>
    <skos:example>Structural shapes made by rolling purchased aluminum</skos:example>
    <skos:example>Rod made by extruding purchased aluminum</skos:example>
    <skos:example>Wire, bare, made in aluminum wire drawing plants</skos:example>
    <skos:example>Aluminum bar made by extruding purchased aluminum</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/K5US-YUOQA-m1BbwsoarAQ"/>
    <rdfs:label>Other Aluminum Rolling, Drawing, and Extruding</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=331318"/>
  </rdf:Description>
