    <skos:altLabel>Dividend Funds</skos:altLabel>
    <skos:altLabel>Interest Income Funds</skos:altLabel>
    <skos:altLabel>Yield Funds</skos:altLabel>
    <skos:altLabel>Profit Distribution Funds</skos:altLabel>
