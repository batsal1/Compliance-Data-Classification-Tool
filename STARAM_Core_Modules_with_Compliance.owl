    <skos:altLabel xml:lang="zh-cn">全面终止条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur vollständigen und endgültigen Freistellung</skos:altLabel>
    <rdfs:label>Full and Final Release Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Full and Final Release Clause is a provision in a contract that releases all parties from any further obligations or claims related to the subject matter of the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9JMX7niGHsR9tG8mfIMzOS">
    <skos:altLabel xml:lang="zh-cn">可分割性条款</skos:altLabel>
