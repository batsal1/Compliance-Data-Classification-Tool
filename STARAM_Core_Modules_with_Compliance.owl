    <skos:altLabel xml:lang="zh-cn">合同超额付款已收回</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Surpaiement sur contrat récupéré</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pagamento excessivo em contrato recuperado</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Recuperación de pago en exceso en contrato</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध पर अधिक भुगतान वसूला गया</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Recuperación de pago en exceso en contrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">החזרת תשלום יתר על חוזה</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:label>Overpayment on Contract Recovered</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
