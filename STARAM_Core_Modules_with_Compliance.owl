    <skos:altLabel xml:lang="de-de">Überwachung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">モニタリング</skos:altLabel>
    <skos:definition>The process of monitoring developments in the law, including judicial decisions, agency opinions, and statutory and regulatory enactments usually for the purpose of establishing up-to-date policies and protocols.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
