  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7z0ey8ZMeOT1q01VNPe1HY">
    <skos:definition>Geographic market attributes refer to the characteristics of a market that are defined by the geographical scope and location of consumers and businesses. These attributes can include the national, international, and local reach of a market, and they play a crucial role in shaping marketing strategies and product offerings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UG79BtYP2uqnKNklLYXB8"/>
    <skos:prefLabel>Market Geography</skos:prefLabel>
    <skos:altLabel>Geographic Market Attributes</skos:altLabel>
    <skos:note>Non-copyrightable idea and fact inspiration drawn from IAB 2.0. https://www.meaningcloud.com/developer/documentation/predefined/deep-categorization-models/iab-2-0</skos:note>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Geographic Market Segments</rdfs:label>
  </rdf:Description>
