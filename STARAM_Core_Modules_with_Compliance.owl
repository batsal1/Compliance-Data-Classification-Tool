  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RW7P6EPg4NMe8dhyO52jzl">
    <rdfs:label>Budgeting Management</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
    <rdfs:subClassOf rdf:nodeID="Nec86dd553eb5437ca738d52aa2e4252a"/>
    <skos:definition>Budgeting Management refers to the process of planning and controlling the financial resources of a business or organization within the legal industry.</skos:definition>
