    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0P6cac8zTuNTxrgFr7L2l">
    <skos:altLabel xml:lang="he-il">הונאת רווחה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">福祉詐欺</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sozialhilfebetrug</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fraude al bienestar social</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fraude de bem-estar social</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fraude de bienestar social</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Welfare Fraud</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कल्याण धोखाधड़ी</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">福利欺诈</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude aux prestations sociales</skos:altLabel>
    <skos:definition>The use of deceitful statements, practices, or devices to unlawfully obtain welfare benefits.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5ks6eYBkfLh4Fgv1Zusal"/>
    <rdfs:label>Welfare Fraud</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R84K4Nv1zRRqSIU4YEOUSdH">
