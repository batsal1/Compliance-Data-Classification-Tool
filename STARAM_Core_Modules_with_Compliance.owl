  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9PYNVVb9kMDcRtGNPADrO5">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlNFgB3TQfMzV26V4V7u4E"/>
    <rdfs:label>Legal Rights</rdfs:label>
    <skos:definition>Legal rights are entitlements or privileges conferred by law that provide an individual or entity with certain freedoms, protections, or benefits. These rights can be civil, political, or social in nature and are enforceable by the judiciary, serving as the basis for legal claims or actions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCvfcnTIQL3IhFBUvFvIWxB">
    <skos:altLabel xml:lang="pt-br">Negligência em farmacologia</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en farmacología</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">药理学失误</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pharmakologiefehler</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Mala praxis en farmacología</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">薬剤学の過失行為</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בפרמקולוגיה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फार्माकोलॉजी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pharmacology Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en pharmacologie</skos:altLabel>
    <skos:definition>Pharmacology Malpractice refers to a type of medical malpractice claim that involves errors or negligence in the prescription, administration, or monitoring of medication by a healthcare professional.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdfs:label>Pharmacology Malpractice</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R78sQua6LVfK3i7KL9lqmZN">
    <rdfs:label>Breach of Implied Warranty of Habitability by Home Seller</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">房屋卖方违反隐含的适居保证</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de la garantía implícita de habitabilidad por parte del vendedor de la casa</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">घर विक्रेता द्वारा निहित वारंटी के अवहेलना का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de habitabilidade pelo vendedor da casa</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Habitability by Home Seller</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite d'habitabilité par le vendeur de la maison</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de la garantía implícita de habitabilidad por parte del vendedor de la vivienda</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת האחריות המשתלמת המשתלמת על ידי מוכר הבית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung der Bewohnbarkeit durch den Hausverkäufer</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">住宅売主による暗黙の居住可能性保証の違反</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Breach of Implied Warranty of Habitability by Home Seller refers to the failure of a home seller to provide a livable and safe dwelling to the buyer, which was not disclosed during the sale, resulting in legal action against the seller.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBRosNDPt8cNUuRnoPqYufN"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8KQ6nS2QG4nNITfi4PTfdK">
    <skos:altLabel xml:lang="es-mx">Socio de capital de la firma</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Socio de capital de la firma</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">固定株式パートナー</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שותף בקרן הון במשרד עורכי הדין</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公司股权合伙人</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Firm Equity Partner</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Associé en capital fixe</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fester Equity-Partner</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Sócio de capital fixo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फर्म इक्विटी पार्टनर</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שותף בקרן הון של המשרד</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDZqAEp47Hwg3SOSMpD7lQh"/>
    <rdfs:label>Firm Equity Partner</rdfs:label>
    <skos:definition>A Firm Equity Partner is a partner in a law firm who holds an ownership interest in the firm, typically through the purchase of shares, and is entitled to a share of the firm's profits.</skos:definition>
  </rdf:Description>
