  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDzhElfGf36QJ6et1f4tIyl">
    <skos:altLabel xml:lang="he-il">הפרת חובת טיפול פיזי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em fisioterapia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">物理治疗过失</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Physical Therapy Negligence</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शारीरिक थेरेपी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit in der Physiotherapie</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en Fisioterapia</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en Terapia Física</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence en kinésithérapie</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">理学療法の過失</skos:altLabel>
    <rdfs:label>Physical Therapy Negligence</rdfs:label>
    <skos:definition>Physical Therapy Negligence refers to a type of medical negligence claim that arises when a physical therapist fails to provide the appropriate standard of care, resulting in harm or injury to the patient.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
