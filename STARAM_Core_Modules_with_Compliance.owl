  <rdf:Description rdf:about="https://folio.openlegalstandard.org/AC9I3j01Qnm7Q2b7GFf-bw">
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of nondurable goods (except printing and writing paper; stationery and office supplies; industrial and personal service paper; drugs and druggists' sundries; apparel, piece goods, and notions; grocery and related products; farm product raw materials; chemical and allied products; petroleum and petroleum products; beer, wine, and distilled alcoholic beverages; farm supplies; books, periodicals, and newspapers; flowers, nursery stock, and florists' supplies; tobacco and tobacco products; and paint, varnishes, wallpaper, and supplies).</skos:definition>
    <skos:example>Artists' supplies merchant wholesalers</skos:example>
    <skos:example>Statuary (except religious) merchant wholesalers</skos:example>
    <skos:example>Textile bags merchant wholesalers</skos:example>
    <skos:example>Industrial yarns merchant wholesalers</skos:example>
    <skos:example>Christmas trees (e.g., artificial, cut) merchant wholesalers</skos:example>
    <skos:example>Pet supplies (except pet food) merchant wholesalers</skos:example>
    <skos:example>Burlap merchant wholesalers</skos:example>
    <rdfs:label>Other Miscellaneous Nondurable Goods Merchant Wholesalers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424990"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_1Ev3PQ-SDG5LAgWif3Lag"/>
  </rdf:Description>
