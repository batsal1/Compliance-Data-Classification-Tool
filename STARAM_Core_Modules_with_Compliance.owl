  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0cDkfK1lTUqnkFLRzVtyQ">
    <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות מחירים מאוגדים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - बंडल कीमत दावे</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反垄断 - 捆绑定价索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de precios combinados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Antitrust - Bundled Pricing Claims</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones de precios combinados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Antitrust - Réclamations de tarification groupée</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wettbewerbsrecht - Ansprüche auf gebündelte Preisgestaltung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações de Preços Agrupados</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独占禁止法 - バンドル価格請求</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A claim made under antitrust law that alleges a company is engaging in anti-competitive behavior by offering products or services as a bundle, rather than allowing customers to purchase them separately.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9aw3d42PAXE6t5QYbR7Vru"/>
    <rdfs:label>Antitrust - Bundled Pricing Claims</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDkk8gcmuzzzVELKIaofrAd">
    <skos:altLabel xml:lang="zh-cn">宣誓作证审讯</skos:altLabel>
