    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jiyejSsdOkKDAWQ9ZPcjj"/>
    <rdfs:label>Antitrust - Vertical Price Fixing Claims</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An allegation of illegal collusion between parties at different levels of a supply chain to set prices for goods or services, in violation of antitrust laws.</skos:definition>
