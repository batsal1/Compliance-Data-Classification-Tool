  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RinkUCYEWeC702L4eg88JJ">
    <rdfs:label>Knowledge Management Risk</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html"/>
    <skos:definition>The threats and opportunities associated with an organization's collection and management of knowledge, including intellectual property, organizational or operational information and records, and scientific data. This includes the potential for negative consequences arising from an organization's inability to effectively capture, store, share, and leverage its collective knowledge and expertise. This can result from poor knowledge management practices, inadequate systems, or employee turnover, potentially leading to inefficiencies, loss of intellectual capital, or reduced innovation and competitiveness.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxTxaN981tLTsN82qPBcp"/>
    <rdfs:subClassOf rdf:nodeID="N6a69affd38544787b6cc27c859282433"/>
    <rdfs:subClassOf rdf:nodeID="N219900466e614d8fb4acb89406cd2042"/>
