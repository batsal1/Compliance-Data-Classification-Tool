  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDKZpAgUjHtS3sp8YcGMkq7">
    <rdfs:subClassOf rdf:nodeID="N8597b91256cc42978de6d086c37ad83c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ6hoxQD6Sa9Hi4bnv1jgC"/>
    <rdfs:label>Teen Market Segment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Adolescent Market Segment</skos:prefLabel>
    <skos:definition>The teen market segment refers to a division of the market that is specifically targeted towards teenagers as consumers. This segment encompasses products, services, and marketing strategies that are designed to cater to the unique needs, preferences, and interests of teenagers, taking into account factors such as social trends, lifestyle choices, and identity exploration.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/qGYH_7qWTlyTHiDsEFsZDg">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424720"/>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of petroleum and petroleum products (except from bulk liquid storage facilities).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Gasoline merchant wholesalers (except bulk stations, terminals)</skos:example>
    <skos:example>Bottled liquid petroleum gas merchant wholesalers</skos:example>
    <skos:example>Lubricating oil and grease merchant wholesalers (except bulk stations, terminals)</skos:example>
    <skos:example>Fuel oil merchant wholesalers (except bulk stations, terminals)</skos:example>
    <rdfs:label>Petroleum and Petroleum Products Merchant Wholesalers (except Bulk Stations and Terminals)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/PLFHrXcUTWaEpQVWyTCBAw"/>
  </rdf:Description>
