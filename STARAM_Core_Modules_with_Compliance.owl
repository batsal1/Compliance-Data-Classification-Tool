    <skos:definition>A writ appeal is a legal action taken by a party who is dissatisfied with a lower court's decision, requesting a higher court to review and potentially overturn the decision.</skos:definition>
    <rdfs:label>Writ Appeals</rdfs:label>
    <rdfs:label>Writ Appeal</rdfs:label>
    <rdfs:isDefinedBy>PACER</rdfs:isDefinedBy>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R94yxXVadPVTE4IW7iABVRc"/>
  </rdf:Description>
