    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
    <skos:altLabel xml:lang="fr-fr">Réclamations contre les agents immobiliers et les courtiers</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">针对房地产经纪人和经纪人的索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reclamações contra agentes e corretores imobiliários</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche gegen Immobilienmakler und -vermittler</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות נגד סוכני ומתווכי נדל״ן</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रियल एस्टेट एजेंट और ब्रोकर्स के खिलाफ दावे</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones contra agentes y corredores de bienes raíces</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandas contra agentes y corredores de bienes raíces</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不動産エージェントおよびブローカーに対する請求</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Claims Against Real Estate Agents and Brokers</skos:altLabel>
    <skos:definition>Claims Against Real Estate Agents and Brokers refers to legal actions taken against individuals or companies who act as intermediaries in real estate transactions, alleging breach of duty or negligence in their representation of clients.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Claims Against Real Estate Agents and Brokers</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBGnzdlRTDfBWfXIysySEW">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Book of Authorities Management refers to the process of organizing and maintaining a collection of legal authorities cited in a litigation case, including cases, statutes, and regulations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
    <rdfs:label>Book of Authorities Management</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RcjE7ZFthlfdvlhZ5GCJyj">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs"/>
    <rdfs:subClassOf rdf:nodeID="Nf81afac75425459da7897ee9089b8fc9"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Spousal Support Claim</rdfs:label>
    <skos:prefLabel>Alimony Claim</skos:prefLabel>
    <skos:definition>A Spousal Support Claim is a legal request made by one spouse to receive financial assistance from the other spouse following a divorce or separation. This claim is typically based on factors such as income disparity, the length of the marriage, and each spouse's financial needs and contributions during the marriage. Spousal support, also known as alimony, is designed to provide financial support to the lower-earning spouse to help them maintain their standard of living or become financially independent.</skos:definition>
  </rdf:Description>
