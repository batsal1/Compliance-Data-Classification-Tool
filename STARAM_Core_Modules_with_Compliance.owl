  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDxZjKnm3grueUeRmKRHXrA">
    <skos:altLabel xml:lang="pt-br">Cláusula de Requisito de Forma Escrita</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Requisito de Forma Escrita</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">書面形式要件条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Requisito de Forma Escrita</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Written Form Requirement Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de l'exigence de forme écrite</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Schriftformanforderung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף דרישת צורת כתב</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">书面形式要求条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिखित रूप आवश्यकता शर्त</skos:altLabel>
    <rdfs:label>Written Form Requirement Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Written Form Requirement Clause is a clause in a contract that specifies that any modifications or waivers to the contract must be in writing to be valid.</skos:definition>
  </rdf:Description>
