  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7NSnFDAuKIakuxCUbcQ2A2">
    <skos:altLabel xml:lang="es-mx">Cláusula de depósito en garantía</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de consignation</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Treuhandsatzung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אסקרו</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Escrow Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एस्क्रो क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de depósito</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">托管条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">エスクロー条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de depósito</skos:altLabel>
    <rdfs:label>Escrow Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>An Escrow Clause is a provision in a contract that requires a third party to hold funds or property until certain conditions are met, providing security and assurance to both parties involved in the transaction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8jqfUwpteNxuBdyvBeZXp3">
    <skos:altLabel xml:lang="fr-fr">Responsabilité du bon samaritain</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade do bom samaritano</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Good Samaritan Liability</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad del buen samaritano</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अच्छा समरिटन दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad del buen samaritano</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות הסמרטן הטוב</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">善意のサマリア人責任</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung des guten Samariters</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">好心人责任</skos:altLabel>
    <skos:altLabel>Emergency Aid Not Given or Not Properly Given</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdfs:subClassOf rdf:nodeID="N43299730dbd445fe8c717f1f252760b3"/>
    <rdfs:label>Good Samaritan Liability</rdfs:label>
    <skos:definition>The concept of Good Samaritan Liability refers to the legal responsibility of an individual who fails to provide or properly provide emergency aid to someone in need, despite having the ability to do so, and may be held liable for any resulting harm.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
