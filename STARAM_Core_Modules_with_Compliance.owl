    <ns1:contractFamily xml:lang="en">Investment &amp; Financial Services</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Brokerage Agreement is a contract between an investor and a brokerage firm allowing the latter to act as the investor's agent in buying and selling securities. The agreement stipulates commission fees, account terms, and other conditions.</skos:definition>
    <rdfs:label>Brokerage Agreement</rdfs:label>
  </rdf:Description>
