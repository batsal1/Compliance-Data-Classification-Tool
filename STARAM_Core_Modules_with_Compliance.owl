    <skos:altLabel xml:lang="es-mx">Cláusula de No Asesoría Fiscal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Tax Advice Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הוראת חוזה ללא ייעוץ מס</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不提供税务建议条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de No Asesoramiento Fiscal</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Não Aconselhamento Fiscal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-conseil fiscal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कोई कर सलाह अनुबंध नहीं</skos:altLabel>
    <rdfs:label>No Tax Advice Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A "No Tax Advice Clause" is a provision in a contract that states that no tax advice has been given by one party to the other, and that each party is responsible for obtaining their own tax advice.</skos:definition>
  </rdf:Description>
