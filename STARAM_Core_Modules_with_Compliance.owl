    <skos:altLabel xml:lang="zh-cn">赔偿方条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भरपाई पक्ष शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de indenização</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">弁済義務条項</skos:altLabel>
