    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#DisputeResolution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQ1HxGIGyREydwZNRx-i1Tg">
    <skos:prefLabel>PA720 Portfolio Analysis and Management</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PA720 Portfolio Analysis and Management</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4OSB4wBIRgipGEh-XVXSZA"/>
    <skos:definition>All action associated with reviewing, analyzing, documenting, and managing a portfolio of patents. Includes patent "due diligence" during transactional analysis.</skos:definition>
  </rdf:Description>
