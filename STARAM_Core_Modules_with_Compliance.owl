  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9BUmtky7GCuq517wEeRYna">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="ja-jp">ソフトウェア保証条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">软件保证条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सॉफ्टवेयर वारंटी क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Software-Gewährleistungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Software Warranty Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אחריות תוכנה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de garantia de software</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de garantie logicielle</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de garantía de software</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de garantía de software</skos:altLabel>
    <rdfs:label>Software Warranty Clause</rdfs:label>
    <skos:definition>A software warranty clause is a provision in a contract that guarantees the quality and performance of software, typically outlining the rights and remedies available to the user in the event of defects or malfunctions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
  </rdf:Description>
