  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBRosNDPt8cNUuRnoPqYufN">
    <skos:altLabel xml:lang="pt-br">Violação da garantia implícita de habitabilidade</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de la garantía implícita de habitabilidad</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de la garantía implícita de habitabilidad</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la garantie implicite d'habitabilité</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת אחריות מתישבת למגורים במצב תקין</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Implied Warranty of Habitability</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung der stillschweigenden Gewährleistung der Bewohnbarkeit</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反隐含的适居保证</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आवासीय गुणवत्ता की निहित वारंटी का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">暗黙の居住保証の違反</skos:altLabel>
    <skos:definition>The Breach of Implied Warranty of Habitability refers to a legal claim that arises when a landlord fails to provide a tenant with a safe and habitable living environment, which is implied in every lease agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NPSSODp2sRYDRSQ2hvF3b"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
    <rdfs:label>Breach of Implied Warranty of Habitability</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
