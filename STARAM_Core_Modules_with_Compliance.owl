  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB3ZDkOj3NY83VeYDOB98XR">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8AUKvbXRK8jOHSQaqxcAtD"/>
    <rdfs:subClassOf rdf:nodeID="Nbaa00ed9fdf24785b6c717c0ab46be0e"/>
    <rdfs:label>Criminal Legal Determination</rdfs:label>
    <skos:definition>A "criminal legal determination" pertains to the verdict or decision made by a court in a criminal case. It typically involves determining whether the defendant is found "guilty" or "not guilty" of the criminal charges brought against them. This determination has significant consequences, including potential penalties such as imprisonment, fines, probation, or other forms of punishment, depending on the verdict.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
