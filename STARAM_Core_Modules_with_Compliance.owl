    <skos:altLabel xml:lang="es-mx">Cláusula de indemnización de la parte indemnizadora</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Indemnifying Party Clause</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
