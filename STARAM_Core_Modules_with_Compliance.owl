    <skos:altLabel xml:lang="zh-cn">工作性质条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Nature of Work Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Naturaleza del Trabajo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">काम की प्रकृति धारा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">業務性質条項</skos:altLabel>
