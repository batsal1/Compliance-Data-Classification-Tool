  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8OmVstIMR7qzYcAWgAkhmn">
    <rdfs:label>Natural Language Processing</rdfs:label>
    <skos:altLabel>Computational Linguistics</skos:altLabel>
    <skos:altLabel>Language Technology</skos:altLabel>
    <skos:altLabel>Language Processing Systems</skos:altLabel>
    <skos:prefLabel>NLP</skos:prefLabel>
    <skos:prefLabel>Linguistic Computation</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Natural Language Processing (NLP) is the field of artificial intelligence focused on enabling machines to process, analyze, and generate human language in its spoken, written, or signed forms. NLP involves a range of techniques to understand, interpret, and produce human language in a way that is both meaningful and useful.</skos:definition>
  </rdf:Description>
