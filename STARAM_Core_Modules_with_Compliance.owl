  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVIiXA1507iI23MP579lNU">
    <skos:altLabel xml:lang="en-gb">Sign On Bonus Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בונוס הצטרפות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de bonificación por contratación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de bônus de inscrição</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de prime d'inscription</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">注册奖金条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Anmeldeprämie</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">サインオンボーナス条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">साइन ऑन बोनस क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de bonificación por firma</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A sign-on bonus clause is a provision in a contract that outlines the terms and conditions of a bonus payment made to an employee upon joining a company.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sign On Bonus Clause</rdfs:label>
  </rdf:Description>
