    <skos:definition>A Development Agreement is a legally binding contract between parties that outlines the terms and conditions for the development of a specific property or project.</skos:definition>
    <rdfs:label>Development Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Intellectual Property &amp; Licensing</ns1:contractFamily>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9qhNOMwcjh8voNoOrpOl1j">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Cláusula de interpretación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'interprétation de contrat</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Interpretação de Contrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף כללי לפרשנות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Rule of Construction Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">解释条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निर्माण नियम शब्दावली</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de interpretación</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">解釈規定条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Auslegung von Verträgen</skos:altLabel>
    <rdfs:label>Rule of Construction Clause</rdfs:label>
    <skos:definition>A Rule of Construction Clause is a provision in a contract that helps interpret the meaning of other clauses within the same contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N367b6438f2b549e08c2126d76610926a">
