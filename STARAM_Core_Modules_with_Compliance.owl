  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Cb2vPDnBbUMQTXMAL5053">
    <rdfs:label>Firm Pricing Personnel</rdfs:label>
    <skos:altLabel xml:lang="hi-in">फर्म मूल्य निर्धारण कर्मचारी</skos:altLabel>
    <skos:altLabel xml:lang="he-il">צוות עובדים לקביעת מחירי החברה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">固定価格人員</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Festpreispersonal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Personal de fijación de precios de la empresa</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Personal de fijación de precios de la empresa</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pessoal de preços fixos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">固定定价人员</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Firm Pricing Personnel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">צוות קבוע לתיעוד מחירים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Personnel de tarification ferme</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQxwZ0byxdnIYBnX6xystH"/>
    <skos:definition>Firm Pricing Personnel refers to individuals within a legal service provider who are responsible for determining the pricing of services offered by the firm, and who are not involved in the direct provision of legal services.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
