  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBIjupGmQLqpwi89uEk45qA">
    <rdfs:label>Expiration Date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>For a legal proceeding or regulatory filing (e.g., patent registration, trademark registration) that filing's expiration date refers to the expiration date of a specific status, benefit, or action, as indicated in official documents such as visas, permits, or contracts. This date marks the end of the authorized period for a particular activity, residency, or employment, as determined by the relevant regulatory authority</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7sBKqCcmlK1Dw9HBvKenYy"/>
    <skos:altLabel>Valid Until Date</skos:altLabel>
  </rdf:Description>
