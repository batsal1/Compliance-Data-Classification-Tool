  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCLHAGZf8zvnEMxSqtawmE1">
    <skos:altLabel xml:lang="fr-fr">Clause de caducité</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de caducidade</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">日落条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Sunset Provision Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תקופת חסינות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sonnenuntergangsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de caducidad</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de terminación automática</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">サンセット条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सनसेट प्रोविजन क्लॉज</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sunset Provision Clause</rdfs:label>
    <skos:definition>A sunset provision clause is a type of contractual clause that specifies the expiration date or termination conditions of an agreement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9mz48xbSZ0Hwbl0Uk1Ft3A">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
