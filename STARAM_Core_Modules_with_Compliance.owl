  <rdf:Description rdf:about="https://staram.in/ontology/contracts#TermMaterialAdverseEffect">
    <skos:exactMatch rdf:resource="https://folio.openlegalstandard.org/RCvRDbONKl5tDesEg3gjvqV"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">As used in this register, exceptions/carve-outs noted for this term: Exceptions; Exceptions - Acts of War; Exceptions - Announcement of Transaction; Exceptions - Changes in GAAP; Exceptions - Changes in Law; Exceptions - Changes in Political Conditions; Exceptions - Consummation of the Transaction; Exceptions - Disproportionate Impact; Exceptions - Economic Conditions; Exceptions - Failure to Meet Projections.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/contracts#Definitions"/>
    <rdfs:label xml:lang="en">Material Adverse Effect</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/legislation#textTruncated">
    <rdfs:isDefinedBy rdf:resource="https://staram.in/ontology/legislation#OASISLegislationStructureModule"/>
