  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8o0lzPUMDOV8nWAfYHXpEK">
    <skos:example>Service Provider Overseeing Compliance In A Project Finance Deal</skos:example>
    <skos:example>Financial Institution Managing Communication Between Lenders And Borrowers</skos:example>
    <skos:example>Bank Acting As An Administrative Agent For A Syndicated Loan</skos:example>
    <skos:definition>An Agency Service Provider in project finance transactions acts as an intermediary between the various parties involved, ensuring smooth communication and coordination. This entity manages administrative tasks, facilitates financial transactions, and ensures compliance with contractual obligations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDs4GGRr5BzwWdb6Lci8ZOJ"/>
