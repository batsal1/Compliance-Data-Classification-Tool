    <rdfs:label xml:lang="en">Unrestricted Subsidiary</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/contracts#Definitions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDUwV1w6s9IIIXMTIcuVyBP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>To "Plan and prepare for" (A101) means to engage in activities that involve creating a strategy or course of action in anticipation of a future event or task, as part of a larger set of activities (A100).</skos:definition>
    <rdfs:label>A101 Plan and prepare for</rdfs:label>
