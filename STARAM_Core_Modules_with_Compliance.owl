    <skos:altLabel xml:lang="he-il">הסכם משכנתא</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mortgage Agreement</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Contrato de hipoteca</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de hipoteca</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord hypothécaire</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऋण अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">抵当契約</skos:altLabel>
    <skos:altLabel>Mortgage Loan</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hypothekenvertrag</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Contrato de hipoteca</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">抵押协议</skos:altLabel>
    <skos:prefLabel>Mortgage</skos:prefLabel>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <skos:definition>A Mortgage Agreement is a legal contract between a lender and borrower that outlines the terms and conditions of a loan used to purchase a property, including the repayment schedule and consequences of default.</skos:definition>
    <rdfs:label>Mortgage Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RrUujWsbn4EF5HyLOudSkR">
    <rdfs:subClassOf rdf:nodeID="N5a64191568534934af9cd0d92fde0c83"/>
    <rdfs:subClassOf rdf:nodeID="Nabb26d9032bf465fb7942ffa8db6e85d"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDlYI2CbQn1u95Hs6otNU2O"/>
    <rdfs:label>Domestic Partner</rdfs:label>
    <skos:definition>A Domestic Partner is an individual who lives with another person in a committed, intimate relationship akin to marriage but without legal recognition as a spouse. This status often provides certain legal benefits and responsibilities, such as healthcare decision-making rights and inheritance, similar to those available to married couples.</skos:definition>
    <skos:altLabel>Cohabitant</skos:altLabel>
    <skos:altLabel>Significant Other</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4MpFVcimybNfBOx7hNv8k">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>INVOICE_TOTAL</rdfs:label>
    <skos:definition>The INVOICE_TOTAL concept refers to the total amount of money charged for goods or services listed on an invoice, as defined within the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
  </rdf:Description>
