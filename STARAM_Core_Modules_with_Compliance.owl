    <rdfs:label>Insurance Broker Malpractice</rdfs:label>
    <skos:definition>Insurance Broker Malpractice refers to a type of malpractice claim that arises from the actions or omissions of an insurance broker in the course of providing insurance services to a client.</skos:definition>
  </rdf:Description>
