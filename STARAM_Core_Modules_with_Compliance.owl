    <skos:altLabel xml:lang="zh-cn">放弃实践</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">放棄実践</skos:altLabel>
    <skos:altLabel>Abandonment</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעשה נטישה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Aufgabepraxis</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de abandono</skos:altLabel>
