    <ns1:contractFamily xml:lang="en">Services &amp; Outsourcing</ns1:contractFamily>
    <rdfs:label>Business Process Outsourcing Agreement</rdfs:label>
    <skos:definition>A Business Process Outsourcing Agreement is a legal contract between a company and an external service provider, where the provider undertakes specific business tasks or processes on behalf of the company.</skos:definition>
    <skos:altLabel>BPO Agreement</skos:altLabel>
  </rdf:Description>
