  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDxbjBJjqwTXjdafXhfOgGz">
    <skos:definition>An Elect at Exercise Asset is a financial instrument where the method of delivery of the underlying asset is determined at the time of exercise. This flexibility allows the option holder to choose between physical delivery and cash settlement based on prevailing market conditions or personal preferences at the moment of exercising the option.</skos:definition>
    <rdfs:label>Elect at Exercise Asset</rdfs:label>
    <skos:altLabel>Elective Delivery Asset</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSx31xBISrYHFCYIgupzdB"/>
    <skos:prefLabel>Elective Delivery Financial Instrument</skos:prefLabel>
  </rdf:Description>
