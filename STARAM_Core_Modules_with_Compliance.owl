    <skos:definition>Water coolers merchant wholesalers</skos:definition>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of refrigeration equipment (except household-type refrigerators, freezers, and air-conditioners).</skos:definition>
    <skos:example>Refrigerated display cases merchant wholesalers</skos:example>
    <skos:example>Cold storage machinery merchant wholesalers</skos:example>
    <skos:example>Commercial refrigerators merchant wholesalers</skos:example>
