  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R832GJgr1HXYcI95tvBtaF9">
    <skos:altLabel xml:lang="fr-fr">Clause de prolongation de l'accord</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समझौते की विस्तार धारा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約延長条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de prorrogação do acordo</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הארכת הסכם</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">协议延期条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Verlängerung der Vereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Extensión de Acuerdo</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Extensión de Acuerdo</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Extension of Agreement Clause</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Extension of Agreement Clause is a provision in a contract that allows for the continuation of the agreement beyond its original expiration date.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFanQiAnBUnqQS4PNIuJao"/>
    <rdfs:label>Extension of Agreement Clause</rdfs:label>
  </rdf:Description>
