    <skos:altLabel xml:lang="es-mx">Conducta desordenada</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Conduta desordeira</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不当行为</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुशासित आचरण</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Desorden público</skos:altLabel>
    <skos:altLabel>Provocation of Disturbance</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התנהגות לא מסודרת</skos:altLabel>
    <skos:altLabel>Disturbing the Peace</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Trouble à l'ordre public</skos:altLabel>
    <skos:altLabel>Violent Disorder</skos:altLabel>
    <skos:definition>Any behavior that tends to disturb the public or decorum, scandalize the community, or shock the public sense of morality.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
