    <skos:altLabel xml:lang="de-de">Allgemeine Geschäftsbedingungen Klausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאים והגבלות כלליים</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Termos e Condições Gerais</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Términos y Condiciones Generales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">一般条款和条件条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de conditions générales</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य नियम और शर्तें क्लॉज</skos:altLabel>
    <skos:definition>A General Terms and Conditions Clause is a provision in a contract that outlines the overall terms and conditions of the agreement.</skos:definition>
