    <skos:altLabel xml:lang="he-il">הסכם פרנצ'ייז</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">特许经营协议</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Franchise Agreement</skos:altLabel>
