  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Lyfw7h0kQuW53BpDMtDhiQ">
    <skos:definition>This industry comprises establishments primarily engaged in providing an array of specialty and luxury passenger transportation services via limousine or luxury sedan generally on a reserved basis. These establishments do not operate over regular routes and on regular schedules.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=485320"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/W34Tw5sHTNqJ7fTdB7PAmw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Limousine Service</rdfs:label>
  </rdf:Description>
