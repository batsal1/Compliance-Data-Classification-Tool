  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCB7WyorxZW7KNk40QqQdPl">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCc50c8MA7S8aeFuufxdksV"/>
    <skos:altLabel xml:lang="zh-cn">超出允许使用范围</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">許可された使用範囲を超える</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעבר לטווח השימוש המותר</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Más allá del alcance del uso permitido</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Além do escopo de uso permitido</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Más allá del alcance del uso permitido</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Au-delà de la portée de l'utilisation autorisée</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुमति दिए गए उपयोग की सीमा से बाहर</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Beyond Scope of Permissive Use</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Über den Umfang der zulässigen Nutzung hinaus</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Defendant is not liable if defendant proves the permission given was for a limited time, place, or purpose which scope was exceeded.</skos:definition>
    <rdfs:label>Beyond Scope of Permissive Use</rdfs:label>
  </rdf:Description>
