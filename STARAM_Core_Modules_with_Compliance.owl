  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8uaOTdTaAuNmWKOgiGiD9t">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en-gb">Lost Capacity in Living Resulting from Tort</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Pérdida de capacidad de vivir como resultado de un delito</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Pérdida de capacidad de vivir como resultado de un delito</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">因酷刑而导致的生活能力丧失</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Perda de capacidade de viver resultante de tortura</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגיעה ביכולת לחיות כתוצאה מפשע</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">तोड़फोड़ से होने वाली जीवन में क्षमता का नुकसान</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verlorene Lebensqualität aufgrund von Folter</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Perte de capacité de vivre résultant de la torture</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">拷問による生活能力の喪失</skos:altLabel>
    <skos:definition>The concept of Lost Capacity in Living Resulting from Tort refers to the reduction in a person's ability to enjoy life due to injuries caused by someone else's wrongful act, for which compensation may be sought in a personal injury claim under the category of non-economic damages.</skos:definition>
    <rdfs:label>Lost Capacity in Living Resulting from Tort</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R93vdMmojgalkwnj531Qdlx">
    <skos:altLabel xml:lang="fr-fr">Clause de confidentialité des documents et des informations</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दस्तावेज़ और सूचना की गोपनीयता अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סודיות מסמכים ומידע</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Confidentiality of Documents and Information Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">文書および情報の機密保持条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertraulichkeitsklausel für Dokumente und Informationen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">文件和信息保密条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de confidencialidade de documentos e informações</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Confidencialidad de Documentos e Información</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Confidencialidad de Documentos e Información</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Confidentiality of Documents and Information Clause</rdfs:label>
    <skos:definition>A Confidentiality of Documents and Information Clause is a provision in a contract that requires the parties to keep certain information confidential and not disclose it to third parties without authorization.</skos:definition>
  </rdf:Description>
