  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9auCu5af3YRnpebdBnsVkv">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <skos:altLabel>Healthcare Recipient</skos:altLabel>
    <skos:altLabel>Medical Care Receiver</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Patient</rdfs:label>
    <skos:definition>A Patient is an individual who receives medical care, treatment, or other health services from a healthcare provider or institution. This person is under professional care due to illness, injury, or for preventive health measures, and is the recipient of medical attention, diagnosis, and therapeutic interventions.</skos:definition>
  </rdf:Description>
