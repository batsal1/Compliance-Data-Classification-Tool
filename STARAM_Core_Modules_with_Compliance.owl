    <skos:altLabel xml:lang="hi-in">राजनीतिक वोट विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio de voto político</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège de vote politique</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio de Voto Político</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Political Vote Privilege</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">政治的投票特権</skos:altLabel>
    <rdfs:label>Political Vote Privilege</rdfs:label>
