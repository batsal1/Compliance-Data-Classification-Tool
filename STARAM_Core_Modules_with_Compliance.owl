  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ra1ZjvLdH7yzudCHZixw6l">
    <skos:altLabel xml:lang="es-mx">Cláusula de arrendamiento mensual</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">月々の賃貸契約条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Month to Month Tenancy Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de locação mensal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שכירות חודשי</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">月租条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de location mensuelle</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">महीने के महीने किराये की शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de arrendamiento mensual</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel für monatliche Mietverhältnisse</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Month to Month Tenancy Clause</rdfs:label>
    <skos:definition>A month-to-month tenancy clause is a provision in a contract that allows a tenant to occupy a property on a monthly basis without a fixed term commitment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/_M0G3f3hS3SISj0UPwBWUA">
    <skos:example>Concrete product (e.g., structural precast, structural prestressed) installation</skos:example>
    <skos:example>Erecting structural steel</skos:example>
    <skos:example>Placing and tying reinforcing rod at a construction site</skos:example>
    <skos:example>Reinforcing steel contractors</skos:example>
    <skos:example>Rebar contractors</skos:example>
    <skos:example>Precast concrete panel, slab, or form installation</skos:example>
    <skos:example>Structural steel contractors</skos:example>
    <skos:definition>This industry comprises establishments primarily engaged in (1) erecting and assembling structural parts made from steel or precast concrete (e.g., steel beams, structural steel components, and similar products of precast concrete) and/or (2) assembling and installing other steel construction products (e.g., steel rods, bars, rebar, mesh, and cages) to reinforce poured-in-place concrete. The work performed may include new work, additions, alterations, maintenance, and repairs.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=238120"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Q1nqA7oCT2qxNilrYkoRHg"/>
    <rdfs:label>Structural Steel and Precast Concrete Contractors</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9tIoV6NSL01NJcZzv2QgzY">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RChRXRlMt5J5wkUApU4J9zz"/>
    <skos:altLabel xml:lang="he-il">זיהוי מגשר המשפטי</skos:altLabel>
    <skos:altLabel>Bar ID</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Identificador del Colegio de Abogados</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anwaltskammer-Identifikator</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">律师协会标识符</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זיהוי מקצועי של עורך דין</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Identificador da Ordem dos Advogados</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">弁護士会議識別子</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lawyer's Bar Identifier</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वकील बार पहचानकर्ता</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Identificador del Colegio de Abogados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Identifiant du barreau de l'avocat</skos:altLabel>
    <skos:altLabel>Bar Admission Number</skos:altLabel>
    <skos:definition>A Lawyer Identifier is a unique number or code assigned to a lawyer upon admission to practice law in a specific jurisdiction, such as a Bar Admission Number.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Lawyer's Bar Identifier</rdfs:label>
  </rdf:Description>
