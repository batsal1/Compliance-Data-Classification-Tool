  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9JIe7aURW35qmdzdEaQwQ4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Haftungsausschluss- und Gewährleistungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Representações e Garantias</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रतिनिधित्व और वारंटी क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Representaciones y Garantías</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Representations and Warranties Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">表明および保証条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">陈述与保证条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Representaciones y Garantías</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de représentations et garanties</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מיוצגים ואחריות</skos:altLabel>
    <rdfs:label>Representations and Warranties Clause</rdfs:label>
    <skos:definition>A Representations and Warranties Clause is a contractual provision in which one party makes certain statements about the subject matter of the contract, and warrants that those statements are true and accurate, thereby providing assurance to the other party.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8phitqyUIXJ4ZdLaJjabna">
    <skos:altLabel xml:lang="en-gb">Trademark and Trade Dress Law</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito de Marcas e Designações Comerciais</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ley de Marcas y Diseño Comercial</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ley de Marcas y Diseño Comercial</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">商標及び外観権法</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ट्रेडमार्क और ट्रेड ड्रेस कानून</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit des marques et des habillages commerciaux</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Marken- und Geschmacksmusterrecht</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商标和外观设计法</skos:altLabel>
    <skos:altLabel>Trademark and Trade Dress Law</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוק סימני מסחר ועיצוב מסחרי</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-INTP-TMRK</ns2:legacyIdentifier>
    <skos:hiddenLabel>TMRK</skos:hiddenLabel>
    <rdfs:label>Trademark and Trade Dress Law</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdMucRftztKt4Ag7WzUxX"/>
    <skos:prefLabel>Trademark and Trade Dress Law</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>INTP-TMRK</dc:identifier>
    <dc:identifier>IN-LAW-20.4</dc:identifier>
    <skos:definition>Law protecting a business' commercial identity or brand by or product design discouraging other businesses from adopting a name, logo or design that is "confusingly similar" to an existing trademark or design.</skos:definition>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#resolvedByPrecedenceRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Links a finding or a conflict to the precedence rule that determines which component prevails. A conflict with no such link is an unresolved conflict.</skos:definition>
