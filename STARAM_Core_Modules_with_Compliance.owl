  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R88VLhcFqAzYcQcfQzhYhgU">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
    <skos:definition>The Faithless Servant Doctrine is a legal concept that holds an agent liable for any profits they wrongfully obtain while acting on behalf of their principal.</skos:definition>
    <skos:altLabel xml:lang="de-de">Lehre vom treulosen Diener</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Doctrina del siervo infiel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विश्वासघाती सेवक डॉक्ट्रिन</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Doctrina del siervo infiel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Faithless Servant Doctrine</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不忠仆人原则</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Doutrina do Servo Infiel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不忠な使用人の教義</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תורת העבד הבלתי נאמן</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Doctrine du serviteur infidèle</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Faithless Servant Doctrine</rdfs:label>
  </rdf:Description>
