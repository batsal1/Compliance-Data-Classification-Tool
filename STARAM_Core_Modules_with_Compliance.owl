  <rdf:Description rdf:about="https://folio.openlegalstandard.org/DSxlUvfHT0awVZ78QeZIIw">
    <skos:example>Aluminum compounds, not specified elsewhere by process, manufacturing</skos:example>
    <skos:example>Carbon black manufacturing</skos:example>
    <skos:example>Hydrochloric acid manufacturing</skos:example>
    <skos:example>Chlorine manufacturing</skos:example>
    <skos:example>Potassium inorganic compounds, not specified elsewhere by process, manufacturing</skos:example>
    <skos:example>Alkalies manufacturing</skos:example>
    <skos:example>Sulfuric acid manufacturing</skos:example>
    <skos:example>Carbides (e.g., baron, calcium, silicon, tungsten) manufacturing</skos:example>
    <skos:example>Sulfides and sulfites manufacturing</skos:example>
    <skos:example>Radioactive isotopes manufacturing</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325180"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Dz0_4UL7QRGssxVMIKlP2g"/>
    <rdfs:label>Other Basic Inorganic Chemical Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing basic inorganic chemicals (except industrial gases and synthetic dyes and pigments).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/WmIEPfNTSMiLM5RHR6MRXA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=532420"/>
    <skos:definition>This industry comprises establishments primarily engaged in renting or leasing office machinery and equipment, such as computers, office furniture, duplicating machines (i.e., copiers), or facsimile machines.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/0lNFblcERdGbvgw9pY1flw"/>
    <rdfs:label>Office Machinery and Equipment Rental and Leasing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8YpJBaF5zesoc0jtaNESdQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
    <rdfs:label>Precedent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Precedent refers to a legal decision or judgment passed in a previous case, used as an authoritative rule or example in subsequent similar cases. It serves as a guiding principle, helping courts decide future cases with similar issues or facts.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/YZD1MTnYRQi3oCRr8AP1Jw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/OHRgpwVGRR2OOs9XZgkEgA"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing aircraft engines and engine parts; (2) developing and making prototypes of aircraft engines and engine parts; (3) aircraft propulsion system conversion (i.e., major modifications to systems); and (4) aircraft propulsion systems overhaul and rebuilding (i.e., periodic restoration of aircraft propulsion system to original design specifications).</skos:definition>
    <rdfs:label>Aircraft Engine and Engine Parts Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=336412"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rrg4cyS943amEafmkgc879">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
    <skos:altLabel xml:lang="en-gb">General Welfare Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף הרווחה הכללית</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Bienestar General</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula do Bem-Estar Geral</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">一般福祉条項主張</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">一般福利条款主张</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य कल्याण शर्त दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Bienestar General</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de la clause du bien-être général</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf die Klausel zum allgemeinen Wohlstand</skos:altLabel>
    <rdfs:label>General Welfare Clause Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A General Welfare Clause claim refers to a legal argument challenging the constitutionality of a law or government action based on the interpretation and application of the General Welfare Clause found in the United States Constitution. This claim asserts that the law or action exceeds the scope of the federal government's authority by not promoting the general welfare of the people, as mandated by the Clause, and therefore may be unconstitutional.</skos:definition>
  </rdf:Description>
