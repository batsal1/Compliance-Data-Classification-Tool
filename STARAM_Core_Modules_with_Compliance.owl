  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R782rseywIikSx01LgfUJ01">
    <skos:altLabel xml:lang="es-mx">Incarceración por tiempo cumplido</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הכלאה עבור זמן שהושהה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Inhaftierung für verbüßte Zeit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">既に服役したための収監</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समय के लिए कारावास</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Encarcelamiento por tiempo cumplido</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">已服刑入狱</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Incarceration for Time Served</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prisão por tempo cumprido</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Emprisonnement pour temps déjà purgé</skos:altLabel>
    <rdfs:label>Incarceration for Time Served</rdfs:label>
    <skos:definition>The concept of "Incarceration for Time Served" refers to the legal practice of releasing a prisoner from custody after they have served the full length of their sentence, including any time spent in pre-trial detention or custody.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ItOPdbcc8mA2sYecRl3cu"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9DCJMzRXnPZMWQqQuPLECx">
    <rdfs:subClassOf rdf:nodeID="N6b7e08b5b20c44fd815cdaa7f0d5bf41"/>
    <rdfs:subClassOf rdf:nodeID="N751516e6a44947f9a36c6e0a79be88ae"/>
    <rdfs:subClassOf rdf:nodeID="N6a5dd0bbc18f4c55875c8257301ba7a7"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KxYUBMSAuzPHdBhWfPSv7"/>
    <rdfs:subClassOf rdf:nodeID="N630c17f7fb5d4ce7be6484159f6d86a7"/>
    <rdfs:subClassOf rdf:nodeID="Nbca53f17885e4cc2bff0db661e2af880"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Gender-Based Market Segment</rdfs:label>
    <skos:definition>Gender-based market segments refer to divisions of the market that are categorized based on the gender of consumers. These segments allow businesses to tailor their products, services, and marketing strategies to cater to the specific needs, preferences, and behaviors of different gender groups, such as men, women, and non-binary individuals.</skos:definition>
    <skos:prefLabel>Sex-Based Market Segment</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc24f207f41be4752bc6fc262a7736957">
