  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8jcVDnQwdnKGmGiTEDU6a0">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aVRgLAjmuf0OiloIoc9pm"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Borda count electoral system is a voting method where voters rank candidates in order of preference, and points are assigned based on the position in which each candidate is ranked. The candidate with the highest total points across all ballots wins the election, promoting a consensus-based selection rather than a simple majority.</skos:definition>
    <rdfs:label>Borda Count Electoral System</rdfs:label>
  </rdf:Description>
