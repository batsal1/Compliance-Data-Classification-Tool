  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RskHhsuhWsZ8Bjxgt5n7yD">
    <skos:altLabel xml:lang="hi-in">लिखित अनुबंध में भ्रामक भाषा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שפה מבלבלת בחוזה כתוב</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verwirrende Sprache in schriftlichem Vertrag</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">書面契約における混乱した言語</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Confusing Language in Written Contract</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Langage confus dans un contrat écrit</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lenguaje confuso en contrato escrito</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">书面合同中的混淆语言</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Linguagem confusa em contrato escrito</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Lenguaje confuso en contrato escrito</skos:altLabel>
    <skos:definition>The concept of "Confusing Language in Written Contract" refers to the use of unclear or ambiguous terms in a written agreement, which may lead to disputes or misunderstandings between the parties involved.</skos:definition>
    <rdfs:label>Confusing Language in Written Contract</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R87qxvkj3w9hwJO2ZVp4sRa">
    <skos:altLabel xml:lang="ja-jp">ベスティングスケジュール条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de calendrier de libération</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेस्टिंग अनुसूची शर्त</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף לוח זמני רכישה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Programación de Adquisición</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Vesting Schedule Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Programación de Vencimiento</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de cronograma de aquisição</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">归属计划条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vestingschema-Klausel</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Vesting Schedule Clause</rdfs:label>
    <skos:definition>A Vesting Schedule Clause is a provision in a contract that outlines the schedule for when an individual's ownership or entitlement to something, such as stock options or retirement benefits, becomes fully realized.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ryz3VWLysfUWxexbNfV2MA">
    <skos:altLabel xml:lang="fr-fr">Loi désapprouvée</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不被批准的法律</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不承認法</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei desaprovada</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Abgelehntes Gesetz</skos:altLabel>
    <skos:definition>The previously effective law has been disapproved by some authority (e.g., appellate court, judge).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Disapproved Law</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7g26D3ngRM7ylTT72MlAUW"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/sRxB9Rr0SOqAHsdRgOhU3g">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Luggage and Leather Goods Retailers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/tC-ANburRjGXa9bmfoQdTA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=458320"/>
    <skos:definition>This industry comprises establishments primarily engaged in retailing new luggage, briefcases, and trunks, or retailing these new products in combination with a general line of leather items (except leather apparel), such as belts, gloves, and handbags.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RgsvxYKhqRKNkjPVgxJIKt">
    <skos:altLabel xml:lang="es-es">Cláusula de Mediación</skos:altLabel>
