  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBUe0cQF64tyOYgN6tqTSLm">
    <skos:altLabel xml:lang="de-de">Diskriminierung aufgrund von Behinderung und medizinischem Zustand</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Discrimination fondée sur le handicap et l'état de santé</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">障害および医療状態に基づく差別</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Discriminação por deficiência e condição médica</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">残疾和医疗状况歧视</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Discrimination based on a person's disability or medical condition, which is prohibited by law and can be the basis for a legal claim.</skos:definition>
    <rdfs:label>Disability and Medical Condition Discrimination</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
  </rdf:Description>
