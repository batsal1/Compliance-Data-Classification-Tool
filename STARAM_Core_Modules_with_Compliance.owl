  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RgtlFP9wL8nEQ4Khh2uXSl">
    <skos:altLabel>Delayed Offering</skos:altLabel>
    <skos:altLabel>Continuous Public Offering</skos:altLabel>
    <skos:altLabel>Continuous Offering</skos:altLabel>
    <skos:altLabel>Shelf Offering</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Shelf Registration</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8sLSP3fcYlpo2TNHbyFkQ8"/>
    <skos:definition>Shelf Registration is a process that allows a company to register a new issue of securities without having to sell the entire issue at once, enabling the company to sell portions of the issue over time. This method provides flexibility and efficiency in accessing capital markets as conditions become favorable.</skos:definition>
  </rdf:Description>
