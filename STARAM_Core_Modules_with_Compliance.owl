  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9GiJsMoTZg1cqRPGgwmQ2H">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The trademark renewal process is a legal procedure that allows the owner of a registered trademark to extend the protection of the trademark beyond its initial term. This process typically involves submitting a renewal application and paying the required fees before the expiration of the current registration period.</skos:definition>
    <rdfs:label>Trademark Renewal Process</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rb9ymr4tGQwciL1lrwg0UN"/>
  </rdf:Description>
