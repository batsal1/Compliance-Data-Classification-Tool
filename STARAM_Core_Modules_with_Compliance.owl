  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBoDiMryDOIE3XWHl6qgL3y">
    <skos:altLabel xml:lang="en-gb">Beyond a Reasonable Doubt</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合理怀疑的界限之外</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Além de qualquer dúvida razoável</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Jenseits jeden vernünftigen Zweifels</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Hors de tout doute raisonnable</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合理的疑いを超えて</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक वजहबल शक से परे</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעבר לספק סביר</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Más allá de toda duda razonable</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fuera de toda duda razonable</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
    <rdfs:label>Beyond a Reasonable Doubt</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Beyond a Reasonable Doubt" refers to the highest standard of proof required in a criminal trial, where the evidence presented must be so convincing that there is no reasonable doubt in the mind of a reasonable person that the defendant committed the crime.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RyeqviATd4YRSAiT6TX6qn">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBkzNeCV70lWNDKaIVq358i"/>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Buddhist Law, while not codified as a formal legal system in most regions, refers to the ethical and moral teachings derived from the teachings of the Buddha, especially the Vinaya, which governs the conduct of Buddhist monastics.</skos:definition>
    <rdfs:label>Buddhist Law</rdfs:label>
    <dc:identifier>IN-LAW-29.1</dc:identifier>
    <skos:altLabel>Vinaya</skos:altLabel>
    <skos:prefLabel>Buddhist Law</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDqSn32zsjxExcBFzIYxT2D">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:nodeID="Nca1679313d144d078b3c959a43764def"/>
    <rdfs:subClassOf rdf:nodeID="N38cbd43910ca4d21a25738526c482222"/>
    <skos:definition>Tort Claims are civil claims that arise from a wrongful act or omission that causes harm or injury to another person, property, or reputation, and for which the injured party may seek compensation or damages.</skos:definition>
    <skos:altLabel xml:lang="de-de">Haftungsansprüche</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות עזיבה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones por agravios</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Actions en responsabilité civile</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Tort Claims</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reclamações por danos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">侵权索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不法行為請求</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">टॉर्ट दावे</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones por agravios</skos:altLabel>
    <rdfs:label>Tort Claims</rdfs:label>
  </rdf:Description>
