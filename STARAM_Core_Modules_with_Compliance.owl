    <skos:altLabel xml:lang="en-gb">Deed of Trust</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Deed of Trust is a legal agreement that transfers the title of real property to a trustee as security for a loan between a borrower and a lender.</skos:definition>
    <rdfs:label>Deed of Trust</rdfs:label>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
  </rdf:Description>
