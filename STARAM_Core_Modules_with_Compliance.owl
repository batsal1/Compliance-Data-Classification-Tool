  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RxoNw5zBCTjk6cahJCSDjD">
    <skos:altLabel>Ethical AI Design</skos:altLabel>
    <skos:altLabel>Value-Based AI</skos:altLabel>
    <skos:altLabel>Value-Oriented AI</skos:altLabel>
    <skos:altLabel>Culturally Aware AI</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Human Values For AI</rdfs:label>
    <skos:prefLabel>Ethically Aligned AI Systems</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
    <skos:definition>Human Values for AI recognize that AI systems are not value-neutral and that their design must incorporate idealized qualities or conditions deemed good by society. Designing AI with human values involves negotiating different value systems, making ethical decisions, and considering governance, policies, and incentives while respecting cultural diversity and social and economic interests</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N752e25946ab444e5a497476eec46432a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
