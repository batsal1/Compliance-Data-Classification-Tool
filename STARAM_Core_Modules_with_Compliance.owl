  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBqyMMilyJsOelem8C8QQRu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Interferencia con la Relación Contractual</skos:altLabel>
    <skos:altLabel>Contract Performance Interfered with by Outsider</skos:altLabel>
    <skos:altLabel>Business Intentionally Interfered With by Outsider</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">干涉合同关系</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ठेकेदारी संबंध में हस्तक्षेप</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Störung des Vertragsverhältnisses</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interference with Contractual Relationship</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרעה בקשר חוזי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência em relação contratual</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia con la Relación Contractual</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約関係の妨害</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de contrat</skos:altLabel>
    <rdfs:label>Interference with Contractual Relationship</rdfs:label>
    <skos:definition>Interference with Contractual Relationship is the intentional or negligent interference by a third party with a contractual relationship between two parties, resulting in damages to one or both parties.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFs8eqGTlY90gkX2NFNLTH"/>
  </rdf:Description>
