  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RYzJVyjhwllqE6bBdEFnQ2">
    <skos:altLabel xml:lang="en-gb">Unlawful Warrant Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de orden de registro ilegal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">違法な令状の主張</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf rechtswidrigen Haftbefehl</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת צו איסור לגישה בלתי חוקית</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de mandado ilegal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de orden de registro ilegal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवैध वारंट दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非法拘留索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de mandat illégal</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KGGhirGUj2y81W5Kp7TT2"/>
    <rdfs:label>Unlawful Warrant Claim</rdfs:label>
    <skos:definition>An unlawful warrant claim is a legal assertion that a search or arrest warrant was issued without proper justification or did not meet the required legal standards, thereby violating an individual's constitutional rights.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
