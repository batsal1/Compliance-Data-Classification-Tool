  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-document-hierarchy">
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-legal-liability"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-pre-award"/>
    <skos:prefLabel xml:lang="en">Document Hierarchy, Precedence &amp; Corrigendum</skos:prefLabel>
    <rdfs:label xml:lang="en">Document Hierarchy, Precedence &amp; Corrigendum</rdfs:label>
    <skos:scopeNote xml:lang="en">Covers register serial numbers 1 to 10. This is the only category whose risks are inherently about the relationship between documents. Model these risks with epc:conflictsWith, epc:amends and epc:resolvedByPrecedenceRule rather than by pointing to a single clause.</skos:scopeNote>
    <skos:definition xml:lang="en">Risks that arise from how the contract documents relate to one another rather than from any single provision, covering order of precedence, corrigenda that have not been reconciled, and inconsistent definitions and dates.</skos:definition>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <skos:notation>LR-01</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
  </rdf:Description>
