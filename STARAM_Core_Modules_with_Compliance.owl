  <rdf:Description rdf:about="https://folio.openlegalstandard.org/jrg6Ufe-Tx2lnzgn1Id0Wg">
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of products of the primary metals industries. Service centers maintain inventory and may perform functions, such as sawing, shearing, bending, leveling, cleaning, or edging, on a custom basis as part of sales transactions.</skos:definition>
    <skos:example>Metal bars (except precious) merchant wholesalers</skos:example>
    <skos:example>Metal spikes merchant wholesalers</skos:example>
    <skos:example>Metal rods merchant wholesalers</skos:example>
    <skos:example>Cast iron pipe merchant wholesalers</skos:example>
    <skos:example>Noninsulated wire merchant wholesalers</skos:example>
    <skos:example>Metal pipe merchant wholesalers</skos:example>
    <skos:example>Metal plates merchant wholesalers</skos:example>
    <skos:example>Metal sheets merchant wholesalers</skos:example>
    <skos:example>Nails merchant wholesalers</skos:example>
    <skos:example>Metal ingots (except precious) merchant wholesalers</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423510"/>
    <rdfs:label>Metal Service Centers and Other Metal Merchant Wholesalers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/-CymbomUSG-tmTQSPlFoQQ"/>
  </rdf:Description>
