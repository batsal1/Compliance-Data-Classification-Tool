  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCERRYZLasFJUnLuEVqfrFN">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RkIejtiO3CUzgQe98NWyPq"/>
    <rdfs:label>Human Resources Business Partner Manager</rdfs:label>
    <skos:definition>An HRBP Manager, or Human Resources Business Partner Manager, is a managerial role within the Human Resources department focused on aligning business objectives with employees and management. They serve as a consultant to the management team on HR-related issues and work to develop integrated solutions that optimize employee performance, engagement, and retention</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>HRBP Manager</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/AtpClf7tR5SbFk363YGzRg">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in offering preparation for standardized examinations and/or academic tutoring services.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ZPOZN-AIQOG6rXrpt2o7mA"/>
    <skos:example>Professional examination review instruction</skos:example>
    <skos:example>Learning centers offering remedial courses</skos:example>
    <skos:example>Academic tutoring services</skos:example>
    <skos:example>College board preparation centers</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=611691"/>
    <rdfs:label>Exam Preparation and Tutoring</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RrZ8GeZZWg1PSJ3c7SqMwn">
    <skos:altLabel>Rights Offering</skos:altLabel>
    <skos:altLabel>Rights Offering Service</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Rights Offering Practice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5mVKmojg3FKSzxupI6FLy"/>
    <skos:prefLabel>Rights Issue</skos:prefLabel>
    <skos:definition>Rights Offering Practice is a method of equity financing in which a company offers its existing shareholders the right to purchase additional shares of stock, typically at a discounted price, before the shares are offered to the general public. This practice allows companies to raise capital while giving current shareholders the opportunity to maintain their proportional ownership.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RWyivPLyBOY3TzWAIEcXY4">
    <skos:altLabel xml:lang="zh-cn">准合同索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de Quase-Contrato</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de cuasicontrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת חוזה כמעטי</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्वासी-अनुबंध दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch aus ungerechtfertigter Bereicherung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">準契約請求</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de cuasicontrato</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Action en quasi-contrat</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Quasi-Contract Claim</skos:altLabel>
    <skos:definition>A quasi-contract claim is a legal claim that arises when one party receives a benefit from another party, even though there was no actual contract between them, and the law implies a promise to pay for that benefit.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:label>Quasi-Contract Claim</rdfs:label>
  </rdf:Description>
