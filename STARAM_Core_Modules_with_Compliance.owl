    <dc:identifier>IN-INDUSTRY-1</dc:identifier>
    <dc:identifier>AFS</dc:identifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
    <rdfs:label>Accommodation and Food Services Industry</rdfs:label>
    <skos:hiddenLabel>AFS</skos:hiddenLabel>
    <skos:definition>The Accommodation and Food Services industry group comprises establishments providing customers with lodging and/or preparing meals, snacks, and beverages for immediate consumption. The sector includes both accommodation and food services establishments because the two activities are often combined at the same establishment.</skos:definition>
