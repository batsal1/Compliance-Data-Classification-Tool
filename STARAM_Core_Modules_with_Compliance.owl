    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9ksYmaNhrwE6VL9r0qV1sL">
    <skos:altLabel xml:lang="es-mx">Lenguaje general de exención fiduciaria</skos:altLabel>
    <skos:altLabel>General Fiduciary Exemption</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שפת פטור פידוציארי כללית</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lenguaje general de exención fiduciaria</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य फिडूशियरी छूट भाषा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">General Fiduciary Exemption Language</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCZmEz3VSzAcKpjGH5Wu1ir"/>
    <rdfs:label>General Fiduciary Exemption Language</rdfs:label>
    <skos:definition>General Fiduciary Exemption Language refers to a legal provision that exempts fiduciaries from liability for certain actions or decisions that may be inconsistent with their fiduciary duties, as long as they were made in good faith and with reasonable care.</skos:definition>
  </rdf:Description>
