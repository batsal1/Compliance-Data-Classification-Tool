    <skos:altLabel xml:lang="ja-jp">独占禁止法 - 価格請求</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Antitrust - Réclamations de prix</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反垄断 - 定价索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות מחירים</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações de Preços</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Antitrust - Pricing Claims</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wettbewerbsrecht - Preisgestaltungsansprüche</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCFPWMbdFLbplboOqvI77Jh"/>
    <skos:definition>Antitrust - Pricing Claims refer to allegations of anti-competitive behavior related to pricing practices, such as price-fixing or predatory pricing, in violation of antitrust laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Antitrust - Pricing Claims</rdfs:label>
  </rdf:Description>
