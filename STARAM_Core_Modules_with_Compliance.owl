  <rdf:Description rdf:about="https://folio.openlegalstandard.org/tmzg1yQbR9yQeds8CVpg0w">
    <rdfs:label>Motor Vehicle Body and Trailer Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in (1) manufacturing motor vehicle bodies and cabs or (2) manufacturing truck, automobile and utility trailers, truck trailer chassis, detachable trailer bodies, and detachable trailer chassis.  The products made may be sold separately or may be assembled on purchased chassis and sold as complete vehicles.  Motor homes are units where the motor and the living quarters are contained in the same integrated unit, while travel trailers are designed to be towed by a motor unit, such as an automobile or a light truck.</skos:definition>
    <skos:example>Semi-trailers manufacturing</skos:example>
    <skos:example>Travel trailers, recreational, manufacturing</skos:example>
    <skos:example>Bodies and cabs, truck, manufacturing</skos:example>
    <skos:example>Motor homes, self-contained, assembling on purchased chassis</skos:example>
    <skos:example>Camper units, slide-in, for pick-up trucks, manufacturing</skos:example>
    <skos:example>Pick-up canopies, caps, or covers manufacturing</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/JQTWdrH7S26SGa03JzRcug"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33621"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
