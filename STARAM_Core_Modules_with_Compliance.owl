  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCzNI1QoW4KZCDSoIqjFHFj">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <skos:prefLabel>Insolvency Initiation Type</skos:prefLabel>
    <skos:altLabel>Insolvency Filing Method</skos:altLabel>
    <skos:altLabel>Bankruptcy Commencement Method</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bankruptcy Initiation Type</rdfs:label>
    <skos:definition>Bankruptcy Initiation Type refers to the classification of bankruptcy proceedings based on who initiates the process. It includes subclasses Voluntary Bankruptcy, where the debtor voluntarily files for bankruptcy, and Involuntary Bankruptcy, where creditors force the debtor into bankruptcy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nda00b9d89fee42e2ac218d2c7a762872">
