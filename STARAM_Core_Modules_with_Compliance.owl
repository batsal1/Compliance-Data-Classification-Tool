  <rdf:Description rdf:about="https://folio.openlegalstandard.org/qyKd9K3RR-KMVz1Cw0qhBw">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=31194"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/bVu-tszYQS2MtoFucM1fZA"/>
    <rdfs:label>Seasoning and Dressing Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing dressings and sauces, such as mayonnaise, salad dressing, vinegar, mustard, horseradish, soy sauce, tartar sauce, Worcestershire sauce, and other prepared sauces (except tomato-based and gravies); (2) manufacturing spices, table salt, seasoning, and flavoring extracts (except coffee and meat), and natural food colorings; and (3) manufacturing dry mix food preparations, such as salad dressing mixes, gravy and sauce mixes, frosting mixes, and other dry mix preparations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8U7OnAYHvuh8BdypxQfRgX">
