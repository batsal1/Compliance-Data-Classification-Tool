    <skos:prefLabel>Medicare Coverage</skos:prefLabel>
    <skos:definition>Universal healthcare coverage refers to a system where all residents of a country have access to healthcare services, usually funded by the government. In the U.S., Medicare is often cited as an example, though it primarily serves individuals 65 and older or those with specific disabilities, rather than the entire population.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Universal Healthcare Coverage Policy</rdfs:label>
  </rdf:Description>
