  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBm3VMZFqLwhzWkXh7uimt1">
    <skos:altLabel xml:lang="he-il">עונש שירות ציבורי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">社会奉仕刑</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pena de Serviço Comunitário</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Community Service Order</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Trabajo en beneficio de la comunidad</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Peine de travail d'intérêt général</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">社区服务刑</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gemeinnützige Strafe</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समुदाय सेवा दंड</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Prestación de servicios a la comunidad</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl"/>
    <skos:definition>A community service penalty is a type of criminal penalty that requires an offender to perform unpaid work for the benefit of the community, as a form of punishment for their offense.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Community Service Penalty</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RvOCpmr98FwBq1EZ2L86iV">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRTsPoZhucp80NJy00WHwY"/>
    <rdfs:label>Single Transferable Vote System</rdfs:label>
    <dc:source rdf:resource="https://en.wikipedia.org/wiki/Single_transferable_vote"/>
    <skos:altLabel>STV</skos:altLabel>
    <skos:definition>The Single Transferable Vote (STV) system is a proportional voting method where voters rank candidates in order of preference. Votes are initially allocated to each voter's first preference, and if a candidate reaches a specified quota, they are elected; any surplus votes are transferred to remaining candidates based on the voters' next preferences, and this process continues until all seats are filled.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
