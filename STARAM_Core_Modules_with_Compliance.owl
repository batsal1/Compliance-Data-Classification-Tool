  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RHBAWBNGU2uLqb1Hf0YF1Y">
    <skos:altLabel xml:lang="en-gb">One-Step Merger</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fusão em uma etapa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fusión en un solo paso</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक-चरण विलय</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מסירה בשלב אחד</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ワンステップ合併</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fusion en une seule étape</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">一步合并</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fusión en un solo paso</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ein-Schritt-Fusion</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RQK2hPELdaFnrBqNkJFzWO"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <rdfs:label>One-Step Merger</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
    <skos:definition>A One-Step Merger is a type of merger where the acquiring company merges directly with the target company, without the need for a separate shareholder vote on the merger agreement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/xetp3Y4fRFmL7GChfaeTvw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Mantel, marble or stone, installation</skos:example>
    <skos:example>Stone flooring installation</skos:example>
    <skos:example>Ceramic tile installation</skos:example>
    <skos:example>Marble, granite, and slate, interior installation contractors</skos:example>
    <skos:example>Mosaic work</skos:example>
    <skos:example>Tile (except resilient) laying and setting</skos:example>
    <rdfs:label>Tile and Terrazzo Contractors</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=238340"/>
    <skos:definition>This industry comprises establishments primarily engaged in setting and installing ceramic tile, stone (interior only), and mosaic and/or mixing marble particles and cement to make terrazzo at the job site. The work performed may include new work, additions, alterations, maintenance, and repairs.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/5jQYQW4wSkyNl4l4T3Fpmg"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7nqxxlAfhYqqSA2UQ5UxpX">
    <skos:altLabel xml:lang="pt-br">Negligência</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過失</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">疏忽</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit</skos:altLabel>
    <rdfs:label>Negligence</rdfs:label>
    <skos:definition>Negligence is a legal concept that refers to the failure to exercise reasonable care, resulting in harm or injury to another person or property.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Het7mFmt5GhljEZERkDpM">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Jv88vklSkqJGJCJCeVItp"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBpsWIRUJELHpUvE3xQw7Of"/>
    <rdfs:label>Repapering Management Services</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Repapering Management Services refers to the provision of alternative legal services that specifically involve managing the process of updating legal documents and contracts to comply with new regulations or requirements.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5S7Kc0zSEu_T8b8PUXhzw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/QIzHBkOqTPKH967TaRYAsA"/>
    <skos:example>Rock salt mining and/or beneficiating</skos:example>
    <skos:example>Phosphate rock mining and/or beneficiating</skos:example>
    <skos:example>Peat mining and/or beneficiating</skos:example>
    <skos:example>Barite mining and/or beneficiating</skos:example>
    <skos:example>Borate, natural, mining and/or beneficiating</skos:example>
    <skos:example>Potash mining and/or beneficiating</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=212390"/>
    <rdfs:label>Other Nonmetallic Mineral Mining and Quarrying</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in developing the mine site, mining, and/or milling or otherwise beneficiating (i.e., preparing) nonmetallic minerals (except coal, stone, sand, gravel, clay, and ceramic and refractory minerals). Drylake brine operations are included in this industry, as well as establishments engaged in producing the specified minerals from underground and open pit mines.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4VJrP7SSVnHuzI6s4tvC6">
    <skos:definition>All other time spent in preparing for and supporting a trial, including developing overall trial strategy, preparing own witnesses for trial, working on cross-examination, preparing opening and closing arguments, , identifying documents for use at trial, preparing demonstrative materials, making any physical arrangements for trial etc</skos:definition>
    <rdfs:label>JK20 General work regarding preparation for trial (UK J-CODE)</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Na6a08224f8834203a2fc855b1cada1c7"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RYhdC2tLD6aExrszJuSLZm"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCTMP0o99zMc6vuBbTI0PtG">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Flat Buyer Consent Requirement is a legal concept that refers to the specific requirement for a buyer's consent in a transaction, without any additional conditions or qualifications.</skos:definition>
    <skos:altLabel xml:lang="en-gb">Flat Buyer Consent Requirement</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Requisito de consentimento do comprador de apartamento</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">フラット購入者の同意要件</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">购房者同意要求</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דרישת הסכמת קונה דירה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Requisito de consentimiento del comprador de pisos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exigence de consentement de l'acheteur d'un appartement</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फ्लैट खरीदार सहमति आवश्यकता</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Erfordernis der Zustimmung des Wohnungskäufers</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Requisito de consentimiento del comprador de departamentos</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7J7NYI0WlIIflyMEgnXHIq"/>
    <rdfs:label>Flat Buyer Consent Requirement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R788056HRwxGpba6Of0gGM">
    <rdfs:label>Business Schools and Computer and Management Training</rdfs:label>
    <rdfs:label>Business Schools and Computer and Management Training Industry</rdfs:label>
    <dc:identifier>EDU-BSCH</dc:identifier>
    <dc:identifier>IN-INDUSTRY-7.1</dc:identifier>
    <skos:altLabel xml:lang="es-mx">Escuelas de Negocios e Industria de Capacitación en Administración</skos:altLabel>
    <skos:altLabel>Business Schools and Management Training</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Business Schools und Management-Trainingsbranche</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Business Schools and Management Training Industry</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बिजनेस स्कूल और प्रबंधन प्रशिक्षण उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Escuelas de Negocios e Industria de Formación en Gestión</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Escolas de negócios e indústria de treinamento em gestão</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ビジネススクールと経営トレーニング業界</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בתי ספר לעסקים ותעשיית הדרכה בניהול</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Écoles de commerce et industrie de la formation en management</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商学院和管理培训行业</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-EDU-BSCH</ns2:legacyIdentifier>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:hiddenLabel>BSCH</skos:hiddenLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=6114"/>
    <skos:prefLabel>Business Schools and Computer and Management Training Industry</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7IaNyshrHiqug0LlmK6J2"/>
    <skos:definition>This industry group comprises establishments primarily engaged in one of the following: (1) offering courses in office procedures and secretarial and stenographic skills and may offer courses in basic office skills, such as word processing; (2) conducting computer training (except computer repair); or (3) offering an array of short duration courses and seminars for management and professional development.  Instruction may be provided in diverse settings, such as the establishment's or client's training facilities, educational institutions, the workplace, or the home, and through diverse means, such as correspondence, television, the Internet, or other electronic and distance-learning methods.  The training provided by these establishments may include the use of simulators and simulation methods.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R96y1Rpq4Dxws1pWvvHcJof">
    <skos:altLabel xml:lang="en-gb">Lack of Subject Matter Jurisdiction</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Absence de compétence matérielle</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">缺乏主题管辖权</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta de jurisdicción en materia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fehlende Zuständigkeit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">管轄権の欠如</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falta de jurisdição em razão da matéria</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta de jurisdicción objetiva</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוסר סמכות תחום נושא</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विषय क्षेत्र की अभाविता जुरिसडिक्शन</skos:altLabel>
    <skos:definition>The lack of subject matter jurisdiction is a defense raised in a civil litigation that argues that the court does not have the authority to hear the case due to the nature of the legal claim or the parties involved.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Lack of Subject Matter Jurisdiction</rdfs:label>
  </rdf:Description>
