    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermAssumedObligationsLiabilities"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/legislation#Annexure">
    <rdfs:label xml:lang="en">Annexure</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://staram.in/ontology/legislation#OASISLegislationStructureModule"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/legislation#AnnexedMaterial"/>
