  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Jl9W6K0OTdWmBQPrGUYZcg">
    <skos:definition>This U.S. industry comprises establishments (except those known as barber shops or men's hair stylist shops) primarily engaged in one or more of the following: (1) cutting, trimming, shampooing, coloring, waving, or styling hair; (2) providing facials; and (3) applying makeup (except permanent makeup).</skos:definition>
    <skos:example>Hairdressing salons or shops</skos:example>
    <skos:example>Combined beauty and barber shops</skos:example>
    <skos:example>Facial salons or shops</skos:example>
    <skos:example>Unisex or women's hair stylist shops</skos:example>
    <skos:example>Beauty parlors or shops</skos:example>
    <skos:example>Cosmetology salons or shops</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=812112"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Beauty Salons</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/c2zJcA5sQkixccD2L4lXBw"/>
