  <rdf:Description rdf:about="https://staram.in/ontology/epc#RiskAssessment">
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#EPCContractRiskModule"/>
    <skos:definition xml:lang="en">A reified evaluation of a risk: likelihood, impact severity, resulting exposure rating, negotiability, the assessor and the date. Separated from the risk so that competing assessments (bidder vs authority vs lender) can coexist.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Risk Assessment</rdfs:label>
  </rdf:Description>
