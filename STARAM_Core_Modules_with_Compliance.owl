    <skos:altLabel xml:lang="en-gb">Restraint of Assets</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Restriction des actifs</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Restricción de Bienes</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגבלת נכסים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">资产限制</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संपत्ति की संयमी रखरखाव</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">資産の制限</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beschränkung von Vermögenswerten</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Restricción de Activos</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCQJU54O6qCvotCfmDwYZwj"/>
    <rdfs:label>Restraint of Assets</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A restraint of assets is a legal concept within matrimonial emergency applications that involves preventing one party from disposing of or transferring their assets in order to preserve them for equitable distribution in a divorce settlement.</skos:definition>
  </rdf:Description>
