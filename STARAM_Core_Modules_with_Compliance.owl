  <rdf:Description rdf:about="https://folio.openlegalstandard.org/-kylzKPOTfKUaxzQcdiOAw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561599"/>
    <skos:example>Condominium time-share exchange services</skos:example>
    <skos:example>Road and travel services automobile clubs</skos:example>
    <skos:example>Ticket (e.g., airline, bus, cruise ship, sports, theatrical) offices</skos:example>
    <skos:example>Ticket (e.g., amusement, sports, theatrical) agencies</skos:example>
    <skos:example>Reservation (e.g., airline, car rental, hotel, restaurant) services</skos:example>
    <rdfs:label>All Other Travel Arrangement and Reservation Services</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/aVATO1h8Q7yGC9sLbSm7jw"/>
    <skos:definition>This U.S. industry comprises establishments (except travel agencies, tour operators, and convention and visitors bureaus) primarily engaged in providing travel arrangement and reservation services.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDzGV0uU52QEYp4H0g4bOBP">
    <skos:altLabel xml:lang="fr-fr">Industrie immobilière</skos:altLabel>
    <skos:altLabel>Real Estate</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रियल एस्टेट उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית נדלן</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria Inmobiliaria</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria imobiliária</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不動産業</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Immobilienbranche</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">房地产行业</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Real Estate Industry</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria Inmobiliaria</skos:altLabel>
    <skos:hiddenLabel>REAL</skos:hiddenLabel>
    <dc:identifier>RES-REAL</dc:identifier>
    <dc:identifier>IN-INDUSTRY-16.2</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=531"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RjKL1UdfWL1FCPVhnbIFSF"/>
    <rdfs:label>Real Estate Industry</rdfs:label>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-RES-REAL</ns2:legacyIdentifier>
    <skos:prefLabel>Real Estate Industry</skos:prefLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:definition>Industries in the Real Estate group are primarily engaged in renting or leasing real estate to others; managing real estate for others; selling, buying, or renting real estate for others; and providing other real estate related services, such as appraisal services. This subsector includes equity Real Estate Investment Trusts (REITs) that are primarily engaged in leasing buildings, dwellings, or other real estate property to others.</skos:definition>
  </rdf:Description>
