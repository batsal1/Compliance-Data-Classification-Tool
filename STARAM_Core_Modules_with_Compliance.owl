    <skos:altLabel xml:lang="pt-br">Privilégio do processo deliberativo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège de processus délibératif</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio del proceso deliberativo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privilegio del proceso deliberativo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Deliberative-Process-Privileg</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות התהליך המתכוונן</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विचार-प्रक्रिया विशेषाधिकार</skos:altLabel>
