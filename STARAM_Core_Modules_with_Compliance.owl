    <skos:altLabel xml:lang="fr-fr">Clause de résolution alternative des litiges</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur alternativen Streitbeilegung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वैकल्पिक विवाद समाधान शर्त</skos:altLabel>
