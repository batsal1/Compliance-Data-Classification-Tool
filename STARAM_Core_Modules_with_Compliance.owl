  <rdf:Description rdf:about="https://folio.openlegalstandard.org/1cGYANb2RHiE9VMhPe9BKQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/88dAy02kTpSG_hNiqeRfhw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in operating bulk farm product warehousing and storage facilities (except refrigerated). Grain elevators primarily engaged in storage are included in this industry.</skos:definition>
    <rdfs:label>Farm Product Warehousing and Storage</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=493130"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N90a13f22c6214ad79fa4d1cf6c3c1ab8">
