    <skos:altLabel xml:lang="ja-jp">契約救済措置の尽力不履行</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंधिक उपाय को खत्म करने में विफलता</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha em esgotar o recurso contratual</skos:altLabel>
