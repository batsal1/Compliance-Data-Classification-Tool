  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s">
    <rdfs:label>Foundation and Competency Objections</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Foundation and Competency Objections are raised when a party in a legal proceeding believes that evidence lacks the necessary groundwork for admissibility (foundation) or when a witness lacks the qualifications to provide reliable testimony (competency). These objections aim to ensure that evidence and testimony meet legal standards for relevance, reliability, and expertise.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Bk5v9AAJmhb4WcgIQjy29"/>
  </rdf:Description>
