    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Federal Tort Claims Act Claim is a legal claim made against the United States government for damages caused by the negligent or wrongful acts of federal employees acting within the scope of their employment.</skos:definition>
    <rdfs:label>Federal Tort Claims Act Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
