  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RGvDd1LWO2w0H7qGaNtEhX">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This claim is brought forward when an employer, school, or service provider fails to make reasonable adjustments or modifications that would allow an individual with a disability to access employment opportunities, services, or benefits. The nature of the accommodation depends on the individual's needs and the context, but it aims to ensure equal opportunities and non-discrimination.</skos:definition>
    <skos:definition>This claim is brought forward when an employer or service provider fails to make reasonable adjustments or modifications that would allow an individual with a disability to access employment opportunities, services, or benefits. The nature of the accommodation depends on the individual's needs and the context, but it aims to ensure equal opportunities and non-discrimination.</skos:definition>
    <skos:altLabel>Education Impediment Claim</skos:altLabel>
    <skos:altLabel>Accommodation Request</skos:altLabel>
    <skos:altLabel>Disability Accommodation Claim</skos:altLabel>
    <skos:prefLabel>Special Education Claim</skos:prefLabel>
    <rdfs:label>Reasonable Accommodation Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7coJULMWSPoIPITP5qUS96"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ROaRQTFgM9oWtVX4k6v6I"/>
  </rdf:Description>
