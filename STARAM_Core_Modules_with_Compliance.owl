    <rdfs:label>oasis:SuborderList</rdfs:label>
    <skos:definition>A suborder list is a type of deontic specification within the OASIS ontology.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R969M34LEgPe5hm59rdksmi"/>
  </rdf:Description>
