    <rdfs:label>Co-Branding Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Marketing, Sponsorship &amp; Brand</ns1:contractFamily>
    <skos:definition>A co-branding agreement is a legal contract between two or more companies that outlines the terms and conditions of a joint marketing campaign or product collaboration.</skos:definition>
  </rdf:Description>
