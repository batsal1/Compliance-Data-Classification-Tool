  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDkMmwVhgxwiwuOmif1WUxw">
    <rdfs:label>Failure to Signal Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <skos:prefLabel>Turn Signal Violation Claim</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Failure to Signal Claim involves allegations that a driver has not used proper turn or lane change signals as required by traffic laws, leading potentially to misunderstandings or accidents on the road. Such claims are typically processed through traffic courts or administrative bodies and may result in fines or other penalties.</skos:definition>
