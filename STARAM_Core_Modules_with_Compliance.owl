  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rp0HEB2LI5bBIWba7jeZtE">
    <skos:altLabel xml:lang="he-il">רכישה ידידותית</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मित्रतापूर्ण अधिग्रहण</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Freundliche Übernahme</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">OPA amicale</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">友好的買収</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Adquisición amistosa</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Aquisição amigável</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">友好收购</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Friendly Takeover</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Adquisición amistosa</skos:altLabel>
    <rdfs:label>Friendly Takeover</rdfs:label>
    <skos:definition>A friendly takeover involves the acquiring company working in cooperation with the target company's management and board of directors to negotiate and agree upon the terms of the acquisition. In a friendly takeover, both parties collaborate to ensure a smooth transition and integration of the businesses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj"/>
    <skos:prefLabel>Friendly Acquisition</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
