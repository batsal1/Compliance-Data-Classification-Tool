  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Zhd0So57YTwCncrDosIpy">
    <skos:altLabel xml:lang="es-mx">Ley de Finanzas Comerciales</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho de Finanzas Comerciales</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वाणिज्यिक वित्त विधि</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito de Finanças Comerciais</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Handelsfinanzrecht</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוקי פיננסים מסחריים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Commercial Finance Law</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">商業金融法</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit de la finance commerciale</skos:altLabel>
    <skos:altLabel>Commercial Finance</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业金融法</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDhhApr0eDVle3F076WAVct"/>
    <skos:prefLabel>Commercial Finance Law</skos:prefLabel>
    <rdfs:label>Commercial Finance Law</rdfs:label>
    <skos:hiddenLabel>COMF</skos:hiddenLabel>
    <dc:identifier>IN-LAW-14.1</dc:identifier>
    <dc:identifier>FINL-COMF</dc:identifier>
    <skos:definition>Law supporting the function of providing loans or other financing to businesses.</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-FINL-COMF</ns2:legacyIdentifier>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6d5f1e30f07240478b4c31b63a3b2660">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
