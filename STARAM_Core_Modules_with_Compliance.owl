    <skos:altLabel xml:lang="de-de">Zwischenstreitige Berufungen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interlocutory Appeals</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Recursos interlocutórios</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">中间上诉</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">中間的控訴</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Recursos de apelación interlocutorios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अंतरिम अपील</skos:altLabel>
    <rdfs:label>Interlocutory Appeal</rdfs:label>
    <rdfs:label>Interlocutory Appeals</rdfs:label>
    <rdfs:isDefinedBy>PACER</rdfs:isDefinedBy>
  </rdf:Description>
