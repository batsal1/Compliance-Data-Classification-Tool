    <skos:altLabel xml:lang="ja-jp">俳優エキスパート</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Actor Expert</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Experto en Actuación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Experte Schauspieler</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Expert Acteur</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ator Especialista</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
