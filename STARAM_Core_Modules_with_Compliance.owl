  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBNz30rxM6l0GnL6R9XDyU2">
    <skos:altLabel xml:lang="de-de">Vandalismus</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Vandalismo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Vandalisme</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">破坏行为</skos:altLabel>
    <skos:altLabel xml:lang="he-il">וינדליזם</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">破壊行為</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Vandalism</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Vandalismo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपद्रव</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Vandalismo</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdfs:subClassOf rdf:nodeID="N80cf14c8b8dd45918e966979ff9fa472"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <rdfs:label>Vandalism</rdfs:label>
    <skos:definition>DEFINITION OF Destruction/Damage/Vandalism of Property — To willfully or maliciously destroy, damage, deface, or otherwise injure real or personal property without the consent of the owner or the person having custody or control of it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
