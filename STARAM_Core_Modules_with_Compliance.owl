    <skos:altLabel xml:lang="es-mx">Apropiación indebida de imagen</skos:altLabel>
    <rdfs:label>Misappropriation of Likeness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rd7uelGFqCTWSgf9lWki5N"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Misappropriation of Likeness is a legal claim that arises when someone uses another person's name, image, or likeness without their permission for commercial gain or other benefits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7gtGxdeqqRZIBU3zWGzmXE">
    <rdfs:label>Grazing Rights</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q"/>
    <rdfs:subClassOf rdf:nodeID="N45c1c953a7d04bddba4fca0107e5d9eb"/>
    <skos:definition>These grant an individual or entity the right to allow their livestock to feed (or graze) on specific areas of land. Often, these rights are leased or licensed by landowners or governmental entities.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
