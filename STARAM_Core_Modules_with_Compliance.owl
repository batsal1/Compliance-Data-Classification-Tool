  <rdf:Description rdf:about="https://staram.in/ontology/contracts#AssignmentOfClaims">
    <skos:exactMatch rdf:resource="https://folio.openlegalstandard.org/RBCaxiBwyfzT4iSxezQE1Fb"/>
    <rdfs:label xml:lang="en">Assignment of Claims</rdfs:label>
