  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Pxa1wnEDQYCYNQ0nBI37_A">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=488210"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing specialized services for railroad transportation, including servicing, routine repairing (except factory conversion, overhaul, or rebuilding of rolling stock), and maintaining rail cars; loading and unloading rail cars; and operating independent terminals.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Support Activities for Rail Transportation</rdfs:label>
