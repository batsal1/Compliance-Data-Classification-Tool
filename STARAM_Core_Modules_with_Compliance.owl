  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCC5eI2Qd36jIBTsOtd8dgb">
    <skos:definition>Pain and Suffering refers to the physical and emotional distress experienced by a person as a result of an injury or harm caused by another party, for which compensation may be sought in a legal proceeding.</skos:definition>
    <skos:altLabel xml:lang="es-es">Dolor y sufrimiento</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dor e Sofrimento</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Douleur et souffrance</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schmerzen und Leiden</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pain and Suffering</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दर्द और पीड़ा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">痛みと苦しみ</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Dolor y sufrimiento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כאב וסבל</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">痛苦和折磨</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Pain and Suffering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/courts#NonPecuniaryDamages"/>
