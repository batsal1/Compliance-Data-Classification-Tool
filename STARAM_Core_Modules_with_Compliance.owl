  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RixnrA7cMNoJE25gFQ2maF">
    <skos:prefLabel>No-Duty-to-Retreat Claim</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDwA2C5kO5T37PMjFme24ia"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDLANHrFj8nfaiNIalX9Ndx"/>
    <skos:definition>A Stand Your Ground Claim asserts a person's right to use force, including lethal force, in self-defense without the duty to retreat when faced with a perceived threat. This legal concept is grounded in the broader principle of self-defense and is often associated with gun rights and the use of firearms for personal protection.</skos:definition>
    <rdfs:label>Stand Your Ground Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBed9IWoxGy29Cmdz95B46m">
    <rdfs:label>pre_post_split</rdfs:label>
    <skos:definition>"Identifies whether the disc_cred is applied before (""Pre-Split"") or after (""Post-Split) the MISF and MIDB percentages are applied to the invoice. ""NA"" (Not applicable) should be used for splits indicated by disc_cred ""MISF"" and ""MIDB"".
"</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JDOjlrvV3jFpUOQu9WGhP"/>
  </rdf:Description>
