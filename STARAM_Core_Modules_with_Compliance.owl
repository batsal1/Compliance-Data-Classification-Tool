  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDPp2oN6KlpTkCPsPkP7Zx2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Employment Suspension is a temporary removal of an employee from their duties, often as a disciplinary measure for misconduct or policy violations. Suspensions can be with or without pay and are intended to provide time for investigation or to serve as a penalty.</skos:definition>
    <skos:prefLabel>Administrative Leave</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R996WtCH3h9VroTEbPc4hpS"/>
    <rdfs:label>Employment Suspension</rdfs:label>
    <skos:altLabel>Disciplinary Suspension</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/legislation#Section">
    <rdfs:isDefinedBy rdf:resource="https://staram.in/ontology/legislation#OASISLegislationStructureModule"/>
