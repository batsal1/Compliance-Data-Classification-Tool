    <skos:altLabel xml:lang="pt-br">Tipo de processo de disputa</skos:altLabel>
    <skos:definition>Dispute Proceeding Type refers to the specific legal process used to resolve a conflict between parties, such as an investigation, alternative dispute resolution, administrative proceeding, civil court proceeding, or criminal court proceeding.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDigDgTiLFmt7iX3436yCOT"/>
