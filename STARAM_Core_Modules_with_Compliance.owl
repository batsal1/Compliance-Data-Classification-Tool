    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Interference with Testamentary Expectancy refers to a legal claim that arises when someone intentionally interferes with another person's expected inheritance or gift, causing harm or damages.</skos:definition>
    <skos:altLabel xml:lang="ja-jp">遺言予想の妨害</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Atteinte à l'attente testamentaire</skos:altLabel>
