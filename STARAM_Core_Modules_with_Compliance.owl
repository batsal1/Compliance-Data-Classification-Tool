  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVRrqw2QfVD6UcPQLUMxaq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Permanent Resident is an individual who has been granted the right to live indefinitely within a country, typically after meeting certain eligibility criteria. In the United States, for example, this status is commonly referred to as having a "Green Card," and it grants the holder various rights and responsibilities, including the ability to work and reside in the country long-term, but does not confer citizenship.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GuYn7yMmfL0coiNQ0OE8f"/>
    <rdfs:label>Permanent Resident</rdfs:label>
    <skos:prefLabel>Green Card Holder</skos:prefLabel>
  </rdf:Description>
