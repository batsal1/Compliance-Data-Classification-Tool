  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9G3uvBhP5zhLlE1HcCXcKP">
    <skos:example>Specialized Products (e.g., fashion, literature, and art celebrating LGBTQ+ culture)</skos:example>
    <skos:example>Gay-Friendly Travel Services (e.g., LGBTQ+-friendly accommodations, travel packages)</skos:example>
    <skos:example>LGBTQ+ Community Events (e.g., pride parades, social gatherings)</skos:example>
    <skos:definition>The gay lifestyle market refers to a division of the market that is specifically targeted towards the LGBTQ+ community, focusing on products and services that cater to the needs, preferences, and interests of gay individuals and couples. This segment encompasses a wide range of offerings, from community events to specialized products, all designed to support and celebrate the gay lifestyle.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Gay Market Segment</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNw3wCvXyyjEPknfOpicmf"/>
    <rdfs:label>LGBTQ+ Market Segment</rdfs:label>
    <skos:prefLabel>Queer and Gay Market Segment</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R1Yi9mEExS6zx5Cueyjj9R">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hWq9dSn0Su2Y59JE48V3H"/>
    <rdfs:label>Retail Investor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Non-professional investors who invest their personal capital rather than on behalf of other entities or individuals.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/b1e73fca-5c79-4241-aa1c-b4a099b0397fb228630d-8e3b-4948-93fa-74989650b646">
    <rdfs:label>Dishonour Presumption on Proof of Protest</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/96d61b45-7761-4b57-aeed-e2c391cac0810b8ddbf4-f45c-4a7d-94e4-78c2a8f8f515"/>
    <skos:definition>This concept involves the presumption of the fact of dishonor in a suit upon an instrument that has been dishonored, when the protest (a formal declaration made by the notary public) is proven. The court assumes the dishonor occurred unless disproven.</skos:definition>
  </rdf:Description>
