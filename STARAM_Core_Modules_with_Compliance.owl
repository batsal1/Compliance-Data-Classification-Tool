  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBjsn37Lspz9G7hwXhWlj0R">
    <rdfs:label>Goats</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Goats are domesticated ruminant animals belonging to the species Capra aegagrus hircus, commonly raised for their milk, meat, fiber (such as cashmere and mohair), and hides. Known for their agility and ability to graze on various types of vegetation, goats are valuable in agricultural practices and can thrive in diverse environments.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KMTMyVwMFJ4uhm95DFM9y"/>
  </rdf:Description>
