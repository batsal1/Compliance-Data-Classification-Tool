    <skos:altLabel xml:lang="pt-br">Exigido para cumprir deveres fiduciários</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Erforderlich, um Treuepflichten zu erfüllen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">'Obligado a cumplir' con los deberes fiduciarios fiduciarios</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">受託義務を遵守する必要がある</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फिडुशियरी दायित्वों के साथ 'अनुपालन करने' के लिए आवश्यक</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Requis pour se conformer aux devoirs fiduciaires</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">需要遵守受托责任</skos:altLabel>
    <skos:altLabel xml:lang="he-il">'נדרש לעמוד ב' חובות פידוסיאריות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">'Obligado a cumplir' con los deberes fiduciarios</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">'Required to comply' with fiduciary duties</skos:altLabel>
    <rdfs:label>"'Required to comply' with fiduciary duties" Language</rdfs:label>
    <skos:definition>The concept of "'Required to comply' with fiduciary duties" Language refers to the specific language used in legal agreements, particularly in relation to No-Shop Covenants and the Fiduciary Standard, that outlines the obligation of parties to act in the best interest of their clients or beneficiaries.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
