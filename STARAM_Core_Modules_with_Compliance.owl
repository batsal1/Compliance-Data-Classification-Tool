    <skos:definition>Trial Transcripts Expense refers to the costs incurred for obtaining a written or recorded verbatim record of the proceedings that took place during a trial, including the testimony of witnesses, arguments of counsel, and rulings of the court.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
