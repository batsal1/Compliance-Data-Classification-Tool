  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rv4ABt24oeDVQUXuwWg4Lo">
    <rdfs:label>Brief Drafting Management</rdfs:label>
    <skos:definition>Brief Drafting Management refers to the process of managing and organizing the creation of legal documents that are concise and to the point. It is a subcategory of Litigation Management, which involves the overall management of legal cases.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
