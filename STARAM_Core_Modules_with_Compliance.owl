  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7QNGRlEB8h2Rpruaa2FrLs">
    <skos:altLabel xml:lang="zh-cn">放弃保密条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गोपनीयता अस्वीकरण शर्त</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">機密保持条項の放棄</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzicht auf Vertraulichkeitsklausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור מסודיות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation à la confidentialité</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver of Confidentiality Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia à confidencialidade</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia a la confidencialidad</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a la confidencialidad</skos:altLabel>
    <skos:definition>A Waiver of Confidentiality Clause is a provision in a legal agreement where a party agrees to release or give up their right to keep certain information confidential.</skos:definition>
    <rdfs:label>Waiver of Confidentiality Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/YZvvZq8LS0GWtMKkXTSYZQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/zk8rUeWUSwKLMuuZb7d2tw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=525190"/>
    <rdfs:label>Other Insurance Funds</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises legal entities (i.e., funds (except pension, and health- and welfare-related employee benefit funds)) organized to provide insurance exclusively for the sponsor, firm, or its employees or members. Self-insurance funds (except employee benefit funds) and workers' compensation insurance funds are included in this industry.</skos:definition>
  </rdf:Description>
