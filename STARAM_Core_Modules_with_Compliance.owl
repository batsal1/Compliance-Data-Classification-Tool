  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RYPD19NDoJtK57PW36y9O8">
    <skos:altLabel xml:lang="en-gb">Lien Waiver Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a gravamen</skos:altLabel>
