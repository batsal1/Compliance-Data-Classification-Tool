    <skos:altLabel xml:lang="he-il">סעיף חוזה שירותים אישיים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यक्तिगत सेवा अनुबंध शर्त</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel für persönliche Dienstleistungsverträge</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">個人サービス契約条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de contrato de servicios personales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Personal Services Contract Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de contrato de servicios personales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">个人服务合同条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de contrat de services personnels</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Personal Services Contract Clause</rdfs:label>
    <skos:definition>A Personal Services Contract Clause is a provision in a contract that outlines the specific services that an individual will provide, typically in the context of an employment or independent contractor relationship.</skos:definition>
  </rdf:Description>
