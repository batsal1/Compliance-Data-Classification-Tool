    <skos:altLabel xml:lang="en-gb">Barrister</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lawyer</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abogado</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N1f3fb19c64eb41c9bd9c5afd31437cc6"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7tKtki2tvT0I1cpSLJSWRF"/>
