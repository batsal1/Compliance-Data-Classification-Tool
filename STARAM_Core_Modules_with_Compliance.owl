    <skos:definition>A Forbearance Agreement is a temporary modification to a loan contract that allows a borrower to reduce or suspend payments due to financial hardship. The agreement outlines the duration of the forbearance, any fees involved, and the terms under which regular loan payments will resume.</skos:definition>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Forbearance Agreement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#alloc-execution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:notation>AL-3</skos:notation>
    <skos:definition xml:lang="en">Risk that arises while the works are being built, covering care of the works, coordination between parties and the knock-on effects of a breach, withdrawal of scope, availability of personnel, and access to the site.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:prefLabel xml:lang="en">Execution Risk (Schedule, Cost, Quality)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#AllocationRiskTaxonomy"/>
    <rdfs:label xml:lang="en">Execution Risk (Schedule, Cost, Quality)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDm6JYS1CRyCvUIWyont3U9">
    <skos:altLabel xml:lang="es-es">Cláusula de ahorro</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">セービングス条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de salvaguarda</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sicherungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">储蓄条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de ahorro</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Savings Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף חיסכון</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de sauvegarde</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बचत अनुबंध</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Savings Clause</rdfs:label>
    <skos:definition>A savings clause is a clause in a contract that preserves certain rights or obligations even if other parts of the contract are found to be invalid or unenforceable.</skos:definition>
  </rdf:Description>
