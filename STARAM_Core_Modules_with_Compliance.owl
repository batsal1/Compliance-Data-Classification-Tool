    <skos:altLabel xml:lang="zh-cn">索赔审核实践</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de revisão de reivindicações</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Claims Review Practice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दावों की समीक्षा अभ्यास</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Prüfung von Ansprüchen</skos:altLabel>
