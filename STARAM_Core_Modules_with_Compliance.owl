  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RhODoZEsVZp3nkeCKtJhmL">
    <skos:definition>A main proceeding in foreign insolvency is the primary insolvency case initiated in the debtor's center of main interests (COMI), typically where the debtor's principal place of business is located. This proceeding takes precedence over other insolvency proceedings and serves as the primary forum for administering the debtor's assets and restructuring efforts.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs"/>
    <rdfs:subClassOf rdf:nodeID="N199bee62d59a414586133c4d9c2ee160"/>
    <rdfs:label>Main Proceeding (Foreign Insolvency)</rdfs:label>
  </rdf:Description>
