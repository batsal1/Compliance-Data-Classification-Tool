  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9iGqX5xbiOWpsuFDpBLYhU">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHZTIZfN6Fbrf6azRExLaD"/>
    <skos:altLabel xml:lang="ja-jp">Go-Shop コヴェナント</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">Go-Shop 公约</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Engagement de Go-Shop</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם גו-שופ</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Go-Shop-Verpflichtung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Pacto Go-Shop</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Go-Shop Covenant</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गो-शॉप कवेनेंट</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Convenio Go-Shop</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pacto Go-Shop</skos:altLabel>
    <skos:definition>A Go-Shop Covenant is a provision in a deal protection agreement that allows the target company to seek out alternative offers from other potential buyers during a specified period of time, while still honoring the original offer.</skos:definition>
    <rdfs:label>Go-Shop Covenant</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8sLSP3fcYlpo2TNHbyFkQ8">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5mVKmojg3FKSzxupI6FLy"/>
    <rdfs:label>Secondary Offering Practice</rdfs:label>
    <skos:altLabel>Seasoned Equity Offering Practice</skos:altLabel>
    <skos:altLabel>Secondary Offering</skos:altLabel>
    <skos:altLabel>Secondary Offering Service</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Follow-On Offering Practice</skos:prefLabel>
    <skos:definition>Secondary Offering Practice involves the sale of shares by existing shareholders, typically through a public offering, after the company's initial public offering (IPO). It includes the legal and regulatory processes to ensure compliance with securities laws and protect investors' interests.</skos:definition>
  </rdf:Description>
