  <rdf:Description rdf:about="https://folio.openlegalstandard.org/FgBSp0nTT1a_EnARHNrNnQ">
    <rdfs:label>Major Household Appliance Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing household-type cooking appliances, household-type laundry equipment, household-type refrigerators, upright and chest freezers, and other electrical and nonelectrical major household-type appliances, such as dishwashers, water heaters, and garbage disposal units.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/gsZoY4JCRu-WIyAoZQ3yHw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=335220"/>
  </rdf:Description>
