  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCasJB92VYmX5vWeMXUz6tB">
    <skos:definition>Inventive Step is a patentability requirement that an invention must not be obvious to a person skilled in the relevant field, based on the prior art. It is used to determine whether an invention has sufficient ingenuity to warrant a patent.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV2029Q3Zi4LQ1ehMJNj3w"/>
    <rdfs:label>Inventive Step</rdfs:label>
  </rdf:Description>
