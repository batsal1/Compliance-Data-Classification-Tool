  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8XwFrJuWIwLcyBNEkI3VW0">
    <rdfs:label>Extendible Asset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Extendable Security</skos:altLabel>
    <skos:prefLabel>Flexible Maturity Asset</skos:prefLabel>
    <skos:definition>An Extendible Asset is a financial instrument that allows the redemption date to be extended at the option of the issuer or the holder. This feature provides additional flexibility, enabling the extension of the asset's maturity under predefined conditions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
  </rdf:Description>
