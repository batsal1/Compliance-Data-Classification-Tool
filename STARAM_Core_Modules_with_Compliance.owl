    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCM9weoavtDkLhcSgingjMp">
    <rdfs:label>Appeals Under Court Rule</rdfs:label>
    <rdfs:isDefinedBy>PACER</rdfs:isDefinedBy>
    <skos:altLabel xml:lang="ja-jp">裁判所規則に基づく控訴</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Apelaciones bajo la regla del tribunal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Appeals Under Court Rule</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">根据法院规则的上诉</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Berufungen gemäß Gerichtsregel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ערעורים על פי כללי בית המשפט</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायालय नियम के तहत अपील</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Appels en vertu de la règle de cour</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Recursos sob a Regra do Tribunal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Apelaciones bajo la regla del tribunal</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R94yxXVadPVTE4IW7iABVRc"/>
    <skos:definition>Appeals Under Court Rule refers to the process of challenging a lower court's decision by filing a request for review with a higher court, as governed by the specific procedural rules established by that court.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RhJCSR4hhRWaYBDe7BF07Mw">
    <rdfs:label>C100 Fact Gathering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxX1kaW2JSgeTr8ALPGia2g"/>
    <skos:prefLabel>C100 Fact Gathering</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This phase includes all initial inquiries, meetings and instructions and the identification and collection of information relevant to the assignment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5c9a3f632da84153b97212d4d0d1c09c">
