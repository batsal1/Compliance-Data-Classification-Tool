  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCHjx5I5OEtRzy42Dh0AA4t">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-mx">Cláusula del Método del Tiempo Transcurrido</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula do Método de Tempo Decorrido</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Methode der verstrichenen Zeit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">経過時間メソッド条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de méthode de temps écoulé</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שיטת זמן עבר</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">经过时间方法条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Elapsed Time Method Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बीते समय विधि शब्दांश</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula del Método del Tiempo Transcurrido</skos:altLabel>
    <skos:definition>An Elapsed Time Method Clause is a provision in a contract that specifies the amount of time that must pass before a certain action or event can occur, and is a subcategory of a Contractual Clause.</skos:definition>
    <rdfs:label>Elapsed Time Method Clause</rdfs:label>
  </rdf:Description>
