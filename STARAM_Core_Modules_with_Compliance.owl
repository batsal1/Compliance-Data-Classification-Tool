    <rdfs:label>Continuation Coverage Plan</rdfs:label>
    <skos:definition>Continuation coverage plans, such as the Consolidated Omnibus Budget Reconciliation Act (COBRA) in the U.S., allow former employees to continue their employer-sponsored health insurance for a limited period after employment ends. The individual is generally responsible for the full premium cost plus an administrative fee.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>COBRA Coverage Policy</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-time-eot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:prefLabel xml:lang="en">Time, Delay &amp; Extension of Time</skos:prefLabel>
    <rdfs:label xml:lang="en">Time, Delay &amp; Extension of Time</rdfs:label>
    <skos:broadMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-execution"/>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <skos:notation>LR-03</skos:notation>
    <skos:definition xml:lang="en">Risks in the time regime, covering grounds and notices for extension of time, concurrent delay, ownership of float, acceleration, sectional completion dates, and time becoming 'at large'.</skos:definition>
  </rdf:Description>
