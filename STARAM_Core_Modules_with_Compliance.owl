  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8rgsxWmEx8qQqXMEtuobJx">
    <skos:altLabel xml:lang="es-es">Exención fiduciaria al convenio de cambio de recomendación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exemption fiduciaire de la clause de changement de recommandation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सिद्धांत बदलने के लिए फिडुसियरी छूट</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fiduciary Exemption to Change of Recommendation Covenant</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">勧告変更の信託免除</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Exceção fiduciária à cláusula de mudança de recomendação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">信托豁免更改建议契约</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Treuhänderische Ausnahme von der Verpflichtung zur Empfehlungsänderung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Exención fiduciaria al convenio de cambio de recomendación</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פטור פידוסיארי מההסכם לשינוי ההמלצה</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Fiduciary Exemption to Change of Recommendation Covenant</rdfs:label>
    <skos:definition>A fiduciary exemption to change of recommendation covenant is a legal concept that allows a fiduciary to deviate from a previously agreed-upon recommendation in certain circumstances, without breaching their fiduciary duty.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7lw1kvfDrIqvdTv04QYbIP"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/QR-ok53ZQo6CuJMSBqvR8w">
