  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC1VlT6Qzfu6Z4lbkxlmU6u">
    <rdfs:label>Substantial Evidence</rdfs:label>
    <skos:altLabel xml:lang="es-es">Prueba Sustancial</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ठोस सबूत</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Evidência substancial</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Evidencia Sustancial</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">充分证据</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Preuve suffisante</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">十分な証拠</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ראיות משמעותיות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ausreichende Beweise</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Substantial Evidence</skos:altLabel>
    <skos:definition>Substantial Evidence: Sufficient and reasonable amount of relevant and credible evidence that a reasonable mind could accept as adequate to support a conclusion in a legal matter, which is subject to appellate review and litigation burdens of proof.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCpnqQCzeexk3k9kkbLx1Zu"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd63612b8d54d44c7a5511f6d5e277edc">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMo0rWec8owXGDAYl6PGNG">
    <skos:altLabel>Dual Ownership</skos:altLabel>
    <skos:altLabel>Shared Ownership</skos:altLabel>
    <skos:altLabel>Simultaneous Ownership</skos:altLabel>
    <skos:prefLabel>Co-Ownership</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <rdfs:label>Concurrent Interest</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Concurrent Interest refers to the situation where two or more parties simultaneously hold ownership interests in the same piece of property. This type of ownership includes various forms such as joint tenancy, tenancy in common, and tenancy by the entirety, each with distinct legal implications regarding the rights of the owners.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7c5BcqV4pI9L9rPupIV17C">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Wildlife Crimes involve illegal activities that harm wildlife species, including poaching, trafficking, and illegal trade. These crimes violate national and international laws aimed at protecting endangered and protected species.</skos:definition>
    <rdfs:label>Wildlife Crimes</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
    <skos:prefLabel>Wildlife Offenses</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB6bIH76tDZ6TdfHvYdbyj0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
    <skos:definition>Delivery services/messengers refer to expenses incurred for the transportation of documents or packages from one location to another, and are a subcategory of expenses in legal matters.</skos:definition>
    <rdfs:label>E107 Delivery services/messengers</rdfs:label>
  </rdf:Description>
