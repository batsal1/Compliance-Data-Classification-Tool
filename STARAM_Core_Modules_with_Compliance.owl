    <skos:altLabel xml:lang="es-mx">Tutela de Menores</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Guarda de Menores</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未成年人监护</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">未成年者の保護</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Tutela de Menores</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Tutelle des mineurs</skos:altLabel>
    <skos:definition>The legal concept of Guardianship of Minor refers to the legal authority and responsibility given to a person or entity to care for and make decisions on behalf of a minor child who is not able to care for themselves.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCVn9Ew2WyR8O4O5WGDlLKO"/>
    <rdfs:subClassOf rdf:nodeID="Nd54f38e0838447ce93f7f8046fef687a"/>
