    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Motor Vehicle Negligence</rdfs:label>
    <skos:definition>Motor Vehicle Negligence refers to a legal claim for damages resulting from the careless or reckless operation of a motor vehicle, which causes injury or harm to another person.</skos:definition>
  </rdf:Description>
