    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Deliberative Process Privilege</rdfs:label>
    <skos:definition>The Deliberative Process Privilege is a legal protection that allows government agencies to withhold documents and communications that are part of the decision-making process, in order to encourage open and honest discussion and debate among officials.</skos:definition>
  </rdf:Description>
