    <skos:altLabel xml:lang="fr-fr">Clause de retrait de biens personnels</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de remoción de propiedad personal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Removal of Personal Property Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">個人財産の除去条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de eliminación de propiedad personal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסרת רכוש אישי</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यक्तिगत संपत्ति धारा का हटाना</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de remoção de propriedade pessoal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">个人财产清除条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Entfernung von persönlichem Eigentum</skos:altLabel>
    <rdfs:label>Removal of Personal Property Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Removal of Personal Property Clause is a provision in a contract that allows one party to take possession of another party's personal property in certain circumstances.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N425dec4ea3374385b0bde23b3734b8fb">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBVGGEdVgHfVPEPq5dLPjrS"/>
