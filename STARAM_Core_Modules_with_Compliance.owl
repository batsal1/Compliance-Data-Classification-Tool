  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RgQLVqqo23cFKNa2n4P7wp">
    <skos:definition>Recoupment of public benefit refers to the action taken by a government agency to recover funds that have been overpaid to an individual or family under a public benefit program. This process may involve reducing future benefit payments, establishing repayment plans, or legal actions, and is aimed at maintaining the integrity and financial sustainability of the benefit program.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
    <rdfs:subClassOf rdf:nodeID="N1cc6d39847ba4c98aaba4825fca6df9b"/>
    <rdfs:label>Recoupment of Public Benefit</rdfs:label>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
