  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVPwUkNgWhlwyYWWSPrLuZ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3"/>
    <skos:definition>Legal System Types refer to the various frameworks of laws, rules, and institutions that govern the legal processes and procedures within a jurisdiction. These systems encompass distinct traditions, principles, and methodologies that have evolved over time, influenced by cultural, religious, and historical factors.</skos:definition>
    <skos:altLabel>Legal Traditions</skos:altLabel>
    <skos:altLabel>Legal Frameworks</skos:altLabel>
    <skos:altLabel>Juridical Systems</skos:altLabel>
