  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQgpAo5GFhGAvTuB5ZwKO3">
    <skos:altLabel xml:lang="hi-in">मिलान अधिकार भाषा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שפת זכויות תואמות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Matching Rights Language</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">マッチング権利言語</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Linguagem de correspondência de direitos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">匹配权利语言</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Übereinstimmende Rechte-Sprache</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Langage de correspondance des droits</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lenguaje de Derechos Coincidentes</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Lenguaje de Derechos Coincidentes</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Matching Rights Language refers to the specific contractual language used in a Change of Recommendation Covenant that grants parties the right to maintain their ownership percentage in a company during a merger or acquisition by allowing them to purchase additional shares of the new entity.</skos:definition>
    <rdfs:label>Matching Rights Language</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7lw1kvfDrIqvdTv04QYbIP"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RbZdfoStLWj9ovWYnXHzp5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Liability to Property Invitees</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Liability to Property Invitees</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung gegenüber eingeladenen Personen auf dem Grundstück</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad hacia los invitados a la propiedad</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">財産招待者への責任</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संपत्ति आमंत्रितों के लिए दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade em relação aos convidados da propriedade</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות כלפי אורחי הנכס</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité envers les invités sur la propriété</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad hacia los invitados a la propiedad</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">物业受邀请人责任</skos:altLabel>
    <skos:definition>Liability to Property Invitees refers to the legal responsibility of a property owner or occupier to ensure the safety of individuals who are invited onto their property for business purposes, such as customers or clients.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMLusAf4cAxrOTTs872NeQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Building Right</skos:definition>
    <skos:definition>The Right of Superficies is a legal concept that allows an individual to own structures or plantings on land owned by someone else. This right typically enables the holder to build on, cultivate, or otherwise use the land's surface for a specified period, subject to conditions outlined in an agreement or governing laws, without owning the land itself.</skos:definition>
    <rdfs:label>Right of Superficies</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdz3J6xqNZfHwiRt3aSLCr"/>
  </rdf:Description>
