    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RRd84bRRbTvy2WWd1k4wT4"/>
    <skos:definition>"A percentage number expressing the percent discount provided to this charge, i.e. ""0.15"" reflects a 15% discount to the charge.  
"</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/q0dUqhTdTAiEiF1s45ptcg">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in custom roll forming metal products by use of rotary motion of rolls with various contours to bend or shape the products.</skos:definition>
