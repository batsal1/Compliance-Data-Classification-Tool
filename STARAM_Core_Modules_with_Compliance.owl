    <skos:example>Chicks, live, merchant wholesalers</skos:example>
    <skos:example>Leaf tobacco merchant wholesalers</skos:example>
    <skos:example>Raw pelts merchant wholesalers</skos:example>
    <skos:example>Nuts, unprocessed or shelled only, merchant wholesalers</skos:example>
    <skos:example>Hemp merchant wholesalers</skos:example>
    <skos:example>Mules merchant wholesalers</skos:example>
    <skos:example>Horses merchant wholesalers</skos:example>
    <skos:example>Raw cotton merchant wholesalers</skos:example>
    <skos:example>Sod merchant wholesalers</skos:example>
    <skos:example>Hides merchant wholesalers</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424590"/>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of farm products (except grain and field beans, livestock, raw milk, live poultry, and fresh fruits and vegetables).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/KMmINX7IS6WBvugBKOU0rw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
