  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDpPrzyG145FEMbdXJEzPkJ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9jx1uLGTrB6S8hwGcWVmlT"/>
    <skos:altLabel xml:lang="he-il">מְכֻהָּן</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">aggravé</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">agravado</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भड़काऊ</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Agravado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Aggravated</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大な</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Agravado</skos:altLabel>
    <skos:altLabel xml:lang="de-de">verschärft</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">加重的</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <skos:example>Aggravated Battery</skos:example>
    <skos:example>Aggravated Assault</skos:example>
    <skos:example>Aggravated Sexual Assault</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An unlawful attack by one person upon another wherein the offender uses a weapon or displays it in a threatening manner, or the victim suffers obvious severe or aggravated bodily injury involving apparent broken bones, loss of teeth, possible internal injury, severe laceration, or loss of consciousness. This also includes assault with disease (as in cases when the offender is aware that he/she is infected with a deadly disease and deliberately attempts to inflict the disease by biting, spitting, etc.).</skos:definition>
    <rdfs:label>Aggravated</rdfs:label>
  </rdf:Description>
