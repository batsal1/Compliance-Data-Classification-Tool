    <ns1:contractFamily xml:lang="en">Restrictive Covenants &amp; Confidentiality</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en-gb">Nonsolicitation Agreement</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם לא סוליציטציה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नॉनसोलिसिटेशन अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acuerdo de no solicitud</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de no solicitud</skos:altLabel>
    <skos:definition>A Nonsolicitation Agreement is a legal contract between parties that prohibits one party from soliciting or hiring employees or customers of the other party for a specified period of time.</skos:definition>
    <rdfs:label>Nonsolicitation Agreement</rdfs:label>
  </rdf:Description>
