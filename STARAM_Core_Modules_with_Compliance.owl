  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RoABbJ9kEFzmBvBSGmbAyq">
    <rdfs:label>Inadmissible Documentary Evidence Objection</rdfs:label>
    <skos:prefLabel>Documentary Evidence Admissibility Objection</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Inadmissible Documentary Evidence Objection is raised when a party attempts to introduce a document into evidence that fails to meet the necessary legal requirements for admissibility. This objection encompasses various grounds, such as lack of proper authentication or failure to provide the original document when required by the "original writings" rule (also known as the best evidence rule).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Bk5v9AAJmhb4WcgIQjy29"/>
  </rdf:Description>
