    <rdfs:label>Pre-Flight Inspection</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"Pre-Flight Inspection (PFI)" is a security and immigration procedure that occurs before an individual boards an aircraft destined for a specific country, ensuring compliance with entry requirements and verifying eligibility to travel to the destination</skos:definition>
