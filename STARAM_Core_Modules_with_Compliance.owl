  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7qYdzDpOwDU4Z5oYtmDMBp">
    <skos:altLabel xml:lang="es-mx">Provisión negligente de salvaguardas o precauciones requeridas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未提供必要的安全保障或预防措施</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आवश्यक सुरक्षा उपाय या सावधानियों की लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Bereitstellung erforderlicher Sicherheitsvorkehrungen oder Vorsichtsmaßnahmen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ספק לא מתאים של הגנות או זהירויות נדרשות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fornecimento negligente de salvaguardas ou precauções necessárias</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">必要な安全保障措置の怠慢な提供</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Provisión negligente de salvaguardas o precauciones requeridas</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fourniture négligente des mesures de sécurité ou de précaution requises</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Provision of Required Safeguards or Precautions</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
    <rdfs:label>Negligent Provision of Required Safeguards or Precautions</rdfs:label>
    <skos:definition>The Negligent Provision of Required Safeguards or Precautions refers to a failure to provide necessary safety measures or precautions, resulting in harm or injury, in the context of industrial injury claims.</skos:definition>
