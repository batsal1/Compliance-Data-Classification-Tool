  <rdf:Description rdf:about="https://folio.openlegalstandard.org/DQI6M3oDTx6y2Lai1kz3yg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=562212"/>
    <rdfs:label>Solid Waste Landfill</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) operating landfills for the disposal of nonhazardous solid waste or (2) the combined activity of collecting and/or hauling nonhazardous waste materials within a local area and operating landfills for the disposal of nonhazardous solid waste. These establishments may produce byproducts, such as methane.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/nEU9oAnvS4GKVFPRE4aqrA"/>
  </rdf:Description>
