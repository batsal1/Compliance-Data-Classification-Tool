  <rdf:Description rdf:about="https://folio.openlegalstandard.org/s7oRrm5lRU2JpIrjCD722Q">
    <skos:example>Porcelain electrical insulators manufacturing</skos:example>
    <skos:example>Earthenware table and kitchen articles, coarse, manufacturing</skos:example>
    <skos:example>Chemical stoneware (i.e., pottery products) manufacturing</skos:example>
    <skos:example>Ceramic or ferrite permanent magnets manufacturing</skos:example>
    <skos:example>Clay and ceramic statuary manufacturing</skos:example>
    <skos:example>Bathroom accessories, vitreous china and earthenware, manufacturing</skos:example>
    <skos:example>Vitreous china plumbing fixtures manufacturing</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/jlweTXsuRYGvJV3lxFW-Tg"/>
    <skos:definition>This industry comprises establishments primarily engaged in shaping, molding, glazing, and firing pottery, ceramics, plumbing fixtures, and electrical supplies made entirely or partly of clay or other ceramic materials.</skos:definition>
