  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDJy67uuHSmMFfjfpevrNe0">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1XGKMfgmQGI3yTSEndqMN"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Best Interest of the Child Claim</rdfs:label>
    <skos:definition>A Best Interest of the Child Claim is a legal argument presented in family court, typically during custody or visitation disputes, where one party asserts that a particular custody arrangement or decision serves the child's best interests. This claim focuses on the child's welfare and well-being, considering factors such as their emotional, physical, and educational needs, the stability of each parent's home, and their relationship with both parents. Courts prioritize the best interests of the child when making custody and visitation determinations to ensure their safety and well-being.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBeWZQTG3XMrKMwMbUgJEgW">
    <skos:altLabel xml:lang="zh-cn">租金比例分配条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Prorrateo de Alquiler</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף חלוקת השכר</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">家賃配分条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Prorrateo de Renta</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur anteiligen Mietzahlung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de proratisation du loyer</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">किराये का अंशदान धारा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Proration of Rent Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de rateio de aluguel</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A proration of rent clause is a provision in a contract that specifies how rent will be divided and calculated when a tenant moves in or out of a property during a rental period.</skos:definition>
    <rdfs:label>Proration of Rent Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDpNoF3OruNHqrls00vgBNu">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj"/>
    <skos:prefLabel>Dominant Shareholding Position</skos:prefLabel>
    <rdfs:label>Control Position</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An M&amp;A Control Position refers to a stake in a company acquired through mergers and acquisitions that gives the holder significant influence over corporate decisions. This control is often achieved by obtaining a majority of voting shares or a significant minority stake sufficient to influence board decisions.</skos:definition>
    <skos:altLabel>Controlling Interest</skos:altLabel>
    <skos:altLabel>Acquisition Control Stake</skos:altLabel>
    <skos:altLabel>Control Stake</skos:altLabel>
  </rdf:Description>
