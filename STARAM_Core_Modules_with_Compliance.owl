    <rdfs:label>Fire Protection</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=92216"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
