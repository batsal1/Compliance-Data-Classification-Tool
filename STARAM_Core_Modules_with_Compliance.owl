  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCKkUM2s9JcBYCHb797Fk9h">
    <rdfs:label>08_1 Intellectual Property Rights (PACER NoS)</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N9eb9b5519483471bb00dbbf93d7c7e28"/>
    <rdfs:subClassOf rdf:nodeID="N1209512e3af64ab2a2e4be6435999926"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSGywkPBv7f2ACrfTSiirV"/>
    <skos:definition>Intellectual Property Rights (PACER NoS) refers to a category of legal cases related to the protection of creative works and inventions, including patents, trademarks, copyrights, and trade secrets, as classified under the PACER Nature of Suit (NoS) Codes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
