  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDWa2Zxkb8Cm2LvqU1Bu5bc">
    <rdfs:label>Statutory Tax Districts Clause</rdfs:label>
    <skos:altLabel xml:lang="hi-in">कानूनी कर जिला बंदी धारा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">法定税区条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法定税区画条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Distritos Fiscales Estatutarios</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause sur les districts fiscaux légaux</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Distritos Fiscales Estatutarios</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu gesetzlichen Steuerbezirken</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Distritos Fiscais Estatutários</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Statutory Tax Districts Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אזורי מס חוקיים</skos:altLabel>
    <skos:definition>A Statutory Tax Districts Clause is a provision in a contract that outlines the specific tax districts that are applicable to the agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
