  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7q3vIB6kCMaSnQt4XPuaAz">
    <skos:altLabel xml:lang="pt-br">Cláusula de consideração futura</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de considération future</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Consideración Futura</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Consideración Futura</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भविष्य की विचारणीय शर्त</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Future Consideration Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur zukünftigen Berücksichtigung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未来考虑条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התחשבנות עתידית</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">将来的な考慮条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Future Consideration Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Future Consideration Clause is a provision in a contract that outlines an obligation to perform an action or provide compensation at a later date, based on certain conditions being met.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC3AVugCxJxGX8OFhrHCR9D">
    <skos:altLabel xml:lang="de-de">Klausel zum Ausführungsdatum</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Fecha de Ejecución</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de date d'exécution</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निष्पादन तिथि वाक्य</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">执行日期条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">実行日条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Fecha de Ejecución</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de data de execução</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Execution Date Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תאריך ביצוע</skos:altLabel>
    <skos:definition>An Execution Date Clause is a clause in a contract that specifies the date on which the contract will be signed and become effective.</skos:definition>
    <rdfs:label>Execution Date Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
