  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8KMTMyVwMFJ4uhm95DFM9y">
    <rdfs:label>Livestock</rdfs:label>
    <dc:identifier>IN-LAW-2.2</dc:identifier>
    <skos:prefLabel>Farm Animals</skos:prefLabel>
    <skos:prefLabel>Livestock</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RYdDlq7cXsPj2kB0yDsDGF"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Livestock refers to domesticated animals raised in an agricultural setting that are considered tangible assets for economic purposes. These animals hold monetary value and can be used as collateral in financial transactions or counted as part of an individual's or entity's assets.</skos:definition>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
  </rdf:Description>
