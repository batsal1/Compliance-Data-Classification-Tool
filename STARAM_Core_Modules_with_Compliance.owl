  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBc6oqiKweeX4V16bHrd1ue">
    <skos:altLabel xml:lang="de-de">Anspruch auf die Klausel zur Rede und Debatte</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Speech and Debate Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">言论和辩论条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף נאום ודיון</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Discurso y Debate</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da cláusula de discurso e debate</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de la clause de discours et de débat</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भाषण और वाद-विवाद धारा दावा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">スピーチおよびディベート条項の主張</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Discurso y Debate</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
    <rdfs:label>Speech and Debate Clause Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Speech and Debate Clause claim refers to a legal argument based on the constitutional provision that grants legislators immunity from civil or criminal liability for statements made during legislative proceedings. This claim protects legislators from being sued or prosecuted for defamation, libel, or other legal actions arising from their speech or debate in the legislative context.</skos:definition>
  </rdf:Description>
