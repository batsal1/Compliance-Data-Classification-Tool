  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5ZPcFJs3LnNUSJOrzPiii">
    <skos:altLabel xml:lang="ja-jp">司法免責</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חסינות משפטית</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Judicial Immunity</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Immunité judiciaire</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Imunidade judicial</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Inmunidad Judicial</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">司法豁免权</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Richterliche Immunität</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Inmunidad Judicial</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायिक अविरोध</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvhPeoPwTNYsc19VBpYjSV"/>
    <rdfs:label>Judicial Immunity</rdfs:label>
    <skos:definition>Judicial Immunity refers to the legal protection granted to judges from being held personally liable for actions taken in their official capacity, even if those actions are later found to be incorrect or unlawful.</skos:definition>
  </rdf:Description>
