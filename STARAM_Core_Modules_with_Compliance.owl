  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7IjZ1aqBNtooeIsm94n5ET">
    <skos:altLabel xml:lang="es-es">Extorsión</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">敲诈勒索</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Erpressung</skos:altLabel>
    <skos:altLabel>Blackmail</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Extorsion</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Extorsão</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उत्पीड़न</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Extorsión</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Extortion</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">恐喝</skos:altLabel>
    <skos:altLabel xml:lang="he-il">איומי חמסין</skos:altLabel>
    <skos:definition>To unlawfully obtain money, property, or any other thing of value, either tangible or intangible, through the use or threat of force, misuse of authority, threat of criminal prosecution, threat of destruction of reputation or social standing, or through other coercive means.</skos:definition>
    <rdfs:label>Extortion</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBpSXv8uOXDikW5jk944sRN"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
