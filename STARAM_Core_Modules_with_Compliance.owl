    <skos:example>Harvesting machinery and equipment merchant wholesalers</skos:example>
    <skos:example>Lawnmowers merchant wholesalers</skos:example>
    <skos:example>Planting machinery and equipment merchant wholesalers</skos:example>
    <skos:example>Animal feeders merchant wholesalers</skos:example>
    <skos:example>Milking machinery and equipment merchant wholesalers</skos:example>
