  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCNKm9EnW4P2a7noaWhJg4j">
    <skos:altLabel xml:lang="zh-cn">违约条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף עונשי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula penal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Penalty Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula penal</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Strafklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दंड अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause pénale</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">違約条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula penal</skos:altLabel>
    <rdfs:label>Penalty Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A penalty clause is a provision in a contract that specifies a predetermined amount of money or other penalty that one party will owe to the other if they breach the terms of the contract.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCLPjZmKSZN87AQT8zi3gcU">
    <skos:altLabel xml:lang="es-es">Reclamo de Cláusula de Forma Republicana</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf eine republikanische Formklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">共和国形式条款要求</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de la clause de forme républicaine</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共和国形式条項の主張</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Forma Republicana</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गणतंत्र रूप क्लॉज क्लेम</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף דמוקרטי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de Cláusula de Forma Republicana</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Republican Form Clause Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5bITZZ0taJOXwcwS314VU"/>
    <rdfs:label>Republican Form Clause Claim</rdfs:label>
    <skos:definition>A Republican Form Clause claim refers to a legal argument based on the Republican Form Clause of the United States Constitution, asserting that the federal government must ensure that each state is governed by a republican form of government. It aims to prevent the establishment of monarchies or other non-republican forms of government within the states, promoting representative democracy.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne2581c66e20c41ce9718c22adedc8bbc">
