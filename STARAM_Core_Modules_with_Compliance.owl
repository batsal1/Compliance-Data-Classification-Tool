  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ErtW8KCAHKPRpDlftMFEP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Regulatory Disclosure Service</skos:altLabel>
    <skos:altLabel>Disclosure Compliance</skos:altLabel>
    <skos:altLabel>Regulatory Filings</skos:altLabel>
    <skos:altLabel>Transparency Regulation</skos:altLabel>
    <skos:altLabel>Regulatory Disclosure</skos:altLabel>
    <skos:altLabel>Reporting Compliance</skos:altLabel>
    <skos:altLabel>Regulatory Reporting</skos:altLabel>
    <skos:definition>Regulatory Disclosure Practice involves the legal requirements and procedures for disclosing information to regulatory authorities. This practice area includes compliance with disclosure laws, reporting obligations, transparency standards, and the management of regulatory filings and communications.</skos:definition>
    <rdfs:label>Regulatory Disclosure Practice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDEuNPJBSNIARaYTXJwi86w"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rxq9H83mWAaaXKD76cA6X8">
    <skos:definition>Telephone Expense refers to the cost incurred by an individual or organization for using telephone services, which is categorized as an expense in accounting and financial management.</skos:definition>
