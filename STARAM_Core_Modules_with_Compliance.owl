  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7oNzeoztbuRwAAvrHzmGb6">
    <skos:altLabel xml:lang="zh-cn">共同利益费用方法论</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Methodik der gemeinsamen Nutzengebühr</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共通利益料金方式</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Metodología de tarifa de beneficio común</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מתודולוגיית עמלת תועלת משותפת</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Common Benefit Fee Methodology</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Metodología de tarifa de beneficio común</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Metodologia de taxa de benefício comum</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य लाभ शुल्क विधि</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Méthodologie de frais d'avantages communs</skos:altLabel>
    <rdfs:label>Common Benefit Fee Methodology</rdfs:label>
    <skos:definition>A Common Benefit Fee Methodology is a method of calculating attorney fees in a legal matter where the outcome of the case provides a benefit to a group of individuals, and the fees are divided among the group based on their proportionate share of the benefit received.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlDwAh4h0X7Sosy5SLccvX"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nee1b8808a73d42a99fb89522f59baeab">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#DefinitionsOfTerms"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCQuJ7q1lQ1WIJ2kx5jJk3v">
    <skos:altLabel>Avoiding the Corporate Liability Shield</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Desconsideração da personalidade jurídica</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Disolución del velo corporativo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कॉर्पोरेट वेल को छेदना</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נקיטת המסך התאגידי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Durchbrechung der Unternehmensschleier</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Desestimación de la personalidad jurídica</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lifting the Corporate Veil</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法人格の透過</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">穿透公司法人格</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Piercing the Corporate Veil</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Percer le voile corporatif</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Piercing the Corporate Veil is a legal concept that allows a court to disregard the limited liability protection of a corporation or partnership and hold its shareholders or partners personally liable for the entity's actions or debts.</skos:definition>
    <rdfs:label>Piercing the Corporate Veil</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N24ff38ca3f3b442988abadf2c60c6abb">
