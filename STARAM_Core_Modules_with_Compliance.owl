    <skos:definition>Injury Caused by Wild Animal refers to harm or damage inflicted upon a person by a non-domesticated animal, and falls under the broader category of Animal Claims.</skos:definition>
    <rdfs:label>Injury Caused by Wild Animal</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCkPc0XIMxDInzRipCUUZ1q">
    <skos:altLabel>Right of Use</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R75Bx0QJin6XW4ki2c8pJGw"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <rdfs:label>Property Right of Use</rdfs:label>
    <skos:definition>The Right of Property Use refers to the civil law concept of legal entitlement to utilize a property for certain activities as permitted by law or contract. This can include residential, commercial, or agricultural uses, and may be subject to zoning laws, covenants, and other legal restrictions</skos:definition>
  </rdf:Description>
