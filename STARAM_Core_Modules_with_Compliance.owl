  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7n9rAWIq1fi7qGb3xRynWG">
    <skos:prefLabel>Sacrilegious Content</skos:prefLabel>
    <rdfs:label>Blasphemous Material</rdfs:label>
    <skos:definition>Blasphemous Material refers to content that shows disrespect or irreverence toward religious beliefs, figures, deities, or sacred symbols. This type of material often leads to significant controversy and legal actions in jurisdictions where blasphemy laws are enforced.</skos:definition>
    <skos:altLabel>Profane Material</skos:altLabel>
    <skos:altLabel>Anti-Religious Material</skos:altLabel>
    <skos:altLabel>Religious Offense Content</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7fCP2EQY8XQ5fxqiYaKPQA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R99UNWpuiCUIJXZnQbuFLRq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3hDYvR4ffxmqJg2F8YGT6"/>
    <skos:definition>"Summarizes the Tiered Taxes charged on this matter/invoice detailed in TAX_TIER_DETAIL by tx_id.  There will be 0 or more TAX_TIER_SUMMARY segments per INVOICE segment.  There will be 1 TAX_TIER_SUMMARY segment for each TAX.tx_id where TAX.'tax_tiers = ""Y"".

Note that the EXTEND_HEADER option was purposely omitted from this segment.
"</skos:definition>
    <rdfs:label>tax_tier_summary segment</rdfs:label>
  </rdf:Description>
