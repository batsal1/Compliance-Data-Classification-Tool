  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCM3e0nEvIdOmiCEVyCuVT4">
    <rdfs:label>total_amount</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ktJqdQifgzEaV2DJkdMZa"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9VdnoybnEodiN0EUTedSOz"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"The final billed value of the fee item after application of all FEE_ITEM_DISC_CRED.disc_cred_amounts.  Does not include MATTER_DISC_CRED.disc_cred_amounts or taxes on the fee item.
  
FEE.total_amount = FEE.base_amount + FEE.item_disc_cred_amount  
"</skos:definition>
  </rdf:Description>
