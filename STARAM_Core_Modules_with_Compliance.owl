  <rdf:Description rdf:about="https://folio.openlegalstandard.org/_WI4A58aS8-uJoCNlZunhw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333992"/>
    <rdfs:label>Welding and Soldering Equipment Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/z92pj9hTTd2-Vgl3rH8XfQ"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing welding and soldering equipment and accessories (except transformers), such as arc, resistance, gas, plasma, laser, electron beam, and ultrasonic welding equipment; welding electrodes; coated or cored welding wire; and soldering equipment (except handheld).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7KxYUBMSAuzPHdBhWfPSv7">
    <skos:note>Non-copyrightable idea and fact inspiration drawn from IAB 2.0. https://www.meaningcloud.com/developer/documentation/predefined/deep-categorization-models/iab-2-0</skos:note>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UG79BtYP2uqnKNklLYXB8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Demographic Market Segments</rdfs:label>
    <skos:definition>Demographic segments refer to divisions of the market that are categorized based on demographic characteristics such as age, gender, income, education level, and family status. These segments help marketers and businesses tailor their products and services to specific groups within the population, based on their unique needs and preferences.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7vY8WK0oISJWX8cd6FfGsZ">
    <skos:altLabel xml:lang="pt-br">Oferta superior - Quantidade mínima necessária de ativos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उत्कृष्ट प्रस्ताव - न्यूनतम आवश्यक संपत्ति राशि</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Oferta superior - cantidad mínima necesaria de activos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">優れたオファー-最小必要資産額</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Oferta superior - cantidad mínima necesaria de activos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Überlegenes Angebot - Mindestens erforderliche Menge an Vermögenswerten</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Superior Offer - Minimum Necessary Amount of Assets</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Offre supérieure - Montant minimum nécessaire d'actifs</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצעה עליונה - כמות הנכסים המינימלית הנדרשת</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">优越报价-最少必要资产量</skos:altLabel>
    <rdfs:label>Superior Offer - Minimum Necessary Amount of Assets</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R951hKkSGUrKhm07RqJ1hDc"/>
    <skos:definition>A "Superior Offer - Minimum Necessary Amount of Assets" is a specific threshold within the broader concept of "Superior Offer" that requires a minimum amount of assets to be included in an offer in order for it to be considered superior to other offers in a legal matter.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
