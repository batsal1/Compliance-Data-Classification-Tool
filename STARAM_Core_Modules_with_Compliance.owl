  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7aHk2AkuO60xkjZ0nGpV70">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nREeU6lB0zs0dt9N339nm"/>
    <skos:altLabel>Impartial</skos:altLabel>
    <skos:altLabel>Unbiased</skos:altLabel>
    <skos:prefLabel>Neutral</skos:prefLabel>
    <skos:definition>The attribute "disinterested" refers to parties, often trustees or professionals, who have no personal interest in the outcome of the proceedings and no prior relationship with the debtor or creditors. Disinterested parties ensure unbiased administration and decision-making, fostering fairness and integrity in the process.</skos:definition>
    <rdfs:label>Disinterested</rdfs:label>
  </rdf:Description>
