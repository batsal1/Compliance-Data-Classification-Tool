    <rdfs:label>Health Insurance Policy</rdfs:label>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A health insurance policy is an agreement between an insurer and a policyholder wherein the insurer covers part or all of the policyholder's healthcare costs in exchange for premium payments. The policy specifies what medical services are covered, the network of healthcare providers, and any co-payments, deductibles, or other financial responsibilities for the insured.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na91c82b6bfcc42cf85127e7cf040c4f4">
