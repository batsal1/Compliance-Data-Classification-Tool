  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8CRocu4czjQ5mseqDWSeWC">
    <skos:altLabel>In-House Legal Department</skos:altLabel>
    <skos:altLabel>Law Department</skos:altLabel>
    <skos:altLabel>Legal Affairs</skos:altLabel>
    <skos:altLabel>Corporate Legal Team</skos:altLabel>
    <skos:altLabel>In-House Law Department</skos:altLabel>
    <skos:prefLabel>In-House Counsel</skos:prefLabel>
    <skos:definition>A Corporate Law Department is a division within a business entity (e.g., corporation, LLC, partnership) responsible for handling legal matters and ensuring compliance with laws and regulations. It advises the entity on legal issues, drafts and reviews legal documents, and represents the corporation in legal proceedings.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RMIoMi1OqwHKqsjgrjdaHj"/>
    <rdfs:label>Corporate Law Department</rdfs:label>
  </rdf:Description>
