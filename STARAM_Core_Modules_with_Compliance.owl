    <skos:altLabel xml:lang="es-mx">Cláusula de garantía limitada de por vida</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Limited Lifetime Warranty Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de garantie à durée de vie limitée</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सीमित जीवनकाल वारंटी शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de garantia limitada vitalícia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">限定生涯保証条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de garantía limitada de por vida</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">有限终身保修条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur beschränkten lebenslangen Garantie</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
    <rdfs:label>Limited Lifetime Warranty Clause</rdfs:label>
    <skos:definition>A Limited Lifetime Warranty Clause is a provision in a warranty agreement that limits the duration of coverage to the lifetime of the product, but with certain restrictions or conditions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8eYplvX9rGzbrcplLZFdlw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Verfahrensverbindung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">जोइंडर</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Joinder</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Litigância conjunta</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acumulación de acciones</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acumulación de acciones</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同訴訟</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Jonction</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">加入诉讼</skos:altLabel>
    <skos:altLabel xml:lang="he-il">צפיפות תביעות</skos:altLabel>
    <rdfs:label>Joinder</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <skos:definition>The concept of Joinder refers to the legal process of combining two or more legal cases or parties into a single action, typically to promote efficiency and avoid inconsistent outcomes.</skos:definition>
  </rdf:Description>
