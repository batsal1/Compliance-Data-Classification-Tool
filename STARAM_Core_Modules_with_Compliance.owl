    <skos:altLabel xml:lang="es-es">Cláusula de derecho de primera opción</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">First Right of Refusal Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">優先購入権条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पहला अधिकार अस्वीकरण शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de derecho de primera oferta</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">优先购买权条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit de préemption</skos:altLabel>
    <skos:definition>A First Right of Refusal Clause is a provision in a contract that grants a party the opportunity to purchase or lease property before it is offered to others.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>First Right of Refusal Clause</rdfs:label>
