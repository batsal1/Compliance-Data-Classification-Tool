  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBiKxjgQ4fCptoehaw3ssba">
    <skos:altLabel xml:lang="en-gb">Qui Tam Whistleblower Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्वी टैम व्हिसलब्लोअर क्लेम</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de dénonciateur Qui Tam</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Qui Tam Whistleblower-Anspruch</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">Qui Tam告密人索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">クイ・タム・ウィスルブロワー請求</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de denuncia de Qui Tam</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de denuncia de Qui Tam</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de denunciante Qui Tam</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת חשיפה קווי טאם</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Qui Tam Whistleblower Claim is a legal action brought by an individual who reports fraud against the government and seeks to recover damages on behalf of the government.</skos:definition>
    <rdfs:label>Qui Tam Whistleblower Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBhkx3dQ6MLH4RmvBj4nBaz"/>
  </rdf:Description>
