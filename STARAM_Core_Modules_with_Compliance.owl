    <skos:altLabel xml:lang="ja-jp">面会請求の強制執行</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exécution du droit de visite</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ejecución de la reclamación de visitas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Enforcement of Visitation Claim</skos:altLabel>
