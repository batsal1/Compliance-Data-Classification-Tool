    <skos:altLabel xml:lang="he-il">תביעת סעיף האמולומנט</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch aus der Emolument Clause</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Emolument Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एमोल्यूमेंट क्लॉज क्लेम</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Emolumentos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Emolumentos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">薪酬条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Emolumentos</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
    <skos:definition>An Emolument Clause claim is a legal argument asserting that a government official, typically the President, has violated the Emoluments Clause of the United States Constitution. This claim contends that the official has received improper financial benefits, such as gifts, payments, or other advantages, from foreign governments or entities, which is prohibited by the Emoluments Clause to prevent conflicts of interest and foreign influence on public officials.</skos:definition>
    <rdfs:label>Emolument Clause Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDTuEXdt1qP78ZmBC7HCzBa">
    <rdfs:label>Domain Name Management</rdfs:label>
    <skos:definition>Domain Name Management refers to the legal management and protection of internet domain names, including registration, transfer, and dispute resolution.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Xrium2aVaYqlV8F4UZu6u"/>
  </rdf:Description>
