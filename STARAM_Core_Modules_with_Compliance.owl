  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDjG5GB80UToe2ZfmrnJ7IO">
    <rdfs:label>Tortious Breach of Contract</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Tortious Breach of Contract</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento contractual doloso</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento contractual doloso</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违约侵权</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation contractuelle délictuelle</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsverletzung mit deliktischer Haftung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוזה עוולה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनैतिक अनुबंध उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação contratual com responsabilidade civil extracontratual</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不法行為に基づく契約違反</skos:altLabel>
    <skos:definition>The Tortious Breach of Contract is a legal concept that occurs when one party breaches a contract and causes harm or damages to the other party, resulting in a tort claim in addition to a breach of contract claim.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC2fjcpsEbrVvVymvt4oASx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5XoB2Y1jvuHNnUMNI8pUE">
    <skos:altLabel xml:lang="ja-jp">最恵国条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Most Favored Nation Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de la nation la plus favorisée</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula da nação mais favorecida</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सर्वाधिक अनुकूल राष्ट्र शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">最惠国条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסעיף של המדינה המועדפת ביותר</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Nación Más Favorecida</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Meistbegünstigungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Nación Más Favorecida</skos:altLabel>
    <skos:altLabel>Most Favored Customer Clause</skos:altLabel>
    <rdfs:label>Most Favored Nation Clause</rdfs:label>
    <skos:definition>A Most Favored Nation Clause is a contractual provision that requires a party to receive the same favorable treatment as the most favored party in a similar situation.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
