    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/93UXWLTCQB2XarynV_W5qQ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RhSS15bKH0If7iXJ0cH9oJ">
    <skos:altLabel xml:lang="pt-br">Cláusula de referência neutra</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de référence neutre</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Referencia Neutral</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यूट्रल संदर्भ शर्त</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">中立的参照条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">中立参考条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התייחסות נייטרלי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur neutralen Bezugnahme</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Referencia Neutral</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Neutral Reference Clause</skos:altLabel>
    <rdfs:label>Neutral Reference Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Neutral Reference Clause is a clause in a contract that provides for a third-party to resolve disputes between the parties in an impartial manner, without favoring either party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/eYxXFH0tRWuSrARaILA5uA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/JSJBUjjLRDuw3htaff_lhg"/>
    <skos:definition>This U.S. industry comprises establishments known as "one-hour" photofinishing labs primarily engaged in developing film and/or making photographic slides, prints, and enlargements on a short turnaround or while-you-wait basis.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=812922"/>
    <rdfs:label>One-Hour Photofinishing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCHROcjZwNS6Fy9jeQGSNGU">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsDNLN3OFdVxc9ZIMb6Noj"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Name Change</rdfs:label>
    <skos:definition>A name change refers to the legal act of altering one's official given name, surname, or both. The process typically requires the submission of a petition to a court and, upon approval, results in a legal decree formally recognizing the new name</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBInEBiBM9AXI15yzeZXun">
