  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDDRzHejI73gYoPIngns0hz">
    <skos:definition>A Buyout Provisions Clause is a specific provision within a Buyout Clause in a legal agreement that outlines the terms and conditions for one party to buy out the other party's interest in a business or property.</skos:definition>
    <skos:altLabel xml:lang="hi-in">खरीदारी प्रावधान अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Buyout Provisions Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">買収条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">收购条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de compra de ações</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de rachat</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Disposiciones de Compra</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאי רכישה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Disposiciones de Compra</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Rückkaufbestimmungen</skos:altLabel>
    <rdfs:label>Buyout Provisions Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ptzjWj29f9jaS2bIuy9Qi"/>
  </rdf:Description>
