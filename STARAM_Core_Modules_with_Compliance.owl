  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R6l5lTCtgGrwOQRlYXtGit">
    <skos:altLabel xml:lang="ja-jp">協力条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de coopération</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de cooperação</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सहयोग धारा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de cooperación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kooperationsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de cooperación</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שיתוף פעולה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Cooperation Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合作条款</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Cooperation Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A cooperation clause is a provision in a contract that requires the parties to work together towards a common goal or objective.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD3FnQpzvyCcGyILkgICREk">
    <skos:altLabel xml:lang="zh-cn">天生公民条款要求</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de la clause de citoyenneté naturelle</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף אזרח טבעי נולד</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Natural Born Citizen Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Ciudadano Natural Nacido</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Ciudadano Natural Nacido</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自然生まれた市民条項の主張</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula do Cidadão Natural Nascido</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्राकृतिक जन्म नागरिक धारा दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf die Klausel zum natürlichen geborenen Bürger</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Natural Born Citizen Clause Claim</rdfs:label>
    <skos:definition>A Natural Born Citizen Clause claim is a legal argument asserting that a person's eligibility to hold the office of the President of the United States is in question due to the interpretation and application of the Natural Born Citizen Clause in the United States Constitution. This claim contends that the person in question does not meet the constitutional requirement of being a natural-born citizen, either due to their birth circumstances or the citizenship status of their parents, potentially rendering their candidacy or presidency invalid.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdZDW8VIPVbM8gI4n7Ippf"/>
  </rdf:Description>
