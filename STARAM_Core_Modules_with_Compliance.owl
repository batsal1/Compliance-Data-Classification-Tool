    <skos:definition>A person against whom a counterclaim is brought.</skos:definition>
    <rdfs:label>Counter-Defendant</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7XlRtk6WMnbMZULXcg7SnI">
    <skos:altLabel xml:lang="en-gb">Family Liability</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות משפחתית</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad familiar</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade familiar</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">家庭责任</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité familiale</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad familiar</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">家族責任</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">परिवार की ज़िम्मेदारी</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Familienhaftung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
    <rdfs:subClassOf rdf:nodeID="N31e87e0fdf24406abcdb831a402418e5"/>
    <skos:definition>Family Liability refers to the legal responsibility of family members for the actions or debts of other family members, including spousal and parent-child liability, as well as agency and vicarious liability.</skos:definition>
    <rdfs:label>Family Liability</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9DbNoeuFm58j4WK3ilKY3R">
    <skos:inSchema>UK</skos:inSchema>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC3iZlQIPU8tP1phFuy6oXX"/>
    <skos:altLabel xml:lang="en-gb">Financial Services and Markets Act Claim</skos:altLabel>
    <skos:definition>Blue Sky Laws are state regulations established as safeguards for investors against securities fraud. A "Blue Sky Claim" would typically refer to a claim or lawsuit brought under these state laws, alleging that a company or individual has committed securities fraud or has otherwise violated these investor protection laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Blue Sky Claim</rdfs:label>
  </rdf:Description>
