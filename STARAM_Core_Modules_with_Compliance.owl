  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8dLGJ7lA896tuBXqGi7y6I">
    <skos:altLabel xml:lang="en-gb">Corporate Officer Participating in Tort</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">टॉर्ट में भाग लेने वाला कॉर्पोरेट अधिकारी</skos:altLabel>
    <skos:altLabel xml:lang="he-il">קצין תאגידי המשתתף בטורט</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不法行為に参加する企業役員</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">参与侵权的公司官员</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Officier d'entreprise participant à un délit</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Oficial corporativo participando en agravio</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Oficial corporativo participando en delito civil</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unternehmensbeauftragter, der an einem Delikt beteiligt ist</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Oficial corporativo participando de delito</skos:altLabel>
    <rdfs:label>Corporate Officer Participating in Tort</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdfs:subClassOf rdf:nodeID="N28eb8a51c12b41d48a61e1f06585c528"/>
    <rdfs:subClassOf rdf:nodeID="N23c6d8f6f29a459c897e775b2b52e48f"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Corporate Officer Participating in Tort is an individual who holds a position of authority within a corporation and is involved in a wrongful act or injury caused to another person or entity, resulting in legal liability for the corporation.</skos:definition>
  </rdf:Description>
