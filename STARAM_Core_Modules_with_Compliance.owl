  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCR2daagM0vMiqCGhsBrZrE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCrctN8FUd3Tj5gi4DWHTZx"/>
    <skos:prefLabel>General Assistance Program Benefit</skos:prefLabel>
    <skos:definition>General Relief Benefit, also known as a general assistance program, refers to a form of public assistance provided by local or state governments to individuals or families who do not qualify for specialized aid programs, such as unemployment or disability benefits. The aim is to offer temporary financial support for basic needs like food, housing, and medical care.</skos:definition>
    <rdfs:label>General Relief Benefit</rdfs:label>
  </rdf:Description>
