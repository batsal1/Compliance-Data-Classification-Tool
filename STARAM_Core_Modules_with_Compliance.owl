  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rc5228EFUCPVV6xlzi7rTd">
    <skos:altLabel xml:lang="zh-cn">超出许可范围的使用</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verwendung außerhalb des genehmigten Umfangs</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">許可範囲外の使用</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Use Beyond Scope of Permission</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Utilisation hors du champ d'autorisation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Uso fuera del alcance de la autorización</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Uso além do escopo de permissão</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुमति की सीमा से बाहर उपयोग</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שימוש מעבר לסקופ ההרשאה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Uso fuera del alcance de la autorización</skos:altLabel>
    <skos:definition>Use Beyond Scope of Permission refers to a defense strategy in civil litigation where the defendant argues that their actions were not in violation of the law because they were within the scope of their authorized permission.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Use Beyond Scope of Permission</rdfs:label>
