  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RofnAxOvRVPY0Ws2jDeLIJ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A "Publicity Covenant" is a contractual provision in which the parties agree on how information related to the transaction or relationship will be disclosed to the public or third parties. This can include stipulations on press releases, announcements, or other public communications, ensuring that both parties have control over or give consent to how the information is presented and disseminated.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHZTIZfN6Fbrf6azRExLaD"/>
    <rdfs:label>Publicity Covenant</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N929798b4e0b949d38f58ac0fc59fe827">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#RenewalOption"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQCqQcWqriNQ2XBCucDmpq">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5RK4Beoxturh6V8lBfWfZ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Child</rdfs:label>
    <skos:definition>A Child is an individual who is the offspring of one or more parents, either biologically or through legal processes like adoption. In legal contexts, a child is often considered a minor and is under the guardianship of their parent(s) or legal guardian(s) until reaching the age of majority.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/tzFads-JQj6WHhHB0AYjyg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC1Ba5YP8y1uxOkQF7LsVU8"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=7113"/>
    <skos:definition>This industry group comprises establishments primarily engaged in organizing, promoting, and/or managing live performing arts productions, sports events, and similar events, held in facilities that they manage and operate or in facilities that are managed and operated by others.</skos:definition>
    <rdfs:label>Promoters of Performing Arts, Sports, and Similar Events</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N595132d9f7f740ff8903cfda9cde1fa4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
