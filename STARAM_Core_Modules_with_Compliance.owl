    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RS6Pedvqd6vX99HwyhZIlP"/>
    <skos:altLabel xml:lang="de-de">Kartellrechtlicher Standard der 'Materialität'</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">「実質性」に基づく独占禁止法基準</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Materiality Based Antitrust Standard</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Norme antitrust de 'Matérialité'</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पदार्थता आधारित विपणि नीति</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Padrão antitruste de 'Materialidade'</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Estándar Antimonopolio Basado en la Materialidad</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">'实质性'反垄断标准</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תקן נגד- trust המבוסס על חומריות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estándar Antimonopolio Basado en la Materialidad</skos:altLabel>
    <rdfs:label>"Materiality" Based Antitrust Standard</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A "Materiality" Based Antitrust Standard is a legal concept that sets a threshold for determining whether certain conduct or information is significant enough to be considered in antitrust analysis, and only conduct or information that meets this threshold will be taken into account.</skos:definition>
  </rdf:Description>
