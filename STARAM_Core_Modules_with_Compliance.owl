  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7u0JelUtJfjM4BJThqnwl5">
    <skos:altLabel xml:lang="en-gb">Waiver of Right to Sue Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">放弃起诉权条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">訴訟権放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation au droit de poursuivre en justice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिकार दावा करने से इनकार करने की क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף רינון זכות לתביעה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia al derecho a demandar</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia ao direito de processar</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia al derecho a demandar</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzicht auf das Recht, zu klagen Klausel</skos:altLabel>
    <rdfs:label>Waiver of Right to Sue Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
    <skos:definition>A Waiver of Right to Sue Clause is a provision in a legal agreement where one party agrees to give up their right to bring a lawsuit against the other party in the event of a dispute.</skos:definition>
  </rdf:Description>
