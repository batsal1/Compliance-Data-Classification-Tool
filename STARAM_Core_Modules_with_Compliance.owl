    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDspRIwoJTlopUDjSgLRduf"/>
    <rdfs:label>Scienter</rdfs:label>
    <skos:definition>The concept of Scienter refers to the knowledge or intent of wrongdoing by a defendant in a legal claim, which is an essential element of the plaintiff's case.</skos:definition>
  </rdf:Description>
