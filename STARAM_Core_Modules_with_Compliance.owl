    <skos:altLabel xml:lang="pt-br">Reivindicações de Lesões Pessoais</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यक्तिगत चोट दावे</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones por Lesiones Personales</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Personenschadensansprüche</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:nodeID="Neecbe9e5362a4bc9a1a3e5e88d84f955"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDqSn32zsjxExcBFzIYxT2D"/>
    <skos:definition>Personal Injury Claims are civil claims or tort claims seeking compensation for physical or emotional harm caused by the negligence or intentional actions of another party, including but not limited to slip-and-fall accidents, medical malpractice, and motor vehicle accidents.</skos:definition>
    <rdfs:label>Personal Injury Claims</rdfs:label>
