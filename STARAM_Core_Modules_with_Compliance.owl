    <rdfs:label>Dangerous Condition of Public Property</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Dangerous Condition of Public Property refers to a situation where a government entity fails to maintain its property in a safe condition, resulting in harm or injury to the public.</skos:definition>
  </rdf:Description>
