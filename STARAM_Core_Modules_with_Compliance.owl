    <skos:altLabel xml:lang="he-il">תביעת משותפת של יזם</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Joint Enterprise Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同企業請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">联合企业索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation d'entreprise conjointe</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संयुक्त उद्यम दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gemeinsame Unternehmensforderung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de Empresa Conjunta</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Empresa Conjunta</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de Empreendimento Conjunto</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Joint Enterprise Claim</rdfs:label>
    <skos:definition>A Joint Enterprise Claim is a legal claim that holds multiple parties responsible for a wrongful act or omission committed in the course of a joint venture or enterprise, and is a type of Corporate and Partnership Liability Claim.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RNlaIvo9pK9MgOcwKug5on">
