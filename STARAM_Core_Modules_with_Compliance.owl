  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8M0SdyE5bdu7Lc0HPFGQmo">
    <skos:altLabel xml:lang="en-gb">Condition of Use Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Condiciones de Uso</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">使用条件条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאי השימוש</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de condition d'utilisation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपयोग शर्त बंधन</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Condiciones de Uso</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">利用条件条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nutzungsbedingungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Condição de Uso</skos:altLabel>
    <rdfs:label>Condition of Use Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Condition of Use Clause is a provision in a contract that outlines the terms and conditions under which a product or service may be used.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RouKBMqFNMZxi21EPh6JJ6">
    <skos:altLabel xml:lang="ja-jp">経済的損害</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Dommages économiques</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Economic Damages</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Danos econômicos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נזקים כלכליים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आर्थिक हानि</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wirtschaftlicher Schaden</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">经济损失</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Daños económicos</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Daños económicos</skos:altLabel>
    <skos:definition>Economic Damages refer to the financial losses suffered by an individual or entity as a result of a legal matter, including lost profits, medical expenses, and future earning capacity.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Economic Damages</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2CEA5hNfHnNl8DMKIfK5F"/>
    <skos:prefLabel>Consequential Damages</skos:prefLabel>
  </rdf:Description>
