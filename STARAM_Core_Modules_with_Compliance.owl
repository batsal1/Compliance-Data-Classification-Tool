  <rdf:Description rdf:about="https://folio.openlegalstandard.org/MM3-4DoFQWOovRbA6N1j-g">
    <skos:example>Metal baskets made from purchased wire</skos:example>
    <skos:example>Woven wire cloth made from purchased wire</skos:example>
    <skos:example>Nails, brads, and staples made from purchased wire</skos:example>
    <skos:example>Chain link fencing and fence gates made from purchased wire</skos:example>
    <skos:example>Noninsulated wire cable made from purchased wire</skos:example>
    <skos:example>Barbed wire made from purchased wire</skos:example>
    <skos:example>Paper clips made from purchased wire</skos:example>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing fabricated wire products (except springs) made from purchased wire.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/UsuwArHqTi6W7A5ulsZQnw"/>
    <rdfs:label>Other Fabricated Wire Product Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=332618"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
