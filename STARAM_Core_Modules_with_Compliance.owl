    <skos:altLabel xml:lang="zh-cn">食品责任索赔</skos:altLabel>
    <skos:definition>A food liability claim is a civil claim related to harm caused by consuming contaminated or poisoned food products.</skos:definition>
    <rdfs:label>Food Liability Claims</rdfs:label>
