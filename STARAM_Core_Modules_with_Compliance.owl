  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/YFbAUnqXTmaP4s08d8dFfQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3219"/>
    <rdfs:label>Other Wood Product Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BuVjQc5Xltba4bK4jk3h"/>
    <skos:definition>This industry group comprises establishments primarily engaged in manufacturing wood products (except establishments operating sawmills and wood preservation facilities; and establishments manufacturing veneer, plywood, or engineered wood products).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5f4e5d4f605d4a6484a026af66cbf7ed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#ComplianceWithLaw"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/EkzBVO9XRbWRudKxoqxQmw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/B01S6KdyTYqg4DnfBk2oXg"/>
    <rdfs:label>Radio Broadcasting Stations</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in broadcasting aural programs by radio to the public. These establishments operate radio broadcasting studios and facilities for the programming and transmission of programs to the public. Programming may originate in their own studio, from an affiliated network, or from external sources.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=516110"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
