    <skos:definition>This phase includes all discussions with third parties not otherwise covered above, such as communications with regulators or parties to contracts with the client.</skos:definition>
    <rdfs:label>C400 Third Party Communication</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
