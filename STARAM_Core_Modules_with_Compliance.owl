  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCh6DNVTpKuGNGUFfysj3uD">
    <skos:definition>The "Rules of Professional Conduct" are a set of ethical guidelines and standards that lawyers are required to adhere to in the course of their legal practice. These rules are designed to ensure lawyers act with integrity, competence, and loyalty to their clients while upholding the principles of justice and the legal profession. Violations of these rules can result in disciplinary actions by legal authorities.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDahKqXGI4trE9V8iw0YfR0"/>
    <rdfs:subClassOf rdf:nodeID="N459139e255b844c587448b151264065c"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Ethics Rules</skos:prefLabel>
    <rdfs:label>Rules of Professional Conduct</rdfs:label>
  </rdf:Description>
