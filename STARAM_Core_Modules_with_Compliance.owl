    <skos:altLabel xml:lang="pt-br">Indústria de seguros</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insurance Industry</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de Seguros</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie de l'assurance</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית הביטוח</skos:altLabel>
