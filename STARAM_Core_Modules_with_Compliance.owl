    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWNAwJemBq0gDs7LXfCjnE"/>
    <skos:definition>Trucking Negligence refers to the failure of a common carrier engaged in the transportation of goods by truck to exercise reasonable care, resulting in harm or injury to others.</skos:definition>
    <rdfs:label>Trucking Negligence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
