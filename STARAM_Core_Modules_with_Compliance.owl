  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDVdjLF5bcB64xE1k3fVCV1">
    <rdfs:label>Rule Type</rdfs:label>
    <skos:altLabel xml:lang="pt-br">Tipo de regra</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ルールタイプ</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Regeltyp</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">规则类型</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Type de règle</skos:altLabel>
    <skos:definition>A Rule Type is a specific type of Litigation Procedural Rule that outlines the procedures and requirements for a particular type of legal case, such as a pilot case or a case with complex issues.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDahKqXGI4trE9V8iw0YfR0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N28c908791284484697955cfe87f6793a">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCu23ODfsnYICpdMNOQUDJV"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC7AKwp8eWbBcuWEwmoJYkq">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <skos:altLabel xml:lang="es-es">Reclamación por prácticas comerciales defectuosas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दोषपूर्ण व्यापार व्यवहार अधिनियम दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch nach dem Gesetz über fehlerhafte Handelspraktiken</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">《缺陷商品交易行为法》索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur les pratiques commerciales déloyales</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación por prácticas comerciales defectuosas</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק מתן שירותים מסחריים פגומים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Defective Trade Practices Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">欠陥商品取引行為法に基づく請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de acordo com a Lei de Práticas Comerciais Defeituosas</skos:altLabel>
    <rdfs:label>Defective Trade Practices Act Claim</rdfs:label>
    <skos:definition>A Defective Trade Practices Act Claim is a legal claim that arises from a product liability issue and is based on a violation of statutory and regulatory laws related to trade practices.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCaUTKzgiRJ1593W0zNZx4F">
    <skos:altLabel>Trespass to Chattels</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यक्तिगत संपत्ति या चैटल के लिए अतिक्रमण</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Eindringen in das Eigentum an persönlichem Eigentum oder Chattel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Intrusión en la propiedad personal o bienes muebles</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">動産または動産への不法侵入</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la propriété personnelle ou du bien meuble</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Invasão de propriedade pessoal ou bem móvel</skos:altLabel>
    <skos:altLabel>Trespass to Personal Property</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת קניין אישי או רכוש נייד</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">侵犯个人财产或动产</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trespass to Personal Property or Chattel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Intrusión en la propiedad personal o bienes muebles</skos:altLabel>
    <rdfs:label>Trespass to Personal Property or Chattel</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCwxVWPUdbPjn2tWtFJg6IZ"/>
    <skos:definition>The concept of Trespass to Personal Property or Chattel refers to the intentional interference with another person's lawful possession of their personal property or chattel, without their consent.</skos:definition>
  </rdf:Description>
