    <skos:altLabel xml:lang="es-es">Cláusula de renuncia y liberación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेवर और रिलीज क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור ושחרור</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">放棄および解除条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">豁免和解除条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia e liberação</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
  </rdf:Description>
