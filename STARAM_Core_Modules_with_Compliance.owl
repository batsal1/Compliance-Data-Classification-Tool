  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#alloc-exogenous-fm">
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#AllocationRiskTaxonomy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <rdfs:label xml:lang="en">Exogenous / Force Majeure Risk</rdfs:label>
    <skos:definition xml:lang="en">Risk from events outside the control of either party. Such risk is normally handled through a relief mechanism rather than being placed entirely on one party.</skos:definition>
    <skos:notation>AL-5</skos:notation>
    <skos:prefLabel xml:lang="en">Exogenous / Force Majeure Risk</skos:prefLabel>
  </rdf:Description>
