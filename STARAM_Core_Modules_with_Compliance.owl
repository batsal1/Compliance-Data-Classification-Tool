  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7LRqYwbWo4Vo6VZx69CUE2">
    <rdfs:label>Redaction Management</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCOOyyZhW3l3cdenBfC5LT4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Redaction Management refers to the process of identifying and removing sensitive or confidential information from legal documents in order to protect the privacy of individuals or organizations involved in litigation.</skos:definition>
  </rdf:Description>
