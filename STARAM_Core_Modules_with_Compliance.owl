  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDkeXkYjY816eSnxFpPcvvm">
    <skos:altLabel xml:lang="fr-fr">Principe de finalité</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Purpose Specification Principle</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Princípio da finalidade</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Principio de Especificación del Propósito</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उद्देश्य विनिर्देशन सिद्धांत</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zweckbindungsprinzip</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">目的明示の原則</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עקרון הצהרת המטרה</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">目的明确原则</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Principio de Especificación del Propósito</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw"/>
    <skos:definition>Purpose Specification is the privacy principle that the purposes for which personal data are collected should be specified not later than at the time of data collection and the subsequent use limited to the fulfilment of those purposes or such others as are not incompatible with those purposes and as are specified on each occasion of change of purpose.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://oecdprivacy.org/"/>
    <rdfs:label>Purpose Specification Principle</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7azvKC8RwopK0ecoTMqfH1">
    <skos:altLabel xml:lang="zh-cn">无罪推定</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">無罪推定</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Presunción de Inocencia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Presunção de inocência</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unschuldsvermutung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Presunción de Inocencia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Presumption of Innocence</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הנחת התפיסה של האפליה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Présomption d'innocence</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निर्दोषता का पूर्वाभास</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N72da0558bd7742aa889869a2950f05cd"/>
    <rdfs:subClassOf rdf:nodeID="N8726be47522e42dc9d9c4d2518192d2a"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQRg4Bv481hOyPBNKLCj8m"/>
    <rdfs:label>Presumption of Innocence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The presumption of innocence is a fundamental principle of criminal law that assumes an accused person is innocent until proven guilty. This cornerstone of the justice system places the burden of proof on the prosecution, requiring them to present sufficient evidence to convince a judge or jury of the defendant's guilt, and helps ensure that individuals are not unfairly convicted without proper evidence or due process.</skos:definition>
  </rdf:Description>
