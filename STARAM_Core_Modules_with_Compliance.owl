  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RLJT8v5yTfRQ6xRfJAq59P">
    <skos:altLabel xml:lang="pt-br">Pagamento indevido de instrumento negociável pelo banco</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">銀行による手形の誤払い</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bank’s Wrongful Payment of Negotiable Instrument</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Paiement erroné d'un instrument négociable par la banque</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">银行错误支付可转让票据</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Pago indebido de instrumento negociable por parte del banco</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fehlerhafte Zahlung von verhandelbaren Instrumenten durch die Bank</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Pago indebido de instrumento negociable por parte del banco</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बैंक के द्वारा न्यौत्पादिक उपकरण के गलत भुगतान</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תשלום לא חוקי של כלי כתיבה נגוש על ידי הבנק</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <skos:definition>The Bank's Wrongful Payment of Negotiable Instrument refers to a situation where a bank makes a payment on a negotiable instrument without proper authorization or without verifying the authenticity of the instrument, resulting in a loss to the rightful owner of the instrument.</skos:definition>
    <rdfs:label>Bank’s Wrongful Payment of Negotiable Instrument</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N923a5e09e93c4005a57f85699b0a5296">
