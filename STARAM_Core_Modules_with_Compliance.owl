    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <skos:definition>A Letter of Credit is a written agreement between a buyer and a seller, typically used in international trade, in which a bank guarantees payment to the seller upon receipt of certain documents.</skos:definition>
    <skos:altLabel xml:lang="fr-fr">Lettre de crédit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">信用状</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Carta de crédito</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">信用证</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Letter of Credit</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्रेडिट पत्र</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Carta de Crédito</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Akkreditiv</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Carta de Crédito</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אישור אשראי</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Letter of Credit</rdfs:label>
  </rdf:Description>
