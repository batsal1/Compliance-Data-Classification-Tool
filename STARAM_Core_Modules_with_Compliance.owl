  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDJvfvUzCUfCqBqkpPjclIi">
    <skos:altLabel>Pedestrian Priority Violation Claim</skos:altLabel>
    <skos:altLabel>Pedestrian Crossing Offence Claim</skos:altLabel>
    <skos:prefLabel>Pedestrian Right-of-Way Violation Claim</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="N58f1c6dc87714cfca7f4f921e0963f9f"/>
