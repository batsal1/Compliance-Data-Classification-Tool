    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The act of making false or misleading statements about someone's property, which causes harm to their reputation or financial interests, and can result in legal action under the categories of defamation, property, and premises liability claims.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/d9f90f0f-cea7-4496-988e-0c04c0573b4002d24824-cb03-4239-819d-c0bd4a615e5e">
