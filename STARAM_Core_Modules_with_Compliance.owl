    <skos:prefLabel>Collision Coverage</skos:prefLabel>
    <skos:definition>Collision auto insurance covers damage to the insured's own vehicle resulting from a collision with another vehicle or object, or from flipping over. It is generally an optional coverage but may be required if the vehicle is leased or financed. A deductible usually applies.</skos:definition>
    <rdfs:label>Collision Auto Insurance Coverage Policy</rdfs:label>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
