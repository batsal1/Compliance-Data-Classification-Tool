  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9roe3CXiKdz9VczkBjTN31">
    <rdfs:label>Expert System</rdfs:label>
    <skos:prefLabel>Domain-Specific AI System</skos:prefLabel>
    <skos:altLabel>Knowledge-Based System</skos:altLabel>
    <skos:altLabel>Symbolist Model</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Expert System is an automated system encoded with the knowledge of human experts, typically utilizing knowledge representation techniques. These systems are focused on narrow tasks and employ automated decision-making based on "if-then" rules to simulate the expertise of human specialists in specific domains.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
  </rdf:Description>
