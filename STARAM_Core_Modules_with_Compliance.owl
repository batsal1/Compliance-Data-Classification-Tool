  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Zpw6W6vllQC97Xj87kMAX">
    <skos:altLabel xml:lang="es-es">Falsificación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fälschung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नकली</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falsificación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">伪造</skos:altLabel>
