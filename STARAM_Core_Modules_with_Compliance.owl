  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RlRMCLYXFcvbK8k0pP4v5I">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Surgery Malpractice</rdfs:label>
    <skos:altLabel xml:lang="hi-in">सर्जरी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">外科医疗事故</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בניתוח</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en cirugía</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica em cirurgia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Surgery Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia médica en cirugía</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Chirurgiefehler</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en chirurgie</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">外科手術の医療過誤</skos:altLabel>
    <skos:definition>Surgery Malpractice refers to a type of medical malpractice claim that arises from a surgical procedure that was performed negligently or incompetently, resulting in harm to the patient.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
  </rdf:Description>
