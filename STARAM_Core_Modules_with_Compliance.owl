  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBAoFbSK8WP6xJyVrgQd5PZ">
    <skos:altLabel xml:lang="es-mx">Defensas Afirmativas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">肯定性抗辩</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגנות אפירמטיביות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिकृत बचाव</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Affirmative Defenses</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">肯定的な弁護</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défenses affirmatives</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Defensas Afirmativas</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Defesas afirmativas</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Affirmative Verteidigungen</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Affirmative Defenses are legal arguments raised by a defendant in response to a plaintiff's claim, which if proven, can defeat or mitigate the plaintiff's claim, and must be asserted by the defendant in their answer or other responsive pleading.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N728a3fcd2f3744f3a4e2da5a386c39a0"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
