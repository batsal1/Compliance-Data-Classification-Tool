  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDcaloxNRJ4e7P8ZOTeYNul">
    <skos:definition>UTBMS MF31 Executive Compensation refers to a specific code within the UTBMS Mergers and Acquisitions (M&amp;A) classification system used to categorize legal services related to executive compensation in corporate mergers and acquisitions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9d2DkaIPGh2tQoNNOoEBMu"/>
