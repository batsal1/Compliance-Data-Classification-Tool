  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBMcwJmi1qbptRmfbZDjEDI">
    <skos:definition>Disaster relief refers to the provision of immediate and coordinated assistance, including legal resources and services, to individuals and communities affected by natural or human-made catastrophes. The aim is to alleviate suffering, minimize further damage, and provide legal support for recovery and rebuilding efforts. Particular services might include helping obtain benefits and assistance, clearing title to property, and dealing with insurance.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7"/>
    <skos:prefLabel>Emergency Response</skos:prefLabel>
    <rdfs:label>Disaster Relief</rdfs:label>
    <rdfs:comment>From LIST: Legal Issues Taxonomy</rdfs:comment>
  </rdf:Description>
