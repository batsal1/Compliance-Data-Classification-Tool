  <rdf:Description rdf:about="https://folio.openlegalstandard.org/fOPbREAsSIarGeJiYAaoiw">
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing wood products (except establishments operating sawmills and wood preservation facilities; and establishments manufacturing veneer, plywood, engineered wood products, millwork, wood containers, or pallets).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/YFbAUnqXTmaP4s08d8dFfQ"/>
    <skos:example>Sections, prefabricated wood building, manufacturing</skos:example>
    <skos:example>Wood dowels manufacturing</skos:example>
    <skos:example>Prefabricated wood buildings manufacturing</skos:example>
    <skos:example>Mobile homes manufacturing</skos:example>
    <skos:example>Wood handles (e.g., broom, handtool, mop) manufacturing</skos:example>
    <skos:example>Panels, prefabricated wood building, manufacturing</skos:example>
    <rdfs:label>All Other Wood Product Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32199"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
