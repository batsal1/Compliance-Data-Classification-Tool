  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDxqUPyVGJl2FrNLqMtaaPs">
    <skos:prefLabel>Kids' Market Segment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The children's market segment refers to a division of the market that is specifically targeted towards children as consumers. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of children, taking into account factors such as age, development stage, and educational needs.</skos:definition>
    <rdfs:label>Children's Market Segment</rdfs:label>
    <skos:altLabel>Youth Market Segment</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N2cbb96ccb4f14cfe86a89eb2c988666f"/>
