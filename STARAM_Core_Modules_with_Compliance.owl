  <rdf:Description rdf:about="https://folio.openlegalstandard.org/pDxCS7g2QSS6LaWXf2aLfA">
    <rdfs:label>Steam and Air-Conditioning Supply</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/adQcOuLaTMu96ErMjMF2_g"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=221330"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing steam, heated air, or cooled air. The steam distribution may be through mains.</skos:definition>
  </rdf:Description>
