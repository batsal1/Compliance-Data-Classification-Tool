  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9jJy1g7qqFbLykg0IpIhYI">
    <skos:definition>Independent Creation in copyright law refers to the creation of a work without copying from other sources, relying solely on the author's own skill, judgment, and creativity. It emphasizes the requirement that a work must originate from the author and not be replicated from existing materials.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Independent Creation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe"/>
  </rdf:Description>
