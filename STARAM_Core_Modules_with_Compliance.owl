    <skos:altLabel xml:lang="es-mx">Experto</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Especialista</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Expert</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">専門家</skos:altLabel>
    <skos:altLabel>Expert</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Experte</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Expert</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">专家</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מומחה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Experto</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N249a68b54cfe4695b5855fac75576a61"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5L1UD7ZnNEZtL0JB8WEyb"/>
    <rdfs:subClassOf rdf:nodeID="N24b30c1c4a0d433ab9a265efafe953b0"/>
    <rdfs:subClassOf rdf:nodeID="N2bf3943668b4428db8b5b2b58e00371f"/>
    <rdfs:subClassOf rdf:nodeID="Nc2bc8acbae2b42b6b2c7a01839bb35bf"/>
    <rdfs:label>Expert</rdfs:label>
    <skos:hiddenLabel>EXPT</skos:hiddenLabel>
    <skos:definition>An expert is a person engaged on behalf of a party or party in interest to a dispute to provide services as a consulting or testifying expert. (A testifying expert would also be a "witness.")</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-EXPT</ns2:legacyIdentifier>
    <dc:identifier>EXPT</dc:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9EPdnM3F87jVOjCROdPARe">
    <skos:altLabel xml:lang="en-gb">Right to Counsel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito à assistência jurídica</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit à l'assistance d'un avocat</skos:altLabel>
    <skos:altLabel>Right to Legal Representation</skos:altLabel>
    <skos:altLabel>Right to an Attorney</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वकील के अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות לייעוץ משפטי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">弁護人の権利</skos:altLabel>
    <skos:altLabel>Right to Defense Counsel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Derecho a la defensa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho a la defensa letrada</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Recht auf anwaltliche Vertretung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">辩护权</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nc85a6f3102eb4cdfb042cf4369dece07"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBQRg4Bv481hOyPBNKLCj8m"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Right to a Lawyer</skos:prefLabel>
    <rdfs:label>Right to Counsel</rdfs:label>
    <skos:definition>The right to counsel refers to a fundamental legal principle that ensures individuals have access to legal representation, particularly during criminal proceedings. In the United States, this right is enshrined in the Sixth Amendment of the United States Constitution and guarantees that defendants facing criminal charges have the opportunity to be represented by an attorney, either privately retained or provided by the state if they cannot afford one, to protect their rights and ensure a fair trial.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7ueaoXfaJI7dcYi5MFDcRX">
    <skos:altLabel xml:lang="es-es">Abuso financiero de personas mayores</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התעללות פיננסית בקשישים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Abus financier envers les personnes âgées</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Finanzieller Missbrauch von älteren Menschen</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वृद्ध लोगों के वित्तीय उत्पीड़न</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abuso financiero de adultos mayores</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">金融对老年人的滥用</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Financial Elder Abuse</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">高齢者に対する金融的虐待</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Abuso financeiro contra idosos</skos:altLabel>
    <skos:definition>The unlawful or unethical exploitation of an elderly person's financial resources, assets, or property by a perpetrator who has a relationship of trust or authority with the victim.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Financial Elder Abuse</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RxwfbvWrxjdHqJhrBu3RWT"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTvmhlWl6bokNJwlrEnUHz">
    <skos:altLabel xml:lang="zh-cn">先决条件条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शर्त पूर्ववता शब्दावली</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de condition préalable</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de condição precedente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">条件前提条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Bedingungsvorbehalt-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Condition Precedent Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Condición Previa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Condición Previa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאי קודם</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A condition precedent clause is a provision in a contract that specifies an event or action that must occur before the parties are obligated to perform their respective duties under the contract.</skos:definition>
    <rdfs:label>Condition Precedent Clause</rdfs:label>
  </rdf:Description>
