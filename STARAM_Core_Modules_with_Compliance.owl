    <rdfs:label xml:lang="en">Undated or Unnumbered Corrigendum Reference</rdfs:label>
    <ns5:classificationMethod xml:lang="en">Category and serial number were taken directly from the source register. Drafting defect type, project phase and impact type were assigned automatically using keyword rules applied to the risk head name and its category.</ns5:classificationMethod>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Undated or Unnumbered Corrigendum Reference</skos:prefLabel>
    <prov:wasDerivedFrom rdf:resource="https://staram.in/ontology/epc/register"/>
    <skos:scopeNote xml:lang="en">Relational risk head: assess it by comparing document components using epc:conflictsWith, epc:amends and epc:crossReferences, not by reviewing a single clause in isolation.</skos:scopeNote>
    <skos:notation>RH-008</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9IOi6YnPlSPWuCJD1p2q3i">
    <skos:altLabel xml:lang="he-il">כתב ויתור על החסרת שיתוף פעולה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-responsabilité pour défaut de coopération</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Aviso de Isenção de Responsabilidade por Falta de Cooperação</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">協力不足の免責事項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Disclaimer for Lack of Cooperation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Aviso de falta de cooperación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftungsausschluss bei mangelnder Zusammenarbeit</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सहयोग की कमी के लिए अस्वीकरण</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Renuncia de responsabilidad por falta de cooperación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不合作免责声明</skos:altLabel>
    <rdfs:label>Disclaimer for Lack of Cooperation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
    <skos:definition>A disclaimer for lack of cooperation is a statement made by an insurance company indicating that they are not liable for a claim due to the policyholder's failure to cooperate with the investigation or provide necessary information.</skos:definition>
  </rdf:Description>
