  <rdf:Description rdf:about="https://folio.openlegalstandard.org/-HM4zEgFTSGy0IZWTbGuPg">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541214"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NmIMYURUTcetuQgVtrZrwA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments (except offices of CPAs) engaged in the following without also providing accounting, bookkeeping, or billing services: (1) collecting information on hours worked, pay rates, deductions, and other payroll-related data from their clients and (2) using that information to generate paychecks, payroll reports, and tax filings. These establishments may use data processing and tabulating techniques as part of providing their services.</skos:definition>
    <rdfs:label>Payroll Services</rdfs:label>
  </rdf:Description>
