  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RRAmVmuECGC1adNCrppWJw">
    <skos:altLabel xml:lang="zh-cn">必要性接收器</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Necessity Receiver</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">必要性レシーバー</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Notwendigkeitsempfänger</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Destinataire de nécessité</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आवश्यकता प्राप्तकर्ता</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מקבל צורך</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Receptor de necessidade</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Receptor de necesidad</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Receptor de necesidad</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आवश्यकता ग्राहक</skos:altLabel>
    <skos:definition>A "Necessity" Receiver is a type of receiver appointed by a court to take control of a company or property when it is necessary to prevent harm or damage to the property or its stakeholders.</skos:definition>
    <rdfs:label>"Necessity" Receiver</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R96NpUUsxlbrpJSPTQxDoH9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8VYYILjUTVRdBAurCoMbMb">
    <skos:altLabel xml:lang="zh-cn">保密信息条款定义</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de definición de información confidencial</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de definición de información confidencial</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Definition vertraulicher Informationen</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de définition des informations confidentielles</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गोपनीय सूचना शब्दावली की परिभाषा धारा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Definition of Confidential Information Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הגדרת מידע סודי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">機密情報条項の定義</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Definição de Informações Confidenciais</skos:altLabel>
    <skos:definition>A Definition of Confidential Information Clause is a provision in a contract that outlines the types of information that are considered confidential and the obligations of the parties to protect such information from disclosure to third parties.</skos:definition>
    <rdfs:label>Definition of Confidential Information Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7d649KKGBfJyGpUlJw50Y1">
    <skos:altLabel xml:lang="zh-cn">多区域诉讼司法小组规则</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">多地区訴訟司法パネルの規則</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Regeln des Justizausschusses für multidisziplinäre Rechtsstreitigkeiten</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Regras do Painel Judicial de Litígios Multidistritais</skos:altLabel>
