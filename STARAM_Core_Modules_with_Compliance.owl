    <skos:altLabel xml:lang="zh-cn">围产医学过失</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Perinatologische Fahrlässigkeit</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia médica en perinatología</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en perinatología</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בפרינטולוגיה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica em perinatologia</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en périnatologie</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">周産期医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पेरिनेटोलॉजी नुकसानदायी कार्य</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Perinatology Malpractice</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Perinatology Malpractice</rdfs:label>
    <skos:definition>Perinatology Malpractice refers to medical malpractice claims related to the care of pregnant women and their fetuses, including issues related to prenatal testing, labor and delivery, and neonatal care.</skos:definition>
  </rdf:Description>
