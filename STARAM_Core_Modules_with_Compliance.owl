    <rdfs:label>Intellectual Property Representation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RWQW185M6gqosVVQA1GE0A">
    <skos:altLabel xml:lang="es-mx">Cláusula de arbitraje</skos:altLabel>
