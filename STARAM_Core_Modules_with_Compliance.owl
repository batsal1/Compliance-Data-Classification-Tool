  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4tTlnh0xdCEoQbj8CkWoB">
    <skos:definition>To unlawfully engage in or promote sexual activities for anything of value.</skos:definition>
    <skos:altLabel xml:lang="es-es">Delitos de prostitución</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Prostitution Crimes</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פשעי זנות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Crimes de prostitution</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Prostitutionsverbrechen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">卖淫罪</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Crimes de prostituição</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">売春犯罪</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Delitos de prostitución</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेश्यावृत्ति अपराध</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
