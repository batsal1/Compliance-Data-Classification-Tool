    <skos:altLabel xml:lang="de-de">Fehlerhafte Geburtshilfe und Gynäkologie</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en obstétrique et gynécologie</skos:altLabel>
    <skos:altLabel>OB GYN Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">产科妇科医生的过失</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica em obstetrícia e ginecologia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">産婦人科医療過誤</skos:altLabel>
