  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7d6hYERMUTdeDdt51PsIX3">
    <skos:altLabel>Public Utility</skos:altLabel>
    <skos:example>A telephone company offering services to the public</skos:example>
    <skos:example>A bus company that offers transportation to the general public.</skos:example>
    <skos:example>An airline that sells tickets to the public</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <skos:prefLabel>Public Transport Service</skos:prefLabel>
    <skos:definition>A common carrier is an individual or business that advertises to the public to transport people, offer goods, or provide services to the public. Common carriers are legally obligated to provide services to any paying customer without discrimination.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Common Carrier</rdfs:label>
  </rdf:Description>
