  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBQJ0H8haMYmsQGXG1Vl4tf">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8FLbODQd9k85hPERve6IN7"/>
    <rdfs:label>Climate Stability Rights</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Climate Stability Rights pertain to the legal entitlements and principles recognizing the fundamental right of present and future generations to a stable and healthy climate. This concept underscores the obligation of governments, industries, and other entities to take proactive measures to mitigate climate change, reduce greenhouse gas emissions, and preserve the planet's ecological balance. These rights emphasize the importance of intergenerational equity, sustainable development, and global cooperation to ensure a habitable environment for all.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#capPercentage">
    <skos:definition xml:lang="en">A percentage limit stated in the allocation, e.g. 3% of Contract Price for professional liability cover, 10% for withdrawal of Works.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">cap percentage</rdfs:label>
  </rdf:Description>
