  <rdf:Description rdf:about="https://folio.openlegalstandard.org/8YUv1xyVROK8jVQTx4KLlg">
    <skos:example>Polygraph services</skos:example>
    <skos:example>Private detective services</skos:example>
    <skos:example>Private investigative services (except credit)</skos:example>
