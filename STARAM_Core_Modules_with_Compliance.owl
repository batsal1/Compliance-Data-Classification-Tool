  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ny9q1BiiYcBN1IyMl0XRe">
    <skos:altLabel xml:lang="en-gb">Pipeline Transportation Industry</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria del transporte por tubería</skos:altLabel>
    <skos:altLabel>Pipeline Transportation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria del transporte por ductos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pipeline-Transportindustrie</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पाइपलाइन परिवहन उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie du transport par pipeline</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">パイプライン輸送産業</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">管道运输行业</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de transporte por dutos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית הובלת צינורות</skos:altLabel>
    <skos:definition>Industries in this group use transmission pipelines to transport products, such as crude oil, natural gas, refined petroleum products, and slurry.</skos:definition>
    <skos:prefLabel>Pipeline Transportation Industry</skos:prefLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-TRA-PIPT</ns2:legacyIdentifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUE4fCCSnGX1wIK324EyiL"/>
    <dc:identifier>IN-INDUSTRY-18.3</dc:identifier>
    <dc:identifier>TRA-PIPT</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Pipeline Transportation Industry</rdfs:label>
    <skos:hiddenLabel>PIPT</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R990nQHm5t87q4mZJrkzOyX">
    <rdfs:label>Extern</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBfgMJEBmJrI7Wp0zUjROJ3"/>
    <skos:definition>An extern typically refers to a student or recent graduate undergoing short-term practical training in a specific field, often without pay. The externship experience is often shorter than an internship and is focused on shadowing professionals rather than performing job duties.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7ySw3Q2ZOiM5J4f8o0nRKK">
    <skos:altLabel>Service Sales</skos:altLabel>
    <skos:altLabel>Service Sales Service</skos:altLabel>
    <skos:altLabel>Service Agreement Practice</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCijZPAaPw0lgYwtl8qWG67"/>
    <rdfs:label>Service Sales Practice</rdfs:label>
    <skos:definition>Services sales practice is the area of law focused on the legal aspects and agreements related to the sale and provision of services, rather than assets. This practice encompasses contract formation, regulatory compliance, liability issues, and the protection of intellectual property related to service transactions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/eFQULaCzQH-_Wr2OaUzajQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/W2f3zFf7TqGjiIp6K4IVNQ"/>
    <skos:example>Paralegal services</skos:example>
    <skos:example>Process serving services</skos:example>
    <skos:example>Patent agent services (i.e., patent filing and searching services)</skos:example>
    <skos:example>Notary public services</skos:example>
    <rdfs:label>All Other Legal Services</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541199"/>
    <skos:definition>This U.S. industry comprises establishments of legal practitioners (except offices of lawyers and attorneys, settlement offices, and title abstract offices). These establishments are primarily engaged in providing specialized legal or paralegal services.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7mBPPNZa5Dk7a8ft3v1VbD">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
    <rdfs:subClassOf rdf:nodeID="N884fe972b86b4b628df265159d555032"/>
    <rdfs:label>CLIENT_NAME</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The term CLIENT_NAME refers to a specific data element within the LEDES98BI V5 Format Rev 1-2020 standard, which is used to identify the name of a client in legal billing and invoicing processes.</skos:definition>
  </rdf:Description>
