    <skos:altLabel xml:lang="zh-cn">纳税申报特权</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio de declaração de imposto</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Steuererklärungsprivileg</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">税務申告特権</skos:altLabel>
