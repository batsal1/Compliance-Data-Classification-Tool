  <rdf:Description rdf:about="https://folio.openlegalstandard.org/MPgMhorTTMapT0FPKqF-Gw">
    <skos:definition>This U.S. industry comprises establishments known as medical laboratories primarily engaged in providing analytic or diagnostic services, including body fluid analysis, generally to the medical profession or to the patient on referral from a health practitioner.</skos:definition>
    <skos:example>Medical pathology laboratories</skos:example>
    <skos:example>Medical testing laboratories</skos:example>
    <skos:example>Blood analysis laboratories</skos:example>
    <skos:example>Medical forensic laboratories</skos:example>
    <skos:example>Medical bacteriological laboratories</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Medical Laboratories</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=621511"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/dN2iD83iS9eNVDIF5FKpEw"/>
  </rdf:Description>
