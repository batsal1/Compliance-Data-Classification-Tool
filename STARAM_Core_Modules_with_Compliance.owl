  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8dZ6ebqbuHCjjAa6BuUsPY">
    <skos:altLabel xml:lang="he-il">ניהול מסמכים וקבצים</skos:altLabel>
