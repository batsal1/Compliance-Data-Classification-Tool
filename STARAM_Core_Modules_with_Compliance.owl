  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB8cqmrXOdfDuxcZ4gQzEZy">
    <rdfs:label>Onshore Wind Energy</rdfs:label>
    <skos:altLabel>Land-Based Wind Power</skos:altLabel>
    <skos:altLabel>Terrestrial Wind Energy</skos:altLabel>
    <skos:definition>Onshore Wind Energy refers to the generation of electricity through wind turbines located on land rather than offshore locations. It is a key component of renewable energy strategies worldwide, contributing significantly to sustainable energy production.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDCVD1h5h31JekFnNolVJju"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7tKtki2tvT0I1cpSLJSWRF"/>
    <skos:definition>An allied legal professional supports the delivery of legal services through specialized skills and knowledge. These professionals work in various roles, such as paralegals, law librarians, and legal marketing personnel, all enabling legal service providers (e.g., law firms) to deliver legal services.</skos:definition>
    <skos:prefLabel>Non-Lawyer</skos:prefLabel>
    <rdfs:label>Allied Legal Professional</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Legal Support Staff</skos:altLabel>
  </rdf:Description>
