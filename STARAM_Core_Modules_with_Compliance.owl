    <skos:definition>"Sum of all FEE_ITEM_DISC_CRED.disc_cred_amounts for this fee item.  Does not include MATTER_DISC_CRED.disc_cred_amounts.  
"</skos:definition>
    <rdfs:label>item_disc_cred_amount</rdfs:label>
  </rdf:Description>
