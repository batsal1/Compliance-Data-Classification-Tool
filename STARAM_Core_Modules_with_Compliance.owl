  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-boilerplate">
    <ns5:mappingGapNote xml:lang="en">Weak mapping: defects in boilerplate clauses affect every allocation category, so they have no natural place in a lifecycle-based taxonomy.</ns5:mappingGapNote>
    <skos:notation>LR-19</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-legal-liability"/>
    <rdfs:label xml:lang="en">Boilerplate &amp; Miscellaneous</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:prefLabel xml:lang="en">Boilerplate &amp; Miscellaneous</skos:prefLabel>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <skos:definition xml:lang="en">Risks in the standard operational clauses, covering notices, waiver, severability, third-party rights, survival of obligations, execution formalities, contract language, and non-solicitation.</skos:definition>
  </rdf:Description>
