    <rdfs:label>Business Judgment Rule</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="hi-in">व्यापार निर्णय नियम</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ビジネス判断規則</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Regra de julgamento empresarial</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Regla de Juicio Empresarial</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כלל שיקול דעת עסקי</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Règle de jugement commercial</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Regla de Juicio Empresarial</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Business Judgment Rule</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业判断规则</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Business Judgment Rule</skos:altLabel>
    <skos:definition>The Business Judgment Rule is a legal principle that shields corporate directors and officers from liability for decisions made in good faith and with reasonable care in the best interests of the company, even if those decisions ultimately result in negative consequences.</skos:definition>
  </rdf:Description>
