  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9FNUfXhgfuBBGUG7VrshB">
    <skos:altLabel xml:lang="es-mx">Expropiación de facto</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיקוח על רכוש בפועל</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">事实征用</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Apropriação de fato</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Expropiación de facto</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">事実上の没収</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वास्तविक तौर पर ले लेना</skos:altLabel>
    <skos:altLabel xml:lang="de-de">De-facto-Enteignung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Prise de facto</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">De Facto Taking</skos:altLabel>
    <skos:definition>The concept of De Facto Taking refers to a situation where the government takes private property without following the proper legal procedures for eminent domain or taking, resulting in the property owner being deprived of their rights without compensation.</skos:definition>
    <rdfs:label>De Facto Taking</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDwajUPdKVdK5tlwiUjmNzG"/>
  </rdf:Description>
