  <rdf:Description rdf:about="https://folio.openlegalstandard.org/2uh-jhMjQtCcfOVdVaT4zA">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing institutional-type furniture (e.g., library, school, theater, and church furniture). Included in this industry are establishments primarily engaged in manufacturing general purpose hospital, laboratory, and dental furniture (e.g., tables, stools, and benches). The furniture may be made on a stock or custom basis and may be assembled or unassembled (i.e., knockdown).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=337127"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/kWnYwlzIS9K0r1_cV3CAHQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Institutional Furniture Manufacturing</rdfs:label>
  </rdf:Description>
