    <rdfs:label>Motor Vehicle Dealership Liability</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Motor Vehicle Dealership Liability refers to the legal responsibility of a car dealership for any harm or damages caused to a customer or third party as a result of the dealership's actions or negligence in the sale or maintenance of a vehicle.</skos:definition>
  </rdf:Description>
