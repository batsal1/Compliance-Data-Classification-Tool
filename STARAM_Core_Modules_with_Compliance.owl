  <rdf:Description rdf:about="https://staram.in/ontology/epc#reliefGovernedBy">
    <rdfs:range rdf:resource="https://staram.in/ontology/epc#DocumentaryUnit"/>
    <rdfs:label xml:lang="en">relief governed by</rdfs:label>
    <skos:definition xml:lang="en">The documentary unit that supplies the relief, which is often not the unit that allocates the risk (e.g. allocation in Art. 21.2, relief in Art. 21.6). The range admits whole documents because valuation relief for withdrawn Works is supplied by Schedule-H as a whole.</skos:definition>
    <rdfs:domain rdf:resource="https://staram.in/ontology/epc#RiskAllocation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
