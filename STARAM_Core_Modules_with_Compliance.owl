  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8D7zkayxr0I7sqmU8dyWFF">
    <rdfs:subClassOf rdf:nodeID="N8b8c19ae62c54fadb948323ede196ae7"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
    <rdfs:subClassOf rdf:nodeID="N24fffd62f6e548f39dacd1107afcc2aa"/>
    <rdfs:label>Educational Linguistic Accommodation</rdfs:label>
    <skos:definition>Educational Linguistic Accommodation refers to the measures taken by educational institutions to ensure that students with limited proficiency in a country's predominant language receive equitable access to education. This can include bilingual instruction, additional language support resources, tailored curriculum, and other accommodations designed to help these students overcome language barriers and achieve academic success on par with their native-speaking peers.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-defects-warranty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-safety-env-om"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-execution"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <skos:notation>LR-06</skos:notation>
    <rdfs:label xml:lang="en">Defects Liability &amp; Warranty</rdfs:label>
    <skos:definition xml:lang="en">Risks that arise after completion, covering the length and extension of the defects liability period, latent defects, allocation of rectification costs, snagging, and performance guarantee testing.</skos:definition>
    <skos:prefLabel xml:lang="en">Defects Liability &amp; Warranty</skos:prefLabel>
  </rdf:Description>
