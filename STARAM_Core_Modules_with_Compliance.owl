  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8PCFARyZiL1JkOYsz4sen3">
    <skos:altLabel xml:lang="fr-fr">Norme antitrust basée sur le dollar</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Dollar-basierter Kartellrechtsstandard</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ドルベースの独占禁止法基準</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">基于美元的反垄断标准</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Padrão antitruste baseado em dólar</skos:altLabel>
    <skos:definition>A Dollar-Based Antitrust Standard is a legal concept that sets a monetary threshold for determining whether a business practice violates antitrust laws, with the aim of preventing anticompetitive behavior while also allowing for efficient business operations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dollar-Based Antitrust Standard</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RS6Pedvqd6vX99HwyhZIlP"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Qf9X22qnr7DDy7sBFXP9K">
    <rdfs:label>Littering</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Fly-Tipping</skos:altLabel>
    <skos:definition>Littering is the act of improperly disposing of waste materials in public or private spaces, rather than in designated trash receptacles. This behavior results in environmental pollution, health hazards, and can lead to significant fines and penalties.</skos:definition>
    <skos:prefLabel>Illegal Dumping</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8ZZ3NsCK0vyOmGji7SpKkW"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
