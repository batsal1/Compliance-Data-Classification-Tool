    <skos:altLabel>Want of Consideration</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha de contraprestação</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure of Consideration</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta de contraprestación</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">対価不履行</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כשל בתמורה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta de contraprestación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaut de contrepartie</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Mangelnde Gegenleistung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:subClassOf rdf:nodeID="N616f3b98d3c1418b998c68de2b96a441"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBAoFbSK8WP6xJyVrgQd5PZ"/>
    <rdfs:label>Failure of Consideration</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Failure of Consideration is a legal defense that asserts that one party did not receive the agreed-upon consideration or value in exchange for their performance or promise, which renders the contract or agreement unenforceable.</skos:definition>
  </rdf:Description>
