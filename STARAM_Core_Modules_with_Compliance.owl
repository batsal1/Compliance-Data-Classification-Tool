  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCRhA0WSfh8IAm5R1OvgQAF">
    <skos:altLabel xml:lang="en-gb">Buyer Recovering Costs Due to Title Defect</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Comprador recuperando custos devido a defeito de título</skos:altLabel>
    <skos:altLabel xml:lang="he-il">קונה משיב עלות בגין פגם בכותרת</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Comprador recuperando costos debido a defectos en el título</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">タイトル欠陥による買い手の費用回収</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Acheteur récupérant les coûts dus à un défaut de titre</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार शीर्षक दोष के कारण लागत पुनर्प्राप्त करना</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Comprador recuperando costos debido a defectos en el título</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Käufer erholt Kosten aufgrund von Titeldefekt</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">由于所有权瑕疵而恢复费用的买方</skos:altLabel>
    <rdfs:label>Buyer Recovering Costs Due to Title Defect</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Buyer Recovering Costs Due to Title Defect" refers to the legal right of a purchaser of property to seek compensation for expenses incurred as a result of a defect in the title of the property, such as legal fees or costs associated with correcting the defect.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
  </rdf:Description>
