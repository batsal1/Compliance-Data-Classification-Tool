  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e">
    <skos:altLabel xml:lang="de-de">Transaktionsziele</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">トランザクション目標</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Objectifs transactionnels</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लेन-देन उद्देश्य</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מטרות עסקיות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Objetivos Transaccionales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">交易目标</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Objetivos Transaccionales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Transactional Objectives</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Objetivos transacionais</skos:altLabel>
    <skos:definition>Transactional Objectives are specific aims, goals, plans, or intentions related to a legal transaction, such as a merger or acquisition, and the frameworks that support their execution.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlNFgB3TQfMzV26V4V7u4E"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Transactional Objectives</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBgyUJt7qyOEtnXbAg6mdTJ">
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <skos:prefLabel>Medical Assistance</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Health public benefit refers to government programs designed to provide medical services or financial assistance for healthcare needs to eligible individuals. This can include programs like Medicaid in the United States, which offers healthcare coverage to low-income families and individuals.</skos:definition>
    <rdfs:label>Health Public Benefit</rdfs:label>
  </rdf:Description>
