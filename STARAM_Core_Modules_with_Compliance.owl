  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCcWasK7LnVMXipm7uQAOA2">
    <rdfs:label>Visitor</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A visitor is an individual who temporarily enters a specific location, such as a country, city, or residence, for various purposes. Visitors can include tourists, who travel for leisure and exploration; business visitors, who come for work-related activities; or guests invited to a residence for social or personal reasons. The nature of the visit and applicable regulations, such as visa requirements or entry permissions, can differ based on the visitor's purpose and destination.</skos:definition>
  </rdf:Description>
