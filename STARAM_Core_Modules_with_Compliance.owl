  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ld5fuznk2KgKLafAENQsH">
    <skos:altLabel xml:lang="de-de">Verwässerung des Markenimages</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ट्रेड ड्रेस दिलूशन</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业外观淡化</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Dilution de l'image de marque</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">トレードドレスの希釈</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Dilución de la imagen comercial</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Diluição da imagem de marca</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דילול תפאורה מסחרית</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Dilución de la imagen comercial</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trade Dress Dilution</skos:altLabel>
    <skos:definition>The concept of Trade Dress Dilution refers to a legal claim that protects the distinctiveness and uniqueness of a company's product or service design from being weakened or diluted by similar designs used by competitors, which may cause confusion among consumers.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8viNe7dpcLA9kGH5gl7YE6"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJL4HDUmZp1VEEZ7lCwSSF"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Trade Dress Dilution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL">
    <skos:altLabel xml:lang="hi-in">सौदे की संरक्षण और संबंधित विधियाँ</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Maßnahmen zum Schutz von Geschäftsabschlüssen und verwandte Bestimmungen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Deal Protection and Related Provisions</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">取引保護および関連規定</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגנת העסקה והוראות קשורות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Mesures de protection des transactions et dispositions connexes</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Protección de la operación y disposiciones relacionadas</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Protección de la operación y disposiciones relacionadas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">交易保护及相关条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Proteção de negociações e disposições relacionadas</skos:altLabel>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <skos:definition>Deal Protection and Related Provisions refer to a set of contractual clauses and agreements that are designed to safeguard a merger or acquisition deal from external threats and ensure its successful completion, including provisions such as no-shop covenants, breakup fee triggers, and fiduciary termination rights.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
    <rdfs:label>Deal Protection and Related Provisions</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDRCaFxX4hpUklgNnVS9D8C"/>
  </rdf:Description>
