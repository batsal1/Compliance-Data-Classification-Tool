    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q7GJc1zsYT0P4Xdp6l9Oz"/>
    <rdfs:subClassOf rdf:nodeID="N58a0d98c887f4166b04f7b99d3194f26"/>
    <skos:altLabel xml:lang="fr-fr">Action collective</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sammelklage</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Group Litigation</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Class Action</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">集体诉讼</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה מחוץ לכינוי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ação coletiva</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acción Colectiva</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्लास एक्शन</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">集団訴訟</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acción de Clase</skos:altLabel>
    <skos:definition>A Class Action is certified class consisting of a group of people who have suffered similar harm or injury, where the claims are too numerous or impractical to be brought individually.</skos:definition>
    <skos:definition>A Class Action is a legal claim brought by a group of people who have suffered similar harm or injury, where the claims are too numerous or impractical to be brought individually.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
