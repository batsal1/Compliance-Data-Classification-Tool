  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9jQJqTpfsNpvV2UXQrh6k5">
    <skos:prefLabel>Government Issuer</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>National Issuer</skos:altLabel>
    <skos:altLabel>Country Issuer</skos:altLabel>
    <rdfs:label>Sovereign Issuer</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDM4k8t0O3hy93vQwQzEcpg"/>
    <skos:definition>A Sovereign Issuer refers to a national government or its agencies that issue debt securities to raise capital for public expenditures, such as infrastructure projects or budget deficits. These securities, often called government bonds, are backed by the full faith and credit of the issuing government.</skos:definition>
  </rdf:Description>
