  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rr7unN3nXmcbbkDTbDWiwb">
    <skos:altLabel xml:lang="de-de">Anspruch nach Artikel 3</skos:altLabel>
    <skos:altLabel>Article III Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף 3</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Article 3 Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação do Artigo 3</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">第3条請求</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación del artículo 3</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Demande en vertu de l'article 3</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुच्छेद 3 दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación del artículo 3</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">第3条索赔</skos:altLabel>
    <skos:definition>An Article III claim pertains to a legal argument based on Article III of the U.S. Constitution, which establishes the judicial branch of the federal government. Such a claim may arise in disputes over federal court jurisdiction, the interpretation of federal laws, or the constitutionality of legislation or executive actions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
    <rdfs:label>Article 3 Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
