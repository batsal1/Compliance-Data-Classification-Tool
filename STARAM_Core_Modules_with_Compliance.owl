  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7YcudBFwMUS1r7BcWje7Ly">
    <rdfs:label>"Intervening Event" Thresholds</rdfs:label>
    <skos:altLabel xml:lang="es-es">Umbral de Evento Interviniente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Umbral de Evento Interviniente</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Limiares de Evento Interveniente</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schwellenwerte für 'Einschreitendes Ereignis'</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">介入イベントの閾値</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हस्तक्षेप घटना अधिकतम सीमा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Intervening Event Thresholds</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Seuils d'événement intervenant</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">“干预事件”门槛</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סף אירוע מתערב</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDnJ5pHeJZuA0vHQXYalZO6"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Intervening Event Thresholds refer to specific criteria or conditions that must be met in order for an event to be considered an intervening event, which is an event that occurs after the signing of a legal agreement and may affect its performance or outcome.</skos:definition>
  </rdf:Description>
