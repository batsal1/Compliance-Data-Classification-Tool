    <skos:altLabel xml:lang="ja-jp">軍事的差別待遇</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Discriminación Militar</skos:altLabel>
    <skos:altLabel>Veteran Discrimination</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सैन्य भेदभाव</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">军事歧视</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Discriminación Militar</skos:altLabel>
