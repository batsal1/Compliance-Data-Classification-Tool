  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8FavvZFarqdpJREx1eciBp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Court Clerk</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSYPGgBlFz5eWNtwoMA2c5"/>
    <skos:definition>A Judicial Clerk is a legal professional, typically a recent law school graduate, who assists a judge with research, writing opinions, and other tasks essential to judicial proceedings. Judicial clerks play a critical role in the judicial process by providing detailed analysis and support for the judge's decision-making.</skos:definition>
    <rdfs:label>Judicial Clerk</rdfs:label>
    <skos:prefLabel>Law Clerk</skos:prefLabel>
  </rdf:Description>
