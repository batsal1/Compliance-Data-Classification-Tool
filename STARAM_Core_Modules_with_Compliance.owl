  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB23VdjCCaK5Rs8CopgFJpI">
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות במרפאה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence médicale en clinique</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en la clínica</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en la clínica</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्लिनिक लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência clínica</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">クリニック過失</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klinikverschulden</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Clinic Negligence</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">诊所疏忽</skos:altLabel>
    <rdfs:label>Clinic Negligence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <skos:definition>Clinic Negligence refers to the failure of a medical clinic or its staff to provide adequate care or treatment to a patient, resulting in harm or injury to the patient.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5d160493112b4855916678566d648bee">
