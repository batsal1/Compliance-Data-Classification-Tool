  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC94jK40XuV0hinhBl0BDly">
    <skos:altLabel xml:lang="es-mx">Cláusula de Ejecución en Múltiples Contrapartes</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">相補的な執行条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Execution in Counterparts Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ביצוע בנפרד</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Ausführung in mehreren Ausfertigungen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Ejecución en Múltiples Ejemplares</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कार्यान्वयन विपरीतों में धारा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">分别执行条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de execução em contrapartida</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'exécution en plusieurs exemplaires</skos:altLabel>
    <skos:definition>An Execution in Counterparts Clause is a provision in a contract that allows for the execution of multiple identical copies of the contract, each signed by different parties, as if they were a single document.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Execution in Counterparts Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDpsD9QKYJV3FTgsBK87fSe">
    <skos:altLabel xml:lang="hi-in">मूल्य परिवर्तन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">价格变更条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Preisänderungsklausel</skos:altLabel>
    <skos:altLabel>Price Adjustment Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de changement de prix</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Cambios de Precio</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de alteração de preços</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Price Changes Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Cambios de Precio</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שינויי מחיר</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">価格変更条項</skos:altLabel>
    <rdfs:label>Price Changes Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Price Changes Clause, also known as a Price Adjustment Clause, is a provision in a contract that allows for adjustments to the price of goods or services based on certain conditions or events.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
