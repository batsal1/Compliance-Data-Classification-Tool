    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7bP5vwpnavvW5pPJutIvq8"/>
    <rdfs:subClassOf rdf:nodeID="Nae56f334f16c4e949a4fb71327f397e5"/>
    <skos:definition>A degree of infraction refers to the severity level of a criminal claim, indicating the level of wrongdoing or harm caused by the accused party.</skos:definition>
    <skos:definition>An infraction is a violation of a rule or law that is typically considered less serious than a misdemeanor or felony. Infractions are generally punishable by fines, citations, or other minor penalties, rather than imprisonment.</skos:definition>
    <rdfs:label>Infraction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
