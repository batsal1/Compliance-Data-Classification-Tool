  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBBn10LVE7BZpwwMxp4N6RQ">
    <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato implícito en los hechos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de contrato implícito</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de contrato implícito en los hechos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बिना-फैक्ट-कॉन्ट्रैक्ट का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">默示合同违约</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">黙示契約違反</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Implied-in-Fact Contract</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung eines stillschweigend geschlossenen Vertrags</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de contrat implicite</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוזה משפטי משוער במציאות</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDplPdJJQ6YnEbE1gSXm51T"/>
    <skos:definition>The Breach of Implied-in-Fact Contract refers to a situation where one party fails to fulfill the obligations that were not explicitly stated but were understood by both parties to be a part of their agreement.</skos:definition>
    <rdfs:label>Breach of Implied-in-Fact Contract</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/4_4xkC4YSFO4R12wNsuklw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ac4Hh3usR0SdQ7ST12Vtug"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing one or more of the following community housing services: (1) transitional housing to low-income individuals and families; (2) volunteer construction or repair of low-cost housing, in partnership with the homeowner who may assist in the construction or repair work; and (3) the repair of homes for elderly or disabled homeowners. These establishments may subsidize housing using existing homes, apartments, hotels, or motels or may require a low-cost mortgage or sweat equity. These establishments may also provide low-income families with furniture and household supplies.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=624229"/>
    <rdfs:label>Other Community Housing Services</rdfs:label>
  </rdf:Description>
