  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBAZQooO7sbntllrQgnIFHM">
    <skos:definition>The failure to perform a contractual obligation, resulting in a violation of the terms of the agreement.</skos:definition>
    <skos:altLabel xml:lang="he-il">הפרת חוזה עקב כישלון בביצוע</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">履行不履行による契約違反</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de contrat pour non-exécution</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Contract for Failure to Perform</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato por falta de ejecución</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsbruch wegen Nichterfüllung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de contrato por falta de cumplimiento</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवकाश के लिए अनुबंध उल्लंघन</skos:altLabel>
