  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7KxjL7VPa0Qrz5eSP9DAs3">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
    <skos:altLabel>Computational Model</skos:altLabel>
    <skos:altLabel>Machine Learning Model</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AI Model</rdfs:label>
    <skos:definition>An AI Model is a core component of an AI system used to make inferences from inputs to produce outputs. It characterizes an input-to-output transformation designed to perform a specific computational task of the AI system, such as classifying an image, predicting the next word in a sequence, or selecting a robot's next action based on its state and goals.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/WKdlevc0TBSMKSzQN1Qilg">
    <skos:definition>This industry comprises establishments primarily engaged in offering instruction in the arts, including dance, art, drama, and music.</skos:definition>
    <skos:example>Dance studios</skos:example>
    <skos:example>Art (except commercial and graphic) instruction</skos:example>
    <skos:example>Music schools (except academic)</skos:example>
    <skos:example>Performing arts schools (except academic)</skos:example>
    <skos:example>Dance instruction</skos:example>
    <skos:example>Music instruction (e.g., piano, guitar)</skos:example>
    <skos:example>Fine arts schools (except academic)</skos:example>
    <skos:example>Photography schools (except commercial photography)</skos:example>
    <skos:example>Drama schools (except academic)</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/u-0_T-m_ST-CIY-33Mnrdw"/>
    <rdfs:label>Fine Arts Schools</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=611610"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
