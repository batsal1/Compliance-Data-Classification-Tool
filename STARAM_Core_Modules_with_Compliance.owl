    <skos:altLabel xml:lang="pt-br">Luz falsa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אור שקרי</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">虚假的光</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Luz falsa</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">झूठी रोशनी</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">偽りの光</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">False Light</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Falsches Licht</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>False Light is a type of privacy claim where a person is portrayed in a misleading or false manner that would be highly offensive to a reasonable person.</skos:definition>
  </rdf:Description>
