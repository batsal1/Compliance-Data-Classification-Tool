  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RE5Fc26D4606fC0Cd7664845">
    <dc:identifier>B-USCHAP11</dc:identifier>
    <rdfs:label>US Chapter 11 Bankruptcy</rdfs:label>
    <skos:altLabel xml:lang="es-es">Quiebra del Capítulo 11 de EE. UU.</skos:altLabel>
    <skos:altLabel>US Chapter 11</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Quiebra del Capítulo 11 de EE. UU.</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faillite américaine de Chapitre 11</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">米国の第11章破産</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">US Chapter 11 Bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="de-de">US-Insolvenzverfahren nach Kapitel 11</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यूएस अध्याय 11 दिवाली</skos:altLabel>
    <skos:altLabel>Chapter 11</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">美国第11章破产</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דיוקנאות פשיטת רגל פרק 11 של ארה״ב</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falência americana do Capítulo 11</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Proc-B-USCHAP11</ns2:legacyIdentifier>
    <skos:hiddenLabel>USCHAP11</skos:hiddenLabel>
    <rdfs:subClassOf rdf:nodeID="N2b7cbec832c44d45a35adbe05b02fab3"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdfs:subClassOf rdf:nodeID="N677c1e3a65534492976b5f05207f0e1e"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Jo3gp8LjhpdJNXYE9ow95"/>
    <skos:definition>Chapter 11 bankruptcy is a reorganization bankruptcy, and is available to individuals and businesses. The debtor remains in control of business operations under chapter 11 and doesn't sell off all of its assets.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>US Chapter 11</skos:prefLabel>
  </rdf:Description>
