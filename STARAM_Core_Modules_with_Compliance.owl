    <skos:altLabel xml:lang="ja-jp">著作権法</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei de Direitos Autorais</skos:altLabel>
    <skos:altLabel>Copyright Law</skos:altLabel>
    <dc:identifier>IN-LAW-20.1</dc:identifier>
    <dc:identifier>INTP-COPY</dc:identifier>
