    <skos:altLabel xml:lang="fr-fr">Blessure causée par un animal sauvage</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגיעה שנגרמה על ידי חיות פראיות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Lesiones causadas por animales salvajes</skos:altLabel>
