    <ns1:contractFamily xml:lang="en">Tax</ns1:contractFamily>
    <skos:definition>A Rollover Agreement refers to an arrangement where an investor transfers the proceeds from a mature security into a new issue of the same or a similar security. It can also pertain to the transfer of assets from one retirement plan to another without incurring tax penalties.</skos:definition>
    <rdfs:label>Rollover Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
