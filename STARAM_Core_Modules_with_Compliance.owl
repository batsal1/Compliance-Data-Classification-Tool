  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8HTEJBbwGF5UCcvBsSJKmg">
    <skos:altLabel>Equal Share Ownership</skos:altLabel>
    <skos:altLabel>Joint Ownership with Right of Survivorship</skos:altLabel>
    <skos:altLabel>Survivorship Tenancy</skos:altLabel>
    <skos:prefLabel>Joint Ownership</skos:prefLabel>
    <skos:definition>Joint Tenancy is a form of concurrent ownership where two or more individuals hold equal shares in a property with the right of survivorship. This means that upon the death of one joint tenant, their share automatically passes to the surviving joint tenants.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RMo0rWec8owXGDAYl6PGNG"/>
    <rdfs:label>Joint Tenancy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7c3c143e00874f32a4854fe045eae2af">
