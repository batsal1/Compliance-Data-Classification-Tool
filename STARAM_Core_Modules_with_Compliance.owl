  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9JJWlci2GwDGSMqF9e5IiW">
    <skos:definition>A Vehicle Equipment Violation Claim involves allegations that a vehicle's equipment does not meet the regulatory standards required by law, which may include issues with lighting, brakes, tires, or emissions controls. These claims are crucial for ensuring road safety and environmental compliance, and they can result in mandatory repairs, fines, or other enforcement actions.</skos:definition>
    <skos:altLabel>Car Equipment Infraction Claim</skos:altLabel>
    <skos:altLabel>Vehicle Compliance Violation Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <rdfs:label>Vehicle Equipment Violation Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
