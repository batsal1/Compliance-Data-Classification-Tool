    <skos:altLabel xml:lang="hi-in">कर्मचारी लाभ / पेंशन का विश्लेषण</skos:altLabel>
    <skos:definition>The Analysis of Employee Benefits/Pensions is the examination and evaluation of the benefits and pension plans provided to employees by an employer, typically in the context of legal obligations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
