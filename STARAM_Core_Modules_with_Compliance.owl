  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCGW5RFfjJ95ygeSCJLaJQT">
    <skos:altLabel xml:lang="hi-in">प्रधान-एजेंट दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">委托代理责任</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade do principal e do agente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad del principal por actos del agente</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Principal-Agent Liability</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad del principal por actos del agente</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות המנהל על פעולות הסוכן</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité du mandant et de l'agent</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung von Prinzipal und Agent</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">委任者代理人責任</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Principal-Agent Liability is a legal concept that holds a principal responsible for the actions of their agent, who acts on their behalf, and can be held liable for any harm caused by the agent's actions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
    <rdfs:label>Principal-Agent Liability</rdfs:label>
  </rdf:Description>
