  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8GuYn7yMmfL0coiNQ0OE8f">
    <skos:definition>An immigrant is an individual who moves to a country other than their country of origin with the intention of residing there permanently or for an extended period. The reasons for immigration can vary and may include seeking employment opportunities, better living conditions, or reunification with family.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD2KAbcnrk0vfpUCEog3N9F"/>
    <rdfs:subClassOf rdf:nodeID="Ncc22b46f997b4dfea3618280d5e9fdf9"/>
