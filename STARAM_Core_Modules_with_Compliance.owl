    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Enurement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDvoXpLEwrCw49W70qdbtvN">
    <skos:altLabel xml:lang="pt-br">Regra de Wagoner</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वैगनर नियम</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">瓦格纳规则</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Regla Wagoner</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ワゴナー・ルール</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Règle de Wagoner</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כלל וגונר</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Regla Wagoner</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Wagoner Rule</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wagoner-Regel</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Wagoner Rule</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N00be19f903c94df5a4dd6a1316d42f62"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:subClassOf rdf:nodeID="N68945aa7aeaa4920ad1c4a19fdad3465"/>
    <rdfs:subClassOf rdf:nodeID="Ne0a99857e3e1462888eb6327b491cc4e"/>
    <skos:definition>The Wagoner Rule is a legal defense in civil litigation that prevents a trustee from suing third-party professionals for damages caused by the trustee's own misconduct.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RFXc2NtinmfJhHDBnbVgVN">
    <skos:definition>Provisional Remedies are temporary legal measures sought by a party in a civil matter to preserve the status quo or prevent irreparable harm until a final decision is made.</skos:definition>
    <skos:altLabel xml:lang="en-gb">Provisional Remedies</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Medidas Provisionales</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">remédios provisórios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अस्थायी उपाय</skos:altLabel>
    <skos:altLabel xml:lang="de-de">vorläufige Maßnahmen</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">仮処分</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">mesures provisoires</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Medidas Provisionales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">临时救济措施</skos:altLabel>
    <skos:altLabel xml:lang="he-il">צווי מתקן זמני</skos:altLabel>
    <rdfs:label>Provisional Remedies</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
  </rdf:Description>
