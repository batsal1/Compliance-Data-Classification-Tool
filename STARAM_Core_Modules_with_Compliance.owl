  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBxGUw3MJVJVdwE6vZ77CbP">
    <skos:altLabel xml:lang="de-de">Internationale Datenübertragungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अंतरराष्ट्रीय डेटा ट्रांसफर क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף העברת נתונים בינלאומי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Transferencia Internacional de Datos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">国际数据转移条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Transferencia Internacional de Datos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Transferência Internacional de Dados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">International Data Transfer Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">国際データ転送条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de transfert de données internationales</skos:altLabel>
    <rdfs:label>International Data Transfer Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An International Data Transfer Clause is a provision in a contract that governs the transfer of personal data across international borders.</skos:definition>
  </rdf:Description>
