  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCv1mXvS4wBS00uefnLb5hm">
    <rdfs:label>State-Provided Public Benefit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3fTefpnCuP3Hxdj2ZPXFh"/>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <skos:definition>State-provided public benefit refers to assistance programs that are administered and funded at the state or provincial level. These can include state-specific healthcare programs, housing assistance, and educational grants.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne5d22f468de4473187e365dc223d9170">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasStandardClause"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#UseOfProceeds"/>
