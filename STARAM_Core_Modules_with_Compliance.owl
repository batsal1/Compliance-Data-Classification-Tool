    <skos:altLabel xml:lang="es-mx">Práctica Preprocesal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">事前手続き</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica Preprocesal</skos:altLabel>
    <rdfs:label>Pretrial Practice</rdfs:label>
    <skos:definition>Pretrial Practice refers to the legal work and procedures that take place before a trial, including but not limited to motions, pleadings, and discovery.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgzWJQz52CrObfGXDKH1t7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
