    <rdfs:label>Colleges, Universities, and Professional Schools Industry</rdfs:label>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-EDU-COLU</ns2:legacyIdentifier>
    <skos:altLabel xml:lang="en-gb">Colleges, Universities, and Professional Schools Industry</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कॉलेज, विश्वविद्यालय और पेशेवर स्कूल उद्योग</skos:altLabel>
    <skos:altLabel>Colleges, Universities, and Professional Schools</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית מכללות, אוניברסיטאות ובתי ספר מקצועיים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de Colegios, Universidades y Escuelas Profesionales</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de Colegios, Universidades y Escuelas Profesionales</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:hiddenLabel>COLU</skos:hiddenLabel>
    <skos:prefLabel>Colleges, Universities, and Professional Schools Industry</skos:prefLabel>
    <dc:identifier>EDU-COLU</dc:identifier>
    <dc:identifier>IN-INDUSTRY-7.2</dc:identifier>
    <skos:definition>Colleges, universities, and professional schools furnishing academic courses and granting academic degrees. The requirement for admission is at least a high school diploma or equivalent general academic training.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7IaNyshrHiqug0LlmK6J2"/>
  </rdf:Description>
