    <skos:altLabel xml:lang="de-de">Verstoß gegen die Finanzierung von Wahlkampagnen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת מימון מסעות מבצעים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Campaign Finance Violation</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de financiamento de campanha</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">竞选资金违规行为</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अभियान वित्त उल्लंघन</skos:altLabel>
