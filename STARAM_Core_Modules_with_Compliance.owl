  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R3XhsEnunIrdi5MYNdLqGL">
    <rdfs:subClassOf rdf:nodeID="Nfd501a8cc3f9462f85e63a722ba9c02f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <rdfs:subClassOf rdf:nodeID="N09291c1f0eae40ae9e60de5bf3825a53"/>
    <rdfs:subClassOf rdf:nodeID="N6d0467a75d7643daa9ec165add196945"/>
    <skos:definition>Children's rights are the legal and moral entitlements specifically aimed at the protection and welfare of minors. These rights may include, but are not limited to, the right to education, healthcare, protection from abuse and exploitation, and participation in family and cultural life, often upheld by international law such as the United Nations Convention on the Rights of the Child.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Rights of the Child</skos:prefLabel>
    <rdfs:label>Children's Rights</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Zr9gsyON1Ie92OHPq0AQj">
    <skos:altLabel xml:lang="fr-fr">Répression du locataire</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">टेनेंसी प्रतिशोध</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Mietervergeltung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Represalia de arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃貸報復</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租赁报复</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Tenancy Retaliation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נקמת חזקת דיור</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Retaliação de locação</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Represalia de arrendamiento</skos:altLabel>
    <rdfs:label>Tenancy Retaliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The act of a landlord seeking revenge against a tenant for exercising their legal rights, such as complaining about unsafe living conditions or requesting repairs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbba87ca311e945f0a67c8fdc54643330">
