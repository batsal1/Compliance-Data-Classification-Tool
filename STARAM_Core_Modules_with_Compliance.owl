    <skos:altLabel xml:lang="es-mx">Cláusula de firmas de contraparte</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Counterpart Signatures Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Gegenunterschriften</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de firmas de contraparte</skos:altLabel>
