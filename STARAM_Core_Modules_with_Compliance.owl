  <rdf:Description rdf:about="https://folio.openlegalstandard.org/t52Vl9l4Rpeu1FviQezxZQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=339920"/>
