    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>M&amp;A</skos:altLabel>
    <skos:definition>UTBMS Mergers and Acquisitions (M&amp;A) refers to the standardized codes used to categorize legal tasks and expenses related to the process of merging or acquiring companies, including matters such as due diligence, purchase agreements, antitrust issues, and post-closing disputes.</skos:definition>
    <rdfs:label>UTBMS Mergers and Acquisitions</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9bUktwERRfaUf6sl6H8wPB">
