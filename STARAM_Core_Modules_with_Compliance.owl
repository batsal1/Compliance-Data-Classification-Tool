  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Noco0WzoPRAfLQ1iJkI2t">
    <skos:altLabel>Arms Export Control Claim</skos:altLabel>
    <skos:altLabel>ITAR Violation Claim</skos:altLabel>
    <skos:altLabel>ITAR Claim</skos:altLabel>
    <skos:altLabel>Defense Export Violation Claim</skos:altLabel>
    <rdfs:label>International Traffic in Arms Regulations (ITAR) Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmiYQJshZzYvIsqEWLjj1x"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>International Arms Control Claim</skos:prefLabel>
    <skos:definition>An ITAR Claim arises when an individual or entity violates the International Traffic in Arms Regulations, which control the export and import of defense-related articles and services. This claim involves allegations of unauthorized export, re-export, or transfer of defense articles or technical data to foreign nationals or countries.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBSV3OcjnUsJCI5BxMcT4d2">
    <skos:altLabel>FIRPTA Claim</skos:altLabel>
    <skos:altLabel>Foreign Real Estate Investment Tax Claim</skos:altLabel>
    <skos:altLabel>Foreign Property Tax Withholding Claim</skos:altLabel>
    <skos:altLabel>FIRPTA Compliance Claim</skos:altLabel>
    <skos:altLabel>FIRPTA Violation Claim</skos:altLabel>
    <skos:definition>A Foreign Agents Registration Act (FARA) claim involves legal action taken against individuals or entities for failing to comply with the disclosure and registration requirements mandated by FARA. Such claims seek to enforce transparency and accountability regarding foreign influence on U.S. political and public processes.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:label>Foreign Investments in US Real Property Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
