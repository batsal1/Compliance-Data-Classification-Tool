    <skos:altLabel xml:lang="he-il">ייצוגים ואחריות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">陈述与保证</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Déclarations et garanties</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">表明および保証</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Representations and Warranties</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Declaraciones y Garantías</skos:altLabel>
