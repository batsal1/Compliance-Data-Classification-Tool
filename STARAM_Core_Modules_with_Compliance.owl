    <rdfs:label>L611 Preservation order</rdfs:label>
    <skos:prefLabel>L611 Preservation order</skos:prefLabel>
    <skos:definition>Activities and actions related to ensuring that data is preserved in accordance with requirements and assist with any efforts to seek relief from preservation order that may be issued by the court. Includes notice letters to other parties.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
