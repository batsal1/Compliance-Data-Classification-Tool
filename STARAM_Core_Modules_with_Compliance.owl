  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCz8lpUNOWlxcgMSwmGZguB">
    <skos:altLabel xml:lang="hi-in">जमानत या सुरक्षा की देखभाल</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pflege von Sicherheiten</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Gestion des garanties</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">抵押品或担保物的保养</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cuidado del Colateral o la Seguridad</skos:altLabel>
    <skos:altLabel xml:lang="he-il">טיפול בעמידה בפיקדון או באבטחה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cuidado com garantias ou segurança</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">担保物の管理</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Caring for Collateral or Security</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cuidado del Colateral o la Garantía</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
    <skos:definition>The concept of "Caring for Collateral or Security" refers to the legal responsibility of an agent to properly maintain and protect assets that have been pledged as security for a loan or other obligation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Caring for Collateral or Security</rdfs:label>
  </rdf:Description>
