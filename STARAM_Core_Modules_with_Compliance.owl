    <rdfs:label>Disorderly Conduct</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Breach of the Peace</skos:prefLabel>
  </rdf:Description>
