    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RBKXEdlGEMzeuinxEdRGBF5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDUh2eoTMgiwXCaceBJiMOJ">
    <skos:altLabel xml:lang="de-de">Missbrauch von Ermessen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Abuso de discricionariedade</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Abuse of Discretion</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिकार का दुरुपयोग</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">裁量権の乱用</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abuso de discrecionalidad</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שימוש בסמכות בצורה לא תקינה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Abus de pouvoir discrétionnaire</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Abuso de discreción</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">滥用裁量权</skos:altLabel>
    <skos:definition>The abuse of discretion is a legal concept that refers to a situation where a judge or other decision-maker has acted in a manner that is unreasonable, arbitrary, or capricious, and has therefore exceeded the bounds of their lawful authority.</skos:definition>
    <rdfs:label>Abuse of Discretion</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCpnqQCzeexk3k9kkbLx1Zu"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rcwn8msRtDqTFPXcgrpN7A">
    <skos:altLabel xml:lang="es-es">Dilución de la marca</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trademark Dilution</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ट्रेडमार्क दिलूटियन</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">商標の希釈</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Diluição de marca</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Dilución de la marca</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Dilution de marque</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Markenverwässerung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דילול מותג</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商标侵权</skos:altLabel>
    <skos:altLabel>Service Mark Dilution</skos:altLabel>
    <rdfs:label>Trademark Dilution</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJL4HDUmZp1VEEZ7lCwSSF"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8viNe7dpcLA9kGH5gl7YE6"/>
    <rdfs:subClassOf rdf:nodeID="N8309693ce9404012a5caab13892a0ebe"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Trademark Dilution is a legal claim that arises when a party uses a similar or identical trademark to another party's famous mark, causing a likelihood of dilution of the distinctive quality of the famous mark.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8M3SUKqCbdOWME6U1EKq7e">
    <skos:altLabel>Hybrid Debt</skos:altLabel>
    <rdfs:label>Mezzanine Loan</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Mezzanine Loan is a hybrid form of financing that combines debt and equity features, typically used in acquisitions or expansions. It is subordinated to senior debt but ranks higher than equity, often allowing lenders to convert debt into equity if the loan is not repaid on time.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
    <skos:prefLabel>Mezzanine Financing</skos:prefLabel>
  </rdf:Description>
