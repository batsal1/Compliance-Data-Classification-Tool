    <rdfs:subClassOf rdf:nodeID="Nb9bc167a61344d778978f64a74501b4b"/>
    <rdfs:label>Obligee</rdfs:label>
    <skos:definition>An obligee is the party in a legal contract or relationship who is entitled to receive a specified performance or payment from another party, known as the obligor. In various contexts such as contract law, bonds, or loans, the obligee holds the right to claim the fulfillment of the obligation set forth in the agreement.</skos:definition>
    <skos:altLabel>Promisee</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
