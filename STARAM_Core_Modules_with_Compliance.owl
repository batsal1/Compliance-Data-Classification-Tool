  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDoc5fkIs4N79QVKf9t11jt">
    <rdfs:label>Defensive Asylum</rdfs:label>
    <dc:source rdf:resource="https://help.unhcr.org/usa/applying-for-asylum/types-of-asylum/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCjaPxLpNSWz91c3fJzxweU"/>
    <skos:definition>Defensive asylum is a form of asylum claimed by individuals who are in removal proceedings before an immigration court. Unlike affirmative asylum, defensive asylum is raised as a defense against being removed from the destination country (e.g., United States) and requires the applicant to present their case before an immigration judge.</skos:definition>
  </rdf:Description>
