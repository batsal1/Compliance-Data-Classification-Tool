  <rdf:Description rdf:about="https://folio.openlegalstandard.org/g8axALSkRCuyGGQRyncFDA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=212321"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/XyZ6m8jkTemBuzuW-cAHCA"/>
    <rdfs:label>Construction Sand and Gravel Mining</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) operating commercial grade (i.e., construction) sand and gravel pits; (2) dredging for commercial grade sand and gravel; and (3) washing, screening, or otherwise preparing commercial grade sand and gravel.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
