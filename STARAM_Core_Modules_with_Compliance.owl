  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCP4jMji1Crm7iRVVtsLgwq">
    <skos:altLabel>Patent Reevaluation</skos:altLabel>
    <skos:altLabel>Patent Reassessment</skos:altLabel>
    <skos:altLabel>Patent Reexamination</skos:altLabel>
    <skos:altLabel>Patent Review</skos:altLabel>
    <skos:definition>The Patent Reexamination Process allows the U.S. Patent and Trademark Office (USPTO) to re-evaluate the validity of an existing patent based on new evidence or prior art not considered during the original examination. This process can be requested by the patent owner or a third party and aims to confirm the patent's claims or cancel them if they are found to be invalid.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3LBDAXqjURNXVGHaWXf7s"/>
    <rdfs:label>Patent Reexamination Process</rdfs:label>
  </rdf:Description>
