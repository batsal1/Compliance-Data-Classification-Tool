    <rdfs:label>JC20 Legal investigation (UK J-CODE)</rdfs:label>
    <skos:definition>Includes identification of the legal issues raised by the case facts and developing the strategy for the case.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
