    <rdfs:label>Requirements Contract Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A requirements contract clause is a provision in a contract that obligates one party to purchase goods or services exclusively from the other party for a specified period of time, based on the buyer's needs.</skos:definition>
  </rdf:Description>
