  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RvarcjDMtvkjKFA7vTQdDO">
    <skos:altLabel xml:lang="pt-br">Cláusula de penalidade por atraso no pagamento</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de penalización por pago tardío</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">遅延支払いペナルティ条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף עונש עיכוב בתשלום</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de penalización por pago tardío</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विलंबित भुगतान जुर्माना अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Verzugsstrafe</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Late Payment Penalty Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de pénalité de retard de paiement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">迟付款罚则条款</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Late Payment Penalty Clause is a provision in a contract that imposes a financial penalty on a party who fails to make a payment by the agreed-upon due date.</skos:definition>
    <rdfs:label>Late Payment Penalty Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
