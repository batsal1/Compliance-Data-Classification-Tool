    <skos:altLabel xml:lang="en-gb">Not for Distribution Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">配布禁止条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de no distribución</skos:altLabel>
