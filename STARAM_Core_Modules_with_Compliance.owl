  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RdzWa7UcCQDumRGcHcWml3">
    <skos:altLabel xml:lang="pt-br">Cláusula de subordinação de locação</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף כתיבת חוזה של כספיות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लीज क्लॉज की अधीनता</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Subordination of Lease Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租赁从属条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unterordnungsklausel im Mietvertrag</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃貸権の従属条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Subordinación de Arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de subordination de bail</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Subordinación de Arrendamiento</skos:altLabel>
    <skos:definition>A subordination of lease clause is a provision in a lease agreement that places the tenant's rights and interests below those of a third-party lender or landlord in the event of default or foreclosure.</skos:definition>
    <rdfs:label>Subordination of Lease Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RhCLmyJ9TLbnSraEygiNg"/>
  </rdf:Description>
