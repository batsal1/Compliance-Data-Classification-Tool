    <rdfs:label>Negative Pledge Agreement</rdfs:label>
    <skos:definition>A "Negative Pledge Agreement" is a contractual clause or standalone agreement where a debtor promises not to encumber assets with liens, or offer them as collateral, without the consent of a specific creditor. This agreement aims to protect the unsecured creditor's interests by limiting the debtor's ability to further secure its assets to other creditors.</skos:definition>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
