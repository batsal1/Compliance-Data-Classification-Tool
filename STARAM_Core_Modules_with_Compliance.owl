  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ROgOHUkJpQfCQ0v4X2QQgsw">
    <skos:definition>Activities and actions related to exception of both electronic and paper documents requiring special handling. Includes decryption.</skos:definition>
    <skos:prefLabel>L634 Exception handling</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
