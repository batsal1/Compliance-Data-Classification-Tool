  <rdf:Description rdf:about="https://folio.openlegalstandard.org/NxFQNeidROq0oYR7MPdqGw">
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing basic organic chemicals (except petrochemicals, industrial gases, and synthetic dyes and pigments).</skos:definition>
    <skos:example>Plasticizers (i.e., basic synthetic chemical) manufacturing</skos:example>
    <skos:example>Organo-inorganic compound manufacturing</skos:example>
    <skos:example>Cyclic intermediates made from refined petroleum or natural gas (except aromatic petrochemicals)</skos:example>
    <skos:example>Gum and wood chemicals manufacturing</skos:example>
    <skos:example>Fatty acids (e.g., margaric, oleic, stearic) manufacturing</skos:example>
    <skos:example>Carbon organic compounds, not specified elsewhere by process, manufacturing</skos:example>
    <skos:example>Silicone (except resins) manufacturing</skos:example>
    <skos:example>Synthetic sweeteners (i.e., sweetening agents) manufacturing</skos:example>
    <skos:example>Enzyme proteins (i.e., basic synthetic chemicals) (except pharmaceutical use) manufacturing</skos:example>
    <skos:example>Biodiesel fuels not made in petroleum refineries and not blended with petroleum</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/7uYrSNWeQ9uARs2ln1C_kA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32519"/>
    <rdfs:label>Other Basic Organic Chemical Manufacturing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/fkIgwd23Rcmt4BfxVH3o-Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Hogs merchant wholesalers</skos:example>
    <skos:example>Goats merchant wholesalers</skos:example>
    <skos:example>Cattle merchant wholesalers</skos:example>
    <skos:example>Sheep merchant wholesalers</skos:example>
    <rdfs:label>Livestock Merchant Wholesalers</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=424520"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/wh1GF23PR7qImOqZ55-YoQ"/>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of livestock (except horses and mules).</skos:definition>
  </rdf:Description>
