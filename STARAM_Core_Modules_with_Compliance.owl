    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9EU57yyGYQyG3GeOJ1VgMr"/>
    <rdfs:label>Investor Advisory Services</rdfs:label>
    <skos:definition>Investor Advisory Services: A type of consulting and management service that provides advice and guidance to investors on financial matters.</skos:definition>
