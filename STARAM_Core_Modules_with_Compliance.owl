    <rdfs:label>Utility Patent Registration</rdfs:label>
    <skos:altLabel xml:lang="de-de">Registrierung eines Gebrauchsmusters</skos:altLabel>
    <skos:altLabel xml:lang="he-il">רישום פטנט ייעודי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">実用新案特許登録</skos:altLabel>
