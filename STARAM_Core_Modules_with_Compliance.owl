  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBxR7hcvIRuO4hydhUq8Plm">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <skos:altLabel xml:lang="zh-cn">信托权力下银行不当行为</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Mala conducta bancaria al confiar en el poder notarial</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Bankfehlverhalten bei Nutzung einer Vollmacht</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Mauvaise conduite de la banque lors de l'utilisation d'une procuration</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bank Misconduct When Relying on Power of Attorney</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Má conduta bancária ao confiar em procuração</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">委任状に頼る際の銀行の不正行為</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Mala conducta bancaria al confiar en el poder de representación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बैंक दोष जब पावर ऑफ अटॉर्नी पर भरोसा करते हैं</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פשע בנקאי כאשר מסתמכים על כוח הממונה</skos:altLabel>
    <rdfs:label>Bank Misconduct When Relying on Power of Attorney</rdfs:label>
    <skos:definition>Bank Misconduct When Relying on Power of Attorney: The wrongful or illegal actions taken by a bank when it relies on a power of attorney granted by a customer to conduct transactions on their behalf, often resulting in harm or loss to the customer.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
