    <skos:definition>Procedural rules governing arbitrations in JAMS (Judicial Arbitration and Mediation Services).</skos:definition>
    <rdfs:label>JAMS International Arbitration Rules</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xVj14htMg08Ph5XqOUdbf"/>
