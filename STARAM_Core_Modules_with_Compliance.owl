  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RfwjIqLfrhhnCE2TsmLCeR">
    <skos:altLabel xml:lang="en-gb">Consolidated Omnibus Budget Reconciliation Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Consolidación de Presupuesto Omnibus de Conciliación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">根据《综合预算和协调法案》提出的索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">総合予算調整法に基づく請求</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק הסיכום המאוחד לתקציבי אומניבוס</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de acordo com a Lei de Reconciliação Orçamentária Consolidada Omnibus</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Conciliación Consolidada de Presupuesto Omnibus</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch gemäß dem Gesetz zur Konsolidierung der Haushaltsmittel und zur Rechtschreibung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation en vertu de la loi sur la réconciliation budgétaire consolidée Omnibus</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संयुक्त ओमनिबस बजट समन्वय अधिनियम दावा</skos:altLabel>
    <skos:altLabel>COBRA Claim</skos:altLabel>
    <rdfs:label>Consolidated Omnibus Budget Reconciliation Act Claim</rdfs:label>
    <skos:definition>A COBRA claim is a legal action initiated by a former employee against their former employer for not complying with the U.S. law called the Consolidated Omnibus Budget Reconciliation Act (COBRA). COBRA requires employers with 20 or more employees to offer certain terminated employees and their eligible dependents the opportunity to continue their group health insurance coverage for a limited time after their employment ends. The claim typically arises when an employer does not comply with applicable COBRA requirements, which can result in the loss of health insurance coverage for the affected individual and their dependents. Employers can face liability for violating COBRA, which can result in significant damages for the affected individual.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8TmxqBbWaNgdm0lJQdY6D4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na42e3fef92e54c5aacb7f5494ba93f86">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Termination"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/JEAc8mhWQ5-29LwhQpMcDQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=2381"/>
    <rdfs:label>Foundation, Structure, and Building Exterior Contractors</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/pghJQ5LtTs2mdrNX0Qlf2Q"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry group comprises establishments primarily engaged in the specialty trades needed to complete the basic structure (i.e., foundation, frame, and shell) of buildings. The work performed may include new work, additions, alterations, maintenance, and repairs.</skos:definition>
  </rdf:Description>
