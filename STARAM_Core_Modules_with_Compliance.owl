  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9BdovRK3PPCHYuYSJXadkJ">
    <skos:altLabel xml:lang="es-es">Privilegio de Confidencialidad Abogado-Cliente</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פרטיות עו"ד-לקוח</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">律师-客户特权</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Secret professionnel avocat-client</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">弁護士・クライアント特権</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio advogado-cliente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio Abogado-Cliente</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वकील-ग्राहक विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anwaltsgeheimnis</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Attorney-Client Privilege</skos:altLabel>
    <skos:definition>The Attorney-Client Privilege is a legal concept that protects the confidentiality of communications between an attorney and their client, and prevents those communications from being disclosed without the client's consent.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
    <rdfs:label>Attorney-Client Privilege</rdfs:label>
  </rdf:Description>
