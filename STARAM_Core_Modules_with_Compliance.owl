  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBu4G0fGR03P9qzzvvp00tK">
    <rdfs:label>Firm Of Counsel</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="fr-fr">Cabinet de conseil</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">顾问律师事务所</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">काउंसल कंपनी</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beraterkanzlei</skos:altLabel>
    <skos:altLabel xml:lang="he-il">משרד עו"ד מייעץ</skos:altLabel>
    <skos:altLabel xml:lang="he-il">משרד עו"ד יועץ</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Firm Of Counsel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Firma de Abogados Consultores</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Escritório de consultoria</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">顧問弁護士事務所</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Firma de Abogados Asesores</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RcTA2iQmrtqOnX3WrjJIp8"/>
    <rdfs:subClassOf rdf:nodeID="N827d80566c4b46edacaf6f778307ee7f"/>
    <skos:definition>A "Firm Of Counsel" is a type of lawyer who is affiliated with a law firm and provides legal advice and services to the firm's clients on a regular basis, but is not an employee or partner of the firm.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0qklfbrglijOsQolSCenX">
    <skos:altLabel xml:lang="zh-cn">不退款条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ללא החזר כספי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de No Reembolso</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel ohne Rückerstattung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">返金なし条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de No Reembolso</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कोई धनवापसी अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de não reembolso</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-remboursement</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Refunds Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>No Refunds Clause</rdfs:label>
    <skos:definition>A "No Refunds Clause" is a provision in a contract that states that the party receiving payment will not be required to refund any money paid, even if the goods or services provided are defective or unsatisfactory.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDR8hWYIaoudg2qZmCbzto6">
    <skos:altLabel xml:lang="en-gb">Breach of Employment Contract</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation du contrat de travail</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反雇佣合同</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de contrato laboral</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verstoß gegen den Arbeitsvertrag</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato de trabajo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रोजगार अनुबंध का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação do contrato de trabalho</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">雇用契約違反</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוזה עסקה עובדת</skos:altLabel>
    <rdfs:label>Breach of Employment Contract</rdfs:label>
    <skos:definition>The Breach of Employment Contract is a violation of the terms and conditions agreed upon by an employer and employee, resulting in legal claims and potential damages.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC2fjcpsEbrVvVymvt4oASx"/>
    <rdfs:subClassOf rdf:nodeID="N22a8c4d0ec764702821ac920d1546127"/>
    <rdfs:subClassOf rdf:nodeID="Nb781a4cb39a440aa8041884f69c1a1ad"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCNNEdIIOOF1LVzwErTn8yq">
    <skos:altLabel xml:lang="he-il">הטרדה בעבודה על סמך מאפיינים מוגנים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保護された特徴に基づく雇用におけるハラスメント</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Harcèlement en milieu professionnel fondé sur des caractéristiques protégées</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beschäftigungsmobbing aufgrund geschützter Merkmale</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acoso laboral basado en características protegidas</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acoso laboral basado en características protegidas</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Assédio no emprego com base em características protegidas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Employment Harassment Based on Protected Characteristics</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संरक्षित विशेषताओं पर आधारित रोजगार उत्पीड़न</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">基于受保护特征的就业骚扰</skos:altLabel>
    <skos:definition>Employment Harassment Based on Protected Characteristics refers to the mistreatment of an employee by a colleague or superior in the workplace due to their membership in a protected class, such as race, gender, or religion.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwadSStLIBnmEe8euTpNYP"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Employment Harassment Based on Protected Characteristics</rdfs:label>
  </rdf:Description>
