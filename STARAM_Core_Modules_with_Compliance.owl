    <rdfs:subClassOf rdf:nodeID="Na0b9e86f343543f9a93c06706d2e9e5a"/>
    <rdfs:label>Liability Auto Insurance Coverage Policy</rdfs:label>
    <skos:prefLabel>Liability Coverage</skos:prefLabel>
    <skos:definition>Liability auto insurance provides coverage for bodily injury and property damage inflicted on others in an accident for which the insured is at fault. It does not cover damages to the insured's own vehicle or medical expenses for the insured. This type of coverage is generally mandatory in most U.S. states.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
