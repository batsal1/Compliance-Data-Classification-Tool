  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4YBBDxkx2m0Iy4bgKxjz1">
    <rdfs:label>Child Abuse Claim</rdfs:label>
    <skos:altLabel xml:lang="pt-br">Alegação de abuso infantil</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Child Abuse Claim</skos:altLabel>
    <skos:altLabel>Dependent Abuse Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על התעללות בילדים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बाल शोषण दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">儿童虐待指控</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accusation de maltraitance infantile</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">児童虐待の申し立て</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kindesmissbrauchsanzeige</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de abuso infantil</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de abuso infantil</skos:altLabel>
    <skos:definition>A Child Abuse Claim is a legal action brought by a child or their representative alleging physical, emotional, or sexual abuse by a parent or caregiver.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R61UyUqeNOLAfN2d33tibl"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/JkXnfJVlT1ahaU-seTZXpw">
    <skos:definition>This industry comprises establishments primarily engaged in (1) smelting ores into nonferrous metals and/or (2) the primary refining of nonferrous metals (except aluminum) by electrolytic methods or other processes.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/JI7GK6c7Q-uDS3y59ggWhg"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=331410"/>
    <rdfs:label>Nonferrous Metal (except Aluminum) Smelting and Refining</rdfs:label>
