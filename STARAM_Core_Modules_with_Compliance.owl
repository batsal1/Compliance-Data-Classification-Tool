    <skos:example>Broadcasting networks, radio</skos:example>
    <skos:example>Stand-alone streaming services</skos:example>
    <skos:example>Wiki sites, Internet</skos:example>
    <skos:example>Satellite radio networks</skos:example>
    <skos:example>Cable television networks</skos:example>
    <skos:example>Subscription Video on Demand (SVOD) services</skos:example>
    <skos:example>Pay-per-view cable programming</skos:example>
    <skos:example>Web broadcasting</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
