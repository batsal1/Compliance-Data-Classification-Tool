  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RgBq3kUkMfNYtUi93XIh0i">
    <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Lenguaje Relacional</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - Relational Language</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition eines wesentlichen nachteiligen Effekts - Relationale Sprache</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Lenguaje Relacional</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Linguagem Relacional</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition d'un effet défavorable important - Langage relationnel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義 - 関係言語</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - संबंधी भाषा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">重大不利影响定义 - 关系语言</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת השפעה שלילית חומרית - שפת יחסים</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsHuW5MLfrGGruc6e9rJZC"/>
    <dc:source>ABA Deal Points Study</dc:source>
    <rdfs:label>Material Adverse Effect Definition - Relational Language</rdfs:label>
    <rdfs:label>Material Adverse Effect Definition - Exceptions Language</rdfs:label>
    <skos:definition>Material Adverse Effect (MAE) is a term used in legal agreements to describe a significant negative change or event that could affect the value or operations of a company or asset.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
