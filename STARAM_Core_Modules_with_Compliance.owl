    <rdfs:label>Reinsurance Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Reinsurance Agreement is a contract where an insurer transfers a portion of its risks to another insurer, known as the reinsurer. This helps the primary insurer manage its risk exposure and maintain solvency by spreading potential large losses.</skos:definition>
  </rdf:Description>
