    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskHead"/>
    <rdfs:subClassOf rdf:nodeID="N96363c9606e94f4288b5c110f6b193e7"/>
    <rdfs:subClassOf rdf:nodeID="N5520f61e01ba413fb71b46066d5d8d10"/>
    <rdfs:subClassOf rdf:nodeID="Nd08d17c5450d4028a22ca98ab33e2c7e"/>
    <skos:prefLabel xml:lang="en">GCC-STC Direct Conflict</skos:prefLabel>
    <rdfs:label xml:lang="en">GCC-STC Direct Conflict</rdfs:label>
    <skos:notation>RH-002</skos:notation>
    <ns5:classificationMethod xml:lang="en">Category and serial number were taken directly from the source register. Drafting defect type, project phase and impact type were assigned automatically using keyword rules applied to the risk head name and its category.</ns5:classificationMethod>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="https://staram.in/ontology/epc/register"/>
    <skos:scopeNote xml:lang="en">Relational risk head: assess it by comparing document components using epc:conflictsWith, epc:amends and epc:crossReferences, not by reviewing a single clause in isolation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBn6qsJVbVCoZz6nipy4RTO">
    <skos:definition>A claim for falling on ice and snow is a legal action brought by a plaintiff who has suffered injuries due to slipping and falling on ice or snow, and seeks compensation for damages from the defendant who may be held liable for negligence.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3"/>
    <skos:altLabel xml:lang="es-es">Reclamación por caída en hielo y nieve</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Sturz auf Eis und Schnee</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">滑冰和雪上摔倒索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על נפילה על קרח ושלג</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Claim for Falling on Ice and Snow</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">氷や雪で転倒した場合の請求</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por caída en hielo y nieve</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बर्फ और बर्फ़ानी में गिरने के लिए दावा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação por queda em gelo e neve</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour chute sur glace et neige</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Claim for Falling on Ice and Snow</rdfs:label>
  </rdf:Description>
