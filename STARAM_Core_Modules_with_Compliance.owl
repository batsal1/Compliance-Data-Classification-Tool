  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Zs8I3vHrRlaD-WjbU5sJxQ">
    <rdfs:label>Seafood Product Preparation and Packaging</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311710"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) canning seafood (including soup); (2) smoking, salting, and drying seafood; (3) eviscerating fresh fish by removing heads, fins, scales, bones, and entrails; (4) shucking and packing fresh shellfish; (5) processing marine fats and oils; and (6) freezing seafood. Establishments known as "floating factory ships" that are engaged in the gathering and processing of seafood into canned seafood products are included in this industry.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/F5xTOBBAS1esbxW9utsBng"/>
  </rdf:Description>
