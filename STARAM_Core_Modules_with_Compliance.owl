  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTyoF6vOGn0G3py0iRkxN5">
    <rdfs:label>Number of Employees</rdfs:label>
    <skos:definition>Number of Employees refers to the total count of individuals employed by a business or organization, either on a full-time or part-time basis. This metric is often used for various purposes including business valuation, eligibility for certain benefits or programs, and as an indicator of company size and capacity.</skos:definition>
    <skos:prefLabel>Workforce Size</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nREeU6lB0zs0dt9N339nm"/>
  </rdf:Description>
