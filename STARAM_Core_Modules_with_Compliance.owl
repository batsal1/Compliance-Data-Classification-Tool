  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCEchldQJ7ND4j4ohefIlEg">
    <skos:altLabel xml:lang="he-il">אכיפת שמירה זמנית</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Custódia temporária</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Custodia Temporal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">一時的な保護</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अस्थायी हिरासत</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">临时监护</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vorläufige Obhut</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Temporary Custody</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Custodia Temporal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Garde temporaire</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCQJU54O6qCvotCfmDwYZwj"/>
    <skos:definition>Temporary Custody refers to the legal arrangement where a child is placed in the care of a guardian or custodian for a limited period of time, typically during the pendency of a matrimonial emergency application filed by the parents.</skos:definition>
    <skos:prefLabel>Temporary Custody</skos:prefLabel>
    <rdfs:label>Temporary Child Custody</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R98qBptLYsim7eproGLF6q6">
    <skos:altLabel xml:lang="es-mx">Metodología de tarifas del Fondo Común</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Common Fund Fee Methodology</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Metodologia de taxa de fundo comum</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同基金手数料の方法論</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Méthodologie des frais de fonds communs</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Methodik der gemeinsamen Fondsgebühr</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Metodología de tarifas del Fondo Común</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कॉमन फंड फी मेथडोलॉजी</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מתודולוגיית עמלות קרן משותפת</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">共同基金费用方法论</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Common Fund Fee Methodology is a method used by attorneys to calculate their fees in class action lawsuits, where the fees are based on a percentage of the total amount recovered for the class.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlDwAh4h0X7Sosy5SLccvX"/>
    <rdfs:label>Common Fund Fee Methodology</rdfs:label>
  </rdf:Description>
