    <skos:altLabel xml:lang="he-il">תעשיית ייצור רכבות וציוד רכבתי</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Railway Rolling Stock Manufacturing Industry</skos:altLabel>
    <skos:altLabel>Railroad Rolling Stock Manufacturing</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie de fabrication de matériel roulant ferroviaire</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रेलवे रोलिंग स्टॉक निर्माण उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de Fabricación de Material Rodante Ferroviario</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">铁路机车车辆制造业</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de Fabricación de Material Rodante Ferroviario</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-MFG-TRMF-RAIM</ns2:legacyIdentifier>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing and/or rebuilding locomotives, locomotive frames and parts; (2) manufacturing railroad, street, and rapid transit cars and car equipment for operation on rails for freight and passenger service; and (3) manufacturing rail layers, ballast distributors, rail tamping equipment and other railway track maintenance equipment.</skos:definition>
    <dc:identifier>MFG-TRMF-RAIM</dc:identifier>
    <dc:identifier>IN-INDUSTRY-12.20.3</dc:identifier>
    <rdfs:label>Railroad Rolling Stock Manufacturing Industry</rdfs:label>
    <skos:prefLabel>Railroad Rolling Stock Manufacturing Industry</skos:prefLabel>
    <skos:hiddenLabel>RAIM</skos:hiddenLabel>
  </rdf:Description>
