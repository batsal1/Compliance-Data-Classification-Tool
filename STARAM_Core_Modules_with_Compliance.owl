  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8hj0gAqtwU7U7DZCh2kEFy">
    <skos:altLabel xml:lang="es-mx">Cláusula de advertencia de plomo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Blei-Warnung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'avertissement au plomb</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de advertencia de plomo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लेड चेतावनी वाक्यांश क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הזהרת עופרת</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">鉛警告声明条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lead Warning Statement Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">铅警告声明条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Aviso de Chumbo</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Lead Warning Statement Clause is a provision in a contract that requires the disclosure of the presence of lead in a product or property, in order to protect individuals from potential health hazards.</skos:definition>
    <rdfs:label>Lead Warning Statement Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDkxy1u3kzfwPuVV7mW0nv7">
    <skos:altLabel xml:lang="es-es">Reclamación de la Ley de Abogados Generales Privados</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Procuradores Gerais Privados</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de la Ley de Abogados Generales Privados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Private Attorneys General Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निजी वकील महानियांकन अधिनियम दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">私人检察官法案索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Action en vertu de la loi sur les procureurs généraux privés</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">プライベート・アトーニーゼネラル法クレーム</skos:altLabel>
    <skos:altLabel>PAGA Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק עורכי דין כלליים פרטיים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klage nach dem Gesetz über private Staatsanwälte</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <rdfs:label>Private Attorneys General Act Claim</rdfs:label>
    <skos:definition>The Private Attorneys General Act (PAGA) is a California law that allows employees to bring claims on behalf of the state against their employers for labor code violations. By acting as private attorneys general, employees can seek penalties for themselves and their co-workers, thereby helping to enforce labor laws when government agencies may lack the resources to do so.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#TermShares">
    <skos:exactMatch rdf:resource="https://folio.openlegalstandard.org/RBnws1cVX4kf2XpFVgfZA1c"/>
