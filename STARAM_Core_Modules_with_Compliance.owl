    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing fluid power (i.e., hydraulic and pneumatic) cylinders and actuators.</skos:definition>
    <rdfs:label>Fluid Power Cylinder and Actuator Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333995"/>
