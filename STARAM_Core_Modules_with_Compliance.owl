    <skos:altLabel xml:lang="hi-in">डीड रोक प्रतिबंध बंदी</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de restricción de escritura</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de restricción de escritura</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">契约限制条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הגבלת כתב</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Deed Restriction Clause</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Deed Restriction Clause</rdfs:label>
    <skos:definition>A deed restriction clause is a provision in a contract that limits the use or development of a property, typically in order to maintain certain standards or preserve certain rights.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Xjkk7EkIgiSA3LmsPofVx">
    <rdfs:subClassOf rdf:nodeID="Nb51d28ec7613494b81de6b3da2da6a92"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <rdfs:subClassOf rdf:nodeID="Nd75295ab7aea46b39ab3af9aae92b0c3"/>
    <rdfs:subClassOf rdf:nodeID="N245dfe76581645f48cb240215b7479a0"/>
    <skos:altLabel xml:lang="fr-fr">Jeu illégal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Juego ilegal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הימורים בלתי חוקיים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Illegales Glücksspiel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवैध जुआ</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">違法賭博</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Juego ilegal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Illegal Gambling</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jogo ilegal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非法赌博</skos:altLabel>
    <skos:prefLabel>Gambling</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>To unlawfully bet or wager money or something else of value; assist, promote, or operate a game of chance for money or some other stake; possess or transmit wagering information; manufacture, sell, purchase, possess, or transport gambling equipment, devices or goods; or tamper with the outcome of a sporting event or contest to gain a gambling advantage.</skos:definition>
    <rdfs:label>Illegal Gambling</rdfs:label>
  </rdf:Description>
