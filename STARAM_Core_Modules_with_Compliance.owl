  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7JKVOM2aFkvG1yiLzF7ndA">
    <skos:altLabel xml:lang="hi-in">अपमान</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Defamation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגיעה במוניטין</skos:altLabel>
