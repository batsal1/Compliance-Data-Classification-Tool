    <skos:altLabel xml:lang="es-es">Desfiguración</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विकृति</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défiguration</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Disfigurement</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Desfiguração</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">毁容</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Desfiguración</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Entstellung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגיעה במראה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">顔面の傷跡</skos:altLabel>
    <skos:definition>Disfigurement refers to a physical impairment or alteration of a person's appearance resulting from an injury or accident, which may lead to emotional distress and loss of self-esteem.</skos:definition>
    <rdfs:label>Disfigurement</rdfs:label>
  </rdf:Description>
