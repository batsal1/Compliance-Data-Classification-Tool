    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBZL31YCqZA1E1vlIkzRRqw"/>
    <rdfs:label>tax_type</rdfs:label>
    <skos:definition>"Type of tax.  Based on a value specified by the client.  Examples in US: ""Federal"", ""State"", ""Local"".  Examples in Canada: ""GST"", ""HST"", ""PST"", ""TVQ"".
"</skos:definition>
  </rdf:Description>
