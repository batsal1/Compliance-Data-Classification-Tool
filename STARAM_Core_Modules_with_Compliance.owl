    <skos:altLabel xml:lang="he-il">זיוף</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faux</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falsificación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fälschung</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdfs:label>Forgery</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Na4689d8a3bdb460a9002876be0722c71"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFjY2mO804t9gJNy5Dn4P1"/>
    <skos:definition>(Definition of "Counterfeiting/Forgery") The altering, copying, or imitation of something, without authority or right, with the intent to deceive or defraud by passing the copy or thing altered or imitated as that which is original or genuine; or the selling, buying, or possession of an altered, copied, or imitated thing with the intent to deceive or defraud.</skos:definition>
  </rdf:Description>
