  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9HPub0PMW2GODvjQ2PttbM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Ndfe05da23e8c44a8aa35066b22b2d94b"/>
    <rdfs:subClassOf rdf:nodeID="Nd83a1808b8644ffda04d912e3139cfcc"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8cjnXHiv1wNe6nzPvWnhQw"/>
    <skos:definition>A Leasehold is an estate in real property where a lessee is granted the exclusive right to occupy and use a property for a predetermined period, typically in exchange for rent or other consideration. Unlike fee simple ownership, leasehold interests are temporary and revert back to the lessor at the end of the lease term</skos:definition>
    <rdfs:label>Leasehold Estate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5fcbf696fac84554b2315afd2dbccdb4">
