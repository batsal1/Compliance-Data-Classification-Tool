  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDfVOYip9VRmSX7YTmktPR">
    <skos:definition>A Subject Person Clause is a clause in a contract that identifies a specific individual or group of individuals who will be affected by the terms of the contract.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Personenbezogene Klausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de pessoa sujeita</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de persona sujeta</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">主体者条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de personne concernée</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אדם נושא</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de persona sujeta</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Subject Person Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विषय व्यक्ति शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">主体人条款</skos:altLabel>
    <rdfs:label>Subject Person Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7gqzji2c0gwIGnyAeJE8UV">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDrxLQS4WPXUa6tUdBGdu2r"/>
    <rdfs:label>Analysis of Utilities Considerations</rdfs:label>
    <skos:altLabel xml:lang="es-mx">Análisis de consideraciones de servicios públicos</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Análisis de consideraciones de servicios públicos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公益事業の考慮分析</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ניתוח של שיקוליות של תועלות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपयोगिता विचारों का विश्लेषण</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Analyse des considérations relatives aux services publics</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Análise das Considerações de Utilidades</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公用事业考虑分析</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Analysis of Utilities Considerations</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Analyse der Versorgungsunternehmen-Betrachtungen</skos:altLabel>
    <skos:definition>Analysis of Utilities Considerations refers to the evaluation and assessment of the various utility factors involved in an obligation analysis.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBnsEcCI2IYcIzlWhNi3KyD">
    <skos:altLabel xml:lang="es-mx">Revocación de la libertad bajo fianza</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">取保候审撤销</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Revogação da liberdade provisória</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ביטול שחרור עדיין לפני המשפט</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pretrial Release Revocation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保釈取り消し</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Révocation de la libération provisoire</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Revocación de la libertad provisional</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रीट्रायल रिलीज रिवोकेशन</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Aufhebung der vorläufigen Freilassung</skos:altLabel>
    <rdfs:label>Pretrial Release Revocation</rdfs:label>
    <skos:definition>The concept of Pretrial Release Revocation refers to the legal event of revoking a defendant's release from custody before trial, typically due to a violation of the conditions of their release.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBV3MQlbGLIUVo5fSiBZ2V4"/>
    <rdfs:subClassOf rdf:nodeID="N9319c0ad12be4a53a15184648d291819"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R97fVfsGrxXjdTlPquAgu6R">
    <dc:identifier>IN-LAW-18.2</dc:identifier>
    <dc:identifier>INFS-GVTA</dc:identifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7kUD6H5adQ83mCKuHjT5JD"/>
    <skos:altLabel xml:lang="de-de">Gesetz über den Zugang der Regierung und die Offenlegung von Informationen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Government Access and Disclosure Law</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">政府のアクセスと開示に関する法律</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוק גישה וחשיפה של הממשלה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ley de Acceso y Divulgación del Gobierno</skos:altLabel>
    <skos:altLabel>Government Access and Disclosure</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ley de Acceso y Divulgación del Gobierno</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">政府访问和披露法</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei de Acesso e Divulgação do Governo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सरकारी पहुंच और खुलासा विधि</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Loi sur l'accès et la divulgation gouvernementaux</skos:altLabel>
    <skos:definition>Law relating to the access and disclosure of information by a government.</skos:definition>
    <rdfs:label>Government Access and Disclosure Law</rdfs:label>
