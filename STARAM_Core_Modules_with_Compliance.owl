  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBPZYWmIkyMFJzHVKOA9JWL">
    <skos:altLabel xml:lang="de-de">Forum Non Conveniens</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פורום לא נוח</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不方便管辖原则</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">フォーラム・ノン・コンビニエンス</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फोरम नॉन कनवीनियंस</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Foro de Inconveniencia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Forum Non Conveniens</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Forum Non Conveniens</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Forum Non Conveniens</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Foro de Inconveniencia</skos:altLabel>
    <skos:definition>A legal doctrine that allows a court to dismiss a case if it determines that another court, with jurisdiction over the case, is a more appropriate forum for the case to be heard.</skos:definition>
    <rdfs:label>Forum Non Conveniens</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5u9wTR86QD4UfWi91OTra"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RjQP37RLKtTQzjd7UbRKcQ">
    <skos:altLabel xml:lang="ja-jp">米国第7章破産</skos:altLabel>
    <skos:altLabel>US Chapter 7</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוקי הבנקרות של ארה״ב פרק 7</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">US Chapter 7 Bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falência americana do Capítulo 7</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faillite américaine de chapitre 7</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Quiebra del Capítulo 7 de los Estados Unidos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">US-Insolvenzverfahren nach Kapitel 7</skos:altLabel>
    <skos:altLabel>Chapter 7</skos:altLabel>
    <skos:altLabel>Liquidation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यूएस चैप्टर 7 दिवाली</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Quiebra del Capítulo 7 de Estados Unidos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">美国第七章破产</skos:altLabel>
    <skos:definition>Chapter 7 bankruptcy, sometimes referred to as liquidation bankruptcy, is the most common type of bankruptcy in the U.S., and the most basic form of bankruptcy. Chapter 7 provides liquidation of an individual's property and then distributes it to creditors.</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Proc-B-USCHAP7</ns2:legacyIdentifier>
    <rdfs:label>US Chapter 7 Bankruptcy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N54f8e4f5675e4440b5635d2168b9071e"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkqKed1jktjgwaeiLc7ru"/>
    <dc:identifier>B-USCHAP7</dc:identifier>
    <skos:hiddenLabel>USCHAP7</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/8ePkLK-8SyaGYDyGAnGHoQ">
    <rdfs:label>Poured Concrete Foundation and Structure Contractors</rdfs:label>
    <skos:example>Footing and foundation concrete contractors</skos:example>
    <skos:example>Gunite contractors</skos:example>
    <skos:example>Mud-jacking contractors</skos:example>
    <skos:example>Concrete pumping (i.e., placement)</skos:example>
    <skos:example>Concrete work (except paving)</skos:example>
    <skos:example>Shotcrete contractors</skos:example>
    <skos:example>Concrete pouring and finishing</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=238110"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/x3cnl5kORAOBfJgR37P19Q"/>
    <skos:definition>This industry comprises establishments primarily engaged in pouring and finishing concrete foundations and structural elements. This industry also includes establishments performing grout and shotcrete work. The work performed may include new work, additions, alterations, maintenance, and repairs.</skos:definition>
  </rdf:Description>
