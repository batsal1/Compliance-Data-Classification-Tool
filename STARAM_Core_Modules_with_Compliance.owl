  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQ0TQRZKlDOogaFb20BIuK">
    <skos:prefLabel>Redeemable Security</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Redeemable Instrument</skos:altLabel>
    <skos:altLabel>A Redeemable Asset is a financial instrument that can be bought back or redeemed by the issuer or the holder under predefined conditions. This option provides flexibility and liquidity to the asset, allowing for its retirement before the maturity date or upon reaching specific terms.</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
    <rdfs:label>Redeemable Asset</rdfs:label>
  </rdf:Description>
