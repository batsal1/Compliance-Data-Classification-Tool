  <rdf:Description rdf:about="https://folio.openlegalstandard.org/JO9pD1pURsu08gubfQb1pw">
    <rdfs:label>Research and Development in the Physical, Engineering, and Life Sciences</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R87fr1FKikCIYwUpqvmzR0Z"/>
    <skos:definition>This industry comprises establishments primarily engaged in conducting research and experimental development in the physical, engineering, and life sciences, such as agriculture, electronics, environmental, biology, botany, biotechnology, computers, chemistry, food, fisheries, forests, geology, health, mathematics, medicine, nanotechnology, oceanography, pharmacy, physics, veterinary, and other allied subjects.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=54171"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
