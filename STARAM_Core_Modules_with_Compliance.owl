    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/IN-LAW-SUB-28-3-08774a1486">
    <dc:identifier>IN-LAW-28.3</dc:identifier>
    <skos:prefLabel>Acquisition, Requisition, Eminent Domain and Nationalisation</skos:prefLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDb8aZxNJsmCvQGbfiFyfI7"/>
    <rdfs:label>Acquisition, Requisition, Eminent Domain and Nationalisation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9D00mxrkbEo2ZeuWmb92Aw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCwdLsWxoa7TqpUv5hIYwzW"/>
    <rdfs:label>Corporate President</rdfs:label>
    <skos:definition>A Corporate President is a senior executive often responsible for overseeing the day-to-day operations of a company and implementing strategic initiatives set by the board of directors. The President often acts as the second-highest-ranking officer in a company, reporting directly to the Chief Executive Officer (CEO) or, in some cases, the board.</skos:definition>
    <skos:altLabel>President</skos:altLabel>
  </rdf:Description>
