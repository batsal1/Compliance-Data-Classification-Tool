  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Jo3gp8LjhpdJNXYE9ow95">
    <skos:altLabel xml:lang="zh-cn">重整破产</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faillite de réorganisation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">再生手続き中の破産</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sanierungsbankrott</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falência de reorganização</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdfs:subClassOf rdf:nodeID="N1c3dc5ea55b74968b7159190b2c0ed6d"/>
    <rdfs:label>Reorganization Bankruptcy</rdfs:label>
    <skos:definition>This is a process where a company, individual, or any other entity rearranges its debts in order to remain viable. The debtor typically retains their assets and continues to operate the business, while working out a plan to repay creditors over time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDD0pYyXNm3TiZN6SyX0WTt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Citator - Orange Flag</skos:prefLabel>
    <skos:altLabel xml:lang="fr-fr">Droit d'application douteuse</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">有争议的适用法律</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fraglich anwendbares Recht</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">疑問のある適用法</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei questionávelmente operativa</skos:altLabel>
    <skos:definition>The efficacy of a legal authority (e.g., judicial opinion, statute, regulation) is in doubt, usually through the action of some decisionmaker (e.g., judge, regulator, legislator), through some act (e.g., statutory codification, review of statutory constitutionality).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtSews3LsWL6xdoibt5V5R"/>
    <rdfs:label>Questionably Operative Law</rdfs:label>
  </rdf:Description>
