  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9ya2bhBlRQfwOwM8T7zhJa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Social Security Number (SSN) is a nine-digit identification number issued by the U.S. Social Security Administration. Primarily used for tracking individuals for taxation purposes, the SSN has also become a de facto national identification number used for various other legal, financial, and personal identification activities.</skos:definition>
    <skos:prefLabel>SSN</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXwl9xfFnpmQn8Ex816ROD"/>
    <rdfs:label>Social Security Number</rdfs:label>
  </rdf:Description>
