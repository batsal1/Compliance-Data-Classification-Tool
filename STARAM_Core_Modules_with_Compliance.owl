  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R81q0MYebZZv26XtzcIvVJ5">
    <skos:definition>Disability public benefit refers to government-provided financial assistance specifically aimed at individuals who are unable to work due to a disability. These benefits are designed to provide a safety net by replacing lost income or covering additional costs associated with the disability. In the United States, this can include Social Security Disability Insurance (SSDI), Social Security disability insurance, and Supplemental Security Income (SSI).</skos:definition>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
    <rdfs:subClassOf rdf:nodeID="N9fec826c5fb34627b7d7068ef0190f5b"/>
    <rdfs:subClassOf rdf:nodeID="N1d73f1891ca74be2adf469d46d57b1a6"/>
    <rdfs:label>Disability Public Benefit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RvYuKVxSvhODjfxzqHdLNn">
    <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - "Constructive Knowledge - Express Investigation" Language</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת השפעה שלילית חומרית - שפת "ידיעה בונה - חקירה מפורטת"</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - "निर्माणात्मक ज्ञान - व्यक्तिगत अनुसंधान" भाषा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Lenguaje de "Conocimiento Constructivo - Investigación Expresa"</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de l'effet indésirable matériel - Langage de la connaissance constructive - Enquête explicite</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Lenguaje de "Conocimiento Constructivo - Investigación Expresa"</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Linguagem de Conhecimento Construtivo - Investigação Expressa</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition des wesentlichen nachteiligen Effekts - Sprache des konstruktiven Wissens - Ausdrückliche Untersuchung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大な不利益影響の定義 - 建設的知識 - 明示的調査言語</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">实质性不利影响定义 - 建设性知识 - 明确调查语言</skos:altLabel>
    <rdfs:label>Material Adverse Effect Definition - "Constructive Knowledge - Express Investigation" Language</rdfs:label>
    <rdfs:label>"Constructive Knowledge - Express Investigation" Language</rdfs:label>
    <skos:definition>A Material Adverse Effect (MAE) is a negative change or event that has a significant impact on a company's financial condition or operations, and which a reasonable person would not have known about without conducting an express investigation.</skos:definition>
    <skos:definition>A negative change or event that has a significant impact on a company's financial condition or operations, and which a reasonable person would not have known about without conducting an express investigation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCrshoNA9Tc4Xswrj0v8nqX"/>
  </rdf:Description>
