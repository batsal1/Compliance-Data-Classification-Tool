  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RICbnAjD2tT1fD7oBULYPW">
    <skos:altLabel xml:lang="ja-jp">医師の過失</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">医生疏忽</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ärztliche Fahrlässigkeit</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence médicale</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Physician Negligence</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">चिकित्सक लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia médica</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת רופא</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica</skos:altLabel>
    <skos:definition>Physician Negligence refers to the failure of a medical practitioner to provide the standard of care expected of them, resulting in harm or injury to a patient.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Physician Negligence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD0eQlnhd3jz3LFSNTucGBt">
    <skos:altLabel xml:lang="hi-in">बचाने की शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de sauvegarde</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שמירה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de salvaguardia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rettungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保留条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Saving Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de salvaguardia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de salvaguarda</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">セービング条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Saving Clause</rdfs:label>
    <skos:definition>A saving clause is a clause in a contract that preserves certain rights or obligations even if other parts of the contract are found to be invalid or unenforceable.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
