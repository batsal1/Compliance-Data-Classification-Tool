    <rdfs:label>Specialized Freight (except Used Goods) Trucking, Local</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/-CxiRQ72RV-ICeqxtmUMnA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing local, specialized trucking. Local trucking establishments provide trucking within a metropolitan area that may cross state lines. Generally the trips are same-day return.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQx0RJibKX2Ds4LX0PHjU">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7YcudBFwMUS1r7BcWje7Ly"/>
    <rdfs:label>Intervening Event - Knowledge by Target Management</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">干预事件 - 目标管理知识</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Einschreitendes Ereignis - Wissensmanagement durch Zielsetzung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Événement intervenant - Gestion des connaissances par objectif</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">介入イベント - ターゲット管理による知識</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Evento Interveniente - Gerenciamento de Conhecimento por Objetivo</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An intervening event in a legal matter that involves the knowledge possessed by the target management.</skos:definition>
  </rdf:Description>
