  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDhTbfA9WACnFGtRuw8v57e">
    <skos:altLabel xml:lang="es-es">Disolución del matrimonio</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">離婚</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विवाह विघटन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פירוק נישואים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Dissolution du mariage</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Disolución del matrimonio</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dissolução do casamento</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Marriage Dissolution</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">婚姻解除</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ehescheidung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7widavYhXmyfw9WvR9ahBs"/>
    <rdfs:subClassOf rdf:nodeID="N2eeb5038f608465688cb0f66d0759ea6"/>
    <skos:prefLabel>Marriage Dissolution</skos:prefLabel>
    <rdfs:label>Divorce</rdfs:label>
    <skos:definition>The legal process of ending a marriage, either due to fault or without fault, including issues such as property division, child custody, and spousal support.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/lTBLC8rTTz2JgTTShF9vvw">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing food services (except snack and nonalcoholic beverage bars) where patrons generally order or select items and pay before eating. Food and drink may be consumed on premises, taken out, or delivered to the customer's location. Some establishments in this industry may provide these food services in combination with selling alcoholic beverages.</skos:definition>
    <skos:example>Fast casual restaurants</skos:example>
    <skos:example>Delicatessen restaurants</skos:example>
    <skos:example>Takeout eating places</skos:example>
    <skos:example>Takeout sandwich shops</skos:example>
    <skos:example>Limited-service pizza parlors</skos:example>
    <skos:example>Family restaurants, limited-service</skos:example>
    <skos:example>Pizza delivery shops</skos:example>
    <skos:example>Fast-food restaurants</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/AkoKQRJPSBauQVqI83j4iQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=722513"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Limited-Service Restaurants</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBRmBlop1vdGAw1yi4ZP2Qh">
    <skos:altLabel xml:lang="hi-in">धोखा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מרמה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">詐欺</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fraude</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Tromperie</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Engaño</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">欺骗</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Engaño</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Täuschung</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Deceit</skos:altLabel>
    <skos:definition>Deceit is a type of fraudulent claim that involves intentionally misleading or tricking someone in order to gain an advantage or cause harm.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:label>Deceit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBbmAr7UZlvBSjbTLZeA5I9">
    <skos:altLabel xml:lang="es-es">Reclamación de embargo de salario ilegal</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de penhora de salário ilegal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unlawful Wage Garnishment Claim</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非法工资扣押索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">違法な賃金差し押さえ請求</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה למחיקת שכר עבודה בלתי חוקי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf unrechtmäßige Lohnpfändung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de embargo de salario ilegal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de saisie de salaire illégale</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवैध वेतन गार्निशमेंट दावा</skos:altLabel>
    <rdfs:label>Unlawful Wage Garnishment Claim</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Na7e655237b0b4afb9b2fe73f32699e96"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB5irrjea9ZzesLNnhYPQ1D"/>
    <rdfs:subClassOf rdf:nodeID="Nfa2476d4804a46269054c56b296c6fe4"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An unlawful wage garnishment claim is a legal action initiated by an employee against their employer for not complying with the legal requirements for wage garnishment. Wage garnishment occurs when a creditor obtains a court order to deduct a portion of an employee's wages to satisfy a debt. The claim typically arises when an employer improperly withholds too much of an employee's wages or does not follow the proper legal procedures for wage garnishment, which can result in financial harm to the employee. Employers can also face liability for not protecting employees from unlawful garnishment orders.</skos:definition>
  </rdf:Description>
