  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9bkemkms5qzbbCvm5LI82V">
    <rdfs:label>House Arrest</rdfs:label>
    <skos:definition>House Arrest: A criminal penalty that requires an individual to remain confined to their residence, typically with electronic monitoring, as a substitute for imprisonment.</skos:definition>
    <skos:altLabel xml:lang="en-gb">House Arrest</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Assignation à résidence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Arresto domiciliario</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">软禁</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Arresto domiciliario</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעצר בית</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prisão domiciliar</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hausarrest</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自宅軟禁</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">घर की हिरासत</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBJKfGRN6PPuMeHLwrDvGNx">
    <skos:altLabel xml:lang="hi-in">टालने वाली कार्रवाई दावे</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de ação de evitação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">回避诉讼索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות פעולת חריגה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acciones de evitación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche aus Anfechtungsklagen</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">回避訴訟請求</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acciones de evitación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Actions en annulation</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Avoidance Action Claims</skos:altLabel>
    <rdfs:label>Avoidance Action Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
    <rdfs:subClassOf rdf:nodeID="N0fa486d2b7a14ec0826b1bd41497c70c"/>
    <skos:definition>Avoidance Action Claims refer to legal claims made in bankruptcy and restructuring cases that seek to recover property or assets that were transferred or paid out in a way that is considered fraudulent or preferential, and may include actions such as turnover of property, setoff, and avoidance of statutory liens.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RNtr2KMwM33LplYnmmxxVY">
    <skos:definition>Domestic Violence refers to physical, emotional, or sexual abuse that occurs within a domestic relationship, such as between spouses or partners, and is considered a form of criminal assault.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Violência doméstica</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Häusliche Gewalt</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Violencia Doméstica</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violence domestique</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Domestic Violence</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">घरेलू हिंसा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">家庭暴力</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אלימות במשפחה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Violencia Doméstica</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ドメスティックバイオレンス</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N9a17849219904adeb57c3351208f2696"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8BLgPtZOuKFI8MtZNTaT0u"/>
    <rdfs:label>Domestic Violence</rdfs:label>
  </rdf:Description>
