    <skos:prefLabel>Contract Termination Agreement</skos:prefLabel>
    <rdfs:label>Termination Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">General Commercial</ns1:contractFamily>
    <skos:definition>A Termination Agreement is a legal document that formally concludes a previously established contract before the original terms of the contract are fulfilled. It outlines the conditions, responsibilities, and any obligations or entitlements of the parties involved in ending the agreement.</skos:definition>
    <skos:altLabel>Cancellation Agreement</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
