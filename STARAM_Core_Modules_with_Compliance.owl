  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N33aacc1f226c46309462bb5c4b5ca94c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0TZk2qCI4HPwDl3e9FoOo"/>
    <rdfs:subClassOf rdf:nodeID="Nbc475fcb6e1d4e6882590c8e37df5c3e"/>
    <skos:definition>Civil rights are the rights of individuals to receive equal treatment and protection under the law, typically focusing on issues such as discrimination, freedom of speech, and the right to vote. These rights are enshrined in national laws and constitutions and are designed to protect individuals from unfair treatment or discrimination by the government or private organizations</skos:definition>
    <rdfs:label>Civil Rights</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rlbq3SekJ58WQwzlThYFtY">
