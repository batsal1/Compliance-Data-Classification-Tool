    <skos:altLabel xml:lang="hi-in">ट्रायल और पोस्ट-ट्रायल मोशन प्रैक्टिस</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de juicio y post-juicio de mociones</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">审判和审判后动议实践</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Prozess- und Nachprozessbewegungen</skos:altLabel>
    <skos:altLabel>Trial and Post-Trial Motion</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de juicio y post-juicio de mociones</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de movimentos de julgamento e pós-julgamento</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">裁判および裁判後の動議手続き</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique des motions de procès et post-procès</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ניהול הליך ניסיון והליך תנועה לאחר הליך ניסיון</skos:altLabel>
    <skos:altLabel>Trial and Post-Trial Motion Service</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trial and Post-Trial Motion Practice</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bs2IGOdHj0EAVOmcrj2WO"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9dd6R73IfKyiskT5Jf62R7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Trial and Post-Trial Motion Practice refers to the legal procedures and actions taken by parties after a trial has concluded, including motions for a new trial, appeals, and other post-trial motions.</skos:definition>
    <rdfs:label>Trial and Post-Trial Motion Practice</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RKsQ8wAiKiOfAtbV7KR6i1">
    <skos:altLabel xml:lang="de-de">Verstoß gegen das Gesetz gegen irreführende Werbung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不当景品類及び不当表示防止法違反</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação da Lei de Publicidade Enganosa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוק הפרסום המזויף</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Violación de la Ley de Publicidad Falsa</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">虚假广告法违规行为</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Violación de la Ley de Publicidad Falsa</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">False Advertising Act Violation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">झूठी विज्ञापन अधिनियम उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de la loi sur la publicité mensongère</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A False Advertising Act Violation is a claim that a party has made false or misleading statements in connection with the promotion or sale of a product or service, in violation of the False Advertising Act and related laws and regulations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9seb5qQstcsgRm3UE8hV5t"/>
    <rdfs:subClassOf rdf:nodeID="N00a4663617324a4386a8ef5cc4f557df"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:label>False Advertising Act Violation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8JVOGBEzEQHWl2bYk4uQam">
    <rdfs:label>Patent Assessment Process</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The patent assessment process is a systematic investigation conducted to ascertain the novelty and non-obviousness of an invention by examining existing patents and other relevant technical literature. This process is crucial for determining the likelihood of obtaining a patent and avoiding infringement of existing patents.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3LBDAXqjURNXVGHaWXf7s"/>
  </rdf:Description>
