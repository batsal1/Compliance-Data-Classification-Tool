  <rdf:Description rdf:nodeID="N6b7e08b5b20c44fd815cdaa7f0d5bf41">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/PfSj5GuQSG2Apk5yNyy8oQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
