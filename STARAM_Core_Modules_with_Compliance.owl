  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Esb4KwFEHvJv7P0b95t5p">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R723CZDeI1c9CzFdyGi58Xd"/>
    <rdfs:subClassOf rdf:nodeID="N6503c288b59f49f4a7614d57810d632b"/>
    <rdfs:subClassOf rdf:nodeID="N8ea3bb49be184528815b7ccc0caf189a"/>
