  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RcMZgiwSAaHpqXMO4nq3sU">
    <skos:altLabel xml:lang="fr-fr">Indemnisation implicite</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुमति द्वारा भरपाई</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">默示赔偿</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Implied Indemnification</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">暗黙の補償</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Indemnización implícita</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Indemnización implícita</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Implizite Entschädigung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indenização implícita</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיצויים משוחררים</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Implied Indemnification</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLNlm7nXyJQLJmk8qYnaPQ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoKNrz23ylFaWAaoPC3ECY"/>
    <skos:definition>A legal concept where one party is obligated to compensate another party for damages or losses, even if there is no explicit agreement to do so, due to actions or statements that created a reasonable expectation of indemnification.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/12hbihA0Spili44-dI_1_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Pet and Pet Supplies Retailers</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in retailing pets, pet foods, and pet supplies.</skos:definition>
