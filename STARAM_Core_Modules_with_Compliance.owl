    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7"/>
    <rdfs:label>Firm Business Development Personnel</rdfs:label>
    <skos:definition>Firm Business Development Personnel are professionals within a law firm or legal organization who focus on identifying and pursuing new business opportunities, expanding client relationships, and enhancing the firm's market position. They strategize and implement initiatives to attract new clients, retain existing ones, and increase the firm's revenue and growth potential.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>BD Professional</skos:prefLabel>
  </rdf:Description>
