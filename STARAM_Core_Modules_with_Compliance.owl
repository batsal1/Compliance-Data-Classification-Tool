  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RSCPj3Fx9eMWODAmY3A64o">
    <skos:definition>AI Discrimination refers to the differential treatment of individuals based on factors such as ethnicity, culture, or religion. This discrimination can arise from institutional and individual biases embedded in AI processes, cultural and social biases within the data, technical limitations of hardware or software, or the context of an AI system's application that results in unequal treatment of groups.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
    <skos:example>Mobley v. Workday, Inc., Case No. 3:23-cv-00770 (N.D. Cal.)</skos:example>
    <skos:example rdf:resource="https://www.courtlistener.com/docket/66831340/mobley-v-workday-inc/"/>
    <skos:altLabel>Computational Discrimination</skos:altLabel>
    <skos:altLabel>Machine-Induced Inequity</skos:altLabel>
    <skos:altLabel>Algorithmic Discrimination</skos:altLabel>
    <skos:altLabel>Automated Discrimination</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AI Discrimination</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCc5UaQRTagjPA2b0YSaSBi">
    <rdfs:label>Assuming Facts Not in Evidence Objection</rdfs:label>
    <skos:altLabel>Unsubstantiated Facts Assumption</skos:altLabel>
    <skos:altLabel>Assumes Facts Not in Evidence</skos:altLabel>
    <skos:altLabel>Assuming Facts Not in Evidence</skos:altLabel>
    <skos:altLabel>Inaccurate Hypothetical Objection</skos:altLabel>
    <skos:altLabel>Presumption of Unproven Facts</skos:altLabel>
    <dc:source>Fed. R. Evid. 611</dc:source>
    <dc:source>Fed. R. Evid. 403</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Naad8fdd8071e4e32962899cb165d691b"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NB9WJzAFK6tIIGmfIj5Ay"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBMlUtTtbQUQxrZrkeF8Fpm"/>
    <skos:prefLabel>Assuming Unestablished Facts</skos:prefLabel>
    <skos:definition>Assuming Facts Not in Evidence is an objection raised when a party in a legal proceeding believes that a question or statement implies the existence of facts that have not been formally introduced or established as evidence in the case. This objection aims to prevent the influence of unfounded assumptions on the proceedings.</skos:definition>
  </rdf:Description>
