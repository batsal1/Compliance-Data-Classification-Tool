  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7H1LBWxhK8J5cyQxoZepfT">
    <rdfs:label>Dairy Cattle</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Dairy Cattle are domesticated bovine animals bred and raised primarily for milk production. These cattle are known for their high milk yield, efficient lactation cycles, and significant role in the dairy industry, providing milk for consumption and dairy products such as cheese, butter, and yogurt.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7qxVfcFITBa22T7miUZb0x"/>
    <skos:altLabel>Dairy Livestock</skos:altLabel>
    <skos:prefLabel>Milk Cows</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rr4ZtEAUQzKQNSwTz3x2Og">
    <skos:definition>Illustrative Examples:</skos:definition>
    <skos:definition>Television sets merchant wholesalers</skos:definition>
    <skos:definition>Household-type refrigerators merchant wholesalers</skos:definition>
    <skos:definition>Toothbrushes, electric, merchant wholesalers</skos:definition>
    <skos:definition>Household-type radios (including automotive) merchant wholesalers</skos:definition>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of household-type gas and electric appliances (except water heaters and heating stoves (i.e., noncooking)), room air-conditioners, and/or household-type audio or video equipment.</skos:definition>
    <skos:definition>Curling irons, electric, merchant wholesalers</skos:definition>
    <skos:definition>Household-type video cameras merchant wholesalers</skos:definition>
    <skos:definition>Household-type sewing machines merchant wholesalers</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Household Appliances, Electric Housewares, and Consumer Electronics Merchant Wholesalers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/BL7OfkdvRjKwd_8Hw4l2QA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423620"/>
  </rdf:Description>
