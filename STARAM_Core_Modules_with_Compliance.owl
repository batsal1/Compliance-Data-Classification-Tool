  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDEH31m87KVjv66MO5hBvje">
    <skos:altLabel xml:lang="fr-fr">Pratique de la motion en faillite</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de movimentação de falência</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de presentación de mociones de quiebra</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de presentación de mociones de bancarrota</skos:altLabel>
    <skos:altLabel>Bankruptcy Motion</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">破産動議の実務</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">破产动议实践</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Insolvenzbewegungspraxis</skos:altLabel>
    <skos:altLabel>Bankruptcy Motion Service</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दिवालियापन मोशन प्रैक्टिस</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bankruptcy Motion Practice</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול הגשת מוטות במשפטי חדלות פירעון</skos:altLabel>
    <skos:definition>Bankruptcy Motion Practice refers to the legal procedures and strategies involved in filing and responding to motions in bankruptcy cases, including but not limited to motions for relief from automatic stay, objections to claims, and motions to dismiss.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bankruptcy Motion Practice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/dBznQuc4TF2u9qYTVToxXA">
    <skos:definition>See industry description for 424610.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/fPIkr3gKQKuIhKOwtekbzw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=42461"/>
    <rdfs:label>Plastics Materials and Basic Forms and Shapes Merchant Wholesalers</rdfs:label>
