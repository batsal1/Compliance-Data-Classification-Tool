  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCpgZ2FzF6vHyeapUTLstks">
    <rdfs:label>Intentional or Malicious Harm to Another</rdfs:label>
    <skos:altLabel xml:lang="es-es">Daño intencional o malicioso a otra persona</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פגיעה מתוכננת או זדונית באדם אחר</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dano intencional ou malicioso a outra pessoa</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">故意或恶意伤害他人</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Intentional or Malicious Harm to Another</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">他者への意図的または悪意のある害</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Dommage intentionnel ou malveillant à autrui</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दूसरों को जानबूझकर या इच्छापूर्वक हानि पहुंचाना</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vorsätzliche oder bösartige Schädigung eines anderen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Daño intencional o malicioso a otra persona</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Intentional or Malicious Harm to Another refers to a legal claim for damages resulting from a deliberate and harmful act committed by one person against another.</skos:definition>
  </rdf:Description>
