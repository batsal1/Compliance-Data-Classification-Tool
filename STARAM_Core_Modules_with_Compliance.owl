  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rwlacj5u1wGL6ZMuJlmLcV">
    <skos:altLabel xml:lang="es-mx">Infracción</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verstoß</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Infraction</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违规行为</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Infraction</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">違反行為</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Infracción</skos:altLabel>
    <skos:altLabel>Petty Offense</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Infração</skos:altLabel>
