    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe"/>
    <rdfs:label>Scènes à Faire</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Scènes à Faire in copyright law refers to scenes, elements, or themes that are standard, necessary, or customary to a particular genre and are therefore not protectable due to their lack of originality. This doctrine acknowledges that certain expressions are indispensable or typical for certain topics or settings and are therefore free for use by all.</skos:definition>
  </rdf:Description>
