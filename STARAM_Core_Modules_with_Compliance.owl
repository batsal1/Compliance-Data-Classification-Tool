    <skos:altLabel xml:lang="zh-cn">情感困扰赔偿</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भावनात्मक तनाव नुकसान</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">精神的苦痛に対する損害賠償</skos:altLabel>
