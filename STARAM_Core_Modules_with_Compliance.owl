  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R1mvqs8rqT-2Ji-pXnQHz7A">
    <skos:definition>Preparing for hearing, Identifying documents/evidence for use at hearing, Preparing demonstrative materials, evidence and exhibits, Pre-hearing conference with adjuster/employer /opposing counsel/witness, Research of case law and statutes for use at hearing, Review of deposition for use at hearing, Preparation of trial summary memorandum of law, Preparation of opening/closing statement</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6P7wyMvVTo6CR9AJqe-HSg"/>
    <rdfs:label>WC440 Hearing Preparation and Support</rdfs:label>
    <skos:prefLabel>WC440 Hearing Preparation and Support</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RvOk9UP5lfNJm6UJBzGiCO">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7kD4ePZmjNDaw2a1pWIDds"/>
    <rdfs:label>Uncontentious</rdfs:label>
    <skos:definition>Uncontentious negotiation refers to a negotiation process where parties have aligned interests and work cooperatively to reach an agreement without conflict or adversarial tactics. This approach emphasizes mutual understanding, amicable discussions, and efficient resolution of terms, often resulting in agreements that are satisfactory to all parties involved.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Uncontentious Negotiation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9LJ3VYJiCCG4bvoMOFX1Kq">
    <skos:altLabel>Equines</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KMTMyVwMFJ4uhm95DFM9y"/>
    <skos:definition>Horses are large domesticated mammals belonging to the species Equus ferus caballus, known for their strength, speed, and endurance. They have been utilized by humans for transportation, labor, recreation, and competitive sports, and come in a variety of breeds adapted for specific purposes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Horses</rdfs:label>
  </rdf:Description>
