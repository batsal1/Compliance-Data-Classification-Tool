  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5VP1uyxTZkNC9Yw87tKtd">
    <skos:altLabel xml:lang="hi-in">उपयोग सीमा सिद्धांत</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">使用限制原则</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">使用制限原則</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Principio de Limitación de Uso</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Prinzip der Verwendungseinschränkung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Principe de limitation d'utilisation</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Princípio da Limitação de Uso</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Use Limitation Principle</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Principio de Limitación de Uso</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עקרון ההגבלה בשימוש</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="http://oecdprivacy.org/"/>
    <rdfs:label>Use Limitation Principle</rdfs:label>
    <skos:definition>Use limitation is the privacy principle that personal data should not be disclosed, made available, or otherwise used for various purposes unless (1) the data subject consents or (2) by the authority of law.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/IzcLQzJ3S2iEqtcIrJNYrg">
    <skos:example>Fatty acids (e.g., margaric, oleic, stearic) manufacturing</skos:example>
    <skos:example>Carbon organic compounds, not specified elsewhere by process, manufacturing</skos:example>
    <skos:example>Silicone (except resins) manufacturing</skos:example>
    <skos:example>Enzyme proteins (i.e., basic synthetic chemicals) (except pharmaceutical use) manufacturing</skos:example>
    <skos:example>Biodiesel fuels not made in petroleum refineries and not blended with petroleum</skos:example>
    <skos:example>Synthetic sweeteners (i.e., sweetening agents) manufacturing</skos:example>
    <skos:example>Plasticizers (i.e., basic synthetic chemicals) manufacturing</skos:example>
    <skos:example>Calcium organic compounds, not specified elsewhere by process, manufacturing</skos:example>
    <skos:example>Organo-inorganic compound manufacturing</skos:example>
    <skos:example>Refrigerant mixtures and blends manufacturing</skos:example>
    <skos:example>Raw organic waxes manufacturing</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NxFQNeidROq0oYR7MPdqGw"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing basic organic chemical products (except aromatic petrochemicals, industrial gases, synthetic organic dyes and pigments, gum and wood chemicals, cyclic crudes and intermediates, and ethyl alcohol).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325199"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>All Other Basic Organic Chemical Manufacturing</rdfs:label>
  </rdf:Description>
