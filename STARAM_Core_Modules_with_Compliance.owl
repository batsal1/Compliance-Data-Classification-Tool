  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQCyNdB6QvP6zcWKkpQQ1q">
    <skos:definition>The Political Vote Privilege is a legal right or immunity granted to individuals that allows them to cast their vote in political elections without fear of retaliation or discrimination.</skos:definition>
    <skos:altLabel xml:lang="zh-cn">政治投票特权</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות הצבעה פוליטית</skos:altLabel>
