  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDlYI2CbQn1u95Hs6otNU2O">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Committed Relationship Partner</rdfs:label>
    <skos:definition>A Committed Relationship Partner is an individual who is in a stable, long-term relationship characterized by mutual commitment, love, and shared responsibilities, but not necessarily legally recognized as a spouse. This status implies a serious, ongoing partnership that may include cohabitation and joint decision-making in various aspects of life.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
  </rdf:Description>
