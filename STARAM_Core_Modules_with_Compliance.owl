  </rdf:Description>
  <rdf:Description rdf:nodeID="Naab6340f90694d258ae6fdf06baae917">
    <owl:hasValue rdf:resource="https://staram.in/ontology/epc/taxonomy#impact-time"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/epc#hasConsequence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rijz2yDnioeblXoMdxow8K">
    <rdfs:subClassOf rdf:nodeID="Nb5294038b7294bf1a9e9b9f85234b853"/>
    <rdfs:subClassOf rdf:nodeID="Ned7336c912554dab9a49db8051550ff2"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDsWDLg5JUKHPw6my6QzmoU"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Litigation Risk refers to the potential for negative consequences arising from legal disputes, claims, or lawsuits involving an organization or its representatives. This can result from contractual breaches, regulatory noncompliance, intellectual property infringement, or negligence, potentially leading to financial losses, reputational damage, or operational disruptions, ultimately impacting the organization's overall performance, credibility, and sustainability.</skos:definition>
    <rdfs:label>Litigation Risk</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5ba777b18ed24e79b7f5c38dfb5233bd">
