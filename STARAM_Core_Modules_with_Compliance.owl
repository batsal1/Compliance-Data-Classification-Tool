  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7e7pNl5IOMFbxKN2GV2C41">
    <skos:altLabel xml:lang="ja-jp">ヘッジファンド</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fundo de cobertura</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hedgefonds</skos:altLabel>
    <skos:altLabel>Hedge Fund Investor</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">对冲基金</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fonds spéculatif</skos:altLabel>
