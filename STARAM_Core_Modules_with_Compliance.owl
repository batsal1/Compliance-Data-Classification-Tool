  <rdf:Description rdf:about="https://folio.openlegalstandard.org/POR-YI_oToaOV6DJqGhIBQ">
    <rdfs:label>Fluid Milk Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311511"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) manufacturing processed milk products, such as pasteurized milk or cream and sour cream and/or (2) manufacturing fluid milk dairy substitutes from soybeans and other nondairy substances.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/hncqZ2XEQgCapENT5DIm_A"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
