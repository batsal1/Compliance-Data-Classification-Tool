    <ns1:contractFamily xml:lang="en">Real Estate &amp; Leasing</ns1:contractFamily>
    <rdfs:label>Lease Subordination Agreement</rdfs:label>
    <rdfs:seeAlso>A Lease Subordination Agreement places a tenant's rights below (or "subordinates" them to) the rights of a third party, typically a lender or a new property owner.</rdfs:seeAlso>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
