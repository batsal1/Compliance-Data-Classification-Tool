    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>230 Rent Lease &amp; Ejectment (PACER NoS)</rdfs:label>
    <skos:definition>Action for rental or lease payments owed on real property and/or to eject a party occupying real property illegally.</skos:definition>
  </rdf:Description>
