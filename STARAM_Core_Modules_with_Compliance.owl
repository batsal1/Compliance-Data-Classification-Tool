  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBM2snOfHOGu50QMiZ0LoiS">
    <skos:altLabel xml:lang="fr-fr">Revendication de la clause de conseil et de consentement</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Beratung und Zustimmungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף ייעוץ והסכמה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">助言と同意条項の主張</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Advice &amp; Consent Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de Consejo y Consentimiento</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de Consejo y Consentimiento</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Cláusula de Conselho e Consentimento</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">建议和同意条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सलाह और सहमति धारा दावा</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Advice &amp; Consent Clause Claim</rdfs:label>
    <skos:definition>An Advice &amp; Consent Clause claim is a legal argument asserting that a particular appointment or nomination made by a government official violates the Advice and Consent Clause of the United States Constitution. This claim contends that the appointment or nomination was made without obtaining the necessary advice and consent of a legislative body, typically the Senate, as required by the constitutional provision.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdZDW8VIPVbM8gI4n7Ippf"/>
  </rdf:Description>
