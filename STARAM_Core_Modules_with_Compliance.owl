    <skos:altLabel xml:lang="fr-fr">Représentation de l'opinion du conseiller financier</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ファイナンシャルアドバイザーの意見表明</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representación de la opinión del asesor financiero</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representação da opinião do consultor financeiro</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Financial Adviser's Opinion Representation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वित्तीय सलाहकार की राय प्रतिनिधित्व</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">财务顾问意见陈述</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Darstellung der Meinung des Finanzberaters</skos:altLabel>
    <skos:definition>A Financial Advisor's Opinion Representation is a statement made by a financial advisor regarding the financial aspects of a legal matter, which is included as a representation and warranty in the legal documentation.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Nb96ebfbf79e64727a938fb03ff709153"/>
