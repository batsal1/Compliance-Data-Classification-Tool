    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermTaxes"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/kWnYwlzIS9K0r1_cV3CAHQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33712"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/-Cm9mv-7RueAjbhc-pGpkA"/>
    <rdfs:label>Household and Institutional Furniture Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing household-type and public building furniture (e.g., library, school, theater, and church furniture).  This industry includes establishments that manufacture general purpose hospital, laboratory, and/or dental furniture (e.g., stools, tables, benches).  The furniture may be made on a stock or custom basis and may be assembled or unassembled (i.e., knockdown).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R3Q94wfBzs41rD9XxEgl6m">
    <skos:altLabel xml:lang="he-il">תביעה על הפרת הצהרת שכר</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेतन विवरण उल्लंघन दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">工资报表违规索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por violación de la declaración de salarios</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃金明細書違反請求</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación por violación de la declaración de salarios</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de violação de extrato de salário</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Verletzung der Lohnabrechnung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de violation de relevé de salaire</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Wage Statement Violation Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <skos:definition>A wage statement violation claim is a legal action initiated by an employee against their employer for not complying with the legal requirement to provide accurate and complete wage statements or pay stubs. These statements typically include information about the employee's hours worked, wages earned, deductions taken, and other important employment-related information. The claim typically arises when an employer provides wage statements that do not accurately reflect the employee's earnings or deductions, or do not contain all the information required by law. Employers can face liability for failing to provide accurate and complete wage statements, which can result in financial harm to the employee.</skos:definition>
    <skos:definition>DEPRECATED as duplicative of `Failure to Provide Wage Records Claim`</skos:definition>
    <rdfs:label>Wage Statement Violation Claim</rdfs:label>
    <rdfs:label>DEPRECATED Wage Statement Violation Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/1GNpG5iBR2-T_cm6IHtTXw">
    <skos:example>Ceiling lighting fixtures, residential, manufacturing</skos:example>
    <skos:example>Table lamps (i.e., lighting fixtures) manufacturing</skos:example>
    <skos:example>Chandeliers, residential, manufacturing</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Yz4kpOqlRVKhZEaDlcjMvg"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing fixed or portable residential electric lighting fixtures and lamp shades of metal, paper, or textiles. Residential electric lighting fixtures include those for use both inside and outside the residence.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=335131"/>
    <rdfs:label>Residential Electric Lighting Fixture Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/lD2TFa7OQmmnU-niYcL88g">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=621310"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/kcHcbKFXTdO-26NkL_8CFw"/>
    <rdfs:label>Offices of Chiropractors</rdfs:label>
    <skos:definition>This industry comprises establishments of health practitioners having the degree of D.C. (Doctor of Chiropractic) primarily engaged in the independent practice of chiropractic. These practitioners provide diagnostic and therapeutic treatment of neuromusculoskeletal and related disorders through the manipulation and adjustment of the spinal column and extremities, and operate private or group practices in their own offices (e.g., centers, clinics) or in the facilities of others, such as hospitals or HMO medical centers.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCEeTSxyIUBpuP9F2hVyHua">
    <skos:altLabel xml:lang="ja-jp">通知エージェント</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Agente de notificación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Noticing Agent</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סוכן הודעה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Benachrichtigungsagent</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Agente de notificación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Agent de notification</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Agente de notificação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">通知代理</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नोटिसिंग एजेंट</skos:altLabel>
    <skos:definition>A Noticing Agent is an individual or entity who is authorized to provide legal notice to parties involved in a legal matter.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:description>Bankruptcy Courts will sometimes outsource court duties (e.g., noticing) to external agents (e.g., Noticing Agents)</dc:description>
    <rdfs:label>Noticing Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDvvMcl4VbqDv1BGaZqaSL"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDQuQN3mVLJzSmHuOJ0jTsC">
    <skos:altLabel xml:lang="es-mx">Práctica de Suspensión Automática</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Praxis des automatischen Aufschubs</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自動滞在の実践</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">自动停留实践</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique du séjour automatique</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Automatic Stay Practice</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de Suspensión Automática</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de suspensão automática</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वचालित रोक अभ्यास</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול השהייה אוטומטית</skos:altLabel>
    <skos:altLabel>Automatic Stay</skos:altLabel>
    <skos:altLabel>Automatic Stay Service</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9gfE6kHyuByZQuBx64zEoD"/>
    <skos:definition>Automatic Stay Practice refers to the legal practice of obtaining and enforcing an automatic stay, which is a court order that stops creditors from taking certain actions against a debtor or the debtor's property during a bankruptcy proceeding.</skos:definition>
    <rdfs:label>Automatic Stay Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ren27VK2QbFLW1uRFu8AtK">
    <skos:altLabel xml:lang="hi-in">स्केटबोर्ड और होवर बोर्ड लिएबिलिटी क्लेम</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de responsabilidade por acidentes com skate e hoverboard</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de responsabilidad por patineta y hoverboard</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftungsanspruch bei Skateboard- und Hoverboardunfällen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Skateboard and Hover Board Liability Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de responsabilidad por patinete y hoverboard</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">滑板和悬浮板责任索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">スケートボードおよびホバーボードの責任請求</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de responsabilité pour les accidents de skateboard et de hoverboard</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת אחריות על סקייטבורד והוברבורד</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Skateboard and Hover Board Liability Claim</rdfs:label>
    <skos:definition>A Skateboard and Hover Board Liability Claim is a legal claim for damages resulting from injuries caused by the use of a skateboard or hover board, falling under the category of Personal Injury Claims.</skos:definition>
  </rdf:Description>
