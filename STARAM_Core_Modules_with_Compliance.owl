    <skos:altLabel xml:lang="en-gb">Pornography and Obscene Material</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pornografie und obszönes Material</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ポルノグラフィーとわいせつ物</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pornographie et matériel obscène</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pornografia e material obsceno</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Pornografía y Material Obsceno</skos:altLabel>
