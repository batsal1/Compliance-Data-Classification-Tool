  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCbbmfvsGlQiz0v3PERbrU3">
    <skos:altLabel xml:lang="es-es">Negligencia médica en cirugía cardíaca</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">心臓手術の医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em cirurgia cardíaca</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en chirurgie cardiaque</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हृदय शल्य अपराध</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בניתוח לב</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en cirugía cardiaca</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fehlerhafte Herzchirurgie</skos:altLabel>
