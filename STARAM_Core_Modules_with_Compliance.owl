  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RssAZbpAdTvtzgbHYQtB6a">
    <skos:definition>A Lack of Authentication Objection is raised when a party attempts to introduce evidence without providing sufficient proof that the evidence is genuine and authentic. This objection asserts that the party offering the evidence has not met the necessary burden to establish that the evidence is what it purports to be.</skos:definition>
    <rdfs:label>Lack of Authentication Objection</rdfs:label>
    <skos:altLabel>Insufficient Authentication Objection</skos:altLabel>
    <skos:altLabel>Lack of Authenticity Objection</skos:altLabel>
    <skos:altLabel>Foundational Authentication Objection</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoABbJ9kEFzmBvBSGmbAyq"/>
    <dc:source>Fed. R. Evid. 901</dc:source>
    <dc:source>Fed. R. Evid. 902</dc:source>
    <skos:prefLabel>Unauthenticated Evidence Objection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R79l2IoqX4ogtsb5ZRVMWG">
    <skos:definition>The Enforcement of Visitation Claim is the legal process of ensuring that a parent's right to visit their child is upheld, typically through court orders and legal remedies.</skos:definition>
    <skos:altLabel xml:lang="hi-in">दौरे के दावे का प्रवर्तन</skos:altLabel>
