  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCVTMxVNrsAdKOruCSm37WV">
    <skos:altLabel xml:lang="ja-jp">製薬産業</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pharmaindustrie</skos:altLabel>
    <skos:altLabel>Pharmaceuticals</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria Farmacéutica</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria farmacêutica</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria Farmacéutica</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie pharmaceutique</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית תרופות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">制药工业</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फार्मास्यूटिकल उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pharmaceuticals Industry</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3254"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-PHA</ns2:legacyIdentifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Pharmaceutical and Medicine Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBrBYbsaP35Zqr9ZrYFHMda"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing biological and medicinal products; (2) processing (i.e., grading, grinding, and milling) botanical drugs and herbs; (3) isolating active medicinal principals from botanical drugs and herbs; and (4) manufacturing pharmaceutical products intended for internal and external consumption in such forms as ampoules, tablets, capsules, vials, ointments, powders, solutions, and suspensions.</skos:definition>
    <dc:identifier>PHA</dc:identifier>
    <skos:hiddenLabel>PHA</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB9XWHA1xmPwnDe5p5pj4zh">
    <skos:altLabel xml:lang="fr-fr">Clause de libération d'intérêt de sécurité</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de liberación de garantía</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सुरक्षा हित शर्त का विमोचन अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de liberación de garantía</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">担保権解除条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">解除安全利益条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de liberação de interesse de segurança</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שחרור התעניינות בטחונית</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Release of Security Interest Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Freigabe von Sicherheitsinteressen</skos:altLabel>
    <skos:definition>A Release of Security Interest Clause is a legal provision that terminates a creditor's claim to a debtor's property used as collateral for a loan.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Release of Security Interest Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7QtA1XEvYBttW8LUvBN7OB"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/xHYpQehTSCuxJCSwbZ2iAQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBX1KA0BJR7y27zZSvaLBVE"/>
    <rdfs:label>Depository Credit Intermediation Industry</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5221"/>
    <skos:definition>This industry group comprises establishments primarily engaged in accepting deposits (or share deposits) and in lending funds from these deposits. Within this group, industries are defined on the basis of differences in the types of deposit liabilities assumed and in the nature of the credit extended.</skos:definition>
  </rdf:Description>
