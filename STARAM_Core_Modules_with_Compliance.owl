  <rdf:Description rdf:about="https://folio.openlegalstandard.org/G1QfHBCDQYuntKzytME4aQ">
    <skos:definition>This industry comprises establishments primarily engaged in applying physical laws and principles of engineering in the design, development, and utilization of machines, materials, instruments, structures, processes, and systems. The assignments undertaken by these establishments may involve any of the following activities: provision of advice, preparation of feasibility studies, preparation of preliminary and final plans and designs, provision of technical services during the construction or installation phase, inspection and evaluation of engineering projects, and related services.</skos:definition>
    <rdfs:label>Engineering Services</rdfs:label>
    <skos:example>Construction engineering services</skos:example>
    <skos:example>Environmental engineering services</skos:example>
    <skos:example>Civil engineering services</skos:example>
    <skos:example>Mechanical engineering services</skos:example>
    <skos:example>Engineers' offices</skos:example>
    <skos:example>Robotics automation engineering services</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541330"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/OQq6o-KHTuunIFnPjMV6UQ"/>
  </rdf:Description>
