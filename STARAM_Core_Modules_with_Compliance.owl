    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoABbJ9kEFzmBvBSGmbAyq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBbkwoH1uH2PhTq4RgSutqL">
