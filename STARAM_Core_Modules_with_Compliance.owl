    <skos:altLabel xml:lang="de-de">Hinweis-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">通知条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de notification</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Notificaciones</skos:altLabel>
    <skos:altLabel>Notice</skos:altLabel>
    <rdfs:label>Notices Clause</rdfs:label>
    <skos:definition>A notices clause is a provision in a contract that outlines the requirements for providing formal communication between parties, such as the method and timing of delivering notices.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
