  <rdf:Description rdf:about="https://folio.openlegalstandard.org/1vi1NWSDSMKp4xURTipE7g">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in renting consumer goods and products (except consumer electronics and appliances; formal wear and costumes; prerecorded video tapes and discs for home electronic equipment; home health furniture and equipment; and recreational goods). Included in this industry are furniture rental centers and party rental supply centers.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>All Other Consumer Goods Rental</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/uWOA_M6CQQaGGo4Y88CnuA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=532289"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7RIiGEhbNy3YC5PH9ohXMp">
    <skos:altLabel>Objection to Evidence of Religious Affiliation</skos:altLabel>
    <skos:altLabel>Faith-Based Evidence Objection</skos:altLabel>
    <skos:altLabel>Creed Evidence Objection</skos:altLabel>
    <skos:definition>A Religious Belief Evidence Objection is raised when a party in a legal proceeding believes that evidence regarding a person's religious beliefs or practices is being used unfairly to suggest credibility, believability, or character. This objection aims to prevent prejudice or bias based on religious affiliation and to ensure that the focus remains on relevant and admissible evidence.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8R7UAZpzIQTdqNtctKj3XY"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Religious Belief Evidence Objection</rdfs:label>
    <dc:source>Fed. R. Evid. 610.</dc:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nea58d5f292424c7585f62a3a4b90905f">
