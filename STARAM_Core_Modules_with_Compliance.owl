    <skos:altLabel xml:lang="de-de">Rechtsbehelfe, Abhilfen und Strafen bei Rechtsstreitigkeiten</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">诉讼救济、救济措施和处罚</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">訴訟救済、救済措置および罰則</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Remedios, alivio y sanciones en litigios</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיצויים, תביעות ועונשים בהליך משפטי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Remedios, alivio y sanciones en litigios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मुकदमे के उपचार, राहत और दंड</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Litigation Remedies, Relief, and Penalties</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Recours, mesures de réparation et sanctions en matière de litiges</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDhSx7fl9qS0ezDVJuZHX4"/>
    <skos:definition>Litigation Remedies, Relief, and Penalties refer to the legal actions or measures sought by a party in a lawsuit to obtain compensation, restitution, or other forms of relief for harm suffered, as well as the penalties imposed on the opposing party for their wrongdoing.</skos:definition>
    <skos:prefLabel>Compensations</skos:prefLabel>
    <rdfs:label>Litigation Remedies, Relief, and Penalties</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
