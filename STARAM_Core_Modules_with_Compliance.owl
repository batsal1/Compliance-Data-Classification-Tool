  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R88V7POqTDWSiC7aI1y5oWW">
    <skos:altLabel xml:lang="en-gb">Improperly Buying Securities During Corporate Takeover</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unangemessener Kauf von Wertpapieren während einer Unternehmensübernahme</skos:altLabel>
    <skos:altLabel xml:lang="he-il">קניית ניירות ערך באופן לא תקין במהלך רכישת חברה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Achat inapproprié de titres pendant une prise de contrôle d'entreprise</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公司收购期间不当购买证券</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कॉर्पोरेट अधिग्रहण के दौरान अनुचित रूप से सुरक्षाएं खरीदना</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Compra inadecuada de valores durante una adquisición corporativa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Compra inadecuada de valores durante una adquisición corporativa</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Compra inadequada de valores mobiliários durante aquisição corporativa</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">企業買収中の適切でない証券購入</skos:altLabel>
    <rdfs:label>Improperly Buying Securities During Corporate Takeover</rdfs:label>
    <skos:definition>The concept of "Improperly Buying Securities During Corporate Takeover" refers to the act of purchasing securities in a company during a takeover in a manner that violates securities laws or regulations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBWTNMvqynzbuBEvo2wGHe7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
