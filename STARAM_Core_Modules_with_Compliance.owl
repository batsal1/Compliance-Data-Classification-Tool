  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R83u2PaBNXclAGLdTJGeFiG">
    <skos:definition>The limited voting system is an electoral method where voters have fewer votes than the number of available seats, allowing for the possibility of minority representation. This system is designed to prevent any single group from winning all the seats and is often used to promote more diverse representation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Alabama State Board of Education Elections: Limited voting used to ensure minority representation</skos:example>
    <skos:example>Spain's Senate Elections: Voters have two or three votes for four seats in each province</skos:example>
    <skos:example>Gibraltar's Parliamentary Elections: Voters have ten votes for seventeen seats</skos:example>
    <dc:source rdf:resource="https://en.wikipedia.org/wiki/Limited_voting"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8aVRgLAjmuf0OiloIoc9pm"/>
    <skos:prefLabel>Partial Block Voting</skos:prefLabel>
    <rdfs:label>Limited Voting System</rdfs:label>
    <skos:altLabel>Minority Representation Voting</skos:altLabel>
    <skos:altLabel>Partial Voting System</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RLrx27QGpu0s2hBlvQ62q9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Cláusula de sinalização externa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף לוחות חיצוניים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de señalización exterior</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">外部看板条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel für Außenbeschilderung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de señalización exterior</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">外部标识条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बाहरी संकेत शर्त</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Exterior Signage Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de signalisation extérieure</skos:altLabel>
    <rdfs:label>Exterior Signage Clause</rdfs:label>
    <skos:definition>Exterior Signage Clause: A provision in a contract that specifies the terms and conditions related to the display of signs or other advertising materials on the exterior of a building or property.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Sz0s9t0f50ZJbxuJyhsi0">
    <skos:altLabel xml:lang="he-il">עבודה חוזית שטוחה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Trabajo contractual descuidado</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不注意な契約作業</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">粗心合同工作</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Vertragsarbeit</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Trabalho contratual descuidado</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Travail contractuel négligent</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Trabajo contractual descuidado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Careless Contractual Work</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लापरवाह ठेकेदारी का काम</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nf1f17770de444062a4c2ec6e6c3ce8dc"/>
    <rdfs:subClassOf rdf:nodeID="N979561caae8f400bbfb5d1ee70b8535f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Careless Contractual Work</rdfs:label>
    <skos:definition>Careless Contractual Work refers to a breach of contract claim that arises when a party fails to exercise reasonable care in the performance of their contractual obligations, resulting in harm or damages to the other party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCc2g99sFHEbUR6mIr1hLKE">
    <skos:altLabel>Excise Tax Service</skos:altLabel>
    <skos:altLabel>Excise Tax</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Excise Tax Practice refers to the application, administration, and enforcement of taxes imposed on specific goods, services, or activities, such as alcohol, tobacco, fuel, and gambling. These taxes are typically levied at the point of production or sale and are often used to generate revenue and regulate consumption of certain products.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R527Rr0DAZ1Lu9VPx6QRbj"/>
    <rdfs:label>Excise Tax Practice</rdfs:label>
  </rdf:Description>
