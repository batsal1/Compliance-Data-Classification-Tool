  <rdf:Description rdf:about="https://folio.openlegalstandard.org/IKhloeFRQCmV-NtdilGd0w">
    <skos:definition>This industry group comprises establishments primarily engaged in providing real estate services (except lessors of real estate and offices of real estate agents and brokers). Included in this industry group are establishments primarily engaged in managing real estate for others and appraising real estate.</skos:definition>
    <rdfs:label>Activities Related to Real Estate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDzGV0uU52QEYp4H0g4bOBP"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5313"/>
  </rdf:Description>
