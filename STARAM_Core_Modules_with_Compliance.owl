    <skos:altLabel xml:lang="en-gb">Collecting Bank Mishandling Negotiable Instrument</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Mauvaise manipulation d'instruments négociables par la banque de collecte</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Má manipulação de instrumento negociável pelo banco coletor</skos:altLabel>
