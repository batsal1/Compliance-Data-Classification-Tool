    <skos:altLabel xml:lang="es-mx">Cláusula de reversión de derechos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right of Reversion Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de réversion</skos:altLabel>
    <skos:definition>A right of reversion clause is a provision in a contract that allows the original owner to regain ownership of the property or asset if certain conditions are met.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Right of Reversion Clause</rdfs:label>
  </rdf:Description>
