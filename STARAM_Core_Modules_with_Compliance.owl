  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBWYYH8EVxFlamkT7Z7UYqi">
    <skos:altLabel xml:lang="zh-cn">商业上合理努力反垄断标准</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Commercially Reasonable Efforts Antitrust Standard</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תקן נגד המונופולים של מאמצים מסחריים סבירים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">商業上合理な努力反トラスト標準</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Antitrust-Standard für kommerziell angemessene Anstrengungen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estándar Antimonopolio de Esfuerzos Comercialmente Razonables</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वाणिज्यिक तौर पर उचित प्रयास विरोधात्मक मानक</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Padrão antitruste de esforços comercialmente razoáveis</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Norme antitrust des efforts commercialement raisonnables</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Estándar Antimonopolio de Esfuerzos Comercialmente Razonables</skos:altLabel>
    <skos:definition>The Commercially Reasonable Efforts Antitrust Standard is a provision within antitrust efforts that requires parties to make a good faith effort to achieve a particular goal or outcome, while taking into account the costs and benefits of such efforts.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Commercially Reasonable Efforts Antitrust Standard</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwjUss6QZVzUsfsKBJ0kHX"/>
  </rdf:Description>
