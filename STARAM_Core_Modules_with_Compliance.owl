  <rdf:Description rdf:about="https://folio.openlegalstandard.org/GtNxbapGRL26_Ki-0ZpxOA">
    <skos:example>Plastics or fiberglass plumbing fixtures (e.g., toilets, shower stalls, urinals) manufacturing</skos:example>
    <skos:example>Plastics siding manufacturing</skos:example>
    <skos:example>Plastics hardware manufacturing</skos:example>
    <skos:example>Plastics clothes hangers manufacturing</skos:example>
    <skos:example>Plastics cups (except foam) manufacturing</skos:example>
    <skos:example>Plastics bowls and bowl covers manufacturing</skos:example>
    <skos:example>Plastics trash containers manufacturing</skos:example>
    <skos:example>Plastics prefabricated buildings manufacturing</skos:example>
    <skos:example>Plastics bottle caps and lids manufacturing</skos:example>
    <skos:example>Plastics dinnerware (except foam) manufacturing</skos:example>
    <skos:example>Plastics gloves manufacturing</skos:example>
    <skos:example>Plastics ice chests or coolers (except plastics foam) manufacturing</skos:example>
    <skos:example>Plastics air mattresses manufacturing</skos:example>
    <skos:example>Inflatable plastics swimming pool rafts and similar flotation devices manufacturing</skos:example>
    <skos:example>Resilient floor coverings (e.g., sheet, tiles) manufacturing</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/P2ahRVjlQwyn4knwwoIQvw"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing plastics plumbing fixtures and other plastics products (except film, sheet, bags, profile shapes, pipes, pipe fittings, laminates, foam products, bottles, and hoses).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Other Plastics Product Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32619"/>
  </rdf:Description>
