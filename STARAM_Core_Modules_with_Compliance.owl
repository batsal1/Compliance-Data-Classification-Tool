  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDRqzI5PsE3KeAC0BnugmUV">
    <skos:altLabel xml:lang="fr-fr">Clause d'insalubrité</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">居住不能条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unbewohnbarkeitsklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवास्तव्यता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de insalubridade</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不适居条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de inhabilidad del inmueble</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de inhabilidad del inmueble</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף על חוסר תאכלס</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Untenantability Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Untenantability Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An untentantability clause is a provision in a contract that allows a party to terminate the agreement if the property becomes uninhabitable or unusable for its intended purpose due to circumstances beyond the control of either party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na75667a94f014d95bad61c46e86eaa3e">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
