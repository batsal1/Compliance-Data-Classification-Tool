  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Do81p7GqTVSWefgMOcuJzw">
    <skos:definition>This industry comprises establishments primarily engaged in (1) growing nursery and floriculture products (e.g., nursery stock, shrubbery, cut flowers, flower seeds, foliage plants) under cover or in open fields and/or (2) growing short rotation woody trees with a growing and harvesting cycle of 10 years or less for pulp or tree stock (e.g., cut Christmas trees, cottonwoods).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/vVPTZWM9TquOobPy0Y44pg"/>
    <rdfs:label>Nursery and Floriculture Production</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=11142"/>
