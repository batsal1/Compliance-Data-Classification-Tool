    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/TV4aVM8QQEOPaPD0gpmpcg"/>
    <skos:definition>This industry comprises (1) establishments primarily engaged in operating religious organizations, such as churches, religious temples, mosques, and monasteries, and/or (2) establishments primarily engaged in administering an organized religion or promoting religious activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/6c1e4151-e237-41de-aedc-68061fa69f86e3a666af-b614-4949-b244-a99454e9be6e">
