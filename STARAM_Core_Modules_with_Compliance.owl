  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RqH4BWxdKaLgUWMsoSwmH4">
    <skos:altLabel xml:lang="pt-br">Negligência na sala de emergência</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence aux urgences</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आपातकालीन कमरे में लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">急诊室疏忽</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">救急室の過失</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en la Sala de Emergencias</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en la Sala de Emergencias</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Emergency Room Negligence</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fehlerhaftes Verhalten in der Notaufnahme</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות בחדר החירום</skos:altLabel>
