    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/contracts#Prepayment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndae07a003a2c4494b60862e1cbbfc434">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermDefaultingLender"/>
