    <rdfs:label>Family Health Insurance Plan</rdfs:label>
    <skos:definition>A family health insurance plan covers not just an individual policyholder but also members of their family, such as a spouse and/or children. These plans often have higher premiums but may offer a cost advantage on a per-person basis.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
