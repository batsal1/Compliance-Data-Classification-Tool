    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Toll agreements are legal contracts between a company and a toll manufacturer, where the company supplies raw materials, and the toll manufacturer processes these materials into finished products for a fee. These agreements outline the terms of the manufacturing relationship, including responsibilities, pricing, quality standards, confidentiality, and intellectual property rights.</skos:definition>
    <skos:altLabel>Toll Agreement</skos:altLabel>
    <ns1:contractFamily xml:lang="en">Supply, Manufacturing &amp; Distribution</ns1:contractFamily>
    <rdfs:label>Toll Manufacturing Agreement</rdfs:label>
  </rdf:Description>
