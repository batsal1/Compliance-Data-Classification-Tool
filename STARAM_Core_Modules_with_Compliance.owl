  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RzBukPsKWTommbx5e6_KLPg">
    <skos:prefLabel>L621 Collection/Recovery</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNkhUYPhiQvGHbAYwX9XKIg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Activities and actions related to the collection and/or recovery of a) custodial email residing on the network, server, home share or enterprise archive or journal, hard-drives and removable media, as well as paper files, b) collection and/or recovery of non-custodial data the network, server, group shares, removable media and paper files, and c) decrypting files, cracking passwords, files restoration and other forensic analysis activity. Includes selective collection, searches and source imaging.</skos:definition>
    <rdfs:label>L621 Collection/Recovery</rdfs:label>
  </rdf:Description>
