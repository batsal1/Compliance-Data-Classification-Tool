  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5Ke1kRNzBeyrIie2uqlMn">
    <skos:definition>Retention and Litigation Hold Management refers to the process of preserving and managing electronic data that may be relevant to a legal matter, in order to comply with legal obligations and avoid spoliation sanctions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
