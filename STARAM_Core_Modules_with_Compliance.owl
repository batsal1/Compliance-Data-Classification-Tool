  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Im228hLRRruCJ446SHxmtQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/yFs1pkk7QF6m3nfn1CBCRw"/>
    <rdfs:label>Document Preparation Services</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) letter or resume writing; (2) document editing or proofreading; (3) typing, word processing, or desktop publishing; and (4) stenography (except court reporting or stenotype recording), transcription, and other secretarial services.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561410"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/aJZF5F0hSQugkx6lQ5ELFQ">
