  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBrBYbsaP35Zqr9ZrYFHMda">
    <dc:identifier>IN-INDUSTRY-12.3</dc:identifier>
    <dc:identifier>MFG-CHEM</dc:identifier>
    <skos:altLabel>Chemical Manufacturing</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria química</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie chimique</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">化学製造業</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">化学制造业</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Chemische Industrie</skos:altLabel>
    <skos:hiddenLabel>CHEM</skos:hiddenLabel>
    <skos:definition>This industry group is based on the transformation of organic and inorganic raw materials by a chemical process and the formulation of products. It industry group includes establishments that make: chemicals, synthetic dyes, rubber, synthetic fibers, pesticides, fertilizers, paint, and cleaning materials.</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-MFG-CHEM</ns2:legacyIdentifier>
    <rdfs:label>Chemical Manufacturing Industry</rdfs:label>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:prefLabel>Chemical Manufacturing Industry</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOjgvcq6Z33XxMhTxWiiDS"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBKBnWyBmr5Hmg5T3VdTFxL">
    <skos:altLabel>Objection to Testimony Without Personal Experience</skos:altLabel>
    <skos:altLabel>No Direct Knowledge Objection</skos:altLabel>
    <skos:altLabel>Beyond Experience Objection</skos:altLabel>
    <dc:source>Fed. R. Evid. 602</dc:source>
    <rdfs:label>Lacks Personal Knowledge Objection</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEx7g3wSm7TRkpl2WQko0s"/>
    <rdfs:subClassOf rdf:nodeID="Nc90d6d5ebfdc4cc2a3f8268b1e59e56d"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Lacks Personal Knowledge Objection is raised when a party in a legal proceeding believes that a witness is testifying about matters beyond their direct experience or observation. This objection aims to ensure that testimony is based on firsthand knowledge and is reliable.</skos:definition>
  </rdf:Description>
