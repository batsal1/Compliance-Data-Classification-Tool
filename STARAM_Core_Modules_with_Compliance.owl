  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBYhRNuXhZViZ7pJ1utkcts">
    <skos:altLabel xml:lang="fr-fr">Avocat facturier</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Billing Solicitor</skos:altLabel>
    <skos:altLabel>Billing Shareholder</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बिलिंग वकील</skos:altLabel>
