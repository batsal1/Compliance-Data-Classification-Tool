    <skos:altLabel xml:lang="ja-jp">訴訟サポートベンダー費用</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kosten für Prozessunterstützungsdienstleister</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Gastos de proveedores de apoyo a litigios</skos:altLabel>
    <rdfs:label>Litigation Support Vendors Expense</rdfs:label>
    <skos:definition>Expenses incurred by vendors who provide support services to parties involved in a legal dispute, such as document management, e-discovery, and trial presentation services.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
