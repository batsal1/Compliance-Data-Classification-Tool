    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Foreign Representative</rdfs:label>
    <skos:definition>From U.S. Bankruptcy Court PACER</skos:definition>
    <skos:definition>A person or body authorized in a foreign proceeding to administer the reorganization or the liquidation of the debtor's assets or affairs or to act as a representative of such foreign proceeding. 11 U.S.C. § 101(24).</skos:definition>
  </rdf:Description>
