    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdfs:label>Individual Health Insurance Plan</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This is a health insurance policy purchased by an individual independently of an employer or government program. Coverage and costs vary widely depending on the plan chosen and the needs of the individual.</skos:definition>
