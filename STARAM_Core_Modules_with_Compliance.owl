  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9oTnyi9FomDmIeLK16ep8m">
    <skos:altLabel xml:lang="de-de">Klausel zur Grundsatzvereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo en Principio</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Agreement in Principle Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Acordo de Princípio</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכמה בעקרון</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">原则协议条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo en Principio</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">原則合意条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सिद्धांत में सहमति धारा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'accord de principe</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Agreement in Principle Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Agreement in Principle Clause is a provision in a contract that outlines the basic terms and conditions of an agreement that has not yet been finalized.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9L2shTy2cnDMS1sImF2PBy">
    <skos:altLabel xml:lang="pt-br">Indústria de tecnologia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Technology Industry</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית טכנולוגיה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">テクノロジー産業</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">技术产业</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Technologiebranche</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria Tecnológica</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie technologique</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रौद्योगिकी उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria Tecnológica</skos:altLabel>
    <skos:altLabel>Technology</skos:altLabel>
    <skos:hiddenLabel>TEC</skos:hiddenLabel>
    <dc:identifier>IN-INDUSTRY-12.4</dc:identifier>
    <dc:identifier>TEC</dc:identifier>
    <skos:prefLabel>Computer and Electronic Product Manufacturing Industry</skos:prefLabel>
    <rdfs:label>Computer and Electronic Product Manufacturing Industry</rdfs:label>
    <rdfs:label>Computer and Electronic Product Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBOjgvcq6Z33XxMhTxWiiDS"/>
    <skos:definition>Industries in the Computer and Electronic Product Manufacturing subsector group establishments that manufacture computers, computer peripherals, communications equipment, and similar electronic products, and establishments that manufacture components for such products.  The Computer and Electronic Product Manufacturing industries are combined in the hierarchy of NAICS because of their economic significance to the economies of all three North American countries.  For industries in this subsector, the manufacturing processes are fundamentally different from the manufacturing processes of other machinery and equipment.  The design and use of integrated circuits and the application of highly specialized miniaturization technologies are common elements in the production technologies of the Computer and Electronic Product Manufacturing subsector.</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-TEC</ns2:legacyIdentifier>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=334"/>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7tLK77FgJ4muzGREkJuEVd">
    <rdfs:label>tax_tier_amount_tax</rdfs:label>
    <skos:definition>"Tax amount resulting from TAX_TIER_DETAIL.tax_tier_rate* TAX_TIER_DETAIL.tax_tier_taxable_amount expressed in INVOICE.inv_currency.  If TAX.increase_decrease = Decrease for this TAX.tx_id, this will be a negative number.  
"</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBPwovGZw8ygaPhghSc1oMI"/>
  </rdf:Description>
