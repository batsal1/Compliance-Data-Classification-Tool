    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R76IAKqsqXlLQRs21W91S5o">
    <skos:altLabel xml:lang="he-il">תביעת זכויות בחירה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Voting Rights Claim</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Stimmrechtsklage</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">投票权主张</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de Derechos de Votación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de direitos de voto</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Derechos de Voto</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मताधिकार दावा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">投票権主張</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Action en revendication de droits de vote</skos:altLabel>
    <rdfs:label>Voting Rights Claim</rdfs:label>
    <skos:definition>A Voting Rights Claim is a legal assertion that an individual's right to vote has been violated, often based on discrimination or unequal treatment, and seeks to remedy the harm caused by such violation.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC4Pdxi5qe0Is3sCmIHT4ju"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L7kPrkn8q0VbbyH4lv1VJ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RthkEiKYxt3o1thUAdbzh7">
    <skos:definition>A Reserved Power Clause claim is a legal assertion related to the Tenth Amendment of the United States Constitution, which reserves to the states or the people any powers not specifically delegated to the federal government or prohibited to the states by the Constitution. This clause forms the basis of federalism, the division of power between the federal government and the states. A claim involving this clause typically arises when there is a dispute over whether a power exercised by the federal government infringes on powers reserved to the states or the people.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="he-il">תביעת סעיף כוח מורשה מראש</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de poder reservado</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de clause de pouvoir réservé</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Vorbehaltsrechtsklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रिजर्व्ड पावर क्लॉज क्लेम</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Poder Reservado</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">留保権条項クレーム</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reserved Power Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保留权条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Poder Reservado</skos:altLabel>
    <rdfs:label>Reserved Power Clause Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB0OjYiZ6X1hMIZOMK1KqhB"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8c1jYVCuUZo8YxduUkgPxY">
    <skos:altLabel xml:lang="hi-in">उपकरण धारा</skos:altLabel>
