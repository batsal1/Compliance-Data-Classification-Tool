    <rdfs:label>Permitted Disclosure Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Permitted Disclosure Clause is a provision in a contract that allows for the sharing of confidential information between parties under certain circumstances.</skos:definition>
  </rdf:Description>
