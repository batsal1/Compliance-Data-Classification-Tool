  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBQUxdVkxYCRp3CYhe9qnyS">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pdzW3m7BhNJzoxFi57s70"/>
    <skos:definition>An American Call Option Style is an option contract that grants the holder the right to purchase the underlying asset at a specified strike price at any time between the purchase date and the expiration date. This flexibility allows the holder to benefit from favorable price movements in the underlying asset at any point during the option's life.</skos:definition>
    <rdfs:label>American Call Option Style</rdfs:label>
    <skos:prefLabel>American-Style Call Option</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R81SeVD4T2SxJDsbPSIoQeE">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9oz08cWJcI23x0nYU1h0it"/>
    <skos:altLabel xml:lang="de-de">Klausel zur Entschädigung bei Ansprüchen Dritter</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de indemnización por reclamaciones de terceros</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">तीसरे पक्ष के दावों के लिए भरपाई क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de indemnización por reclamaciones de terceros</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">第三者請求に対する補償条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'indemnisation pour les réclamations de tiers</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">第三方索赔赔偿条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פיצויים לתביעות של צד שלישי</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Indemnification for Third Party Claims Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de indenização por reivindicações de terceiros</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A provision in a contract that requires one party to compensate and defend the other party against any claims made by a third party.</skos:definition>
    <rdfs:label>Indemnification for Third Party Claims Clause</rdfs:label>
  </rdf:Description>
