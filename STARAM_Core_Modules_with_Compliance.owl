    <skos:altLabel xml:lang="zh-cn">价格上涨条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Escalación de Precios</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Escalación de Precios</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Preisanpassungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Price Escalation Clause</skos:altLabel>
