  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R94yxXVadPVTE4IW7iABVRc">
    <skos:altLabel xml:lang="de-de">Berufungsverfahrenslegitimation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Legitimación procesal en apelación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Legitimidade processual recursal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">上诉程序资格</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות עמידה בפני בית הערעור</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Appellate Procedural Standing</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अपीलीय प्रक्रियात्मक खड़े होने की स्थिति</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Legitimación procesal en apelación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Qualité pour agir en procédure d'appel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">控訴手続きにおける立証能力</skos:altLabel>
    <rdfs:label>Appellate Procedural Standing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDhSx7fl9qS0ezDVJuZHX4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy>PACER</rdfs:isDefinedBy>
    <skos:definition>The concept of Appellate Procedural Standing refers to the legal right of a party to bring an appeal in a higher court, based on the specific procedural requirements and rules governing such appeals.</skos:definition>
  </rdf:Description>
