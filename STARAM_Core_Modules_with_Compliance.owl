    <skos:altLabel xml:lang="ja-jp">金銭的損害賠償</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Monetary Damages</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Daños y perjuicios monetarios</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">货币损害赔偿</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nbdce065f30d94159af0919011166a8d1"/>
