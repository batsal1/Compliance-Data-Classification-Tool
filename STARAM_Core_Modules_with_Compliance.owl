  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7i00MVak7HQPsePKrHq2WF">
    <skos:altLabel>Lease Service</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול השכירות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lease Practice</skos:altLabel>
    <skos:altLabel>Lease</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租赁实践</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verpachtungspraxis</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de location</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">リース実務</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de locação</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लीज़ अभ्यास</skos:altLabel>
    <skos:altLabel>Leasing</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de arrendamiento</skos:altLabel>
    <skos:hiddenLabel>LEA</skos:hiddenLabel>
    <rdfs:label>Lease Practice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RKzL5nW7IGg4mvAPFX2MUL"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Proc-T-LEA</ns2:legacyIdentifier>
    <skos:definition>A contract by which one party (landlord, or lessor) gives to another (tenant, or lessee) the use and possession of lands, buildings, property, etc. for a specified time and for fixed payments.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Leasing Practice</skos:prefLabel>
    <dc:identifier>T-LEA</dc:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7VRaoAh9ayMTR0GEuSF2S9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9RgfP9So7I6U6ug0d6MSHA"/>
    <skos:definition>Regulatory Filing Management refers to the process of managing and submitting required documents and information to regulatory authorities in order to comply with legal and regulatory requirements.</skos:definition>
    <rdfs:label>Regulatory Filing Management</rdfs:label>
  </rdf:Description>
