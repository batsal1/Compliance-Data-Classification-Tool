  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBBqzbaCc2sDtwMhCHYXUi">
    <rdfs:label>Maintenance and Cure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9iUJ1YX0zK3V9D0RbQKTP4"/>
    <rdfs:subClassOf rdf:nodeID="N4d1fb489ec4d4a0c81af3b1db968c5d1"/>
