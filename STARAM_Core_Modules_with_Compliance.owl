    <skos:altLabel xml:lang="es-mx">Permanencia de la Dependencia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवलंबन स्थायित्व</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Abhängigkeitsdauer</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">依赖永久性</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">依存永続性</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Permanência da dependência</skos:altLabel>
    <rdfs:label>Child Dependency Permanency</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Dependency Permanency refers to the legal remedies, relief, and penalties related to the options available for a child's living arrangements when they cannot remain with their biological parents, including APPLA, return to parent, TPR, and adoption.</skos:definition>
    <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
