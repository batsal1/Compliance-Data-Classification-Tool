  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RGrXuVATYPRc56MkpFulP9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Einvernehmliche Pfandrecht</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Penhor consensual</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">协议留置权</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Prenda consensual</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सहमतिपूर्ण लियन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעצור רשותי</skos:altLabel>
