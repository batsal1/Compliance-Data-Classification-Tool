  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RgHUj7ZKoJL0s6JURcX8OI">
    <rdfs:label>Suspension of Sentence</rdfs:label>
    <skos:prefLabel>Suspended Sentence</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="N67ffc61254c44b91bb707e8d041107b7"/>
    <rdfs:subClassOf rdf:nodeID="N51d044f547c44bc0a70122110dc9f93f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8fFf9YNTCtz4Q15Jjj7AXF"/>
    <skos:altLabel>Stay of Execution</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Suspension of Sentence is a legal provision where a court imposes a sentence but delays or refrains from executing it, typically on certain conditions. This approach allows the offender to remain in the community under supervision, with the understanding that violating the conditions may result in the original sentence being imposed.</skos:definition>
  </rdf:Description>
