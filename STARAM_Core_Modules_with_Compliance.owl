    <skos:notation>folio:respondedTo</skos:notation>
    <rdfs:label>sali:respondedTo</rdfs:label>
    <rdfs:label>respondedTo</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/4ZY5iOuHRoenJQr_ldjsrQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=712130"/>
    <skos:example>Arboreta</skos:example>
    <skos:example>Aquariums</skos:example>
    <skos:example>Wild animal parks</skos:example>
    <skos:example>Zoological gardens</skos:example>
    <skos:example>Aviaries</skos:example>
    <rdfs:label>Zoos and Botanical Gardens</rdfs:label>
