  <rdf:Description rdf:about="https://folio.openlegalstandard.org/2pQdeLYrQdaSmmDRN9-_jQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=812990"/>
    <skos:example>Consumer buying services</skos:example>
    <skos:example>Bail bonding or bondsperson services</skos:example>
    <skos:example>Wedding planning services</skos:example>
    <skos:example>Coin- or card-operated personal services machine (e.g., blood pressure, locker, photographic, scale, shoeshine) concession operators</skos:example>
    <skos:example>Personal fitness training services</skos:example>
    <skos:example>Shoeshine services</skos:example>
    <skos:example>Social escort services</skos:example>
    <skos:example>Dating services</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Orm6gQnCQtCtnWYEOSFWyg"/>
    <rdfs:label>All Other Personal Services</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in providing personal services (except personal care services, death care services, drycleaning and laundry services, pet care services, photofinishing services, or parking space and/or valet parking services).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
