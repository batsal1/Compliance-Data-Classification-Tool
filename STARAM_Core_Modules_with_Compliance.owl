  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBt3Kyn3iW32LWSjKBgKL9U">
    <skos:definition>From U.S. District Court PACER</skos:definition>
    <skos:definition>A person who is authorized to maintain legal custody of a person or property.</skos:definition>
    <skos:altLabel xml:lang="es-es">Custodio</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रखवाला</skos:altLabel>
