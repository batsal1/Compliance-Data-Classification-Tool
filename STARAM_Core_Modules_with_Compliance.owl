  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-assignment-subcontracting">
    <rdfs:label xml:lang="en">Assignment, Subcontracting &amp; Flow-Down</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-execution"/>
    <skos:relatedMatch rdf:resource="https://staram.in/ontology/epc/taxonomy#alloc-legal-liability"/>
    <skos:definition xml:lang="en">Risks in the delivery chain, covering consent to assign the contract, approval of subcontractors, gaps in back-to-back terms, novation, vicarious liability, and assignment of receivables.</skos:definition>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Assignment, Subcontracting &amp; Flow-Down</skos:prefLabel>
    <skos:notation>LR-15</skos:notation>
  </rdf:Description>
