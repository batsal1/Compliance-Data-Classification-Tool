  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7MXUsspwVFhBmhwbAGdnil">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSRxb9psAJdqf8rppoiYI8"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGm7jrTspmRi606c5XWZ1z"/>
    <skos:altLabel xml:lang="zh-cn">公证人因疏忽承认而承担责任</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公証人の過失承認に対する責任</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité de l'officier public de notaire pour reconnaissance négligente</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung des Notarbeamten für fahrlässige Anerkennung</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Notary Public Officer Liability for Negligent Acknowledgment</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad del Notario Público por Reconocimiento Negligente</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade do oficial público do notário por reconhecimento negligente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad del Notario Público por Reconocimiento Negligente</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות עו"ד רשמי עבור הכרה שגויה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गैर-सावधान अधिकारी के लिए नोटरी पब्लिक जिम्मेदारी</skos:altLabel>
    <skos:definition>The liability of a notary public officer for negligent acknowledgment refers to the legal responsibility of such an officer for making a mistake or error while performing an acknowledgment, which can result in a malpractice claim or a judicial and procedural tort claim.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Notary Public Officer Liability for Negligent Acknowledgment</rdfs:label>
  </rdf:Description>
