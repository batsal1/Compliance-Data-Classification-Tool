    <skos:altLabel xml:lang="fr-fr">Industrie des systèmes d'eau, d'assainissement et autres</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">水道・下水道およびその他のシステム産業</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de Sistemas de Água, Esgoto e Outros</skos:altLabel>
