  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RIID6TwX1zfh0pWeJjeDrF">
    <skos:altLabel>Architectural Review</skos:altLabel>
    <skos:altLabel>Design Review</skos:altLabel>
    <skos:altLabel>Urban Design Assessment</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Design Approval Process</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxq2qQYpdo9stHOBIQhub7"/>
    <skos:definition>Real Estate Design Review is the process by which proposed architectural and site designs for a development project are evaluated for their adherence to local design standards, aesthetics, and land use compatibility. This review is usually conducted by a designated committee or governing body and may involve public hearings, expert consultations, and revisions to the initial plans.</skos:definition>
    <rdfs:label>Real Estate Design Review</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R96XGzKASNrV6ZQLc0btgHj">
    <rdfs:label>Ability to Work</rdfs:label>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDNsW4JqaHcQ9KPtpXLzCPc"/>
    <skos:definition>Ability to work refers to an individual's physical and mental capacity to perform tasks required for specific jobs or professions. This criterion is often assessed in the context of eligibility for disability or unemployment benefits, as well as in employment settings.</skos:definition>
  </rdf:Description>
