  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDGR7PTYD8TltxEq0F8NGIR">
    <skos:altLabel xml:lang="ja-jp">証人直接尋問</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गवाह का सीधा पूछताछ</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Interrogatoire direct du témoin</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חקירה ישירה של עד</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Examen Directo del Testigo</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Direct-Examination of Witness</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Examen Directo del Testigo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">证人直接询问</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interrogatório direto da testemunha</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Direkte Befragung des Zeugen</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Ne2f1ca7769cf4d7e9979280b815bbb53"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7R1YAozFcvfvIX32msHyay"/>
    <rdfs:label>Direct-Examination of Witness</rdfs:label>
    <skos:definition>The Direct-Examination of Witness is a legal practice that involves questioning a witness by the party who called them to testify, in order to elicit testimony that supports their case.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
