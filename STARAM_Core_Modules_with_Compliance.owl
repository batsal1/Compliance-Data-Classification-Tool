    <rdfs:subClassOf rdf:nodeID="N619ea81dc4314b15be0668ac732204fa"/>
    <skos:definition>A Drivers Privacy Protection Act Claim is a legal claim that arises from the violation of the federal law that regulates the disclosure of personal information contained in motor vehicle records.</skos:definition>
    <rdfs:label>Drivers Privacy Protection Act Claim</rdfs:label>
  </rdf:Description>
