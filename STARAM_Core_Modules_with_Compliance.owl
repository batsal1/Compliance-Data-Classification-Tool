  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7MRIM3vshGlEUKpDuyXkBr">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e"/>
    <skos:example>Standard &amp; Poor's 500 Index</skos:example>
    <skos:example>Dow Jones Industrial Average</skos:example>
    <skos:example>Financial Times Stock Exchange 100 Index</skos:example>
    <skos:example>Dow 30</skos:example>
    <skos:example>FTSE 100 Index</skos:example>
    <skos:example>S&amp;P 500</skos:example>
    <skos:example>Nasdaq Composite Index</skos:example>
    <skos:altLabel>Market Index</skos:altLabel>
    <skos:altLabel>Stock Market Index</skos:altLabel>
    <skos:altLabel>Market Indicator</skos:altLabel>
    <skos:prefLabel>Investment Market Index</skos:prefLabel>
    <rdfs:label>Financial Market Index</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Financial Market Index is a statistical measure that reflects the composite value of a selected group of stocks, bonds, or other financial instruments, representing a specific market or sector. Examples include the S&amp;P 500 Index, which tracks the performance of 500 large-cap U.S. companies, and the Dow Jones Industrial Average (DJIA), which measures the stock performance of 30 prominent U.S. companies.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R3N9erYNAUdTJqPeT1fju0">
    <skos:definition>An Extension of Term Clause is a provision in a contract that allows for the lengthening of a specified period of time beyond its original expiration date.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="zh-cn">期限延长条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הארכת תקופה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de prorrogação de prazo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Extensión de Plazo</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Extensión de Plazo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Verlängerung der Frist</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Extension of Term Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समय अवधि बढ़ाने की शर्त अनुच्छेद</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de prolongation de terme</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">期間延長条項</skos:altLabel>
    <rdfs:label>Extension of Term Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFanQiAnBUnqQS4PNIuJao"/>
  </rdf:Description>
