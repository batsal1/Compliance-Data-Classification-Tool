  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMDptTKAPE4Nk8RRmz1BaE">
    <skos:altLabel xml:lang="hi-in">प्रोस्पेक्टिव आर्थिक लाभ के साथ लापरवाह विवदास्पद हस्तक्षेप</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Interference with Prospective Economic Advantage</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia Negligente con la Perspectiva de Beneficio Económico</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia Negligente con la Perspectiva de Beneficio Económico</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התערבות שגויה בפוטנציאל הכלכלי העתידי</skos:altLabel>
    <skos:definition>The concept of Negligent Interference with Prospective Economic Advantage refers to a situation where a party's careless actions cause harm to another party's potential economic opportunities.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RTWpoh9tHMCjgHHoS1igdV"/>
    <rdfs:label>Negligent Interference with Prospective Economic Advantage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCoPjsM1Gd6Ra4z053jBObw">
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a conflictos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Conflict Waiver Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Konfliktverzichtsklausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור מסכסוך</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">冲突豁免条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation au conflit</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia a conflitos</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia a conflictos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">紛争棄却条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संघर्ष वेवर क्लॉज</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Conflict Waiver Clause is a provision in a contract that requires the parties to waive any potential conflicts of interest that may arise during the course of their relationship.</skos:definition>
    <rdfs:label>Conflict Waiver Clause</rdfs:label>
  </rdf:Description>
