  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBKAwwAzIOYxNJwmaMS0h9L">
    <skos:definition>Stand Your Ground Law is a type of legislation that permits individuals to use force, including deadly force, to defend themselves without any obligation to retreat or flee if they believe they are in imminent danger of serious harm or death.</skos:definition>
    <skos:altLabel>No Duty to Retreat</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Stand Your Ground Law</rdfs:label>
  </rdf:Description>
