  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBJVPkhBi7K5BLh6864GAZT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legalruleml/ns/v1.0/metamodel"/>
    <rdfs:label xml:lang="en">prohibition</rdfs:label>
    <rdfs:label>oasis:Prohibition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R969M34LEgPe5hm59rdksmi"/>
    <skos:definition>A prohibition is a type of deontic specification in the OASIS ontology, indicating that an action or behavior is not allowed or prohibited.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N05a66303a58845859fb8f4350a7aee08">
