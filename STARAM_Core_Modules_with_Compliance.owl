  <rdf:Description rdf:about="https://folio.openlegalstandard.org/6PhkFjpASI2yP-36CyygEA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81119"/>
    <skos:example>Automotive air-conditioning repair shops</skos:example>
    <skos:example>Automotive oil change and lubrication shops</skos:example>
    <skos:example>Automotive tire repair (except retreading) shops</skos:example>
    <skos:example>Automotive rustproofing and undercoating shops</skos:example>
    <skos:example>Car washes</skos:example>
    <rdfs:label>Other Automotive Repair and Maintenance</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in providing automotive repair and maintenance services (except mechanical and electrical repair and maintenance and body, paint, interior, and glass repair) for automotive vehicles, such as passenger cars, trucks, and vans, and all trailers.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Q0Apwmq4R0C0PGdxFiso7Q"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/bCP5M_IYQRO22fkQNM1X-g">
