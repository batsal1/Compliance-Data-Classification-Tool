  <rdf:Description rdf:about="https://folio.openlegalstandard.org/sM1lTysdQ6CQlI1tB3eCdA">
    <rdfs:label>Administration of Veterans' Affairs</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/kCdDtru2Q-e1BNBNmK5ztA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=923140"/>
    <skos:definition>This industry comprises government establishments primarily engaged in the administration of programs of assistance, training, counseling, and other services to veterans and their dependents, heirs, or survivors. Included in this industry are Veterans' Affairs offices that maintain liaison and coordinate activities with other service organizations and governmental agencies.</skos:definition>
  </rdf:Description>
