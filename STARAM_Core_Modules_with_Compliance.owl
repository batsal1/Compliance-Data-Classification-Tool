  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7U11pwkJfQSG7FGXqyIrTE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Statement for Purposes of Medical Diagnosis or Treatment</skos:altLabel>
    <skos:prefLabel>Medical Diagnosis Statement</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R1EbxjQwzgikspixQygdfK"/>
    <dc:source>Fed. R. Evid. 803(4)</dc:source>
    <skos:definition>A Medical Treatment Statement is a hearsay exception that allows the admission of statements made for purposes of medical diagnosis or treatment. This exception is based on the belief that statements made to medical professionals are likely to be truthful because the declarant has a strong motivation to provide accurate information to receive proper care.</skos:definition>
    <rdfs:label>Medical Treatment Statement</rdfs:label>
  </rdf:Description>
