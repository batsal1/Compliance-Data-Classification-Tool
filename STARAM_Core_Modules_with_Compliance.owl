  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4GDJu8v0mhIoymjh7IZoS">
    <skos:altLabel xml:lang="es-es">Jurisdicción personal por intereses relacionados con la propiedad</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Persönliche Gerichtsbarkeit durch verwandte Sachinteressen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Related Property Interests</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción personal por intereses relacionados con la propiedad</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שיפוט אישי על ידי ענייני רכוש קשורים</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por interesses relacionados à propriedade</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par intérêts immobiliers connexes</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">関連財産利益による個人管轄権</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संबंधित संपत्ति हितों द्वारा व्यक्तिगत अधिकरण</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">相关财产利益的个人管辖权</skos:altLabel>
    <rdfs:label>Personal Jurisdiction by Related Property Interests</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7X4vuBVsbGf69DAu7Xotdw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Personal Jurisdiction by Related Property Interests" refers to the authority of a court to hear a case based on a defendant's connection to a particular property, such as ownership or possession, within the court's jurisdiction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1f05e5e741874245ab77c60af3ef35d3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RuNRzptxqnjdnI9WDZmYYC"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rn9n503V7B3fFkOQdslUns">
    <skos:altLabel xml:lang="zh-cn">普通管辖权</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य अधिकारिक अधिक्रमण</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">General Jurisdiction</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שיפוט כללי</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juridiction générale</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Jurisdicción General</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Allgemeine Gerichtsbarkeit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">一般裁判権</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción General</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jurisdição geral</skos:altLabel>
    <skos:definition>General Jurisdiction refers to a court's authority to hear and decide a wide range of legal cases, including those that are not related to a specific geographic location or personal connection to the court.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>General Jurisdiction</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RinqHf65TtUhr762WKqN6R"/>
  </rdf:Description>
