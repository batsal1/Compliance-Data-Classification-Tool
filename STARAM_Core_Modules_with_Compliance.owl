    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RYyEVcMl7Akp5dgjOkQdI5">
    <skos:altLabel xml:lang="ja-jp">ロイヤリティ支払い条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de pago de regalías</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de paiement de redevances</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Zahlung von Lizenzgebühren</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रॉयल्टी भुगतान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de pagamento de royalties</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תשלום זכויות יוצרים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de pago de regalías</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Royalty Payment Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">版税支付条款</skos:altLabel>
    <rdfs:label>Royalty Payment Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A royalty payment clause is a provision in a contract that outlines the terms and conditions for payment of royalties, which are payments made to the owner of a property or asset for its use or exploitation by another party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8aVRgLAjmuf0OiloIoc9pm">
    <rdfs:label>Semi-Proportional Electoral System</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7OQ65vKuOBSSGgSVYnoMfx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A semi-proportional electoral system is a voting method that seeks to balance majority rule with proportional representation, allowing for more accurate reflection of voter preferences while still favoring larger parties. Examples include limited voting, cumulative voting, single non-transferable vote, and modified Borda count, which each employ different mechanisms to achieve this balance.</skos:definition>
  </rdf:Description>
