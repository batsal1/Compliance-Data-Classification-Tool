    <skos:altLabel xml:lang="en-gb">Preliminary Injunction</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रारंभिक अवरोध</skos:altLabel>
    <skos:altLabel>Temporary Injunction</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">injunção preliminar</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">初步禁令</skos:altLabel>
    <skos:altLabel>Provisional Injunction</skos:altLabel>
    <skos:altLabel>Interlocutory Injunction</skos:altLabel>
    <skos:altLabel>Impermanent Injunction</skos:altLabel>
    <skos:altLabel>Interim injunction</skos:altLabel>
    <skos:altLabel xml:lang="de-de">einstweilige Verfügung</skos:altLabel>
    <skos:altLabel>Injunction Pendente Lite</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Medida Cautelar</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Medida Cautelar</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rhwkH0GU868poYsoFKzVb"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFXc2NtinmfJhHDBnbVgVN"/>
    <skos:definition>A Preliminary Injunction is a temporary court order that prohibits a party from taking certain actions until a final decision is made in a legal matter.</skos:definition>
    <rdfs:label>Preliminary Injunction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBZ9yZcHqV6d68U1Fue6KQk">
    <skos:altLabel xml:lang="zh-cn">友好解决条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo Amistoso</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">円満解決条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פיצול ידידותי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur gütlichen Einigung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de règlement amiable</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मैत्रीपूर्ण विनिर्णय धारा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Acordo Amigável</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo Amistoso</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Amicable Settlement Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Amicable Settlement Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An amicable settlement clause is a provision in a contract that requires the parties to attempt to resolve any disputes through negotiation or mediation before pursuing legal action.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCX3HwOMFSz6vLwgDSWfkvt">
    <skos:altLabel xml:lang="he-il">תביעה מחוץ לשעות העבודה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation hors temps de travail</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">下班后索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação fora do horário de trabalho</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऑफ-द-क्लॉक दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch außerhalb der Arbeitszeit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">業務外時間請求</skos:altLabel>
    <skos:altLabel>Off the Clock Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación fuera de horario</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Off-the-Clock Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación fuera de horario</skos:altLabel>
    <rdfs:label>Off-the-Clock Claim</rdfs:label>
    <skos:definition>An off-the-clock claim is a legal action initiated by an employee who alleges that their employer required them to perform work-related tasks outside of their normal working hours without providing appropriate compensation, such as overtime pay. These tasks can include checking work emails or taking work-related phone calls outside of work hours, or completing work assignments after clocking out for the day. The claim typically arises when an employer does not comply with applicable wage and hour laws, which require employers to compensate employees for all hours worked, including overtime.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
  </rdf:Description>
