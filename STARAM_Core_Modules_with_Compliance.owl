    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Carpet and Rug Mills</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/iSGv6BT_Tm-SHEN-3kx-EQ"/>
    <skos:definition>This industry comprises establishments primarily engaged in (1) manufacturing woven, tufted, and other carpets and rugs, such as art squares, floor mattings, needlepunch carpeting, and door mats and mattings, from textile materials or from twisted paper, grasses, reeds, sisal, jute, or rags and/or (2) finishing carpets and rugs.</skos:definition>
  </rdf:Description>
