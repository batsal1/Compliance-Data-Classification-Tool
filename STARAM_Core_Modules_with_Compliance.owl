    <ns1:contractFamily xml:lang="en">Litigation, Settlement &amp; Release</ns1:contractFamily>
    <skos:definition>Litigation Related Agreements are contracts associated with disputes, their resolution, and related legal processes. These agreements can dictate the terms, conditions, and procedures to avoid or end litigation.</skos:definition>
    <rdfs:label>Litigation Agreements</rdfs:label>
