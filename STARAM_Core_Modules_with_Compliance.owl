  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R2CDLqGsq2NxKpqHxWMt3R">
    <rdfs:label>Deep Fake</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa"/>
    <skos:definition>A deep fake is AI-generated or manipulated image, audio, or video content that resembles existing persons, objects, places, or other entities or events and would falsely appear to a person to be authentic or truthful. These technologies can create highly realistic but deceptive representations that can be used for malicious purposes.</skos:definition>
    <skos:altLabel>AI-Generated Fake</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBY4j5UKZ7L8gp0q9Wrxyge">
    <rdfs:label>Employment Classification</rdfs:label>
    <skos:altLabel>Worker Classification</skos:altLabel>
    <skos:definition>Worker Classification refers to the categorization of an employee's work status within an organization, often defined as full-time, part-time, or contractor. These classifications dictate the terms of employment, including benefits eligibility, tax implications, and legal obligations between the employer and employee.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGOU62BPz1QTVsWRE2Nodz"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RZFmpLgHKgrH82Z6qGFkJa">
    <skos:definition>The act of making a reproduction of a document or other material, typically for the purpose of retaining a record or for distribution to others, which is categorized as an expense.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
    <rdfs:label>E101 Copying</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
