  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8qwdsgAn7Q1AOzytfyjNOw">
    <rdfs:label>Shareholding Structure Clause</rdfs:label>
    <skos:altLabel xml:lang="hi-in">शेयरहोल्डिंग संरचना शर्त</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Beteiligungsstruktur</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Shareholding Structure Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de estrutura acionária</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">股权结构条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מבנה הבעלות במניות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de structure d'actionnariat</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de estructura accionarial</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">株式所有構造条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de estructura accionarial</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Shareholding Structure Clause is a provision in a contract that outlines the ownership and distribution of shares in a company among its shareholders.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
