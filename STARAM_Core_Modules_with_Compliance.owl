    <rdfs:label>Reduced Life Expectancy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV"/>
    <skos:definition>Reduced Life Expectancy: A type of non-economic damages in a legal matter where the plaintiff's life expectancy is shortened due to the defendant's actions or negligence.</skos:definition>
  </rdf:Description>
