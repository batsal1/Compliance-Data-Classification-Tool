  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC9gxTda2u80ExW6y0El4YK">
    <skos:altLabel xml:lang="fr-fr">Industrie des matériaux de construction et des équipements de jardin</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">建筑材料和园艺设备行业</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भवन सामग्री और बागवानी उपकरण उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Building Material and Garden Equipment Industry</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de materiales de construcción y equipos de jardinería</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית חומרי בניין וציוד גינון</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Baumaterial- und Gartenbauindustrie</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de materiales de construcción y equipos de jardinería</skos:altLabel>
    <skos:altLabel>Building Material and Garden Equipment</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">建材・園芸機器産業</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de materiais de construção e equipamentos de jardim</skos:altLabel>
    <skos:hiddenLabel>BMGD</skos:hiddenLabel>
    <skos:definition>Industries in the Building Material and Garden Equipment and Supplies Dealers subsector retail new building materials, hardware, paint, and garden and outdoor power equipment and supplies.  Establishments in this subsector with fixed point-of-sale locations, including home centers and retail lumber yards, may display merchandise either indoors or outdoors under covered areas.  The staff is usually knowledgeable in the use of the specific products being retailed in the construction, repair, and maintenance of the home and associated grounds.</skos:definition>
    <dc:identifier>IN-INDUSTRY-17.1</dc:identifier>
    <dc:identifier>RET-BMGD</dc:identifier>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <rdfs:label>Building Material and Garden Equipment and Supplies Dealers Industry</rdfs:label>
    <rdfs:label>Building Material and Garden Equipment and Supplies Dealers</rdfs:label>
    <skos:prefLabel>Building Material and Garden Equipment and Supplies Dealers Industry</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=444"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-RET-BMGD</ns2:legacyIdentifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC2yZjilzMLJoDOQDudrD8o">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="es-mx">Cláusula de Derechos de Autor</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">版权条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit d'auteur</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Urheberrechtsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Derechos de Autor</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">著作権条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכויות יוצרים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कॉपीराइट क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Copyright Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de direitos autorais</skos:altLabel>
    <skos:definition>A Copyright Clause is a provision in a contract that outlines the ownership and usage rights of a creative work, such as a book or a song.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Copyright Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RhxDxh9s5K4frlHSAtxM5n">
    <skos:altLabel xml:lang="ja-jp">年次ボーナス資格条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'éligibilité au bonus annuel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">年度奖金资格条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de elegibilidad para bonificación anual</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכאות לקבלת פרס שנתי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de elegibilidade para bônus anual</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Annual Bonus Eligibility Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de elegibilidad para bono anual</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur jährlichen Bonusberechtigung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वार्षिक बोनस पात्रता शर्त</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A provision in a contract that outlines the conditions under which an employee is eligible to receive an additional payment on an annual basis.</skos:definition>
    <rdfs:label>Annual Bonus Eligibility Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBukB9MGGdY4Kwx3b6itiwi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="zh-cn">责任限制条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Limitation of Liability Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Limitación de Responsabilidad</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftungsausschlussklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Limitación de Responsabilidad</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הגבלת אחריות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de limitação de responsabilidade</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">責任制限条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उत्तरदायित्व की सीमा बाधा अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de limitation de responsabilité</skos:altLabel>
    <skos:definition>A Limitation of Liability Clause is a provision in a contract that limits the amount of damages that one party can be held liable for in the event of a breach or other legal claim.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZVXNAbvbm2JirFGPT4Ihy"/>
    <rdfs:label>Limitation of Liability Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9LFpbbSQYInrAdT45K8jPS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
    <rdfs:label>E110 Out-of-town travel</rdfs:label>
    <skos:definition>Expenses incurred for travel outside of the employee's usual work location.</skos:definition>
  </rdf:Description>
