    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A severability clause is a provision in a contract that states that if any part of the contract is found to be invalid or unenforceable, the rest of the contract will remain in effect.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
