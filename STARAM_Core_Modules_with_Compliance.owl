  <rdf:Description rdf:about="https://staram.in/ontology/epc#RiskHead">
    <rdfs:label xml:lang="en">Risk Head</rdfs:label>
    <skos:definition xml:lang="en">A contract-independent, reusable archetype of a legal or commercial risk, as catalogued in a risk register and used as a review checklist item.</skos:definition>
    <skos:example xml:lang="en">'LD Cap Absent or Excessive' (Sl. No. 59 of the Legal Risk Register 200).</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N5b180fe088714fb2a8b326540861e9b1"/>
