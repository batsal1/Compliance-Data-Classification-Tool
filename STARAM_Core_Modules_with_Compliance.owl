    <rdfs:label>Salvage</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Salvage refers to the legal remedy of recovering property or goods that have been lost or damaged, typically through the efforts of a third party who is entitled to compensation for their services.</skos:definition>
  </rdf:Description>
