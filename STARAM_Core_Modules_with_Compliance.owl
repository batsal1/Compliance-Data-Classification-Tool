  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Jm44LczZQeaLf-mLXYn4WA">
    <skos:definition>This industry group comprises establishments primarily engaged in providing short-term lodging in facilities, such as hotels, motels, casino hotels, and bed-and-breakfast inns. In addition to lodging, these establishments may provide a range of other services to their guests.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=7211"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCJn3atbap7QaYJjysSsJ1P"/>
    <rdfs:label>Traveler Accommodation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne2f08b6919d04a7d93644b96f791cec4">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Confidentiality"/>
