    <skos:altLabel xml:lang="hi-in">अतिरिक्त उपलब्धता</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Disponibilidade em excesso</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Disponibilidad excedente</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过剩可用性</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Excess Availability</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זמינות חורגת</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Disponibilidad excedente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">余剰可用性</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R74IJAT8MHMqUZeBJR7txV1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>"Excess Availability" Definition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/-YMvXxl2S0SCYd_nLyY58Q">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/-GOKvKWcSEShOMp5Y2jhmQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in raising sheep and lambs, or feeding lambs for fattening. The sheep or lambs may be raised for sale or wool production.</skos:definition>
