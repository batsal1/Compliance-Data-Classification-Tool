  <rdf:Description rdf:about="https://folio.openlegalstandard.org/kxWBpMLoQDumxMOVKEhB_g">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333993"/>
    <rdfs:label>Packaging Machinery Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing packaging machinery, such as wrapping, bottling, canning, and labeling machinery.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/z92pj9hTTd2-Vgl3rH8XfQ"/>
