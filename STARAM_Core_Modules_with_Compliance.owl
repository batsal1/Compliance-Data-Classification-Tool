    <skos:altLabel xml:lang="zh-cn">独立承包商法</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוק קבלן עצמאי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ley de Contratistas Independientes</skos:altLabel>
