  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7wsLtBraH6Dx1GyHgB0h0x">
    <skos:altLabel xml:lang="en-gb">Tender Offer</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">टेंडर ऑफर</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">株式公開買付け</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Oferta pública de aquisição</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Offre publique d'achat</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Oferta Pública de Adquisición (OPA)</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">要约收购</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Oferta Pública de Adquisición (OPA)</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצעת רכישה ציבורית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Übernahmeangebot</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Rdvjz7Q76QLZXnSJ66z40"/>
    <rdfs:label>Tender Offer</rdfs:label>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <skos:definition>A tender offer is a type of M&amp;A deal structure where the acquiring company offers to purchase a significant portion or all of the target company's shares at a premium price, usually with the goal of gaining control of the target company.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Wr4hG8vwC8fkSaCK9ZhOz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Subsidized Housing</skos:prefLabel>
    <skos:definition>Housing public benefit programs refer to government initiatives that provide assistance to individuals or families in obtaining affordable and safe housing. These programs often include subsidies, vouchers, or direct assistance to help low-income or vulnerable populations access housing that meets their needs. The specific eligibility criteria, types of assistance, and regulations governing such programs can vary widely by jurisdiction.</skos:definition>
    <rdfs:label>Public Housing Benefit</rdfs:label>
    <skos:altLabel>Public Housing</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#CapitalizedTerms">
    <rdfs:label xml:lang="en">Capitalized Terms</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:exactMatch rdf:resource="https://folio.openlegalstandard.org/RXXpBE98TBttHxMYU6TasA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
