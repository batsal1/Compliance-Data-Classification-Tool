  <rdf:Description rdf:about="https://folio.openlegalstandard.org/7UU9Y21ORUeNIoUBr_tXMQ">
    <skos:definition>Travelers' check issuance services</skos:definition>
    <skos:definition>This industry comprises establishments primarily engaged in facilitating credit intermediation (except mortgage and loan brokerage; and financial transactions processing, reserve, and clearinghouse activities).</skos:definition>
