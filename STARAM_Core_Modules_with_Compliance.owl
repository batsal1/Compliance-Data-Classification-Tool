    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8bs2IGOdHj0EAVOmcrj2WO"/>
    <skos:definition>Post-Trial Submission Practice refers to the legal activities and procedures that take place after a trial has concluded, such as filing motions, briefs, and other documents with the court.</skos:definition>
    <rdfs:label>Post-Trial Submission Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBpLvGtycyCm93U686txQg2">
    <skos:definition>A Consequential Damages Waiver Clause is a provision in a contract that limits the liability of one party for indirect or consequential damages resulting from a breach of the contract.</skos:definition>
