  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RJnxhN2bkiWDlP8X0ZWpi">
    <skos:altLabel xml:lang="en-gb">State Destruction of Private Property</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">राज्य द्वारा निजी संपत्ति का नाश</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">国家破坏私人财产</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Destruction de biens privés par l'État</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Destrucción de Propiedad Privada por parte del Estado</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הרס רכוש פרטי על ידי המדינה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Destrucción de Propiedad Privada por parte del Estado</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Destruição de propriedade privada pelo Estado</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">国家による私有財産の破壊</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Staatliche Zerstörung von Privatbesitz</skos:altLabel>
    <skos:definition>The State Destruction of Private Property is the legal concept where the government takes possession of private property for public use without the owner's consent, and compensates the owner for the fair market value of the property.</skos:definition>
    <rdfs:label>State Destruction of Private Property</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDwajUPdKVdK5tlwiUjmNzG"/>
  </rdf:Description>
