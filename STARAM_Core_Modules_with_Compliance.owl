    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="ja-jp">マイルストーン支払いスケジュール条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Milestone Payment Schedule Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de calendrier de paiement par étapes</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Meilensteinzahlung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de calendario de pagos por hitos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">里程碑付款进度条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Cronograma de Pagamento por Etapas</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף לוח תשלומי פרויקט לפי קבוצות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de calendario de pagos por hitos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">माइलस्टोन भुगतान अनुसूची शर्त</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Milestone Payment Schedule Clause is a provision in a contract that outlines the specific dates or events that trigger payment obligations, typically tied to the completion of certain project milestones.</skos:definition>
    <rdfs:label>Milestone Payment Schedule Clause</rdfs:label>
  </rdf:Description>
