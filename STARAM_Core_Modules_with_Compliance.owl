  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RdJXzcAmlfZcyYjgz46UzE">
    <skos:definition>A representation made by a party in a legal matter that confirms the approval of a particular action or decision, and is supported by legal or other professional frameworks.</skos:definition>
    <skos:altLabel xml:lang="pt-br">Representação de aprovação</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Representación de aprobación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मंजूरी प्रतिनिधि</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Genehmigungsvertretung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representación de aprobación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Représentation d'approbation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ייצוג אישור</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">批准代表</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Approval Representation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">承認代表</skos:altLabel>
