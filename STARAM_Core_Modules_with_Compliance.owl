    <skos:altLabel xml:lang="hi-in">मरम्मत और रखरखाव उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie de la réparation et de la maintenance</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de reparação e manutenção</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de Reparación y Mantenimiento</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">维修和保养行业</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Reparatur- und Instandhaltungsbranche</skos:altLabel>
    <skos:altLabel>Repair and Maintenance</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">修理およびメンテナンス産業</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Repair and Maintenance Industry</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית תיקונים ותחזוקה</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-BCS-REPM</ns2:legacyIdentifier>
    <rdfs:label>Repair and Maintenance Industry</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBsVax4c8Bdvzok8MTZKGD8"/>
    <skos:definition>Industries in the Repair and Maintenance industry group restore machinery, equipment, and other products to working order. These establishments also typically provide general or routine maintenance (i.e., servicing) on such products to ensure they work efficiently and to prevent breakdown and unnecessary repairs.</skos:definition>
    <skos:hiddenLabel>REPM</skos:hiddenLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:prefLabel>Repair and Maintenance Industry</skos:prefLabel>
    <dc:identifier>BCS-REPM</dc:identifier>
    <dc:identifier>IN-INDUSTRY-5.4</dc:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/pZsa2LQeSRa1SKVYna-kpg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/rszFTqGFQk-ACTM1IYSmIQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423430"/>
    <rdfs:label>Computer and Computer Peripheral Equipment and Software Merchant Wholesalers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of computers, computer peripheral equipment, loaded computer boards, and/or computer software.</skos:definition>
  </rdf:Description>
