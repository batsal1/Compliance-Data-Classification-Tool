  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ifKK3H7Ra75thrWRwyh8">
    <skos:altLabel>Senior Law Enforcement Official</skos:altLabel>
    <skos:altLabel>Head of Police</skos:altLabel>
    <skos:altLabel>Director of Public Safety</skos:altLabel>
    <skos:altLabel>Police Chief</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Chief Constable</skos:altLabel>
    <skos:altLabel>Commissioner of Police</skos:altLabel>
    <skos:example>Los Angeles Police Chief</skos:example>
    <skos:example>Metropolitan Police Commissioner (London)</skos:example>
    <skos:example>New York City Police Commissioner</skos:example>
    <skos:prefLabel>Police Commissioner</skos:prefLabel>
    <rdfs:label>Chief of Police</rdfs:label>
    <skos:definition>A Chief of Police is the highest-ranking law enforcement officer within a police department or municipal law enforcement agency. This individual is responsible for overseeing all aspects of police operations, including personnel management, policy implementation, and ensuring public safety within their jurisdiction.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RILQypXcjvqd1GxNIcqsb7"/>
  </rdf:Description>
