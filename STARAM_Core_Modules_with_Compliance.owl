  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rv2BH4j7XbwE7RJbqFkDci">
    <skos:altLabel xml:lang="de-de">Risiko-Nutzen-Test</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">जोखिम लाभ परीक्षण</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בדיקת יתרות וסיכונים</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Teste de relação risco-benefício</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Prueba de riesgo-beneficio</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Test de balance bénéfice-risque</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Risk Benefit Test</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">リスク・ベネフィット・テスト</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Prueba de riesgo-beneficio</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">风险效益测试</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCc50c8MA7S8aeFuufxdksV"/>
    <rdfs:label>Risk Benefit Test</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Risk Benefit Test is a defense used in product liability cases where the defendant argues that the benefits of the product outweigh the risks associated with it.</skos:definition>
  </rdf:Description>
