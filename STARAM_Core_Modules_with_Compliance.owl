  <rdf:Description rdf:about="https://folio.openlegalstandard.org/aOJCk4kQS1SaRhyyZ4PpMw">
    <skos:example>Electrical supply retailers</skos:example>
    <skos:example>Floor covering retailers, hardwood or ceramic tile only</skos:example>
    <skos:example>Fencing dealers</skos:example>
    <skos:example>Prefabricated building (except manufactured home) dealers</skos:example>
    <skos:example>Garage door dealers</skos:example>
    <skos:example>Lumber yards, retail</skos:example>
    <skos:example>Glass (except automotive) retailers</skos:example>
    <skos:example>Kitchen cabinet (except custom) retailers</skos:example>
    <skos:example>Plumbing supply retailers</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=444180"/>
    <skos:definition>This industry comprises establishments (except home centers, paint and wallpaper retailers, and hardware retailers) primarily engaged in retailing specialized lines of new building materials, such as lumber, fencing, glass, doors, plumbing fixtures and supplies, electrical supplies, prefabricated buildings and kits, and kitchen and bath cabinets and countertops to be installed.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/oLd6BswkTKmNnHBKhv41Lw"/>
    <rdfs:label>Other Building Material Dealers</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7SaXrn5D1aJju69qYJCWL6">
    <skos:altLabel xml:lang="hi-in">इमिग्रेशन उल्लंघन</skos:altLabel>
