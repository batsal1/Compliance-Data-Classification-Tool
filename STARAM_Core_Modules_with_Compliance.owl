  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ljsyofqbjPd8V1LNVlI6">
    <skos:altLabel xml:lang="es-es">Cláusula de Accionista Único</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">唯一の株主条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause du seul actionnaire</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel über den alleinigen Aktionär</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Accionista Único</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">唯一股东条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף בעל המניות היחיד</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Sole Shareholder Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula do único acionista</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एकल सहधारक शर्त</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Sole Shareholder Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Sole Shareholder Clause is a provision in a contract that specifies the rights and obligations of a shareholder who owns all of the outstanding shares of a corporation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTtZtn67Cvp0TersB7y9l8">
    <skos:definition>An Analysis of Pre-Petition Mortgage involves the examination and evaluation of mortgage agreements and related financial transactions that occurred before the filing of a bankruptcy petition. This analysis helps determine the validity, priority, and enforceability of claims against the debtor's property within the bankruptcy proceedings.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9WeLPiEbGoOavw05ow5nev"/>
    <rdfs:label>Analysis of Pre-Petition Mortgage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/5i9GvY0XR9Sx6xXT30RQyA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/qDsXOU70Tf6usMKyrcjeUQ"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) manufacturing dry pasta and/or (2) manufacturing prepared flour mixes or dough from flour ground elsewhere. The establishments in this industry may package the dry pasta they manufacture with other ingredients.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dry Pasta, Dough, and Flour Mixes Manufacturing from Purchased Flour</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311824"/>
  </rdf:Description>
