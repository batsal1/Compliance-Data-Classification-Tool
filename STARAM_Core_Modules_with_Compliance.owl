    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBhpxuVP1KPa3qKKM4U0LlL">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RClEPD3LQVJMcRPGY9oXVXU"/>
    <skos:altLabel xml:lang="en-gb">Guaranteed Maximum Price Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Precio Máximo Garantizado</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מחיר מקסימלי מובטח</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保証最高価格条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de prix maximum garanti</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गारंटीड मैक्सिमम प्राइस क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Garantierte Höchstpreisklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Precio Máximo Garantizado</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保证最高价格条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de preço máximo garantido</skos:altLabel>
    <skos:definition>A Guaranteed Maximum Price Clause is a provision in a contract that sets a limit on the amount that a party will be required to pay for a project, ensuring that the cost will not exceed a certain amount.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Guaranteed Maximum Price Clause</rdfs:label>
  </rdf:Description>
