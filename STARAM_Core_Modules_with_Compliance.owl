    <skos:altLabel xml:lang="ja-jp">文書保存の実践</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de Preservação de Documentos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de Preservación de Documentos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de la préservation des documents</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">文件保全实践</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Praxis der Dokumentenerhaltung</skos:altLabel>
    <rdfs:label>Preservation of Documents Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Preservation of Documents Practice refers to the legal practice of ensuring that relevant documents are protected and maintained in their original form during a legal matter, in order to prevent their destruction or alteration.</skos:definition>
  </rdf:Description>
