    <rdfs:label>L670 Production (NOS)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RIqMae8AYRo634OG4XtuV0A"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"NOS" = Not Otherwise Specified (catch-all, includes the subcategories). Primarily charges on a per GB, per custodian. or a flat/fixed fee basis.</skos:definition>
    <skos:prefLabel>L670 Production (NOS)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R__bAx9MRFy6G0jOlyvIZA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=213113"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Support Activities for Coal Mining</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/2A-BXFaYS4aaPb9hUzIjNA"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing support activities for coal mining (except geophysical surveying and mapping, site preparation, construction, and transportation activities) on a contract or fee basis. Exploration for coal is included in this industry. Exploration services include traditional prospecting methods, such as taking core samples and making geological observations at prospective sites.</skos:definition>
  </rdf:Description>
