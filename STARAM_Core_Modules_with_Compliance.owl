  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R799GvEx8X8n754gDXCRxTS">
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia mútua à sub-rogação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">相互放弃代位权条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur gegenseitigen Verzichtserklärung auf Subrogation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सह-विनिमय उपस्थिति से वाइवर ऑफ सब्रोगेशन क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">相互代位放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation mutuelle à la subrogation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף וייבר משותף של סוברוגציה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mutual Waiver of Subrogation Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Renuncia Mutua de Subrogación</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Renuncia Mutua de Subrogación</skos:altLabel>
    <skos:definition>A Mutual Waiver of Subrogation Clause is a provision in a contract where both parties agree to waive their right to seek reimbursement from the other party's insurance company in the event of a loss or damage.</skos:definition>
