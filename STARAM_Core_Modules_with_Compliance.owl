  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RrMIIsCEqxpHSyyLrupuZl">
    <rdfs:label>Pension Benefit</rdfs:label>
    <skos:altLabel>Retirement Benefit</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
    <skos:definition>A pension benefit is a periodic payment made to an employee who has retired from work, based on the employee's years of service and salary history. It is typically provided as part of a retirement plan, ensuring financial security for the retiree.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
