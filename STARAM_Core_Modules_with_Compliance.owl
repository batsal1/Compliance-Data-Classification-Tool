    <skos:example>Clutches and brakes (except electromagnetic industrial controls, motor vehicle) manufacturing</skos:example>
    <skos:example>Plain bushings (except internal combustion engine) manufacturing</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33361"/>
