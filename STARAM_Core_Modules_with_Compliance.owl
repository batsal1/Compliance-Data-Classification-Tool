  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBrjry4X0Uiy3k5OKO9WxxD">
    <skos:prefLabel>Congressional Investigation Practice</skos:prefLabel>
    <skos:altLabel>Legislative Inquiry Practice</skos:altLabel>
    <skos:altLabel>Government Inquiry Practice</skos:altLabel>
    <skos:altLabel>Inquiry Service</skos:altLabel>
    <skos:altLabel>Inquiry</skos:altLabel>
    <skos:altLabel>Public Inquiry</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7epmKzXnQGUjQ78UEKxoTG"/>
    <rdfs:label>Inquiry Practice</rdfs:label>
    <skos:definition>Inquiry Practice refers to the legal and procedural framework governing the conduct of formal investigations into matters of public concern, often initiated by government bodies or legislative entities. These inquiries aim to uncover facts, make recommendations, and provide accountability, typically involving extensive fact-finding, evidence gathering, and public hearings.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RaWObOphVqdpQ8MspdRMci">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Marketing Law</skos:prefLabel>
    <skos:definition>Advertising Law regulates the practices and methods of promoting products, services, and brands to ensure that advertisements are truthful, non-deceptive, and fair. It encompasses regulations on commercial speech, consumer protection, and compliance with industry standards.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N68b7ace050b94e618171ea9639131d58"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rq7yrbwVSqS8fuRtnzDx6g"/>
    <rdfs:label>Advertising Law</rdfs:label>
  </rdf:Description>
