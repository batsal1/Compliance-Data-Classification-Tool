  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rm51XYTbDjRXLDOlLzfn25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sex Offender Registration</rdfs:label>
    <skos:altLabel xml:lang="hi-in">सेक्स अपराधी पंजीकरण</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">性犯罪登记</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Registro de agressores sexuais</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Registrierung von Sexualstraftätern</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Sex Offender Registration</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Enregistrement des délinquants sexuels</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Registro de delincuentes sexuales</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Registro de delincuentes sexuales</skos:altLabel>
    <skos:altLabel xml:lang="he-il">רישום פושעי מין</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">性犯罪者登録</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7p8xRy14cVNnXyHxD92nQk"/>
    <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
    <skos:definition>Sex offender registration is a system in which individuals convicted of certain sexual offenses are required to register their personal details, including current address and nature of their offense, with a designated government authority. This registration is typically made available to the public, either in part or in full, with the intent of informing communities about the presence of individuals who might pose a risk, and to aid law enforcement in monitoring and managing these individuals.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDs9eCLoiQpyTdMrksg6z9R">
    <skos:definition>Negligent or wrongful conduct by a neurosurgeon that results in harm or injury to a patient, and which is the subject of a legal claim for damages.</skos:definition>
    <skos:altLabel xml:lang="ja-jp">神経外科医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Neurochirurgische Kunstfehler</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Neurosurgery Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यूरोसर्जरी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia médica en neurocirugía</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica em neurocirurgia</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en neurocirugía</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">神经外科医疗事故</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בנוירוכירורגיה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en neurochirurgie</skos:altLabel>
    <rdfs:label>Neurosurgery Malpractice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
