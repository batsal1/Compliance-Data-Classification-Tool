  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RinqHf65TtUhr762WKqN6R">
    <skos:altLabel xml:lang="es-es">Jurisdicción Personal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juridiction personnelle</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Persönliche Gerichtsbarkeit</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción Personal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">个人管辖权</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שיפוט אישי</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Personal Jurisdiction</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यक्तिगत अधिकरण</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">個人管轄権</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jurisdição pessoal</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIuHPBKs3x9tZ0vRBJ76AI"/>
    <skos:definition>The concept of Personal Jurisdiction refers to the power of a court to hear and decide a case involving a particular defendant, based on the defendant's connection to the forum state, as determined by the legal rules and principles governing jurisdiction.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Personal Jurisdiction</rdfs:label>
  </rdf:Description>
