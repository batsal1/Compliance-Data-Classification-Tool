  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC64ZzunlH8jxxkzGOC3ItS">
    <skos:definition>Analysis of Severance Obligations refers to the examination and evaluation of the legal responsibilities and duties of an employer to provide compensation or benefits to an employee upon termination of employment, specifically focusing on the severance package.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCNQdoTDumXxFCbORNgfrm7"/>
    <rdfs:label>Analysis of Severance Obligations</rdfs:label>
    <skos:altLabel xml:lang="ja-jp">解雇手当の分析</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">解除义务分析</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">छुट्टी के अधिभारों का विश्लेषण</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Análisis de Obligaciones de Separación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Analysis of Severance Obligations</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Análisis de Obligaciones de Indemnización por Despido</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Análise de obrigações de rescisão</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Analyse des obligations de départ</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Analyse von Abfindungsverpflichtungen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ניתוח חובות פיצויי פיטורים</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RYS2M2cunzcjtIHPdPzmUy">
    <skos:altLabel>Hazardous Substance Claims</skos:altLabel>
    <skos:altLabel>Toxic Exposure Claims</skos:altLabel>
    <skos:altLabel>Environmental Tort Claims</skos:altLabel>
    <skos:altLabel>Chemical Injury Claims</skos:altLabel>
    <skos:definition>A toxic tort claim arises when an individual alleges harm due to exposure to a toxic substance. This claim seeks compensation for injuries caused by chemicals, pollutants, or other hazardous materials.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Toxic Exposure Claims</skos:prefLabel>
    <rdfs:label>Toxic Tort Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDqSn32zsjxExcBFzIYxT2D"/>
  </rdf:Description>
