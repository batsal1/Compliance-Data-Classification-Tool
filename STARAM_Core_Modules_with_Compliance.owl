    <skos:altLabel xml:lang="de-de">Kompatibilität von Standards</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Compatibilidade de padrões</skos:altLabel>
    <rdfs:label>Standards Compatibility</rdfs:label>
    <skos:definition>Existing standards (e.g., UTBMS, LEDES, PACER) and their components' mappings (relationships) to their FOLIO counterparts.</skos:definition>
    <skos:definition>Existing standards (e.g., UTBMS, LEDES, PACER) and their components' mappings (relationships) to their SALI LMSS counterparts.</skos:definition>
