    <skos:altLabel xml:lang="es-es">Lenguaje de Anuncio de Acuerdo, Pendencia o Consumación</skos:altLabel>
    <skos:definition>Deal Announcement, Pendency, or Consummation Language refers to the specific language used in legal agreements to describe the announcement, pending status, or completion of a business transaction, and any related exceptions or carveouts regarding material adverse effects.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
