  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDOppPCupWvkmNYt9jF2cVS">
    <skos:altLabel xml:lang="de-de">Berichterstattungsprivileg für faire und wahre Berichterstattung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privilegio de Información Justa y Verdadera</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fair and True Reporting Privilege</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio de Información Justa y Verdadera</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निष्पक्ष और सच्ची रिपोर्टिंग विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公正真实报道特权</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio de relato justo e verdadeiro</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות לדיווח נאמן והוגן</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公正かつ真実の報道特権</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège de rapport équitable et véridique</skos:altLabel>
    <skos:definition>The Fair and True Reporting Privilege is a legal immunity and privilege that protects journalists and media outlets from being sued for defamation when reporting on matters of public interest, as long as they report accurately and in good faith.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE"/>
    <rdfs:subClassOf rdf:nodeID="N4e324814b2af4e808bdbaea87084e953"/>
    <rdfs:label>Fair and True Reporting Privilege</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg">
    <skos:altLabel xml:lang="en-gb">Agent Liability</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">代理人责任</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות הסוכן</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité de l'agent</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade do agente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">代理人の責任</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad del agente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad del agente</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung des Agenten</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एजेंट दायित्व</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
    <rdfs:label>Agent Liability</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Agent Liability refers to the legal responsibility of an individual or entity acting as an agent for another party, for any harm caused to a third party due to their negligence or breach of fiduciary duty.</skos:definition>
  </rdf:Description>
