    <skos:altLabel xml:lang="fr-fr">Clause directe ou indirecte</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Direkt oder indirekt Klausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula Directa o Indirectamente</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Directly or Indirectly Clause</skos:altLabel>
