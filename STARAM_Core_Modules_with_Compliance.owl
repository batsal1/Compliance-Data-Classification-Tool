    <rdfs:label>Fiduciary Termination Right</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RbNdxLlwhsOPsmRLO2nN7Q">
    <skos:altLabel xml:lang="de-de">Kieferorthopädische Kunstfehler</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Mala praxis en ortodoncia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">矯正歯科の医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Orthodontics Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en ortodoncia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">正畸医疗事故</skos:altLabel>
