    <rdfs:label>Transfer Agent Services Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Investment &amp; Financial Services</ns1:contractFamily>
    <skos:definition>A Transfer Agent Services Agreement is a contract between a company and a transfer agent who manages the record-keeping of investor information, processes security transactions, and distributes dividends. The agreement outlines the services provided and compensation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9bUK6IbIdy0QvCFXmq0n7Z">
    <skos:altLabel xml:lang="zh-cn">牙科医疗事故</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Mala praxis dental</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência odontológica</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולות שגויות של רופאי שיניים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">डेंटल अनुचित आचरण</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dental Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia dental</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">歯科医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle dentaire</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zahnärztliche Kunstfehler</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Negligent or improper conduct by a dental professional, resulting in harm or injury to a patient, which may give rise to a legal claim for damages.</skos:definition>
    <rdfs:label>Dental Malpractice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Q7Ut5uDnSIFiVL9nm1qiq">
    <skos:altLabel xml:lang="zh-cn">安宁享有条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Quiet Enjoyment Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de disfrute pacífico</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף נאום שקט</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de goce pacífico</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शांत आनंद क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de gozo tranquilo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur ungestörten Nutzung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">静穏な使用条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de jouissance paisible</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Quiet Enjoyment Clause</rdfs:label>
    <skos:definition>A Quiet Enjoyment Clause is a provision in a contract that guarantees a tenant's right to use and enjoy the leased property without interference from the landlord or any third party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N143fca5d16254e3d92a2520ea6f620cf">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#DefinitionsOfTerms"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0wKTngGCYzLVM5KhPOC0T">
    <rdfs:label>Supersedes Previous Agreements Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-mx">Cláusula de Sustitución de Acuerdos Anteriores</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Substituição de Acordos Anteriores</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Aufhebung früherer Vereinbarungen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">取代先前协议条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מחליף הסכמים קודמים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de remplacement des accords précédents</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्ववर्ती समझौतों क्लॉज को अधिस्थापित करता है</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">以前の契約条項を置き換える</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Sustitución de Acuerdos Anteriores</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Supersedes Previous Agreements Clause</skos:altLabel>
    <skos:altLabel>Supersedes Prior Agreements Clause</skos:altLabel>
    <skos:definition>A Supersedes Previous Agreements Clause is a contractual clause that specifies that the current agreement between parties supersedes any prior agreements or understandings, whether written or oral.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDkc9fh6vYvZbJc7ERuIJCf">
    <rdfs:subClassOf rdf:nodeID="N0c13a063bd0141ef81569da756fbb818"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8QJDc8SCwsfsJARkyevIJ0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>L400 Trial Preparation and Trial</rdfs:label>
    <skos:definition>L400 Trial Preparation and Trial refers to the process of preparing for and conducting a trial, including tasks such as drafting written motions, preparing expert witnesses, attending hearings, and making post-trial submissions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/register#RH-151">
    <rdfs:subClassOf rdf:nodeID="N50d87620a9b94064a6f2f2292ecfd14a"/>
    <rdfs:subClassOf rdf:nodeID="N97c5a9f5129744429c7072d622ec270b"/>
    <rdfs:subClassOf rdf:nodeID="Nd9c21b4b2da74aeea5f5bf22581f9e42"/>
    <rdfs:subClassOf rdf:nodeID="N37e78398e2c54151a456ade725e652eb"/>
    <rdfs:subClassOf rdf:nodeID="N661a07437bf041ee85aaa90bea714bad"/>
    <rdfs:subClassOf rdf:nodeID="N2503a25af01b4dd0a9682a2114aa7c88"/>
    <rdfs:subClassOf rdf:nodeID="N8f17e2b2e3c447f2b6bfe8cb0f2ef3f7"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskHead"/>
    <rdfs:label xml:lang="en">Safety Obligation Allocation Onerous</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
