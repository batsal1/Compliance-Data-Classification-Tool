  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCs5oguF0b3mA15pozhbhFu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
