  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCizN3b0LSS8fP0QBHWfWWr">
    <rdfs:label>Contract Intake Management</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8MRtBMmrg5epp6WfJx4lSW"/>
    <skos:definition>Contract Intake Management refers to the process of receiving and reviewing contracts for a business or organization, including the initial assessment and documentation of contract terms and conditions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
