  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7ssf9135kwzOV2U0znjLMk">
    <skos:altLabel xml:lang="en-gb">Animal Attack Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por ataque de animal</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Schadensersatz bei Tierangriffen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">动物攻击索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por ataque de animal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">動物襲撃請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de ataque animal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על התקפת חיות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पशु हमला दावा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation d'attaque d'animal</skos:altLabel>
    <rdfs:label>Animal Attack Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8XMs89zuZc9chn6WQ9Fgbm"/>
    <skos:definition>A claim for damages resulting from an animal's attack on a person, which falls under the broader categories of animal claims and personal injury claims.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBWPUbkNplXXhqH4NNuAeF">
    <skos:altLabel xml:lang="de-de">Freistellungs- und Haftungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de libération et d'indemnisation</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de liberação e indenização</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שחרור ופיצויים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Release and Indemnity Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de liberación e indemnización</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">免責および賠償条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रिलीज और इंडेम्निटी क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de liberación e indemnización</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">免责和赔偿条款</skos:altLabel>
    <skos:definition>A Release and Indemnity Clause is a legal provision that absolves one party from liability for damages or injuries suffered by another party, and requires the other party to indemnify and hold harmless the first party from any claims or losses arising from the agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7QtA1XEvYBttW8LUvBN7OB"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Release and Indemnity Clause</rdfs:label>
  </rdf:Description>
