  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7OF55qIq9P3iOXGnNfVTuP">
    <skos:altLabel xml:lang="en-gb">Counterpart Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">相手条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הצד השני</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de contrepartie</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gegenpartei-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de contraparte</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Contraparte</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">相对方条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Contraparte</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">काउंटरपार्ट क्लॉज</skos:altLabel>
    <rdfs:label>Counterpart Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Counterpart Clause is a provision in a contract that allows for multiple identical copies of the contract to be signed by different parties, each copy being considered an original.</skos:definition>
  </rdf:Description>
