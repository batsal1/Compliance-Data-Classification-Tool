  <rdf:Description rdf:about="https://folio.openlegalstandard.org/tg8RzD_2SeapQGyJ84zbNw">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311224"/>
    <rdfs:label>Soybean and Other Oilseed Processing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in crushing oilseeds and tree nuts, such as soybeans, cottonseeds, linseeds, peanuts, and sunflower seeds. Examples of products produced in these establishments are oilseed oils, cakes, meals, and protein isolates and concentrates.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/f5KVOtZmSlibxAGrEymRkQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
