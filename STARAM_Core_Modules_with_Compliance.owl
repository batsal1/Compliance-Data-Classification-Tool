  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7l5Sys48lqv0bE9pCva2ve">
    <rdfs:label>Court Reporter</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">法庭记录员</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Court Reporter</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Taquígrafo judiciário</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Taquígrafo de tribunal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कोर्ट रिपोर्टर</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מתווך בית משפט</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法廷記録官</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gerichtsreporter</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Sténographe judiciaire</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Taquígrafo judicial</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <skos:definition>Person who provides verbatim recordings of each session of the court and every other proceeding by shorthand, mechanical means, electronic sound recording, or any other method. See 28 U.S. Code § 753</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB6nt74cA4ZaBYa5cOSeNzV">
    <skos:altLabel xml:lang="en-gb">Settlement Purposes Only Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">決済目的のみの条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause réservée à des fins de règlement</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समाधान उद्देश्यों के लिए क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de solo propósitos de liquidación</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף למטרות פשרה בלבד</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de solo propósitos de liquidación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">仅限于结算目的条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula apenas para fins de liquidação</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel nur für Abwicklungszwecke</skos:altLabel>
    <skos:definition>A Settlement Purposes Only Clause is a contractual clause that limits the use of a settlement agreement to only settling the dispute at hand and prohibits its use as evidence in any future legal proceedings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Settlement Purposes Only Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
