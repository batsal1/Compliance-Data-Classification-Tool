  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMIoMi1OqwHKqsjgrjdaHj">
    <skos:definition>A Legal Services Provider - Organization is an entity that offers professional legal assistance, advice, or representation to clients. This category encompasses traditional law firms, alternative legal service providers (ALSPs), legal aid, and other organizations or professionals authorized to deliver legal services.</skos:definition>
    <skos:definition>A Legal Services Provider - Organization is a type of legal service provider that operates as an organization, such as a law firm or alternative legal services provider (ALSP).</skos:definition>
    <rdfs:label>Legal Services Provider - Organization</rdfs:label>
    <skos:altLabel xml:lang="ja-jp">法的サービスプロバイダー - 組織</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fournisseur de services juridiques - Organisation</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Legal Services Provider - Organisation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ספק שירותי משפט - ארגון</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prestador de serviços jurídicos - Organização</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Proveedor de servicios legales - Organización</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Proveedor de servicios legales - Organización</skos:altLabel>
    <skos:altLabel>Law Firm</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कानूनी सेवा प्रदाता - संगठन</skos:altLabel>
    <skos:altLabel>Alternative Legal Services Provider (ALSP)</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rechtsdienstleister - Organisation</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">法律服务提供商 - 组织</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9x6yqzHQfo3MF4rxIcPupm"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDVbjWsWiybGzxviskHLn21">
    <rdfs:label>Right to Life</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <dc:source>International Bill of Human Rights</dc:source>
    <skos:definition>The right to life is a fundamental human right that protects individuals from arbitrary or unlawful deprivation of life. This right is upheld by various international legal instruments, such as the Universal Declaration of Human Rights and the International Covenant on Civil and Political Rights, and prohibits practices like extrajudicial killings, enforced disappearances, and the death penalty in some contexts</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj">
    <skos:altLabel xml:lang="zh-cn">交易立场</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Postura de negociação</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Postura de Negociación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Position de négociation</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verhandlungsposition</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समझौते का स्थान</skos:altLabel>
    <skos:altLabel xml:lang="he-il">גישת עסקה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Postura de Negociación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Deal Stance</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">取引スタンス</skos:altLabel>
    <skos:definition>Deal stance refers to the approach taken by an acquiring company when pursuing a takeover of another company. Two primary types of deal stances are hostile takeovers and friendly takeovers.</skos:definition>
    <skos:definition>Deal stance refers to the approach taken by an acquiring company when pursuing a takeover of another company. They include hostile takeovers, friendly takeovers, proxy contests, control positions, and minority stakes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDRCaFxX4hpUklgNnVS9D8C"/>
    <rdfs:label>Deal Stance</rdfs:label>
  </rdf:Description>
