  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R83AdEoeP7V1UjvZuvvIHnz">
    <skos:altLabel xml:lang="pt-br">Fraude e engano com base em ocultação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">基于隐瞒的欺诈和欺骗</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">隠蔽に基づく詐欺と欺瞞</skos:altLabel>
    <skos:altLabel>Fraudulent Concealment</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betrug und Täuschung aufgrund von Verschleierung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fraude y engaño basado en ocultación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">छल और धोखे का आधार छिपाने पर</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fraude y engaño basado en ocultación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fraude et tromperie basées sur la dissimulation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הונאה ומרמה המבוססת על הסתרה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fraud and Deceit Based on Concealment</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:label>Fraud and Deceit Based on Concealment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Fraud and Deceit Based on Concealment refers to a legal claim that arises when one party intentionally hides or fails to disclose important information from another party, with the intention of deceiving them and causing them harm.</skos:definition>
  </rdf:Description>
