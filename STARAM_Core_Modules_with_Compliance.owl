    <skos:altLabel xml:lang="zh-cn">财产犯罪</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פשעים נגד המוניות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Delitos contra la propiedad</skos:altLabel>
    <rdfs:label>Crimes Against Property</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N9fe4d18c72e34124aa438aaf01d9d577"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7u1GstOpfAmZ3mI7yFcbgU"/>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <skos:prefLabel>Offences Involving Property</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>To willfully or maliciously destroy, damage, deface, or otherwise injure real or personal property without the consent of the owner or the person having custody or control of it.</skos:definition>
  </rdf:Description>
