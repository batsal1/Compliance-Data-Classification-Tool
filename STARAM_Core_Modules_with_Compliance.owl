  <rdf:Description rdf:about="https://folio.openlegalstandard.org/q9RvnO_yRIOItX7BVivMHQ">
    <skos:definition>This industry comprises establishments primarily engaged in retailing new sporting goods, such as bicycles and bicycle parts; camping equipment; exercise and fitness equipment; athletic uniforms; specialty sports footwear; and other sporting goods, equipment, and accessories.</skos:definition>
    <skos:example>Sporting gun and hunting equipment retailers</skos:example>
    <skos:example>Fishing supply retailers</skos:example>
    <skos:example>Camping and hiking equipment retailers</skos:example>
    <skos:example>Diving equipment retailers</skos:example>
    <skos:example>Golf pro shops</skos:example>
    <skos:example>Sporting goods (e.g., scuba, skiing, ball sports) retailers</skos:example>
    <skos:example>Tack shops</skos:example>
    <skos:example>Bowling equipment and supply retailers</skos:example>
    <skos:example>Bicycle (except motorized) retailers</skos:example>
    <skos:example>Exercise equipment retailers</skos:example>
    <skos:example>Athletic uniform supply retailers</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/vy_ZompTQdW-uOyPZteTdg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=459110"/>
    <rdfs:label>Sporting Goods Retailers</rdfs:label>
  </rdf:Description>
