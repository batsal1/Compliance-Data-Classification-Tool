  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8KGri8xvqfghB4ViHja406">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Repudiatory Breach of Contract Claim is a legal action asserting that one party has committed a breach so fundamental that it effectively nullifies the contract, allowing the innocent party to terminate the agreement. This type of claim alleges that the breach goes to the root of the contract, depriving the innocent party of substantially the whole benefit they were intended to derive from it.</skos:definition>
    <skos:prefLabel>Contract Repudiation</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
    <rdfs:label>Repudiatory Breach of Contract</rdfs:label>
  </rdf:Description>
