  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCC6FvCiFeSijk47glfD3ZX">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNw3wCvXyyjEPknfOpicmf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Marriage Market Segment</rdfs:label>
    <skos:example>Financial Planning for Couples (e.g., joint bank accounts, estate planning)</skos:example>
    <skos:example>Marriage Counseling Services (e.g., couples therapy, relationship workshops)</skos:example>
    <skos:prefLabel>Married Couples Market</skos:prefLabel>
    <skos:definition>The marriage market refers to a division of the market that is specifically targeted towards individuals and couples who are married or planning to get married. This segment encompasses products and services that support the various aspects of married life, from wedding planning to financial and relationship counseling.</skos:definition>
  </rdf:Description>
