    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-BCS-PLNS</ns2:legacyIdentifier>
    <dc:identifier>IN-INDUSTRY-5.1</dc:identifier>
    <dc:identifier>BCS-PLNS</dc:identifier>
    <skos:hiddenLabel>PLNS</skos:hiddenLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBsVax4c8Bdvzok8MTZKGD8"/>
    <skos:prefLabel>Personal and Laundry Services Industry</skos:prefLabel>
    <skos:definition>Industries in the Personal and Laundry Services industry group provide personal and laundry services to individuals, households, and businesses. Services performed include: personal care services; death care services; laundry and dry cleaning services; and a wide range of other personal services, such as pet care (except veterinary) services, photofinishing services, temporary parking services, and dating services.,Industries in the Personal and Laundry Services industry group provide personal and laundry services to individuals, households, and businesses. Services performed include: personal care services; death care services; laundry and drycleaning services; and a wide range of other personal services, such as pet care (except veterinary) services, photofinishing services, temporary parking services, and dating services.</skos:definition>
    <rdfs:label>Personal and Laundry Services Industry</rdfs:label>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
  </rdf:Description>
