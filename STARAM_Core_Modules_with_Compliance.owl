  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R88ZQQdykfBPa54FbVrdaop">
    <skos:altLabel>Cycling Lane Infringement Claim</skos:altLabel>
    <skos:altLabel>Bicycle Path Obstruction Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <rdfs:subClassOf rdf:nodeID="N241bf5aef5d248cc8b6948b877817039"/>
    <rdfs:subClassOf rdf:nodeID="Nf5f5639961a74a6b97c43c5a5fe22c02"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBuYThXwp8tJjNWkTeuFvAZ"/>
    <rdfs:label>Bicycle Lane Violation</rdfs:label>
    <skos:definition>A Bicycle Lane Violation Claim involves allegations that a motorist or other road user has unlawfully used or obstructed a bicycle lane, violating regulations designed to ensure the safety and mobility of cyclists. Such claims typically lead to enforcement actions that may include fines or mandatory education on sharing the road responsibly.</skos:definition>
    <skos:prefLabel>Bike Lane Encroachment Claim</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
