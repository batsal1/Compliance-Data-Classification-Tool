    <skos:altLabel xml:lang="es-es">Representación de la comisión del corredor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ब्रोकर शुल्क प्रतिनिधित्व</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Broker's Fee Representation</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Maklergebührenvertretung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ייצוג עמלת המתווך</skos:altLabel>
    <skos:definition>A Broker's Fee Representation is a statement made by a party in a legal matter regarding the payment of fees to a broker, which is supported by legal or other professional frameworks and falls under the category of Representations and Warranties.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Nee3f3780d1b644cb928d9c6eb9c3e964"/>
