  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCGzY6GxWecmgsg39XP6QMG">
    <skos:definition>Voluntary commitment to a mental health facility occurs when an individual willingly and knowingly agrees to be admitted to a psychiatric hospital or clinic for treatment. This decision is made without external coercion, and the individual retains the right to request discharge, though there might be conditions or procedures to follow before release.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmZbwmBBKWQ3vGof1sh1kB"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Voluntary Commitment to a Mental Health Facility</rdfs:label>
  </rdf:Description>
