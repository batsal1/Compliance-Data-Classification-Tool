    <skos:altLabel xml:lang="en-gb">Appraisal Rights</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मूल्यांकन अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit d'évaluation</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The right of a shareholder to demand fair value for their shares in a corporation in the event of certain major corporate actions, such as mergers or acquisitions, as specified in the Conditions to Closing.</skos:definition>
    <rdfs:label>Appraisal Rights</rdfs:label>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
  </rdf:Description>
