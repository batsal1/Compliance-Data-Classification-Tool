  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCE0Yra7ugHR8DmISUDu3qp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>Fed. R. Evid. 804(b)(3)</dc:source>
    <skos:definition>A Statement Against Interest is a hearsay exception that allows the admission of statements that, at the time they were made, were contrary to the declarant's pecuniary, proprietary, or penal interest, or subjected the declarant to civil or criminal liability. This exception is based on the assumption that a person is unlikely to make a statement that goes against their own interests unless they believe it to be true.</skos:definition>
    <skos:altLabel>Declaration Against Interest</skos:altLabel>
    <skos:altLabel>Admission Against Interest</skos:altLabel>
    <rdfs:label>Statement Against Interest</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxtm6yCTUcImGngCzkPcx0"/>
  </rdf:Description>
