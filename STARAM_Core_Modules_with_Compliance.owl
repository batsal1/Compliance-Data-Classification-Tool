    <skos:altLabel xml:lang="hi-in">जस्टिस ऑफ़ द पीस</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juge de paix</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Juez de Paz</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Justice of the Peace</skos:altLabel>
