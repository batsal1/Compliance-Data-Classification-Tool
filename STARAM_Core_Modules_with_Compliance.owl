    <skos:altLabel xml:lang="ja-jp">代理著作権侵害</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de direitos autorais vicária</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">替代侵权</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Contrefaçon de droit d'auteur vicariante</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Vicarious Copyright Infringement</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Stellvertretende Urheberrechtsverletzung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xzICx2jmaNf0lhp5OGKx"/>
    <skos:definition>Vicarious Copyright Infringement refers to a situation where a person is held liable for copyright infringement committed by another person, even if they did not directly commit the infringement themselves.</skos:definition>
