    <skos:altLabel xml:lang="de-de">Ausschließlichkeitsdoktrin der Arbeitnehmerentschädigung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कर्मचारी रक्षा एक्सक्लूसिव रिमेडी डॉक्ट्रिन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תפיסת המשפט הבלעדית לפיצויי עובדים בפיצויי עובדים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Doctrina de recurso exclusivo de compensación laboral</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">工人赔偿专属救济原则</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Workers' Compensation Exclusive Remedy Doctrine</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Doctrina de recurso exclusivo de compensación de trabajadores</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">労働者補償独占救済主義</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Doctrine de la réparation exclusive de la compensation des travailleurs</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Doutrina de Remédio Exclusivo de Compensação dos Trabalhadores</skos:altLabel>
    <rdfs:label>Workers' Compensation Exclusive Remedy Doctrine</rdfs:label>
    <skos:definition>The Workers' Compensation Exclusive Remedy Doctrine is a legal defense in civil litigation cases that limits the liability of employers for workplace injuries by providing workers' compensation as the sole remedy for employees.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N6e63a4002bdb4bd28dfef0db095f6519"/>
    <rdfs:subClassOf rdf:nodeID="N43171804e8184757bb3d51f0133f8bc3"/>
