  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDjmrAnUSooACWGC6eGWNZe">
    <skos:definition>The Estimated Duration is a concept within Project Management Objectives that refers to the anticipated length of time required to complete a project or task.</skos:definition>
    <skos:altLabel xml:lang="en-gb">Estimated Duration</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Durée estimée</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Duração estimada</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">预计持续时间</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">見積もり時間</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुमानित अवधि</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Geschätzte Dauer</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Duración Estimada</skos:altLabel>
    <skos:altLabel xml:lang="he-il">משך זמן משוער</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Duración Estimada</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8IPYrNykDTHjhTEpNetWUR"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Estimated Duration</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7NSY7xuiRPxwfxpijRhyaF">
    <skos:altLabel>Unsafe Following Claim</skos:altLabel>
    <skos:altLabel>Close Following Offence Claim</skos:altLabel>
    <skos:prefLabel>Following Too Closely Claim</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Tailgating Claim involves allegations that a driver has followed another vehicle too closely, violating safe following distance regulations and potentially causing a safety hazard. This type of claim is typically addressed in traffic courts and can lead to penalties, including fines and driving record points, depending on the jurisdiction.</skos:definition>
    <rdfs:label>Tailgating Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
  </rdf:Description>
