    <skos:definition>Renter's insurance provides coverage for a tenant's personal belongings within a rented property and may offer liability coverage for injuries that occur within the rental unit. This type of insurance does not cover the structure of the building itself, which is the responsibility of the landlord.</skos:definition>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Renter's Insurance Policy</rdfs:label>
  </rdf:Description>
