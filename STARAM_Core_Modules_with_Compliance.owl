    <skos:altLabel xml:lang="zh-cn">挪用客户</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Atribución Indebida</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Palming Off</skos:altLabel>
    <skos:definition>The concept of Palming Off refers to a type of unfair competition claim or intellectual property claim where one party misrepresents their goods or services as those of another party in order to deceive consumers and gain an unfair advantage.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Palming Off</rdfs:label>
  </rdf:Description>
