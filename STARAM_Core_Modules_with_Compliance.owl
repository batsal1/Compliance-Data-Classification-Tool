    <skos:altLabel xml:lang="es-mx">Cláusula de período de prueba</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">試用期間条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">परीक्षणावधि धारा</skos:altLabel>
    <rdfs:label>Probationary Period Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A probationary period clause is a provision in a contract that outlines a trial period during which an employee's performance is evaluated before a permanent employment decision is made.</skos:definition>
