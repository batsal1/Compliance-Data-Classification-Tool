    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of meats and meat products (except canned and packaged frozen) and/or lard.</skos:definition>
    <rdfs:label>Meat and Meat Product Merchant Wholesalers</rdfs:label>
  </rdf:Description>
