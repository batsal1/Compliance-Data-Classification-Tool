  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB7BbLR5TMwSkGVKHVSs4Ng">
    <skos:altLabel xml:lang="de-de">Strafzumessungsrichtlinien</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">量刑指南</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Lignes directrices de détermination de la peine</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Diretrizes de Sentenciamento</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">刑罰基準</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N435c3a773a5f4095b2079ad9887fb48f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RrECTdM9f5ml4sac9MFrSC"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Rules for computing criminal sentences, typically providing classifications (e.g., offenses, offenders), scales (e.g., severity), and suggested punishments.</skos:definition>
    <rdfs:label>Sentencing Guidelines</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCnkGaPQt5VMPUM5QsgXhX">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
    <skos:altLabel xml:lang="pt-br">Cláusula geral de garantia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">一般保证条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de garantía general</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de garantía general</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">一般保証条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">General Warranty Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Allgemeine Gewährleistungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause générale de garantie</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אחריות כללי</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य वारंटी शर्त</skos:altLabel>
    <skos:definition>A General Warranty Clause is a provision in a contract that guarantees the quality and condition of the goods or services being provided, without specifying any particular defects or issues that may arise.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>General Warranty Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#Draw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Draw</rdfs:label>
    <skos:exactMatch rdf:resource="https://folio.openlegalstandard.org/R8Z563RYBLIDWaiRo7Jvsmx"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7yULiuUW6FwlVvfIPt13We">
    <rdfs:label>Receivership Creation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG"/>
    <skos:altLabel>Receiver Establishment</skos:altLabel>
    <skos:altLabel>Receivership Appointment</skos:altLabel>
    <skos:altLabel>Appointment Of Receiver</skos:altLabel>
    <skos:definition>Receivership creation refers to the judicial appointment of a receiver to take control of and manage a company's assets during financial distress or litigation. This process aims to protect and preserve the assets while a resolution is sought, often leading to restructuring, liquidation, or sale.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne81790dcd3a94317b9238ea13b769156">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
