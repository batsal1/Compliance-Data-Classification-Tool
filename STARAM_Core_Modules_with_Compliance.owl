  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7dfOE4uDkhuyr8mme8oOqo">
    <skos:definition>A Hidden Assets Claim is a legal action taken during divorce proceedings when one spouse suspects that the other spouse is concealing or not fully disclosing assets or financial information. This claim seeks to uncover any undisclosed or hidden assets, which could include bank accounts, investments, real estate, or other valuable property, to ensure a fair and accurate division of marital property during the divorce process. Discovery methods and legal processes are used to identify and reveal any concealed assets.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUXzL8Z4Ddh2CK6TBhofjU"/>
    <rdfs:label>Hidden Assets Claim</rdfs:label>
  </rdf:Description>
