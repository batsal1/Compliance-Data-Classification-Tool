  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RpFL8eFjObYE5sneSBmS9U">
    <rdfs:label>Personal Jurisdiction by Sufficient Contacts</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">充分联系的个人管辖权</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción personal por contactos suficientes</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Persönliche Gerichtsbarkeit durch ausreichende Kontakte</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por contatos suficientes</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Jurisdicción personal por contactos suficientes</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שיפוט אישי על ידי אישורים מספיקים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">十分な接触による個人管轄権</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Sufficient Contacts</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par contacts suffisants</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पर्सनल जुरिसडिक्शन बाय सफिशिएंट कॉन्टैक्ट्स</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7X4vuBVsbGf69DAu7Xotdw"/>
    <skos:definition>The concept of "Personal Jurisdiction by Sufficient Contacts" refers to the legal authority of a court to hear a case based on a defendant's significant and continuous contacts with the forum state, even if the defendant is not physically present in the state at the time of the lawsuit.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBNKZnRpEuzjfwPs0r0VRIN">
    <skos:altLabel xml:lang="zh-cn">诉讼特权</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio de litigio</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">訴訟特権</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège de litige</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privilegio de litigio</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio de litígio</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות סודיות בהליך משפטי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Prozessprivileg</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिटिगेशन प्रिविलेज</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Litigation Privilege</skos:altLabel>
    <rdfs:label>Litigation Privilege</rdfs:label>
    <skos:definition>A legal protection that allows parties involved in a lawsuit to keep certain communications and documents confidential from disclosure to the opposing party or in court proceedings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCR7Z71r5mmHYFs1xoAWwzE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDWbjk2yLNHL2dIZvygRD5J">
    <rdfs:label>Construction of Buildings Industry</rdfs:label>
    <skos:altLabel xml:lang="fr-fr">Industrie de la construction de bâtiments</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria da construção de edifícios</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de la construcción de edificios</skos:altLabel>
    <skos:altLabel>Construction of Buildings</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית בנייה של בניינים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Construction of Buildings Industry</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भवन निर्माण उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de la construcción de edificios</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">建築業</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Bauindustrie</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">建筑业</skos:altLabel>
    <skos:definition>The Construction of Buildings subsector comprises establishments primarily responsible for the construction of residential and non-residential buildings. The work performed may include new work, additions, alterations, or maintenance and repairs. The onsite assembly of precut, panelized, and prefabricated buildings and construction of temporary buildings are included in this subsector. Part or all of the production work for which the establishments in this subsector have responsibility may be subcontracted to other construction establishments'usually specialty trade contractors.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCQY0EFoRWFu0qcub25sBj8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-CON-BUIL</ns2:legacyIdentifier>
    <skos:prefLabel>Construction of Buildings Industry</skos:prefLabel>
    <dc:identifier>IN-INDUSTRY-6.1</dc:identifier>
    <dc:identifier>CON-BUIL</dc:identifier>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <skos:hiddenLabel>BUIL</skos:hiddenLabel>
  </rdf:Description>
