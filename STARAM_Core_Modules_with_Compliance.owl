    <skos:altLabel xml:lang="hi-in">अनिवार्य दायित्व द्वारा आसानी</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות שימוש בצורך חיוני</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Servidão por necessidade</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R93T7OEmCjkwufvhJAY4ScV"/>
    <skos:definition>A type of easement that arises when there is no other reasonable way to access a property except through another's land.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Easement by Necessity</rdfs:label>
