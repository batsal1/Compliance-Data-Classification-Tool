  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCDOABUr8ZTMQ7N7Rydeius">
    <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/R8CdMpOM0RmyrgCCvbpiLS0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:example>Judge Signed Order</skos:example>
    <skos:example>Lawyer Signed Pleading</skos:example>
    <skos:example>Party Signed Contract</skos:example>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <skos:notation>folio:signed</skos:notation>
    <rdfs:label>signed</rdfs:label>
    <rdfs:label>sali:signed</rdfs:label>
    <skos:definition>"Signed" in a legal context refers to the act of putting one's signature on a legal document, such as a pleading, contract, or order. This signature signifies the individual's approval, authorization, or acknowledgement of the content of the document, and is often a requisite for the document's legal validity and enforceability.</skos:definition>
    <skos:altLabel>signed</skos:altLabel>
  </rdf:Description>
