  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBoJ2jZ28WAsPN9ZCwtDG1w">
    <rdfs:label>HSSE Standards Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="pt-br">Cláusula de padrões HSSE</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">HSSE Standards Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Normas HSSE</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Normas HSSE</skos:altLabel>
    <skos:altLabel xml:lang="de-de">HSSE-Standardsklausel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एचएसएसई मानक धारा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">HSSE規格条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de normes HSSE</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תקני HSSE</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">HSSE标准条款</skos:altLabel>
    <skos:definition>A HSSE Standards Clause is a specific provision within a contract that outlines the health, safety, security, and environmental standards that must be adhered to by the parties involved.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBCAQkvPnbH15vsK0uElowM">
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation pour cause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão por justa causa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Terminación por Causa</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">原因による契約解除条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Termination for Cause Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">因原因终止条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigung aus wichtigem Grund Klausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סיום בגין סיבה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कारण के लिए समाप्ति धारा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Terminación por Causa</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Termination for Cause Clause is a provision in a contract that allows one party to end the agreement if the other party breaches a specific condition or obligation outlined in the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R355Le1zLujnXiHMmYqQNM"/>
    <rdfs:label>Termination for Cause Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RLvhxz3b1k2IU3MaAgeRtF">
    <skos:altLabel xml:lang="zh-cn">针对公众的犯罪</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Delitos contra la sociedad</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Crimes contra o público</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פשעים נגד הציבור</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Delitos contra el orden público</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Crimes Against the Public</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公共に対する犯罪</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सार्वजनिक विरुद्ध अपराध</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Crimes contre le public</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verbrechen gegen die Öffentlichkeit</skos:altLabel>
    <skos:definition>Crimes Against the Public are offenses that harm or disrupt the general welfare and safety of society, including but not limited to prostitution, disorderly conduct, rioting, weapons offenses, unlawful assembly, criminal gang participation, unlawful gaming and lotteries, curfew violations, loitering, vagrancy, disorderly house, failure to disperse, and drug crimes.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7u1GstOpfAmZ3mI7yFcbgU"/>
    <rdfs:label>Crimes Against the Public</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
