  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RX4IL0dBTdT6NybOqieEPR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Reclamación por violación de horas extras</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">時間外勤務違反請求</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על הפרת שעות נוספות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Überstundenverletzungsklage</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por violación de horas extra</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">加班违规索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reclamação de violação de horas extras</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ओवरटाइम उल्लंघन दावा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de violation des heures supplémentaires</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Overtime Violation Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <rdfs:label>Overtime Violation Claim</rdfs:label>
    <skos:definition>An overtime violation claim is a legal action initiated by an employee against their employer for not properly compensating them for overtime work. The claim typically arises when an employer does not comply with applicable federal, state, or local overtime laws, which require employers to pay eligible employees at a higher rate for any hours worked beyond a certain number per week or per day. The claim can include allegations of employers failing to pay the required overtime rate, miscalculating the employee's overtime pay, or not properly tracking the employee's overtime hours.</skos:definition>
  </rdf:Description>
