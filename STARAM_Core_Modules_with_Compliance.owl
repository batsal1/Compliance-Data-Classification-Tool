  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCQ6BvkaHE7MeHGbhMx2ebt">
    <skos:altLabel xml:lang="en-gb">Jones Act Claims</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות חוק ג'ונס</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de la Ley Jones</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations Jones Act</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">琼斯法案索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações da Lei Jones</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">जोन्स एक्ट दावे</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandas de la Ley Jones</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ジョーンズ法クレーム</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Jones-Act-Ansprüche</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqHLQbqYW16CtZ6TSKOZPz"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:subClassOf rdf:nodeID="Nd58cafca64f24262a2bf526b47924e1a"/>
    <rdfs:subClassOf rdf:nodeID="N1ba54fde55454662b66cbe7dc21fc90b"/>
    <skos:definition>A Jones Act Claim is a legal claim made under the Jones Act, which provides compensation for seamen who are injured or killed while working on a vessel in navigable waters.</skos:definition>
    <rdfs:label>Jones Act Claims</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
