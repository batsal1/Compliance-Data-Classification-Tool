  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R75OjKiIyaZ7UKYKYmCvFRL">
    <skos:altLabel xml:lang="es-es">Orden de protección civil / Orden de alejamiento doméstico</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demanda de protección civil / Orden de restricción doméstica</skos:altLabel>
    <skos:altLabel>Domestic Violence Restraining Order</skos:altLabel>
    <skos:altLabel>Restraining Order Claim</skos:altLabel>
    <skos:altLabel>Domestic Restraining Order Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת הגנת אזרחים / צו הגבלת מגורים במקום</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">民事保护索赔 / 国内限制令</skos:altLabel>
    <skos:altLabel>Civil Protection Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de proteção civil / Ordem de restrição doméstica</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">市民防護請求 / 家庭内制限命令</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zivilschutzanspruch / Inlandsverfügung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de protection civile / Ordonnance de restriction domestique</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Civil Protection Claim / Domestic Restraining Order</skos:altLabel>
    <skos:altLabel>Civil Protection Order Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सिविल संरक्षा दावा / घरेलू रोकथाम आदेश</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Civil Protection Claim / Domestic Restraining Order is a legal order issued by a court that prohibits an individual from contacting or coming near another person, typically a family member, in order to protect them from harm or abuse.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUXzL8Z4Ddh2CK6TBhofjU"/>
    <rdfs:label>Civil Protection Claim / Domestic Restraining Order</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Q2UJMIPvStSC7CrG3RLhzw">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=711130"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/9kCtrS-IR2i0tGz02ToM3Q"/>
    <skos:example>Musical groups (except theatrical musical groups)</skos:example>
    <skos:example>Orchestras</skos:example>
    <skos:example>Bands</skos:example>
    <skos:example>Independent musicians or vocalists</skos:example>
    <skos:example>Drum and bugle corps (i.e., drill teams)</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Musical Groups and Artists</rdfs:label>
    <skos:definition>This industry comprises (1) groups primarily engaged in producing live musical entertainment (except theatrical musical or opera productions) and (2) independent (i.e., freelance) artists primarily engaged in providing live musical entertainment. Musical groups and artists may perform in front of a live audience or in a studio, and may or may not operate their own facilities for staging their shows.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/lM5S8xnEQnK7K0V56QXmxw">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81219"/>
    <skos:example>Non-medical diet and weight reducing centers</skos:example>
    <skos:example>Hair replacement (except by offices of physicians) or weaving services</skos:example>
    <skos:example>Tanning salons</skos:example>
    <skos:example>Steam baths</skos:example>
    <skos:example>Permanent makeup salons</skos:example>
    <skos:example>Ear piercing services</skos:example>
    <skos:example>Tattoo parlors</skos:example>
    <skos:example>Depilatory or electrolysis (i.e., hair removal) salons</skos:example>
    <skos:example>Day spas</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing personal care services (except hair, nail, facial, or nonpermanent makeup services).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/eh8Ay3ANTdWnlpqxVysRLw"/>
    <rdfs:label>Other Personal Care Services</rdfs:label>
  </rdf:Description>
