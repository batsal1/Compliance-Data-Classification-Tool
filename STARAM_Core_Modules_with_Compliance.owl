    <skos:altLabel xml:lang="es-mx">Interferencia indebida en la membresía de la asociación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Association Membership Wrongfully Interfered With</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unrechtmäßige Beeinträchtigung der Verbandsmitgliedschaft</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Ingérence abusive dans l'adhésion à une association</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संघ सदस्यता के साथ गलत रूप से हस्तक्षेप किया गया</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">协会会员权益被非法干涉</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">協会の会員資格に不当な干渉があった</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência indevida na filiação a uma associação</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia indebida en la membresía de la asociación</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N0c0808abc8ed40558dd5d5cd3215d3e2"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <skos:definition>The concept of "Association Membership Wrongfully Interfered With" refers to a legal claim made against a corporation or partnership for unlawfully interfering with an individual's membership in an association or organization.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Association Membership Wrongfully Interfered With</rdfs:label>
  </rdf:Description>
