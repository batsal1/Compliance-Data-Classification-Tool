    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Amendment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R81VVZdOeEvD1EbkHfBdKL2">
    <skos:altLabel xml:lang="es-mx">Divulgación ilegal de procedimientos del gran jurado</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Processos do Grande Júri divulgados ilegalmente</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פרקטיקה לא חוקית של חקירות חברתיות של ג'ורי גרנד</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ग्रैंड ज्यूरी प्रक्रियाओं का अवैध रूप से खुलासा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unrechtmäßig offengelegte Grand Jury-Verfahren</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Divulgation illégale de procédures de grand jury</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Grand Jury Proceedings Unlawfully Disclosed</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">違法に開示された大陪審の手続き</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非法披露大陪审团程序</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Divulgación ilegal de procedimientos del gran jurado</skos:altLabel>
    <rdfs:label>Grand Jury Proceedings Unlawfully Disclosed</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nd8595f18e0f84c06b29db7f50940a2bd"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvs4zROaonjMftsSlqlZZp"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Grand Jury Proceedings Unlawfully Disclosed" refers to the illegal act of revealing information about a grand jury investigation, which is supposed to be kept confidential, without proper authorization or legal justification.</skos:definition>
  </rdf:Description>
