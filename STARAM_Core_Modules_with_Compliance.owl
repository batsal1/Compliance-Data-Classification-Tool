    <skos:altLabel xml:lang="es-mx">Tutoría</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">家庭教師</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ट्यूटोरिंग</skos:altLabel>
