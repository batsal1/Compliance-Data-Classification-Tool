  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDYOJik4Ek7UYqiT9NBB2Ux">
    <skos:altLabel xml:lang="es-es">Quantum Meruit</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्वांटम मेरूट</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Quantum Meruit</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">Quantum Meruit</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Quantum Meruit</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Quantum Meruit</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Quantum Meruit</skos:altLabel>
    <skos:altLabel xml:lang="he-il">קוונטום מרואיט</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">Quantum Meruit</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Quantum Meruit</skos:altLabel>
    <rdfs:label>Quantum Meruit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A claim for quantum meruit is a legal action seeking payment for the reasonable value of services or goods provided, when there is no contract or the contract is unenforceable, and is typically brought under the category of equitable relief or quasi-contract claims.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBlW5OLfCbqfO3PmxrRqwG"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9iUJ1YX0zK3V9D0RbQKTP4"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:subClassOf rdf:nodeID="N0011408989d14c8d896165deebbae941"/>
  </rdf:Description>
