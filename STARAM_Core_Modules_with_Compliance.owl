  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCDFQUOX6iWCS5YNroyffSk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Right of Withdrawal</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ICeOg6A95qwBlvRoew3Br"/>
    <skos:definition>The Right of Withdrawal, an element of moral rights in copyright law, empowers the creator to retract their work from the public domain under certain conditions. It reflects the creator's ongoing personal and emotional connection to their work, allowing them to change their mind about publication based on personal or ethical grounds.</skos:definition>
  </rdf:Description>
