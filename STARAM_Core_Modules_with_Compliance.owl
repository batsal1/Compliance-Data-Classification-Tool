  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV">
    <skos:altLabel xml:lang="pt-br">Reivindicações contratuais e quase-contratuais</skos:altLabel>
    <skos:altLabel>Quasi-Contract Claims</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同和准合同索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations contractuelles et quasi-contractuelles</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות חוזיות וחצי-חוזיות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約および準契約請求</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध और क्वासी-अनुबंध दावे</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones contractuales y cuasicontractuales</skos:altLabel>
    <skos:altLabel>Contract Claims</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones contractuales y cuasicontractuales</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertrags- und Quasi-Vertragsansprüche</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Contract &amp; Quasi-Contract Claims</skos:altLabel>
    <skos:definition>Contract &amp; Quasi-Contract Claims refer to legal claims arising from the breach of a contract or an agreement that is not legally binding, but where one party has received a benefit that would be unjust to retain without compensation.</skos:definition>
    <rdfs:label>Contract &amp; Quasi-Contract Claims</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
  </rdf:Description>
