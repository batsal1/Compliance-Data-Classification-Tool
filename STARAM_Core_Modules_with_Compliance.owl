    <skos:altLabel xml:lang="he-il">תכונות השחקן</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">俳優属性</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Atributos do ator</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अभिनेता गुणधर्म</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">演员属性</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schauspielerattribute</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Actor Attributes</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Atributos del Actor</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Atributos del Actor</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Attributs d'acteur</skos:altLabel>
    <skos:definition>Actor Attributes: Characteristics or qualities that define the role or position of a person involved in a legal matter, including their level of involvement (inside, outside, lead, local, supporting).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
