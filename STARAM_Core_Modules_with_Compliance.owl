  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD03oCoAjjHbPHmAqfZnqge">
    <skos:altLabel xml:lang="en-gb">Co-tenant's Share of Profits and Expenses</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Partilha de lucros e despesas do co-inquilino</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Participación del coinquilino en las ganancias y gastos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gewinn- und Kostenanteil des Mitmieters</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Participación del copropietario en las ganancias y gastos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सहमिलकर्ता के लाभ और व्यय का हिस्सा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Part du co-locataire dans les bénéfices et les dépenses</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同テナントの利益および費用の分担</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מניית השותף ברווחים והוצאות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">共同租户的利润和费用份额</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
    <rdfs:subClassOf rdf:nodeID="N5b9c1c0063564ff58a349ee76290922e"/>
    <skos:definition>The Co-tenant's Share of Profits and Expenses refers to the portion of profits and expenses that a co-tenant is entitled to receive or responsible for paying in relation to a property they share with others.</skos:definition>
    <rdfs:label>Co-tenant's Share of Profits and Expenses</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9dd6R73IfKyiskT5Jf62R7">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgzWJQz52CrObfGXDKH1t7"/>
    <skos:altLabel xml:lang="es-mx">Práctica de juicio</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de juicio</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">裁判実務</skos:altLabel>
    <skos:altLabel>Trials</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול במשפטים</skos:altLabel>
    <skos:altLabel>Trial Service</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique du procès</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trial Practice</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática processual</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Prozesspraxis</skos:altLabel>
    <skos:altLabel>Trial</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">审判实践</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ट्रायल प्रैक्टिस</skos:altLabel>
    <rdfs:label>Trial Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Trial Practice refers to the set of legal skills and procedures involved in presenting a case before a court of law, including witness examination, jury selection, trial preparation, testimony, and motion practice.</skos:definition>
  </rdf:Description>
