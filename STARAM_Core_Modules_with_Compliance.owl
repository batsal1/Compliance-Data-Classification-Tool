  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9zy04O1ktopmeDKdmRvLpY">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
    <rdfs:label>Credit Enhancement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Credit Enhancement refers to strategies employed to improve the credit risk profile of a financial transaction or asset, thereby increasing its credit rating and reducing the risk to investors. Techniques include guarantees, insurance, reserve funds, and collateralization to protect against potential losses.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBoIe0xPTT7GpQtX7Z3fc6t">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8FLbODQd9k85hPERve6IN7"/>
    <skos:definition>Land Conservation Rights involve the legal entitlements and mechanisms to protect, preserve, and sustainably manage land and its natural resources. This can include the right of individuals, communities, or organizations to conserve land for ecological, historical, recreational, or cultural significance. Additionally, these rights can manifest through tools like conservation easements, land trusts, and zoning regulations, which aim to prevent degradation, limit development, and ensure the long-term protection of the land's intrinsic values.</skos:definition>
    <rdfs:label>Land Conservation Rights</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R83UGZWX9KH0aZfhtRQ4jCJ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N06ba3aa3de6445df966e663c5c3401d6"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD2KAbcnrk0vfpUCEog3N9F"/>
    <skos:definition>A Lawful Temporary Resident is a foreign national who has been granted permission to reside in a country on a temporary basis under a specific visa or immigration status. This status allows the individual to live and possibly work in the host country for a limited period as defined by the terms of their visa or temporary residency permit.</skos:definition>
    <rdfs:label>Lawful Temporary Resident</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/2d579a6b-d2b4-4892-8c4b-037d05f78d3854bc22b4-be3f-4942-8bc7-c3210ad919f3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Rule of Presumption</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/96d61b45-7761-4b57-aeed-e2c391cac0810b8ddbf4-f45c-4a7d-94e4-78c2a8f8f515"/>
    <skos:definition>Rule for various types of presumption.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N20f1ee12e6a64b209c9b6d04252d5fe1">
