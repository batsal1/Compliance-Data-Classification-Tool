    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">Asset-Based / Secured Lending</ns1:contractFamily>
    <skos:prefLabel>Securities Agreement</skos:prefLabel>
    <rdfs:label>Security Agreement</rdfs:label>
    <skos:definition>A "Security Agreement" is a legal contract between a debtor and a secured party that outlines the collateral provided by the debtor to secure a loan or other obligation. The agreement defines the terms under which the secured party can take possession of the collateral in the event the debtor defaults.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne348a99a68dd41fba2beb34bad538434">
