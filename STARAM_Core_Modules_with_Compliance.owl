    <rdfs:subClassOf rdf:nodeID="N9b469cf9033445a1aeab90ea141a2c3b"/>
    <skos:definition>Tax practice refers lawyers assisting individuals or organizations in navigating tax laws, including compliance, filing returns, and handling disputes with tax authorities. These lawyers may also advise on tax planning strategies to optimize tax liability and benefit</skos:definition>
    <skos:altLabel>Tax</skos:altLabel>
    <skos:altLabel>Tax Service</skos:altLabel>
    <rdfs:label>Tax Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
  </rdf:Description>
