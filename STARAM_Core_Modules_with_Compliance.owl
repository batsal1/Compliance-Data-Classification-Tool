  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RHXDdSfiFTbmrGb8xohHJM">
    <skos:definition>Unfair Trade Practices refer to any deceptive or fraudulent business practices that harm consumers or competitors, and are considered illegal under competition law.</skos:definition>
    <skos:altLabel xml:lang="en-gb">Unfair Trade Practices</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratiques commerciales déloyales</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Prácticas Comerciales Desleales</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अन्यायपूर्ण व्यापार अभ्यास</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不公平贸易行为</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולות מסחר לא הוגנות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不当な取引行為</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unlautere Handelspraktiken</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Prácticas Comerciales Desleales</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Práticas comerciais desleais</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Unfair Trade Practices</rdfs:label>
    <skos:prefLabel>Unfair Trade Practices Claim</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8viNe7dpcLA9kGH5gl7YE6"/>
  </rdf:Description>
