    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Solicitation refers to the act of encouraging, requesting, or commanding another person to commit a crime, with the intent that the crime be committed.</skos:definition>
  </rdf:Description>
