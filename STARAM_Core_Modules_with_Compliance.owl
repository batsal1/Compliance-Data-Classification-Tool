    <skos:altLabel xml:lang="es-mx">Ley de Protección al Consumidor</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Consumer Protection Law</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपभोक्ता संरक्षण कानून</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">消費者保護法</skos:altLabel>
