    <skos:altLabel xml:lang="en-gb">Actions Taken with Consent or Approval of Buyer Language</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Actions prises avec le consentement ou l'approbation de l'acheteur</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acciones Tomadas con el Consentimiento o Aprobación del Comprador</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ações tomadas com o consentimento ou aprovação do comprador</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">在买方同意或批准的情况下采取的行动</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">買い手の同意または承認に基づく措置</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולות שננקטו עם הסכמת או אישור הקונה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार की सहमति या अनुमोदन के साथ लिए गए कार्य</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Actions Taken with Consent or Approval of Buyer Language refers to the specific language in a legal agreement that outlines the actions that can be taken by one party with the consent or approval of the other party, typically in the context of a Material Adverse Effect (MAE) carveout.</skos:definition>
    <rdfs:label>Actions Taken with Consent or Approval of Buyer Language</rdfs:label>
  </rdf:Description>
