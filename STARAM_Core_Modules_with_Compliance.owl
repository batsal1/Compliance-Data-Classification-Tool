  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC4B4XKjrkGV2nCrSywW8Vr">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RS6Pedvqd6vX99HwyhZIlP"/>
    <skos:altLabel xml:lang="ja-jp">明示的な売却義務のない声明</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ausdrückliche Erklärung ohne Veräußerungsverpflichtung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Declaración expresa de no obligación de desinversión</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Déclaration expresse de non-obligation de désinvestissement</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Declaração expressa de não obrigação de desinvestimento</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">无剥离义务的明确声明</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Express Statement of No Divestiture Obligation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Declaración expresa de no obligación de desinversión</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विनिवेश अधिभार के लिए व्यक्तिगत बयान नहीं है</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצהרת ביטוי ללא התחייבות לפטור</skos:altLabel>
    <skos:definition>An express statement made by a party indicating that they are not obligated to divest assets or take other actions to address antitrust concerns, falling under the category of Limitations on Antitrust Efforts Standards.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Express Statement of No Divestiture Obligation</rdfs:label>
  </rdf:Description>
