  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R91fLU1XR4z8ISTl5vpKGnh">
    <rdfs:label>Roving Employment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9zfbONJISnRjpI4gufgjAU"/>
    <skos:definition>Roving Employment refers to a work arrangement where an employee does not have a fixed work location but instead moves between different sites, offices, or geographic areas as part of their job responsibilities. This setup may require extensive travel and adaptability, and is often seen in roles like sales, consulting, and field services.</skos:definition>
  </rdf:Description>
