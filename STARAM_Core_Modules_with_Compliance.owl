    <skos:altLabel xml:lang="en-gb">Down Payment Clause</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Down Payment Clause is a provision in a contract that requires a specified amount of money to be paid upfront by one party to the other as a condition for entering into the agreement.</skos:definition>
