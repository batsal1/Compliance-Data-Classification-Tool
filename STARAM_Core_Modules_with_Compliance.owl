  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RhA1ai8KGTUaVhKjWp54yxA">
    <rdfs:label>PA140 Budgeting</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RS489lsfpR7SJTB0tH66wpQ"/>
    <skos:prefLabel>PA140 Budgeting</skos:prefLabel>
    <skos:definition>Covers developing, negotiating, and revising the budget for a matter that does not fit under other task codes below. Cost estimates which are included as part of other activities, such as reporting an Official Communication from a patent Office, should be included under the appropriate task codes below, unless otherwise instructed by the client.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RV8mJWGZnQhe2gDARKvAiF">
    <skos:altLabel>Plurality-at-Large Voting</skos:altLabel>
    <skos:altLabel>Multi-Winner Voting</skos:altLabel>
    <skos:altLabel>Multiple-Winner Voting System</skos:altLabel>
    <skos:altLabel>Block Voting</skos:altLabel>
    <skos:definition>A winner-take-all multi-winner system is an electoral method where multiple candidates are elected from a single district, and the candidates with the highest number of votes win the available seats. This system can lead to one party or group dominating the representation, often marginalizing minority party voters.</skos:definition>
    <skos:prefLabel>Multi-Winner Plurality System</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Winner-Take-All - Multi-Winner System</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Sn2rwvFp1q6oYORzblWjv"/>
  </rdf:Description>
