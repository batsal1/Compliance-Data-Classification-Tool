  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R6h0B0OkJYPn7irySKHz2S">
    <skos:altLabel xml:lang="en-gb">Ejectment for Wrongful Possession of Claim On Land</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भूमि पर दावा करने के लिए गलात कब्जे के लिए निष्कासन</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Desalojo por posesión ilegal de reclamo sobre la tierra</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פינוי על בסיס תביעה לכיבוש לא חוקי של אדמה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Räumungsklage wegen unrechtmäßigem Besitzanspruch auf Land</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Desahucio por posesión ilegal de reclamo sobre la tierra</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">因土地所有权争议而进行的驱逐</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Despejo por posse ilegal de reivindicação de terra</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">土地の不当占有に対する立ち退き命令</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Expulsion pour possession illégale de revendication sur la terre</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R92zfYLbJJuyDTDnDtJOrLx"/>
    <skos:definition>The concept of "Ejectment for Wrongful Possession of Claim On Land" refers to a legal action taken by a property owner to remove someone who is wrongfully claiming possession of their land.</skos:definition>
    <rdfs:label>Ejectment for Wrongful Possession of Claim On Land</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
