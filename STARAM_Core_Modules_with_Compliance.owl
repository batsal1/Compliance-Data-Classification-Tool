    <skos:altLabel xml:lang="pt-br">Retaliação do empregador</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Represalias del empleador</skos:altLabel>
    <rdfs:label>Employer Retaliation</rdfs:label>
    <skos:definition>The act of an employer taking adverse action against an employee in response to the employee engaging in protected activity, such as reporting illegal conduct or filing a workers' compensation claim.</skos:definition>
