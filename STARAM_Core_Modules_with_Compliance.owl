    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
    <skos:definition>A Waiver of Damages Clause is a provision in a contract where one party agrees to waive their right to seek damages from the other party in the event of a breach of contract or other specified circumstances.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Waiver of Damages Clause</rdfs:label>
  </rdf:Description>
