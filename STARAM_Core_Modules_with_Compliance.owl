    <skos:example>Tapes (e.g., adding machine, calculator, cash register) made from purchased paper</skos:example>
    <skos:example>Envelopes (i.e., mailing, stationery) made from any material</skos:example>
    <skos:example>Tablets (e.g., memo, note, writing) made from purchased paper</skos:example>
    <skos:example>Stationery made from purchased paper</skos:example>
    <skos:example>Die-cut paper products for office use made from purchased paper or paperboard</skos:example>
    <skos:example>Computer paper, die-cut, made from purchased paper</skos:example>
