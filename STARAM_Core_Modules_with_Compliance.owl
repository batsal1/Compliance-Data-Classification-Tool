    <rdfs:subClassOf rdf:nodeID="Nf85f321282374f8794caf36592846fa0"/>
    <skos:definition>Criminal Claim Modifiers are specific types of claims made in a legal matter related to criminal activity, including threatened, attempted, and aggravated claims.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Criminal Claim Modifiers</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCidwgumM09XdytbPtmcuur">
