  <rdf:Description rdf:about="https://folio.openlegalstandard.org/oS3ZjajvSPWy2t8a-D2yAQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=31121"/>
    <rdfs:label>Flour Milling and Malt Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/7h_ZAiafR1OGmih72Z50XA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) milling flour or meal from grains or vegetables; (2) preparing flour mixes or doughs from flour milled in the same establishment; (3) milling, cleaning, and polishing rice; and (4) manufacturing malt from barley, rye, or other grains.</skos:definition>
  </rdf:Description>
