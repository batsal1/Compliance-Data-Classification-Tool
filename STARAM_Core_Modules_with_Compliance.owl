  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8fSoRbI3U75OLeBvp4PzG2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A publisher is an individual, group, or organization responsible for producing and distributing printed or digital content, such as books, newspapers, magazines, or software. Publishers oversee the editorial, production, and marketing processes to bring a work from manuscript or concept to a finished, available product</skos:definition>
    <rdfs:label>Publisher</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8eT1bTptg5J6ZfnwSUQYpf"/>
  </rdf:Description>
