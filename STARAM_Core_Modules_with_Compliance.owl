  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7g7orVXBD7PBoQArPcDYsz">
    <skos:example>Organic Meat and Poultry</skos:example>
    <skos:example>Organic Fruits and Vegetables</skos:example>
    <skos:example>Organic Dairy Products</skos:example>
    <skos:prefLabel>Natural Foods Market Segment</skos:prefLabel>
    <skos:definition>The organic foods market segment refers to a division of the market that is specifically targeted towards consumers who are interested in foods that are produced using methods that do not involve synthetic pesticides, fertilizers, genetically modified organisms (GMOs), or irradiation. This segment encompasses products and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek natural, environmentally friendly, and health-conscious food options.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rt7y5QJoXmShB4OEPQ8Ysl"/>
    <skos:altLabel>Organic Foods Market Segment</skos:altLabel>
    <rdfs:label>Organic Products Market Segment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
