  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVZJBUCRB7cgWN1CIbeJJq">
    <skos:altLabel xml:lang="hi-in">तथ्य जांच और विकास</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חקירת עובדות ופיתוח</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Investigación y Desarrollo de Hechos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fact Investigation and Development</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Investigação e desenvolvimento de fatos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Enquête et développement de faits</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Faktenermittlung und -entwicklung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">事実調査と開発</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">事实调查和开发</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Investigación y Desarrollo de Hechos</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNlaIvo9pK9MgOcwKug5on"/>
    <rdfs:label>Fact Investigation and Development</rdfs:label>
    <skos:definition>Fact Investigation and Development refers to the process of gathering and analyzing evidence and information related to a legal matter, including interviewing witnesses and experts, analyzing technical data, and assessing the validity of claims.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ih8EI2O3Rr2VB1b2JLaHwA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/4CzfktbVRua2rRGxaHt4mA"/>
    <skos:definition>This industry comprises establishments primarily engaged in the merchant wholesale distribution of commercial and related machines and equipment (except photographic equipment and supplies; office equipment; and computers and computer peripheral equipment and software) generally used in restaurants and stores.</skos:definition>
    <skos:example>Commercial cooking equipment merchant wholesalers</skos:example>
    <skos:example>Coin- or card-operated merchandising machine merchant wholesalers</skos:example>
    <skos:example>Commercial shelving merchant wholesalers</skos:example>
    <skos:example>Store fixtures (except refrigerated) merchant wholesalers</skos:example>
    <skos:example>Commercial chinaware merchant wholesalers</skos:example>
    <skos:example>Balances and scales (except laboratory) merchant wholesalers</skos:example>
    <skos:example>Electrical signs merchant wholesalers</skos:example>
    <skos:example>Partitions merchant wholesalers</skos:example>
    <rdfs:label>Other Commercial Equipment Merchant Wholesalers</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=423440"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#relief-indemnity">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
