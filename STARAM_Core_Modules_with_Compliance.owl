    <skos:altLabel xml:lang="hi-in">व्यक्तिगत चोट और टॉर्ट कानून</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho de Daños y Perjuicios Personales</skos:altLabel>
    <skos:altLabel>Personal Injury and Torts</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">人身傷害および不法行為法</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Personal Injury and Tort Law</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Derecho de Daños y Perjuicios Personales</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוק פגיעה אישית וטורט</skos:altLabel>
