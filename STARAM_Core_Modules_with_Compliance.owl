  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7TMXUE0nBJ2a4RL8LbordW">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rt7TTPXJ7WX1Jrjufs0Mdr"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A devisee is an individual or entity designated in a will to receive real property from the estate of the deceased. The term specifically refers to beneficiaries of real estate, distinguishing them from legatees who inherit personal property.</skos:definition>
    <rdfs:label>Devisee</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/IBVNBPHeQva7m00TTfEC-g">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561591"/>
    <rdfs:label>Convention and Visitors Bureaus</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/aVATO1h8Q7yGC9sLbSm7jw"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in marketing and promoting communities and facilities to businesses and leisure travelers through a range of activities, such as assisting organizations in locating meeting and convention sites; providing travel information on area attractions, lodging accommodations, restaurants; providing maps; and organizing group tours of local historical, recreational, and cultural attractions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
