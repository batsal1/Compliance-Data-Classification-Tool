    <skos:example>Assembly machines (i.e., wire making equipment) manufacturing</skos:example>
    <skos:example>Metalworking coil winding and cutting machinery manufacturing</skos:example>
    <skos:example>Wire drawing and fabricating machinery and equipment (except dies) manufacturing</skos:example>
    <skos:example>Cradle assembly machinery (i.e., wire making equipment) manufacturing</skos:example>
    <skos:example>Rolling mill roll machines, metalworking, manufacturing</skos:example>
    <rdfs:label>Rolling Mill and Other Metalworking Machinery Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/tEn-M7tEQwSDoAaEWhntrQ"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing rolling mill machinery and equipment and/or other metalworking machinery (except industrial molds; special dies and tools, die sets, jigs, and fixtures; cutting tools and machine tool accessories; and machine tools).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333519"/>
  </rdf:Description>
