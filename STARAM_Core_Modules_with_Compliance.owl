    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Constructive Fraud is a type of fraud claim that arises when a party's actions or omissions, although not intentionally fraudulent, result in harm or injury to another party.</skos:definition>
  </rdf:Description>
