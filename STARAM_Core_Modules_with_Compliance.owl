  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9QUQK65GB15xLVfXkpiW5r">
    <skos:definition>Asset Exchange Attributes encompass various methods by which financial assets are traded or converted to achieve specific strategic objectives. These attributes involve transactions where assets like debt and equity are exchanged to improve financial structure, raise capital, or consolidate ownership.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Financial Exchange Traits</skos:altLabel>
    <skos:altLabel>Asset Swap Characteristics</skos:altLabel>
    <rdfs:label>Asset Exchange Attributes</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9c3HXkuELwcWa4UNcvpbxk"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RNQ-wMsECS8Oxe6o5mlMtiA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rn5kG4YdbRjOyGEVaUvrizw"/>
    <rdfs:label>P800 Maintenance and Renewal</rdfs:label>
    <skos:prefLabel>P800 Maintenance and Renewal</skos:prefLabel>
    <skos:definition>This phase includes all tasks related to subsequent maintenance and renewal requirements under the terms of the transaction or project such as monitoring of lease agreements, routine waivers and coordination of UCC requirements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
