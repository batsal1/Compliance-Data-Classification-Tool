  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8jj3srBAJ1uwSbhFqlt9Y1">
    <skos:altLabel xml:lang="es-es">Acto u Omisión Razonable</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Acte ou omission raisonnable</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reasonable Act or Omission</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合理行为或不作为</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Angemessene Handlung oder Unterlassung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合理な行為または不作為</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acto u Omisión Razonable</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולה או התעלמות סבירה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उचित कार्य या अनुपस्थिति</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ato ou omissão razoável</skos:altLabel>
    <rdfs:label>Reasonable Act or Omission</rdfs:label>
    <skos:definition>An act or failure to act that a reasonable person would or would not do, which is used as a standard to determine liability in cases involving the condition of public property and governmental immunity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCHbjppawvAlt5WcUyfjeN8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
