    <skos:definition>A Split Dollar Agreement is a contract that details how the premiums, death benefits, and cash values of a life insurance policy are split between two parties. Typically, one party owns the policy, while the other has a vested interest in the death benefit or cash value.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Split Dollar Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
  </rdf:Description>
