  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQ1Ag0nBDfe33vXin188p5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Negligencia médica en Otorrinolaringología</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Otolaryngology Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">耳鼻喉科医疗事故</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">耳鼻咽喉科医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית באוטולרינגולוגיה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ओटोलेरिंगोलॉजी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en oto-rhino-laryngologie</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica em Otorrinolaringologia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hals-Nasen-Ohrenheilkunde-Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en Otorrinolaringología</skos:altLabel>
    <rdfs:label>Otolaryngology Malpractice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <skos:definition>Negligent or wrongful conduct by a medical professional in the field of otolaryngology, resulting in harm or injury to a patient.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDc9DVnOHM4a1xADu1lh9lz">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD3fTefpnCuP3Hxdj2ZPXFh"/>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Nation-Provided Public Benefit</rdfs:label>
    <skos:definition>Nation-provided public benefit refers to social assistance programs that are administered and funded by a country's federal or national government. Examples include national healthcare systems, unemployment insurance, and pension schemes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBAxfpbmWO6iXLjcldJnbKt">
    <skos:altLabel xml:lang="de-de">Diskriminierungsklage bei Hintergrundüberprüfung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por discriminación en la verificación de antecedentes</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">背景调查歧视索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de discriminação em verificação de antecedentes</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Background Check Discrimination Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de discriminación en la verificación de antecedentes</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">バックグラウンドチェック差別クレーム</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बैकग्राउंड चेक भेदभाव दावा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de discrimination lors d'une vérification des antécédents</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על הפרת זכויות בבדיקת רקע</skos:altLabel>
    <skos:definition>A background check claim is a legal action initiated by an individual who alleges they have been unfairly treated or denied employment, housing, or other opportunities based on the results of a background check. Background checks typically involve the examination of an individual's criminal record, credit history, employment history, or other personal information. These claims often arise when an employer, landlord, or other decision-maker violates the Fair Credit Reporting Act (FCRA) or other applicable laws by not providing proper notice, failing to obtain consent, or using the background check information in a discriminatory manner.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdfs:label>Background Check Discrimination Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
