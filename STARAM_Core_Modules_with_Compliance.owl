    <ns1:contractFamily xml:lang="en">Real Estate &amp; Leasing</ns1:contractFamily>
    <skos:altLabel xml:lang="es-es">Acuerdo de asunción de arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租赁承接协议</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लीज़ असमंजस मसला</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">リースアサンプション契約</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acuerdo de asunción de arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Übernahmevereinbarung für Mietverträge</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Lease Assumption Agreement</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם להנחת שכירות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord d'assomption de bail</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Acordo de Assunção de Locação</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Lease Assumption Agreement is a legal contract that allows a new tenant to take over the lease of a property from the original tenant, with the consent of the landlord, and outlines the terms and conditions of the transfer.</skos:definition>
    <rdfs:label>Lease Assumption Agreement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCN3k0phRGqCx0eJP0i4N21">
    <skos:altLabel xml:lang="pt-br">Não se opôs durante o período de acompanhamento</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nicht widersprochen während der Nachlaufzeit</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूंजी की अवधि के दौरान विरोध नहीं किया गया</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">尾随期间未反对</skos:altLabel>
    <skos:altLabel xml:lang="es-es">No se opuso durante el período de cola</skos:altLabel>
    <skos:altLabel xml:lang="he-il">לא התנגד במהלך תקופת הזנב</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">No se opuso durante el período de cola</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">テール期間に反対されていない</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Non contesté pendant la période de suivi</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Not Opposed During Tail Period</skos:altLabel>
    <skos:definition>Not Opposed During Tail Period: A condition in the Timing of Acquisition Proposal Closing where the target company does not express opposition during the specified period after the proposal is made.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xvhTRvZsOK7xYmQh6eEKG"/>
    <rdfs:label>Not Opposed During Tail Period</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc993a5b7e83c481e838b0414408d8dc1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermMaterialAdverseEffect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCXrYpp1ijYGjHeVTcU5RfV">
    <skos:altLabel xml:lang="he-il">סעיף תשלום עבור שירותים שניתנו</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दी गई सेवाओं के लिए भुगतान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Pagamento por Serviços Prestados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Payment for Services Rendered Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Pago por Servicios Prestados</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">提供されたサービスの支払い条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">已提供服务的支付条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de paiement pour services rendus</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Bezahlung erbrachter Dienstleistungen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Pago por Servicios Prestados</skos:altLabel>
    <skos:definition>A Payment for Services Rendered Clause is a provision in a contract that outlines the terms and conditions for compensating a party for services provided.</skos:definition>
    <rdfs:label>Payment for Services Rendered Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N74b44d9090494b50a74cf2101d46a5af">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#NoWaiver"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8H9mw1xu0sYmrwbdIVo92A">
    <skos:definition>A legal doctrine known as Brillhart-Wilton Abstention, which falls under the category of abstention doctrines, allows a federal court to abstain from hearing a case that involves complex state law issues that are better suited for resolution in state court.</skos:definition>
    <skos:altLabel xml:lang="fr-fr">Abstention de Brillhart-Wilton</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Abstención de Brillhart-Wilton</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abstención de Brillhart-Wilton</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התמנות ברילהרט-ווילטון</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">布里尔哈特-威尔顿回避原则</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Abstenção de Brillhart-Wilton</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Brillhart-Wilton-Abstinenz</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ब्रिलहार्ट-विल्टन अवहेलना</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Brillhart-Wilton Abstention</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ブリルハート・ウィルトン棄権</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RuliWeVDE8CQi4AATMNab1"/>
    <rdfs:label>Brillhart-Wilton Abstention</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
