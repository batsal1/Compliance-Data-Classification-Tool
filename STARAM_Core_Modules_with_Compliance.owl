    <rdfs:subClassOf rdf:nodeID="N49591f85e1764a0e8cd4ec627941d5d5"/>
    <skos:definition>04_1 Civil Rights (PACER NoS) refers to a specific category of civil rights cases in the PACER system, including cases related to employment, voting, disabilities, education, housing, and other civil rights issues.</skos:definition>
    <rdfs:label>04_1 Civil Rights (PACER NoS)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7KZwhAGHfOZiJ3JU4whCT4">
    <skos:altLabel xml:lang="hi-in">रेलवे लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia Ferroviaria</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Eisenbahnnachlässigkeit</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência ferroviária</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence ferroviaire</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">鉄道過失</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות ברכבת</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">铁路过失</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Railway Negligence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia Ferroviaria</skos:altLabel>
    <skos:definition>The concept of Railroad Negligence refers to the legal responsibility of a common carrier, such as a railroad company, to exercise reasonable care in the operation and maintenance of its equipment and facilities to prevent harm to passengers and others.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N5002d1d93b934b78831bc0c3321e6b1a"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWNAwJemBq0gDs7LXfCjnE"/>
    <rdfs:label>Railroad Negligence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8p15egW5el3Go9V1L4obop">
    <skos:altLabel xml:lang="fr-fr">Responsabilité stricte du fabricant</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">严格产品责任</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad objetiva del producto</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सख्त उत्पाद दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad objetiva del producto</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade objetiva do fabricante</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Strict Product Liability</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Strenge Produkthaftung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות מוצר קפדנית</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">厳格な製品責任</skos:altLabel>
    <rdfs:label>Strict Product Liability</rdfs:label>
    <skos:definition>Strict Product Liability is a legal concept that holds manufacturers and sellers responsible for any harm caused by their products, regardless of fault or negligence, if the product is found to be defective.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RdN6a66644QYTrLMGgEar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBDfRm4fG5sFgdk95zLTcJa">
    <skos:definition>The social security funding objective aims to ensure the financial sustainability of a social security system, which provides benefits such as retirement income, disability payments, and healthcare coverage. This objective involves strategies for collecting sufficient revenues through taxes or contributions and managing expenditures to maintain long-term solvency.</skos:definition>
    <rdfs:label>Social Security Funding Objective</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
    <rdfs:subClassOf rdf:nodeID="N9b400de2f9764a5096eedeb325862481"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
