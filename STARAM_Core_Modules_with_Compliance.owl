    <skos:altLabel xml:lang="es-es">Cláusula de Derecho de Último Rechazo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">最後優先権条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right of Last Refusal Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zum Recht des letzten Widerspruchs</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit de préemption</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Derecho de Último Rechazo</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכות הסירוב האחרונה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अंतिम अस्वीकरण का अधिकार शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de direito de preferência</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Right of Last Refusal Clause</rdfs:label>
    <skos:definition>A Right of Last Refusal Clause is a provision in a contract that gives a party the option to purchase property or assets before they are offered to others.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBdRbQ6LheYkEvM4LBGBHps">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL"/>
    <skos:definition>"Post-Closing Covenants" are promises or obligations that parties agree to adhere to after the completion of a transaction, such as a merger. In merger agreements, these covenants typically address ongoing commitments, actions, or restrictions to ensure a smooth transition and integration, or to protect the interests of the involved parties after the deal has closed.</skos:definition>
    <rdfs:label>Post-Closing Covenants</rdfs:label>
  </rdf:Description>
