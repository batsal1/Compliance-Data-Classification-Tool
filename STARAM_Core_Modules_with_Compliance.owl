  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDyRgvXjMTUxb484hmkEfzM">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7RS1hG7BxbLQktXIrO1Rro"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Litigation Applicant/Petitioner is an individual or entity initiating a lawsuit or formal legal proceedings by filing a complaint or petition with a court. This party seeks judicial intervention to obtain relief, resolve disputes, or enforce legal rights, setting the judicial process in motion.</skos:definition>
    <rdfs:label>Litigation Applicant/Petitioner</rdfs:label>
  </rdf:Description>
