    <skos:altLabel xml:lang="es-es">Toma de declaración</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Prise de déposition</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Tomando depoimento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">לקחת הצהרה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Taking Deposition</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">証言の取得</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">采取证言</skos:altLabel>
