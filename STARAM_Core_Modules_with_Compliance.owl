  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7ME5bcP1ep2LpnUSiBvP1T">
    <skos:altLabel xml:lang="fr-fr">Pratique préliminaire</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática pré-processual</skos:altLabel>
    <skos:altLabel>Pretrial</skos:altLabel>
    <skos:altLabel>Pretrial Service</skos:altLabel>
    <skos:altLabel>Pre-Trial</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pretrial Practice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">审前实践</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vorverfahrenspraxis</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रीट्रायल अभ्यास</skos:altLabel>
