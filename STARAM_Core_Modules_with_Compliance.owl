    <rdfs:label>Civic and Social Organizations</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in promoting the civic and social interests of their members. Establishments in this industry may operate bars and restaurants for their members.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/2pXtuqf_Rlq4ikSqCT7SHg"/>
