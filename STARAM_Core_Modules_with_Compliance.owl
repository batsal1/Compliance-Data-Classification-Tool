    <skos:altLabel xml:lang="pt-br">Prática pós-julgamento</skos:altLabel>
    <skos:altLabel>Post-Trial Service</skos:altLabel>
    <skos:altLabel>Post-Trial</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nachprozesspraxis</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול לאחר הניסיון</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica Post-Trial</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Post-Trial Practice</rdfs:label>
    <skos:definition>Post-Trial Practice refers to the legal work performed after a trial has concluded, including motions and submissions related to the outcome of the trial.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBgzWJQz52CrObfGXDKH1t7"/>
  </rdf:Description>
