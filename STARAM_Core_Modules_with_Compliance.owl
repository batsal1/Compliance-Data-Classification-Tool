  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7dIoqwvQvmYE03eXBHmcO">
    <skos:altLabel>In immigration law, "Adjustment of Status Pending" refers to the interim period during which an individual's application to adjust their immigration status, often from a non-immigrant to an immigrant status (permanent resident), is under review by the immigration authorities (e.g., U.S. Citizenship and Immigration Services (USCIS)). During this time, the applicant is generally authorized to remain in the destination country (e.g., U.S.) and may be eligible for work authorization and other interim benefits while awaiting a final decision</skos:altLabel>
    <skos:altLabel>AOS Pending</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Adjustment of Status Pending</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RJEhNjPDXIeJRMwifVraDk">
    <skos:altLabel xml:lang="he-il">טעות בחוזה</skos:altLabel>
