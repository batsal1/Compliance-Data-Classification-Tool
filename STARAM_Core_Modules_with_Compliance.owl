    <skos:definition>A Factoring Agreement is a financial arrangement where a business sells its accounts receivable, or invoices, to a third-party factoring company at a discount. This agreement outlines the terms and conditions under which the factoring company will advance funds, collect payments, and charge fees, providing immediate liquidity to the original business.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">Asset-Based / Secured Lending</ns1:contractFamily>
    <rdfs:label>Factoring Agreement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RGVC4iLBAv5yqaFh8rYlz6">
    <skos:definition>A Compensation Clause, also known as a Payment Clause, is a provision in a contract that outlines the terms and conditions for payment in the event of a breach or termination of the agreement.</skos:definition>
    <skos:altLabel xml:lang="hi-in">मुआवजा धारा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de compensation</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Compensation Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de compensación</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de compensación</skos:altLabel>
    <skos:altLabel>Payment Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Entschädigungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">赔偿条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">補償条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de compensação</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פיצויים</skos:altLabel>
    <rdfs:label>Compensation Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
