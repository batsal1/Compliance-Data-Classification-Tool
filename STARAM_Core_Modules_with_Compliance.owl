  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Efd4vRm9Q5qQSyxZRc3gug">
    <skos:example>Agricultural organizations (except youth farming organizations, farm granges)</skos:example>
    <skos:example>Chambers of commerce</skos:example>
    <skos:example>Real estate boards</skos:example>
    <skos:example>Manufacturers' associations</skos:example>
    <skos:example>Trade associations</skos:example>
    <skos:definition>This industry comprises establishments primarily engaged in promoting the business interests of their members. These establishments may conduct research on new products and services; develop market statistics; sponsor quality and certification standards; lobby public officials; or publish newsletters, books, or periodicals for distribution to their members.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/cXYvEA_TSW-TyFU9Wji_UA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=813910"/>
    <rdfs:label>Business Associations</rdfs:label>
  </rdf:Description>
