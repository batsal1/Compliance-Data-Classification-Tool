  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7zVAb2kzP6ZyfHRn7WMpBB">
    <skos:altLabel xml:lang="es-es">Aplicación Forward-looking MAE - Lenguaje de "Impacto adverso en el negocio del objetivo"</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anwendung von Forward-Looking MAE - Sprache "Adverse Auswirkungen auf das Geschäft des Ziels"</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Forward-looking MAE Application - "Adverse impact on target's business" Language</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Aplicación Forward-looking MAE - Lenguaje de "Impacto adverso en el negocio del objetivo"</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Aplicação de Forward-Looking MAE - Linguagem "Impacto adverso nos negócios do alvo"</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फॉरवर्ड-लुकिंग एमएई एप्लिकेशन - "लक्ष्य के व्यवसाय पर नकारात्मक प्रभाव" भाषा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Application de Forward-Looking MAE - Langage "Impact négatif sur l'activité de la cible"</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">前瞻性 MAE 应用 - "对目标业务的不利影响" 语言</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">Forward-Looking MAE アプリケーション - "ターゲットのビジネスへの不利な影響" 言語</skos:altLabel>
    <skos:altLabel xml:lang="he-il">Forward-looking MAE Application - שפת "השפעה שלילית על העסק של המטרה"</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Forward-looking MAE Application - "Adverse impact on target's business" Language is a specific application of the Forward-looking Material Adverse Effect (MAE) Standard that focuses on the potential negative effects on the target company's business in the future.</skos:definition>
    <rdfs:label>Forward-looking MAE Application - "Adverse impact on target's business" Language</rdfs:label>
