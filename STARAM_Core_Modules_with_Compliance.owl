    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Abandonment Practice refers to the legal process of relinquishing ownership or control of an asset, typically in the context of Asset Disposition Practice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC4QMCtqIKU9i366bPpd3rG">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Petty Theft</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Petty Theft</skos:altLabel>
    <skos:altLabel xml:lang="de-de">kleiner Diebstahl</skos:altLabel>
    <skos:altLabel xml:lang="he-il">גניבה קטנה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">furto simples</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Robo Menor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">छोटी चोरी</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Hurto Menor</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">vol simple</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">小偷窃</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">軽度窃盗</skos:altLabel>
    <skos:definition>Petty Theft is a criminal offense that involves the unlawful taking of property or money that is of relatively low value, typically classified as a misdemeanor.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <rdfs:subClassOf rdf:nodeID="N94761a177d8941f9ade7c5bbbd24a761"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rr9w7wCl8wpJfmdqqOJ6m4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-mx">Receptor Temporal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">récepteur temporaire</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">临时接收人</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מקבל זמני</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">一時的な受信者</skos:altLabel>
    <skos:altLabel xml:lang="de-de">vorläufiger Empfänger</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अस्थायी रिसीवर</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Temporary Receiver</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Receptor Temporal</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Receptor temporário</skos:altLabel>
    <rdfs:label>Temporary Receiver</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R96NpUUsxlbrpJSPTQxDoH9"/>
    <skos:definition>A Temporary Receiver is a person appointed by a court to take control of and manage a business or property for a limited period of time, typically to preserve assets or prevent harm until a permanent receiver can be appointed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVcQsyiR3zEN86uQG2Onsy">
    <skos:altLabel xml:lang="en-gb">Affirmative Covenant</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התחייבות אפירמטיבית</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Convention positive</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Convenção afirmativa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Convenio afirmativo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Positives Baulasten</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">肯定的誓約</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सकारात्मक अधिवेशन</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Convenio afirmativo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">肯定性契约</skos:altLabel>
    <rdfs:label>Affirmative Covenant</rdfs:label>
    <skos:definition>An affirmative covenant is a legally binding promise made by one party to another to take specific actions or refrain from certain activities, as outlined in a contract or agreement, in order to fulfill a particular obligation or achieve a specific goal.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUqAm74lUE8pmrNqTadcrl"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R81gIxZEycEyh9ymjYjs9qK">
    <skos:altLabel>Debt Conversion</skos:altLabel>
    <skos:altLabel>Debt-to-Equity Swap</skos:altLabel>
    <skos:altLabel>Equity Conversion</skos:altLabel>
    <skos:altLabel>Equity-to-Debt Swap</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9QUQK65GB15xLVfXkpiW5r"/>
    <skos:prefLabel>Exchange Equity for Debt</skos:prefLabel>
    <skos:definition>An asset exchange where a party replaces debt with equity — or equity with debt — in a company. Replacing debt with equity often occurs during restructuring to improve financial stability. Replacing equity with debt can help raise capital while avoiding dilution of ownership.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Exchange Debt for Equity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8kmQMgCr7HN4i77QrZkVwg">
    <skos:altLabel xml:lang="es-mx">Préstamo con contingencia hipotecaria que exige comisión ilegal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Préstamo con contingencia hipotecaria que exige comisión ilegal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऋण नियमितता ऋण अवैध कमीशन को निष्कर्षित करता है</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Prêt de contingence hypothécaire, commission illégale exacte</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Empréstimo de contingência hipotecária, comissão ilegal exata</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mortgage Contingency Loan Exacting Illegal Commission</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">按揭附带条件贷款，精确的非法佣金</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הלוואת תנאי משכנתא מוציאה עמלה בלתי חוקית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hypotheken-Kontingenzdarlehen, exakte illegale Provision</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">抵当権付き条件付きローン、正確な違法手数料</skos:altLabel>
    <rdfs:label>Mortgage Contingency Loan Exacting Illegal Commission</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Naa24c73aec184d6da7ce3d2c5211c8e2"/>
    <rdfs:subClassOf rdf:nodeID="Nd508bcbffe0e43d5a2877f2151fa5a6f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Mortgage Contingency Loan Exacting Illegal Commission is a type of loan in which the lender charges an illegal commission to the borrower, and the loan is contingent upon the borrower obtaining a mortgage.</skos:definition>
  </rdf:Description>
