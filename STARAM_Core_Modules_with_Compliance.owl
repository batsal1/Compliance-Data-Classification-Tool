  <rdf:Description rdf:about="https://folio.openlegalstandard.org/HmiKW24HStOR9ekPviypfA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in the farm raising and production of aquatic animals or plants in controlled or selected aquatic environments.  These establishments use some form of intervention in the rearing process to enhance production, such as holding in captivity, regular stocking, feeding, and protecting from predators, pests, and disease.</skos:definition>
    <rdfs:label>Aquaculture</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/5uTZQJ54RrS09SwZ9yZCOA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=11251"/>
