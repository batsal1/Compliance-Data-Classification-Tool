  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCUqGer9HHWVokBHORBqZ3i">
    <skos:altLabel xml:lang="de-de">Klausel zur Mitteilung der Verfügung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de notificación de disposición</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विनियोग नोटिस क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Aviso de Disposição</skos:altLabel>
