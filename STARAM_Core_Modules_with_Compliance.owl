  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDjGVtbkpmSvuHjMNBohZ8o">
    <skos:altLabel>Defensive Machine Learning</skos:altLabel>
    <skos:altLabel>Adversarial AI</skos:altLabel>
    <skos:altLabel>Adversarial Attack Techniques</skos:altLabel>
    <rdfs:label>Adversarial Machine Learning</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
    <skos:definition>Adversarial Machine Learning refers to the study and design of algorithms that can withstand intentional manipulation or adversarial attacks. These attacks aim to deceive machine learning models by supplying deceptive inputs, highlighting vulnerabilities and the need for robust defenses in AI systems.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RI2amMkwxQGg3O1kvboDTU">
    <skos:altLabel>Corporate Chair</skos:altLabel>
    <skos:prefLabel>Chairman of the Board</skos:prefLabel>
    <rdfs:label>Board Chair</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9qtOzWmov77zTz4rUCNAKr"/>
    <skos:definition>A Corporate Chair, or Chairman of the Board, is the presiding officer of a company's board of directors, responsible for leading board meetings and ensuring effective board governance. The Chair facilitates discussions, oversees board functions, and often acts as a liaison between the board and executive management.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
