  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBBu1oEeGLOZwYrYMPTvgfz">
    <skos:altLabel xml:lang="es-mx">Coordinación de Co-Parte</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Co-Party Coordination</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Coordination entre co-parties</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">共同参与方协调</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同参加者調整</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תיאום עם-מפלגה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ko-Parteien-Koordination</skos:altLabel>
    <skos:altLabel>Joint Defense Group</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सह-पक्ष समन्वय</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Coordenação entre co-partes</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Coordinación de Co-Parte</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Co-Party Coordination (e.g., Joint Defense Groups) refers to the collaborative efforts of multiple parties in a legal matter, such as forming a joint defense group, to coordinate their defense strategy and share information.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNlaIvo9pK9MgOcwKug5on"/>
    <rdfs:label>Co-Party Coordination</rdfs:label>
  </rdf:Description>
