  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBezOsNqOiZGv3hJvsQvVkp">
    <rdfs:label>Bring Down Certificate Clause</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Bring Down Certificate Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Certificación de Actualización</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Certificación de Actualización</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de réduction du certificat</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ब्रिंग डाउन प्रमाणपत्र डाक</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">証明書削減条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">下证条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תעודת הורדה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de redução do certificado</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Herabsetzung des Zertifikats</skos:altLabel>
    <skos:definition>A Bring Down Certificate Clause is a provision in a contract that requires a party to provide updated information or documentation at a later time to ensure the accuracy of the original representations and warranties made in the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
