    <skos:altLabel xml:lang="pt-br">Negligência da parteira</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hebammenfehler</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle de la sage-femme</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Midwife Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">助産師の過失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दाई दोष</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאת מיון</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Midwife Malpractice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <skos:definition>Negligent or improper actions or omissions by a midwife during the course of providing medical care, resulting in harm or injury to the patient.</skos:definition>
  </rdf:Description>
