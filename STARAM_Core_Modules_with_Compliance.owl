    <skos:altLabel xml:lang="ja-jp">家電条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de electrodomésticos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Appliances Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Geräteklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de eletrodomésticos</skos:altLabel>
