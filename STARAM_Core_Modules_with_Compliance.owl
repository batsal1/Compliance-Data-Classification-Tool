    <skos:altLabel xml:lang="de-de">Aufhebung des Wiederbestätigungsvertrags</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Résiliation de l'accord de réaffirmation</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">撤销重申协议</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पुनर्नवीकरण समझौते का रद्द करना</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Rescisão do Acordo de Reafirmação</skos:altLabel>
