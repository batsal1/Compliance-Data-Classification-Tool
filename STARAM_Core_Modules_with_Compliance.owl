  <rdf:Description rdf:about="https://folio.openlegalstandard.org/kVMh7FMMSUeYrg0u2UvdkA">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in making manufactured homes (i.e., mobile homes) and nonresidential mobile buildings. Manufactured homes are designed to accept permanent water, sewer, and utility connections and although equipped with wheels, they are not intended for regular highway movement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Manufactured Home (Mobile Home) Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=321991"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/fOPbREAsSIarGeJiYAaoiw"/>
  </rdf:Description>
