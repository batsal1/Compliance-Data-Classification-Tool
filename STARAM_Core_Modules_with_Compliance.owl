  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Vbg_AW0iQnqmEwYY23zpOA">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in performing services on crops, subsequent to their harvest, with the intent of preparing them for market or further processing. These establishments provide postharvest activities, such as crop cleaning, sun drying, shelling, fumigating, curing, sorting, grading, packing, and cooling.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/a-WMSGfvSDCXHFqyHRYryg"/>
    <rdfs:label>Postharvest Crop Activities (except Cotton Ginning)</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=115114"/>
  </rdf:Description>
