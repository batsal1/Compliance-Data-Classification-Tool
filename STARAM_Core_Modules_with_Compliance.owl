  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7MxkTvcb7ueuW8WviDGm7p">
    <skos:prefLabel>Immigration Priority Date</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The immigration priority date is a critical concept in immigration system, marking the date when an individual's application for a visa or permanent residency (such as filing Form I-485) is first received by the relevant authority. This date determines the applicant's place in the queue for visa availability, as visas are allocated based on the priority date in conjunction with the visa bulletin.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ODLnhxFt38FQNV4BUbRSD"/>
    <rdfs:label>Visa Priority Date</rdfs:label>
    <skos:altLabel>Queue Date</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfae91a85c19e48d5aa8c13e56c59ffb6">
