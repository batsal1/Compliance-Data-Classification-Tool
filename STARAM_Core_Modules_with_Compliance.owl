  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8evMeNsxochHY3GkdiS2As">
    <skos:altLabel xml:lang="hi-in">नुकसान के लिए मुआवजा धारा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">损害赔偿条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schadensersatzklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">損害賠償条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de compensação por danos</skos:altLabel>
