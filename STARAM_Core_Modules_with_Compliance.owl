    <skos:altLabel xml:lang="pt-br">Negligência de veículo automotor</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自動車過失</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence automobile</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मोटर वाहन लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">机动车过失</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Motor Vehicle Negligence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia de Vehículo Automotor</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia de Vehículo de Motor</skos:altLabel>
