    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>In a homestead exemption, a property is protected from being sold to pay off debts in a bankruptcy case, as it is considered essential for the debtor's basic needs and livelihood.</skos:definition>
    <rdfs:label>Homestead Exemption</rdfs:label>
  </rdf:Description>
