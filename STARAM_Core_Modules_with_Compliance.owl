  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RORCUYDiiZxOrpiC8NiK74">
    <rdfs:label>Corporate Vice President</rdfs:label>
    <skos:altLabel>EVP</skos:altLabel>
    <skos:altLabel>Executive Vice President</skos:altLabel>
    <skos:altLabel>Senior Vice President</skos:altLabel>
    <skos:altLabel>VP</skos:altLabel>
    <skos:altLabel>SVP</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Corporate Vice President is an executive officer responsible for leading specific departments or functions within a company and supporting the President or CEO in executing strategic initiatives. The Vice President may oversee operations, sales, finance, or other divisions, often holding a key leadership role within the organization's hierarchy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCwdLsWxoa7TqpUv5hIYwzW"/>
  </rdf:Description>
