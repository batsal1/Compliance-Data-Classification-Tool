  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4pYCvaJ8nADRG8NCwgCoa">
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-WHT-DURG</ns2:legacyIdentifier>
    <skos:prefLabel>Merchant Wholesalers, Durable Goods Industry</skos:prefLabel>
    <dc:identifier>IN-INDUSTRY-20.2</dc:identifier>
    <dc:identifier>WHT-DURG</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Merchant Wholesalers, Durable Goods Industry</rdfs:label>
    <skos:hiddenLabel>DURG</skos:hiddenLabel>
    <skos:altLabel xml:lang="de-de">Großhandel mit langlebigen Gebrauchsgütern</skos:altLabel>
    <skos:altLabel>Merchant Wholesalers, Durable Goods</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">耐用消费品批发商</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Commerce de gros de biens durables</skos:altLabel>
