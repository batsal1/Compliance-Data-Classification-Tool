    <rdfs:subClassOf rdf:nodeID="N3258b07c32b5401e9ef0eac4be1670a4"/>
    <rdfs:label>Corporate and Partnership Liability Claims</rdfs:label>
    <skos:definition>Corporate and Partnership Liability Claims refer to legal claims made against corporations or partnerships for their actions or inactions that result in harm or injury to others, including claims related to breach of fiduciary duty, wrongful interference, debt liability, freeze-out of minority shareholders, and piercing the corporate veil.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1840f6934b404f7484df6982f5d1d1a0">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#SuccessorsAndAssigns"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R82DCY9wpy8RlxYrwn0NIya">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9yi9EljTLvrh7N74L460ye"/>
    <rdfs:label>Non-Hearsay Evidentiary Objective</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Non-Hearsay Evidentiary Objective refers to a purpose for admitting an out-of-court statement that is specifically exempted from the hearsay rule due to its inherent reliability or fairness in the context of the adversarial process. These objectives include party admissions, prior statements by witnesses under oath, and prior identifications made by witnesses.</skos:definition>
    <dc:source>Fed. R. Evid. 801(d)</dc:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7081e17eecb54912be1a9d6d8351677a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Amendment"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC6OuguqBnCmspFsAH9y69S">
    <skos:altLabel xml:lang="zh-cn">租金减免条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de reducción de renta</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de reducción de alquiler</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הפחתת שכר דירה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">家賃免除条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Rent Abatement Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Mietminderungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de réduction de loyer</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">किराये में कटौती धारा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de abatimento de aluguel</skos:altLabel>
    <rdfs:label>Rent Abatement Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A rent abatement clause is a provision in a contract that allows for a reduction or suspension of rent payments in the event of certain circumstances, such as property damage or loss of use.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc98b4b8bed1f48fb902bca1f6d7ac10d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#EffectiveDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7aTogftBWxHCdIJBM31Q3X">
    <skos:altLabel xml:lang="fr-fr">Réclamations de responsabilité scolaire</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्कूल दायित्व दावे</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות אחריות בבתי ספר</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandas de responsabilidad escolar</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de responsabilidade escolar</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">学校责任索赔</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">School Liability Claims</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">学校の責任請求</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de responsabilidad escolar</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche wegen Schulhaftung</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>School Liability Claims: Legal claims brought against educational institutions for damages or injuries caused by the institution's negligence or failure to provide a safe environment for students.</skos:definition>
    <rdfs:label>School Liability Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBREngQZS9QIgeWCOMPBLIo"/>
  </rdf:Description>
