  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RjkYsdp52WZkUgu3vsRyRK">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCdJG6uCwl9vj0GwxJe7mez"/>
    <rdfs:label>matter_net_fees</rdfs:label>
    <skos:definition>"Using the Math Statement on the next tab:  
   The total for pre-split non-taxable fee items on the bill  
+ The total for pre-split Tax1 fee items on the bill 
+  ... repeated for each pre-split tax fee items on the bill  
+ The total for post-split non-taxable fee items on the bill 
+ The total for post-split Tax1 fee items on the bill 
+  ... repeated for each post-split tax fee items on the bill 
   tax_total_detail_fees 
"</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
