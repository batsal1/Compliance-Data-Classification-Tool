    <skos:notation>RH-064</skos:notation>
    <skos:prefLabel xml:lang="en">LD Trigger Date Ambiguity</skos:prefLabel>
    <prov:wasDerivedFrom rdf:resource="https://staram.in/ontology/epc/register"/>
    <ns5:classificationMethod xml:lang="en">Category and serial number were taken directly from the source register. Drafting defect type, project phase and impact type were assigned automatically using keyword rules applied to the risk head name and its category.</ns5:classificationMethod>
    <rdfs:label xml:lang="en">LD Trigger Date Ambiguity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCVn9Ew2WyR8O4O5WGDlLKO">
    <skos:altLabel xml:lang="es-es">Tutela</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Tutela</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">监护</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">後見制度</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रतिनिधित्व</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Tutelle</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Guardianship</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Curatela</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אפוטרופוס</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vormundschaft</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Guardianship</rdfs:label>
    <skos:definition>The legal concept of Guardianship refers to the legal authority granted to a person to make decisions on behalf of another individual who is unable to make decisions for themselves due to mental or physical incapacity, with specific application to family law and matrimonial claims.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCUXzL8Z4Ddh2CK6TBhofjU"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ROtFPghetZooCW3zD2jggd">
    <skos:altLabel xml:lang="en-gb">Attorney-Client Corporate Privilege</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privilegio de Confidencialidad Abogado-Cliente Corporativo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio de sigilo advogado-cliente corporativo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège de confidentialité avocat-client en entreprise</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anwalts-Mandanten-Unternehmensprivileg</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות הפרטיות המשפטית של הלקוח והעורך דין החברה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वकील-ग्राहक कॉर्पोरेट विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">律师-客户公司特权</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio de Confidencialidad Abogado-Cliente Corporativo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">弁護士・顧客企業特権</skos:altLabel>
    <skos:definition>The Attorney-Client Corporate Privilege is a legal concept that protects confidential communications between a corporation and its attorneys from being disclosed in court proceedings, as long as the communications were made for the purpose of seeking legal advice.</skos:definition>
    <rdfs:label>Attorney-Client Corporate Privilege</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9BdovRK3PPCHYuYSJXadkJ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#pattern-shared-proportionate">
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#AllocationPatternScheme"/>
    <rdf:type rdf:resource="https://staram.in/ontology/epc#AllocationPattern"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="en">Shared - proportionate to fault</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R3OpMrE5sKOamGoqxb1D0K">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Grande júri</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Grand Jury</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Große Jury</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ग्रैंड जुरी</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">グランドジュリー</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Gran Jurado</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">大陪审团</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Grand jury</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Gran Jurado</skos:altLabel>
    <skos:altLabel xml:lang="he-il">השופט הגדול</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N4d5c5fe4d19a4a5e957a5e42cc5beed8"/>
    <rdfs:subClassOf rdf:nodeID="N2c450d8a40894662a62971b9cccb661c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pwejG33H0Y9mi74WzE2nb"/>
    <skos:definition>A court-impaneled body of jurors that hears and examines evidence concerning alleged criminal offenses and misconduct, examining the validity of those accusations.</skos:definition>
    <rdfs:label>Grand Jury</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBRfTafHhaeRg9Va3VjPQgX">
    <skos:altLabel xml:lang="pt-br">Cláusula de alteração do acordo operacional</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">修改经营协议条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संचालन समझौते क्लॉज के संशोधन</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">事業協定条項の改正</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de enmienda del acuerdo operativo</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תיקון לסעיף הסכם הפעילות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de modification de l'accord d'exploitation</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de enmienda del acuerdo operativo</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Amendment to Operating Agreement Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Änderung der Betriebsvereinbarung</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7UiQA8gafbU8G6XKu27y62"/>
    <skos:definition>An Amendment to Operating Agreement Clause is a provision added to an operating agreement that modifies or alters a previous clause in the agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Amendment to Operating Agreement Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9SqqJ7oW7XF52TFPoEbPbN">
    <skos:altLabel xml:lang="es-es">Discriminación en la vivienda</skos:altLabel>
    <skos:altLabel xml:lang="he-il">Discrimination in Housing</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Discrimination en matière de logement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">住房歧视</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आवास भेदभाव</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wohnungsdiskriminierung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">住宅差別待遇</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Discriminação habitacional</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Discriminación en la vivienda</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Housing Discrimination</skos:altLabel>
    <skos:definition>The unfair treatment of individuals or groups in the housing market based on their race, ethnicity, gender, religion, or other protected characteristics.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
    <rdfs:label>Housing Discrimination</rdfs:label>
  </rdf:Description>
