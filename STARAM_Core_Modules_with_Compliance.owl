  <rdf:Description rdf:about="https://folio.openlegalstandard.org/xMQKjPstSu-pwmHEbJhqkQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/AkoKQRJPSBauQVqI83j4iQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments, known as cafeterias, grill buffets, or buffets, primarily engaged in preparing and serving meals for immediate consumption using cafeteria-style or buffet serving equipment, such as steam tables, refrigerated areas, display grills, and self-service nonalcoholic beverage dispensing equipment. Patrons select from food and drink items on display in a continuous cafeteria line or from buffet stations.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=722514"/>
    <rdfs:label>Cafeterias, Grill Buffets, and Buffets</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3863ecb21e53462e8e7e1260a06e4bac">
