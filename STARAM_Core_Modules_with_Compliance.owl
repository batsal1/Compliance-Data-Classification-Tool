  <rdf:Description rdf:about="https://staram.in/ontology/epc#assessedFromPerspectiveOf">
    <rdfs:label xml:lang="en">assessed from perspective of</rdfs:label>
    <skos:definition xml:lang="en">Whose book the assessment is written in. The same clause is a risk to one party and a protection to the other.</skos:definition>
    <rdfs:range rdf:resource="https://staram.in/ontology/epc#PartyRole"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://staram.in/ontology/epc#RiskAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ro9PP70DaBQ08hhexWCSCG">
    <skos:definition>Legal Verification Management refers to the process of ensuring the accuracy and validity of legal information and documents, typically through the use of technology and specialized software, within the context of Legal Point Solutions.</skos:definition>
    <rdfs:label>Legal Verification Management</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD2xwWqnYhIj0tyrPJrmege"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RJUEBi1isIMI3tc2P5DHvM">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCBPerly9Ql2EqjR3jCfB37"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RPA Management</rdfs:label>
    <skos:definition>RPA Management refers to the process of managing and optimizing Robotic Process Automation (RPA) technology in order to improve legal processes.</skos:definition>
  </rdf:Description>
