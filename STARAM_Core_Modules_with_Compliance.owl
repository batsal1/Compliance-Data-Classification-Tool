  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7oaAQI6I2tIaCnl7vdONZz">
    <skos:altLabel xml:lang="ja-jp">共同事業におけるメンバーの責任</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संयुक्त उद्यम में सदस्य दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad de los miembros en la empresa conjunta</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade dos membros em empreendimento conjunto</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad de los miembros en la empresa conjunta</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Member Liability in Joint Enterprise</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité des membres dans une entreprise commune</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">联合企业中的成员责任</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung der Mitglieder in einer gemeinsamen Unternehmung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות החברים במיזם משותף</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <skos:definition>Member Liability in Joint Enterprise refers to the legal responsibility of individuals who are part of a joint enterprise, such as a partnership or corporation, for any liabilities incurred by the enterprise.</skos:definition>
    <rdfs:label>Member Liability in Joint Enterprise</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/pYi9zljbSU6w62eKekO9CQ">
