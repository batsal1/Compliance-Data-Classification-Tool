    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHSZPHkLvnB6N4bgIo6kuX"/>
    <rdfs:subClassOf rdf:nodeID="N56fff3b2acac42deaa7acaa9a124ed25"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <skos:altLabel xml:lang="es-es">Reclamaciones por competencia desleal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unfair Competition Claims</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות על תחרות לא הוגנת</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Actions en concurrence déloyale</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不正競争請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de concorrência desleal</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandas por competencia desleal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अन्यायपूर्ण प्रतिस्पर्धा दावे</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不正当竞争索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche wegen unlauteren Wettbewerbs</skos:altLabel>
    <skos:definition>Unfair Competition Claims refer to legal actions taken by businesses against competitors who engage in deceptive or unfair practices that harm their business, such as trademark infringement, trade secret misappropriation, or deceptive trade practices.</skos:definition>
    <rdfs:label>Unfair Competition Claims</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/sAT0ZKM4Rfu7nWNnPxRz9w">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9pJlgZDelUlrPrZ9dZ6GM2"/>
    <skos:definition>This industry group comprises establishments primarily engaged in home and garden equipment and appliance repair and maintenance; reupholstery and furniture repair; footwear and leather goods repair; and other personal and household goods repair and maintenance.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Personal and Household Goods Repair and Maintenance</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=8114"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9cc33b292c644582a500d74e5ba8eff5">
