    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Administration of Education Programs</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDsNu801voNxdpEeagwicFR">
    <skos:altLabel xml:lang="en-gb">Limited Guardianship of Adult</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वयस्क की सीमित अभिभावकता</skos:altLabel>
