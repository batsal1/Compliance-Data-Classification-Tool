  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9qYLpjYHVmsbAR3Gr5Pstq">
    <rdfs:label>Right to Nationality</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <skos:definition>The right to nationality is a fundamental human right that ensures individuals have a legal membership in a sovereign state, often signified by citizenship. This right is protected by international treaties like the Universal Declaration of Human Rights and aims to prevent statelessness, which can result in the loss of basic rights and protections.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9JHul9FKmkFasxXopMmrpq">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79LjWBKHCdmQKEW6zPY8Co"/>
