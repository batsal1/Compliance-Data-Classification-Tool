  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDQ4N5uKyIQA6HpY6uoaTyx">
    <skos:altLabel xml:lang="fr-fr">Règle de preuve par témoignage oral</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כלל הראיות הפרוליות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Regla de la evidencia parol</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Regra da prova testemunhal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पैरोल साक्ष्य नियम</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Mündlichkeitsgrundsatz</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Extrinsic Evidence Rule</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Regla de la evidencia parol</skos:altLabel>
    <skos:altLabel>Extrinsic Evidence Rule</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">口証ルール</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">口证规则</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Parol Evidence Rule is a legal defense in civil litigation that prohibits the introduction of oral or written evidence that contradicts the terms of a written contract.</skos:definition>
    <rdfs:label>Parol Evidence Rule</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N55a19dfa3f144da8bc5525b201f1cc3d"/>
