    <skos:altLabel xml:lang="he-il">מורה פרטי</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nachhilfeunterricht</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Tutoría</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Tutoria</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Tutoring</skos:altLabel>
    <skos:definition>Tutoring refers to the provision of educational assistance or instruction by a tutor to a student, as a condition of a criminal disposition imposed on the student's parents.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
