  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCaLazi1IqFwhZAygqTUf0n">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Third-Party Employment Placement</rdfs:label>
    <skos:definition>Third-Party Employment Placement refers to a work arrangement where an employee is hired through an external agency or organization but performs work for a different, client company. In this setup, the agency typically handles administrative tasks like payroll and benefits, while the employee works under the direction of the client company.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDAy5MQTYwrACj2yao4MGbA"/>
  </rdf:Description>
