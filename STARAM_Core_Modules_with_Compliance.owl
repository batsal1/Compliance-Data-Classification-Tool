    <skos:altLabel xml:lang="he-il">סעיף הזכאות להעברה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">有効化条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de enervación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Aproveitamento</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de cesión de derechos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Enurement Clause</skos:altLabel>
    <rdfs:label>Enurement Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Enurement Clause is a provision in a contract that ensures the benefits or obligations of the contract extend to third parties who were not originally parties to the contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ROguS5c2GcVcG9HTujCwzG">
    <skos:altLabel xml:lang="hi-in">बैठक के स्थान पर लिखित सहमति अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Written Consent in Lieu of Meeting Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schriftliche Zustimmung anstelle einer Versammlungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Consentimiento por Escrito en Lugar de Reunión</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">会议决议书书面同意条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכמה בכתב במקום ישיבה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">会議の代わりに書面による同意条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Consentimiento por Escrito en Lugar de Reunión</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de consentement écrit en lieu et place de la réunion</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de consentimento escrito em vez de reunião</skos:altLabel>
    <skos:definition>A Written Consent in Lieu of Meeting Clause is a provision in a contract that allows the parties to give their consent to a decision without holding a formal meeting, as long as the consent is given in writing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Written Consent in Lieu of Meeting Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RpWWO4QoMRyYTyPJNtx0qD">
    <skos:altLabel xml:lang="de-de">Verletzung durch wildes Tier</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lesiones causadas por animales salvajes</skos:altLabel>
