  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8wMxsTdrra0TJaBCyIWcHw">
    <rdfs:subClassOf rdf:nodeID="N7703a552b5824a8199521ae3cd8d392c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVRrqw2QfVD6UcPQLUMxaq"/>
    <skos:altLabel>LPR</skos:altLabel>
    <skos:altLabel>A Lawful Permanent Resident (LPR) is an individual who has been legally granted the right to live and work indefinitely within the destination country (e.g., United States). LPR status provides many of the same benefits as citizenship, such as the ability to work and travel freely, but unlike citizens, LPRs may lose their status under certain conditions like committing serious crimes or abandoning their destination-country residence (e.g., U.S. residence).</skos:altLabel>
    <rdfs:label>Lawful Permanent Resident</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
