    <skos:altLabel xml:lang="fr-fr">Usurpation d'identité / Vol d'identité</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Suplantación de identidad / Robo de identidad</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अभिनय / पहचान चोरी</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Suplantación de identidad / Robo de identidad</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Impersonação / Roubo de identidade</skos:altLabel>
    <skos:altLabel>Theft of Personal Identifying Information</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">冒充 / 身份盗窃</skos:altLabel>
    <skos:definition>Falsely representing one’s identity or position, and acting in the character or position thus unlawfully assumed, to deceive others and thereby gain a profit or advantage, enjoy some right or privilege, or subject another person or entity to an expense, charge, or liability which would not have otherwise been incurred.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
  </rdf:Description>
