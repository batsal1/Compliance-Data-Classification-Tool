  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RkFqkFfrtGlzCVzePQ2QD">
    <skos:altLabel xml:lang="he-il">פעולות אסורות של גבייה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Prácticas de cobro injustas</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अन्यायपूर्ण वसूली व्यवहार</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratiques de recouvrement abusives</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Prácticas de cobranza injustas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unfair Collection Practices</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Práticas de cobrança injustas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不公平的收款行为</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不当な債権回収行為</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unfaire Inkassopraktiken</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KRLFkDC6ycyN3FyXivt7D"/>
    <skos:definition>The concept of "Unfair Collection Practices" refers to any actions taken by debt collectors that are deemed to be abusive, deceptive, or unfair towards consumers, and can result in legal claims against the collectors.</skos:definition>
    <rdfs:label>Unfair Collection Practices</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBnWwBM1j1dxSEB6lEdw0NV">
    <skos:altLabel xml:lang="pt-br">Prática de formação de confiança</skos:altLabel>
    <skos:altLabel>Trust Formation Service</skos:altLabel>
    <skos:altLabel>Trust Formation</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">信托组建实践</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Praxis der Treuhandbildung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מעשה יצירת נאמנות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de formation de fiducie</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ट्रस्ट फॉर्मेशन प्रैक्टिस</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de formación de fideicomisos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trust Formation Practice</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de formación de fideicomisos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">信託形成の実践</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nd6e4004ed03f46269af03f85d7699b0d"/>
    <rdfs:subClassOf rdf:nodeID="N05da06b5840d4ee9acb04d7ed4b93bfc"/>
    <rdfs:subClassOf rdf:nodeID="Nf94d5be0a6b245d69c8c5d32808a093a"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RvpVqC4Gt7SDHOy4JCOKCy"/>
    <rdfs:label>Trust Formation Practice</rdfs:label>
    <skos:definition>Trust Formation (Service) refers to the legal work performed by a Legal Services Provider in creating a trust, which is a legal arrangement where a trustee holds and manages assets for the benefit of a beneficiary.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/DwUn-gI0STmBfN2MQNiAhA">
    <rdfs:label>Automotive Parts and Accessories Retailers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/TocdB2j8RJCD-Zq_nA0hcA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=441330"/>
    <skos:definition>This industry comprises establishments primarily engaged in retailing new, used, and/or rebuilt automotive parts and accessories, with or without repairing automobiles; and/or establishments primarily engaged in retailing and installing automotive accessories.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Used automotive parts retailers</skos:example>
    <skos:example>Automotive parts and supply retailers</skos:example>
    <skos:example>Truck cap retailers</skos:example>
    <skos:example>Automotive stereo retailers</skos:example>
  </rdf:Description>
