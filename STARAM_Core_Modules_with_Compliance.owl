    <skos:altLabel xml:lang="en-gb">Lessor’s Default on Lease of Goods</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Lessor's Default on Lease of Goods refers to the failure of the party who owns the leased property to fulfill their obligations under the lease agreement, resulting in a breach of contract and potential legal action by the lessee.</skos:definition>
    <rdfs:label>Lessor’s Default on Lease of Goods</rdfs:label>
  </rdf:Description>
