    <dc:identifier>AGR-ANAQ</dc:identifier>
    <dc:identifier>IN-INDUSTRY-2.1</dc:identifier>
    <skos:prefLabel>Animal Production and Aquaculture Industry</skos:prefLabel>
  </rdf:Description>
