    <skos:altLabel xml:lang="en-gb">Future Advances Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未来进展条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भविष्य के आगामी विकास की शर्त</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">将来の進歩条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התקדמות עתידיות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'avances futures</skos:altLabel>
    <skos:definition>A Future Advances Clause is a provision in a contract that allows for additional loans or credit to be extended to the borrower in the future, without requiring a new contract or agreement.</skos:definition>
    <rdfs:label>Future Advances Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
