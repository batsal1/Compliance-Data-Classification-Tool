  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RIqmNDUxiSH9LkSnGG7aqh">
    <skos:altLabel>Vice Chairman</skos:altLabel>
    <skos:altLabel>Deputy Chair</skos:altLabel>
    <skos:altLabel>Corporate Vice Chair</skos:altLabel>
    <skos:altLabel>Vice Chairwoman</skos:altLabel>
    <skos:definition>A Board Vice Chair is a board officer who assists the Board Chair in leading the board of directors and may assume the Chair's duties in their absence. The Vice Chair supports board governance, facilitates meetings, and collaborates with other board members to advance the organization’s strategic objectives.</skos:definition>
    <skos:prefLabel>Vice Chair of the Board</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9qtOzWmov77zTz4rUCNAKr"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Board Vice Chair</rdfs:label>
  </rdf:Description>
