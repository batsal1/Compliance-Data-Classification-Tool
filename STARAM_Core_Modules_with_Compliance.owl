  <rdf:Description rdf:about="https://folio.openlegalstandard.org/EFp0vDnXST6WKnWg6qPytA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Steel Investment Foundries</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing steel investment castings. Investment molds are formed by covering a wax shape with a refractory slurry. After the refractory slurry hardens, the wax is melted, leaving a seamless mold. Investment molds provide highly detailed, consistent castings. Establishments in this industry purchase steel made in other establishments.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/5_bs3MXKTrCIt5UR6Gy_VA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=331512"/>
  </rdf:Description>
