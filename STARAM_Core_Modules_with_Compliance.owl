    <rdfs:label xml:lang="en">Shares</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/contracts#Definitions"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nef32c4f3744a4605bf8b1bb044479d42">
