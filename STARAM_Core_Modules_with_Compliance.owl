  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RW6LrybdH8vy8EeskNZC6q">
    <skos:altLabel>Durable AI</skos:altLabel>
    <skos:definition>Robust AI refers to artificial intelligence systems that are both technically and socially resilient, designed to prevent unintentional harm. Technically robust AI systems are built to handle diverse conditions and adversarial attacks, while socially robust AI systems are designed to function ethically within societal contexts, ensuring safety, reliability, and fairness.</skos:definition>
    <skos:prefLabel>Resilient AI</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMmocc9Ine34BK9vSksb0k"/>
    <rdfs:label>Robust AI</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
