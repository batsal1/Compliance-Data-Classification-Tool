    <skos:altLabel xml:lang="es-es">Cláusula de suspensión</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Standstill Provision Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de gel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्टैंडस्टिल प्रावधान शर्त</skos:altLabel>
