    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Public Health Insurance Policy</rdfs:label>
    <skos:definition>Public health insurance is a government-sponsored program designed to provide healthcare coverage to eligible individuals or populations. Examples in the United States include Medicare, for older adults, and Medicaid, for low-income individuals. Coverage and eligibility criteria are determined by the government.</skos:definition>
  </rdf:Description>
