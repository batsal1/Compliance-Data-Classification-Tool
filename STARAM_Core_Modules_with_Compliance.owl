  <rdf:Description rdf:about="https://folio.openlegalstandard.org/rm6Op71TRZKqO_wE7EHJEA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/3ODslBVpSLOOs-nRaxGdhw"/>
    <rdfs:label>Industrial Machinery Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing industrial machinery, such as food and beverage manufacturing machinery, semiconductor manufacturing machinery, sawmill and woodworking machinery (except handheld), machinery for making paper and paper products, printing and binding machinery and equipment, textile making machinery, and machinery for making plastics and rubber products.</skos:definition>
