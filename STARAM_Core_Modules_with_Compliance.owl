    <skos:altLabel xml:lang="es-es">Interferencia con la expectativa testamentaria</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרעה בציפייה צדקנית לצוואה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beeinträchtigung der testamentarischen Erwartung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">干涉遗嘱预期</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interference with Testamentary Expectancy</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência na expectativa testamentária</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Interferencia con la expectativa testamentaria</skos:altLabel>
    <rdfs:label>Interference with Testamentary Expectancy</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nfca748c00cec4a2990611e82aa98b32b"/>
