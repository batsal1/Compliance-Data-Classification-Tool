  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ZYx37m3oxpGunpx48tCOK">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Foreign Influence Claim</skos:altLabel>
    <skos:altLabel>National Security Ownership Claim</skos:altLabel>
    <skos:altLabel>International Control Claim</skos:altLabel>
    <rdfs:label>Foreign Ownership, Control, or Influence Claim</rdfs:label>
    <skos:prefLabel>FOCI Violation Claim</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <skos:definition>A Foreign Ownership, Control, or Influence (FOCI) Claim arises when a company or entity is alleged to be under foreign ownership, control, or influence, potentially compromising national security. This claim involves evaluating the extent of foreign involvement and its impact on the entity's operations, particularly in sectors critical to national security.</skos:definition>
  </rdf:Description>
