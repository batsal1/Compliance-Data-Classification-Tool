  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDosxMJGwf9BqQr182uOWEJ">
    <skos:definition>A product warranty clause is a provision in a contract that outlines the terms and conditions of a manufacturer's promise to repair or replace a product if it fails to meet certain standards or expectations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
    <skos:altLabel xml:lang="en-gb">Product Warranty Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">製品保証条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de garantia do produto</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de garantía del producto</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Produktgarantieklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">产品保修条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אחריות המוצר</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de garantía del producto</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उत्पाद वारंटी शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de garantie de produit</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Product Warranty Clause</rdfs:label>
  </rdf:Description>
