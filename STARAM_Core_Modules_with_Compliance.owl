  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R3uq0eVSfEpZbTNkX6Mzcc">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7kD4ePZmjNDaw2a1pWIDds"/>
    <skos:prefLabel>Win-Win Negotiation</skos:prefLabel>
    <rdfs:label>Collaborative</rdfs:label>
    <skos:altLabel>Cooperative Bargaining</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Collaborative negotiation is a negotiation approach where parties work together cooperatively to find mutually beneficial solutions, emphasizing communication, trust, and problem-solving. This style focuses on creating value and fostering long-term relationships, often characterized by open dialogue and a willingness to understand and accommodate each party's interests.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7cLxNTHXARH6xtJZ2kNYQW">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBwMhlMYnN7SRBNxJwAJ9SF"/>
    <rdfs:comment>a collection where every member is a Role.</rdfs:comment>
    <skos:definition>A collection of roles defined by the Organization for the Advancement of Structured Information Standards (OASIS), which is a subset of a larger collection.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>oasis:role collection</rdfs:label>
  </rdf:Description>
