  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RzbRrublchPvUBEyEBe7IY">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Incumplimiento negligente de una obligación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Performance of An Undertaking</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Execução negligente de um compromisso</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento negligente de una obligación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违约行为的疏忽履行</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Erfüllung einer Verpflichtung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक अनुबंध के अनावश्यक प्रदर्शन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ביצוע של איחוד שגוי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">義務の怠慢な履行</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exécution négligente d'une entreprise</skos:altLabel>
    <skos:definition>The Negligent Performance of An Undertaking refers to a legal claim of negligence where a party fails to fulfill their obligation or duty, resulting in harm or damage to another party.</skos:definition>
    <rdfs:label>Negligent Performance of An Undertaking</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
  </rdf:Description>
