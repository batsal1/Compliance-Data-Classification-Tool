    <skos:altLabel xml:lang="hi-in">दिवालियापन अध्याय 11 दावा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de falência Capítulo 11</skos:altLabel>
    <skos:definition>A Bankruptcy Chapter 11 Claim is a request for payment made by a creditor in a Chapter 11 bankruptcy case, which allows a debtor to reorganize their finances and operations while still operating their business.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7vBjMmDitSBmBKZvNugCLG"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RXLAGe4FhY6gwdxiXOP2TC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Litigation finance management refers to the process of managing the financial aspects of a legal case, including funding, budgeting, and accounting, in order to maximize the potential return on investment for the parties involved.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Nf297b96f5bdc4992a5451b09af3ac697"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
    <rdfs:label>Litigation Finance Management</rdfs:label>
  </rdf:Description>
