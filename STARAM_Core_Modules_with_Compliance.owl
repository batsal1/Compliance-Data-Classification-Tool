  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8XSHg9bgncgnUB5XdahzNP">
    <rdfs:label>Geothermal Rights</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Geothermal rights grant ownership or control over the heat energy stored beneath the earth's surface in a specific area. The holder of these rights can harness this energy for power generation or other purposes and may lease, sell, or transfer these rights to another entity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9jGsr6LEcgGQxDRMlckOMm"/>
  </rdf:Description>
