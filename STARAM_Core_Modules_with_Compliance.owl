    <skos:example>Cooling tower installation</skos:example>
    <skos:example>Mechanical contractors</skos:example>
    <skos:example>Refrigeration system (e.g., commercial, industrial, scientific) installation</skos:example>
    <skos:example>Duct work (e.g., cooling, dust collection, exhaust, heating, ventilation) installation</skos:example>
    <skos:example>Heating, ventilation, and air-conditioning (HVAC) contractors</skos:example>
    <skos:example>Lawn sprinkler system installation</skos:example>
    <skos:example>Furnace installation</skos:example>
    <skos:example>Sewer hookup and connection, building</skos:example>
    <skos:example>Fire sprinkler system installation</skos:example>
