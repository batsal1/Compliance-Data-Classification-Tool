  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RaoUknSK5XanlmEQsAne1v">
    <skos:altLabel xml:lang="en-gb">Definition of Change of Control Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת סעיף שינוי שליטה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition der Klausel zur Änderung der Kontrolle</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de cláusula de cambio de control</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नियंत्रण परिवर्तन शर्त की परिभाषा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Definição da cláusula de mudança de controle</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de cláusula de cambio de control</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">支配変更条項の定義</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de la clause de changement de contrôle</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">控制变更条款定义</skos:altLabel>
    <skos:definition>A Change of Control Clause is a provision in a contract that allows one party to terminate or modify the agreement if the other party undergoes a change in ownership or control.</skos:definition>
    <rdfs:label>Definition of Change of Control Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
