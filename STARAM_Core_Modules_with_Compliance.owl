    <skos:altLabel xml:lang="he-il">חוק שכר ושעות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit du travail et des salaires</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei de Salário e Hora</skos:altLabel>
    <skos:altLabel>Wage and Hour Law</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेतन और घंटे कानून</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Arbeitszeit- und Lohnrecht</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ley de Salarios y Horas</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ley de Salarios y Horas</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃金および労働時間法</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzvtNXIrDJF8xkmOoc6JKH"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>LEMP-WGHR</dc:identifier>
    <dc:identifier>IN-LAW-21.12</dc:identifier>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-LEMP-WGHR</ns2:legacyIdentifier>
    <skos:definition>Law that governs the wages rates an employer can pay its employees, the hours for which an employer must compensate its employees, child labor laws and meal and break laws.</skos:definition>
    <skos:prefLabel>Wage and Hour Law</skos:prefLabel>
  </rdf:Description>
