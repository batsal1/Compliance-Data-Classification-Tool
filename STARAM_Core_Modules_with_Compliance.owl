    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7JKVOM2aFkvG1yiLzF7ndA"/>
    <rdfs:label>Slander</rdfs:label>
    <skos:definition>The spoken or oral communication of false statements that harm the reputation of another person, which can result in legal action against the speaker.</skos:definition>
  </rdf:Description>
