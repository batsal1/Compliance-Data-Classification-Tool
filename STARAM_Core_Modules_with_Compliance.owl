  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8s0yR70Hwjc78Nrk2G4opC">
    <skos:altLabel xml:lang="zh-cn">协助和参与</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Assistance et participation</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unterstützung und Teilnahme</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">支援と参加</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Assisting and Participating</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סיוע והשתתפות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Asistir y Participar</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सहायता और भागीदारी</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Assistência e Participação</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Asistir y Participar</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R5jFFdAx82IJWPe4JDkFqg"/>
    <rdfs:label>Assisting and Participating</rdfs:label>
    <skos:definition>Assisting and Participating refers to the act of aiding or supporting someone in the commission of a crime or other wrongful act, without necessarily being directly involved in the act itself.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBoafnxAMpIdpKNECeolckn">
    <skos:altLabel xml:lang="ja-jp">ビジネス</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Business</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यवसाय</skos:altLabel>
