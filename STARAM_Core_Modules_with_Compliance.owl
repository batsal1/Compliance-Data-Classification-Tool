  <rdf:Description rdf:about="https://folio.openlegalstandard.org/nqbocWLeToqbthMmBWaRcQ">
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing explosives.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=325920"/>
    <rdfs:label>Explosives Manufacturing</rdfs:label>
