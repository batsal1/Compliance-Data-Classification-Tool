  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RxQ9amGYNaNNyjzrOzxcFH">
    <skos:altLabel xml:lang="en-gb">Indecent Exposure</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חשיפה לפני הציבור</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Exibicionismo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">猥亵行为</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Exhibicionismo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">わいせつ行為</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Exhibicionismo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Erregung öffentlichen Ärgernisses</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अश्लील उज्ज्वलता</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exhibitionnisme</skos:altLabel>
    <skos:definition>The act of exposing one's private parts in public or in the presence of others in a lewd or offensive manner, which is considered a criminal offense of a less serious nature.</skos:definition>
