  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rfgtsl3cveBJQwasdTQZTN">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <rdfs:label>Red Light Violation Claim</rdfs:label>
    <skos:definition>A Red Light Violation Claim involves a legal assertion that a driver has failed to comply with a red traffic light regulation, potentially leading to civil or administrative penalties. This claim can be part of broader traffic enforcement actions or disputes, often requiring adjudication or settlement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
