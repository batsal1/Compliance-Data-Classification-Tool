    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Landlord-Tenant Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:nodeID="N615fd8aca3664639b04ed1fba8b350b9"/>
    <skos:definition>Landlord-Tenant Claims refer to legal disputes between a landlord and a tenant, including issues such as failure to return a tenant's security deposit, unlawful eviction, retaliation, and failure to repair or remedy.</skos:definition>
  </rdf:Description>
