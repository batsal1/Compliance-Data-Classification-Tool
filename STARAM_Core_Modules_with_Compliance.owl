    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHZTIZfN6Fbrf6azRExLaD"/>
    <skos:definition>A No-Shop Covenant is a provision in a business deal that restricts one party from seeking other offers or engaging in negotiations with other potential buyers, in order to protect the interests of the other party involved in the deal.</skos:definition>
    <rdfs:label>No-Shop Covenant</rdfs:label>
  </rdf:Description>
