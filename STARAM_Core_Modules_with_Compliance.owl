    <skos:altLabel xml:lang="en-gb">Claim for Falling on Water</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por caída en el agua</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por caída en el agua</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Sturz auf Wasser</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">水中での転倒に対する請求</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour chute sur l'eau</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação por queda na água</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">跌落水中索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על נפילה על מים</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Claim for Falling on Water</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3"/>
    <skos:definition>A claim for falling on water is a legal action brought by a plaintiff who has suffered injury due to slipping and falling on a wet surface, and is based on the legal theory of negligence.</skos:definition>
  </rdf:Description>
