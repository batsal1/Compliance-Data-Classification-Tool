  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDWrlAT5y1sm1PdlKJzlEwj">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A prosecutor is a legal professional responsible for representing the government in criminal cases by presenting evidence, building a case against the defendant, and seeking their conviction. Prosecutors also have a duty to ensure that justice is served and that defendants' rights are upheld throughout the legal process.</skos:definition>
    <skos:prefLabel>District Attorney</skos:prefLabel>
    <rdfs:label>Prosecutor</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N8fc7580e5355494a80f7d2d5e5b14e92"/>
