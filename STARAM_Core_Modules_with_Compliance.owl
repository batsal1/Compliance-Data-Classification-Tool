  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RkZYUUCh1HYX007hux78Rl">
    <skos:altLabel xml:lang="pt-br">Reivindicação de falha em pagar pontualmente</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por falta de pago oportuno</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">支払い遅延請求</skos:altLabel>
    <skos:altLabel>Fail to Pay Timely Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समय पर भुगतान न करने की दावा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未能及时支付索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על כשל בתשלום במועד</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf verspätete Zahlung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de non-paiement en temps voulu</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación por falta de pago oportuno</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fail-to-Pay-Timely Claim</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <skos:definition>A fail-to-pay-timely claim is a legal action initiated by an employee against their employer for not providing timely payment of wages or other compensation. The claim typically arises when an employer does not comply with applicable laws, which require employers to pay employees their earned wages at regular intervals, such as weekly or bi-weekly. The claim can also include allegations of employers not paying earned commissions, bonuses, or other forms of compensation in a timely manner.</skos:definition>
    <rdfs:label>Fail-to-Pay-Timely Claim</rdfs:label>
  </rdf:Description>
