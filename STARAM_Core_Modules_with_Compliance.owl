  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rur2GcVfhwGRdEjyt84rMc">
    <skos:altLabel xml:lang="hi-in">अवैध अधिग्रहण के लिए किरायेदार का बेदखली करना</skos:altLabel>
