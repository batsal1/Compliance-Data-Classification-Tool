    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD22PX6hiObnrRSM3c6bXdR"/>
    <skos:definition>A claim made under the Longshore and Harbor Workers’ Compensation Act (LHWCA), which provides benefits to certain maritime workers who are injured or become ill while working on navigable waters or in adjoining areas used for loading, unloading, repairing, or building a vessel.</skos:definition>
    <rdfs:label>Longshore and Harbor Workers’ Compensation Act Claim</rdfs:label>
  </rdf:Description>
