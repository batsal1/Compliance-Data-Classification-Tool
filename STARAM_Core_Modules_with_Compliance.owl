  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7kodSBxHt8yXxA0EKNJobL">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ksYmaNhrwE6VL9r0qV1sL"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDnJ5pHeJZuA0vHQXYalZO6"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDxvjss5OK7lnAY9w2RaGeB"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9kHJwRBkXjBRaeSNiyPWY"/>
    <skos:definition>The concept of "'Reasonably likely/expected breach' of fiduciary duties" refers to the language used in legal documents to describe a situation where a fiduciary is expected to violate their duties, and the legal standards that apply in such a scenario.</skos:definition>
    <skos:altLabel xml:lang="pt-br">Violação 'razoavelmente provável/prevista' de deveres fiduciários</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובות פידוסיאריות 'בהסתמך על הסתייגות סבירה/צפויה'</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विश्वसनीय दायित्वों के 'योग्यता के आधार पर संभवतः' उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="de-de">„Angemessen wahrscheinlicher/erwarteter Verstoß“ gegen Treuepflichten</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">“合理可能/预期违反”受托责任</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">« Violation raisonnablement probable/attendue » des devoirs fiduciaires</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">'Reasonably likely/expected breach' of fiduciary duties</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento razonablemente probable/esperado de los deberes fiduciarios</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">「合理的に予想される/予想される」受託義務違反</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento razonablemente probable/esperado de los deberes fiduciarios</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>"'Reasonably likely/expected breach' of fiduciary duties" Language</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBoTCgDMLMytE5TAroCxyvX">
    <skos:definition>A contract amendment clause is a provision added to a contract that allows for changes to be made to the original agreement.</skos:definition>
    <skos:altLabel xml:lang="he-il">סעיף שינוי חוזה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Modificación del Contrato</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Contract Amendment Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध संशोधन धारा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同修改条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約変更条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsänderungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de modification de contrat</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de alteração contratual</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Modificación del Contrato</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Contract Amendment Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RIEdvjJfG7brutJLh2eyRw">
    <skos:altLabel xml:lang="es-mx">Cláusula de la Doctrina del Lápiz Azul</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नीले पेंसिल डॉक्ट्रिन क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Blaupausen-Doktrin</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula da doutrina do lápis azul</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Blue Pencil Doctrine Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">蓝铅笔原则条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de la Doctrina del Lápiz Azul</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ブルーペンシル原則条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תיאוריית העפרון הכחול</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de la doctrine du crayon bleu</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Blue Pencil Doctrine Clause</rdfs:label>
    <skos:definition>A Blue Pencil Doctrine Clause is a provision in a contract that allows a court to modify or remove any unenforceable or illegal portions of the contract while leaving the rest of the agreement intact.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8TmxqBbWaNgdm0lJQdY6D4">
    <skos:altLabel xml:lang="pt-br">Reivindicações de pensão e benefícios</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Renten- und Leistungsansprüche</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pension and Benefits Claims</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">养老金和福利索赔</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पेंशन और लाभ दावे</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">年金および給付請求</skos:altLabel>
    <skos:altLabel>Benefits Claims</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות פנסיה וטבעות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de pensiones y beneficios</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations de pensions et d'avantages sociaux</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones de pensiones y prestaciones</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdfs:subClassOf rdf:nodeID="N2c17954d66b24dfaba8391a10afcb6c4"/>
    <rdfs:label>Pension and Benefits Claims</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Pension and benefits claims are legal actions initiated by an employee against their employer for not complying with applicable laws or the terms of an employment agreement regarding retirement and other benefits. These claims can involve issues such as the mismanagement or mishandling of employee pension or retirement accounts, denial or reduction of employee benefits, or failure to provide required benefits such as health insurance or disability coverage. Employees may also bring pension and benefits claims if their employer retaliates against them for asserting their rights to these benefits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#MutualAgreement">
    <skos:exactMatch rdf:resource="https://folio.openlegalstandard.org/RDzPYy9bDUVld7uHMs6YtWx"/>
