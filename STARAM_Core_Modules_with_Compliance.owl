  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RalaaNQ3RajBddzUzN1EsA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGm7jrTspmRi606c5XWZ1z"/>
    <skos:altLabel xml:lang="ja-jp">建築家の過失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वास्तुकार दोष</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאת אדריכל</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência profissional do arquiteto</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia profesional del arquitecto</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Architektenfehler</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle de l'architecte</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia profesional del arquitecto</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">建筑师过失</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Architect Malpractice</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Architect Malpractice refers to a type of malpractice claim that arises from the negligent or wrongful actions of an architect in the design or construction of a building or structure.</skos:definition>
    <rdfs:label>Architect Malpractice</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBFZYGIRpeJOqUKpUaOJXY">
    <skos:altLabel xml:lang="fr-fr">Clause de dispositions supplémentaires</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel für zusätzliche Bestimmungen</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">追加規定条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Disposiciones Adicionales</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अतिरिक्त प्रावधान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de disposições adicionais</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Additional Provisions Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאים נוספים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">附加条款条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Disposiciones Adicionales</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Additional Provisions Clause is a specific clause within a contract that outlines additional terms and conditions beyond those already stated in the contract.</skos:definition>
    <rdfs:label>Additional Provisions Clause</rdfs:label>
  </rdf:Description>
