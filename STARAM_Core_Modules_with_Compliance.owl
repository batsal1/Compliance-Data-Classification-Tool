  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RKXOIeewQztJfJjnEdN8J6">
    <skos:altLabel xml:lang="es-mx">Interferencia Negligente en la Relación Contractual</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过失干涉合同关系</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Interferência negligente em relação contratual</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約関係に対する過失による妨害</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Interference with Contractual Relationship</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Interferencia Negligente con la Relación Contractual</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Störung des Vertragsverhältnisses</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Ingérence négligente dans une relation contractuelle</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">असावधान अनुबंध संबंध में हस्तक्षेप</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התערבות שגויה בקשר חוזי</skos:altLabel>
    <skos:definition>Negligent Interference with Contractual Relationship is a legal claim that arises when a third party's careless actions cause a breach of contract between two parties.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBqyMMilyJsOelem8C8QQRu"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Negligent Interference with Contractual Relationship</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9UVUxFvefgSg70axsgw01S">
    <skos:altLabel xml:lang="zh-cn">铁路运输行业</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria del transporte ferroviario</skos:altLabel>
    <skos:altLabel>Rail Transportation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">鉄道輸送産業</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית התחבורה ברכבת</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie du transport ferroviaire</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Eisenbahnverkehrsbranche</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Rail Transport Industry</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रेल परिवहन उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria del transporte ferroviario</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de transporte ferroviário</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <dc:identifier>IN-INDUSTRY-18.5</dc:identifier>
    <dc:identifier>TRA-RAIL</dc:identifier>
    <skos:prefLabel>Rail Transportation Industry</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Industries in this group provide rail transportation of passengers and/or cargo using railroad rolling stock. The railroads in this subsector primarily either operate on networks, with physical facilities, labor force, and equipment spread over an extensive geographic area, or operate over a short distance on a local rail line.</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-TRA-RAIL</ns2:legacyIdentifier>
    <rdfs:label>Rail Transportation Industry</rdfs:label>
    <skos:hiddenLabel>RAIL</skos:hiddenLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RUE4fCCSnGX1wIK324EyiL"/>
  </rdf:Description>
