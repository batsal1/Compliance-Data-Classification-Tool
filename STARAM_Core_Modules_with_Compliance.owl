    <skos:definition>This industry comprises establishments primarily engaged in manufacturing sporting and athletic goods (except apparel and footwear).</skos:definition>
    <rdfs:label>Sporting and Athletic Goods Manufacturing</rdfs:label>
  </rdf:Description>
