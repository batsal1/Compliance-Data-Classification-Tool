  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCUtNAEY6SLedQqmx0HbAvy">
    <skos:altLabel>Maturity-Dated Asset</skos:altLabel>
    <skos:altLabel>Maturity-Certain Asset</skos:altLabel>
    <skos:altLabel>Term-Specified Asset</skos:altLabel>
    <skos:altLabel>Fixed-Term Instrument</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NbRiaFKuXbP6fYk436pb2"/>
    <rdfs:label>Fixed Maturity Asset</rdfs:label>
    <skos:prefLabel>Fixed-Term Asset</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Fixed Maturity Asset is a financial instrument where the principal amount is repaid in full at a specified maturity date. This type of asset provides a predictable repayment schedule, offering investors assurance of receiving their principal investment at the end of the term.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCmAarh6Wj8m6lLe6lJJBmj">
    <skos:altLabel xml:lang="zh-cn">家庭和医疗假法索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על פי חוק החופשה המשפחתית והרפואית</skos:altLabel>
    <skos:altLabel>FMLA Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Ley de Licencia Familiar y Médica</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">परिवार और चिकित्सा अवकाश अधिनियम दावा</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Ley de Ausencia Familiar y Médica</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation au titre de la loi sur le congé familial et médical</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Family and Medical Leave Act Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Licença Familiar e Médica</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">家族・医療休暇法請求</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch nach dem Gesetz über Familien- und Krankenpflegezeit</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:subClassOf rdf:nodeID="Na198032143c04d529a7c34844dc6a734"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <rdfs:subClassOf rdf:nodeID="N62a9ea28c70449d68cbf995e429e6e3c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCty0MaQzrLC9KnzjM7nMER"/>
    <rdfs:subClassOf rdf:nodeID="Nd7386a73b4de45e4ab6081514b55aaaa"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Family and Medical Leave Act Claim</rdfs:label>
    <skos:definition>A Family and Medical Leave Act (FMLA) Claim is a legal claim made by an employee against their employer for violating their rights under the FMLA, which provides eligible employees with up to 12 weeks of unpaid leave per year for certain family and medical reasons.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/JR-Scke0SMqJhTkv2_TqSQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/axnr3Y-hTQuJMpwsLYTKAQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=31141"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing frozen fruit, frozen juices, frozen vegetables, and frozen specialty foods (except seafood), such as frozen dinners, entrees, and side dishes; frozen pizza; frozen whipped toppings; and frozen waffles, pancakes, and French toast.</skos:definition>
    <rdfs:label>Frozen Food Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R83buoZjuTTqc9djnsDxCz2">
    <skos:definition>Personal Jurisdiction by Fairness refers to the authority of a court to hear a case based on the fairness of doing so, even if the defendant does not have sufficient minimum contacts with the forum state.</skos:definition>
    <skos:altLabel xml:lang="es-es">Jurisdicción personal por equidad</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Personal Jurisdiction by Fairness</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायमित्त व्यक्तिगत अधिकरण</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Jurisdição pessoal por equidade</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Persönliche Zuständigkeit durch Angemessenheit</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שיפוט אישי על פי הוגנות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción personal por equidad</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公正による個人管轄権</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公平个人管辖权</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Juridiction personnelle par équité</skos:altLabel>
    <rdfs:label>Personal Jurisdiction by Fairness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7X4vuBVsbGf69DAu7Xotdw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
