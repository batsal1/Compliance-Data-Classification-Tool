  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDgbjRGvnprxnFm9CAqCjYs">
    <rdfs:label>Curfew, Loitering, and Vagrancy Violations</rdfs:label>
    <skos:altLabel xml:lang="hi-in">कर्फ्यू, घूमना-फिरना और बेघरी उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violations de couvre-feu, d'errance et de vagabondage</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרות צווארון לילה, תגרות ובזבזות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Curfew, Loitering, and Vagrancy Violations</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Violaciones de toque de queda, vagancia y merodeo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">外出禁止令、徘徊および浮浪行為の違反</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ausgangssperre, Herumlungern und Vagabundieren Verstöße</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">宵禁、徘徊和流浪违规行为</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Violaciones de toque de queda, vagancia y merodeo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violações de toque de recolher, vadiagem e mendicância</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLvhxz3b1k2IU3MaAgeRtF"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The violation of a court order, regulation, ordinance, or law requiring the withdrawal of persons from the streets or other specified areas; prohibiting persons from remaining in an area or place in an idle or aimless manner; or prohibiting persons from going from place to place without visible means of support.</skos:definition>
  </rdf:Description>
