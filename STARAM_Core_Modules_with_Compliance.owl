    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
    <rdfs:label>Presumption of Undue Hardship</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A legal assumption that a debtor cannot repay their debts without experiencing significant hardship, which may be used as a defense in bankruptcy proceedings.</skos:definition>
  </rdf:Description>
