  <rdf:Description rdf:about="https://staram.in/ontology/legislation#DefinedTerm">
    <rdfs:comment xml:lang="en">A concept that a provision expressly defines, typically via a '"X" means ...' construction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://staram.in/ontology/legislation#OASISLegislationStructureModule"/>
