    <skos:altLabel xml:lang="de-de">Alkohol an Minderjährige abgeben</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Proporcionar Alcohol a Menores</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fournir de l'alcool à un mineur</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDJwYAhLKCUFLjsFuACCRPB"/>
