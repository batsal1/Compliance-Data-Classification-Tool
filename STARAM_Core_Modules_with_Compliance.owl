  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCZWLI44IaT2FdTm22w3SiK">
    <rdfs:label>Density Credit Transactions</rdfs:label>
    <skos:definition>Density Credit Transactions refer to the buying, selling, or transferring of development rights, allowing property owners to adjust the allowable density of development on their land. These transactions are typically facilitated through legal agreements and are overseen by regulatory agencies to ensure compliance with land use and zoning laws.</skos:definition>
    <skos:altLabel>Zoning Credit Transactions</skos:altLabel>
    <skos:altLabel>Development Right Exchanges</skos:altLabel>
    <skos:altLabel>Density Bonus Trading</skos:altLabel>
    <skos:altLabel>TDR</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxq2qQYpdo9stHOBIQhub7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Transfer of Development Rights</skos:prefLabel>
  </rdf:Description>
