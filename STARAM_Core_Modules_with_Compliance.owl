  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7mVtx371wZ4xXfqQEtgcAA">
    <skos:altLabel xml:lang="zh-cn">保险理算师</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ajustador de seguros</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versicherungsjustierer</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Perito de seguros</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保険調整者</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Expert en assurance</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insurance Assessor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מכוון ביטוחים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बीमा समायोजक</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ajustador de seguros</skos:altLabel>
    <rdfs:label>Insurance Adjuster</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBl2WJxJ69U7TybdQRUInbs"/>
    <skos:definition>An insurance adjuster is a professional who works for an insurance company and investigates and evaluates insurance claims made by policyholders.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/cHSMkP4uSyGYRwJhD2jULQ">
