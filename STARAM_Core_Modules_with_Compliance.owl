  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCSnNFWDmB5Nh62H5KZJRf8">
    <skos:altLabel xml:lang="es-es">Cláusula de no contratación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-embauche</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">採用禁止条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Nicht-Einstellung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不雇用条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de no contratación</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नो हायर क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Hire Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסעיף לא להעסיק</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de não contratação</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A "No Hire Clause" is a provision in a contract that prohibits one party from hiring or soliciting the employees of the other party.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>No Hire Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCVPI1urZIhFYA7MHoDPZ8a">
    <skos:altLabel xml:lang="fr-fr">Réclamations liées à l'amiante</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">アスベスト請求</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de amianto</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">石棉索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandas de asbesto</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एस्बेस्टस दावे</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות אסבסטוס</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Asbestklagen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações de amianto</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Asbestos Claims</skos:altLabel>
    <skos:definition>Asbestos Claims refer to legal claims made by individuals who have suffered harm due to exposure to asbestos, seeking compensation for damages such as medical expenses, lost wages, and pain and suffering.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RYS2M2cunzcjtIHPdPzmUy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Asbestos Exposure Claims</skos:prefLabel>
    <rdfs:label>Asbestos Claims</rdfs:label>
  </rdf:Description>
