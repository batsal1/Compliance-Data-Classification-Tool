  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7JNvoooIaePAkBMY2R9m8l">
    <skos:inScheme>UK</skos:inScheme>
    <skos:altLabel xml:lang="es-es">Inmunidad cualificada</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">imunidade qualificada</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Qualified Immunity</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">योग्यता प्रतिरक्षा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合格豁免</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חסינות מוגבלת</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Crown Immunity</skos:altLabel>
    <skos:altLabel xml:lang="de-de">qualifizierte Immunität</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">immunité qualifiée</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Inmunidad calificada</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">限定的免責</skos:altLabel>
    <skos:definition>Qualified Immunity: A legal doctrine that shields government officials from liability for civil damages in cases where their actions did not violate clearly established statutory or constitutional rights of which a reasonable person would have known.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Qualified Immunity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvhPeoPwTNYsc19VBpYjSV"/>
  </rdf:Description>
