    <rdfs:label xml:lang="en">violation of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/f7F4_FZxRWugcKbor76j2Q">
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) spinning yarn; (2) manufacturing thread of any fiber; (3) texturizing, throwing, twisting, and winding purchased yarn or manmade fibers and filaments; and (4) producing hemp yarn and further processing into rope or bags.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=313110"/>
    <rdfs:label>Fiber, Yarn, and Thread Mills</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/TpUCSATGTp6qfgMpsOT7Gg"/>
  </rdf:Description>
