  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDvVBJAIjWJ6V7k3Hor0WSN">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Public Civil Law Office</skos:altLabel>
    <skos:altLabel>Civil Legal Affairs Division</skos:altLabel>
    <skos:altLabel>Government Civil Legal Department</skos:altLabel>
    <rdfs:label>Governmental Civil Law Division</rdfs:label>
    <skos:example>Federal Civil Litigation Unit</skos:example>
    <skos:example>Civil Litigation Unit</skos:example>
    <skos:example>City Civil Law Division</skos:example>
    <skos:example>County Civil Law Office</skos:example>
    <skos:example>State Civil Law Division</skos:example>
    <skos:definition>A Governmental Civil Law Division is a governmental entity that handles civil legal matters involving the government. It provides legal advice to government agencies, represents the government in civil litigation, and ensures compliance with civil laws and regulations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBt449Gy4YQBuVqNLxE7Gg"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N01b23498dadd42599f185b48a2348209">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R8eYplvX9rGzbrcplLZFdlw"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCx9GuPni9uwMsDX2m5EXxB">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Negligent Operation of Activity Requiring Franchise or License</rdfs:label>
    <skos:altLabel xml:lang="hi-in">फ्रैंचाइज़ या लाइसेंस की आवश्यकता वाली गतिविधि के लिए लापरवाह ऑपरेशन</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässiger Betrieb einer Tätigkeit, die eine Franchise oder Lizenz erfordert</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Operation of Activity Requiring Franchise or License</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעולה שלא יסודית של פעילות הדורשת רישיון או רישיון ייצור</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exploitation négligente d'une activité nécessitant une franchise ou une licence</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">需要特许经营或许可证的活动的疏忽操作</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">フランチャイズまたはライセンスを必要とする活動の過失操作</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Operação negligente de atividade que requer franquia ou licença</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Operación negligente de actividad que requiere franquicia o licencia</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Operación negligente de actividad que requiere franquicia o licencia</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
    <skos:definition>Negligent Operation of Activity Requiring Franchise or License refers to a legal claim for damages resulting from the careless or reckless operation of a business or activity that requires a franchise or license to operate, such as a taxi service or a liquor store.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7ahfB1BbtNvve47RAqswqA">
    <skos:altLabel xml:lang="hi-in">काली सूची दावा</skos:altLabel>
