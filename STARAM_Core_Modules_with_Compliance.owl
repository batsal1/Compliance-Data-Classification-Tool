    <skos:altLabel xml:lang="de-de">Anspruch nach dem False Claims Act</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da Lei de Reivindicações Falsas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">False Claims Act Claim</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBhkx3dQ6MLH4RmvBj4nBaz"/>
    <rdfs:subClassOf rdf:nodeID="Na86108c2b9f24799a5dd038bcb5afbc9"/>
    <skos:definition>A False Claims Act Claim is a legal claim made by a whistleblower alleging that a person or entity has submitted false or fraudulent claims for payment to the government, in violation of the False Claims Act.</skos:definition>
    <rdfs:label>False Claims Act Claim</rdfs:label>
  </rdf:Description>
