    <skos:altLabel>ESOP Document</skos:altLabel>
    <skos:prefLabel>Employee Share Ownership Plan Document</skos:prefLabel>
    <skos:definition>An Employee Stock Ownership Plan (ESOP) document is a formal written plan that outlines the terms, conditions, and procedures for establishing and operating an Employee Stock Ownership Plan. This document details the rules governing employee eligibility, stock allocation, vesting schedules, and the plan’s administration to ensure compliance with legal requirements.</skos:definition>
    <ns1:contractFamily xml:lang="en">Employment &amp; Labour</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Employee Stock Ownership Plan</rdfs:label>
  </rdf:Description>
