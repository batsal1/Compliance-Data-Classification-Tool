    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-es">Acuerdo de depósito en garantía</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Treuhandschaftsvereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एस्क्रो समझौता</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Escrow Agreement</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de dépôt</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">托管协议</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Contrato de depósito en garantía</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">エスクロー契約</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Contrato de depósito</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם אסקרו</skos:altLabel>
    <skos:definition>An Escrow Agreement is a legal contract between two parties where a third party holds and manages assets or funds until the conditions of the agreement are met.</skos:definition>
    <rdfs:label>Escrow Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Escrow, Trust &amp; Fiduciary</ns1:contractFamily>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/S9FlAMSDQrmcMUbQ-uR6EQ">
    <skos:definition>This industry comprises establishments primarily engaged in the preservation and exhibition of sites, buildings, forts, or communities that describe events or persons of particular historical interest. Archeological sites, battlefields, historical ships, and pioneer villages are included in this industry.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=712120"/>
    <rdfs:label>Historical Sites</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Xr8BtaXOTEyuA-PUSb7SvA"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RsZxhuNFK33sHecLQ7WJdp">
    <skos:altLabel>Employer</skos:altLabel>
