  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9RShJ920RqbSd7rDVrV7z5">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8A2f18n9G7OkKnD3C0K5O"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Limited Voting Share</skos:altLabel>
    <skos:altLabel>Partial Voting Right</skos:altLabel>
    <skos:altLabel>Reduced Voting Equity</skos:altLabel>
    <skos:definition>An Asset Restricted Voting Right refers to a limited voting entitlement associated with certain classes of shares, where the shareholder may possess fewer voting rights compared to standard voting shares, often less than one vote per share. This attribute allows for differentiated control mechanisms within a company's equity structure, balancing economic interest with limited decision-making power.</skos:definition>
    <rdfs:label>Asset Restricted Voting Right</rdfs:label>
    <skos:prefLabel>Restricted Voting Share</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na64a49f849e247afa36bd11bbad88919">
