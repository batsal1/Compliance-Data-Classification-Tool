    <skos:definition>"NOS" = Not Otherwise Specified (catch-all, includes the subcategories) Primarily hourly charges.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>L610 Preservation (NOS)</rdfs:label>
  </rdf:Description>
