    <skos:altLabel xml:lang="es-mx">Vagancia</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זיהום</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Vagabundeo</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Loitering</skos:altLabel>
    <skos:definition>The act of remaining in a public place for an extended period of time without a clear purpose or legitimate reason, often in violation of local laws or ordinances related to curfew, loitering, or vagrancy.</skos:definition>
    <rdfs:label>Loitering</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
