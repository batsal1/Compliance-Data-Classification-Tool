  <rdf:Description rdf:about="https://folio.openlegalstandard.org/o5nSWsYZT9iKcGHLWFOK4g">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333921"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/HNVzadjSQGur0qgpX0Smbw"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing elevators and moving stairways.</skos:definition>
    <skos:example>Moving walkways manufacturing</skos:example>
    <skos:example>Escalators manufacturing</skos:example>
    <skos:example>Automobile lifts (i.e., garage-type, service station) manufacturing</skos:example>
    <skos:example>Passenger and freight elevators manufacturing</skos:example>
    <rdfs:label>Elevator and Moving Stairway Manufacturing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RqpMXzmXRzOi5szkC4bwcA">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=488999"/>
    <skos:definition>Illustrative Examples:</skos:definition>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing support activities to transportation (except for air transportation; rail transportation; water transportation; road transportation; freight transportation arrangement; and packing and crating).</skos:definition>
    <skos:definition>Stockyards (i.e., not for fattening or selling livestock)</skos:definition>
    <skos:definition>Independent pipeline terminal facilities</skos:definition>
    <skos:definition>Arrangement of vanpools or car pools (except ridesharing arrangement services)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>All Other Support Activities for Transportation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/49W_Qx6KT8OCUdWJDhzZmg"/>
  </rdf:Description>
