  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R715Jnq0KgwityC5K5W6Yvs">
    <skos:altLabel>CTA</skos:altLabel>
    <skos:altLabel>Commodity Futures Advisor</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBEfQXg8uUIsk2iZbk8Z2gR"/>
    <rdfs:label>Commodity Trading Advisor</rdfs:label>
    <skos:prefLabel>Commodity Investment Advisor</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Commodity Trading Advisor (CTA) is an individual or firm that provides advice on trading commodity futures, options on futures, and retail off-exchange forex contracts. CTAs are registered with the Commodity Futures Trading Commission (CFTC) and typically manage client assets on a discretionary basis.</skos:definition>
  </rdf:Description>
