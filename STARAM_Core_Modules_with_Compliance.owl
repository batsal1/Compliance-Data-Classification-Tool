    <skos:altLabel xml:lang="pt-br">Delegado dos Estados Unidos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">US Marshal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Marshal américain</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Marechal de los Estados Unidos</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Marechal de los Estados Unidos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מרשל ארצות הברית</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">美国元帅</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">यूएस मार्शल</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">アメリカ合衆国保安官</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RILQypXcjvqd1GxNIcqsb7"/>
    <skos:definition>An officer of the United States Marshals Service (USMS), which is a federal law enforcement agency that is a bureau within the U.S. Department of Justice.</skos:definition>
    <rdfs:label>U.S. Marshal</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R76ZXX5F2U3ZNFiP1HqoAae">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7mMPoEuA9Ja4rODr1LGXcR"/>
    <rdfs:label>Compilation</rdfs:label>
    <skos:definition>Compilation in copyright law is a work formed by assembling, selecting, or organizing pre-existing material or data, creating a unique intellectual creation through this process. It requires that the compilation's arrangement or selection of contents be original, even if the individual elements are not.</skos:definition>
  </rdf:Description>
