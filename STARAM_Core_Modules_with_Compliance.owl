  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8nKj8jCoF7tXLyAvph4qQI">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5GqV01EclTMMUtFKVLSZD"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>AI Accuracy is a metric within AI measurement that quantifies an AI system's proportion of correct (intended) predictions, compared to the total number of predictions. It serves as an indicator of how well an AI system performs in making accurate predictions, based on Ground Truth, encompassing both precision and recall, providing a comprehensive assessment of model performance.</skos:definition>
    <rdfs:label>AI Accuracy</rdfs:label>
  </rdf:Description>
