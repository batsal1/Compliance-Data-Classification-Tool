  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5b49iXhdLOBaTOqsjQBtQ">
    <skos:definition>Open-End Assets refer to investment funds that continually offer new units to the public and redeem outstanding units on demand. This mechanism results in the constant adjustment of the fund's outstanding capital, increasing or decreasing as investors buy or redeem units.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDWDi7o4XYIl6YajH1XLGU1"/>
    <skos:altLabel>Continuously Offered Funds</skos:altLabel>
    <rdfs:label>Open-End Assets</rdfs:label>
    <skos:prefLabel>Open-End Funds</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB8v1h0OiUgX3iXn0LXUg7g">
    <skos:altLabel xml:lang="es-mx">Cláusula de Carta de Indemnización</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">免責事項書状条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">赔偿保证书条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de lettre d'indemnité</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Letter of Indemnity Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Carta de Indemnización</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Haftungsfreistellungserklärung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इंडेम्निटी पत्र शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Carta de Indenização</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מכתב התחייבות פיצוי</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Letter of Indemnity Clause is a provision in a contract that obligates one party to compensate the other party for any losses or damages that may arise from a specified event or circumstance.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Letter of Indemnity Clause</rdfs:label>
  </rdf:Description>
