    <skos:altLabel xml:lang="es-es">Análisis del financiamiento DIP</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">DIPファイナンスの分析</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">DIP融资分析</skos:altLabel>
