    <skos:altLabel xml:lang="zh-cn">缩短的寿命期限</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Expectativa de vida reducida</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कम हो गई जीवनकाल की अपेक्षा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">expectativa de vida reduzida</skos:altLabel>
    <skos:altLabel xml:lang="he-il">צפייה בקצב חיים מופחתת</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reduced Life Expectancy</skos:altLabel>
