  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCu7hQ9r1Giq9eP0uyDNU58">
    <skos:altLabel xml:lang="zh-cn">试用期条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Probationary Period Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de período de experiência</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תקופת ניסיון</skos:altLabel>
