  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7N3mHbDxpMp8lgod0TKYT6">
    <rdfs:label>Diversity and Inclusion Management</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROb7P1zmS9dqMfXoFzhfu6"/>
    <skos:definition>Diversity and Inclusion Management refers to the practice of promoting and maintaining a workplace culture that values and respects differences among employees, including but not limited to race, gender, age, religion, and sexual orientation, with the goal of creating a more inclusive and equitable environment.</skos:definition>
  </rdf:Description>
