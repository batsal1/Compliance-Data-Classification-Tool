  <rdf:Description rdf:about="https://folio.openlegalstandard.org/I0xM16oaTRGcgM9qfBZkvg">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=112910"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/nSv2xP7YS9qZV7SMY7Aknw"/>
    <rdfs:label>Apiculture</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in raising bees. These establishments may collect and gather honey; and/or sell queen bees, packages of bees, royal jelly, bees' wax, propolis, venom, pollen, and/or other bee products.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/KIh4E8dIRyiNW6yu3u-BGg">
    <skos:example>Hot air balloon rides, scenic and sightseeing operation</skos:example>
    <skos:example>Glider excursions</skos:example>
    <skos:example>Aerial cable cars, scenic and sightseeing operation</skos:example>
    <skos:example>Aerial tramways, scenic and sightseeing operation</skos:example>
    <skos:example>Helicopter rides, scenic and sightseeing operation</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=487990"/>
    <rdfs:label>Scenic and Sightseeing Transportation, Other</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/BNcI1tXfSEWkaXq9DBwMEA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing scenic and sightseeing transportation (except on land and water). The services provided are usually local and involve same-day return to place of departure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N02882ba1e27e4a3c9d754b67ea40ffba">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R89e7t0wDXgx7mBu9rn271g"/>
