    <skos:altLabel xml:lang="es-mx">Novación</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Novação</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Novation</skos:altLabel>
    <skos:definition>The concept of Novation refers to the substitution of a new contract or obligation for an existing one, with the mutual agreement of all parties involved, resulting in the discharge of the original obligation.</skos:definition>
    <ns1:contractFamily xml:lang="en">General Commercial</ns1:contractFamily>
  </rdf:Description>
