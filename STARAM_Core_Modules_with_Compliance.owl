    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mistake in Contract</rdfs:label>
    <skos:definition>A Mistake in Contract is a legal claim that arises when one or both parties to a contract make an error in the terms of the agreement, which can render the contract void or unenforceable.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/U3L3UG1LQhe2QTqofGAing">
    <skos:example>Fabricating metal cabinets or countertops on site</skos:example>
    <skos:example>Trade show exhibit installation and dismantling</skos:example>
    <skos:example>Countertop and cabinet, metal (except residential-type), installation</skos:example>
    <skos:example>Modular furniture system attachment and installation</skos:example>
    <skos:example>Concrete coating, glazing, or sealing</skos:example>
    <skos:example>Window shade and blind installation</skos:example>
    <skos:example>Waterproofing contractors</skos:example>
    <skos:example>Closet organizer system installation</skos:example>
    <skos:example>Drapery fixture (e.g., hardware, rods, tracks) installation</skos:example>
    <skos:example>Bathtub refinishing, on-site</skos:example>
    <rdfs:label>Other Building Finishing Contractors</rdfs:label>
