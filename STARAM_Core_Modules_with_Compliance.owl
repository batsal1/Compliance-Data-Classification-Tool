  <rdf:Description rdf:about="https://folio.openlegalstandard.org/LtY7HBv9RA6TXuFqHfvcXQ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Offices of Real Estate Agents and Brokers</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in acting as agents and/or brokers in one or more of the following: (1) selling real estate for others; (2) buying real estate for others; and (3) renting real estate for others.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=531210"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/XmPUH9fPRNCfOEtgdcKZxQ"/>
  </rdf:Description>
