  <rdf:Description rdf:about="https://folio.openlegalstandard.org/_Xh4w_XyQVSUrqC7JJ2SpA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Jm44LczZQeaLf-mLXYn4WA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=72119"/>
    <skos:example>Tourist homes</skos:example>
    <skos:example>Housekeeping cabins and cottages</skos:example>
    <skos:example>Guest houses</skos:example>
    <skos:example>Bed-and-breakfast inns</skos:example>
    <skos:example>Hostels</skos:example>
    <rdfs:label>Other Traveler Accommodation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing short-term lodging (except hotels, motels, and casino hotels).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RqBMS8HFJwbfAcW0aEKhyF">
    <skos:altLabel xml:lang="en-gb">Due Diligence Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Diligencia Debida</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף דיליגנטיות נדרשת</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de diligence raisonnable</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">देय दिलिजेंस क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">尽职调查条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">デューデリジェンス条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sorgfaltspflichtklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Debida Diligencia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de diligência prévia</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Due Diligence Clause</rdfs:label>
    <skos:definition>A Due Diligence Clause is a provision in a contract that requires a party to exercise a certain level of care and investigation before entering into the agreement, often including a period of time for the investigation to take place.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
