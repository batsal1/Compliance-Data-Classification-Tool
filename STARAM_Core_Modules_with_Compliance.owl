    <skos:example>Medical forensic laboratories</skos:example>
    <rdfs:label>Medical and Diagnostic Laboratories</rdfs:label>
    <skos:definition>This industry comprises establishments known as medical and diagnostic laboratories primarily engaged in providing analytic or diagnostic services, including body fluid analysis and diagnostic imaging, generally to the medical profession or to the patient on referral from a health practitioner.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/syuF1w1uR1aHhkphWaPcbg"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=62151"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
