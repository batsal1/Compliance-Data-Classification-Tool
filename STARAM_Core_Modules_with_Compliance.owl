  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBHcgWfomutlulDfZaPGKsI">
    <rdfs:label>Bearer Securities</rdfs:label>
    <skos:altLabel>Bearer Instruments</skos:altLabel>
    <skos:altLabel>Anonymous Securities</skos:altLabel>
    <skos:altLabel>Bearer Financial Instruments</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCa0GJrngclDdSJ8dRAueqB"/>
    <rdfs:subClassOf rdf:nodeID="Nf19a2f0518dd4a62abdeacf84272ba25"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Bearer Securities are financial instruments where the owner's identity is not recorded on the books of the issuer or the registrar. These securities can be transferred by mere possession, making them highly negotiable and anonymous.</skos:definition>
    <skos:prefLabel>Unregistered Securities</skos:prefLabel>
  </rdf:Description>
