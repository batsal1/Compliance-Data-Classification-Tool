    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A specialized area of legal practice that involves conducting due diligence investigations and preparing disclosure schedules in the context of mergers and acquisitions.</skos:definition>
    <rdfs:label>M&amp;A C Due Diligence and Disclosure Schedules Practice</rdfs:label>
  </rdf:Description>
