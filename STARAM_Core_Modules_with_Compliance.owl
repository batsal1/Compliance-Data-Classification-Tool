    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ROn8Ax97B0Gx5rgsNR76C4"/>
    <skos:definition>Subpoena fees are expenses incurred in the process of serving a subpoena.</skos:definition>
    <rdfs:label>E113 Subpoena fees</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RcPCCRQUx0nlNBGvI8Keh0">
    <rdfs:label>Obviousness</rdfs:label>
    <skos:definition>Obviousness in legal terms refers to the lack of novelty and inventiveness in an invention, making it ineligible for a patent. An invention is considered obvious if a person with ordinary skill in the field would find the invention predictable based on prior art.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV2029Q3Zi4LQ1ehMJNj3w"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
