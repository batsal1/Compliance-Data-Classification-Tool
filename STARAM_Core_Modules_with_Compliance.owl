    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The finding has no adequate archetype in the register. Query these to grow the register from real contracts.</skos:definition>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#CoverageScheme"/>
    <skos:prefLabel xml:lang="en">Not covered - candidate new head</skos:prefLabel>
