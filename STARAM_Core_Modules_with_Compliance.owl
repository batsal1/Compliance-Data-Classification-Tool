    <skos:altLabel xml:lang="ja-jp">個人財産法</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">个人财产法</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho de Propiedad Personal</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sachenrecht</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit des biens personnels</skos:altLabel>
