  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB2DWo5KfwBtpy15ZHG5fmJ">
    <skos:definition>The INVOICE_REPORTED_TAX_TOTAL is a specific element within the LEDES98BI V5 Format Rev 1-2020 standard for electronic legal invoicing, which represents the total amount of taxes reported on the invoice.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
    <rdfs:label>INVOICE_REPORTED_TAX_TOTAL</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R3TZludg4KJtTjPW1T2J9c">
    <rdfs:label>Visa Waived</rdfs:label>
    <skos:altLabel>Visa Waiver</skos:altLabel>
    <skos:altLabel>VWP</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
    <skos:definition>The Visa Waiver Program (VWP) allows citizens of participating countries to travel to the destination country for tourism or business purposes without obtaining a visa. In the United States, travel under the VWP is permitted for up to 90 days and does not allow for a change of status or an extension of stay</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
