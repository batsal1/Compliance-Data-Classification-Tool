  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R93RTHT7RIhwzcK2cDgMrhV">
    <skos:altLabel xml:lang="ja-jp">企業ポリシー順守条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de conformité aux politiques de l'entreprise</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de cumplimiento de políticas de la empresa</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de cumplimiento de políticas de la empresa</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Compliance with Company Policies Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">遵守公司政策条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कंपनी नीतियों के अनुपालन अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de conformidade com as políticas da empresa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף עמיתות עם מדיניות החברה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Einhaltung der Unternehmensrichtlinien</skos:altLabel>
    <skos:definition>A Compliance with Company Policies Clause is a provision in a contract that requires one or both parties to adhere to the policies and regulations of the company involved.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Compliance with Company Policies Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7DodCQoDjgNTWmFlkofNo">
    <rdfs:label>AI System</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An AI system is a machine-based system that, for explicit or implicit objectives, infers how to generate outputs such as predictions, content, recommendations, or decisions from the input it receives. These outputs can influence physical or virtual environments, and AI systems vary in their levels of autonomy and adaptiveness after deployment.</skos:definition>
    <skos:altLabel>Intelligent Automation Systems</skos:altLabel>
    <skos:altLabel>Automated Decision-Making Systems</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RqLTf7YnPRDUOTT48SvclX"/>
  </rdf:Description>
