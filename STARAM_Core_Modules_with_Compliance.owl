    <skos:altLabel xml:lang="es-es">Mala gestión de los activos fiduciarios por parte del fiduciario</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">信託財産の管理不行き届きによる受託者の不正行為</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">受托人对信托资产的管理不善</skos:altLabel>
