    <rdfs:label>Senior Citizen Healthcare Coverage</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <skos:prefLabel>Elderly Healthcare Coverage</skos:prefLabel>
    <skos:definition>This refers to healthcare plans specifically designed to cater to the needs of individuals who are in their senior years, generally those 65 and older. In the U.S., Medicare is the primary provider of healthcare coverage for seniors, offering various plans that include hospital stays, medical services, and prescription drugs.</skos:definition>
  </rdf:Description>
