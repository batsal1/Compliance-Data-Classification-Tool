    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Process Improvement Services refers to professional services that aim to enhance and optimize business processes, including but not limited to consulting and management, in order to increase efficiency and effectiveness.</skos:definition>
    <rdfs:label>Process Improvement Services</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7UbtK5agOlYoFQYRlh858H">
