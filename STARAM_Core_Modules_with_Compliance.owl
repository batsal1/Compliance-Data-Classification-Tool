    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZVXNAbvbm2JirFGPT4Ihy"/>
    <skos:definition>A Liability Cap Clause is a provision in a contract that limits the amount of damages that can be recovered by one party from the other party in case of a breach of contract or other liability.</skos:definition>
    <rdfs:label>Liability Cap Clause</rdfs:label>
  </rdf:Description>
