  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7J7NYI0WlIIflyMEgnXHIq">
    <skos:altLabel xml:lang="zh-cn">买方同意要求</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Käufer-Einwilligungserfordernis</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">バイヤーの同意要件</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exigence de consentement de l'acheteur</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Buyer Consent Requirement</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Requisito de consentimento do comprador</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Requisito de consentimiento del comprador</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार सहमति आवश्यकता</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Requisito de consentimiento del comprador</skos:altLabel>
    <skos:altLabel xml:lang="he-il">דרישת הסכמת הקונה</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3bU74bKrSAyu2rkZ4SZEa"/>
    <skos:definition>Buyer Consent Requirement is a legal concept that refers to the obligation of a party to obtain the consent of the buyer before taking certain actions, subject to certain conditions and limitations, as specified in a negative covenant.</skos:definition>
    <rdfs:label>Buyer Consent Requirement</rdfs:label>
  </rdf:Description>
