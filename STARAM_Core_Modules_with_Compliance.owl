    <skos:definition>A Reaffirmation Agreement is a legal agreement made in the context of bankruptcy proceedings, in which a debtor agrees to repay a debt that would otherwise be discharged in bankruptcy.</skos:definition>
    <skos:altLabel xml:lang="he-il">הסכם האימוץ מחדש</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पुनःस्थापन समझौता</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acuerdo de Reafirmación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reaffirmation Agreement</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Acordo de reafirmação</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de réaffirmation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">再確認契約</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wiederaufnahmeabkommen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de Reafirmación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">再确认协议</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Reaffirmation Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
  </rdf:Description>
