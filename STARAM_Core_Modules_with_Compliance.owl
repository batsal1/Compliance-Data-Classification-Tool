  <rdf:Description rdf:about="https://folio.openlegalstandard.org/r78yIFiZQrCFnspcr2BSqA">
    <skos:definition>This industry comprises establishments primarily engaged in (1) manufacturing asphalt and tar paving mixtures and blocks and roofing cements and coatings from purchased asphaltic materials and/or (2) saturating purchased mats and felts with asphalt or tar from purchased asphaltic materials.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/9JgQwj6GQayMCfO78tmPTw"/>
    <rdfs:label>Asphalt Paving, Roofing, and Saturated Materials Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32412"/>
