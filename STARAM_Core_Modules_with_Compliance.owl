  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDtLLvVCAkIl6MqCGzKTZRY">
    <skos:altLabel xml:lang="es-mx">Recursos de apelación de órdenes colaterales</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ערעור על צווי עמידה</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">抵押权令上诉</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Recursos de apelación de órdenes colaterales</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Recursos de ordem de garantia</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Appels d'ordonnances de garantie</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Collateral Order Appeals</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अतिरिक्त आदेश अपील</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">担保命令控訴</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beschwerden über Sicherheitsleistungen</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy>PACER</rdfs:isDefinedBy>
    <rdfs:label>Collateral Order Appeal</rdfs:label>
    <rdfs:label>Collateral Order Appeals</rdfs:label>
    <skos:definition>Collateral Order Appeals are a type of appeal that can be made during a legal proceeding, which allows a party to challenge a specific issue that is separate from the main case and cannot be resolved later, even if the main case is still ongoing.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R94yxXVadPVTE4IW7iABVRc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/XdrTlruORiSD8Y5RWHKpnw">
    <skos:definition>This industry group comprises establishments primarily engaged in one of the following: (1) operating machine shops primarily engaged in machining metal and plastic parts and parts of other composite materials on a job or order basis; (2) machining precision turned products; or (3) manufacturing metal bolts, nuts, screws, rivets, and other industrial fasteners.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=3327"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ebi1FLjOSRqXDvrM65TO6A"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Machine Shops; Turned Product; and Screw, Nut, and Bolt Manufacturing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7WGnh1rtHb83LCujSQcY5h">
    <skos:altLabel xml:lang="fr-fr">Clause de paiement ballon</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बैलून भुगतान क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de pago final elevado</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ballonzahlungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תשלום בלון</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de pagamento balão</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">气球付款条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de pago final elevado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Balloon Payment Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">バルーン支払い条項</skos:altLabel>
    <skos:definition>A balloon payment clause is a provision in a contract that requires the borrower to make a large payment at the end of the loan term, often used in mortgage agreements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Balloon Payment Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
