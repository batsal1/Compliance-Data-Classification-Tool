  <rdf:Description rdf:about="https://folio.openlegalstandard.org/c2zJcA5sQkixccD2L4lXBw">
    <skos:example>Cosmetology salons</skos:example>
    <skos:example>Hair stylist shops</skos:example>
    <skos:example>Barber shops</skos:example>
    <skos:example>Beauty salons</skos:example>
    <skos:example>Nail salons</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) providing hair care services; (2) providing nail care services; and (3) providing facials or applying makeup (except permanent makeup).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81211"/>
    <rdfs:label>Hair, Nail, and Skin Care Services</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/eh8Ay3ANTdWnlpqxVysRLw"/>
  </rdf:Description>
