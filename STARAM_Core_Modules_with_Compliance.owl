  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RByMtfzwHW0Uwqj0a1kyR8s">
    <skos:altLabel xml:lang="de-de">Gesetz zur Lohngleichheit</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei de Equidade Salarial</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃金均等法</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">薪酬平等法</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Loi sur l'équité salariale</skos:altLabel>
    <skos:definition>A legal concept that deals with ensuring equal pay for equal work regardless of gender, race, or other protected characteristics in the workplace.</skos:definition>
