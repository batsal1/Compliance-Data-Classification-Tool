  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBrUb9V2u6f7iVR1RBNsyB1">
    <skos:definition>Civil Contract Law refers to a subset of Civil Caw (e.g., civil law countries) that deals with agreements between private entities, as opposed to public or governmental entities. This body of law encompasses the creation, interpretation, and enforcement of these agreements, as well as resolution of disputes related to contract performance, breach, or termination.</skos:definition>
    <dc:identifier>IN-LAW-8.1</dc:identifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCIPwpgRpMs1eVz4vPid0pV"/>
    <rdfs:label>Civil Contract Law</rdfs:label>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Civil Contract Law</skos:prefLabel>
  </rdf:Description>
