  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7oZYoHPjrvOgl09T5WKFGI">
    <skos:definition>A dependent is an individual who relies on another person, typically a family member, for financial support and is often eligible for specific tax benefits. In legal and insurance contexts, dependents may include spouses, children, and sometimes other relatives or individuals who live in the same household and rely on the primary earner for essential financial support.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5RK4Beoxturh6V8lBfWfZ"/>
    <rdfs:label>Dependent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
