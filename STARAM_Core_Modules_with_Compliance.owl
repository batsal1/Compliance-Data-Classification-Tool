    <skos:altLabel xml:lang="zh-cn">替代责任</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वैकल्पिक दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad Alternativa</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Alternative Haftung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité alternative</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">代替責任</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות חלופית</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Alternative Liability</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad Alternativa</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade alternativa</skos:altLabel>
    <rdfs:label>Alternative Liability</rdfs:label>
    <skos:definition>A legal concept where multiple parties may be held liable for damages or harm caused to another, even if it is unclear which specific party was responsible for the harm.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
