  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCLGQsilSLhiEYMG8njnuvc">
    <skos:altLabel xml:lang="es-mx">Derecho de Terminación Fiduciaria</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות סיום פידוסיארי</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फिडुशियरी समाप्ति अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit de résiliation fiduciaire</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho de Terminación Fiduciaria</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fiduciary Termination Right</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">受托人终止权</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito de rescisão fiduciária</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">信託解除権</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigungsrecht des Treuhänders</skos:altLabel>
    <skos:definition>The Fiduciary Termination Right is a provision in a legal agreement that allows a fiduciary to terminate the agreement if they believe it is in the best interest of their client, and is typically included in deal protection provisions.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8S6XHMUuU5cg5gdDri7LuL"/>
