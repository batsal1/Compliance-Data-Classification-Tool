  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9RKKV89o69CwHCRTa8p3Fz">
    <skos:altLabel xml:lang="zh-cn">法律效力条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'effet juridique</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法的効力条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Efecto Legal</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף השפעה משפטית</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rechtswirkungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de efeito legal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कानूनी प्रभाव वाली धारा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Legal Effect Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Efecto Legal</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Legal Effect Clause</rdfs:label>
    <skos:definition>A Legal Effect Clause is a clause within a contract that has the power to create legal obligations or rights for the parties involved.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/kkrdK7YAQjyv4JKqUrUUqA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Automatic Environmental Control Manufacturing for Residential, Commercial, and Appliance Use</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/NwpC-AVOSrGS91q0HJPhaw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=334512"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing automatic controls and regulators for applications, such as heating, air-conditioning, refrigeration, and appliances.</skos:definition>
  </rdf:Description>
