  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCJGdcjxSlE1dPADMhI3tqr">
    <skos:altLabel xml:lang="pt-br">Falha em reparar ou remediar</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure to Repair or Remedy</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未修复或纠正</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta de reparación o remedio</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaut de réparation ou de remédiation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כשל בתיקון או תיקון</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मरम्मत या उपचार में असफलता</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">修理または是正の怠慢</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta de reparación o remedio</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unterlassung der Reparatur oder Behebung</skos:altLabel>
    <skos:definition>The Failure to Repair or Remedy is a legal concept within Landlord-Tenant Claims that refers to the landlord's failure to fix or address issues with the rental property that they are responsible for maintaining.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R97svnIdQhrkKZw6i3Nn88z"/>
    <rdfs:label>Failure to Repair or Remedy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
