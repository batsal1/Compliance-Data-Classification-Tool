  <rdf:Description rdf:about="https://folio.openlegalstandard.org/cc423de3-17c3-4483-9e72-16afef88cf3da3728ef4-cbec-478e-a047-40749a5b6d94">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
