  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R46ln52yAFNA1tiafP1obe">
    <skos:definition>An Asset Non-Voting Right refers to the ownership of an asset that does not confer the right to participate in the voting process of a company or organization. This attribute is typically associated with certain classes of shares or financial instruments that provide economic benefits without granting decision-making power.</skos:definition>
    <rdfs:label>Asset Non-Voting Right</rdfs:label>
    <skos:altLabel>Non-Voting Security</skos:altLabel>
    <skos:altLabel>Economic Interest Without Voting Right</skos:altLabel>
    <skos:altLabel>Non-Voting Equity</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8A2f18n9G7OkKnD3C0K5O"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Non-Voting Share</skos:prefLabel>
  </rdf:Description>
