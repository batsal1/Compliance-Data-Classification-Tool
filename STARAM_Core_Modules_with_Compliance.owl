  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rq5QX7mLkcqEdsfMx86kxc">
    <skos:altLabel>Declaratory Judgment</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Feststellungsklage</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">घोषणात्मक न्याय दावा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">確定訴訟</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">宣告判决诉讼</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demanda de Declaración de Derechos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ação Declaratória</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Demanda de Declaración de Derechos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Declaratory Judgment Claim</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Action en constatation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת דין מצהירת</skos:altLabel>
    <skos:definition>A Declaratory Judgment (Claim) is a civil claim seeking a court's declaration of the parties' rights and legal obligations without ordering any specific action or awarding damages.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
    <rdfs:label>Declaratory Judgment Claim</rdfs:label>
  </rdf:Description>
