    <skos:example>Mandarin groves</skos:example>
    <skos:example>Grapefruit groves</skos:example>
    <rdfs:label>Citrus (except Orange) Groves</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in growing citrus fruits (except oranges).</skos:definition>
