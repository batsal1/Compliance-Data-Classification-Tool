  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDaMa8JZwja0SX59zWGsJYD">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Syndicated Investments</skos:example>
    <skos:example>Syndicated Loans</skos:example>
    <skos:example>Syndicated Debts</skos:example>
    <skos:definition>Syndicated refers to a financial arrangement where multiple lenders or investors jointly provide funds to a borrower or project, sharing the associated risks and returns. This structure is commonly used in large loans, debt issues, or investments that exceed the capacity or risk tolerance of a single lender or investor.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
    <rdfs:label>Syndicated</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/-dID63v6S8ytPSDaG2xfzw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/HNVzadjSQGur0qgpX0Smbw"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing industrial trucks, tractors, trailers, and stackers (i.e., truck-type) such as forklifts, pallet loaders and unloaders, and portable loading docks.</skos:definition>
    <rdfs:label>Industrial Truck, Tractor, Trailer, and Stacker Machinery Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=333924"/>
  </rdf:Description>
