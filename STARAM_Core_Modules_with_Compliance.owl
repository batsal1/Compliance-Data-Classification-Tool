    <skos:altLabel xml:lang="he-il">הוצאות עדי ראייה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Witness Expenses</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Despesas com honorários de testemunhas</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Frais de témoins</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">证人费用支出</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Gastos de testigos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Gastos de testigos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הוצאות עדים</skos:altLabel>
    <skos:definition>A witness fees expense is a type of expense that refers to the compensation paid to a person who provides testimony in a legal proceeding, which may include fees for travel, lodging, and other related expenses.</skos:definition>
    <rdfs:label>Witness Fees Expense</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
  </rdf:Description>
