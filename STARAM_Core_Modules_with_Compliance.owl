  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R70SxbGVtJtjtFVO1CA6NLZ">
    <skos:altLabel xml:lang="fr-fr">Clause de relation avec un entrepreneur indépendant</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独立請負人関係条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur unabhängigen Auftragnehmerbeziehung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वतंत्र ठेकेदार संबंध शब्दावली</skos:altLabel>
