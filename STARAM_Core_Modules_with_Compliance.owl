  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBNLtCtiehXHqrqSiI8me4X">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCMCyg29yJdESbSXnNRLABk"/>
    <skos:definition>Preferred Shares represent a class of ownership in a company that confers preferential treatment regarding dividend payments and asset distribution in the event of liquidation. These shares typically do not carry voting rights but offer a fixed dividend that must be paid before any dividends are distributed to common shareholders.</skos:definition>
    <skos:altLabel>Priority Shares</skos:altLabel>
    <rdfs:label>Preferred Shares</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Preferred Stock</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RtGO7nVUVQhovRrhewzPBk">
    <skos:altLabel>Cross-Border Segment</skos:altLabel>
    <skos:altLabel>Multinational Segment</skos:altLabel>
    <skos:altLabel>Worldwide Market Segment</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBSftPgkpTWJ4IzuvXyLBVG"/>
    <rdfs:label>International Market Segment</rdfs:label>
    <skos:prefLabel>Global Segment</skos:prefLabel>
    <skos:definition>The international segment refers to a market that spans across multiple countries or regions. It targets a global audience and is characterized by marketing strategies and product offerings that cater to diverse international preferences and regulations.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
