    <skos:definition>A cancellation of promissory note clause is a provision in a contract that allows for the cancellation or termination of a promissory note, which is a written promise to pay a debt, under certain circumstances.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cancellation of Promissory Note Clause</rdfs:label>
  </rdf:Description>
