    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7XlRtk6WMnbMZULXcg7SnI"/>
    <skos:definition>The legal concept of Parent-Child Liability refers to the responsibility of a parent for the actions or debts of their child, within the context of Family Liability.</skos:definition>
