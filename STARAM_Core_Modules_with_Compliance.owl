    <skos:altLabel xml:lang="pt-br">Assalto criminoso</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Agression criminelle</skos:altLabel>
    <skos:altLabel>Simple Assault</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nf744654ec7f14fbdaa4c91092cb7a287"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MbuFEaL6NyU9tM2AXk7lk"/>
    <skos:definition>An unlawful physical attack by one person upon another where neither the offender displays a weapon, nor the victim suffers obvious severe or aggravated bodily injury involving apparent broken bones, loss of teeth, possible internal injury, severe laceration, or loss of consciousness.</skos:definition>
    <rdfs:label>Criminal Assault</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
  </rdf:Description>
