  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R94b5WILT1ePj3BCcG92yjr">
    <rdfs:label>Attorney Increasing Inadequate Contingency Fee</rdfs:label>
    <skos:altLabel xml:lang="he-il">עו"ד מגביה עמלות תמורת תשלום עתידי לא מתאימות</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Abogado Aumentando Honorarios Contingentes Inadecuados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Solicitor Increasing Inadequate Contingency Fee</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anwalt erhöht unzureichende Erfolgsgebühr</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abogado Aumentando Honorarios Contingentes Inadecuados</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वकील बढ़ते अपर्याप्त आपात शुल्क</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">律师增加不足的 contingency fee</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Avocat augmentant les frais de contingence insuffisants</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">弁護士が不十分なコンティンジェンシー料金を増やす</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Advogado aumentando taxa de contingência insuficiente</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An attorney's failure to increase a contingency fee in proportion to the increased risk or complexity of a case, resulting in inadequate compensation for the attorney's services.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoltD3dXNzHF23P50ZXh6v"/>
  </rdf:Description>
