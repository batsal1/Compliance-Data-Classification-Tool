    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=335210"/>
    <skos:example>Portable cooking appliances (except microwave, convection ovens), household-type electric, manufacturing</skos:example>
    <skos:example>Scissors, electric, manufacturing</skos:example>
    <skos:example>Portable electric space heaters manufacturing</skos:example>
    <skos:example>Curling irons, household-type electric, manufacturing</skos:example>
    <skos:example>Portable hair dryers, electric, manufacturing</skos:example>
    <skos:example>Carpet and floor cleaning equipment, household-type electric, manufacturing</skos:example>
    <skos:example>Electric blankets manufacturing</skos:example>
    <skos:example>Portable humidifiers and dehumidifiers manufacturing</skos:example>
    <skos:example>Ceiling fans, residential, manufacturing</skos:example>
    <skos:example>Bath fans, residential, manufacturing</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/IskppNfMST2HwyMs3oTwLA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing small electric appliances and electric housewares, household-type fans (except attic fans), household-type vacuum cleaners, and other electric household-type floor care machines.</skos:definition>
    <skos:definition>Ventilating and exhaust fans (except attic fans), household-type, manufacturing</skos:definition>
    <rdfs:label>Small Electrical Appliance Manufacturing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDzeDq1ztdnjJlGdGfj1oWQ">
    <skos:altLabel xml:lang="es-mx">Lenguaje de "Derecho a Solicitar" el Cumplimiento Específico</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito de buscar o cumprimento específico</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">有权寻求具体履行的语言</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">"विशिष्ट प्रदर्शन भाषा" के अधिकारी होना</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Durchsetzung der Leistung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכאי לבקש שפה של ביצוע מסוים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lenguaje de "Derecho a Solicitar" el Cumplimiento Específico</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit de demander l'exécution en nature</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">履行を求める権利の言語</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Entitled to Seek" Specific Performance Language</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Bdj1eCxXbeaYx70Wt6JN5"/>
    <rdfs:label>"Entitled to Seek" Specific Performance Language</rdfs:label>
    <skos:definition>The "Entitled to Seek" Specific Performance Language refers to a clause in a legal contract that grants one party the right to request specific performance, or the fulfillment of a specific obligation, from the other party.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
