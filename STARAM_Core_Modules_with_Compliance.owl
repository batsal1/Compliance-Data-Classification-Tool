  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8SXsuhOb76PDAHy1Sk1iYU">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDR762ETZykxzu0RfYBxNu9"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDGdgxwCGXpkY1zfT2WwGl9"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7pLfw7zqXtd20kKg7EcOA"/>
    <skos:altLabel>ESOP Law</skos:altLabel>
    <skos:altLabel>Employee Share Ownership Law</skos:altLabel>
    <rdfs:label>Employee Stock Ownership Plans Law</rdfs:label>
    <skos:definition>Employee Stock Ownership Plans Law refers to the legal framework governing the establishment, management, and regulation of Employee Stock Ownership Plans (ESOPs), which allow employees to acquire ownership interests in their employer. This body of law includes statutes, regulations, and case law that ensure ESOPs are operated in the best interest of the employees and comply with tax and labor laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Employee Equity Participation Law</skos:prefLabel>
  </rdf:Description>
