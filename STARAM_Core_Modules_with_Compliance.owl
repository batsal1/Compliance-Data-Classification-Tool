  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBrQ5TxsIktzAkyFafeC1NS">
    <skos:altLabel xml:lang="zh-cn">费用报销条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kostenrückerstattungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de reembolso de despesas</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Reembolso de Gastos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यय वापसी शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Reembolso de Gastos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף החזר הוצאות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">費用弁償条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Reimbursement of Expenses Clause</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de remboursement des dépenses</skos:altLabel>
    <rdfs:label>Reimbursement of Expenses Clause</rdfs:label>
    <skos:definition>A Reimbursement of Expenses Clause is a provision in a contract that requires one party to compensate the other for any expenses incurred in the performance of the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
