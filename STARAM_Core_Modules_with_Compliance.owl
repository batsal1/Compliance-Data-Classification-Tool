    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rv3swANBomz5la6o0SeA2V">
    <skos:altLabel xml:lang="es-mx">Parte sin representación legal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">自诉方</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Parte Pro Se</skos:altLabel>
    <skos:altLabel>Unrepresented Party</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Litigant in person</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">プロセパーティー</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מי שמייצג את עצמו</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Partie Pro Se</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वयं से पक्ष</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pro-Se-Partei</skos:altLabel>
    <skos:altLabel>Self-Represented Party</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Parte sin representación legal</skos:altLabel>
    <skos:definition>A Pro Se Party is an individual who represents themselves in a legal matter without the assistance of an attorney. Another name for pro se is "unrepresented party."</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Self-Represented Litigant</skos:prefLabel>
    <rdfs:label>Pro Se Party</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/adMzcJ4sRbysAYPktwOg-Q">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_tHJmmKxTwaTlgYnPYomFA"/>
    <skos:example>Athletic shoes manufacturing</skos:example>
    <skos:example>Shoes, children's and infants' (except orthopedic extension), manufacturing</skos:example>
    <skos:example>Cleated athletic shoes manufacturing</skos:example>
    <skos:example>Shoes, men's (except orthopedic extension), manufacturing</skos:example>
    <skos:example>Shoes, women's (except orthopedic extension), manufacturing</skos:example>
    <skos:example>Ballet slippers manufacturing</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=316210"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Footwear Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing footwear (except orthopedic extension footwear).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB8myhaCCMTUdY7A2X5UFj6">
    <skos:definition>A failure to reimburse expenses claim is a legal action initiated by an employee against their employer for not properly reimbursing work-related expenses incurred by the employee in the course of performing their job duties. These expenses can include items such as travel costs, mileage, or required tools and equipment, and the claim arises when an employer neglects or refuses to reimburse the employee as required by law or the terms of their employment agreement.</skos:definition>
    <skos:altLabel xml:lang="he-il">כישלון בקשת החזר דרישות הוצאות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta de Reembolso de Gastos Reclamados</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nichterstattung von Ausgabenansprüchen</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Refus de rembourser les frais</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">経費請求の返済の失敗</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha em reembolsar despesas</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta de Reembolso de Gastos Reclamados</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未能报销费用申请</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure to Reimburse Expenses Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यय दावा वापसी में असफलता</skos:altLabel>
    <rdfs:label>Failure to Reimburse Expenses Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
  </rdf:Description>
