  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RYQtICTQZAQzMuF7hmmszk">
    <skos:altLabel xml:lang="es-mx">Operar / Promover / Asistir en el Juego de Azar</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Exploitation / Promotion / Assistance au jeu</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betreiben / Bewerben / Unterstützen von Glücksspiel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">经营/推广/协助赌博</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Operar / Promover / Auxiliar em Jogos de Azar</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Operar / Promover / Asistir en el Juego de Azar</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפעלת / קידום / סיוע בהימורים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ギャンブルの運営/促進/支援</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">जुआ चलाना / प्रोत्साहित करना / सहायता करना</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Operating / Promoting / Assisting Gambling</skos:altLabel>
    <skos:definition>To unlawfully operate, promote, or assist in the operation of a game of chance, lottery, or other gambling activity</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Operating / Promoting / Assisting Gambling</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Xjkk7EkIgiSA3LmsPofVx"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na0fd754e74b344809b1c24c17147acba">
