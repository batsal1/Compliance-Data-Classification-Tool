    <skos:altLabel xml:lang="hi-in">नोटरी पब्लिक और सुरेटी की लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת הזהות של הנוטריון הציבורי והערבים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia del Notario Público y los Fiadores</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligence of Notary Public &amp; Sureties</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência do notário e dos fiadores</skos:altLabel>
    <rdfs:label>Negligence of Notary Public &amp; Sureties</rdfs:label>
    <skos:definition>The failure of a notary public and their guarantors to exercise reasonable care and diligence in performing their duties, resulting in harm or loss to a party involved in a real estate transaction.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Ne16852bbcbdb41c6a40e8bcfa3a113ec"/>
