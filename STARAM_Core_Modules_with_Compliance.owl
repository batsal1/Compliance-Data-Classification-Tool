  <rdf:Description rdf:about="https://folio.openlegalstandard.org/FaZbyMUoS-e3jFurirN20A">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Campgrounds</skos:example>
    <skos:example>Fishing and hunting camps</skos:example>
    <skos:example>Travel trailer campsites</skos:example>
    <skos:example>Recreational vehicle parks</skos:example>
    <skos:example>Outdoor adventure retreats</skos:example>
    <skos:example>Vacation camps (except instructional, day)</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/bQRurX9qSk2Pq-ywfZzaFw"/>
    <rdfs:label>RV (Recreational Vehicle) Parks and Recreational Camps</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=72121"/>
    <skos:definition>This industry comprises establishments primarily engaged in operating recreational vehicle parks and campgrounds and recreational and vacation camps.  These establishments cater to outdoor enthusiasts and are characterized by the type of accommodation and by the nature and the range of recreational facilities and activities provided to their clients.</skos:definition>
  </rdf:Description>
