    <skos:altLabel xml:lang="fr-fr">Inventeur</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">发明家</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Erfinder</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Inventor</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">発明家</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Inventor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מְגַלֵּה חֲדָשׁוֹת</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Inventor</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N305ed98e5087455ab7d7fb1aad9c550d"/>
    <rdfs:subClassOf rdf:nodeID="Ndf75f86928b14722990c02ba920e82d5"/>
    <rdfs:subClassOf rdf:nodeID="Nc3e8b87793ae42e687a73ae55c8030e7"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Inventor</rdfs:label>
    <skos:definition>An inventor is a person who creates a new and useful process, machine, manufacture, or composition of matter, and is recognized as the original source of that invention in a legal matter.</skos:definition>
  </rdf:Description>
