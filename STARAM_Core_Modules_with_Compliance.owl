    <skos:definition>eSignatures Management refers to the process of creating, verifying, and managing electronic signatures within the context of contract and document management.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/i22tsqU-R5SH9nDskUhX8Q">
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) slaughtering animals; (2) preparing processed meats and meat byproducts; and (3) rendering and/or refining animal fat, bones, and meat scraps.  This industry includes establishments primarily engaged in assembly cutting and packing of meats (i.e., boxed meats) from purchased carcasses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/JQyudzenQCewkU5pYtJHGw"/>
    <rdfs:label>Animal Slaughtering and Processing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=31161"/>
  </rdf:Description>
