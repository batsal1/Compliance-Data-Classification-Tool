  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9yqnXWcGhtBOudF4GuEVPs">
    <rdfs:label>Estate Planning Practice</rdfs:label>
    <skos:altLabel>Legacy Planning Practice</skos:altLabel>
    <skos:altLabel>Wills and Trusts</skos:altLabel>
    <skos:altLabel>Estate Planning Service</skos:altLabel>
    <skos:altLabel>Estate Preparation Practice</skos:altLabel>
    <skos:altLabel>Wealth Planning Practice</skos:altLabel>
    <skos:altLabel>Asset Planning Practice</skos:altLabel>
    <skos:altLabel>Estate Planning</skos:altLabel>
    <skos:altLabel>Trusts and Estates</skos:altLabel>
    <skos:altLabel>Succession Planning</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9bCaZjWhV1f2PgQiwzAkDm"/>
    <skos:definition>Estate Planning Practice involves the preparation and arrangement of an individual's estate to manage and distribute assets during their lifetime and after death. It includes creating legal documents such as wills, trusts, and powers of attorney to ensure that an individual's wishes are followed and to minimize taxes and legal complications.</skos:definition>
  </rdf:Description>
