  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP">
    <skos:altLabel>Retail Trade</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खुदरा व्यापार उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria del Comercio al por Menor</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie du commerce de détail</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Retail Trade Industry</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria do comércio varejista</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">小売業界</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">零售贸易行业</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria del Comercio Minorista</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Einzelhandelsbranche</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית מסחר בקמעונאות</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=44"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=45"/>
    <skos:definition>The Retail Trade industry group comprises establishments engaged in retailing merchandise, generally without transformation, and rendering services incidental to the sale of merchandise. The retailing process is the final step in the distribution of merchandise; retailers are, therefore, organized to sell merchandise in small quantities to the general public. This sector comprises two main types of retailers: store and nonstore retailers.</skos:definition>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-RET</ns2:legacyIdentifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:identifier>RET</dc:identifier>
    <dc:identifier>IN-INDUSTRY-17</dc:identifier>
    <rdfs:label>Retail Trade Industry</rdfs:label>
    <skos:prefLabel>Retail Trade Industry</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDIwFaFcH4KY0gwEY0QlMTp"/>
    <skos:hiddenLabel>RET</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/XeYL9yOAQT6W0zcjNmItyQ">
    <skos:example>Submarine building</skos:example>
    <skos:example>Cargo ship building</skos:example>
    <skos:example>Yachts built in shipyards</skos:example>
    <skos:example>Barge building</skos:example>
    <skos:example>Drilling and production platforms, floating, oil and gas, building</skos:example>
    <skos:example>Passenger ship building</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Ship Building and Repairing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/F1CbUwpYQ8C1oc_0y9ztIQ"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in operating shipyards. Shipyards are fixed facilities with drydocks and fabrication equipment capable of building a ship, defined as watercraft typically suitable or intended for other than personal or recreational use. Activities of shipyards include the construction of ships, their repair, conversion and alteration, the production of prefabricated ship and barge sections, and specialized services, such as ship scaling.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=336611"/>
  </rdf:Description>
