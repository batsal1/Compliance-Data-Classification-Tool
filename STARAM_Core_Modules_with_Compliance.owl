    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Expert Practice</rdfs:label>
    <skos:definition>Expert Practice refers to the specialized legal work performed by an individual with advanced knowledge and experience in a particular field, typically involving the preparation and presentation of expert testimony in a legal matter.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ewxg1idKRuaTvVKFvLRikw">
    <rdfs:label>Hog and Pig Farming</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/J9eoyOIzSpyPpWJoi95s_g"/>
