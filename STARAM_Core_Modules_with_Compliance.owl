  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBMP3a3Y68abx6FeTqmEPFk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
    <skos:altLabel xml:lang="he-il">סעיף פטור מנידון על ידי לוחמי צבא</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation au procès devant un jury</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ज्यूरी ट्रायल क्लॉज का इनकार</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia ao julgamento por júri</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzicht auf eine Jury-Verhandlungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">陪審裁判の放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia al juicio por jurado</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">放弃陪审团审判条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia al juicio por jurado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver of Jury Trial Clause</skos:altLabel>
    <rdfs:label>Waiver of Jury Trial Clause</rdfs:label>
    <skos:definition>A Waiver of Jury Trial Clause is a provision in a contract where parties agree to give up their right to a trial by jury in the event of a dispute, and instead have the dispute resolved by a judge or arbitrator.</skos:definition>
  </rdf:Description>
