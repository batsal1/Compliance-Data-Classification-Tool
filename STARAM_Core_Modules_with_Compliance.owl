  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCE0lkpU1G16wfw8phS0y9R">
    <skos:altLabel xml:lang="en-gb">At Will Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इच्छा अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur freien Kündigung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">随时条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ברצונך</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation à tout moment</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">随意条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão unilateral</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de voluntad</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de voluntad</skos:altLabel>
    <rdfs:label>At Will Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An at-will clause is a provision in a contract that allows either party to terminate the agreement at any time without cause or penalty.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQGzAjBWLRfJIJGsChGKna">
    <skos:altLabel xml:lang="he-il">הליך מאכזב</skos:altLabel>
