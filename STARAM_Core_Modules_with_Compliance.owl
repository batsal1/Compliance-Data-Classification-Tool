  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/iSgrhJSsQMWdkwK4aqBZIQ">
    <rdfs:label>Furniture Retailers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/jF4vQ7KBRLCfdwE0hqAOnw"/>
    <skos:definition>This industry comprises establishments primarily engaged in retailing new furniture, such as household furniture (e.g., baby furniture, box springs, and mattresses) and outdoor furniture; office furniture (except sold in combination with office supplies and equipment); and/or furniture sold in combination with major appliances, home electronics, home furnishings, or floor coverings.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=449110"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8bI7utrpB2lXtuUuLqUWqa">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:subClassOf rdf:nodeID="Nec91dc6c370e4986be4d078871065a82"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBAoFbSK8WP6xJyVrgQd5PZ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
    <rdfs:subClassOf rdf:nodeID="N2afb61045d484ff5b43ec603a4864378"/>
    <skos:altLabel xml:lang="he-il">שחרור מחויבות בהתאגדות פשיטת רגל</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Discharge in Bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Exoneración en bancarrota</skos:altLabel>
    <skos:altLabel>Payment, release, satisfaction, discharge in bankruptcy</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">破産債務の免除</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Descarga na falência</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Liberación en bancarrota</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Décharge de faillite</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Insolvenzverfahrenseröffnung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">破产清偿</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दिवालियापन में रिहाई</skos:altLabel>
    <skos:prefLabel>Bankruptcy Discharge</skos:prefLabel>
    <rdfs:label>Discharge in Bankruptcy</rdfs:label>
    <skos:definition>The concept of Discharge in Bankruptcy refers to the release of a debtor from the obligation to pay certain debts, as ordered by a bankruptcy court.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8iS8CmEf6kvCNAGHqIbhAu">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <skos:altLabel xml:lang="en-gb">Pharmaceutical Negligence</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הזנחת תרופות</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência farmacêutica</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">医薬品過失</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">药品过失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फार्मास्यूटिकल लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence pharmaceutique</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia farmacéutica</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Pharmazeutische Fahrlässigkeit</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia farmacéutica</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Pharmaceutical Negligence</rdfs:label>
    <skos:definition>Pharmaceutical Negligence refers to the failure of a medical professional or institution to provide adequate care and treatment in the prescription, dispensing, or administration of medication, resulting in harm or injury to the patient.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2f8f827757c14fe1bd9e99d287180bbc">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RCxuXpqOrrFbsypErx3cM4"/>
