  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RsDNLN3OFdVxc9ZIMb6Noj">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
    <rdfs:label>Personal Identity Objective</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A personal identity objective refers to an individual's pursuit to legally alter or affirm aspects of their personal identity, such as their name or gender marker, in official records. This process often involves navigating legal procedures and requirements to obtain necessary documentation or court orders to reflect the desired change or affirmation on official identification documents</skos:definition>
  </rdf:Description>
