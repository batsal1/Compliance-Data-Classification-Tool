  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R70VwdCRSOPwzDEI6oPuy9B">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="fr-fr">Délit</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">轻罪</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Delito menor</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vergehen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Contravenção</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עבירה קלה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">軽犯罪</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Misdemeanour</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Delito menor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कम गंभीर अपराध</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7bP5vwpnavvW5pPJutIvq8"/>
    <rdfs:label>Misdemeanor</rdfs:label>
    <skos:definition>A Misdemeanor Degree is a level of severity within the category of Criminal Claims, indicating a less serious offense than a felony, but still punishable by fines or imprisonment for up to one year.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7H9fjJqEhdvJ0hGGKxvSyG">
    <rdfs:label>Insurance Malpractice</rdfs:label>
    <skos:definition>Insurance Malpractice refers to a legal claim made against an insurance professional or company for negligence, errors, or omissions in handling an insurance claim.</skos:definition>
    <skos:altLabel xml:lang="es-es">Negligencia en seguros</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insurance Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बीमा लोगों के साथ अनुचित व्यवहार</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">保险失误</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保険過失</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאת ביטוח</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versicherungsfehlerhaftigkeit</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em seguros</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en assurance</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en seguros</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Nf5bdae990e414a8e94f51002c85b62da"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RGm7jrTspmRi606c5XWZ1z"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/coo7OMB2Qtaq6fzpUmNGYA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/VwDNzEFrQ5iDn8JkFA5ieg"/>
    <rdfs:label>Public Relations Agencies</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=541820"/>
    <skos:definition>This industry comprises establishments primarily engaged in designing and implementing public relations campaigns. These campaigns are designed to promote the interests and image of their clients. Establishments providing lobbying, political consulting, or public relations consulting are included in this industry.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
