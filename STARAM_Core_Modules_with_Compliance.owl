  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDzSLCTTihtIsY2Vostr1Fn">
    <skos:altLabel xml:lang="en-gb">Disclosure Motion Practice</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Discovery Motion Practice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खोज याचिका प्रथा</skos:altLabel>
    <skos:altLabel>Discovery Motion Service</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">发现动议实践</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Entdeckungsverfahren</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de la Moción de Descubrimiento</skos:altLabel>
    <skos:altLabel>Discovery Motion</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Procédure de découverte</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de la Moción de Descubrimiento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעילות מוטיון גילוי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">開示動議手続き</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de movimento de descoberta</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9hR0S1zExtgPQTzV0LeyD3"/>
    <skos:definition>Discovery Motion Practice refers to the legal process of requesting a court order to compel the opposing party to provide evidence or information during the discovery phase of a legal matter.</skos:definition>
    <rdfs:label>Discovery Motion Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
