    <skos:altLabel xml:lang="pt-br">Negligência em flebotomia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">採血過失</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Phlebotomie-Nachlässigkeit</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">采血过失</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en flebotomía</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Phlebotomy Negligence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en flebotomía</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence en phlébotomie</skos:altLabel>
