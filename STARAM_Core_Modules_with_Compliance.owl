  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R73uN7kP1iXmj2AOvXW2sl3">
    <rdfs:label>Time Limitation of Public Benefit</rdfs:label>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
    <skos:definition>Time limitation of public benefit refers to a policy that restricts the duration for which an individual or family can receive financial assistance or services from a specific public benefit program. This is designed to encourage recipients to become self-sufficient and reduce long-term dependency on government aid.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
