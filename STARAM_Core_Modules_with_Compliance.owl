  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDb7mHsQQLLSVsxIdQivBMB">
    <skos:prefLabel>Workers' Rights</skos:prefLabel>
    <skos:definition>Labor rights are the legal and social protections designed to ensure fair treatment, equitable wages, and safe working conditions for workers. These rights can include the freedom to organize and join labor unions, the right to collective bargaining, and protection from unlawful discrimination or harassment in the workplace.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCKyQq2d2O4kCcP6LbXtuCz"/>
    <rdfs:subClassOf rdf:nodeID="N5a713d443b2b4fc4bc5eb257b08d786b"/>
    <rdfs:subClassOf rdf:nodeID="Ndd7a4f312bf7415e858fbf82ca5b37c4"/>
    <rdfs:subClassOf rdf:nodeID="Nacd76451d0f543079411131fe78e729d"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Employment Rights</skos:altLabel>
    <rdfs:label>Labor Rights</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RELaiGA_MRN2lyRkkH1_I4A">
    <skos:prefLabel>TR120 Analysis/Strategy</skos:prefLabel>
    <rdfs:label>TR120 Analysis/Strategy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The thinking, strategizing, and planning for a case that is not included under other trademark task codes below. Includes discussions, writing, and meetings on case strategy. Also includes initial legal research for case assessment purposes and legal research for developing a basic case strategy. Most legal research and/or other activity will be under the primary task for which the research is conducted, such as research for a response to an office action under TR430 and TR630 respectively.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R-YvCgdtISQO1tbI6WJNXTQ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R37FvPsRLcbw663pimU2TZ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
    <skos:altLabel xml:lang="es-es">Cobertura para Causas que se Extienden desde el Riesgo Asegurado</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Couverture pour les causes découlant du risque assuré</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Coverage for Causes Extending From Insured Risk</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保険リスクからの原因に対するカバレッジ</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כיסוי לסיבות המתרחבות מהסיכון המבוטח</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बीमित जोखिम से फैलने वाले कारणों के लिए कवरेज</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">涵盖从保险风险延伸的原因</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cobertura para Causas que se Extienden desde el Riesgo Asegurado</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Deckung für Ursachen, die sich aus versichertem Risiko ergeben</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cobertura para causas decorrentes do risco segurado</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Insurance coverage that applies to claims arising from risks that are covered under the insurance policy, and extends to claims for breach of contract.</skos:definition>
    <rdfs:label>Coverage for Causes Extending From Insured Risk</rdfs:label>
  </rdf:Description>
