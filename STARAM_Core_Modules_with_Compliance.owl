  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCymFqZ4uzSi1MXyfIUk1TH">
    <rdfs:label>Party Admission</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R82DCY9wpy8RlxYrwn0NIya"/>
    <skos:altLabel>Statement by a Party Opponent</skos:altLabel>
    <skos:altLabel>Admission by a Party</skos:altLabel>
    <dc:source>Fed. R. Evid. 801(d)(2)</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Party Admission is a statement made by a party to a legal proceeding that is offered as evidence against that party. Party admissions are considered non-hearsay and are admissible as an exception to the hearsay rule due to the inherent reliability and fairness of allowing a party's own statements to be used against them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6dc1c1970870447ba8a7ddfc1fccb9d6">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermGuarantor"/>
