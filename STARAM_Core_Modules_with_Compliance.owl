    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">M&amp;A / Transactional</ns1:contractFamily>
    <rdfs:label>Separation and Distribution Agreement</rdfs:label>
    <skos:definition>A Separation and Distribution Agreement outlines the terms under which a parent company will spin off, or separate, one of its businesses into an independent entity. It defines the assets, liabilities, and equity that will be transferred to the new entity and the manner of distribution.</skos:definition>
  </rdf:Description>
