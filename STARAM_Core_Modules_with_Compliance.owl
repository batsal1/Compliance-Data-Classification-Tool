    <skos:altLabel xml:lang="pt-br">Reivindicações de Direito à Saúde</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de derecho sanitario</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות חוקיות בתחום הבריאות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamations en droit de la santé</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ansprüche im Gesundheitsrecht</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">医療法の請求</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वास्थ्य देखभाल कानून दावे</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones de derecho sanitario</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">医疗法律索赔</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Health Care Law Claims</skos:altLabel>
    <skos:definition>Health Care Law Claims: Legal claims related to healthcare, including claims under the Health Maintenance Organization Act, claims under the Health Insurance Portability and Accountability Act (HIPAA), and claims related to health care fraud.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Health Care Law Claims</rdfs:label>
  </rdf:Description>
