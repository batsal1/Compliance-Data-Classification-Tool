  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7yue2mtjzJWKBkXpq5y1Mm">
    <skos:altLabel xml:lang="he-il">ספקת אלכוהול באופן שגוי או באופן שלא ישיג את הסטנדרטים הנדרשים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">過失によるアルコール提供</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligently Providing Alcohol</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Suministro negligente de alcohol</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">过失提供酒精</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fornecimento negligente de álcool</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Alkoholabgabe</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लापरवाही से शराब प्रदान करना</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Fourniture négligente d'alcool</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Suministro negligente de alcohol</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Negligently Providing Alcohol refers to the legal claim that holds a person responsible for providing alcohol to someone who is not legally allowed to consume it or who is already intoxicated, resulting in harm or injury to that person or others.</skos:definition>
    <rdfs:label>Negligently Providing Alcohol</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBOczjtsHXQh2ojzTubbrxI">
    <skos:prefLabel>Ancillary Relief</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
    <rdfs:subClassOf rdf:nodeID="Nbdbb9c23681c47a696b068e5267288ef"/>
    <skos:definition>Ancillary Relief refers to additional financial orders made by a court in the context of divorce or separation proceedings, including maintenance payments, division of assets, and financial support. These orders are intended to ensure fair financial arrangements between the parties involved.</skos:definition>
    <rdfs:label>Remedies in Family Law</rdfs:label>
    <skos:altLabel>Support Orders</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RYR2drZu94msrQ4RDFyPoU">
    <skos:altLabel xml:lang="fr-fr">Discrimination fondée sur l'origine nationale</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">国籍に基づく差別</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Discriminação de origem nacional</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Discriminación por origen nacional</skos:altLabel>
    <skos:altLabel xml:lang="he-il">Discrimination based on national origin</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">राष्ट्रीय मूल के आधार पर भेदभाव</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Discriminación por origen nacional</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">National Origin Discrimination</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Diskriminierung aufgrund der nationalen Herkunft</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">因国籍歧视</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
    <skos:definition>Discrimination based on a person's country of origin or ancestry, which is prohibited by law in various jurisdictions.</skos:definition>
    <rdfs:label>National Origin Discrimination</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8hWq9dSn0Su2Y59JE48V3H">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-mx">Inversionista</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">投資家</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">投资者</skos:altLabel>
    <skos:altLabel>Investor</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Investisseur</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Inversor</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निवेशक</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Investor</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Investidor</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Investor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">משקיע</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-INVR</ns2:legacyIdentifier>
    <skos:hiddenLabel>INVR</skos:hiddenLabel>
    <dc:identifier>INVR</dc:identifier>
    <rdfs:label>Investor</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="Nb5c2124596254ba3bc5da23674890134"/>
    <rdfs:subClassOf rdf:nodeID="Nf7e97648eada4c718db2838769608126"/>
    <rdfs:subClassOf rdf:nodeID="N99b3c42ce6b147a2aae676b2a72c0bb6"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:nodeID="Na43fdb01137a427198b5291efecf7011"/>
    <rdfs:subClassOf rdf:nodeID="N2489cc9bf3694c018d94364b9964a849"/>
    <skos:definition>An investor is a person, company or entity that qualifies under the Securities Act of 1933 and related Securities and Exchange Commission regulations as one having sufficient knowledge and expertise in financial matters to weigh the value and risks of an investment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N32396cd37bcf4503a1debcefe190792c">
    <owl:onProperty rdf:resource="https://staram.in/ontology/epc#hasDraftingDefectType"/>
