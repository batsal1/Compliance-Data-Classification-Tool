  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RmiYQJshZzYvIsqEWLjj1x">
    <skos:definition>An Export Control Claim arises when an individual or entity is accused of violating regulations that govern the export, re-export, and transfer of controlled goods, technology, and services. This claim involves allegations of unauthorized exports, failure to obtain necessary licenses, or exporting to prohibited destinations or entities.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36"/>
    <skos:altLabel>Export Violation Claim</skos:altLabel>
    <rdfs:label>Export Control Claims</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#coverage-covered">
