  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ChCxhVnJMczYDKPYrqmXo">
    <skos:altLabel>Appropriations</skos:altLabel>
    <skos:altLabel>Budgetary Distribution Practice</skos:altLabel>
    <skos:altLabel>Fund Allocation Management</skos:altLabel>
    <skos:altLabel>Appropriations Service</skos:altLabel>
    <skos:altLabel>Resource Allocation Management</skos:altLabel>
    <skos:altLabel>Budgetary Allocation Practice</skos:altLabel>
    <skos:altLabel>Financial Resource Management</skos:altLabel>
    <skos:altLabel>Financial Appropriation Services</skos:altLabel>
    <skos:definition>Appropriations Practice involves advice regarding the management and oversight of the allocation and disbursement of funds within an organization, whether it be governmental, private, or nonprofit. This practice helps ensure that financial resources are allocated in accordance with legal and organizational guidelines to support designated projects and operations.</skos:definition>
    <rdfs:label>Appropriations Practice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9p98NogvwJk1MnJgYzuiZd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rfp3FLmS5d1KkQwcg33DDu">
    <rdfs:label>Right of First Negotiation Clause</rdfs:label>
    <skos:altLabel xml:lang="pt-br">Cláusula de direito de primeira negociação</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zum Recht auf erste Verhandlung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit de première négociation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכות המשא ומתן ראשוני</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">最優先交渉権条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पहली वार्ता का अधिकार शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Derecho de Primera Negociación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">优先谈判权条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Derecho de Primera Negociación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right of First Negotiation Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Right of First Negotiation Clause is a provision in a contract that grants one party the exclusive right to negotiate with the other party before any other potential buyers or sellers, typically in regards to a specific asset or property.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7TMX2dw9IzNIC3bpUZEFRP">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDlzJI9mdSvHCyKvBrBOFmp"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBAslwjHggAEqEvEC7C8oWJ"/>
    <rdfs:subClassOf rdf:nodeID="N980bba71db0645238c94f82ae5fccd7f"/>
    <rdfs:subClassOf rdf:nodeID="Nf9477dd5152e46cbba36823b9a3c2f67"/>
    <skos:altLabel>Legislative Drafting Service</skos:altLabel>
    <skos:altLabel>Legislative Drafting</skos:altLabel>
    <rdfs:label>Legislative Drafting Practice</rdfs:label>
    <skos:definition>Legislative drafting practice involves the creation of legal texts that are intended to become laws, typically performed by specialized legal experts or legislative counsel. This practice requires a deep understanding of legal principles, legislative processes, and the ability to write clearly and unambiguously, with the goal of producing enforceable and effective laws.</skos:definition>
