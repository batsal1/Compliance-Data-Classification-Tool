    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo de Regalías</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכם זכויות יוצרים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ロイヤリティ契約条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Royalty Agreement Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">版税协议条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'accord de redevances</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रॉयल्टी समझौता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Lizenzgebührenvereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo de Regalías</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Acordo de Royalties</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Royalty Agreement Clause</rdfs:label>
    <skos:definition>A royalty agreement clause is a provision in a contract that outlines the terms and conditions for the payment of royalties, which are payments made to the owner of a property or asset for its use or exploitation.</skos:definition>
  </rdf:Description>
