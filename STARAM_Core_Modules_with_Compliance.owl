  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCHefhz5TMvHujG15QFkVde">
    <skos:altLabel xml:lang="hi-in">बीमा नीति बिना बीमित को सूचित किए बिना समाप्त</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Póliza de seguro terminada sin previo aviso al asegurado</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Versicherungspolice ohne Benachrichtigung des Versicherten gekündigt</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">保険契約が保険契約者に通知されずに終了しました</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Apólice de seguro rescindida sem aviso ao segurado</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פוליסת ביטוח נפסקה ללא הודעה למבוטח</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Póliza de seguro terminada sin previo aviso al asegurado</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insurance Policy Terminated Without Notice to Insured</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未通知被保险人终止保险单</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Police d'assurance résiliée sans préavis à l'assuré</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Insurance Policy Terminated Without Notice to Insured</rdfs:label>
    <skos:definition>An insurance policy terminated without notice to the insured refers to the situation where an insurance policy is cancelled by the insurer without informing the policyholder, resulting in the termination of coverage and potential legal disputes.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
    <rdfs:subClassOf rdf:nodeID="N417f5644286e4415b783a60a4c24287e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ARlCKJua3ITxq2VdwZ2xT">
    <skos:altLabel xml:lang="en-gb">Breach of Third-Party Beneficiary Contract</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">第三者受益契約違反</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verletzung eines Vertrags mit Drittbegünstigten</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反第三方受益人合同</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">तीसरे पक्ष लाभार्थी अनुबंध का उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוזה מוטב צד שלישי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de contrato de beneficiário terceiro</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de contrato de beneficiario de terceros</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de contrato de beneficiario de terceros</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation d'un contrat bénéficiaire tiers</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Breach of Third-Party Beneficiary Contract refers to a situation where a party fails to fulfill their obligations under a contract, which was made for the benefit of a third party who is not a direct party to the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC2fjcpsEbrVvVymvt4oASx"/>
    <rdfs:label>Breach of Third-Party Beneficiary Contract</rdfs:label>
  </rdf:Description>
