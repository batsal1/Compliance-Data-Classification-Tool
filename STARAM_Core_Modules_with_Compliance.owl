  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8VdhCh5655Uv5Em3v6CAD9">
    <skos:altLabel xml:lang="zh-cn">承包商选择过失</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligent Selection of a Contractor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בחירת קבלן באופן שגוי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Selección negligente de un contratista</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Selección negligente de un contratista</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Seleção negligente de um contratante</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक कॉन्ट्रैक्टर का लापरवाह चयन</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Sélection négligente d'un entrepreneur</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">請負業者の選択ミス</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässige Auswahl eines Auftragnehmers</skos:altLabel>
    <rdfs:label>Negligent Selection of a Contractor</rdfs:label>
    <skos:definition>The Negligent Selection of a Contractor refers to a situation where an employer fails to exercise reasonable care in choosing a contractor, resulting in harm or injury to an employee.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9W383eXfjKshQ9yv9dK7f1">
    <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
    <skos:altLabel xml:lang="fr-fr">Activité de développement positif des jeunes</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ポジティブ・ユース・ディベロップメント・アクティビティ</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सकारात्मक युवा विकास गतिविधि</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Actividad de Desarrollo Positivo de la Juventud</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">积极青年发展活动</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Actividad de Desarrollo Positivo de la Juventud</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Positive Youth Development Activity</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Aktivität zur positiven Jugendentwicklung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעילות פיתוח נוער חיובית</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Atividade de desenvolvimento positivo da juventude</skos:altLabel>
    <rdfs:label>Positive Youth Development Activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7p8xRy14cVNnXyHxD92nQk"/>
    <skos:definition>A positive youth development activity is an action or program designed to promote the healthy development and well-being of young people, particularly in areas such as education, social skills, and emotional regulation. This concept is specifically related to the conditions that parents must meet as part of a criminal disposition.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N382a19bf7dc64443a2805e01f0e9f32d">
