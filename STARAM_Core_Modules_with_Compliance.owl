  <rdf:Description rdf:about="https://folio.openlegalstandard.org/lYsj9T1_RyW-EpfsA1WOSA">
    <skos:definition>This industry comprises establishments known as machine shops primarily engaged in machining metal and plastic parts and parts of other composite materials on a job or order basis. Generally machine shop jobs are low volume using machine tools, such as lathes (including computer numerically controlled); automatic screw machines; and machines for boring, grinding, milling, and additive manufacturing.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Machine Shops</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=332710"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/FTCohQRcQH27CzHG7N5rMQ"/>
  </rdf:Description>
