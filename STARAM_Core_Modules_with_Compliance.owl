  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC2sDzkhJsoDium48Imqwn8">
    <skos:definition>The possession of a prohibited weapon refers to the act of having in one's control or ownership a weapon that is illegal to possess under the law, such as a firearm that has been modified to be fully automatic or a weapon that is designed for military use.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9KC6PngzJi80MRTJgJyVad"/>
    <rdfs:subClassOf rdf:nodeID="Nd735fe6705894d6f9cd8be3447ea5540"/>
    <skos:prefLabel>Prohibited Weapon</skos:prefLabel>
    <skos:altLabel xml:lang="zh-cn">持有违禁武器</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">禁止された武器の所持</skos:altLabel>
    <skos:altLabel xml:lang="he-il">בעלות נשק אסור</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक प्रतिबंधित हथियार की हवाले रखना</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Posse de uma arma proibida</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Possession d'une arme prohibée</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Besitz einer verbotenen Waffe</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Possession of a Prohibited Weapon</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Posesión de un arma prohibida</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Posesión de un arma prohibida</skos:altLabel>
    <rdfs:label>Possession of a Prohibited Weapon</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
