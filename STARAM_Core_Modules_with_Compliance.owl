    <rdfs:subClassOf rdf:nodeID="N2be9bef5f49a464a86999aaff682629d"/>
    <rdfs:label>JL10 Advocacy (UK J-CODE)</rdfs:label>
    <skos:definition>Preparation by advocates of written and oral openings, closings or skeleton arguments; preparation for examination of witnesses; preparation of and for all applications made during trial;  considering all submissions of other parties; attendance of advocates during trial.  Includes all dealings by advocates with others (e.g. solicitors, clients, witnesses) for these purposes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
