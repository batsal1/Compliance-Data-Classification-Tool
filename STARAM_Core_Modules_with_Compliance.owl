    <skos:altLabel xml:lang="de-de">Anspruch auf Beendigung der elterlichen Rechte</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Terminación de Derechos Parentales</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de término dos direitos parentais</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de Terminación de Derechos Parentales</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Demande de cessation des droits parentaux</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה לביטול זכויות הוריות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अभिभावक अधिकारों के समाप्ति दावा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Termination of Parental Rights Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">親権の終了請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">终止父母权利申请</skos:altLabel>
    <skos:altLabel>TPR</skos:altLabel>
    <skos:definition>Termination of Parental Rights (TPR) Claim is a legal action taken to permanently end a parent's legal rights and responsibilities towards their child, typically due to abuse, neglect, or abandonment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
