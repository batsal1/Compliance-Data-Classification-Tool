  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/uX98XSUsQwqyaNFuyn-5Gg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>See industry description for 321920.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=32192"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/YFbAUnqXTmaP4s08d8dFfQ"/>
    <rdfs:label>Wood Container and Pallet Manufacturing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDRVyo42lMH12fyHOhE6T6z">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8Xrium2aVaYqlV8F4UZu6u"/>
    <rdfs:label>Counterfeit Identification Management</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Counterfeit Identification Management refers to the process of managing and preventing the production and distribution of fake identification documents, such as passports or driver's licenses, in order to protect intellectual property rights.</skos:definition>
  </rdf:Description>
