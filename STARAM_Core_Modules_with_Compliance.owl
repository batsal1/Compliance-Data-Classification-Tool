  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDJyLaQc804aQ8QTjdAVeqs">
    <skos:altLabel xml:lang="zh-cn">生效条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एनुरमेंट क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'agrément</skos:altLabel>
