  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R1mmZgj9s6vqgxrWeEM82m">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <rdfs:label>Speeding Violation Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A speeding violation claim is an assertion made by a law enforcement officer or traffic camera that a driver has exceeded the posted speed limit. The claim initiates a legal process that may result in penalties, such as fines or points on the driver's license, if the violation is proven or uncontested.</skos:definition>
  </rdf:Description>
