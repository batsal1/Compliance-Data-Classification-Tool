    <skos:altLabel xml:lang="en-gb">Betting / Wagering</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賭博 / 賭け</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Apostas / Apostas</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">赌博 / 投注</skos:altLabel>
