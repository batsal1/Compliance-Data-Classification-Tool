    <skos:altLabel xml:lang="fr-fr">Clause d'éthique</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नैतिकता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">倫理条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Ethics Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ethik-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de ética</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula ética</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אתי</skos:altLabel>
    <skos:definition>An Ethics Clause is a provision in a contract that outlines the ethical standards and principles that the parties agree to abide by during the course of their relationship.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
