  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCR9dUNNWhfQwdzq3isTiY">
    <skos:altLabel xml:lang="pt-br">Negligência per se</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הזנחה פר סה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia Per Se</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违法推定下的疏忽</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法定違反に基づく過失</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia Per Se</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligence Per Se</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence par principe</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नेग्लिजेंस पर से</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit per se</skos:altLabel>
    <rdfs:label>Negligence Per Se</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7nqxxlAfhYqqSA2UQ5UxpX"/>
    <skos:definition>Negligence Per Se is a legal concept that refers to a situation where an action or failure to act violates a law or regulation, and that violation automatically establishes a breach of duty in a negligence case.</skos:definition>
  </rdf:Description>
