  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9FLastlaw370DDJtDV59Ez">
    <skos:altLabel xml:lang="ja-jp">短縮された寿命予測</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Expectativa de vida reducida</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">espérance de vie réduite</skos:altLabel>
