    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#RenewalOption"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RJ2spkLaFKaXIIurB8oqYQ">
    <skos:altLabel xml:lang="zh-cn">可退还押金条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">返金可能な預託金条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Depósito Reembolsable</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Depósito Reembolsável</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de dépôt remboursable</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הפקדה המוחזרת</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Depósito Reembolsable</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Erstattungsfähigkeit von Kautionen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Refundable Deposit Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वापसीय जमा शर्त</skos:altLabel>
    <skos:definition>A refundable deposit clause is a provision in a contract that requires one party to provide a deposit to the other party, which will be returned if certain conditions are met.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Refundable Deposit Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RxKOdwRHKP32r4F1sT7lZ7">
    <skos:altLabel xml:lang="de-de">Unentladbare Schulden</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不可清偿债务</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Deuda no exonerable</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">免責不能債務</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधार्य ऋण</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Dette non déchargeable</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dívida não descartável</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Nondischargeable Debt</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוב לא ניתן לשחרר</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Deuda no cancelable</skos:altLabel>
    <skos:definition>Debt that cannot be eliminated through bankruptcy proceedings, typically including taxes, student loans, and debts incurred through fraud or willful misconduct.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Nda20c08a659340399eb321c0f4d53729"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Nondischargeable Debt</rdfs:label>
  </rdf:Description>
