    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDF1eq4djzA9XExVEr6afNo">
    <skos:altLabel xml:lang="ja-jp">初期マッチング権期間</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Periodo inicial de derechos de emparejamiento</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Initial Matching Rights Period</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Periodo inicial de derechos de emparejamiento</skos:altLabel>
