  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7xetKG7UJNRSImGDq3ssRk">
    <skos:definition>An Accumulation Fund is an investment fund that typically reinvests its investment profits back into the fund, rather than distributing them to shareholders. This reinvestment strategy aims to enhance the fund's value over time, providing potential for capital growth.</skos:definition>
    <skos:altLabel>Growth Fund</skos:altLabel>
    <skos:altLabel>Profit Reinvestment Fund</skos:altLabel>
    <skos:altLabel>Growth Investment Fund</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9I5NnI41F5zvaAiT1AdU7I"/>
    <rdfs:label>Accumulation Fund</rdfs:label>
    <skos:prefLabel>Reinvestment Fund</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
