    <skos:altLabel xml:lang="pt-br">Direito de danos pessoais e responsabilidade civil</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Personenschaden- und Deliktsrecht</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-TORT</ns2:legacyIdentifier>
    <skos:definition>Law which allows an injured person to obtain compensation from the person who caused the injury.</skos:definition>
