  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB2PuT3FuKzNgNP8TeHZaRC">
    <skos:definition>The concept of Receiving Stolen Property refers to the criminal offense of knowingly obtaining or receiving property that has been stolen, with the intent to deprive the rightful owner of their property.</skos:definition>
    <rdfs:label>Receiving Stolen Property</rdfs:label>
    <skos:altLabel xml:lang="ja-jp">盗品受領</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Recel</skos:altLabel>
