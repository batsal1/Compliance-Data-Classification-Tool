  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCVMobXFl279UVXHDF5uZ7f">
    <skos:altLabel xml:lang="es-es">Privilegio absoluto</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Privilégio absoluto</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">绝对特权</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège absolu</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio absoluto</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">絶対特権</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Absolute Immunität</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Absolute Privilege</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्ण विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פריבילגיה אבסולוטית</skos:altLabel>
    <skos:definition>Absolute Privilege: A legal immunity that protects government officials from being held liable for statements made during official proceedings, even if those statements are defamatory or otherwise harmful.</skos:definition>
    <rdfs:label>Absolute Privilege</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvhPeoPwTNYsc19VBpYjSV"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
