  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMcqHIYvRWhQKINP6nEvol">
    <skos:altLabel xml:lang="hi-in">सौदे की घोषणा, विलंब या सम्पन्नता भाषा</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Linguagem de anúncio, pendência ou consumação de negócios</skos:altLabel>
