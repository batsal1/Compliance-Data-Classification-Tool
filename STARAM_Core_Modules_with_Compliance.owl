    <dc:source>Fed. R. Evid. 803(1)</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Present Sense Impression is a statement describing or explaining an event or condition made while or immediately after the declarant perceived it. This hearsay exception is based on the belief that statements made in the moment, without time for reflection or fabrication, are inherently reliable.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ro7NzBFiq6eW3vKMpqpufQ">
    <skos:altLabel xml:lang="es-mx">Preponderancia de la prueba</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Prépondérance des preuves</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">证据优势</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">証拠の優越性</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रमाण का अधिकतम</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Preponderância de Provas</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Preponderancia de la prueba</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כביכול הוכחה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Preponderance of Evidence</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Überwiegendes Beweisergebnis</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDV74m3ydS2I72hZ88Mf1RX"/>
    <rdfs:label>Preponderance of Evidence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Preponderance of Evidence" refers to the burden of proof in a legal case where the party with the greater weight of evidence in their favor will prevail.</skos:definition>
  </rdf:Description>
