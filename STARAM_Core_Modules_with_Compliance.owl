  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RgV54oXgxhf8Ue1aYVdIx9">
    <skos:prefLabel>Primary Drafter</skos:prefLabel>
    <rdfs:label>Responsible Author</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ra6EHlbqrpUT9rxM2PtwIP"/>
    <skos:altLabel>Lead Writer</skos:altLabel>
    <skos:definition>The Responsible Author is the individual accountable for the creation of a document. This person ensures the content's accuracy, completeness, and adherence to an organization's standards (e.g., legal standards, stylistic standards).</skos:definition>
  </rdf:Description>
