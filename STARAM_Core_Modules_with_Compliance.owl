    <rdfs:label>Empty Chair</rdfs:label>
    <skos:definition>The Empty Chair is a legal defense strategy in civil litigation where the defendant is absent from the trial and is not represented by counsel.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
