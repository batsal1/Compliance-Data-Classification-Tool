    <skos:prefLabel>Economic Damages</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Monetary Damages refer to compensation awarded to a party in a legal matter for financial losses or expenses incurred as a result of the actions of another party.</skos:definition>
    <rdfs:label>Monetary Damages</rdfs:label>
  </rdf:Description>
