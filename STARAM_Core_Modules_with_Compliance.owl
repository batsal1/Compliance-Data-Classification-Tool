    <skos:altLabel xml:lang="en-gb">Severability Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de separabilidad</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Trennbarkeitsklausel</skos:altLabel>
