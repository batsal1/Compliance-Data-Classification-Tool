  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7aSm1AVSKBVx8el1HZUrxw">
    <skos:altLabel xml:lang="en-gb">Conflict of Interest Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">利益相反条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Conflicto de Intereses</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हितधर्म विसंगति शर्त</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Vermeidung von Interessenkonflikten</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">利益冲突条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף עימות עניינים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Conflicto de Intereses</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de conflito de interesses</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de conflit d'intérêts</skos:altLabel>
    <skos:definition>A Conflict of Interest Clause is a provision in a contract that requires the parties involved to disclose any potential conflicts of interest that may arise during the course of their relationship.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Conflict of Interest Clause</rdfs:label>
