  <rdf:Description rdf:about="https://folio.openlegalstandard.org/XrslSCybSquf4Pcy8rAFCA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/A8toAtKhS3uW2J9y19lCXQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=483111"/>
    <rdfs:label>Deep Sea Freight Transportation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing deep sea transportation of cargo to or from foreign ports.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8o77OqyndqK7R237rr61yE">
    <skos:altLabel xml:lang="zh-cn">允许合同撤销的不合理性</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Permettre la résiliation du contrat pour iniquité</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אי הגיון מאפשר ביטול חוזה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अयोग्यता अनुबंध रद्दीकरण की अनुमति देना</skos:altLabel>
    <skos:altLabel xml:lang="es-es">La iniquidad que permite la rescisión del contrato</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">La iniquidad que permite la rescisión del contrato</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不合理性による契約解除の許可</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unconscionability Permitting Contract Rescission</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unangemessenheitserlaubnis zur Vertragsaufhebung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Permitir a rescisão do contrato por iniquidade</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDP2t75tSvlsq1GCrOZlInL"/>
    <rdfs:subClassOf rdf:nodeID="Ndd66e885b1df48999952ef69f3a3d146"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:label>Unconscionability Permitting Contract Rescission</rdfs:label>
    <skos:definition>Unconscionability Permitting Contract Rescission refers to the legal concept that allows a contract to be cancelled or voided due to the presence of unfair or oppressive terms or circumstances that make it impossible for one party to fully understand or consent to the agreement.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9e3bf9aca1ad40f180e96640d6a6dee2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasStandardClause"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#AdditionalInsured"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RN3mWlXZUAt07dYsu6tls2">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <skos:altLabel>seeks to achieve</skos:altLabel>
    <skos:definition>"Seeks to Achieve" refers to the act of pursuing a specific legal outcome or objective. This involves drafting, arguing, and advocating for legal legal goals (e.g., preliminary injunction, securing indemnification).</skos:definition>
    <skos:example>Lawyer Seeks to Achieve Preliminary Injunction</skos:example>
    <skos:example>Party Seeks to Achieve Indemnification</skos:example>
    <rdfs:label>seeksToAchieve</rdfs:label>
    <rdfs:label>sali:seeksToAchieve</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:notation>folio:seeksToAchieve</skos:notation>
    <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RlNFgB3TQfMzV26V4V7u4E"/>
  </rdf:Description>
