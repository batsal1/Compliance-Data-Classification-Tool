  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDNDZH2X3OVk6FwdmXYvxqK">
    <skos:altLabel xml:lang="en-gb">Termination Without Cause by the Company Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公司无故终止条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigung ohne Grund durch das Unternehmen Klausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Terminación sin Causa por parte de la Compañía</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कंपनी द्वारा कारण के बिना समाप्ति अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">会社による理由なき解雇条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Terminación sin Causa por parte de la Empresa</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão sem justa causa pela empresa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סיום ללא סיבה על ידי החברה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation sans cause par l'entreprise</skos:altLabel>
    <skos:definition>A Termination Without Cause by the Company Clause is a provision in a contract that allows a company to end the agreement without providing a reason.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Termination Without Cause by the Company Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDSmGRMaYfZ97elBp5tV28A"/>
  </rdf:Description>
