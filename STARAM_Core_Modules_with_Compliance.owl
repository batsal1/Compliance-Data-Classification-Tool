  <rdf:Description rdf:about="https://folio.openlegalstandard.org/kPokteEhQjiUgicu-VvulQ">
    <rdfs:label>Direct Life, Health, and Medical Insurance Carriers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in initially underwriting (i.e., assuming the risk and assigning premiums) annuities and life insurance policies, disability income insurance policies, accidental death and dismemberment insurance policies, and health and medical insurance policies.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=52411"/>
