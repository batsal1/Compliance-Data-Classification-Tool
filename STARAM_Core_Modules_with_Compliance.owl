  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBSewRxgjTh2VhFX6itIoFA">
    <skos:altLabel xml:lang="en-gb">Cheque Bouncing Crime</skos:altLabel>
    <skos:altLabel>Check Bouncing Crime</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schlechter Scheck Kriminalität</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不良支票犯罪</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Crime de chèque sans provision</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bad Cheque Crime</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Crime de cheque sem fundos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不渡り小切手犯罪</skos:altLabel>
    <skos:definition>Knowingly and intentionally writing and/or negotiating checks drawn against insufficient or nonexistent funds.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Nf08f092756834d60a352393a2fbc19e0"/>
    <rdfs:subClassOf rdf:nodeID="N81a7aa57180f4538a1c0a7d422fb51ee"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdfs:label>Bad Check Crime</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R906atF1FPFvNXecNuVymyC">
    <skos:altLabel xml:lang="fr-fr">Clause d'accord complet</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Acuerdo Completo</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Gesamtvereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de acordo integral</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">完全合意条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्ण समझौता धारा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Acuerdo Completo</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הסכם מלא</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Entire Agreement Clause</skos:altLabel>
    <skos:altLabel>Entire Contract Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">完全协议条款</skos:altLabel>
    <skos:definition>An Entire Agreement Clause, also known as an Entire Contract Clause, is a provision in a contract that declares that the written agreement is the complete and final expression of the parties' agreement, and supersedes all prior negotiations and understandings between them.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Entire Agreement Clause</rdfs:label>
  </rdf:Description>
