  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7nYjWxGQdHVUZcYq7nUpSZ">
    <skos:altLabel>Failure to Stop and Give Information</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Darse a la fuga</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פריצה ובריחה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Hit and Run</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fuga de la escena del accidente</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हिट एंड रन</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nd2ad7bdc9110461e918f3160b64982b4"/>
    <rdfs:subClassOf rdf:nodeID="N637d4b7a25a145679a1b891ea877d297"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rj1p7FbFSLxlWfUlSPZxhX"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <skos:definition>The concept of Hit and Run refers to a criminal offense where a person involved in an accident fails to stop and provide information, such as their name and contact details, to the other party involved.</skos:definition>
    <rdfs:label>Hit and Run</rdfs:label>
  </rdf:Description>
