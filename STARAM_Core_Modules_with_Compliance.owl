  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBlWM6X0yqMrb4z4JQYaEP2">
    <skos:altLabel xml:lang="fr-fr">Réclamation au titre du 6ème amendement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">第六修正案索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת התיקון השישי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Sexta Enmienda</skos:altLabel>
    <skos:altLabel>Sixth Amendment Claim</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf den 6. Zusatzartikel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da 6ª Emenda</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Sexta Enmienda</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">6 वीं संशोधन दावा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">6th Amendment Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">第6修正案の主張</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
    <rdfs:label>6th Amendment Claim</rdfs:label>
    <skos:definition>A Sixth Amendment claim is a legal assertion made by a defendant in a criminal case, arguing that their constitutional right to a fair trial, as guaranteed by the Sixth Amendment of the United States Constitution, has been violated. Such a claim may involve issues related to the right to counsel, the right to a speedy and public trial, the right to an impartial jury, or the right to be informed of the nature and cause of the accusation, among others.</skos:definition>
    <skos:prefLabel>Sixth Amendment Claim</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
