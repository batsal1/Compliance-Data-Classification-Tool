    <rdfs:subClassOf rdf:nodeID="N6279bd4c53bd4f5da4ed9c65d5c0cba7"/>
    <skos:altLabel>Land Accumulation</skos:altLabel>
    <skos:altLabel>Land Aggregation</skos:altLabel>
    <skos:prefLabel>Landbanking</skos:prefLabel>
    <rdfs:label>Land Banking</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Land Banking involves the strategic acquisition and holding of parcels of land by individuals, companies, or government entities with the intent of future sale or development. This practice aims to control the use and development of land, often leading to increased land value over time.</skos:definition>
  </rdf:Description>
