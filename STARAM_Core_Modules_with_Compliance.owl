    <skos:altLabel xml:lang="es-mx">Casa de lenocinio</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">淫らな家</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">淫乱之家</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Casa de lenocinio</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुशासहीन घर</skos:altLabel>
    <rdfs:label>Disorderly House</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLvhxz3b1k2IU3MaAgeRtF"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Disorderly House is a type of crime against the public that involves maintaining a dwelling or establishment where illegal activities, such as prostitution or gambling, take place.</skos:definition>
  </rdf:Description>
