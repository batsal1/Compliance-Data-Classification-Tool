    <skos:altLabel xml:lang="zh-cn">账单和付款条款条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Rechnungs- und Zahlungsbedingungen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Términos de Facturación y Pago</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Términos de Facturación y Pago</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बिलिंग और भुगतान शर्तें बंधन</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Billing and Payment Terms Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">請求書および支払条件条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאי חיוב ותשלום</skos:altLabel>
    <rdfs:label>Billing and Payment Terms Clause</rdfs:label>
