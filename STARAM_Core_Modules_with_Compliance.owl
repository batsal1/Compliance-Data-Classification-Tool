  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDDo89IYNYywizH9jSXp6zY">
    <rdfs:label>Unlawful Restraint</rdfs:label>
    <skos:altLabel xml:lang="fr-fr">détention illégale</skos:altLabel>
    <skos:altLabel xml:lang="de-de">ungesetzliche Freiheitsberaubung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवैध रोकथाम</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Detención ilegal</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unlawful Restraint</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非法拘禁</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עיכוב בלתי חוקי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">privação ilegal de liberdade</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Detención ilegal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不法拘束</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Ne9434d8833014c9985ec7acfe9c523b3"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <skos:definition>The concept of Unlawful Restraint refers to the criminal offense of intentionally restricting someone's movement without their consent, and is classified as a misdemeanor offense.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/BbLIn6rZQk2PbmwKSWSv9w">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/bhcIt7ePQoSkVaHfbjWI8Q"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing air transportation of passengers or passengers and freight over regular routes and on regular schedules. Establishments in this industry operate flights even if partially loaded. Scheduled air passenger carriers including commuter and helicopter carriers (except scenic and sightseeing) are included in this industry.</skos:definition>
    <rdfs:label>Scheduled Passenger Air Transportation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=481111"/>
  </rdf:Description>
