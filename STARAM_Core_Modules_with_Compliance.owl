  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBKT7TSvBSVEvxJuaKhCz8P">
    <skos:altLabel xml:lang="zh-cn">工人赔偿歧视索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Diskriminierungsklage wegen Arbeitsunfallentschädigung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על הפרת זכויות עובדים בקבלת פיצויים</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Workers' Compensation Discrimination Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo por discriminación de compensación de trabajadores</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reclamação de discriminação de compensação de trabalhadores</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo por discriminación en compensación de trabajadores</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour discrimination en matière de compensation des travailleurs</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वर्कर्स कंपेंसेशन भेदभाव दावा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">労働者補償差別請求</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RD22PX6hiObnrRSM3c6bXdR"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UnJ8s91KxQbW7GpGgIhsP"/>
    <skos:definition>A workers' compensation discrimination claim is a legal action brought by an employee who alleges that they have been subjected to unfair treatment, retaliation, or adverse actions by their employer due to filing a workers' compensation claim or exercising their rights under workers' compensation laws. Workers' compensation is a system designed to provide medical benefits and wage replacement for employees who suffer work-related injuries or illnesses. Employers are generally prohibited from discriminating or retaliating against employees who seek workers' compensation benefits.</skos:definition>
    <rdfs:label>Workers' Compensation Discrimination Claim</rdfs:label>
  </rdf:Description>
