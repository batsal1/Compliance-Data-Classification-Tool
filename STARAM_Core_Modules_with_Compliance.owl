  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8uPIk7OdU6TA8qkpovKICu">
    <skos:altLabel xml:lang="en-gb">Suit on Sworn Account</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ação de Conta Juramentada</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शपथपूर्वक खाते पर मुकदमा</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">宣誓口座に関する訴訟</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Juicio sobre cuenta jurada</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klage auf Eidkonto</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Action sur compte juré</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">宣誓账户诉讼</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Juicio sobre cuenta jurada</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על חשבון נאמן</skos:altLabel>
    <rdfs:label>Suit on Sworn Account</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <skos:definition>A Suit on Sworn Account is a legal claim that arises from a written statement made under oath by a party who seeks to recover a debt or demand payment for goods or services provided, and is based on a contractual or quasi-contractual relationship between the parties involved.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8KOOEzWFRtQJgpQNRToCPU">
    <skos:altLabel xml:lang="es-es">Negligencia en Medicina Interna</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en Medicina Interna</skos:altLabel>
