  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8zzyMH86cLNMBF93dHt3o3">
    <skos:altLabel xml:lang="en-gb">Waiver of Sovereign Immunity Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור מחסינות ריבונית</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia a la inmunidad soberana</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शासन अधिकार संरक्षण से विवेकाधिकार अस्वीकृति शब्द</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia à imunidade soberana</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">放弃主权豁免条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzicht auf die Klausel der souveränen Immunität</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">主権免除条項の放棄</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a la inmunidad soberana</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation à l'immunité souveraine</skos:altLabel>
    <skos:definition>A Waiver of Sovereign Immunity Clause is a provision in a legal agreement where a government entity agrees to be subject to the jurisdiction of a court or tribunal, thereby waiving its immunity from legal action.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
    <rdfs:label>Waiver of Sovereign Immunity Clause</rdfs:label>
  </rdf:Description>
