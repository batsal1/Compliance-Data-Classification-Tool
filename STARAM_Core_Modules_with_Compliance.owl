  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBs00pxquaGFJOMMwLU9aO9">
    <skos:altLabel xml:lang="zh-cn">伯福德回避原则</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Abstention de Burford</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">बरफोर्ड अव्यवस्था</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abstención de Burford</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Burford Abstention</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Abstención de Burford</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כחול לבן</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Burford-Abstinenz</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">バーフォード棄権</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Abstenção de Burford</skos:altLabel>
    <rdfs:label>Burford Abstention</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RuliWeVDE8CQi4AATMNab1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A legal doctrine known as Burford Abstention allows federal courts to decline jurisdiction over complex state regulatory schemes in order to avoid interfering with state administrative processes.</skos:definition>
  </rdf:Description>
