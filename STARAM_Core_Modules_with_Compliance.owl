  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9KC6PngzJi80MRTJgJyVad">
    <skos:altLabel xml:lang="es-mx">Delitos de Armas, Pistolas y Armas de Fuego</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हथियार, बंदूक और अग्निशस्त्र अपराध</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">武器、銃器、および火器犯罪</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Crimes de armas, armas de fogo e armas de fogo</skos:altLabel>
