  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R93IYJCdKr3BoQolxyKNTC8">
    <skos:prefLabel>Metropolitan Market Segment</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Urban Market Segment</rdfs:label>
    <skos:definition>The urban market segment refers to a group of consumers or businesses located in cities or metropolitan areas, characterized by higher population density and a diverse range of lifestyle and consumption patterns. This segmentation allows businesses to tailor their products and marketing strategies to the specific needs and preferences of urban dwellers, who often have different purchasing behavior compared to rural or suburban consumers.</skos:definition>
    <skos:altLabel>City Market Segment</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RVu433XojPQPseoDXhidgO"/>
  </rdf:Description>
