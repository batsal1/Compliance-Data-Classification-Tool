    <rdfs:subClassOf rdf:nodeID="N8418dfba8d5444fe84b715c83a6ef3f0"/>
    <rdfs:label>Term Life Insurance</rdfs:label>
    <ns1:contractFamily xml:lang="en">Insurance &amp; Risk Transfer</ns1:contractFamily>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Term life insurance is a policy that provides coverage for a specified period, or "term," usually ranging from 10 to 30 years. If the insured individual dies within this term, the death benefit is paid out to the beneficiaries; however, if the term expires and the policyholder is still alive, there is generally no payout.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nabb4e375e73b481d8d1c17f41b96fa68">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermOfAgreement"/>
