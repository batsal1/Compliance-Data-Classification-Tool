  <rdf:Description rdf:about="https://folio.openlegalstandard.org/1n8WzhIBRJuB796TVihXfg">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=5322"/>
    <skos:definition>This industry group comprises establishments primarily engaged in renting personal and household-type goods. Establishments classified in this industry group generally provide short-term rental although in some instances, the goods may be leased for longer periods of time. These establishments often operate from a retail-like or storefront facility.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDqvWcvBcUV4cKSUqlFKc4k"/>
    <rdfs:label>Consumer Goods Rental</rdfs:label>
