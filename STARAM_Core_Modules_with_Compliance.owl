    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Q8Ra8XyYj14cKvu35plq"/>
    <skos:definition>A Payment Terms and Conditions Clause is a provision in a contract that outlines the specific terms and conditions related to payment, including the amount, timing, and method of payment.</skos:definition>
    <rdfs:label>Payment Terms and Conditions Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
