    <skos:example>Office building construction</skos:example>
    <skos:example>School building construction</skos:example>
    <skos:example>Religious building (e.g., church, synagogue, mosque, temple) construction</skos:example>
    <skos:example>Hotel construction</skos:example>
    <skos:example>Radio and television broadcast studio construction</skos:example>
    <skos:example>Data center construction</skos:example>
    <skos:example>Prison construction</skos:example>
    <skos:example>Barrack construction</skos:example>
    <skos:example>Airport building construction</skos:example>
    <rdfs:label>Commercial and Institutional Building Construction</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/_QvLi3Q_R4y2DAKa4oKiLg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=236220"/>
    <skos:definition>This industry comprises establishments primarily responsible for the construction (including new work, additions, alterations, maintenance, and repairs) of commercial and institutional buildings and related structures, such as stadiums, grain elevators, and indoor swimming facilities. This industry includes establishments responsible for the on-site assembly of modular or prefabricated commercial and institutional buildings. Included in this industry are commercial and institutional building general contractors, commercial and institutional building for-sale builders, commercial and institutional building design-build firms, and commercial and institutional building project construction management firms.</skos:definition>
  </rdf:Description>
