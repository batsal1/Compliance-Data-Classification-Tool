  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RRTsPoZhucp80NJy00WHwY">
    <skos:prefLabel>Proportional Voting System</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A proportional electoral system is a voting method designed to allocate seats in a legislative body in proportion to the number of votes each party or candidate receives. This system aims to create a representative body that mirrors the overall distribution of public support, promoting fairer and more inclusive representation.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7OQ65vKuOBSSGgSVYnoMfx"/>
    <rdfs:label>Proportional Electoral System</rdfs:label>
  </rdf:Description>
