  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8OYDhDoTNCMNQHheM1epQY">
    <skos:altLabel xml:lang="es-mx">Reformulación de Contrato</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अनुबंध सुधार</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תיקון חוזה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Rectificación de Contrato</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同重订</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約再締結</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réformation de contrat</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vertragsreformation</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reforma de contrato</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Contract Rectification</skos:altLabel>
    <skos:definition>The concept of Contract Reformation refers to the legal remedy of modifying or changing the terms of a contract in order to correct a mistake or address an unfair situation, and is a type of equitable relief.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9iUJ1YX0zK3V9D0RbQKTP4"/>
    <rdfs:subClassOf rdf:nodeID="N8c67b6878c7c4fca872a9614641979ec"/>
    <rdfs:label>Contract Reformation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
