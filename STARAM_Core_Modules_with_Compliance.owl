  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8A4jLWkG2KpI6wfAznsSCx">
    <skos:altLabel>Judicial Reduction In Damages</skos:altLabel>
    <skos:altLabel>Court-Ordered Damages Decrease</skos:altLabel>
    <skos:altLabel>Decreased Damages Award</skos:altLabel>
    <rdfs:label>Remittitur</rdfs:label>
    <skos:definition>Remittitur refers to a court's power to reduce the amount of damages awarded by a jury if the judge finds the award excessive. This practice is used to prevent the need for a new trial by offering the plaintiff the option to accept a lower amount.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="N05027791c69047919471027d422c8163"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbz1PVc6y57oOb9jAIl0eN"/>
