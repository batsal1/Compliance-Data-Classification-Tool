  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCGquLtBt00CMIRpIU9jQqB">
    <skos:definition>Involuntary commitment to a mental health facility is a legal process where an individual is mandated to be admitted to a psychiatric hospital or clinic against their will. This typically occurs when the individual poses a significant risk to themselves or others due to a mental disorder, and the decision is often based on medical evaluations and established legal criteria.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDmZbwmBBKWQ3vGof1sh1kB"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Involuntary Commitment to a Mental Health Facility</rdfs:label>
  </rdf:Description>
