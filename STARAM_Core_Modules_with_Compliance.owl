    <rdfs:label>Finfish Farming and Fish Hatcheries</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDp74c34xALuehr10JADSM2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="pt-br">Processo de perdão</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Procedimiento de Indulto</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הליך חנינה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Begnadigungsverfahren</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Procédure de grâce</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Procedimiento de Perdón</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pardon Proceeding</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">क्षमा प्रक्रिया</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">恩赦手続き</skos:altLabel>
