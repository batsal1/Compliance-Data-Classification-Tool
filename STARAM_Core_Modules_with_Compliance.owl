  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDrxLQS4WPXUa6tUdBGdu2r">
    <skos:altLabel xml:lang="zh-cn">义务分析</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Análisis de Obligaciones</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Análise de obrigações</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Obligation Analysis</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Analyse des obligations</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">義務分析</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ניתוח חובה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिकार विश्लेषण</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Análisis de Obligaciones</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verpflichtungsanalyse</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <skos:definition>Obligation Analysis is the process of examining and evaluating the legal responsibilities and duties of a debtor in a bankruptcy or financial restructuring matter, including the analysis of various considerations such as vendor agreements, utilities, securities reporting, liens, financial reports, insurance, cash usage, debt agreements, dischargeability, employee benefits, pensions, and environmental issues.</skos:definition>
    <rdfs:label>Obligation Analysis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8zg84LgAVaA5kh6qaU6yKb">
    <skos:altLabel xml:lang="ja-jp">倉庫業者または運送業者による貨物の留置権</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेयरहाउसमैन या कैरियर वस्तुओं पर लियन</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">仓库人或承运人对货物的留置权</skos:altLabel>
    <skos:altLabel xml:lang="he-il">גילוי זכות מעצר על סחורות על ידי מחסנאי או מוביל</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Lagerhalter- oder Frachtführerpfandrecht an Waren</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Gravamen del almacenista o transportista sobre las mercancías</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Gravamen del almacenista o transportista sobre las mercancías</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège du magasinier ou du transporteur sur les marchandises</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Penhor do armazenador ou transportador sobre mercadorias</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Warehouseman or Carrier Lien on Goods</skos:altLabel>
    <rdfs:label>Warehouseman or Carrier Lien on Goods</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
    <skos:definition>A Warehouseman or Carrier Lien on Goods is a legal concept that allows a person or entity who stores or transports goods to have a legal claim on those goods until they receive payment for their services.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9F6Ub2gHtsF9q8OgGUTqWw">
    <skos:altLabel xml:lang="de-de">Überlegenes Angebot - Mindestens erforderliche Menge an Aktien</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Offre supérieure - Quantité minimale nécessaire d'actions</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Superior Offer - Minimum Necessary Amount of Stock</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उत्कृष्ट पेशकश - न्यूनतम आवश्यक शेयरों की राशि</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Oferta superior - Quantidade mínima necessária de ações</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצעה עליונה - כמות מינימלית נדרשת של מניות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">优越报价-最少必要股票数量</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">優れたオファー-最小必要株数</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Oferta superior - cantidad mínima necesaria de acciones</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Oferta superior - cantidad mínima necesaria de acciones</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Superior Offer - Minimum Necessary Amount of Stock</rdfs:label>
    <skos:definition>A "Superior Offer - Minimum Necessary Amount of Stock" is a threshold concept in a legal matter that refers to the minimum amount of stock required for an offer to be considered superior to another offer.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R951hKkSGUrKhm07RqJ1hDc"/>
  </rdf:Description>
