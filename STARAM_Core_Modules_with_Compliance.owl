  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMFG9JGby2DHjcvNy6JP27">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDnJ5pHeJZuA0vHQXYalZO6"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDxvjss5OK7lnAY9w2RaGeB"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9kHJwRBkXjBRaeSNiyPWY"/>
    <skos:altLabel xml:lang="es-es">Contrario a los deberes fiduciarios</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फिडुशियरी कर्तव्यों के साथ 'असंगत' भाषा</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Inconsistente con los deberes fiduciarios</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">'Incohérent' avec les devoirs fiduciaires</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">受託義務に矛盾する</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">'Inconsistente' com deveres fiduciários</skos:altLabel>
    <skos:altLabel xml:lang="de-de">'Inkonsistent' mit Treuepflichten</skos:altLabel>
    <skos:altLabel xml:lang="he-il">'לא עקבי' עם חובות פידוסיאריות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">'Inconsistent' with fiduciary duties</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">与受托责任不一致</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>"'Inconsistent' with fiduciary duties" Language</rdfs:label>
    <skos:definition>Language used in a legal document that describes actions or events that would violate a party's fiduciary duties, specifically in relation to a no-shop covenant, an intervening event, or a superior offer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBqBxJEzhWW5x12JraZHgQd">
    <skos:altLabel xml:lang="hi-in">मुख संबंध</skos:altLabel>
