    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A buy back option clause is a provision in a contract that allows one party to repurchase property or assets from the other party at a predetermined price and time.</skos:definition>
  </rdf:Description>
