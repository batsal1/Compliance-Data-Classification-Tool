    <skos:altLabel xml:lang="zh-cn">联邦证据规则</skos:altLabel>
    <rdfs:label>Federal Rules of Evidence</rdfs:label>
    <skos:definition>U.S. federal courts' procedural rules governing the use of evidence.</skos:definition>
