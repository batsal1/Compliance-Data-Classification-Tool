    <skos:altLabel xml:lang="de-de">Unabhängiger Ausschuss</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">独立委员会</skos:altLabel>
    <skos:altLabel>Independent Committee</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Comité Independiente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独立委員会</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वतंत्र समिति</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Independent Committee</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Comitê independente</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-INCO</ns2:legacyIdentifier>
    <rdfs:label>Independent Committee</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:nodeID="N00fa654243b54815834a91d102a294a7"/>
    <rdfs:subClassOf rdf:nodeID="Na077d6494e7c48b7b7472a5f9719c9e9"/>
    <rdfs:subClassOf rdf:nodeID="N296d8293176b4c65a718cafbb76f0928"/>
    <skos:hiddenLabel>INCO</skos:hiddenLabel>
    <dc:identifier>INCO</dc:identifier>
    <skos:definition>An independent committee is a group of people assembled to conduct an activity independent of the management of a company, often in connection with an internal investigation or approval of an interested party transaction. Also known as a "special committee."</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
