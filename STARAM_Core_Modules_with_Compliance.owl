  <rdf:Description rdf:about="https://folio.openlegalstandard.org/vqSWMMSFSheZALehwOczUA">
    <rdfs:label>Computing Infrastructure Providers, Data Processing, Web Hosting, and Related Services</rdfs:label>
    <skos:example>Computing platform infrastructure provision</skos:example>
    <skos:example>Application hosting</skos:example>
    <skos:example>Infrastructure as a service (IaaS)</skos:example>
    <skos:example>Computer data storage services</skos:example>
    <skos:example>Optical scanning services</skos:example>
    <skos:example>Platform as a service (PaaS)</skos:example>
    <skos:example>Web hosting</skos:example>
    <skos:example>Cloud storage services</skos:example>
    <skos:example>Video and audio technical streaming support services</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=518210"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/gQ5-x_LgT1Sq3-WCNHDHLg"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing computing infrastructure, data processing services, Web hosting services (except software publishing), and related services, including streaming support services (except streaming distribution services). Data processing establishments provide complete processing and specialized reports from data supplied by clients or provide automated data processing and data entry services.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBl014893nVYWtogWXLr9ot">
