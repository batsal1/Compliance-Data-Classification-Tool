    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-PART-LTDP</ns2:legacyIdentifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9oT1uDgFl2wSjoa358Wowx"/>
    <skos:definition>A limited partner is a part-owner of a company whose liability for the firm's debts cannot exceed the amount that individual invested in the company. Limited partners are often called silent partners.</skos:definition>
