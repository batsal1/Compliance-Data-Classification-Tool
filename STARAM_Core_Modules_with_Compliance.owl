    <rdfs:label>tk_rate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbP2hC5iPogaZjkx1uaECq"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>"The hourly rate of the timekeeper.  

It is possible for a timekeeper to bill at more than one tk_level hourly rate during a given invoice period.
  "</skos:definition>
