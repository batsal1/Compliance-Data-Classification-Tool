    <skos:altLabel xml:lang="es-mx">Cláusula de relación con contratistas independientes</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף יחסי עצמאיות עם קבלן</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Independent Contractor Relationship Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">独立承包商关系条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de relación con contratistas independientes</skos:altLabel>
    <skos:definition>An Independent Contractor Relationship Clause is a provision in a contract that outlines the legal relationship between a company and an independent contractor, specifying that the contractor is not an employee and is responsible for their own taxes and benefits.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Independent Contractor Relationship Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RmGWxkvj4y9mflPYYkZgFo"/>
  </rdf:Description>
