    <skos:altLabel xml:lang="en-gb">Receivership Appointments</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מינויי מקבלי הנהלה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Nombramientos de administrador judicial</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">受益者管理人の任命</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Nomeação de administrador judicial</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Nombramientos de síndico</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रिसीवरशिप नियुक्तियाँ</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">接管任命</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Nomination d'un administrateur judiciaire</skos:altLabel>
    <skos:definition>The concept of "Receivership Appointments" refers to the legal process of appointing a third-party receiver to manage and oversee the assets and affairs of a company or individual in financial distress, as a provisional remedy or appointment.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RFXc2NtinmfJhHDBnbVgVN"/>
    <rdfs:subClassOf rdf:nodeID="N067b6f0b41ad4898bcda44e9b9f2028e"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Receivership Appointments</rdfs:label>
  </rdf:Description>
