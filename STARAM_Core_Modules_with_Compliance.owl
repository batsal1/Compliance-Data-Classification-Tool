  <rdf:Description rdf:about="https://folio.openlegalstandard.org/KQtNCyyWSIqeLBviX2FxqA">
    <rdfs:label>General Automotive Repair</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=811111"/>
    <skos:example>General automotive repair shops</skos:example>
    <skos:example>Automobile repair garages (except gasoline service stations)</skos:example>
    <skos:example>Automotive engine repair and replacement shops</skos:example>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing (1) a wide range of mechanical and electrical repair and maintenance services for automotive vehicles, such as passenger cars, trucks, and vans, and all trailers or (2) engine repair and replacement.</skos:definition>
