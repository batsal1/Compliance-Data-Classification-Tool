    <skos:altLabel xml:lang="ja-jp">経済利益防衛</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגנת התנאים הכלכליים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Defensa de los Intereses Económicos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">经济利益防御</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Defensa de los Intereses Económicos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Economic Interest Defense</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Defesa do interesse econômico</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आर्थिक हित रक्षा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verteidigung des wirtschaftlichen Interesses</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défense de l'intérêt économique</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:subClassOf rdf:nodeID="N74fcba7146e34c348de3e594c363b3d9"/>
    <rdfs:label>Economic Interest Defense</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A legal defense used in civil litigation that argues that the actions taken by a party were in the best interest of their economic well-being.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB9DoLZunyUmcyGrXE6BMQ">
    <rdfs:label>Account Stated</rdfs:label>
    <skos:altLabel xml:lang="de-de">Kontostand angegeben</skos:altLabel>
