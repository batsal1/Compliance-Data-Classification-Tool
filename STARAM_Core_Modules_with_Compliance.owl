  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDRZ05RUD0ScNOff4djBSTw">
    <skos:altLabel xml:lang="pt-br">Regras de Arbitragem do Consumidor da AAA</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Règles d'arbitrage des consommateurs de l'AAA</skos:altLabel>
    <skos:altLabel xml:lang="de-de">AAA Verbraucher-Schiedsgerichtsordnung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">AAA消費者仲裁規則</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">AAA消费者仲裁规则</skos:altLabel>
    <skos:definition>The AAA Consumer Arbitration Rules are a set of guidelines and procedures established by the American Arbitration Association for resolving disputes between consumers and businesses through arbitration.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7uzfpLbCGc2taU7nsJBuor"/>
    <rdfs:label>AAA Consumer Arbitration Rules</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/JlkNKwL5SuWqttGfmu5aJw">
    <rdfs:label>All Other Miscellaneous Schools and Instruction</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=611699"/>
    <skos:example>Speed reading instruction</skos:example>
    <skos:example>Public speaking training</skos:example>
    <skos:example>Survival training</skos:example>
    <skos:example>Yoga instruction, camps or schools</skos:example>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in offering instruction (except academic schools, colleges, and universities; business, computer, and management instruction; technical and trade instruction; and fine arts, sports, recreation, language, exam preparation, tutoring, and automobile driving instruction).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ZPOZN-AIQOG6rXrpt2o7mA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R521qAP3nT6dy1GiNVvs1v">
    <skos:altLabel xml:lang="hi-in">जुआ उपकरण उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Infracciones de equipos de juego</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Gambling Equipment Violations</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ギャンブル機器の違反行為</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">赌博设备违规行为</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violations d'équipement de jeu</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violações de equipamentos de jogos de azar</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרות ציוד הימורים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verstöße gegen Glücksspielgeräte</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Violaciones de equipos de juego</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>To unlawfully manufacture, sell, buy, possess, or transport equipment, devices, and/or goods used for gambling purposes.</skos:definition>
