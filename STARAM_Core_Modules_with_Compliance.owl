  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBp6ukavb46WrACVgxJmmBy">
    <skos:altLabel xml:lang="ja-jp">債務者が債権者に対して資産について嘘をつく</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נעצר כוחו של החייב לגבי הנכסים שלו</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Deudor mintiendo al acreedor sobre sus activos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Deudor mintiendo al acreedor sobre sus activos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Devedor mentindo para o credor sobre ativos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">债务人对债权人关于资产的谎言</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऋणदाता के बारे में ऋणार्थी धन से झूठ बोलना</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Débiteur mentant au créancier à propos des actifs</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Debtor Lying to Creditor About Assets</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schuldner lügt gegenüber Gläubiger über Vermögenswerte</skos:altLabel>
    <rdfs:label>Debtor Lying to Creditor About Assets</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:subClassOf rdf:nodeID="N93c2839ca8b44b22a3f0a505c14f6f67"/>
    <rdfs:subClassOf rdf:nodeID="N06af7840c08a4829ad77675c4d61e661"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Debtor Lying to Creditor About Assets" refers to the act of a debtor intentionally providing false information to a creditor regarding their assets in order to deceive them and avoid paying their debts.</skos:definition>
  </rdf:Description>
