  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7iV1A8QEls3ziKhdKt6oFg">
    <rdfs:label>Diversity  Jurisdiction</rdfs:label>
    <rdfs:label>Diversity Jurisdiction</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Diversity Jurisdiction</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विविधता अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שפט תחומי דיברסיטה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Jurisdicción por Diversidad</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Jurisdicción por Diversidad</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/ReswYRsH8IbmoE68QpgOCd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Diversity Jurisdiction refers to the authority of a federal court to hear a case between parties from different states or countries, where the amount in controversy exceeds a certain threshold.</skos:definition>
  </rdf:Description>
