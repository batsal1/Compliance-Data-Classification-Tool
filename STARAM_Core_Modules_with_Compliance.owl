  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rjk1f9sZl1EGPe1jaAcyG">
    <rdfs:label>Information and Participation Rights</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBJlYzE4ZY14dTEghzbbMHg"/>
    <skos:definition>Information and Participation Rights refer to the entitlements that allow individuals to access information held by public bodies and to participate in decision-making processes that affect their lives. These rights are often enshrined in international environmental agreements like the Aarhus Convention, as well as national laws, and aim to enhance transparency, accountability, and public involvement in governance.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
