  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R952ghaje9ugDR4ZiuhF75a">
    <skos:altLabel xml:lang="en-gb">Contributory Copyright Infringement</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת זכויות יוצרים על-ידי תרומה</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同著作権侵害</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Infracción de derechos de autor por contribución</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Contrefaçon de droit d'auteur contributive</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">共同侵权</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">योगदानकारी कॉपीराइट उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação contributiva de direitos autorais</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Infracción de derechos de autor por contribución</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Mitwirkende Urheberrechtsverletzung</skos:altLabel>
    <rdfs:label>Contributory Copyright Infringement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xzICx2jmaNf0lhp5OGKx"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Contributory Copyright Infringement is a legal concept that holds a party liable for knowingly facilitating or encouraging another party's infringement of a copyright owner's exclusive rights.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDW3J82S0DDEwC7sGGFxCem">
    <skos:altLabel xml:lang="es-es">Deudor en posesión</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schuldner in Eigenverwaltung</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נשים בעלות חוב</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Debtor-In-Possession</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Deudor en posesión</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Devedor em posse</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自己破産手続中の債務者</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Débiteur en possession</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">财务状况良好的债务人</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">देब्टर-इन-पॉसेशन</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:hiddenLabel>DBIP</skos:hiddenLabel>
    <dc:identifier>DBIP</dc:identifier>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77pHybcEdlO9OmqSuiyWi1"/>
    <rdfs:label>Debtor-In-Possession</rdfs:label>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#PlayR-DBIP</ns2:legacyIdentifier>
    <skos:definition>A debtor in possession in United States bankruptcy law is a person or corporation who has filed a bankruptcy petition, but remains in possession of property upon which a creditor has a lien or similar security interest.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RSHYQbtLmQEohpuZo4FG2I">
    <rdfs:subClassOf rdf:nodeID="Nbc592099e212425692b987a3e1085dd3"/>
    <rdfs:subClassOf rdf:nodeID="Nb4064723d7034f289ed9a1299144c6e9"/>
    <rdfs:subClassOf rdf:nodeID="N59c095c43de44500bece48517841641c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R723CZDeI1c9CzFdyGi58Xd"/>
    <skos:definition>Action primarily based on personal injury or death caused by negligence or intentional misconduct, including suits brought against the United States under the Federal Tort Claims Act, and which cannot be classified under any other nature of suit.</skos:definition>
    <rdfs:label>360 Other Personal Injury (PACER NoS)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
