  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Cj1A31dy70CbB8b6Uzqh9">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RhUwaBjg0AFfnJkZgYorpG"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZCEI45ZCUwAdUrivSEF1l"/>
    <skos:altLabel xml:lang="zh-cn">创业买家</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Entrepreneurial Buyer</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Acheteur entrepreneur</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उद्यमी खरीदार</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unternehmerischer Käufer</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">起業家バイヤー</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Comprador Emprendedor</skos:altLabel>
    <skos:altLabel xml:lang="he-il">קונה יזמותי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Comprador empreendedor</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Comprador Emprendedor</skos:altLabel>
    <skos:definition>An entrepreneurial buyer is an individual or entity that engages in mergers and acquisitions with the primary goal of acquiring a business to actively manage and grow. These buyers often possess industry-specific knowledge, skills, or experience that enable them to identify opportunities and add value to the target company. Unlike financially driven buyers who focus mainly on generating financial returns, entrepreneurial buyers are more likely to take a hands-on approach, seeking to build and develop the acquired business for the long term, often driven by a strategic vision or passion for the industry.</skos:definition>
    <rdfs:label>Entrepreneurial Buyer</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RFJ69YSKEGMCQh0emzDcu0">
    <skos:altLabel xml:lang="en-gb">Firm Associate</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שותף במשרד</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Collaborateur de cabinet</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Asociado de la firma</skos:altLabel>
