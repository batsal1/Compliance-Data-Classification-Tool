    <skos:altLabel xml:lang="fr-fr">Accord de non-dénigrement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">不贬低协议</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם אי הפגנה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Acuerdo de no denigración</skos:altLabel>
