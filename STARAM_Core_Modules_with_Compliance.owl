  <rdf:Description rdf:about="https://folio.openlegalstandard.org/zsRJsDRFRTWise5EO9WWIA">
    <skos:definition>This industry group comprises establishments primarily engaged in the merchant wholesale distribution of (1) a general line of groceries; (2) packaged frozen food; (3) dairy products; (4) poultry and poultry products; (5) confectioneries; (6) fish and seafood; (7) meats and meat products; (8) fresh fruits and vegetables; and (9) other grocery and related products.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Grocery and Related Product Merchant Wholesalers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB9cei2GHUCqSsSwdI0ySs"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=4244"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9qtOzWmov77zTz4rUCNAKr">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R72p6HAKCuvyIWvgxuoCM9R"/>
    <rdfs:label>Organizational Board Roles</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Board Governance Roles</skos:altLabel>
    <skos:altLabel>Board Leadership Roles</skos:altLabel>
    <skos:definition>Organizational Board Roles refer to the positions and responsibilities assigned to individuals on a board of directors, including governance, oversight, and strategic planning functions. These roles are designed to ensure effective leadership, compliance, and decision-making within an organization.</skos:definition>
    <skos:prefLabel>Board Positions</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB2H8xm2swMJKtPG37C7mMR">
    <skos:example>Financial Regulation Unit</skos:example>
    <skos:example>Telecommunications Regulation Unit</skos:example>
    <skos:example>Environmental Regulation Unit</skos:example>
    <skos:example>Health and Safety Regulation Unit</skos:example>
    <rdfs:label>Governmental Regulatory Law Division</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBt449Gy4YQBuVqNLxE7Gg"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Governmental Regulatory Law Division is a governmental entity responsible for creating, implementing, and enforcing regulations. It ensures compliance with laws and regulations, provides guidance to regulatory agencies, and represents the government in regulatory matters</skos:definition>
    <skos:altLabel>Regulatory Law Division</skos:altLabel>
  </rdf:Description>
