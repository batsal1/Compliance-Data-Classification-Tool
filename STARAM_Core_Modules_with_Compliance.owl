  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7xmPX9pj9KdiRWgSiw76Ys">
    <skos:altLabel xml:lang="en-gb">Effective Tangible Net Worth Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Patrimonio Neto Tangible Efectivo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Patrimônio Líquido Tangível Efetivo</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">有效有形净值条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">有効な有形純資産条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ערך נטו מוחשי יעיל</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de valeur nette tangible effective</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Patrimonio Neto Tangible Efectivo</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रभावी वास्तविक नेट वर्थ क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Effektive materielle Eigenkapitalklausel</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>An Effective Tangible Net Worth Clause is a provision in a contract that requires a party to maintain a certain level of tangible assets in relation to their liabilities, in order to ensure their financial stability and ability to fulfill their obligations under the contract.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Effective Tangible Net Worth Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R1JCxSoGFz6WAdQbXNIwUa">
    <skos:altLabel xml:lang="es-mx">Reclamo de la Decimotercera Enmienda</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da 13ª Emenda</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">13条修正案の主張</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">第十三修正案索赔</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Decimotercera Enmienda</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation fondée sur le 13ème amendement</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">13th Amendment Claim</skos:altLabel>
    <skos:altLabel>Slavery Amendment Claim</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת התיקון השלישי עשר</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">13वीं संशोधन दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf den 13. Verfassungszusatz</skos:altLabel>
    <rdfs:label>13th Amendment Claim</rdfs:label>
    <skos:definition>A Slavery Amendment claim is a legal assertion pertaining to the Thirteenth Amendment of the United States Constitution, which abolished slavery and involuntary servitude, except as punishment for a crime. This amendment represents a fundamental change in the nation's legal and social framework. A claim involving this amendment could arise in cases involving forced labor, human trafficking, or other situations where an individual's freedom is unjustly restricted or exploited.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MGQ9xUx0PxGLp5yxprdpZ"/>
  </rdf:Description>
