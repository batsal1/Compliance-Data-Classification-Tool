    <skos:altLabel xml:lang="fr-fr">Antitrust - Réclamations de fixation des prix verticaux</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - वर्टिकल मूल्य ठेकेदारी दावे</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de fijación de precios verticales</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações de Fixação de Preços Verticais</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反垄断 - 垂直价格固定索赔</skos:altLabel>
