  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCafxux1zDpXGZzqVBKNVpa">
    <skos:prefLabel>Trustworthy Artificial Intelligence</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R88m06glAkTkIFNVlAF30zy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Trustworthy Machine Intelligence</skos:altLabel>
    <skos:definition>AI Trustworthiness refers to the degree of confidence that users and stakeholders can have in an AI system's ability to perform its intended functions reliably, safely, and ethically. It encompasses various attributes such as fairness, transparency, accountability, and robustness, ensuring that AI systems operate in a manner aligned with societal values and ethical standards.</skos:definition>
    <rdfs:label>AI Trustworthiness</rdfs:label>
  </rdf:Description>
