  <rdf:Description rdf:about="https://folio.openlegalstandard.org/VLN3qLhtQCSfxIexmyuwvA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/42SQEIlkSua466-FrBCwSA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=221210"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises: (1) establishments primarily engaged in operating gas distribution systems (e.g., mains, meters); (2) establishments known as gas marketers that buy gas from the well and sell it to a distribution system; (3) establishments known as gas brokers or agents that arrange the sale of gas over gas distribution systems operated by others; and (4) establishments primarily engaged in transmitting and distributing gas to final consumers.</skos:definition>
    <rdfs:label>Natural Gas Distribution</rdfs:label>
  </rdf:Description>
