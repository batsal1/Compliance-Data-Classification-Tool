  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBKTWRbwGg6abugwd5wdta9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Mother and Child Health Public Benefit refers to specialized government programs aimed at providing healthcare services or financial assistance specifically for mothers and their children. These may cover prenatal care, childbirth, postnatal care, and pediatric services to ensure the health and well-being of both mother and child. In the United States, one such program is the Children's Health Insurance Program (CHIP).</skos:definition>
    <skos:prefLabel>Children's Health Insurance Programs (CHIP)</skos:prefLabel>
    <rdfs:label>Mother and Child Health Public Benefit</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCJp6a5TjeoT3FpwDKff9ux"/>
  </rdf:Description>
