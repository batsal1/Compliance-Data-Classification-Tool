  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBXHQl8XE3Va1jIhoYPJHXn">
    <skos:altLabel xml:lang="fr-fr">Clause de garantie de performance</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de garantía de desempeño</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de garantía de rendimiento</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de garantia de desempenho</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रदर्शन वारंटी क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Performance Warranty Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Leistungsgarantieklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">性能保証条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">性能保证条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף אחריות ביצועים</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8hyVs9MsMpcl891lEFtGTg"/>
    <rdfs:label>Performance Warranty Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Performance Warranty Clause is a type of Warranty Clause that guarantees the quality and functionality of a product or service for a specific period of time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RdCJd93cSeUss1HJN1FovI">
    <skos:altLabel xml:lang="en-gb">Order of Precedence Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סדר קדימות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de orden de precedencia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पूर्वाधिकार क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rangfolgeklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">优先顺序条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de orden de precedencia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de ordem de precedência</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">優先順位条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de précédence</skos:altLabel>
    <skos:definition>An Order of Precedence Clause is a provision in a contract that establishes the hierarchy of conflicting terms and conditions within the agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Order of Precedence Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
