  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8FwwQCxjXscph6A648XjFJ">
    <skos:prefLabel>Nonsyndicated Loan</skos:prefLabel>
    <rdfs:label>Whole Loan</rdfs:label>
    <skos:example>Nonsyndicated Bond Issue</skos:example>
    <skos:example>Nonsyndicated Loan Agreement</skos:example>
    <skos:altLabel>Direct Loan</skos:altLabel>
    <skos:altLabel>Single-Lender Loan</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UcujGuJ216ZiqT4I2aRge"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>a Whole Loan (also known as a Nonsyndicated Loan) refers to a loan or financial arrangement that is provided by a single lender or investor, rather than a group of lenders or investors. This type of arrangement typically involves direct negotiations and agreements between the borrower and the lender.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N36909ebeaf2c416ca279a3bc12e3548f">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RDtFkLR3v97fran5zQ3ugao"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
