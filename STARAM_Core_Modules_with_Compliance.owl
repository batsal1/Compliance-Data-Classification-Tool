    <skos:altLabel xml:lang="he-il">קשר פידוציארי</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fiduciary Relationship</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Relação fiduciária</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Relation fiduciaire</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Relación fiduciaria</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Fiduciary Relationship</rdfs:label>
    <skos:definition>A fiduciary relationship is a legal relationship in which one party is entrusted with the care and management of another party's assets or interests, and is obligated to act in the best interests of the other party, with loyalty, honesty, and good faith.</skos:definition>
  </rdf:Description>
