  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8br7fZje4Dnk3sjGST73nE">
    <skos:prefLabel>Electoral Suppression Claim</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R76IAKqsqXlLQRs21W91S5o"/>
    <rdfs:label>Voter Suppression Claim</rdfs:label>
    <skos:altLabel>Voting Obstruction Complaint</skos:altLabel>
    <skos:altLabel>Voter Disenfranchisement Allegation</skos:altLabel>
    <skos:altLabel>Electoral Disenfranchisement Claim</skos:altLabel>
    <skos:definition>A Voter Suppression Claim refers to an allegation that actions were taken to intentionally prevent or discourage certain groups of people from voting. This can include tactics such as stringent voter ID laws, closing polling places in certain areas, purging voter rolls, or disseminating false information about voting procedures.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Wy4X3LyoQx6HlJmAPuW2DQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/o-fq_eggQHqmcPpdATmBUQ"/>
    <skos:definition>This industry comprises establishments primarily engaged in supplying, on a rental or contract basis, laundered items, such as uniforms, gowns and coats, table linens, bed linens, towels, clean room apparel, and treated mops or shop towels.</skos:definition>
    <rdfs:label>Linen and Uniform Supply</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81233"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
