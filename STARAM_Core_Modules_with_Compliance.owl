    <skos:altLabel xml:lang="pt-br">Direito Educacional</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">教育法</skos:altLabel>
    <skos:altLabel>Education Law</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">教育法</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit de l'éducation</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Bildungsrecht</skos:altLabel>
    <dc:identifier>IN-LAW-11</dc:identifier>
    <dc:identifier>EDUC</dc:identifier>
    <skos:hiddenLabel>EDUC</skos:hiddenLabel>
    <rdfs:label>Education Law</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Education Law</skos:prefLabel>
    <skos:definition>The body of state and federal law that covers teachers, schools, school districts, school boards, and the students they teach.</skos:definition>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Law.json</dc:source>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-EDUC</ns2:legacyIdentifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9kuXMvqzY34vaeAdTSaPxW">
    <skos:definition>Taxes Representation is a provision in merger and acquisition agreements where the selling party attests to the accuracy and completeness of the target entity's tax returns, payments, and compliance with all applicable tax laws and regulations. It serves to assure the buyer that the target company has no undisclosed tax liabilities or issues, and that all tax obligations up to the date of the agreement have been appropriately addressed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Taxes Representation</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N0018226f78e647d497fc7d31abc3cf9f"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rCNhUCohkUGbQyd1C3uzz"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN">
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">弃权条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzichtsklausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वेवर क्लॉज</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A waiver clause is a provision in a contract that relinquishes a party's right to assert a particular legal claim or defense.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Waiver Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncf9666c46fef4d9e98d0ec6fceb03019">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
