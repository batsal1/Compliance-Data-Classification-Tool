  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7fCP2EQY8XQ5fxqiYaKPQA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <skos:altLabel>Unsuitable Content</skos:altLabel>
    <skos:altLabel>Objectionable Material</skos:altLabel>
    <skos:altLabel>Explicit Content</skos:altLabel>
    <skos:altLabel>Prohibited Material</skos:altLabel>
    <skos:definition>Inappropriate Content refers to claim regarding material that is deemed offensive, objectionable, or unsuitable for certain audiences, often violating societal norms or legal standards. This can include offensive language, explicit material, or any content that is considered harmful or inappropriate for public display or consumption.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Inappropriate Content</rdfs:label>
    <skos:prefLabel>Offensive Material</skos:prefLabel>
  </rdf:Description>
