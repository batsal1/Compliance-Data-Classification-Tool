  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R75UnfHpjpyqZKKPSpSjgCL">
    <skos:altLabel xml:lang="he-il">סעיף סיום לפי רצון</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation à volonté</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Terminación a Voluntad</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">इच्छा अनुसार समाप्ति धारा</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">随时终止条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Termination At Will Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自由解雇条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Terminación a Voluntad</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigung aus wichtigem Grund</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão a qualquer momento</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Termination At Will Clause is a provision in a contract that allows either party to end the agreement without cause or reason.</skos:definition>
    <rdfs:label>Termination At Will Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R355Le1zLujnXiHMmYqQNM"/>
  </rdf:Description>
