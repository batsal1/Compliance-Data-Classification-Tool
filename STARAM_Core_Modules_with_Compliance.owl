  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBv025DyVvHsv6oLYLWWwyx">
    <skos:altLabel xml:lang="hi-in">दर्द प्रबंधन लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Pain Management Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en el manejo del dolor</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em gerenciamento da dor</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">疼痛管理医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">疼痛管理医疗事故</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fehlerhafte Schmerztherapie</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בניהול כאב</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia en el manejo del dolor</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en gestion de la douleur</skos:altLabel>
    <skos:definition>Negligent or improper treatment of pain by a medical professional, resulting in harm or injury to the patient, which may lead to a legal claim for medical malpractice.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdfs:label>Pain Management Malpractice</rdfs:label>
  </rdf:Description>
