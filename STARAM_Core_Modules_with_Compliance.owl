    <skos:altLabel xml:lang="fr-fr">Concealment frauduleux par un fiduciaire</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">受託者による不正隠蔽</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ocultación fraudulenta por parte del fiduciario</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Ocultación fraudulenta por parte del fiduciario</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסתרה מרמתית על ידי פידוסיירי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Ocultação fraudulenta por fiduciário</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Betrügerische Verschleierung durch Treuhänder</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फ़िडुचेरी द्वारा धोखाधड़ीपूर्ण छिपाना</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">受托人的欺诈隐瞒</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fraudulent Concealment by Fiduciary</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtmRdqzdG4lddVrtCToiL1"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Fraudulent Concealment by Fiduciary</rdfs:label>
    <skos:definition>The fraudulent concealment by fiduciary concept refers to the intentional act of a person in a position of trust or confidence, such as a trustee or executor, to hide or withhold material information from another party for personal gain or to cause harm.</skos:definition>
  </rdf:Description>
