    <skos:altLabel xml:lang="ja-jp">司法特権</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Justizielle Privilegierung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">司法特权</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायिक विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Privilège judiciaire</skos:altLabel>
    <skos:definition>The concept of Judicial Privilege refers to the legal immunity granted to judges and other court officials from being compelled to testify in court about their official duties or decision-making processes.</skos:definition>
