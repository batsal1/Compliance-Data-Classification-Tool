  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDukS1DVkKKku4ERh2rFZxS">
    <skos:altLabel xml:lang="fr-fr">Subrogation</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Subrogation</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Subrogación</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">代位請求</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपस्थापना</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Sub-rogação</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">代位权</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Subrogation</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סוברוגציה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Subrogación</skos:altLabel>
    <rdfs:label>Subrogation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9q0hyYnNxQC475BKXOxjbm"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
