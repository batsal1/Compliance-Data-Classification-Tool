    <skos:altLabel xml:lang="en-gb">Release</skos:altLabel>
    <skos:prefLabel>Release Agreement</skos:prefLabel>
    <rdfs:label>Release</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Release is a legal defense used in civil litigation that involves the relinquishment or surrender of a claim or right by one party to another. A Release can also be a legal document in which one party agrees not to pursue legal action against another party in exchange for compensation or other considerations. It signifies the conclusion of a claim or potential claim.</skos:definition>
    <ns1:contractFamily xml:lang="en">Real Estate &amp; Leasing</ns1:contractFamily>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBpV7a4XyvWmCSvE8cMGfWK">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="hi-in">पशु उत्पादन और एक्वाकल्चर उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de Producción Animal y Acuicultura</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Tierproduktion und Aquakulturindustrie</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית ייצור בעלי חיים ואקווקלציה</skos:altLabel>
    <skos:altLabel>Animal Production and Aquaculture</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">动物生产和水产养殖业</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Industria de Producción Animal y Acuicultura</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">動物生産および水産養殖業</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Animal Production and Aquaculture Industry</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie de la production animale et de l'aquaculture</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de Produção Animal e Aquicultura</skos:altLabel>
    <skos:definition>Industries in this group raise or fatten animals for the sale of animals or animal products and/or raise aquatic plants and animals in controlled or selected aquatic environments for the sale of aquatic plants, animals, or their products. The group includes establishments, such as ranches, farms, and feedlots primarily engaged in keeping, grazing, breeding, or feeding animals. These animals are kept for the products they produce or for eventual sale.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R92xsHpdHu6BJjtepuRu"/>
    <rdfs:label>Animal Production and Aquaculture Industry</rdfs:label>
    <skos:hiddenLabel>ANAQ</skos:hiddenLabel>
