  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9GQ9A16tcviwBa7ali0aNW">
    <skos:altLabel xml:lang="es-es">Negligencia en el sitio de construcción</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निर्माण स्थल लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הזנחת אתר בנייה</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência no canteiro de obras</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia en el sitio de construcción</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">建筑工地疏忽</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence sur le chantier de construction</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit auf der Baustelle</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">建設現場の過失</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Construction Site Negligence</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Construction Site Negligence refers to the failure of a construction company or its employees to exercise reasonable care in maintaining a safe work environment, resulting in harm or injury to workers or others on the construction site.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9VNdcgRmlUlOc4aJbx1HJm"/>
    <rdfs:label>Construction Site Negligence</rdfs:label>
  </rdf:Description>
