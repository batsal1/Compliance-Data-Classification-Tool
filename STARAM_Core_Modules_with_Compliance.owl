    <skos:altLabel xml:lang="en-gb">7th Amendment Claim</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação da 7ª Emenda</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">第7修正案請求</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klage nach dem 7. Zusatzartikel</skos:altLabel>
