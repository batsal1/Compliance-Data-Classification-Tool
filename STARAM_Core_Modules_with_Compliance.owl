    <rdfs:label>Maintenance Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Maintenance Agreement is a type of agreement that outlines the terms and conditions for the upkeep and repair of a particular item or property.</skos:definition>
    <ns1:contractFamily xml:lang="en">Services &amp; Outsourcing</ns1:contractFamily>
