  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC2wlC1tSLKBhu0hof2Uqb0">
    <skos:altLabel xml:lang="en-gb">Buyer Recovering Specifically Identified Goods</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार विशिष्ट निर्दिष्ट वस्तुओं को वापस प्राप्त करता है</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Comprador recuperando bens especificamente identificados</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">买方恢复特定标识的货物</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Comprador recuperando bienes específicamente identificados</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">特定の識別された商品を回収する買い手</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Comprador recuperando bienes específicamente identificados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Acheteur récupérant des biens spécifiquement identifiés</skos:altLabel>
    <skos:altLabel xml:lang="he-il">קונה משיג את הסחורות המזוהות במיוחד</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Käufer erholt speziell identifizierte Waren</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Buyer Recovering Specifically Identified Goods" refers to a legal claim made by a buyer against a seller for breach of contract, seeking to recover goods that were specifically identified in the contract and not delivered by the seller.</skos:definition>
    <rdfs:label>Buyer Recovering Specifically Identified Goods</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
    <rdfs:subClassOf rdf:nodeID="Nadb3e087536f4153b0a2d9672e59a6ca"/>
    <rdfs:subClassOf rdf:nodeID="N7be2325dbf5c42abad83ea001734d78a"/>
  </rdf:Description>
