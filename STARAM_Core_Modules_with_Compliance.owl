  <rdf:Description rdf:about="https://folio.openlegalstandard.org/XMoHjszoS72tj6HeYZ4hJA">
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) retailing and fitting prescription eyeglasses and contact lenses; (2) retailing prescription eyeglasses in combination with the grinding of lenses to order on the premises; and (3) retailing nonprescription eyeglasses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/i2lpdx8aTlqpdnFoLrNyYw"/>
    <rdfs:label>Optical Goods Retailers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=456130"/>
  </rdf:Description>
