  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RFaPio4mlb48F4I6Jc9bTq">
    <rdfs:label>Sports Law</rdfs:label>
    <skos:altLabel>Sports and Recreation Law</skos:altLabel>
    <skos:prefLabel>Athletics Law</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rq7yrbwVSqS8fuRtnzDx6g"/>
    <rdfs:subClassOf rdf:nodeID="Nd82766aea89e4a94ae26554e2cb425b4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Sports Law deals with the legal issues and regulations pertaining to the sports industry, including professional and amateur athletics. It covers a wide range of topics such as contracts, doping, governance, and the rights and obligations of athletes and sports organizations.</skos:definition>
  </rdf:Description>
