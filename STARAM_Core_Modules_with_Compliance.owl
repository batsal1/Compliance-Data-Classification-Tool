    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Exculpatory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDUDvoBnJWk7AbMAk4bGqVs">
    <rdfs:label>Waiver of Moral Rights Clause</rdfs:label>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a los derechos morales</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzicht auf moralische Rechte Klausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">放弃道德权利条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation aux droits moraux</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia a los derechos morales</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia aos direitos morais</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור מזכויות מוסריות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">道徳的権利放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आधारभूत अधिकारों के त्याग की शर्त</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver of Moral Rights Clause</skos:altLabel>
    <skos:definition>A Waiver of Moral Rights Clause is a provision in a legal agreement where an individual relinquishes their right to be credited as the author of their work or to object to any changes made to their work.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RSRxb9psAJdqf8rppoiYI8">
    <skos:altLabel xml:lang="he-il">תביעות עו"דיות ולגליות תהליכיות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Actions en responsabilité civile judiciaire et procédurale</skos:altLabel>
    <skos:altLabel>Procedural Torts</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones judiciales y procesales por agravios</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">司法和程序性侵权索赔</skos:altLabel>
    <skos:altLabel>Judicial Claims</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायिक और प्रक्रियात्मक टॉर्ट दावे</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Judicial and Procedural Tort Claims</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamaciones judiciales y procesales por agravios</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gerichtliche und verfahrensrechtliche Folgeansprüche</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">司法および手続き上の不法行為請求</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações judiciais e processuais por danos</skos:altLabel>
    <skos:definition>Judicial and Procedural Tort Claims refer to legal claims made against individuals or entities for their wrongful actions or omissions during legal proceedings, such as perjury, abuse of process, or spoliation of evidence.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Judicial and Procedural Tort Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8XMs89zuZc9chn6WQ9Fgbm">
    <rdfs:label>Animal Claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <skos:altLabel xml:lang="ja-jp">動物の請求</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Tieransprüche</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamos de animales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Animal Claims</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">动物索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendications animales</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicações animais</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamaciones de animales</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पशु दावे</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעות בנושא בעלי חיים</skos:altLabel>
    <skos:definition>Animal Claims refer to legal claims related to harm caused by or to animals, including liability for injury to pets, cruelty to animals, animal attacks, trespassing livestock causing harm, dangerous domesticated animals, injury caused by wild animals, and negligent handling of animals.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rd6ivGOMbi4Slsu4ynPmMX">
    <skos:altLabel xml:lang="en-gb">Health Law</skos:altLabel>
    <skos:altLabel>Health Law</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito da saúde</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit de la santé</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gesundheitsrecht</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वास्थ्य कानून</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Derecho de la salud</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho sanitario</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">卫生法</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוקי בריאות</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">医療法</skos:altLabel>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#AoL-HLTH</ns2:legacyIdentifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Law, rules, regulations and other jurisprudence among providers, payers and vendors to the health care industry and its patients; and (2) delivery of health care services; all with an emphasis on operations, regulatory and transactional legal issues.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RSYBzf149Mi5KE0YtmpUmr"/>
    <rdfs:label>Health Law</rdfs:label>
    <skos:hiddenLabel>HLTH</skos:hiddenLabel>
    <dc:identifier>HLTH</dc:identifier>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndb0d649f259540f88b0d9c2d6722f3d7">
