  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCpl1tMWPbEplg0P6GxQaLs">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3OI7nrib1LEPtUfn5G5CH"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>General Bequest</rdfs:label>
    <skos:altLabel>General Testamentary Gift</skos:altLabel>
    <skos:definition>A General Bequest is a provision in a will or trust that designates a fixed amount of money or quantity of assets to a beneficiary without specifying the exact source from which these assets should be drawn. It ensures the beneficiary receives the specified value or amount from the overall estate.</skos:definition>
  </rdf:Description>
