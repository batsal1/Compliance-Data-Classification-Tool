    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <skos:definition>A wage theft claim is a legal action taken by an employee against an employer for the unlawful withholding of wages or benefits that the employee is entitled to receive.</skos:definition>
