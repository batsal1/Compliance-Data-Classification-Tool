    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A relinquishment clause is a provision in a contract that allows one party to give up or surrender their rights or claims to something specified in the agreement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/vYX7JSuNRDSzce-lpVwBhg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/K6baW0MvRiqcZdVvcH4MMw"/>
