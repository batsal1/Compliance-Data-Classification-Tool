  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Thgjk3czj9SdgZ1BcrVeu">
    <skos:altLabel>Marine Wind Energy</skos:altLabel>
    <skos:altLabel>Offshore Wind Power</skos:altLabel>
    <skos:prefLabel>Off-shore Wind Power</skos:prefLabel>
    <rdfs:label>Offshore Wind Energy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDCVD1h5h31JekFnNolVJju"/>
    <skos:definition>Offshore Wind Energy refers to the generation of electricity from wind turbines located in bodies of water, usually on the continental shelf. This form of energy generation typically requires specific regulatory approvals due to its impact on marine environments and international waters.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8ON9C39HUAjJYhP2BPONKP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="fr-fr">Défaut de réduction des dommages</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unterlassung der Schadensminderung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未尽力减轻损失</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de la obligación de mitigar daños</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha em Mitigar Danos</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure to Mitigate Damages</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כשל בהפחתת נזקים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de la obligación de mitigar daños</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नुकसान कम करने में विफलता</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">損害軽減義務違反</skos:altLabel>
    <skos:definition>The failure of a plaintiff to take reasonable steps to minimize their losses or damages after an injury or breach of contract has occurred, which may limit the amount of damages they can recover in a lawsuit.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:label>Failure to Mitigate Damages</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/tEn-M7tEQwSDoAaEWhntrQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33351"/>
    <rdfs:label>Metalworking Machinery Manufacturing</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing metalworking machinery, such as metal cutting and metal forming machine tools; cutting tools; accessories for metalworking machinery; special dies, tools, jigs, and fixtures; industrial molds; rolling mill machinery; assembly machinery; coil handling, conversion, or straightening equipment; and wire drawing and fabricating machines.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/aFciQW2QQqiQSsc4MfkorQ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RKgOBuUzUaz2T5XTUY32qa">
    <skos:definition>A legal billing code used to categorize services related to the acquisition or transfer of intellectual property and technology assets, falling under the broader category of UTBMS Mergers and Acquisitions (M&amp;A).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>UTBMS MF50 Intellectual Property and Technology</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9d2DkaIPGh2tQoNNOoEBMu"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/HzWP1G5wRieCjSDD1vmXSQ">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing tires and inner tubes from natural and synthetic rubber.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=326211"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/C8ZWUStdQYSAgNfsaoN1Pw"/>
    <rdfs:label>Tire Manufacturing (except Retreading)</rdfs:label>
