    <skos:example>Sanitary ware (e.g., bathtubs, lavatories, sinks), metal and enameled metal, manufacturing</skos:example>
    <skos:example>Portable metal ladders manufacturing</skos:example>
    <skos:example>Steel wool manufacturing</skos:example>
