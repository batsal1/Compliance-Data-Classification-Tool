  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9j28CnGJGZZNyI3B7Fo6aW">
    <rdfs:label>Waiver of Right of First Refusal Clause</rdfs:label>
    <skos:altLabel xml:lang="he-il">סעיף פטור מזכות הקנייה הראשונה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Waiver of Right of First Refusal Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia al derecho de tanteo</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia al derecho de primera oferta</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">放弃优先购买权条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de renonciation au droit de préemption</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verzicht auf das Vorkaufsrecht-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de renúncia ao direito de preferência</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">優先購入権放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पहले अधिकार से इनकार करने की शर्त का अस्वीकार</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Ryu5LoAUzP13SyODG4jLLN"/>
    <skos:definition>A Waiver of Right of First Refusal Clause is a provision in a contract that allows a party to give up their right to be the first to purchase or lease a property or asset before it is offered to others.</skos:definition>
  </rdf:Description>
