  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9EcKh053NbkS0FJiJCxYwG">
    <skos:altLabel xml:lang="de-de">Staatliche Immunität</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Sovereign Immunity</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">主权豁免</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Inmunidad soberana</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Inmunidad soberana</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समराज्य संरक्षण</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חסינות ריבונית</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Imunidade soberana</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">主権免除</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Immunité souveraine</skos:altLabel>
    <rdfs:label>Sovereign Immunity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDFgKHH89MV9zwwkinVZtzk"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBvhPeoPwTNYsc19VBpYjSV"/>
    <skos:definition>Sovereign immunity is a legal doctrine that protects governments and their agencies from being sued or held legally liable for their actions, without their consent. In the United States, this principle is rooted in the Eleventh Amendment of the Constitution, which provides states with immunity from certain types of lawsuits in federal courts, and is also applied to the federal government under the principle of federal sovereign immunity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7pHBQFhSPZs9t1pC48JEV3">
    <skos:altLabel xml:lang="hi-in">स्पष्ट त्रुटिपूर्ण</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ברור שגוי</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">明白な誤り</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">明显错误</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Erreur manifeste</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Clearly Erroneous</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Offensichtlicher Fehler</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Claramente Erróneo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Claramente Erróneo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Evidentemente Errôneo</skos:altLabel>
    <skos:definition>A legal standard of review used by appellate courts to determine if a lower court's decision was clearly incorrect or mistaken.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCpnqQCzeexk3k9kkbLx1Zu"/>
    <rdfs:label>Clearly Erroneous</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/aig5Acp6RO2jqM0jqlC9Iw">
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) retailing new office supplies, stationery, and school supplies; (2) retailing a combination of new office equipment, furniture, and supplies; and (3) retailing new office equipment, furniture, and supplies in combination with selling new computers.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/kd19cU5aT5WCgbAK6jFL3g"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=459410"/>
    <rdfs:label>Office Supplies and Stationery Retailers</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDIcTaDzu8L9eXSdZX62rYE">
    <skos:altLabel xml:lang="he-il">ייצוג ניתושיות</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Durchsetzbarkeitsdarstellung</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">可执行性陈述</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Representación de Ejecutabilidad</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representação de exigibilidade</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रवर्तन विवरण</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Représentation de l'exécution forcée</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">強制執行表現</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representación de Ejecutabilidad</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Enforceability Representation</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Enforceability Representation: A statement made in a legal agreement that assures the parties involved that the terms of the agreement can be enforced by law.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rCNhUCohkUGbQyd1C3uzz"/>
    <rdfs:label>Enforceability Representation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCui7kRZ1IHGac2ed72DpBK">
    <skos:altLabel xml:lang="hi-in">भुगतान शर्तें और नियम अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de termos e condições de pagamento</skos:altLabel>
