  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC5FOOj5LHE2ITa2pdb9s5i">
    <skos:altLabel xml:lang="es-es">Infracción del toque de queda</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Violación del toque de queda</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ausgangssperrenverstoß</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">外出禁止令違反</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação de toque de recolher</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">宵禁违规</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Curfew Breach</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation de couvre-feu</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कर्फ्यू उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת צו הקליאות</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDgbjRGvnprxnFm9CAqCjYs"/>
    <skos:definition>A curfew violation is a specific type of legal offense that occurs when an individual fails to comply with a set curfew time, typically imposed on minors, and can result in legal consequences.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdfs:label>Curfew Violation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RHEBDj55KU1X33SfjWrdR6">
    <rdfs:label>Non-consensual Pornography Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rd7uelGFqCTWSgf9lWki5N"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9mSfKgf9j4vIGxmQrnBd1I"/>
    <skos:definition>A revenge porn claim is a legal assertion that an individual's private, sexually explicit images or videos have been distributed without their consent, typically as an act of revenge or harassment. This claim seeks redress for the invasion of privacy, emotional distress, and potential reputational harm caused by the unauthorized dissemination.</skos:definition>
    <skos:prefLabel>Revenge Porn Claim</skos:prefLabel>
    <skos:altLabel>Revenge Pornography Claim</skos:altLabel>
    <skos:altLabel>Unauthorized Distribution of Intimate Images Claim</skos:altLabel>
  </rdf:Description>
