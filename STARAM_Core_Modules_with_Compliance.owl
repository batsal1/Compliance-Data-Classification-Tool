  <rdf:Description rdf:about="https://folio.openlegalstandard.org/lxV0SU11R4eA2MvwCvIQTg">
    <rdfs:label>Skiing Facilities</rdfs:label>
    <skos:definition>This industry comprises establishments engaged in (1) operating downhill, cross country, or related skiing areas and/or (2) operating equipment, such as ski lifts and tows. These establishments often provide food and beverage services, equipment rental services, and ski instruction services. Four season resorts without accommodations are included in this industry.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/rB1kZZfTTUyKdfLGYJvktA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=713920"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
