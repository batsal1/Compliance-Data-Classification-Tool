  <rdf:Description rdf:about="https://folio.openlegalstandard.org/PuBa1l2NRcGhNyVWZnUCbQ">
    <rdfs:label>Linen Supply</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in supplying, on a rental or contract basis, laundered items, such as table and bed linens; towels; diapers; and uniforms, gowns, or coats of the type used by doctors, nurses, barbers, beauticians, and waitresses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Wy4X3LyoQx6HlJmAPuW2DQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=812331"/>
  </rdf:Description>
