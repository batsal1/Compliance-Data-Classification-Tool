  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RV1sBg6qkfqNkfEqQ8FnMc">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBeZkopwGsxt3K5BXOgNBNF"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Environmental Review Claim is a legal action asserting that a project or action has not adequately complied with environmental impact assessment requirements mandated by law. Such claims typically allege insufficient analysis of potential environmental effects, failure to consider alternatives, or inadequate mitigation measures for identified impacts.</skos:definition>
    <skos:altLabel>Environmental Impact Assessment Claim</skos:altLabel>
    <rdfs:label>Environmental Review Claim</rdfs:label>
    <skos:prefLabel>Ecological Impact Evaluation Claim</skos:prefLabel>
  </rdf:Description>
