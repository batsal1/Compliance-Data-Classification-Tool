  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8am1TCtFwM5NknBThKf28j">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDa7IsUxl4AA7e5KylzJYK"/>
    <skos:altLabel xml:lang="hi-in">टेंडर शर्त का असफलता</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de la Condición de la Oferta</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaillance de la condition d'appel d'offres</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">入札条件の不履行</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nichterfüllung der Ausschreibungsbedingungen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">招标条件失效</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha na Condição de Licitação</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure of Tender Condition</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de la Condición de la Oferta</skos:altLabel>
    <skos:altLabel xml:lang="he-il">כשל בתנאי המכרז</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Failure of Tender Condition refers to a situation where a party fails to meet the conditions required for a tender offer to be successful, resulting in the offer being terminated.</skos:definition>
    <rdfs:label>Failure of Tender Condition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R82kPq1u51rWEx0EVL7w3lo">
    <skos:altLabel xml:lang="hi-in">लागत या फी अवार्डेड - रेड्यूस्ड अमाउंट</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">費用または手数料の決定 - 減額された金額</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">成本或费用裁决 - 减少的金额</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Costo o tarifa otorgada - Cantidad reducida</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kosten- oder Gebührenentscheidung - Reduzierter Betrag</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עלות או תשלום מוענק - כמות מורדמת</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Decisão de custos ou taxas - Valor reduzido</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Décision de coûts ou de frais - Montant réduit</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Costo o tarifa otorgada - Cantidad reducida</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Cost or Fee Awarded - Amount Reduced</skos:altLabel>
    <skos:definition>A reduction in the amount of costs or fees awarded, which is a part of the broader concepts of cost shifting and fee shifting in legal matters.</skos:definition>
    <rdfs:label>Cost or Fee Awarded - Amount Reduced</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9rEOlPrMiUpUlQrMe18m1X"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBHzq2yqYL8JEktmzbPwYOP">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCQCiKMTNRjrI3JbFdOhXu2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>International Trade Protection Litigation</skos:prefLabel>
    <skos:definition>Trade Safeguards Disputes involve legal proceedings related to the application of safeguard measures, which are temporary restrictions on imports to protect domestic industries from serious injury caused by increased imports. This practice includes representing clients in disputes before international trade bodies and ensuring compliance with international trade agreements.</skos:definition>
    <rdfs:label>Trade Safeguards Dispute</rdfs:label>
    <skos:altLabel>Import Protection Dispute Resolution</skos:altLabel>
    <skos:altLabel>Trade Defense Litigation</skos:altLabel>
    <skos:altLabel>Trade Safeguard Legal Proceedings</skos:altLabel>
  </rdf:Description>
