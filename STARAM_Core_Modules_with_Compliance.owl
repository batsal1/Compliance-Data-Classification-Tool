  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7txERXQ85pCIryX6tF28pW">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Broadcasting Law governs the transmission of television and radio programs, including the regulation of content, licensing, and the management of broadcasting rights. It ensures that broadcasters comply with standards for public interest, decency, and fairness.</skos:definition>
    <skos:altLabel>Radio and Television Law</skos:altLabel>
