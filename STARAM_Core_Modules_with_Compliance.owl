  <rdf:Description rdf:about="https://folio.openlegalstandard.org/REQmdkFCzM2zNINpl5iV3r">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Right of Attribution is a component of moral rights in copyright law, allowing the creator to claim authorship of their work and to object to any unauthorized attribution. It safeguards the creator's reputation by ensuring their work is properly associated with them and not falsely attributed to others.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9ICeOg6A95qwBlvRoew3Br"/>
    <rdfs:label>Right of Attribution</rdfs:label>
  </rdf:Description>
