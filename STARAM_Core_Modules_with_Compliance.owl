  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RuGCUgu3KSRqVu9XKcPIYbg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RtpnOBk4lRnWigpEBBKYUDQ"/>
    <rdfs:label>X122 Late Fees</rdfs:label>
    <skos:definition>Any late fee imposed by a governmental or quasi-governmental agency in any type of matter in order to have a document entered into record past the initial deadline. For IP matters, includes including Petition for Extension of Time and Information Disclosure Statement fees in the US. Excludes any late fee or finance charge on overdue legal bills.</skos:definition>
    <skos:prefLabel>X122 Late Fees</skos:prefLabel>
  </rdf:Description>
