  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCNJOEcy40GPNeOqYERXigC">
    <skos:definition>Youth Arrival Immigrants (in the U.S., DACA (Deferred Action for Childhood Arrivals) immigrants) are individuals who were brought to a country as children and have lived there without legal status. DACA is a U.S. policy that provides temporary relief from deportation and work authorization to eligible individuals who meet certain age, educational, and background criteria</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GuYn7yMmfL0coiNQ0OE8f"/>
    <skos:altLabel>Dreamer</skos:altLabel>
    <skos:altLabel>DACA Immigrant</skos:altLabel>
    <rdfs:label>Youth Arrival Immigrant</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
