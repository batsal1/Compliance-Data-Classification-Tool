  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDyBSHSjhe1bInCsxPkdmfk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="hi-in">क्वासी-एस्टोपल</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Quasi-estoppel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">קוואזי-אסטופל</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Quase-estoppel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cuasiestoppel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">準拘束効力</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Quasi-Estoppel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Quasi-Estoppel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">准停止</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cuasiestoppel</skos:altLabel>
    <rdfs:label>Quasi-Estoppel</rdfs:label>
    <skos:definition>Quasi-Estoppel is a legal principle that prevents a party from denying or asserting a position that is contrary to a previous position they have taken, even if there is no formal legal agreement or contract in place.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RoKNrz23ylFaWAaoPC3ECY"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8JkKF4Hj1gEToIcmTffB1y">
    <skos:altLabel xml:lang="he-il">טעות חד-צדדית בחוזה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Error unilateral en el contrato</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約における一方的な誤り</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Error unilateral en el contrato</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Einseitiger Irrtum im Vertrag</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Erreur unilatérale dans le contrat</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Erro unilateral no contrato</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एकतरफ़ा अशुद्धि अनुबंध में</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合同中的单方面错误</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Unilateral Mistake in Contract</skos:altLabel>
    <rdfs:label>Unilateral Mistake in Contract</rdfs:label>
    <skos:definition>A unilateral mistake in contract is a legal concept that occurs when only one party to a contract is mistaken about a material fact, which can lead to the contract being voidable or unenforceable.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RJEhNjPDXIeJRMwifVraDk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
