  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RByDRLSc43XXuxvGpaC4vtz">
    <skos:altLabel xml:lang="en-gb">Data Quality Principle</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Principio de calidad de datos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Princípio de qualidade de dados</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עקרון איכות הנתונים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">数据质量原则</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Datenqualitätsprinzip</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Principio de calidad de datos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">डेटा गुणवत्ता सिद्धांत</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Principe de qualité des données</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">データ品質の原則</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw"/>
    <rdfs:isDefinedBy rdf:resource="http://oecdprivacy.org/"/>
    <rdfs:label>Data Quality Principle</rdfs:label>
    <skos:definition>Data Quality is the privacy principle that personal data should be relevant to the purposes for which they are to be used, and, to the extent necessary for those purposes, should be accurate, complete and kept up-to-date.</skos:definition>
  </rdf:Description>
