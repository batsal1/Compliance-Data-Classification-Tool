  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8zcX2xM4mtyOQhF9UXKYJ1">
    <skos:definition>A Graffiti Claim is a criminal misdemeanor charge alleging that an individual has defaced property by painting, marking, or inscribing surfaces without the owner's consent. This legal action asserts that the accused has engaged in vandalism through the unauthorized application of graffiti, potentially causing property damage and public nuisance.</skos:definition>
    <skos:prefLabel>Defacement Allegation</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Graffiti</rdfs:label>
    <skos:altLabel>Unauthorized Public Marking Offense</skos:altLabel>
    <skos:altLabel>Tagging Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBNz30rxM6l0GnL6R9XDyU2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6fc2f004d9a14f60a56d6e171bde324f">
