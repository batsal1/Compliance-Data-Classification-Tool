    <skos:altLabel xml:lang="es-mx">Apropiación indebida de ideas - Reclamo contractual</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Apropiación indebida de ideas - Reclamación contractual</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התאגדות רעיונות - טענת חוזה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विचार अनुपात्रवता - अनुबंध दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ideenunterschlagung - Vertragsanspruch</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">创意侵占 - 合同索赔</skos:altLabel>
    <skos:definition>The wrongful taking or use of another's idea or concept, specifically in the context of a breach of contract claim.</skos:definition>
  </rdf:Description>
