  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RK0i5py6LdHGXhMS9gJ26I">
    <skos:altLabel xml:lang="ja-jp">死産</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Natimorto</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Totgeburt</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Muerte fetal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">死胎</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अभीशप्रजनन</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Muerte fetal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Mort-né</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Stillbirth</skos:altLabel>
    <skos:altLabel xml:lang="he-il">לידה מתונה</skos:altLabel>
    <rdfs:label>Stillbirth</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of Stillbirth refers to the loss of a fetus after the 20th week of pregnancy, which may be attributed to medical malpractice and can result in legal claims.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R_OVXBSFNTfms-t-AopmKPA">
    <rdfs:label>A112 Billable Travel Time</rdfs:label>
    <skos:definition>Travel time billed by the timekeeper when other billable services are not performed for the client. Includes time spent waiting for a calendar/court call or other scheduled out-of-office event associated with the matter when other billable services are not performed for the client.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>A112 Billable Travel Time</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RnTEPb_LCSNqAkQqrfte8zg"/>
  </rdf:Description>
