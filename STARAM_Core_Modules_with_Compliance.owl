  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8DKqTsIPZf7MFvQENtRxBO">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
    <rdfs:label>Spousal Privilege</rdfs:label>
    <rdfs:label>Marital Communication / Spousal Privilege</rdfs:label>
    <skos:prefLabel>Marital Communication Privilege</skos:prefLabel>
    <skos:altLabel xml:lang="pt-br">Comunicação conjugal / Privilégio conjugal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Communication conjugale / Privilège conjugal</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Comunicación marital / Privilegio conyugal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">夫婦間のコミュニケーション/配偶者特権</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תקשורת בין בני זוג / זכות סודיות בין בני זוג</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Comunicación marital / Privilegio conyugal</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Ehekommunikation / Ehegattenprivileg</skos:altLabel>
    <skos:altLabel>Spousal Privilege</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Marital Communication / Spousal Privilege</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">婚姻沟通 / 配偶特权</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वैवाहिक संचार / पति-पत्नी का विशेषाधिकार</skos:altLabel>
    <skos:altLabel>Marital Communication</skos:altLabel>
    <skos:definition>The concept of Marital Communication/Spousal Privilege refers to the legal protection that prohibits a spouse from being compelled to testify against their partner in court regarding confidential communications made during the marriage.</skos:definition>
    <skos:definition>The concept of Spousal Privilege (aka Marital Communication Privilege) refers to the legal protection that prohibits a spouse from being compelled to testify against their partner in court regarding confidential communications made during the marriage.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9xXAi8F91sxNsSZRtidmpN">
    <skos:altLabel xml:lang="de-de">Insolventer Vermieter, der Waren vermietet hat</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租赁物的破产出租人</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Locador insolvente que alugou bens</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insolvent Lessor Having Leased Goods</skos:altLabel>
