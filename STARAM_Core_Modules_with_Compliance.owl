    <skos:altLabel xml:lang="de-de">M&amp;A-Praxisbereiche</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">M&amp;A Practice Components</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">M&amp;A実務の構成要素</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Componentes de la práctica de fusiones y adquisiciones</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Composants de la pratique des fusions et acquisitions</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एम एंड ए प्रैक्टिस के घटक</skos:altLabel>
