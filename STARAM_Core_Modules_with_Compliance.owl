    <rdfs:label>Campaign Finance Violation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/YO7KGSCpRdS7OGzFNrGrDQ">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=336419"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Other Guided Missile and Space Vehicle Parts and Auxiliary Equipment Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) manufacturing guided missile and space vehicle parts and auxiliary equipment (except guided missile and space vehicle propulsion units and propulsion unit parts) and/or (2) developing and making prototypes of guided missile and space vehicle parts and auxiliary equipment.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/OHRgpwVGRR2OOs9XZgkEgA"/>
  </rdf:Description>
