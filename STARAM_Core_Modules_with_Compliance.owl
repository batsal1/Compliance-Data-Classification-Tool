  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RdLt8myHW8a9xutd93BnoT">
    <skos:altLabel xml:lang="es-es">Peligro atractivo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Perigo de atração para crianças</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Danger d'attraction pour les enfants</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">魅力的な危険物</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">आकर्षक उपद्रव</skos:altLabel>
