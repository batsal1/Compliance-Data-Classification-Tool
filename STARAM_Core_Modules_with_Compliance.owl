    <rdfs:subClassOf rdf:nodeID="N30411a2ce19b45549dd3333b50f05aba"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8GyyJdxlZtc7PsW9vLAKfE"/>
    <rdfs:subClassOf rdf:nodeID="N1642dca4ef3f4aa5a1b3641a082bb08c"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB"/>
    <skos:definition>Consumer Fraud refers to the deceptive or misleading practices used by businesses or individuals to gain an unfair advantage over consumers, often resulting in financial harm or injury.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Consumer Fraud</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9ad423dd53a5440eb17c8cdf41fb0b82">
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Confidentiality"/>
