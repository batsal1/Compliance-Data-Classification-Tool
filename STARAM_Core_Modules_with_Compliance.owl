    <skos:altLabel xml:lang="fr-fr">Clause de renonciation aux dommages indirects</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">间接损害赔偿豁免条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Consequential Damages Waiver Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de renuncia a daños y perjuicios consecuentes</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף פטור מפיצויים נגזרים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de renuncia a daños y perjuicios consecuentes</skos:altLabel>
    <rdfs:label>Consequential Damages Waiver Clause</rdfs:label>
