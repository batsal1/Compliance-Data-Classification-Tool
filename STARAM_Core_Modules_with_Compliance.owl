    <skos:altLabel xml:lang="fr-fr">Représentation d'autorité</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिकार प्रतिनिधित्व</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Representación de Autoridad</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ייצוג רשות</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
