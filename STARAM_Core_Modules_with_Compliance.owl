  <rdf:Description rdf:nodeID="N8986d0355dfc474daf13f59c5daeeb1e">
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R82Yb8u8L6F9E8vrZFOnfw1"/>
