    <skos:altLabel xml:lang="en-gb">Client Tax ID</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kundensteuer-ID</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">ID fiscal do cliente</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Identificación fiscal del cliente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Identificación fiscal del cliente</skos:altLabel>
    <skos:altLabel>Individual Taxpayer Identification Number</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">客户税号</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מזהה מס לקוח</skos:altLabel>
    <skos:definition>The buyer's tax id number to which provider's taxes are charged.</skos:definition>
    <rdfs:label>Client Tax ID</rdfs:label>
    <rdfs:isDefinedBy>From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/</rdfs:isDefinedBy>
    <skos:prefLabel>ITIN</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
