    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mechanics' Lien</rdfs:label>
    <skos:definition>A Mechanics' Lien is a type of lien that allows a contractor or supplier to place a claim on a property they have worked on if they have not been paid for their services or materials.</skos:definition>
  </rdf:Description>
