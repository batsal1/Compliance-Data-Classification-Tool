  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc/taxonomy#cat-dispute-governing-law">
    <skos:prefLabel xml:lang="en">Dispute Resolution &amp; Governing Law</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#RiskCategory"/>
    <skos:notation>LR-13</skos:notation>
    <skos:inScheme rdf:resource="https://staram.in/ontology/epc/taxonomy#LegalReviewRiskTaxonomy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">Risks in how disputes are resolved, covering multi-tier resolution steps, availability of a Dispute Adjudication Board, the seat and venue of arbitration, mismatched governing law, notices that are conditions precedent to a claim, and shortened limitation periods.</skos:definition>
