  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9KSG54ZD5NJGhEKjpDjZvO">
    <rdfs:domain rdf:resource="https://folio.openlegalstandard.org/RcTA2iQmrtqOnX3WrjJIp8"/>
    <skos:notation>folio:represented</skos:notation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:altLabel>represented</skos:altLabel>
    <rdfs:label>sali:represented</rdfs:label>
    <rdfs:label>represented</rdfs:label>
    <rdfs:range rdf:resource="https://folio.openlegalstandard.org/RCYr9dOm44gvlCAHRrOG0GU"/>
    <skos:example>Lawyer Represented Client</skos:example>
    <skos:definition>"Represented" in a legal context refers to the act of acting on behalf of another person or entity in legal matters. This involves a representative, such as a lawyer, advocating, making decisions, or taking actions under the authority and in the interest of the represented party.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7369cWYH8cut2F7VAmvghj">
    <skos:altLabel xml:lang="en-gb">Rescission and Cancellation of Written Instruments</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Aufhebung und Annullierung von schriftlichen Instrumenten</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Rescisión y Cancelación de Instrumentos Escritos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">書面文書の撤回およびキャンセル</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लिखित दस्तावेजों के रद्द और रद्द करने का अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Résolution et annulation d'instruments écrits</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Rescisión y Cancelación de Instrumentos Escritos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Rescisão e cancelamento de instrumentos escritos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">书面文件的撤销和取消</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ביטול וביטול של מכתבים כתובים</skos:altLabel>
    <rdfs:label>Rescission and Cancellation of Written Instruments</rdfs:label>
    <skos:definition>The concept of Rescission and Cancellation of Written Instruments refers to the legal act of revoking or terminating a written agreement or contract, typically due to a breach of terms or fraud.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDP2t75tSvlsq1GCrOZlInL"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RvCyXheApiOSz6osTb8EwA">
    <skos:altLabel xml:lang="es-mx">Cláusula de Incorporación de los Considerandos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">引入条款条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Incorporación de Considerandos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Incorporação de Preâmbulos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रस्ताव शामिल क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Einbeziehung von Präambeln</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Recitals Incorporated Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">前文組み込み条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הכלול בו הכנסות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'incorporation de préambules</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:label>Recitals Incorporated Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Recitals Incorporated Clause is a type of contractual clause that includes a section outlining the background and context of the agreement being made.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBC0hzYykzvVIU4lgwzWUxn">
    <skos:altLabel xml:lang="ja-jp">JAMS国際仲裁規則</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">JAMS国际仲裁规则</skos:altLabel>
    <skos:altLabel xml:lang="de-de">JAMS Internationale Schiedsgerichtsordnung</skos:altLabel>
