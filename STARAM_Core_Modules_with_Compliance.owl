    <rdfs:subClassOf rdf:nodeID="N0bace0c01a5745948643b4f9256f4f9d"/>
    <rdfs:comment xml:lang="en">A distinct legally required action, prohibition, maintenance requirement, submission, payment/deposit, registration, renewal, appointment, meeting, display, audit, record-keeping requirement, intimation, policy requirement, assurance requirement or other enforceable obligation that a specifically identifiable regulated person/entity must perform, maintain, submit, obtain, avoid or undertake. Minimum identity: Actor + Action/Obligation + Legal Basis + Applicability; where timing exists also Timing/Frequency + Relevant Period + Due Date/Trigger. ONE individual = ONE distinct compliance = ONE repository row.</rdfs:comment>
    <skos:altLabel xml:lang="en">Compliance</skos:altLabel>
    <skos:altLabel xml:lang="en">Compliance Obligation</skos:altLabel>
    <skos:altLabel xml:lang="en">Compliance Row</skos:altLabel>
    <skos:altLabel xml:lang="en">Compliance Logic Object</skos:altLabel>
    <cmp:sourceRule>Master Prompt §4, §13, §55, §74</cmp:sourceRule>
    <rdfs:seeAlso rdf:resource="https://folio.openlegalstandard.org/R9RgfP9So7I6U6ug0d6MSHA"/>
  </rdf:Description>
