  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8xqkW9pvPsFtxGfeABkguc">
    <skos:definition>Sex trafficking involves the recruitment, harboring, transportation, provision, or obtaining of a person for the purpose of a commercial sex act, usually through force, fraud, or coercion. This is a serious criminal offense and is subject to severe penalties under various international and national laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sex Trafficking</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDOQpX5t5sVf55UPK2CfZTy"/>
  </rdf:Description>
