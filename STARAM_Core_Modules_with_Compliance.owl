  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBNAVdQU5MQ2a12j1We7G31">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R89lVNu8g1yMPFfyEkk8npj"/>
    <skos:altLabel>Non-Controlling Stake</skos:altLabel>
    <skos:altLabel>Non-Controlling Shareholding</skos:altLabel>
    <skos:altLabel>Minority Shareholding</skos:altLabel>
    <rdfs:label>Minority Stake</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Minority Stake refers to ownership of less than 50% of a company's shares, which does not provide control over the company but can still offer significant influence. Minority stakeholders often rely on shareholder agreements and other mechanisms to protect their interests.</skos:definition>
    <skos:prefLabel>Minority Interest</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/jk6zTFWDSxScF-7eOJ5OTA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/7WY07yhXQL-MtSYRIdkzJA"/>
    <skos:example>Piano retailers</skos:example>
    <skos:example>Musical instrument retailers</skos:example>
    <skos:example>Sheet music retailers</skos:example>
    <rdfs:label>Musical Instrument and Supplies Retailers</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=459140"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in retailing new musical instruments, sheet music, and related supplies; or retailing these new products in combination with musical instrument repair, rental, or music instruction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9EMtURt2I1SQ7rrguSGbq0">
    <skos:altLabel xml:lang="zh-cn">法律冲突条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Conflito de Leis</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">法律適用法定款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Leyes en Conflicto</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kollisionsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Leyes en Conflicto</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Conflict of Laws Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कानून के संघर्ष ढांचा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סכסוך חוקים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit international privé</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:subClassOf rdf:nodeID="Nbbdf829985ff4b9aa7f6b564b8b5b5a5"/>
    <skos:definition>A Conflict of Laws Clause is a provision in a contract that determines which jurisdiction's laws will apply in the event of a legal dispute between the parties involved.</skos:definition>
    <rdfs:label>Conflict of Laws Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RuYMUlbVtOYREJfX9HGRFL">
