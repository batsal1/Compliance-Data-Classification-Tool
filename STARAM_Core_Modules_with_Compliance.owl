    <skos:altLabel xml:lang="he-il">סעיף אי אחריות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">无责任条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कोई दायित्व शर्त नहीं</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de no responsabilidad</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftungsausschlussklausel</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No Liability Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de não responsabilidade</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">免責条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-responsabilité</skos:altLabel>
    <skos:definition>A no liability clause is a type of contractual clause that absolves one party from any legal responsibility or obligation for any damages or losses incurred by the other party.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>No Liability Clause</rdfs:label>
  </rdf:Description>
