    <skos:altLabel xml:lang="ja-jp">コピー費用</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Despesa de cópia</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Copying Expense</rdfs:label>
    <skos:definition>The Copying Expense concept refers to the costs incurred for reproducing documents or materials, which are necessary for a legal matter and are considered as an expense.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8KRPJpptKbBzyQalWni4Zv"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7KsFvVNE5x9EvtbgtiaiPd">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RboBIGLNpJANLf0bWUxJVX"/>
    <rdfs:label>Multilateral Governmental Policy Representations</rdfs:label>
    <skos:definition>Multilateral Governmental Policy Representations refer to the legal practice of representing a client's interests in multiple jurisdictions or before various international bodies simultaneously. This practice requires a comprehensive understanding of different legal systems, treaties, and international regulations to effectively advocate for the client across borders.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
