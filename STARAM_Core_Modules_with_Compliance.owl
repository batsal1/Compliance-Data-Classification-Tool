  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ROVoteNIJhmVHBMrDVSfEX">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Social Health Insurance is a healthcare system funded by contributions from employers and employees, rather than general taxation. This model is commonly found in European countries like Germany, and it generally offers a wide range of healthcare services to contributors.</skos:definition>
