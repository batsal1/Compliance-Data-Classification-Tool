  <rdf:Description rdf:about="https://folio.openlegalstandard.org/IrkUJZgjSwy0-JqlABmkYg">
    <rdfs:label>Motion Picture and Video Distribution</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=512120"/>
