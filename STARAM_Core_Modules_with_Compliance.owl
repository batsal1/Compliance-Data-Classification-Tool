    <skos:altLabel xml:lang="fr-fr">Débiteur solidaire</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">共同债务人</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संयुक्त ऋणी</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Devedor solidário</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gemeinschuldner</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">共同債務者</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Codeudor solidario</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Deudor solidario</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חייב משותף</skos:altLabel>
    <skos:definition>From U.S. Bankruptcy Court PACER</skos:definition>
    <skos:definition>Two or more debtors who are jointly liable for a single debt (e.g., cosigners on a loan)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Joint Debtor</rdfs:label>
  </rdf:Description>
