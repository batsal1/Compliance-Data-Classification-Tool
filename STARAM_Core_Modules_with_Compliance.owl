  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7dMopV2KulQjmsX11wqbG0">
    <skos:altLabel>Rules of General Jurisdiction</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Conjunto de regras ilimitado</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Ensemble de règles illimité</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">無制限ルールセット</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Unbegrenztes Regelwerk</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">无限规则集</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A set of rules that applies to all cases within a particular jurisdiction, without any limitations or exceptions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDVdjLF5bcB64xE1k3fVCV1"/>
    <rdfs:label>Unlimited Ruleset</rdfs:label>
  </rdf:Description>
