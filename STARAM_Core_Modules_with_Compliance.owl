  <rdf:Description rdf:about="https://folio.openlegalstandard.org/KBAKm1z2QOup3Md1jHUl-w">
    <skos:definition>This industry comprises establishments primarily responsible for the construction or remodeling and renovation of single-family and multifamily residential buildings.  Included in this industry are residential housing general contractors (i.e., new construction, remodeling, or renovating existing residential structures), for-sale builders and remodelers of residential structures, residential project construction management firms, and residential design-build firms.</skos:definition>
    <rdfs:label>Residential Building Construction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/-n1HB-QfSV-Eu80Lh0E1OQ"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=23611"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R84Q93fuCHiuIsUChEPJDxr">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9d2DkaIPGh2tQoNNOoEBMu"/>
    <rdfs:label>UTBMS MI00 Integration Matters</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The UTBMS MI00 Integration Matters concept refers to the specific task code used in the UTBMS Mergers and Acquisitions (M&amp;A) category for legal billing, which covers the integration of two or more entities.</skos:definition>
  </rdf:Description>
