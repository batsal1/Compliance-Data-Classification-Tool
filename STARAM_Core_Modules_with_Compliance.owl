    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#Assignability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N10aaf298995142baa2a3088eee19fec5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/R97apJidWmx520LzKBIhkc1"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#RiskFinding">
    <rdfs:subClassOf rdf:nodeID="N0ec76e214be54a72ac26ec1d2902514d"/>
    <rdfs:subClassOf rdf:nodeID="N96fecf4c13c74af58c21f8ee81eda31a"/>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#Risk"/>
    <skos:definition xml:lang="en">The observation of a risk in a specific document component of a specific contract or tender document, produced by a review activity and carrying an outcome, an allocation and (optionally) a treatment.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Risk Finding</rdfs:label>
    <skos:scopeNote xml:lang="en">A finding may record that a tested risk head is ABSENT (outcome epcx:RiskNotPresent). Negative findings are as valuable as positive ones and must not be deleted.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3">
    <skos:altLabel xml:lang="fr-fr">Négligence en cas de glissade et de chute</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">滑倒和摔倒过失</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">すべり落ちることと転倒の過失</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia por Resbalón y Caída</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्लिप-एंड-फॉल लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung bei Stolper- und Sturzunfällen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em casos de escorregão e queda</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia por Resbalón y Caída</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Slip-and-Fall Negligence</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת אחריות על נפילת החלקים</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <skos:definition>Slip-and-Fall Negligence refers to a legal claim made by an individual who has suffered a personal injury due to the negligence of a property owner or occupier in maintaining safe conditions on their premises, specifically related to slipping or falling.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Slip-and-Fall Negligence</rdfs:label>
  </rdf:Description>
