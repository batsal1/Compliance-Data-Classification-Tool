    <skos:altLabel xml:lang="de-de">Klausel zur Vorauszahlung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de pagamento antecipado</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">预付款条款</skos:altLabel>
