  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R1nnn4DzR2LNHjHoEzypXC">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7XlRtk6WMnbMZULXcg7SnI"/>
    <skos:altLabel xml:lang="fr-fr">Responsabilité conjugale</skos:altLabel>
