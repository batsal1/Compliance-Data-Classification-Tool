  <rdf:Description rdf:about="https://folio.openlegalstandard.org/h3yp63XWRAm6v120dolWng">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing nonwood office-type furniture. The furniture may be made on a stock or custom basis and may be assembled or unassembled (i.e., knockdown).</skos:definition>
    <rdfs:label>Office Furniture (except Wood) Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/iCBE0YiVTYmtAjluJBMIUQ"/>
