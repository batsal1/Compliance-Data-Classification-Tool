  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Ojq6v7E4SpeQbRtwNfAqQQ">
    <rdfs:label>Site Preparation Contractors</rdfs:label>
    <skos:example>Underground tank (except hazardous) removal</skos:example>
    <skos:example>Foundation digging (i.e., excavation)</skos:example>
    <skos:example>Excavating, earthmoving, or land clearing contractors</skos:example>
    <skos:example>Exterior demolition contractors</skos:example>
    <skos:example>Building interior gutting and stripping</skos:example>
    <skos:example>Dewatering contractors</skos:example>
    <skos:example>Cutting new rights of way</skos:example>
    <skos:example>Grading construction sites</skos:example>
    <skos:example>Concrete breaking and cutting for demolition</skos:example>
    <skos:example>Wrecking, building or other structure</skos:example>
    <skos:example>Demolition, building and structure</skos:example>
    <skos:example>Blasting, building demolition</skos:example>
    <skos:example>Equipment rental (except crane), construction, with operator</skos:example>
    <skos:example>Whole building deconstruction</skos:example>
    <skos:example>Line slashing or cutting (except maintenance)</skos:example>
    <skos:example>Foundation drilling contractors</skos:example>
    <skos:example>Dirt moving for construction</skos:example>
    <skos:example>Septic system contractors</skos:example>
    <skos:example>Trenching (except underwater)</skos:example>
    <skos:example>Interior demolition contractors</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=238910"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/c2UnWarETh2N1St2hmdz2g"/>
    <skos:definition>This industry comprises establishments primarily engaged in site preparation activities, such as excavating and grading, demolition of buildings and other structures, and septic system installation. Earthmoving and land clearing for all types of sites (e.g., building, nonbuilding, mining) is included in this industry. Establishments primarily engaged in construction equipment rental with operator (except cranes) are also included.</skos:definition>
  </rdf:Description>
