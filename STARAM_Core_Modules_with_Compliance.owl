  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8EMlmA2ZKeI9HGUOvvNUIf">
    <rdfs:label>Prevailing Party Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:altLabel xml:lang="es-es">Cláusula de Parte Prevaleciente</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">優勢当事者条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הצד המתגבר</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de la partie prévalente</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula da parte vencedora</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Parte Prevaleciente</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Prevailing Party Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विजयी पक्ष शर्त</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur obsiegenden Partei</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">胜诉方条款</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Prevailing Party Clause is a provision in a contract that specifies which party will be considered the prevailing party in the event of a dispute or litigation, and may entitle that party to recover attorney's fees and costs.</skos:definition>
  </rdf:Description>
