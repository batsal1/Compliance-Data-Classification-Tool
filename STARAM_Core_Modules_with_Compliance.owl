  <rdf:Description rdf:about="https://folio.openlegalstandard.org/AZ6MH7_nQP-NxkToJkqNnw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Copper Rolling, Drawing, Extruding, and Alloying</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/lETobmNPRDuefdYfKoquTA"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=331420"/>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) recovering copper or copper alloys from scraps; (2) alloying purchased copper; (3) rolling, drawing, or extruding shapes (e.g., bar, plate, sheet, strip, tube, wire) from purchased copper; and (4) recovering copper or copper alloys from scrap and rolling, drawing, or extruding shapes (e.g., bar, plate, sheet, strip, tube, wire).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc088be45f7794a1498e11237d52c23b1">
