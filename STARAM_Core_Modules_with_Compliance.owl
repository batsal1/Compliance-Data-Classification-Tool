    <skos:example>Drilling machines, metalworking, manufacturing</skos:example>
    <skos:example>Bending and forming machines, metalworking, manufacturing</skos:example>
    <skos:example>Buffing and polishing machines, metalworking, manufacturing</skos:example>
    <skos:example>Home workshop metal cutting machine tools (except handtools, welding equipment) manufacturing</skos:example>
    <skos:example>Metalworking lathes manufacturing</skos:example>
    <skos:example>Stamping machines, metalworking, manufacturing</skos:example>
