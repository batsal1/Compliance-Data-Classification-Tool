  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7WpnfyVtusqXzU7AwdZPO8">
    <skos:altLabel xml:lang="hi-in">विवाद में राशि - "से अधिक" के रूप में व्यक्त की गई</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סכום בסכסוך - מובא כ"חורג מ"</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Montant en litige - exprimé comme "dépassant"</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Monto en controversia - expresado como "excediendo"</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cantidad en controversia - expresada como "excediendo"</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">争议金额 - 表示为“超过”</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">争議金額 - 「超過」と表現される</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Valor da controvérsia - expresso como "excedendo"</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Streitwert - ausgedrückt als "übersteigend"</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Amount in Controversy - expressed as "exceeding"</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The minimum amount in controversy, where the actual amount in dispute exceeds that minimum. Example: U.S. federal courts deciding a state-law matter (e.g., breach of contract) require an amount of controversy exceeding a certain amount (in 2022, that amount was $75,000).</skos:definition>
    <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
    <rdfs:label>Amount in Controversy - expressed as "exceeding"</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfBdQ771UMEZMpb5zTUXAZ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/exOwWGGnTNGZ2eQ1te5MmQ">
    <skos:example>Fabric retailers</skos:example>
    <skos:example>Sewing supply retailers</skos:example>
    <skos:example>Needlecraft sewing supply retailers</skos:example>
    <skos:example>Upholstery materials retailers</skos:example>
    <skos:example>Quilting supply retailers</skos:example>
    <rdfs:label>Sewing, Needlework, and Piece Goods Retailers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/UUlsN65-Sju87tNKMbkufw"/>
    <skos:definition>This industry comprises establishments primarily engaged in retailing new sewing supplies, fabrics, patterns, yarns, and other needlework accessories or retailing these products in combination with new sewing machines.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=459130"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBxsQi6reKya95JWdAa2SRz">
    <skos:altLabel xml:lang="en-gb">Jurisdiction of Formation Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף של שטח סמכויות יצירה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गठन क्षेत्र शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">成立管辖条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de jurisdicción de formación</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de jurisdicción de formación</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de compétence de formation</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gründungszuständigkeitsklausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">設立管轄条項</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de jurisdição de formação</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Jurisdiction of Formation Clause is a provision in a contract that specifies the governing law of the agreement and the jurisdiction where any disputes arising from the contract will be resolved.</skos:definition>
    <rdfs:label>Jurisdiction of Formation Clause</rdfs:label>
  </rdf:Description>
