    <skos:altLabel xml:lang="ja-jp">特別マスター</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Maestro Especial</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Sonderbeauftragter</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מורה מיוחד</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विशेष मास्टर</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Special Master</skos:altLabel>
