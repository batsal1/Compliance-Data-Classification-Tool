  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC2MzleMJSWETgZlADcbkDy">
    <rdfs:label>375 False Claims Act (PACER NoS)</rdfs:label>
    <skos:definition>Action filed by private individuals alleging fraud against the U.S. Government under 31 U.S.C. § 3729.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="N5602914b9fcf435d959395e53ee24dab"/>
