  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RB0QemTkd6XZOLDEO42pdIw">
    <skos:altLabel>DUI</skos:altLabel>
    <skos:altLabel>Driving While Ability Impaired</skos:altLabel>
    <skos:altLabel xml:lang="ko-kr">음주운전</skos:altLabel>
    <skos:altLabel>OUI</skos:altLabel>
    <skos:altLabel>Operating While Intoxicated</skos:altLabel>
    <skos:altLabel>Drunk Driving</skos:altLabel>
    <skos:altLabel>OWI</skos:altLabel>
    <skos:altLabel>DWI</skos:altLabel>
    <skos:altLabel>Operating Under the Influence</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Conducir bajo los efectos del alcohol</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Driving Under the Influence</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Conduite en état d'ivresse</skos:altLabel>
    <skos:altLabel xml:lang="ar-sa">القيادة تحت تأثير الكحول</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Drink-Driving</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मादक पदार्थों के अधीन गाड़ी चलाना</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">酒后驾车</skos:altLabel>
    <skos:altLabel xml:lang="it-it">Guida in stato di ebbrezza</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Conducir bajo los efectos del alcohol</skos:altLabel>
    <skos:altLabel>Drink-Driving</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">飲酒運転</skos:altLabel>
    <skos:altLabel>Driving While Intoxicated</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נהיגה תחת השפעת סמים או אלכוהול</skos:altLabel>
    <skos:altLabel>DUII</skos:altLabel>
    <skos:altLabel>Impaired Driving</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahren unter Alkohol- oder Drogeneinfluss</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Dirigir sob influência de álcool ou drogas</skos:altLabel>
    <skos:altLabel>DWAI</skos:altLabel>
    <skos:altLabel>Driving Under the Influence of Intoxicants</skos:altLabel>
    <skos:altLabel xml:lang="ru-ru">Вождение в нетрезвом состоянии</skos:altLabel>
    <rdfs:label>Driving Under the Influence</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N77587c77cf67477eab94e79f02234be9"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rj1p7FbFSLxlWfUlSPZxhX"/>
    <rdfs:subClassOf rdf:nodeID="N7351edf4414f4697bdb56fd42f7e22e1"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Driving or operating a motor vehicle or common carrier while mentally or physically impaired as the result of consuming an alcoholic beverage or using a drug or narcotic.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <skos:prefLabel>DUI</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDg3svGlPQWSeM8eDKzJTSf">
    <skos:prefLabel>incursCost</skos:prefLabel>
    <skos:definition>In legal and professional contexts, "has expense" refers to the incurrence of costs or financial outlays associated with performing certain actions or fulfilling duties. This includes expenditures such as travel costs for depositions, purchasing materials for expert analysis, or other necessary expenses incurred in the course of legal representation or consultation.</skos:definition>
    <rdfs:label>hasExpense</rdfs:label>
    <rdfs:label>sali:hasExpense</rdfs:label>
    <skos:altLabel>incurs the cost</skos:altLabel>
    <skos:altLabel>has the expense</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:example>Expert has expense of purchasing exemplar product</skos:example>
    <skos:example>Lawyer has expense of flight for deposition</skos:example>
    <skos:notation>folio:hasExpense</skos:notation>
    <skos:notation>folio:incursCost</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBQsdcRJkoMX1iqIsst4xnP">
    <skos:altLabel xml:lang="en-gb">Statement of Services Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Dienstleistungserklärungen</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de déclaration de services</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הצהרת שירותים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">サービス声明条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Declaración de Servicios</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">服务声明条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सेवा विवरण शर्त</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Declaração de Serviços</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Declaración de Servicios</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Statement of Services Clause</rdfs:label>
    <skos:definition>A Statement of Services Clause is a provision in a contract that outlines the specific services that will be provided by one party to another.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RIQnXfIDi8YStyeDYkefmC">
    <rdfs:label>Equal Protection Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDr6DXAcukDYZgOiiRN8qtf"/>
    <skos:definition>An equal protection claim is a legal action initiated by an individual or group alleging that their Fourteenth Amendment right to equal protection under the law has been violated by the government or a government actor. The Equal Protection Clause of the Fourteenth Amendment prohibits the government from treating individuals or groups differently based on their race, gender, national origin, or other protected categories. An equal protection claim may arise in various contexts, such as when a government enacts a law or policy that treats certain individuals or groups unfairly or unequally, or when a government actor engages in discriminatory conduct. Examples of unequal treatment can include unequal enforcement of laws, unequal access to public services or benefits, or unequal treatment in the criminal justice system.</skos:definition>
    <skos:altLabel xml:lang="en-gb">Equal Protection Claim</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">समान अधिकार दावा</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gleichheitsschutzklage</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de proteção igualitária</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de Protección Igualitaria</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de Protección Igualitaria</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Recours en protection de l'égalité</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">平等保護請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">平等保护索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת הגנה שווה</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
