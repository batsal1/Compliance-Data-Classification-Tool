  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R795I9ybqUdayMEcSmyDrG6">
    <skos:prefLabel>Consumer Behavior Market Segment</skos:prefLabel>
    <skos:definition>A behavioral market segment is a group of consumers classified based on their behavior patterns, including their benefits sought, as well as their usage (of products or services). This segmentation relates to how groups of consumers seek out and interact with products or services.</skos:definition>
    <skos:altLabel>Usage-Based Market Segment</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UG79BtYP2uqnKNklLYXB8"/>
    <skos:note>Non-copyrightable idea and fact inspiration drawn from IAB 2.0. https://www.meaningcloud.com/developer/documentation/predefined/deep-categorization-models/iab-2-0</skos:note>
    <rdfs:label>Behavioral Market Segment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N251b2790010a4908b22e15523aa9d11b">
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://folio.openlegalstandard.org/RLNlm7nXyJQLJmk8qYnaPQ"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R6DLuG3VglXIci9EJ3MwAK">
    <skos:altLabel>Penalty</skos:altLabel>
    <skos:altLabel>Corrective Measure</skos:altLabel>
    <rdfs:label>Regulatory Penalty</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
    <rdfs:subClassOf rdf:nodeID="N268f24a291dc4485ac9fd42c659633c2"/>
    <skos:definition>A regulatory penalty refers to a fine or other punitive measure imposed by a governmental or regulatory authority for violations of laws, regulations, or guidelines. The penalty is intended to deter non-compliance and can vary in severity depending on the nature of the violation, the impact on the public, and any history of previous infractions.</skos:definition>
    <skos:definition>A regulatory penalty refers to a fine or other punitive measure imposed by a governmental, private, or regulatory authority for violations of laws, regulations, or guidelines. The penalty is intended to deter non-compliance and can vary in severity depending on the nature of the violation, the impact on the public, and any history of previous infractions.</skos:definition>
    <skos:prefLabel>Regulatory Remedy</skos:prefLabel>
    <skos:prefLabel>Sanction</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb2906b583498490b9cbc14ed43f88fbc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#RightOfFirstRefusal"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasEssentialClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/EbDRPo-YQ8CKIhEer5SY-A">
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561312"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in providing executive search, recruitment, and placement services for clients with specific executive and senior management position requirements. The range of services provided by these establishments may include developing a search strategy and position specification based on the culture and needs of the client; researching, identifying, screening, and interviewing candidates; verifying candidate qualifications; and assisting in final offer negotiations and assimilation of the selected candidate. The individuals identified, recruited, or placed are not employees of the executive search services establishments.</skos:definition>
    <rdfs:label>Executive Search Services</rdfs:label>
    <skos:example>Executive search services</skos:example>
    <skos:example>Senior executive search services</skos:example>
    <skos:example>Executive placement services</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/dsm1E4ZORBmTAUs3H2upKQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
