    <skos:altLabel xml:lang="hi-in">संक्रमण भुगतान शर्त</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Transition Payment Clause</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">移行支払い条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Pago de Transición</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de pagamento de transição</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Transition Payment Clause is a provision in a contract that outlines the terms and conditions for payment during a transitional period, typically when one party is taking over the responsibilities of another.</skos:definition>
    <rdfs:label>Transition Payment Clause</rdfs:label>
