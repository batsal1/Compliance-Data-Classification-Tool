  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RRWBaLpGSGCdJyGv2Bc1Xd">
    <skos:altLabel xml:lang="pt-br">Cláusula de recaptura de fluxo de caixa excedente</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">超额现金流收回条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">超過キャッシュフロー回収条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Excess Cash Flow Recapture Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Recuperación de Flujo de Efectivo Excedente</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अतिरिक्त नकदी धार वापसी शर्त</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף לכידת זרימת מזומנים נוספת</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de récupération de flux de trésorerie excédentaire</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Recuperación de Flujo de Efectivo Excedente</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Rückgewinnung von überschüssigem Cashflow</skos:altLabel>
    <skos:definition>A provision in a contract that allows a party to recapture excess cash flow generated by the contract and apply it towards outstanding debt or other obligations.</skos:definition>
    <rdfs:label>Excess Cash Flow Recapture Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
