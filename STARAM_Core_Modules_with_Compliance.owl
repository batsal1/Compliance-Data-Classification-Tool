    <skos:altLabel xml:lang="es-es">Presunto progenitor</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Presunto padre</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">推定父母</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">推定親</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">suposto pai/mãe</skos:altLabel>
    <skos:altLabel xml:lang="de-de">vermeintlicher Elternteil</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9EOkKjFMzLEwh7coNAwXjX"/>
    <rdfs:label>Putative Parent</rdfs:label>
    <skos:definition>An alleged parent whose legal status as a parent has not yet been resolved.</skos:definition>
  </rdf:Description>
