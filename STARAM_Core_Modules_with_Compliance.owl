  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCIcMbQuMKCvFPcrqmuH7DY">
    <skos:altLabel xml:lang="es-mx">Práctica de testimonio en juicio</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול עדות במשפט</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">审判证言实践</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de depoimento em julgamento</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique du témoignage lors d'un procès</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de testimonio en juicio</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trial Testimony Practice</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Praxis der Zeugenaussage im Prozess</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ट्रायल गवाही अभ्यास</skos:altLabel>
    <skos:altLabel>Trial Testimony</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">裁判所証言の実践</skos:altLabel>
    <skos:altLabel>Trial Testimony Service</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9dd6R73IfKyiskT5Jf62R7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Trial Testimony Practice</rdfs:label>
    <skos:definition>Trial Testimony Practice refers to the specific legal work performed by a Legal Services Provider during a trial, which involves presenting evidence and testimony to support a client's case.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7CwS6UR_Q227ikKkdhaTdQ">
    <rdfs:label>WC430 Written Motions/Submissions</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6P7wyMvVTo6CR9AJqe-HSg"/>
    <skos:prefLabel>WC430 Written Motions/Submissions</skos:prefLabel>
    <skos:definition>Developing/reviewing written motions for hearing, Preparing and responding to written motions, Arguing written motions, Review &amp; analysis of order on motion, Jurisdictional motions, Research for motions, Dispositive motions, Prepare communication with adjuster regarding analysis/summary of motion</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
