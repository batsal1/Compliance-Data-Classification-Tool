  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBu3WEhpPdjyx7OmpuyHjHI">
    <skos:altLabel xml:lang="de-de">Natürlicher Zustand</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Condição natural</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自然状態</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">État naturel</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्राकृतिक स्थिति</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מצב טבעי</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Natural Condition</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">自然状态</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Condición Natural</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Condición Natural</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCHbjppawvAlt5WcUyfjeN8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A public entity is not responsible for harm resulting from natural conditions on unimproved public property.</skos:definition>
    <rdfs:label>Natural Condition</rdfs:label>
  </rdf:Description>
