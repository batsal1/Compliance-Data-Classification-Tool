  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8MeOiBFjwad9SIbcNCHqBc">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9L7kPrkn8q0VbbyH4lv1VJ"/>
    <rdfs:subClassOf rdf:nodeID="N7e3ee04440714e89b1054876dc4932d1"/>
    <rdfs:subClassOf rdf:nodeID="N1058f627aaa546f7b3aea0cb19b0b6dc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:seeAlso>Electoral Discrimination Claims refer to allegations that specific groups of voters were unfairly treated or disadvantaged in the electoral process due to characteristics such as race, ethnicity, gender, or socioeconomic status. These claims can also involve issues such as discriminatory voter ID laws, gerrymandering, unequal access to voting facilities, or biased voter suppression tactics.</rdfs:seeAlso>
    <skos:altLabel>Voting Discrimination Allegations</skos:altLabel>
    <skos:altLabel>Discriminatory Voting Practices Claims</skos:altLabel>
    <skos:altLabel>Electoral Bias Accusations</skos:altLabel>
    <skos:altLabel>Election Inequality Complaints</skos:altLabel>
    <skos:prefLabel>Discriminatory Electoral Practices</skos:prefLabel>
    <rdfs:label>Electoral Discrimination Claims</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RXNDomJj6civMNyyCWUkz6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Part-Time Employee</rdfs:label>
    <skos:definition>A Part-Time Employee is an individual who works fewer hours per week than what is considered full-time by their employer or by labor laws. While part-time employees may have more flexible schedules, they often have limited or no access to benefits like health insurance, retirement plans, and paid time off.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBY4j5UKZ7L8gp0q9Wrxyge"/>
  </rdf:Description>
