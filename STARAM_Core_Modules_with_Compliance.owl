  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9QQLAddYiYrVZR5UngMLk3">
    <skos:altLabel xml:lang="de-de">Wettbewerbsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de concorrência</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Competencia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Competitor Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रतियोगी अनुबंध</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">竞争条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Competencia</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">競合条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הוראת מתחרים</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de concurrence</skos:altLabel>
    <skos:definition>A Competitor Clause is a provision in a contract that restricts one party from engaging in business activities that compete with the other party.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Competitor Clause</rdfs:label>
  </rdf:Description>
