    <skos:altLabel xml:lang="es-mx">Propuesta de Adquisición</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Akquisitionsvorschlag</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अधिग्रहण प्रस्ताव</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Proposition d'acquisition</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Propuesta de Adquisición</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Acquisition Proposal</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">收购提案</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Proposta de aquisição</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">買収提案</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצעת רכישה</skos:altLabel>
    <skos:definition>Acquisition Proposal Language refers to the specific terms and conditions included in a proposal for the acquisition of a company, which may trigger fiduciary exceptions, tail period fee triggers, or breakup fee triggers in a no-shop covenant.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
