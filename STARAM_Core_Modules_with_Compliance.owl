    <skos:altLabel xml:lang="es-mx">Principio de apertura</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Princípio da abertura</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खुलापन का सिद्धांत</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">开放原则</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Principio de apertura</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Offenheitsprinzip</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">オープンネスの原則</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Principe d'ouverture</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Openness Principle</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עקרון הפתיחות</skos:altLabel>
    <rdfs:label>Openness Principle</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://oecdprivacy.org/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7xYDTzzTo7YiXeLN7zeBnw"/>
    <skos:definition>Openness is the privacy principle that there should be a general policy of openness about developments, practices and policies with respect to personal data. Means should be readily available of establishing the existence and nature of personal data, and the main purposes of their use, as well as the identity and usual residence of the data controller.</skos:definition>
  </rdf:Description>
