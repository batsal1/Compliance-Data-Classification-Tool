  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Gzr9WKsdck4rRcLAqMHej">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A nuisance is a legal claim that arises from the use of one's property or conduct that interferes with another's use or enjoyment of their property, resulting in harm or annoyance.</skos:definition>
