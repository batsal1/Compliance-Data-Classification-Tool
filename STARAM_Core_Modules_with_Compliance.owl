    <skos:altLabel xml:lang="en-gb">Clergy-Penitent Privilege</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">聖職者秘密保持特権</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Secret de la confession</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Privilegio del secreto religioso</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Privilegio del secreto profesional religioso</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פרטיות הכומר-תובען</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">神职人员-忏悔者特权</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beichtgeheimnis</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Sigilo religioso</skos:altLabel>
    <skos:definition>A legal concept that protects communications made in confidence between a member of the clergy and a penitent from being disclosed in court proceedings.</skos:definition>
    <rdfs:seeAlso>Priest-Penitent Privilege</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Clergy-Penitent Privilege</rdfs:label>
  </rdf:Description>
