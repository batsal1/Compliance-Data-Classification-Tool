    <skos:altLabel xml:lang="fr-fr">Loi annulée</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">被推翻的法律</skos:altLabel>
    <rdfs:label>Overruled Law</rdfs:label>
    <skos:definition>The previously effective law has been overruled by some authority (e.g., appellate court, judge, regulator).</skos:definition>
