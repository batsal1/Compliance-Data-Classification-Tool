    <skos:altLabel xml:lang="fr-fr">Immunité et privilège</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">豁免和特权</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Inmunidad y Privilegio</skos:altLabel>
    <skos:altLabel>Immunity</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">免責特権</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Inmunidad y Privilegio</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חסינות ופריבילגיה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Immunität und Privileg</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">अवरोध और विशेषाधिकार</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Immunity and Privilege</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Imunidade e privilégio</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8mREFTbCVNHGAdqneLSd0d"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9m8Wz6rX8oJIJfhFFncV5x"/>
    <skos:definition>Immunity and Privilege refers to legal defenses that protect individuals or entities from being held liable or from having to disclose certain information in a legal proceeding. These defenses can include governmental immunity, parental immunity, and various types of privileges such as attorney-client privilege or fair and true reporting privilege.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
