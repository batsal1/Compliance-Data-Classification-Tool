    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Custodial Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Escrow, Trust &amp; Fiduciary</ns1:contractFamily>
    <skos:definition>A Custodial Agreement is a contract where a financial institution, often a bank, agrees to hold and safeguard an individual's or entity's financial assets. The custodian may also provide additional services like account administration, transaction settlements, and tax support.</skos:definition>
    <skos:prefLabel>Custody Agreement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDFmGucxTUBmP6gnVaQ7VvF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Sprache zu allgemeinen wirtschaftlichen oder finanziellen Bedingungen</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">一般经济或金融条件语言</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Lenguaje de Condiciones Económicas o Financieras Generales</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שפת מצב כלכלי או פיננסי כללי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Linguagem sobre condições econômicas ou financeiras gerais</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Lenguaje de Condiciones Económicas o Financieras Generales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">General Economic or Financial Conditions Language</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य आर्थिक या वित्तीय स्थितियों की भाषा</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Langage sur les conditions économiques ou financières générales</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">一般的な経済または金融状況の言語</skos:altLabel>
    <rdfs:label>General Economic or Financial Conditions Language</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
    <skos:definition>General Economic or Financial Conditions Language refers to a provision in a contract that outlines the impact of economic or financial conditions on the agreement, typically used as a carveout to a Material Adverse Effect definition.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8oolcgYWFGI643n9QOSy1f">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkx69t1kBP7tevuzMMsqha"/>
    <rdfs:subClassOf rdf:nodeID="N060822ce564947eebb55ffa9c7756754"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A client's postal code as defined in the LEDES98BI V5 Format Rev 1-2020 standard for electronic legal invoicing.</skos:definition>
    <rdfs:label>CLIENT_POSTCODE</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8TEDsQW7oF8wnUVzGO0eyP">
    <skos:definition>A Trust Formation Document is a legal instrument used to establish a trust, specifying the terms under which assets are held by a trustee for the benefit of beneficiaries. This document outlines the purpose of the trust, the parties involved, and the legal framework governing the trust's operations.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Nb8b0357302234c82b5e94dde0dece6ef"/>
