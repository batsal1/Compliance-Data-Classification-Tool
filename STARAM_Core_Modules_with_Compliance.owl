    <skos:altLabel xml:lang="de-de">Bestechung</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Bribery</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Corruption</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Soborno</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रिश्वत</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שחיתות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Soborno</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Suborno</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">贈賄</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">贿赂</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7V9R3w28BDjOd4lLUUrvQ5"/>
    <rdfs:subClassOf rdf:nodeID="Ne70ecdcbfdc5490792cc894514d79a6c"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The offering, giving, receiving, or soliciting of anything of value (i.e., a bribe, gratuity, or kickback) to sway the judgment or action of a person in a position of trust or influence.</skos:definition>
    <rdfs:label>Bribery</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfc12dc6322204551b7458cb1cb2e4634">
