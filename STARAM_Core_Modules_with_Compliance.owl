  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RVbr7id7xk8cwbPPGi6x1a">
    <dc:source>Fed. R. Evid. 611(c)</dc:source>
    <skos:prefLabel>Lawyer Testifying Objection</skos:prefLabel>
    <skos:altLabel>Lawyer Testifying</skos:altLabel>
    <skos:altLabel>Leading Question Objection</skos:altLabel>
    <skos:altLabel>Suggestive Question Objection</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An objection to a leading question is raised when a party in a legal proceeding believes that a question posed by the opposing counsel improperly suggests an answer to the witness. Leading questions are generally not allowed during direct examination but may be permitted during cross-examination.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7NB9WJzAFK6tIIGmfIj5Ay"/>
    <rdfs:label>Leading Objection</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCdjeyRaYgHqnJ1OOQMd6Wz">
    <skos:altLabel xml:lang="es-mx">Cláusula de no gravamen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negative Pledge Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">负面抵押条款</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Negativverpflichtungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de não-oneração</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התחייבות שלילית</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de no gravamen</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ネガティブ・プレッジ・クローズ</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नकारात्मक अधिवेशन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-cession</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <skos:definition>A Negative Pledge Clause is a provision in a contract that prohibits a party from creating any new liens or encumbrances on their assets, which could negatively affect the other party's security interest.</skos:definition>
    <rdfs:label>Negative Pledge Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/legislation#violationOf">
