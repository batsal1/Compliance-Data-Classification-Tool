    <skos:definition>Discrimination against a woman because of her pregnancy, childbirth, or related medical conditions, in violation of anti-discrimination laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Tktpdf3HuYd3nI7nf9xQU">
    <skos:note>Non-copyrightable idea and fact inspiration drawn from IAB 2.0. https://www.meaningcloud.com/developer/documentation/predefined/deep-categorization-models/iab-2-0</skos:note>
    <skos:altLabel>Interest Market Segments</skos:altLabel>
    <skos:altLabel>Consumer Interest Segments</skos:altLabel>
    <skos:definition>Psychographic market segment refers to divisions of the market that are categorized based on what consumers think about and value, as well as how they live their lives, including consumers' specific interests, preferences, and passions. This category includes consumers who share a common interest or enthusiasm for particular products, services, activities, or priorities. These segments include areas like health-conscious, tech segment, sustainability segment, and others.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Preference-Based Market Segments</skos:prefLabel>
    <rdfs:label>Psychographic Market Segment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UG79BtYP2uqnKNklLYXB8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RClWiJIjOouUllydauOfq00">
    <skos:altLabel xml:lang="es-es">Cláusula de Requisitos de Compra Mínima</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यूनतम खरीद आवश्यकता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Requisitos de Compra Mínima</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף דרישות רכישה מינימליות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Minimum Purchase Requirements Clause</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Requisitos Mínimos de Compra</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">最低购买要求条款</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">最低購入要件条項</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de conditions d'achat minimum</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu Mindestkaufanforderungen</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Minimum Purchase Requirements Clause is a provision in a contract that specifies the minimum amount of goods or services that a party must purchase from another party.</skos:definition>
    <rdfs:label>Minimum Purchase Requirements Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R87MDAJj8ZL7SprFAEqipk2">
    <skos:altLabel xml:lang="es-es">Consentimiento Informado</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">知情同意</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Informed Consent</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">インフォームド・コンセント</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Informierte Einwilligung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Consentement éclairé</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सूचित सहमति</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכמה מושכלת</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Consentimento informado</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Consentimiento Informado</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdfs:label>Informed Consent</rdfs:label>
    <skos:definition>The concept of Informed Consent refers to the legal requirement for medical professionals to fully inform patients of the risks and benefits of a medical procedure or treatment, and to obtain the patient's voluntary agreement to undergo the procedure or treatment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8i3Uwhkm25d055C4zqzxd">
    <skos:altLabel xml:lang="zh-cn">抵押非法点数和预付款费用</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऋण अधिक गैरकानूनी बिंदु और प्रीपेमेंट शुल्क वसूलता है</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Hipoteca que cobra puntos ilegales y tarifas por prepago</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Points de pénalité hypothécaire illégaux et frais de prépaiement</skos:altLabel>
    <skos:altLabel xml:lang="he-il">משכנתא המחייבת נקודות בלתי חוקיות ודמי קדם תשלום</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pontos ilegais de penalidade hipotecária e taxas de pré-pagamento</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Hipoteca que cobra puntos ilegales y tarifas por prepago</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Mortgage Exacting Illegal Points and Prepayments Fees</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hypothekarische unzulässige Punkte und Vorauszahlungsgebühren</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">住宅ローンの不正なポイントと前払い手数料</skos:altLabel>
    <rdfs:label>Mortgage Exacting Illegal Points and Prepayments Fees</rdfs:label>
    <skos:definition>The concept of Mortgage Exacting Illegal Points and Prepayments Fees refers to the practice of charging borrowers excessive fees for paying off their mortgage early or for points that were not properly disclosed, which is prohibited by law.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="Nf188207bec314060a810274ebb2f4f75"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
