  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7OsK77qJzadZwNwV39v2XX">
    <skos:altLabel xml:lang="es-mx">Reclamación de Cláusula de Ejecución Fiel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">忠実に実行された条項の請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">忠实执行条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de clause d'exécution fidèle</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de Cláusula de Ejecución Fiel</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf treue Ausführungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de execução fiel</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף ביצוע נאמן</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ईमानदारी से अंजामित शर्त दावा</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Faithfully Executed Clause Claim</skos:altLabel>
    <skos:definition>A Faithfully Executed Clause claim is a legal argument asserting that a government official, typically the President, has failed to faithfully execute the laws as required by the Faithfully Executed Clause of the United States Constitution. This claim contends that the official's actions or omissions in implementing or enforcing the laws are in violation of the constitutional duty to faithfully execute the laws, potentially rendering their actions unconstitutional or invalid.</skos:definition>
    <rdfs:label>Faithfully Executed Clause Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDdZDW8VIPVbM8gI4n7Ippf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCUIlUpsVsyQs46CyHTJLMq">
    <skos:altLabel xml:lang="ja-jp">ローカルルールセット</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Ensemble de règles locales</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">本地规则集</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Lokaler Regelungssatz</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Conjunto de regras locais</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDVdjLF5bcB64xE1k3fVCV1"/>
    <rdfs:label>Local Ruleset</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Local Ruleset is a specific set of rules that govern a particular jurisdiction or court, typically created by the court itself or a local governing body.</skos:definition>
  </rdf:Description>
