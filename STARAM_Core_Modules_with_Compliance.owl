  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7kNKsqAs0ItHwKhey9rR58">
    <skos:altLabel xml:lang="ja-jp">買い手の同意が合理的に拒否されない</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכמת הקונה לא תימנע באופן בלתי סביר</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Consentimiento del comprador no retenido de manera irrazonable</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Consentimiento del comprador no retenido de manera irrazonable</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">खरीदार की सहमति अनुचित रूप से नहीं रोकी जानी चाहिए</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Buyer Consent Not Unreasonably Withheld</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Käufer-Einwilligung nicht unangemessen verweigert</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Consentement de l'acheteur non raisonnablement refusé</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">买方同意不得不合理地拒绝</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Consentimento do comprador não razoavelmente retido</skos:altLabel>
    <skos:definition>The concept of "Buyer Consent Not Unreasonably Withheld" refers to the requirement that a buyer's consent must be obtained before a certain action can be taken, but the buyer cannot unreasonably withhold their consent.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7J7NYI0WlIIflyMEgnXHIq"/>
    <rdfs:label>Buyer Consent Not Unreasonably Withheld</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/legislation#enabledByProvision">
    <rdfs:subPropertyOf rdf:resource="https://staram.in/ontology/legislation#referencesExternalProvision"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">enabled by provision</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://staram.in/ontology/legislation#OASISLegislationStructureModule"/>
    <rdfs:comment xml:lang="en">The provision of the parent Act conferring the power under which this instrument was made ('In exercise of the powers conferred by section N').</rdfs:comment>
  </rdf:Description>
