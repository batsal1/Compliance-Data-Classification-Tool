    <skos:altLabel xml:lang="de-de">Finanzexperte</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">金融専門家</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Especialista financeiro</skos:altLabel>
