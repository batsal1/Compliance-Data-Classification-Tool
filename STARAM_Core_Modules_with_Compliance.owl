    <skos:altLabel xml:lang="pt-br">Cláusula de comissão de corretagem imobiliária</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Comisión de Bienes Raíces</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de commission immobilière</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Comisión de Bienes Raíces</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Immobilienprovision</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Real Estate Commission Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">房地产佣金条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रियल एस्टेट कमीशन क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不動産手数料条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Real Estate Commission Clause</rdfs:label>
    <skos:definition>A Real Estate Commission Clause is a provision in a contract that outlines the payment of commission to a real estate agent for their services in facilitating the sale or purchase of a property.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBuPVAcB52MFzxOD0Ov56jq">
