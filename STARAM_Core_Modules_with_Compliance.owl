  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Q58o9T-qSLugirRUxfrL8g">
    <rdfs:label>Confectionery Manufacturing from Purchased Chocolate</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in manufacturing chocolate confectioneries from chocolate produced elsewhere. Included in this industry are establishments primarily engaged in retailing chocolate confectionery products not for immediate consumption made on the premises from chocolate made elsewhere.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=311352"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/7zjy747tRHOiMTRBODSXqA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
