  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDZzBk331JIB0uRonHJ9fHu">
    <skos:altLabel xml:lang="fr-fr">Injonction permanente</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Injunction Permanente</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">永久禁令</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्थायी अवरुद्धि</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Permanent Injunction</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Dauerhafte Verfügung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">永久差止命令</skos:altLabel>
    <skos:altLabel xml:lang="he-il">צו איסור קבע</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Injunção permanente</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Injunction Permanente</skos:altLabel>
    <skos:definition>A Permanent Injunction is a court order that prohibits a party from performing a specific act or engaging in certain conduct, and remains in effect indefinitely or until modified or dissolved by the court.</skos:definition>
    <rdfs:label>Permanent Injunction</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
