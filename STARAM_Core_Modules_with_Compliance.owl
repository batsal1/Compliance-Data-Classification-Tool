  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9DDV96cDDNsUfPGDKaoOPI">
    <skos:definition>A Loss Function, also known as a Cost Function, is a mathematical function that provides a single metric to evaluate the performance of an AI model by quantifying the difference between predicted and actual values. The primary goal of training an AI system is to minimize the total loss over a set of validation examples, thereby improving the model's accuracy and effectiveness.</skos:definition>
    <rdfs:label>Loss Function</rdfs:label>
    <skos:prefLabel>Cost Function</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBHMad8oNmYXkYHOHZLCgqv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
