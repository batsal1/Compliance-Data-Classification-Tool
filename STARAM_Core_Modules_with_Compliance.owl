    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Section</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/legislation#Provision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9gfE6kHyuByZQuBx64zEoD">
    <rdfs:label>Relief from Stay Practice</rdfs:label>
    <skos:altLabel>Lift Stay</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Práctica de alivio de la suspensión</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Práctica de alivio de la suspensión</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्थगित प्रभाव से राहत अभ्यास</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">停止救济实践</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תרגול להקלה מהשהייה</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Relief from Stay Practice</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de suspensão de alívio</skos:altLabel>
    <skos:altLabel>Relief from Stay</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">停止救済手続き</skos:altLabel>
    <skos:altLabel>Relief from Stay Service</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verfahren zur Aufhebung der Aussetzung</skos:altLabel>
    <skos:altLabel>Adequate Protection Practice</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Pratique de la levée de la suspension</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <skos:definition>Relief from Stay Practice (Adequate Protection) refers to the legal practice of ensuring that a creditor's interest in property is protected during a bankruptcy proceeding, by providing adequate protection to the creditor's collateral.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N581770c166e74421903613eb358a2b0f">
