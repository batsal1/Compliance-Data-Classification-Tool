  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCwdfkXKaGBhSVTr5qr7vDy">
    <skos:altLabel xml:lang="es-es">Cláusula Anticorrupción</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">反汚職条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">भ्रष्टाचार विरोधी शर्त</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף נגד פשיעה מבוררת</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula Anticorrupción</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause anti-corruption</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Anti-Corruption Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anti-Korruptionsklausel</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反腐败条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula anticorrupção</skos:altLabel>
    <rdfs:label>Anti-Corruption Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:subClassOf rdf:nodeID="N5112c3b8cdf3491abfa488af165b7f32"/>
    <skos:definition>An Anti-Corruption Clause is a provision in a contract that prohibits bribery or other corrupt activities between the parties involved.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
