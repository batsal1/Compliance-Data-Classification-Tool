  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCju2hr8irN7bz2dHOIHI4N">
    <rdfs:isDefinedBy rdf:resource="http://docs.oasis-open.org/legalruleml/ns/v1.0/metamodel"/>
    <rdfs:comment xml:lang="en">A sequence of Deontic Specifications in which a member holds only once every member preceding it has been violated.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
