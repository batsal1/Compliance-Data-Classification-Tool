  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7J5tsgW4oZHjUWIol2tkAg">
    <skos:altLabel>Out of Status</skos:altLabel>
    <rdfs:label>Out of Immigration Status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Undocumented Status</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8N4pMIOhTNbqcmDczSephq"/>
    <skos:definition>"Out of Status" refers to the condition where an individual has violated the terms of their visa or other immigration authorization. This could involve overstaying the duration specified on their visa, working without proper authorization, or failing to maintain enrollment in a study program, among other infractions.</skos:definition>
  </rdf:Description>
