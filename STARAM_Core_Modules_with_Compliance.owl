    <skos:altLabel xml:lang="de-de">Einbruchdiebstahl</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Cambriolage</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">入室盗窃</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פריצה</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Robo con fuerza en las cosas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Burglary</skos:altLabel>
    <skos:altLabel>Breaking and Entering</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Robo con violencia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">चोरी</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Roubo qualificado</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
