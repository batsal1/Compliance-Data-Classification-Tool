  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8lqqKPmifNK2vDWzRQGbVw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Matters relating to personal property — not real property — such as damage to vehicles, ownership of valuables (e.g., jewelry), trespass to chattels, etc.</skos:definition>
    <skos:prefLabel>Personal Property Law</skos:prefLabel>
    <skos:altLabel xml:lang="he-il">חוק הקניין האישי</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Derecho de Propiedad Personal</skos:altLabel>
