  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Vo4lupZdSYNhCwK7FvjDA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCNQdoTDumXxFCbORNgfrm7"/>
    <rdfs:label>Analysis of Employee Retention</rdfs:label>
    <skos:altLabel xml:lang="en-gb">Analysis of Employee Retention</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">员工保留分析</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Análise da retenção de funcionários</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कर्मचारी रखरखाव का विश्लेषण</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">従業員の定着分析</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Análisis de la retención de empleados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Analyse de la rétention des employés</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Análisis de la retención de empleados</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ניתוח של שימור העובדים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Analyse der Mitarbeiterbindung</skos:altLabel>
    <skos:definition>Analysis of Employee Retention refers to the examination and evaluation of the factors that influence an organization's ability to retain its employees, including but not limited to compensation and benefits packages.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0b810bf46432416a8f25e57f937e184a">
