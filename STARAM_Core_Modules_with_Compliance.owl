    <skos:prefLabel xml:lang="en">Health, Safety, Environment &amp; Site Risk</skos:prefLabel>
    <skos:definition xml:lang="en">Risks on the ground, covering allocation of safety obligations, ground and utility conditions, claims from third parties and neighbouring property owners, hazardous materials, and incident reporting.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
