  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBmvJugSf1nDQYfWZmz0ffw">
    <skos:altLabel xml:lang="fr-fr">Réclamation de clause de milice</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Milizklauselanspruch</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Militia Clause Claim</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamo de la Cláusula de la Milicia</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मिलिशिया धारा दावा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת סעיף המיליציה</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">民兵条款索赔</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">民兵条項請求</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamo de la Cláusula de la Milicia</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de cláusula de milícia</skos:altLabel>
    <skos:definition>A Militia Clause claim is a legal argument asserting that a law or action violates the authority granted to Congress by the Militia Clause of the United States Constitution. This claim is based on the interpretation that the Militia Clause empowers Congress to regulate and organize the militia, and prohibits states or other entities from taking actions that infringe upon this federal authority or interfere with the proper functioning of the militia.</skos:definition>
    <rdfs:label>Militia Clause Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDkqXQLaqeFlhG4isnkHJuv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
