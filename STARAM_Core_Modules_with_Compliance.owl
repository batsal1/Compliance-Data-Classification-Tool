  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDL7pg0w01PEka8zAYFUTT9">
    <rdfs:label>Large Language Model</rdfs:label>
    <skos:prefLabel>LLM</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KxjL7VPa0Qrz5eSP9DAs3"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MAzHUZtwmTtToqN57q7V6"/>
    <skos:altLabel>Deep Learning Language Model</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Large Language Model (LLM) is a class of language models that utilize deep learning algorithms and are trained on extensive textual datasets, often spanning multiple terabytes in size. While most LLMs can generate text, some are designed to form compressed representations of inputs for tasks like classification or question answering.</skos:definition>
  </rdf:Description>
