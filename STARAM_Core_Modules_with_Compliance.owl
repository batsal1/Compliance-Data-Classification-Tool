  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBjcw4W3FA3oOwCZwvl4qX1">
    <skos:altLabel xml:lang="he-il">שגיאה רפואית בפלבוטומיה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फ्लेबोटोमी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en phlébotomie</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência em flebotomia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Phlebotomiefehler</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">采血失误</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Phlebotomy Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">採血ミスによる医療過誤</skos:altLabel>
