  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDMDwRdvGV1SmoM2o59K16g">
    <skos:altLabel xml:lang="es-mx">Declaraciones y Garantías Generales</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामान्य प्रतिनिधित्व और वारंटी</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Representações e garantias gerais</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Déclarations et garanties générales</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הצהרות ואחריות כלליות</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">General Representations and Warranties</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Allgemeine Zusicherungen und Gewährleistungen</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Declaraciones y Garantías Generales</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">一般的表明および保証</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">一般陈述和保证</skos:altLabel>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <rdfs:label>General Representations and Warranties</rdfs:label>
    <skos:definition>A General Representation and Warranty is a statement made by a party in a legal matter that asserts the truthfulness and accuracy of certain facts or conditions, without any specific limitations or exceptions, and which may be subject to a Material Adverse Effect (MAE) Qualification.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCV40j08zvRl2faFV72w9aQ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8h7iX0cG97aNHhEzak0e3U"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
