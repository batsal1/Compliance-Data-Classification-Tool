  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RJgCz3oLM22bNgWILGy0L">
    <skos:altLabel xml:lang="de-de">Kündigungsrecht bei erheblicher Beeinträchtigung des Materials</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit de résiliation en cas d'effet indépendant important sur le matériel</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Direito de rescisão em caso de efeito adverso material independente</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Standalone Material Adverse Effect Termination Right</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">独立的重大不利影响终止权</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Derecho de Terminación por Efecto Adverso Material Independiente</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">स्वतंत्र सामग्री विपरीत प्रभाव समाप्ति अधिकार</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Derecho de Terminación por Efecto Adverso Material Independiente</skos:altLabel>
    <skos:altLabel xml:lang="he-il">זכות סיום עצמאי של השפעה שלילית חומרית</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">単独の重大な不利益影響による終了権</skos:altLabel>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <skos:definition>A Standalone Material Adverse Effect (MAE) Termination Right, is a legal provision that allows a party to terminate a contract if an event or circumstance occurs that has a significant negative impact on the value or profitability of the subject matter of the contract, and this provision is not tied to any other termination rights in the contract.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UELEvq0EkRnKE9zMt5IfZ"/>
    <rdfs:label>Standalone Material Adverse Effect Termination Right</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RC8Z0Umke9n1cIFNRAmwDr2">
    <skos:altLabel xml:lang="es-mx">Negligencia del Técnico en Emergencias Médicas</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">EMT Negligence</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia del Técnico en Emergencias Médicas</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit von Rettungsdiensten</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence des services d'urgence</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">急救人员疏忽</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות של טכנאי רפואת חירום</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ईएमटी लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência de serviços de emergência</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">救急隊の過失</skos:altLabel>
    <skos:definition>EMT Negligence refers to the failure of emergency medical technicians to provide the appropriate standard of care, resulting in harm or injury to a patient, and is a specific type of claim under the broader category of Medical Negligence Claims.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Zbqfhemxs6PR7r2Fk6NeY"/>
    <rdfs:label>EMT Negligence</rdfs:label>
  </rdf:Description>
