  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8JAi8C4J0QARz3c14SHh3I">
    <skos:definition>Commercial Property Foreclosure is the legal procedure through which a lender seizes a commercial property, such as an office building or retail space, due to the borrower's failure to meet financial obligations specified in the mortgage contract. The property is then sold, usually through a public auction, to recoup the unpaid loan amount and any additional costs incurred during the foreclosure process</skos:definition>
    <rdfs:label>Commercial Property Foreclosure</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsCr2ffuxk4pqU5CQ8SAxq"/>
  </rdf:Description>
