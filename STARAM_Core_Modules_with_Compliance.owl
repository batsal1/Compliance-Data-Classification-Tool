  <rdf:Description rdf:about="https://folio.openlegalstandard.org/rJxdDS7UTfiYMYYjMy0x5A">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Corrugated and Solid Fiber Box Manufacturing</rdfs:label>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in laminating purchased paper or paperboard into corrugated or solid fiber boxes and related products, such as pads, partitions, pallets, and corrugated paper without manufacturing paperboard. These boxes are generally used for shipping.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/XmPn9qdqRNCrNlvwItWVMw"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=322211"/>
  </rdf:Description>
