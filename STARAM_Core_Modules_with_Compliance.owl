  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RILtMHLpDM8luT3w9ni6LK">
    <dc:source>Fed. R. Evid. 402</dc:source>
    <dc:source>Fed. R. Evid. 401</dc:source>
    <skos:altLabel>Unrelated Evidence Objection</skos:altLabel>
    <skos:altLabel>Irrelevant</skos:altLabel>
    <skos:altLabel>No Probative Value Objection</skos:altLabel>
    <skos:altLabel>Objection to Inapplicable Evidence</skos:altLabel>
    <skos:altLabel>Non-Pertinent Evidence Objection</skos:altLabel>
    <rdfs:label>Irrelevant Evidence Objection</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Irrelevant Evidence Objection is raised when a party in a legal proceeding believes that the evidence being presented is not related to the issues at hand or does not have any probative value. This objection aims to prevent the introduction of extraneous information that could distract or mislead the decision-maker.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9Bk5v9AAJmhb4WcgIQjy29"/>
    <skos:prefLabel>Immaterial Objection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8Bdj1eCxXbeaYx70Wt6JN5">
    <skos:altLabel xml:lang="zh-cn">具体履行条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de l'exécution en nature</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de cumprimento específico</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Cumplimiento Específico</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विशिष्ट प्रदर्शन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף ביצוע מסוים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur konkreten Erfüllung</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">具体履行条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Cumplimiento Específico</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Specific Performance Clause</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdfs:subClassOf rdf:nodeID="Nbeb3d82c6cc74804becb142f4591d732"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8gjAqC8ReYlIYAn6rs8nrm"/>
    <rdfs:label>Specific Performance Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Specific Performance Clause is a contractual provision that requires a party to fulfill their obligations under the contract as agreed upon, rather than simply paying damages for breach of contract.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nce1608ed3d9e484a9da3391b14129934">
