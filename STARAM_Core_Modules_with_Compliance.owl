    <rdfs:subClassOf rdf:nodeID="N2c472820ba7c4000ac5665a0f86f0ba3"/>
    <skos:definition>A Mortgagor is an individual or entity that borrows money to purchase property, securing the loan with the property itself as collateral. In this arrangement, the mortgagor holds ownership of the property but the lender (mortgagee) has the right to take possession if the loan is not repaid according to the agreed terms.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mortgagor</rdfs:label>
  </rdf:Description>
