  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Dq-E1E4oTVyfY32Nn33kXA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/OHRgpwVGRR2OOs9XZgkEgA"/>
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) manufacturing aircraft parts or auxiliary equipment (except engines and aircraft fluid power subassemblies) and/or (2) developing and making prototypes of aircraft parts and auxiliary equipment. Auxiliary equipment includes such items as crop dusting apparatus, armament racks, inflight refueling equipment, and external fuel tanks.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Other Aircraft Parts and Auxiliary Equipment Manufacturing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=336413"/>
  </rdf:Description>
