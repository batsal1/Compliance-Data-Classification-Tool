  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTSiUmV98XcJo4iDnUhMmb">
    <skos:altLabel xml:lang="de-de">Rechtsanwaltsfachangestellte/r</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">律师助理</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">パラリーガル</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Assistente jurídico</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פרלגל</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Asistente jurídico</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Asistente legal</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पैरालीगल</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Paralegal</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Assistant juridique</skos:altLabel>
    <skos:definition>A paralegal is a level of provider in legal services who is responsible for timekeeping and other administrative tasks, but is not a licensed attorney.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCIQtHHdQl861KZaBklud18"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCeEdzen5sS4qh0lfvncqh7"/>
    <rdfs:label>Paralegal</rdfs:label>
  </rdf:Description>
