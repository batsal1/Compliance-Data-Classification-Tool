    <skos:altLabel xml:lang="es-mx">Ley aplicable</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">適用法</skos:altLabel>
    <skos:altLabel>Applicable Law</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Lei aplicável</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Governing Law</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Droit applicable</skos:altLabel>
    <skos:altLabel xml:lang="he-il">חוקי הממשל</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">शासकीय कानून</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anwendbares Recht</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Ley aplicable</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlNFgB3TQfMzV26V4V7u4E"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBDhSx7fl9qS0ezDVJuZHX4"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R70jMZb6xYrVCXW6f3EbO1e"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDRCaFxX4hpUklgNnVS9D8C"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXSQ7cfAYqk20qAg9n2wxi"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCDwLiS22z6MzQaQHS08hvk"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Governing Law</rdfs:label>
    <skos:definition>The law that applies to a given legal matter, which may differ from the location of (1) the client and (2) the legal work being performed. This may be contractual (e.g., "governing law is Delaware") or it may be a function of law (e.g., "negligence claim is governed by Arkansas law").</skos:definition>
    <ns1:functionalCategory xml:lang="en">8. Dispute Resolution &amp; Governing Law</ns1:functionalCategory>
  </rdf:Description>
