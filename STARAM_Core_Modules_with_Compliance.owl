    <skos:altLabel>Fund Services Agreement</skos:altLabel>
    <skos:altLabel>Fund Administration Contract</skos:altLabel>
    <skos:altLabel>Investment Fund Service Agreement</skos:altLabel>
    <skos:definition>An Administration Agreement in the context of private fund administration refers to a contract where a third-party administrator is appointed to manage operational functions like accounting, reporting, and compliance for a private investment fund. This agreement delineates the scope of services, responsibilities, and fees related to the administration of the fund.</skos:definition>
    <ns1:contractFamily xml:lang="en">Investment &amp; Financial Services</ns1:contractFamily>
    <rdfs:label>Administration Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
