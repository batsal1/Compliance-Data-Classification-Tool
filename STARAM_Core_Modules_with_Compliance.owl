  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBXYIdMeIpqr2E0zR4TUIqi">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R67fwZw741EuZY3jLZhsoZ"/>
    <skos:altLabel xml:lang="ja-jp">法律言語の変更</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">法律语言变更</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cambio en el lenguaje de la ley</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Changement de la langue de la loi</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שינוי בשפת החוק</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कानून भाषा में बदलाव</skos:altLabel>
