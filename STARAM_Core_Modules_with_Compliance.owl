    <skos:altLabel xml:lang="zh-cn">观察证言</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Observação de depoimento</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">जमाने का अवलोकन</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Observing Deposition</skos:altLabel>
