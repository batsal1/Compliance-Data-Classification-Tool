  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7Nem8wZFI0MFQYNxH1VhwT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Non-Standard Contractual Terms refer to contract specifications that are variable and customized, differing from the standard predefined terms. These contracts include options traded on exchanges with non-standard delivery or expiry terms, tailored to meet specific needs and preferences of the contracting parties.</skos:definition>
    <rdfs:label>Non-Standard Contractual Terms</rdfs:label>
    <skos:altLabel>Custom Contract Terms</skos:altLabel>
    <skos:altLabel>Bespoke Contract Terms</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9g0tsF68ZfL1dvdj4jdg1t"/>
    <skos:prefLabel>Customized Financial Terms</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#NoAgencyRelationship">
    <ns1:functionalCategory xml:lang="en">9. Boilerplate / General Provisions</ns1:functionalCategory>
