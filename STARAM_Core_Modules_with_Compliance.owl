  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7KLFf3gPDu1CcoHKnJjwpQ">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R77nPY8Gvlle6KPxDEXlNkM"/>
    <rdfs:subClassOf rdf:nodeID="N25f9d4e70b6e4f39ac59f93aa425bcc2"/>
    <rdfs:label>L330 Depositions</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A deposition (L330) is a legal proceeding where a witness gives sworn testimony outside of court, typically in a lawyer's office, as part of the discovery (L300) process.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9Y223PDriaQMEOcrZ2Kgbf">
    <skos:altLabel xml:lang="zh-cn">确认条款</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף הכרה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de reconocimiento</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Acknowledgement Clause</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de reconocimiento</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de reconhecimento</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de reconnaissance</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पुष्टि अनुच्छेद</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">承認条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anerkennungsklausel</skos:altLabel>
    <rdfs:label>Acknowledgement Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Acknowledgement Clause is a provision in a contract where one party acknowledges that they have received and understood certain information or terms, but does not necessarily indicate agreement or acceptance of those terms.</skos:definition>
  </rdf:Description>
