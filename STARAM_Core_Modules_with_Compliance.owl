  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8CPYXVFY59vlr0bNv29WPm">
    <skos:altLabel xml:lang="pt-br">Definição de Efeito Adverso Material - Linguagem "Atribuível a"</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הגדרת השפעה נזיקה חומרית - שפת "ניתן להפעיל על ידי"</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">实质不利影响定义 - "可归因于"语言</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Definición de Efecto Adverso Material - Lenguaje "Atribuible a"</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Material Adverse Effect Definition - "Attributable to" Language</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सामग्री विपरीत प्रभाव परिभाषा - "जिससे संबंधित" भाषा</skos:altLabel>
    <skos:altLabel>MAE</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Définition de l'effet indésirable matériel - Langue "attribuable à"</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Definition des wesentlichen nachteiligen Auswirkungen - Sprache "zuzuschreiben"</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">重大な不利な影響の定義-「帰属する」言語</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Definición de Efecto Adverso Material - Lenguaje "Atribuible a"</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Material Adverse Effect Definition - "Attributable to" Language</rdfs:label>
    <skos:definition>A Material Adverse Effect (MAE) Definition with "Attributable to" Language refers to a clause in a contract that outlines the specific circumstances under which a party can terminate the agreement due to a significant negative change in the financial condition or business operations of the other party, which can be directly attributed to a specific event or circumstance.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RgBq3kUkMfNYtUi93XIh0i"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDf1tfWLrzvdgWUXtzXqY3f">
    <skos:altLabel xml:lang="es-es">Doctrina de la Doble Capacidad</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">二重能力原則</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Lehre der doppelten Kapazität</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dual Capacity Doctrine</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Doctrine de double capacité</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Doctrina de la Doble Capacidad</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">双重能力原则</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">द्वित्व क्षमता सिद्धांत</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Doutrina da Dupla Capacidade</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תאוריה של יכולת כפולה</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R85GQaqi3P8fuEDkEpx55YE"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9b5fs8QJuliSZYeaJLJU2t"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Dual Capacity Doctrine is a legal concept that allows an injured employee to sue their employer in a capacity other than their employer, such as a manufacturer or seller of a defective product, in addition to receiving workers' compensation benefits.</skos:definition>
    <rdfs:label>Dual Capacity Doctrine</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBTf3gToke5LaxSNQfOQASk">
    <skos:altLabel xml:lang="hi-in">अग्रिम अनुबंध उल्लंघन</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Anticipatory Breach of Contract</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento Anticipado de Contrato</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Antizipierter Vertragsbruch</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">预期违约</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">先見的な契約違反</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Violation anticipée du contrat</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Quebra antecipada de contrato</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento Anticipado de Contrato</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חוזה קדמה</skos:altLabel>
    <skos:definition>Anticipatory Breach of Contract refers to a situation where one party to a contract indicates, before the time for performance, that they will not perform their obligations under the contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RbkhZxcSyqaKNyUivxRRpu"/>
    <rdfs:label>Anticipatory Breach of Contract</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
