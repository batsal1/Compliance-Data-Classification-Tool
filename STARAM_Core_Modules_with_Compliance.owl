  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R4O64EZ9f8sZokT55KBbKr">
    <skos:altLabel xml:lang="es-es">Abogado de relaciones</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रिश्ते वकील</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Beziehungsanwalt</skos:altLabel>
    <skos:altLabel>Relationship Partner</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रिश्तों का वकील</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Abogado de relaciones</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Avocat de relation</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Advogado de relacionamento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">עו"ד יחסים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">关系律师</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">関係弁護士</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Relationship Solicitor</skos:altLabel>
    <rdfs:label>Relationship Attorney</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RadAvJ7EdvJm13pHxKGCSa"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Relationship Partner</skos:prefLabel>
    <skos:definition>A relationship attorney is a lawyer who serves as the primary point of contact and maintains an ongoing relationship with a client on behalf of a law firm. This attorney is responsible for understanding the client's needs, expectations, and preferences, and works to ensure that the firm provides consistent, high-quality legal services tailored to the client's requirements.</skos:definition>
  </rdf:Description>
