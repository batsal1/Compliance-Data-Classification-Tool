  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBN9zTYlrd1Dt84iS3QO5fp">
    <rdfs:label>Cryptocurrency Law</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCF0BMeSwppddfM6cp6AUBK"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7meQhKYGkcA57UZ7v4JOdA"/>
    <skos:prefLabel>Digital Currency Law</skos:prefLabel>
    <skos:definition>Cryptocurrency law encompasses the legal rules and regulations governing the use, creation, and exchange of digital currencies, such as Bitcoin and Ethereum. It addresses issues related to security, taxation, and compliance with financial regulations.</skos:definition>
    <skos:altLabel>Crypto Asset Law</skos:altLabel>
  </rdf:Description>
