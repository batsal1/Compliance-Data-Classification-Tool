    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="es-mx">Liquidación estructurada</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">acordo de indenização estruturada</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ストラクチャード・セトルメント</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Structured Settlement</skos:altLabel>
    <skos:altLabel xml:lang="de-de">strukturierte Abfindung</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Liquidación estructurada</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיצוי מבוסס תשלומים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">结构化和解</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">règlement structuré</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संरचित निपटान</skos:altLabel>
    <ns1:contractFamily xml:lang="en">Litigation, Settlement &amp; Release</ns1:contractFamily>
    <rdfs:label>Structured Settlement</rdfs:label>
    <skos:definition>A structured settlement is a type of settlement agreement that provides for periodic payments over time, rather than a lump sum payment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N29ab611d53dc4734960a34d7990cac90">
