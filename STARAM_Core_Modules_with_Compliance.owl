  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R71kuf7b1LuDK50KxqCndMa">
    <skos:altLabel xml:lang="fr-fr">Clause d'engagement d'emploi</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">雇用確約条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">就业承诺条款</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Employment Commitment Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">रोजगार प्रतिबद्धता शर्त</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף התחייבות לתעסוקה</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Beschäftigungszusage</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de compromisso de emprego</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de compromiso de empleo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de compromiso de empleo</skos:altLabel>
    <skos:definition>An Employment Commitment Clause is a provision in a contract that obligates one party to provide employment to the other party for a specified period of time.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Employment Commitment Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
