    <skos:altLabel xml:lang="en-gb">Covenant Not to Sue Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">दावा न करने की शर्त बंदी</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">訴訟放棄条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Renuncia a la Acción Legal</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Renuncia a la Acción Legal</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Verzichtserklärung auf Klagen</skos:altLabel>
    <rdfs:label>Covenant Not to Sue Clause</rdfs:label>
    <skos:definition>A Covenant Not to Sue Clause is a contractual provision that prohibits one or both parties from pursuing legal action against each other in relation to a specific matter.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R83ET91Sr6xHVsZJo1HwuLK">
    <skos:altLabel xml:lang="he-il">כישלון בבית המשפט הפלילי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Falta de arbitraje</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Défaut d'arbitrage</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Failure to Arbitrate</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">仲裁の失敗</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Falha em arbitrar</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Falta de arbitraje</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">未能仲裁</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एअर्बिट्रेट न करने की असफलता</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nichtdurchführung der Schiedsgerichtsbarkeit</skos:altLabel>
    <skos:definition>The Failure to Arbitrate is a legal defense that arises when a party fails to comply with an agreement to resolve a dispute through arbitration, instead choosing to pursue litigation.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzs34uEQI9f4cuWp3bQO0P"/>
    <rdfs:label>Failure to Arbitrate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/pqJmuIOvT96q9Lajk_A4xA">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) rolling, drawing, or extruding shapes (e.g., bar, plate, sheet, strip, tube) from purchased nonferrous metals and/or (2) recovering nonferrous metals from scrap and rolling, drawing, and/or extruding shapes (e.g., bar, plate, sheet, strip, tube) in integrated mills.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=331491"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/1vxa6AN8TJa3-QTPxRNiDA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Nonferrous Metal (except Copper and Aluminum) Rolling, Drawing, and Extruding</rdfs:label>
  </rdf:Description>
