    <skos:altLabel xml:lang="de-de">Fehlerhafte Abrechnung von Verbraucherkrediten</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">消費者クレジット請求エラー</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">消费者信贷账单错误</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאת חיוב לצרכן בקרדיט</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Erreur de facturation de crédit à la consommation</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">उपभोक्ता क्रेडिट बिलिंग त्रुटि</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Error de facturación de crédito al consumidor</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7KRLFkDC6ycyN3FyXivt7D"/>
    <rdfs:subClassOf rdf:nodeID="N050b236e329143c6bd7de4de39e4c164"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7n6xn6CbnvekygNrB5DsJM"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A consumer credit billing error is a mistake made by a creditor in the billing statement of a consumer, which can include incorrect charges, interest rates, or fees, and can be the basis for a legal claim under consumer credit and contract laws.</skos:definition>
    <rdfs:label>Consumer Credit Billing Error</rdfs:label>
  </rdf:Description>
