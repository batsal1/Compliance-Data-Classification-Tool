    <skos:altLabel xml:lang="es-es">Industria de Grandes Almacenes</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie des grands magasins</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">百货商店行业</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Department Store Industry</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Warenhausbranche</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">डिपार्टमेंट स्टोर उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">デパート業界</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de lojas de departamento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית חנויות מחלקה</skos:altLabel>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-RET-DEPT</ns2:legacyIdentifier>
    <skos:prefLabel>Department Store Industry</skos:prefLabel>
    <dc:identifier>IN-INDUSTRY-17.3</dc:identifier>
    <dc:identifier>RET-DEPT</dc:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:hiddenLabel>DEPT</skos:hiddenLabel>
    <skos:definition>This industry group comprises establishments known as department stores primarily engaged in retailing a wide range of the following new products with no one merchandise line predominating: apparel, furniture, appliances and home furnishings; and selected additional items, such as paint, hardware, toiletries, cosmetics, photographic equipment, jewelry, toys, and sporting goods. Merchandise lines are normally arranged in separate departments.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDfdmGR6iPi4k2t6ecIUBkP"/>
    <rdfs:label>Department Store Industry</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9JP1ZcUhPxVoXQqmTruykZ">
    <rdfs:label>Common-Law Sodomy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9uiDByr48mJfLgUdiIZrSi"/>
    <skos:altLabel xml:lang="es-es">Sodomía de Common Law</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Sodomia comum</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gemeinschaftliches Sodomie</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Sodomie en common law</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">普通法通奸罪</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कॉमन-लॉ सोडोमी</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Sodomía de Common Law</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">コモンローのアナルセックス</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סודומיה במשפט המצויין</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Common-Law Sodomy</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The act of engaging in non-procreative sexual intercourse between persons of the same sex, which is prohibited by common law.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R0jtcxWuc4uDVfIaQHGRho">
    <rdfs:label>Negligence by a Managed-Care Entity</rdfs:label>
    <skos:altLabel xml:lang="es-es">Negligencia por parte de una entidad de atención administrada</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fahrlässigkeit durch ein Managed-Care-Unternehmen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência por uma entidade de cuidados gerenciados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Negligence by a Managed-Care Entity</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia por parte de una entidad de atención administrada</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">マネージドケアエンティティによる過失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक प्रबंधित देखभाल संस्था द्वारा लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">托管护理实体的疏忽</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Négligence par une entité de gestion des soins</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת חובת זהירות על ידי ישות טיפול מנוהלת</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R82YwnDd4g8kOAQ7Ekb3bca"/>
    <skos:definition>Negligence by a Managed-Care Entity: Failure of a managed-care entity to provide appropriate medical care or treatment resulting in harm or injury to a patient, which may lead to legal action against the entity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBDNHtmUIGTUKAXvzRP70N1">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDMmocc9Ine34BK9vSksb0k"/>
    <skos:altLabel>Regulation-Compliant AI</skos:altLabel>
    <skos:altLabel>Legally Compliant AI</skos:altLabel>
    <skos:altLabel>Regulation-Conformant AI</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Lawful AI</rdfs:label>
    <skos:definition>Lawful AI refers to AI systems designed and operated in full compliance with all applicable laws and regulations. This ensures that AI systems adhere to legal standards across jurisdictions, including privacy laws, anti-discrimination statutes, data protection regulations, and industry-specific legal requirements.</skos:definition>
    <skos:prefLabel>Legally Adherent AI</skos:prefLabel>
  </rdf:Description>
