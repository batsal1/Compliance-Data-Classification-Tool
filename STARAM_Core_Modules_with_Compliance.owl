    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R79LjWBKHCdmQKEW6zPY8Co"/>
    <skos:definition>Trial Court Practice refers to the legal work performed by a Legal Services Provider in the course of a legal matter that involves presenting evidence and arguments before a judge or jury in a trial court, including procedures and rules specific to district courts.</skos:definition>
    <rdfs:label>Trial Court Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RMmqDogmlGEOTbDl6GgXyL">
