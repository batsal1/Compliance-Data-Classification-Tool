  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7K5c8d5SpTPn51L6OyMKyS">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCzvtNXIrDJF8xkmOoc6JKH"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Drug Testing Law</skos:prefLabel>
    <skos:definition>Drug Testing &amp; Substance Abuse Law refers to the legal framework governing the testing of individuals for the presence of drugs and the regulation of substance abuse. It includes policies, procedures, and regulations related to the detection, prevention, and treatment of drug use and addiction.</skos:definition>
    <rdfs:label>Substance Abuse and Drug Testing Law</rdfs:label>
    <skos:altLabel>Substance Abuse Law</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBVqeuh5Yby92R8jLO7O0M">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
