    <skos:altLabel xml:lang="de-de">Fischerei-, Jagd- und Fallenstellungsbranche</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Fishing, Hunting and Trapping Industry</skos:altLabel>
    <skos:prefLabel>Fishing, Hunting and Trapping Industry</skos:prefLabel>
    <skos:hiddenLabel>FISH</skos:hiddenLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R92xsHpdHu6BJjtepuRu"/>
    <dc:identifier>AGR-FISH</dc:identifier>
    <dc:identifier>IN-INDUSTRY-2.3</dc:identifier>
    <skos:definition>Industries in this group harvest fish and other wild animals from their natural habitats and are dependent upon a continued supply of the natural resource.</skos:definition>
