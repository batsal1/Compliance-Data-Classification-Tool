  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/4rAFZdBCRuakSvTX1CYiUw">
    <skos:definition>This U.S. industry comprises establishments primarily engaged in (1) farm raising finfish (e.g., catfish, trout, goldfish, tropical fish, minnows) and/or (2) hatching fish of any kind.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=112511"/>
