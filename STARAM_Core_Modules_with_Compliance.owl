    <rdfs:subClassOf rdf:nodeID="N87b0041b43fb4d3591d4cc290180430c"/>
    <rdfs:label>Asset Purchase Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">M&amp;A / Transactional</ns1:contractFamily>
    <rdfs:seeAlso>An Asset Purchase Agreement is a contract between a buyer and a seller that stipulates the terms and conditions for the purchase and sale of a company's assets. This can include tangible assets like equipment and inventory, as well as intangible assets like intellectual property and goodwill. The agreement details the assets to be sold, the purchase price, and the method of payment.</rdfs:seeAlso>
  </rdf:Description>
