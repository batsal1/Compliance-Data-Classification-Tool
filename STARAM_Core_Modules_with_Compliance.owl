    <skos:altLabel xml:lang="he-il">מתנות בחיים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Schenkungen unter Lebenden</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Donaciones Inter Vivos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">生前贈与</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Donaciones Inter Vivos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Donations entre vifs</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">生前赠与</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Gifts Inter Vivos: A legal term referring to gifts made during the lifetime of the donor, which are irrevocable and are not subject to probate upon the donor's death, and are often used as a means of reducing estate taxes.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R3SDQBy4KfjSgp3bgpb4Fx"/>
    <rdfs:label>Gifts Inter Vivos</rdfs:label>
  </rdf:Description>
