  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RXhRW62NYQ5imtM7qjDgH0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>HOA Foreclosure</skos:prefLabel>
    <rdfs:label>Homeowners Association Forclosure</rdfs:label>
    <skos:definition>Homeowners Association Foreclosure is the legal process by which a Homeowners Association (HOA) takes possession of a property within its jurisdiction due to the homeowner's failure to pay association fees or fines. The property is subsequently sold to satisfy the outstanding debt, and the process is governed by state laws and the HOA's governing documents.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RsCr2ffuxk4pqU5CQ8SAxq"/>
  </rdf:Description>
