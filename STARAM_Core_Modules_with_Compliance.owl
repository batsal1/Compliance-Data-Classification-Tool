    <skos:altLabel xml:lang="ja-jp">人事プログラム</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Programmes de ressources humaines</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תוכניות משאבי אנוש</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Programme für Humanressourcen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Programas de Recursos Humanos</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Programas de Recursos Humanos</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Programas de Recursos Humanos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मानव संसाधन कार्यक्रम</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Human Resource Programmes</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">人力资源计划</skos:altLabel>
    <skos:altLabel>Human Resource Programs</skos:altLabel>
    <dc:identifier>IN-INDUSTRY-15.4</dc:identifier>
    <dc:identifier>PUB-HRPG</dc:identifier>
    <skos:definition>The Administration of Human Resource Programs subsector groups government establishments primarily engaged in the administration of human resource programs.</skos:definition>
