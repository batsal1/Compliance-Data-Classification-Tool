  <rdf:Description rdf:about="https://folio.openlegalstandard.org/ZlY-ffJsRiK-ufTFdACOqg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8C21XIcxp9SGBNeg8jgUaU"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=7132"/>
    <skos:definition>This industry group comprises establishments (except casino hotels) primarily engaged in operating gambling facilities, such as casinos, bingo halls, and video gaming terminals, or in the provision of gambling services, such as lotteries and off-track betting. Casino hotels are classified in Industry 72112, Casino Hotels.</skos:definition>
    <rdfs:label>Gambling Industries</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neea5d5bc9a2c4a60bf12633dd12ed41c">
