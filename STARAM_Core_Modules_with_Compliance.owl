    <rdfs:label>Intellectual Property Purchase and Transfer Agreement</rdfs:label>
    <ns1:contractFamily xml:lang="en">Intellectual Property &amp; Licensing</ns1:contractFamily>
    <skos:prefLabel>IP Purchase and Transfer Agreement</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>An Intellectual Property Purchase and Transfer Agreement details the terms and conditions under which intellectual property rights are sold and transferred from one party to another. It establishes the sale price, rights being transferred, and any ongoing obligations or royalties.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#prevailsOver">
    <rdfs:label xml:lang="en">prevails over</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition xml:lang="en">Priority between documents or components, as fixed by a precedence rule.</skos:definition>
  </rdf:Description>
