    <skos:altLabel xml:lang="de-de">Aufgabe</skos:altLabel>
    <skos:definition>The concept of Abandonment (Divorce) refers to the act of one spouse leaving the marital home and refusing to return, which can be used as grounds for divorce.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Abandonment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDhTbfA9WACnFGtRuw8v57e"/>
  </rdf:Description>
