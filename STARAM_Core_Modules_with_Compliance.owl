  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RlZPJqPkVtqcjDMl5tqMlL">
    <skos:altLabel xml:lang="de-de">Kartellrecht - Ansprüche wegen horizontaler Preisabsprachen</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Antitruste - Reivindicações de Fixação de Preços Horizontais</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एंटीट्रस्ट - हॉरिजॉन्टल मूल्य ठेकेदारी दावे</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Antitrust - Horizontal Price Fixing Claims</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Antimonopolio - Reclamaciones de fijación de precios horizontales</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独占禁止法 - 水平価格カルテルの請求</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">反垄断 - 水平价格固定索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אנטיטרוסט - טענות קביעת מחירים אופקיות</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Antimonopolio - Reclamaciones de fijación de precios horizontales</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Antitrust - Réclamations de fixation des prix horizontale</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8oBTLovip7JQGJ9AeOmmCD"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9aw3d42PAXE6t5QYbR7Vru"/>
    <rdfs:label>Antitrust - Horizontal Price Fixing Claims</rdfs:label>
    <skos:definition>A claim made in a legal matter alleging that competitors in the same industry colluded to set prices at a certain level, in violation of antitrust laws.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R957mHhJSapbowW1nGWXSwT">
    <rdfs:label>Asset Analysis</rdfs:label>
    <skos:altLabel xml:lang="hi-in">संपत्ति विश्लेषण</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Análise de ativos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Analyse d'actifs</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Análisis de activos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vermögensanalyse</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">資産分析</skos:altLabel>
    <skos:altLabel xml:lang="he-il">ניתוח נכסים</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">资产分析</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Asset Analysis</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Análisis de activos</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7LI3BONqNkXbKHKa0t3jyI"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Asset Analysis is the process of evaluating and examining the value and condition of assets in the context of a regulatory, bankruptcy or financial restructuring matter, including asset valuation, due diligence, investigation, turnover, recovery, and financial advisory practices.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8kZH8Gb8YPAcEBZuvfA08j">
    <skos:altLabel xml:lang="hi-in">कर्फ्यू</skos:altLabel>
