    <rdfs:label>Contributory Negligence</rdfs:label>
    <skos:definition>Contributory Negligence: A legal defense that asserts that the plaintiff's own negligence contributed to their injury or damages, and therefore the defendant should not be held fully liable.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
