  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RbFgivFxOQ5aR8Vwh9-rvVw">
    <rdfs:subClassOf rdf:nodeID="N5c526c64cae6479382f2cb71b0a48846"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDGDqe9RukedToMQPIHmwJe"/>
    <rdfs:subClassOf rdf:nodeID="Nd5542eddb8284c27ad2aa2fa9591577c"/>
    <skos:prefLabel>UTBMS Trademark</skos:prefLabel>
    <rdfs:label>UTBMS Trademark</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
