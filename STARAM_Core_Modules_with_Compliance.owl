  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7JpSKT0YIcvskga9qVpMx">
    <skos:altLabel xml:lang="es-mx">Negligencia médica del especialista en enfermedades infecciosas</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">感染症専門医の過失行為</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle des spécialistes des maladies infectieuses</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאת רופא מומחה למחלות מדבקות</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">传染病专家过失行为</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Infectious Disease Specialist Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संक्रमण रोग विशेषज्ञ लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia médica del especialista en enfermedades infecciosas</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica de especialistas em doenças infecciosas</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Fehlerhaftes Verhalten von Infektionskrankheitsspezialisten</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Infectious Disease Specialist Malpractice</rdfs:label>
    <skos:definition>Negligent or wrongful conduct by a medical professional who specializes in the diagnosis and treatment of infectious diseases, resulting in harm or injury to a patient.</skos:definition>
  </rdf:Description>
