  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7pEQG8cWKZ5BacADALZylh">
    <skos:altLabel xml:lang="pt-br">Responsabilidade de associações e membros</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">団体および会員の責任</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung von Vereinen und Mitgliedschaften</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">协会和会员责任</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad de la Asociación y Membresía</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">संघ और सदस्यता दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad de la Asociación y Membresía</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Association and Membership Liability</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות האגודה וחברות</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité des associations et des membres</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Association and Membership Liability refers to the legal responsibility of individuals or entities who are members or associated with a corporation or partnership for any claims or damages arising from the actions or decisions of the organization.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <rdfs:label>Association and Membership Liability</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8qB45AsGZrsWZ5LARtrahR">
    <rdfs:label>Secured Credit Arrangement</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N55d325e7d912479f819c2cd97708f822"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
    <rdfs:subClassOf rdf:nodeID="N702190e6af1446b59e468dde1568ef7a"/>
    <rdfs:subClassOf rdf:nodeID="N24d66fa763304212bba9f9dee012aa22"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Secured Financing Arrangement</skos:altLabel>
    <skos:altLabel>Specialty Finance</skos:altLabel>
    <skos:altLabel>Collateral Backed Credit</skos:altLabel>
    <skos:altLabel>Collateralized Credit Arrangement</skos:altLabel>
    <skos:prefLabel>Secured</skos:prefLabel>
    <skos:prefLabel>Secured Loan</skos:prefLabel>
    <skos:definition>A Secured Credit Arrangement is a financial agreement where the borrower pledges assets as collateral to secure a loan. This collateral reduces the lender's risk, as they have a claim on the asset if the borrower defaults, potentially resulting in lower interest rates and more favorable loan terms for the borrower.</skos:definition>
  </rdf:Description>
