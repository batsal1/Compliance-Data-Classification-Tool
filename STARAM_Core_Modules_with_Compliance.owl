    <rdfs:label>Firm Administrator</rdfs:label>
    <skos:altLabel xml:lang="es-es">Administrador de la empresa</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公司管理员</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Administrador de escritório</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Firm Administrator</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Firmenadministrator</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फर्म प्रशासक</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">事務所管理者</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מנהל חברה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Administrador de la empresa</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Administrateur de cabinet</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Firm Administrator is a non-timekeeping provider who manages the operations and administrative tasks of a law firm.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/UR_lRSJmQCmidXs7FXJ2BA">
    <rdfs:label>Petroleum and Petroleum Products Merchant Wholesalers</rdfs:label>
    <skos:definition>This industry group comprises establishments primarily engaged in the merchant wholesale distribution of petroleum and petroleum products, including liquefied petroleum gas.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=4247"/>
