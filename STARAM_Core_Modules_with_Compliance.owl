    <skos:altLabel>Settlement</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Settlement Practice</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פעילות תיווך</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Prática de liquidação</skos:altLabel>
