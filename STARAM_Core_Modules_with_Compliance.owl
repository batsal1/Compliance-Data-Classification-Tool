  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RW86HuZD6w8Ia2M8FaBCao">
    <skos:altLabel xml:lang="he-il">אירוע מתערב - ידוע בזמן החתימה</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">介入事件 - 签署时已知</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Evento Interviniente - Conocido en la Firma</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Evento Interviniente - Conocido en la Firma</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Intervening Event - Known at Signing</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Evento Interveniente - Conhecido na assinatura</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">हस्ताक्षर के समय ज्ञात व्यवधान घटना</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Événement Intervenant - Connu lors de la signature</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Eintretendes Ereignis - Bei Vertragsabschluss bekannt</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">介入イベント - 署名時に既知</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7YcudBFwMUS1r7BcWje7Ly"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Intervening Event - Known at Signing</rdfs:label>
    <skos:definition>An Intervening Event - Known at Signing is a specific type of event that occurs after the signing of a legal agreement and has been anticipated by the parties involved.</skos:definition>
  </rdf:Description>
