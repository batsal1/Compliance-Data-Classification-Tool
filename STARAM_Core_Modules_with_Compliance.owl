    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermUnrestrictedSubsidiary"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8WcYwQ92OB86EUyI7Dp2MU">
    <skos:altLabel xml:lang="pt-br">Cláusula BBPLC</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula BBPLC</skos:altLabel>
