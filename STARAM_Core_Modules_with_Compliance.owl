  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8gEvkY3MVQnngtRihvFji6">
    <skos:altLabel xml:lang="de-de">Ausgleichende Entschädigung</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Indemnisation équitable</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">公平赔偿</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायसंगत भरपाई</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indenização equitativa</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Indemnización Equitativa</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פיצוי חוקי</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Equitable Indemnification</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公正な補償</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Indemnización Equitativa</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Equitable indemnification is a legal concept that allows a party who has paid damages to another party to seek reimbursement from a third party who is also responsible for the damages.</skos:definition>
    <dc:source rdf:resource="https://www.docketalarm.com/cases/California_State_Alameda_County_Superior_Court/23CV028370/MUSK_AN_INDIVIDUAL_vs_GREENSPAN_AN_INDIVIDUAL_et_al/35579081/"/>
    <rdfs:label>Equitable Indemnification</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RLNlm7nXyJQLJmk8qYnaPQ"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N37490f8f12b24f2e8408e6a72cdbe57b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasDefinedTerm"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#TermRestrictedPayment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBEs8X4DFr9E6Axfsdds4NG">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R4nwMYlRLa9aP9pKWIZEE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Catch-All Hearsay Exception</skos:prefLabel>
    <skos:definition>The residual hearsay exception is a legal provision that allows hearsay evidence to be admitted in court if it meets certain criteria, even if it does not fall under any other specific hearsay exception. These criteria include the statement being offered as evidence of a material fact, no other more probative evidence exists, its admission serves the interests of justice, and the offering party provides prior notice to the opposing counsel.</skos:definition>
    <dc:source>Fed. R. Evid. 807</dc:source>
    <rdfs:label>Residual Hearsay Exception</rdfs:label>
    <skos:altLabel>Discretionary Hearsay Exception</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/r-Ao21m5RV2eHmoN57h4qQ">
