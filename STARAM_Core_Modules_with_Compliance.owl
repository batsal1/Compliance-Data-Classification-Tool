  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7hEm2ZU1e25I6TtEDbo9xI">
    <skos:example>Dating Advice and Coaching</skos:example>
    <skos:example>Online Dating Platforms</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RNw3wCvXyyjEPknfOpicmf"/>
    <skos:prefLabel>Romantic Relationships Market</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dating Market Segment</rdfs:label>
    <skos:altLabel>Dating Services Market</skos:altLabel>
    <skos:definition>The dating market refers to a division of the market that is specifically targeted towards individuals who are seeking romantic relationships. This segment encompasses products and services that facilitate the process of finding and connecting with potential partners, such as dating apps, matchmaking services, and social events.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/9xzYzeBZRhCxExqFWRLZkg">
    <skos:definition>This industry comprises establishments primarily engaged in providing operating staff to perform a combination of support services within a client's facilities. Establishments in this industry typically provide a combination of services, such as janitorial, maintenance, trash disposal, guard and security, mail routing, reception, laundry, and related services to support operations within facilities. These establishments provide operating staff to carry out these support activities, but are not involved with or responsible for the core business or activities of the client. Establishments providing facilities (except computer and/or data processing) operation support services and establishments providing private jail services or operating correctional facilities (i.e., jails) on a contract or fee basis are included in this industry.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/9OG4cvlYR7OivuWaJgh3CA"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Facilities Support Services</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=561210"/>
  </rdf:Description>
