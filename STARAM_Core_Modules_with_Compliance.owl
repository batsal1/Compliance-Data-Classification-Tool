    <rdfs:label>Domestic Terrorism</rdfs:label>
    <skos:altLabel xml:lang="de-de">Inlands-Terrorismus</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Terrorismo doméstico</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Terrorisme intérieur</skos:altLabel>
