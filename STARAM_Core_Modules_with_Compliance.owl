    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RC5RK4Beoxturh6V8lBfWfZ"/>
    <skos:altLabel xml:lang="he-il">הגורדיאן</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गार्डियन</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">守护者</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Wächter</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">gardien</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Guardian</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ガーディアン</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Guardián</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">guardião</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Guardián</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy>National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods</rdfs:isDefinedBy>
    <rdfs:label>Guardian</rdfs:label>
    <skos:definition>A person appointed to assume control of and responsibility for the care of the beneficiary, the management of his or her estate, or both. 20 CFR 725.506</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RJ7P2VbioQVexfXhjLwsBI">
    <skos:altLabel>Tax Benefit</skos:altLabel>
    <rdfs:label>Tax Incentive</rdfs:label>
    <skos:prefLabel>Tax Relief Mechanism</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Tax Incentive is a provision in tax law designed to encourage specific behaviors or activities by reducing a taxpayer's tax burden. It encompasses various mechanisms such as tax credits, deductions, exemptions, and preferential rates aimed at promoting certain economic or social objectives.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDK6eFy9n1upjAdRoNbPxQd"/>
  </rdf:Description>
