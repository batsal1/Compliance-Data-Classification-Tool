  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD0uImEnupjr6UCaGQ3aTsM">
    <skos:altLabel xml:lang="zh-cn">公平转让索赔</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf gerechte Umwandlung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">न्यायसंगत रूप से रूपांतरण दावा</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעת המרה משפטית</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation de conversion équitable</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Reclamación de conversión equitativa</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Equitable Conversion Claim</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">公正な変換請求</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación de conversión equitativa</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de conversão equitativa</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBnnUGl8ihPMJL1oEIbNGBD"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RWS7oVs9s2563KGt41Lsta"/>
    <skos:definition>An Equitable Conversion Claim is a legal claim that seeks to enforce the transfer of ownership of property from the seller to the buyer, even though legal title has not yet been transferred, based on the principle of equity.</skos:definition>
    <rdfs:label>Equitable Conversion Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
