    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>In criminal justice, parole is the conditional release of an offender from incarceration, allowing them to serve the remainder of their sentence under community supervision, provided they comply with certain terms and conditions set by a parole board</skos:definition>
    <skos:altLabel>Conditional Release</skos:altLabel>
    <skos:altLabel>Conditional Sentence</skos:altLabel>
    <skos:altLabel>Community Sentence</skos:altLabel>
    <rdfs:label>Supervised Release</rdfs:label>
  </rdf:Description>
