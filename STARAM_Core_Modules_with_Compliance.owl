    <rdfs:subClassOf rdf:nodeID="N7646f17907b3430694fe87fb83f02ff2"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Rxkyjui3De88JNN2ZCqKrt"/>
    <rdfs:subClassOf rdf:nodeID="Ndff26ba106e142a998d4dc68afca91f6"/>
    <rdfs:label>Tax Return Privilege</rdfs:label>
    <skos:definition>The Tax Return Privilege is a legal protection that allows a taxpayer to keep their tax information confidential and prevents the government from compelling disclosure of that information.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Lkxx82IbQSGXZjAchWXrCw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example>Combines (i.e., harvester-threshers) manufacturing</skos:example>
    <skos:example>Milking machines manufacturing</skos:example>
    <skos:example>Poultry brooders, feeders, and waterers manufacturing</skos:example>
    <skos:example>Tractors and attachments, lawn and garden-type and farm-type, manufacturing</skos:example>
    <skos:example>Planting machines, farm-type, manufacturing</skos:example>
    <skos:example>Powered lawnmowers manufacturing</skos:example>
    <skos:example>Fertilizing machinery, farm-type, manufacturing</skos:example>
    <skos:example>Cotton ginning machinery manufacturing</skos:example>
    <skos:example>Snowblowers and throwers, residential-type, manufacturing</skos:example>
    <skos:example>Plows, farm-type, manufacturing</skos:example>
    <skos:example>Haying machines manufacturing</skos:example>
    <skos:definition>This industry comprises establishments primarily engaged in manufacturing farm machinery and equipment, powered mowing equipment, and other powered home lawn and garden equipment.</skos:definition>
    <rdfs:label>Agricultural Implement Manufacturing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/opUdJ5BOT32XYfxIls7XJQ"/>
    <rdfs:subClassOf rdf:nodeID="Nc1555c82534d417b844eb0ed70dc74d3"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=33311"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBgykmvlnXtCsXRVIBMbLrV">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB2CEA5hNfHnNl8DMKIfK5F"/>
    <skos:altLabel xml:lang="es-es">Daños no económicos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Dommages non-économiques</skos:altLabel>
    <skos:altLabel xml:lang="he-il">נזקים לא-כלכליים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">非経済的損害賠償</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">非经济性损害赔偿</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Non-economic Damages</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Danos não econômicos</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nichtwirtschaftliche Schäden</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Daños no económicos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">गैर-आर्थिक हानि</skos:altLabel>
    <skos:definition>Non-economic damages refer to compensation awarded in a legal matter for harm or loss that cannot be quantified in monetary terms, such as pain and suffering, emotional distress, disfigurement, and loss of consortium.</skos:definition>
    <rdfs:label>Non-economic Damages</rdfs:label>
  </rdf:Description>
