  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBeABy5UPz4KOLOrL1LrxFD">
    <skos:altLabel xml:lang="es-mx">Intrusión en bienes inmuebles</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Invasão de propriedade</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Trouble de voisinage</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">वास्तविक संपत्ति के लिए अतिचार</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Trespass to Real Property</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת קניין ריאלי</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Intrusión en bienes inmuebles</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">侵占不动产</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Hausfriedensbruch</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">不動産侵入</skos:altLabel>
    <skos:definition>The concept of Trespass to Real Property refers to the intentional and unauthorized entry onto someone else's land or property, causing damage or interference with the owner's right to exclusive possession.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Trespass to Real Property</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCwxVWPUdbPjn2tWtFJg6IZ"/>
  </rdf:Description>
