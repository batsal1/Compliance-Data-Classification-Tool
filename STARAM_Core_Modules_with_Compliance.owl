    <skos:example>Staples merchant wholesalers</skos:example>
    <skos:example>Power handtools (e.g., drills, saws, sanders) merchant wholesalers</skos:example>
    <skos:example>Keys and locks merchant wholesalers</skos:example>
    <skos:example>Cutlery merchant wholesalers</skos:example>
    <skos:example>Tacks merchant wholesalers</skos:example>
    <skos:example>Handtools (except motor vehicle, machinists' precision) merchant wholesalers</skos:example>
    <skos:example>Fasteners (e.g., bolts, nuts, rivets, screws) merchant wholesalers</skos:example>
    <skos:example>Hardware (except motor vehicle) merchant wholesalers</skos:example>
    <skos:example>Brads merchant wholesalers</skos:example>
    <skos:example>Knives (except disposable plastics) merchant wholesalers</skos:example>
