    <skos:altLabel xml:lang="pt-br">Cláusula de direito de preferência para locação</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de derecho de primera oferta en el arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vorkaufsrecht auf Mietvertrag-Klausel</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de droit de préemption pour la location</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Right of First Refusal to Lease Clause</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף זכות קנייה ראשונה להשכרת נכס</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃貸における最初の優先権条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">优先租赁权条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de derecho de tanteo en el arrendamiento</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लीज़ क्लॉज में पहले अधिकार वापसी</skos:altLabel>
    <rdfs:label>Right of First Refusal to Lease Clause</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8vrLOm6RKTfx8fw40CYWsh"/>
    <skos:definition>A Right of First Refusal to Lease Clause is a provision in a contract that gives a party the opportunity to lease a property before it is offered to others, if the owner decides to lease it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
