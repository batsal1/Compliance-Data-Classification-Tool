    <skos:altLabel xml:lang="pt-br">Negligência médica em dermatologia</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Dermatologie-Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">डर्मेटोलॉजी नेग्लिजेंस</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica en dermatología</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Dermatology Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">皮肤科医疗事故</skos:altLabel>
