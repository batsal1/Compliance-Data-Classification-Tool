  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCvCVeq4R5ADTlwj8c21gJE">
    <skos:altLabel xml:lang="he-il">סעיף עמיתות ביצוא</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de conformidade de exportação</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">輸出コンプライアンス条項</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">出口合规条款</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">निर्यात अनुपालन शर्त</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de conformité à l'exportation</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de cumplimiento de exportación</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de cumplimiento de exportación</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Export Compliance Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Export Compliance Klausel</skos:altLabel>
    <skos:definition>An Export Compliance Clause is a provision in a contract that requires the parties to comply with applicable laws and regulations related to the export of goods or technology.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8r3hX4cDNhyDTmzgm9BOfo"/>
