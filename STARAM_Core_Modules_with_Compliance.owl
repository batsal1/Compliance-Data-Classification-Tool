  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RuQrjxxvpOmozofPFu0LZ2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Non-Main Proceeding (Foreign Insolvency)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDbrzFzgheftqJ09xcT2ICs"/>
    <skos:definition>A non-main proceeding in foreign insolvency is an ancillary insolvency case initiated in a jurisdiction other than where the debtor's center of main interests (COMI) is located. This proceeding handles local assets and operations, complementing the main proceeding by addressing regional concerns and facilitating cooperation in cross-border insolvency cases.</skos:definition>
  </rdf:Description>
