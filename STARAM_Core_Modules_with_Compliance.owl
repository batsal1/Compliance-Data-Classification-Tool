    <skos:altLabel xml:lang="he-il">סוכן</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Agente</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एजेंट</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Agente</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Agent</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N1afd1d418ba54ead82bada15ad693354"/>
