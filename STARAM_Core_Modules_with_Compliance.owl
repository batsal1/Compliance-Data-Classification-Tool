    <skos:altLabel xml:lang="pt-br">Delitos familiares - Não violentos</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">家庭犯罪-非暴力</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Delitos Familiares - No violentos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">פשעי משפחה - לא אלים</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7MbuFEaL6NyU9tM2AXk7lk"/>
    <rdfs:label>Family Offenses - Nonviolent</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Unlawful, nonviolent acts by a family member (or legal guardian) that threaten the physical, mental, or economic well-being or morals of another family member and that are not classifiable as other offenses, such as Assault, Incest, Statutory Rape, etc.</skos:definition>
