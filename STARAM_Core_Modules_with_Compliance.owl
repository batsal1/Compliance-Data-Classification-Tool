    <rdfs:label>Fund Formation Practice</rdfs:label>
    <skos:definition>Fund Formation (Service) refers to the legal work performed by a Legal Services Provider in the process of creating a new investment fund, including the drafting of necessary documents and compliance with regulatory requirements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
