  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8aLlxwrKd3TAt3HJptCrRF">
    <skos:altLabel xml:lang="pt-br">Cláusula de rescisão por conveniência</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de résiliation pour convenance</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Terminación por Conveniencia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Termination for Convenience Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Kündigung aus Bequemlichkeitsgründen Klausel</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">都合による解除条項</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף סיום לפי נוחיות</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सुविधा के लिए समाप्ति शर्त</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Terminación por Conveniencia</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">方便终止条款</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R355Le1zLujnXiHMmYqQNM"/>
    <skos:definition>A Termination for Convenience Clause is a provision in a contract that allows one party to terminate the agreement without cause or fault of the other party.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Termination for Convenience Clause</rdfs:label>
  </rdf:Description>
