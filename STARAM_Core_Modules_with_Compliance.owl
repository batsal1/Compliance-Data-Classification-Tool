  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RByK0Dj0kmwIvSw3udQ8dXi">
    <skos:definition>The attribute "interested" refers to parties who have a stake in the proceedings, such as creditors, shareholders, or other entities that may be affected by the outcome. Interested counsel specifically denotes legal representatives advocating on behalf of these stakeholders to protect their interests during the process.</skos:definition>
    <skos:altLabel>Conflicted</skos:altLabel>
    <rdfs:label>Interested</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
