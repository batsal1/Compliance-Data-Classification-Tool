    <rdfs:label>Jaywalking Claim</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N6886cebac3c84879bc6e1c0f95608478"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <skos:definition>A Jaywalking Claim involves allegations that a pedestrian has violated traffic regulations by crossing a street outside of designated crosswalks or against traffic signals, creating potential hazards for both themselves and motorists.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Unlawful Pedestrian Crossing Claim</skos:prefLabel>
    <skos:altLabel>Pedestrian's Unauthorized Street Crossing Claim</skos:altLabel>
  </rdf:Description>
