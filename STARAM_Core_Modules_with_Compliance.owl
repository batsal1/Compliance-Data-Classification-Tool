  <rdf:Description rdf:about="https://folio.openlegalstandard.org/171e7f0a-9ca8-488e-ba61-08a4582cc30bf5b6f4c9-bc37-494f-b4de-87ef67c3d9fd">
    <rdfs:label>Claim for Payment of Bill of Exchange</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/dee4c3fe-fb17-4e56-bed7-6ae3eb6acf96982b1ad5-5b20-40c6-852d-15348064436e"/>
    <skos:definition>Holder can claim amount specified in bill along with interest and legal costs if it's dishonored.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCB958d5UmzrVotUqERG7aJ">
