  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9mE09H2zlfuEgZ7CVMrsrW">
    <rdfs:label>Client Passport Number</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RXwl9xfFnpmQn8Ex816ROD"/>
    <skos:definition>Client Passport Number refers to the unique identification number assigned to an individual's passport by the issuing government. This number is used to verify the passport's authenticity and can be required for various legal, travel, or identification purposes.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
