    <skos:altLabel xml:lang="fr-fr">Industrie de l'assistance sociale</skos:altLabel>
    <skos:hiddenLabel>SOCA</skos:hiddenLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCSG4k3ah1Pu5YgPexPgOmL"/>
    <skos:prefLabel>Social Assistance Industry</skos:prefLabel>
    <rdfs:label>Social Assistance Industry</rdfs:label>
    <dc:identifier>HTC-SOCA</dc:identifier>
    <dc:identifier>IN-INDUSTRY-9.4</dc:identifier>
    <dc:source>Integrated from add/ ontology files on 2026-07-07; add/Industry.json</dc:source>
    <ns2:legacyIdentifier>http://code.sali.org/v1/LMSS/#Ind-HTC-SOCA</ns2:legacyIdentifier>
    <skos:definition>Industries in this group provide a wide variety of social assistance services directly to their clients. These services do not include residential or accommodation services, except on a short stay basis.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
