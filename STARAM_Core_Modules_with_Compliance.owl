    <skos:altLabel xml:lang="fr-fr">Non-respect des lois sur les transactions garanties</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de las leyes de transacciones garantizadas</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Nichtbeachtung von Gesetzen über gesicherte Transaktionen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Noncompliance With Secured Transactions Laws</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">担保取引法に違反</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Não conformidade com as leis de transações garantidas</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="Ndeec820ead574e0f85a2ba3ecef7ed34"/>
    <rdfs:subClassOf rdf:nodeID="N29d52f1c34cb45248035c9214b1cc262"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBKpy2Nyht27CqaMOeeTx1N"/>
    <rdfs:subClassOf rdf:nodeID="Nb624e797d9344732ba07720e0de1f7db"/>
    <rdfs:subClassOf rdf:nodeID="Nf7ea3228883b4a2d8cc83c4b5fb16bd8"/>
    <skos:definition>Noncompliance With Secured Transactions Laws: Failure to adhere to the legal requirements governing the creation, perfection, and enforcement of security interests in personal property, as outlined in the relevant statutes and case law, which may result in the loss of priority or other rights of the secured party.</skos:definition>
    <rdfs:label>Noncompliance With Secured Transactions Laws</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
