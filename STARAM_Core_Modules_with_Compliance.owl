    <rdfs:label>Tax Matters Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">Tax</ns1:contractFamily>
    <skos:definition>A Tax Matters Agreement delineates the rights, responsibilities, and obligations of parties in relation to tax matters, particularly when companies undergo a separation or spin-off. It specifies how the entities will address shared tax liabilities, benefits, and the management of tax-related procedures post-separation.</skos:definition>
  </rdf:Description>
