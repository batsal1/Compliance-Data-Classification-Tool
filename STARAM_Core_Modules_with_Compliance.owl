  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8VN5tK4TtD0GqDw2NCbaLr">
    <skos:prefLabel>Covenantee</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="N996aaaf947fd4dfb8c18c60cc53c9c37"/>
    <rdfs:subClassOf rdf:nodeID="N50a5992b53c14c4e95ba0e9ba8fa8a08"/>
    <rdfs:subClassOf rdf:nodeID="Na4de3c24be9f4867aa8222416a0316a9"/>
    <rdfs:subClassOf rdf:nodeID="N051be225b26b493e966df7254e02fb30"/>
