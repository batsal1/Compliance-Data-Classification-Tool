  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDqst57bGParr7RufgiWyAR">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8nVhrBlasGIc7jxw1D0vbm"/>
    <skos:altLabel xml:lang="de-de">Fehlerhafte osteopathische Medizin</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Negligencia médica osteopática</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Negligência médica em osteopatia</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Osteopathic Medicine Malpractice</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">整骨医療の医療過誤</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Negligencia médica osteopática</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">骨病医学过失</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">ऑस्टियोपैथिक चिकित्सा लापरवाही</skos:altLabel>
    <skos:altLabel xml:lang="he-il">שגיאה רפואית ברפואה אוסטאופטית</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Faute professionnelle en médecine ostéopathique</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Negligent or improper treatment by an osteopathic physician that results in harm to a patient, giving rise to a legal claim for damages.</skos:definition>
    <rdfs:label>Osteopathic Medicine Malpractice</rdfs:label>
