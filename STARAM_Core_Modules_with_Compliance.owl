    <ns1:contractFamily xml:lang="en">Corporate Governance &amp; Formation</ns1:contractFamily>
    <rdfs:label>Joint Venture Agreement</rdfs:label>
    <skos:definition>A Joint Venture Agreement is a legal document that outlines the terms and conditions of a business arrangement between two or more parties who agree to pool their resources and expertise to achieve a specific goal or project. It defines the terms under which multiple parties collaborate on a specific project or business venture, delineating responsibilities, profit-sharing, and decision-making processes.</skos:definition>
    <skos:prefLabel>Joint Operating Agreement</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
