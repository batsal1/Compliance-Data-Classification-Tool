    <skos:altLabel xml:lang="de-de">Entdeckungsverfahren</skos:altLabel>
    <rdfs:label>Discovery Practice</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Discovery Practice refers to the process of obtaining evidence and information from the opposing party in a legal matter, including document collection and production, written discovery, depositions, and discovery motion practice.</skos:definition>
  </rdf:Description>
