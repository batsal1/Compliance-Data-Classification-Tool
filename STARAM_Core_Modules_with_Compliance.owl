    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#RealEstateCommission"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9BgzBqCWU5ljdmx9uyagbX">
    <skos:altLabel xml:lang="es-mx">Responsabilidad personal del agente en el contrato</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">契約上の代理人の個人的責任</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Agent’s Personal Liability on Contract</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad personal del agente en el contrato</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">代理人在合同上的个人责任</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Persönliche Haftung des Agenten für Verträge</skos:altLabel>
    <skos:altLabel xml:lang="he-il">האחריות האישית של הסוכן על החוזה</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité personnelle de l'agent sur le contrat</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade pessoal do agente no contrato</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एजेंट की व्यक्तिगत दायित्व अनुबंध पर</skos:altLabel>
    <skos:definition>The personal responsibility of an agent for fulfilling the terms of a contract, which may result in legal action against them if they fail to do so.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7wZePVWBKLVfAUwDtboutg"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RZ1dOPJ6HH6lMJGSLNxfwV"/>
    <rdfs:label>Agent’s Personal Liability on Contract</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1748586448df45929c22e28501cf5c24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://staram.in/ontology/contracts#BluePencilDoctrine"/>
    <owl:onProperty rdf:resource="https://staram.in/ontology/contracts#hasStandardClause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/Rj8YjyXQqcyq2KLPxPvZqH">
    <skos:altLabel xml:lang="he-il">סעיף הפרעת שירותים</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">サービス中断条項</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Interrupción de Servicios</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Interrupción de Servicios</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Interrupção de Serviços</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'interruption de services</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur Unterbrechung von Dienstleistungen</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Interruption of Services Clause</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">सेवा अवरुद्धि शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">服务中断条款</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Interruption of Services Clause</rdfs:label>
    <skos:definition>An Interruption of Services Clause is a provision in a contract that outlines the rights and obligations of parties in the event that services are interrupted or unavailable due to unforeseen circumstances.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9cXK0KfDcfq4Tr3Xaa0OF0">
    <skos:altLabel xml:lang="hi-in">उप प्रधानाध्यापक दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">副校長の責任</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade do vice-diretor</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad del Vicedirector</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">副校长责任</skos:altLabel>
