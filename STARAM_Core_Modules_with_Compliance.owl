  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDHOh7mNzIbwwpeSoSLcGyi">
    <skos:altLabel xml:lang="es-mx">Reclamo por caída en el piso encerado trapeado</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ワックスがかかった床で転倒した場合の請求</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Claim for Falling on Mopped Waxed Floor</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">滑倒在拖过蜡的地板上的索赔</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תביעה על נפילה על רצפת ווקס מטופחת</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Réclamation pour chute sur un sol ciré</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Reclamación por caída en el suelo encerado fregado</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">मोप्पेड वैक्स फ्लोर पर गिरने के दावे के लिए</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação por queda em piso encerado</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Anspruch auf Sturz auf gewischtem gewachstem Boden</skos:altLabel>
    <skos:definition>A claim for falling on a mopped waxed floor is a legal action brought by an individual who has suffered injury or harm as a result of slipping and falling on a floor that has been recently mopped and waxed.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R6BgoOCiXfPfFeBgDhUcP3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Claim for Falling on Mopped Waxed Floor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RD13zMDizrkliKHQU6IzISt">
