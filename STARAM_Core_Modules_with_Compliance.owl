    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="de-de">Klausel zum Schutz von proprietären Informationen</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף מידע בעלות פרטית</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Proprietary Information Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">专有信息条款</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'information propriétaire</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Informação Proprietária</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">独占情報条項</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Información Propietaria</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Información Propietaria</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">प्रोप्राइटरी जानकारी शर्त</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8UB332003aHlAfQeAxehdN"/>
    <rdfs:label>Proprietary Information Clause</rdfs:label>
    <skos:definition>A Proprietary Information Clause is a provision in a contract that outlines the confidential information that belongs to one party and cannot be shared with others without permission.</skos:definition>
  </rdf:Description>
