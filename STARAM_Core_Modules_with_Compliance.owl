    <skos:altLabel xml:lang="pt-br">Cláusula de assinaturas de contraparte</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">काउंटरपार्ट हस्ताक्षर शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">相对方签名条款</skos:altLabel>
