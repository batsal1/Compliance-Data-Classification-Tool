  <rdf:Description rdf:about="https://folio.openlegalstandard.org/BgkLwbIER0y6m6iFFQV5Vg">
    <skos:example>Automotive glass shops</skos:example>
    <skos:example>Restoration shops, antique and classic automotive</skos:example>
    <skos:example>Automotive paint shops</skos:example>
    <skos:example>Automotive body shops</skos:example>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/Q0Apwmq4R0C0PGdxFiso7Q"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing one or more of the following: (1) repairing or customizing automotive vehicle and trailer bodies and interiors; (2) painting automotive vehicle and trailer bodies; (3) replacing, repairing, and/or tinting automotive vehicle glass; and (4) customizing automobile, truck, and van interiors for the physically disabled or other customers with special requirements.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=81112"/>
    <rdfs:label>Automotive Body, Paint, Interior, and Glass Repair</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8G7CRoVdghiepPTbbQnY7e">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9O8DfnQ5nFlMiycGkJ0eDG"/>
    <rdfs:label>Citation Check Management</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Citation Check Management refers to the process of verifying the accuracy and validity of legal citations within a case or document, and ensuring that all necessary citations have been included.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBRT3WWlDa3ChxzHyS9NLC1">
    <skos:definition>A Health Care Provider is a professional or institution licensed to provide medical services, treatment, or advice to individuals seeking health care. This term encompasses a wide range of practitioners and organizations responsible for diagnosing, treating, and preventing illness, injury, and other physical and mental impairments in human beings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCEDL3kMYgjFUEOhOyGp3IE"/>
    <rdfs:label>Health Care Provider</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel>Medical Professional</skos:altLabel>
    <skos:altLabel>Healthcare Practitioner</skos:altLabel>
    <skos:altLabel>Medical Service Provider</skos:altLabel>
    <skos:prefLabel>Health Care Professional</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/QIzHBkOqTPKH967TaRYAsA">
