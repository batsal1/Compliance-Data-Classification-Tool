  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBjDj4OYq8GXdV6Oimq3Swn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Junior Credit Ranking</rdfs:label>
    <skos:prefLabel>Junior Debt Priority</skos:prefLabel>
    <skos:definition>Junior Credit Ranking refers to the priority status of junior debts, which are ranked above junior subordinated debts but below senior and senior subordinated debts in the event of liquidation. This ranking ensures that junior creditors are paid before junior subordinated creditors from the proceeds of the liquidated assets, providing them with a lower level of security compared to senior debts but higher than junior subordinated debts.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RfuC0yNDKhOWj8FHvjuYyg"/>
  </rdf:Description>
