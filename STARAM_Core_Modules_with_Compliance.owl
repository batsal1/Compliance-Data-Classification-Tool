  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCDWrRUM7m6ja3CN3N5pgyk">
    <skos:altLabel xml:lang="ja-jp">軽蔑</skos:altLabel>
