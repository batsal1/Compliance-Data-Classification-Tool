    <skos:altLabel xml:lang="he-il">ניתוח יתרות / פנסיות לעובדים</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Análisis de Beneficios/Pensiones para Empleados</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Análisis de Beneficios/Pensiones para Empleados</skos:altLabel>
