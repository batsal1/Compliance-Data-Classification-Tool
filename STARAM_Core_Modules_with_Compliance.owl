  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9wUQCNfdSnHyqxrNwDFp1t">
    <skos:definition>Binding Precedent is a legal principle established in a previous case that must be followed by all lower courts in the same jurisdiction when deciding subsequent cases with similar facts or legal issues. It is a fundamental aspect of common law legal systems and ensures consistency and predictability in the application of law.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8YpJBaF5zesoc0jtaNESdQ"/>
    <skos:prefLabel>Mandatory Authority</skos:prefLabel>
    <skos:altLabel>Compulsory Precedent</skos:altLabel>
    <rdfs:label>Binding Precedent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
