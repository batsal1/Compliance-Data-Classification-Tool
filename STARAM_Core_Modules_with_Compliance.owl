    <rdfs:label>Registration of Investment Security Transfer Denied</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Registration of Investment Security Transfer Denied" refers to the legal denial of the registration of a transfer of investment securities, which includes banking, commercial paper, and creditor claims.</skos:definition>
  </rdf:Description>
