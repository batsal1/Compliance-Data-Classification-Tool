    <skos:altLabel xml:lang="en-gb">Rescission of Reaffirmation Agreement</skos:altLabel>
    <rdfs:label>Rescission of Reaffirmation Agreement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns1:contractFamily xml:lang="en">Debt &amp; Credit</ns1:contractFamily>
    <skos:definition>The Rescission of Reaffirmation Agreement is a legal concept that refers to the cancellation or annulment of a previously agreed-upon reaffirmation of debt in a bankruptcy case.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R5NlX3MRKQ0Ispm4G4jHuT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Non-Human Authorship in copyright law pertains to works created by entities other than human beings, such as artificial intelligence or animals. This concept challenges traditional copyright frameworks by raising questions about the eligibility for protection of works created without direct human intellectual input.</skos:definition>
    <rdfs:label>Non-Human Authorship</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RlZdd14uUrCvqa8YJ7RzNd"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N806bd4eb3b8b45fc842375042ea4c24f">
