  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RTzCl6pL4nmd45HEBPCRLt">
    <skos:altLabel xml:lang="fr-fr">Violation de l'accord de non-sollicitation</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ノンソリシテーション契約違反</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הפרת הסכם אי-סוליציטציה</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Incumplimiento de Acuerdo de No Solicitación</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Verstoß gegen die Nichtwerbevereinbarung</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Violação do acordo de não solicitação</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Incumplimiento de Acuerdo de No Solicitación</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">违反禁止招揽协议</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Breach of Nonsolicitation Agreement</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नॉन-सॉलिसिटेशन समझौते का उल्लंघन</skos:altLabel>
    <skos:definition>A breach of nonsolicitation agreement occurs when a party violates the terms of a contract that prohibits them from soliciting or attempting to solicit the employees, clients, or customers of another party, typically their former employer or business partner. Nonsolicitation agreements are often included in employment contracts, partnership agreements, or business sale agreements to protect a company's relationships with its workforce and clientele.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDR8hWYIaoudg2qZmCbzto6"/>
    <rdfs:label>Breach of Nonsolicitation Agreement</rdfs:label>
  </rdf:Description>
