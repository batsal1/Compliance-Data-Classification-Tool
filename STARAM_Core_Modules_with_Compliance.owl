    <rdfs:label>Recklessness</rdfs:label>
    <skos:definition>Recklessness is a legal concept that refers to a state of mind in which a person knowingly takes an unjustifiable risk that results in harm to another person or property.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCfunX4u69LUQ3gbhckE0oI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCC6qZKk4vInl0VVZfVhnNp">
    <skos:definition>A Bus Lane Violation Claim involves allegations that a driver has unlawfully used a bus lane designated solely for buses, potentially impeding public transport efficiency and violating traffic regulations. These claims aim to uphold the integrity of public transit lanes and typically result in fines or other penalties to enforce compliance.</skos:definition>
    <skos:altLabel>Bus-Only Lane Infringement Claim</skos:altLabel>
    <skos:altLabel>Mass Transit Violation Claim</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RBuYThXwp8tJjNWkTeuFvAZ"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf"/>
    <skos:prefLabel>Mass Transit Lane Violation Claim</skos:prefLabel>
    <rdfs:label>Bus Lane Violation Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
