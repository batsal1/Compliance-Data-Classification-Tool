    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R35r4BLfUtdWKiWx1XY1z0"/>
    <rdfs:label>Enforcement of Visitation Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
