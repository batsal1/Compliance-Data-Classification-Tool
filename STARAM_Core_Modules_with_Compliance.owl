  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R7hwAY1NCRi9CAsVmPEK9jv">
    <rdfs:label>School-Based Public Benefit</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe"/>
    <skos:definition>A school-based public benefit refers to programs or services provided in educational institutions to support the well-being and education of students, particularly those from low-income backgrounds. Examples include school breakfast and lunch programs, as well as initiatives aimed at improving the educational opportunities and outcomes for disadvantaged students.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:source>From LIST: Legal Issues Taxonomy — https://taxonomy.legal/</dc:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDryUQXGgybBl5istVHwZMB">
    <skos:definition>The LINE_ITEM_TOTAL concept refers to the total amount charged for a specific line item in the LEDES98BI V5 Format Rev 1-2020 standard.</skos:definition>
