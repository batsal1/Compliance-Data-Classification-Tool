  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R95dH92zrdqxZYn7erKlwpU">
    <rdfs:label>Partnership Liability for Injury</rdfs:label>
    <skos:altLabel xml:lang="zh-cn">合伙责任侵权</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Responsabilité de la société de personnes pour blessures</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Haftung der Partnerschaft für Verletzungen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Responsabilidad de la sociedad por lesiones</skos:altLabel>
    <skos:altLabel xml:lang="he-il">אחריות שותפות עבור נזקי פגיעה</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">घोषणा द्वारा घात के लिए भागीदारी दायित्व</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">パートナーシップの責任における傷害</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Responsabilidade da parceria por lesões</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Partnership Liability for Injury</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Responsabilidad de la sociedad por lesiones</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="N19f601f80597470eb9adbc118a9ff6a8"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8alUnZrt8GVEzHYhh1KTva"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9JkfZIjkVSa5ud1tJ14w3i"/>
    <skos:definition>Partnership Liability for Injury refers to the legal responsibility of a partnership for injuries caused to a third party due to the actions or negligence of the partnership or its partners.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
