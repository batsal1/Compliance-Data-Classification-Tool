  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCKyQq2d2O4kCcP6LbXtuCz">
    <rdfs:label>Economic Rights</rdfs:label>
    <skos:definition>Economic rights refer to the entitlements that enable individuals to achieve a basic standard of living, such as the rights to work, receive a fair wage, and have access to essential social services like healthcare and education. These rights are often articulated in international treaties and may be protected to varying degrees by national laws.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R0TZk2qCI4HPwDl3e9FoOo"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCEe5Qri0q8NM6bN3THf0jy">
    <skos:altLabel xml:lang="fr-fr">Résiliation de contrat en raison d'une fête insensée</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Aufhebung des Vertrags aufgrund einer verrückten Party</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Rescisão de contrato devido a uma festa insana</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fiesta Insana Rescindiendo el Contrato</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">因疯狂派对撤销合同</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fiesta Insana Rescindiendo el Contrato</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">पागल पार्टी अनुबंध रद्द करना</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">狂気のパーティーによる契約の撤回</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Insane Party Rescinding Contract</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מסיבה משוגעת מבטלת חוזה</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Insane Party Rescinding Contract" refers to the legal action of canceling a contract by a party who was not mentally competent at the time of entering into the agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDP2t75tSvlsq1GCrOZlInL"/>
    <rdfs:label>Insane Party Rescinding Contract</rdfs:label>
  </rdf:Description>
