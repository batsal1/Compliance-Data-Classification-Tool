    <skos:altLabel xml:lang="es-mx">Convenio de no compras</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de non-shopping</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Pacto de não-compra</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">No-Shop Covenant</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">नो-शॉप कवेनेंट</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ノーショップ契約</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם איסור רכישה</skos:altLabel>
