  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R80ORqsB3X9OrCodtOAOxqr">
    <skos:altLabel xml:lang="pt-br">Cláusula de condições especiais</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">特殊条件条款</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Condiciones Especiales</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Special Conditions Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel für besondere Bedingungen</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Condiciones Especiales</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de conditions spéciales</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">特別条件条項</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विशेष शर्तें शब्दसंग्रह</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תנאים מיוחדים</skos:altLabel>
    <skos:definition>A Special Conditions Clause is a provision in a contract that outlines specific terms or requirements that are unique to that particular agreement.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Special Conditions Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBJpkCDCQzYJmN1GkuetSQ">
    <rdfs:label>Flat Antitrust Efforts Standard</rdfs:label>
    <skos:altLabel xml:lang="he-il">תקן מאמצי נגד- trust שטוחים</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Estándar de Esfuerzos Antimonopolio Planos</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">फ्लैट एंटीट्रस्ट एफर्ट्स मानक</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Estándar de Esfuerzos Antimonopolio Planos</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Padrão de esforços antitruste planos</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Norme d'efforts antitrust plats</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Flat Antitrust Efforts Standard</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">フラット反トラスト努力規格</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">平面反垄断努力标准</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Standard für flache Wettbewerbsbemühungen</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RwjUss6QZVzUsfsKBJ0kHX"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Flat Antitrust Efforts Standard is a provision within antitrust efforts that requires a company to make a consistent effort to comply with antitrust laws, without any specific benchmarks or goals to meet.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RQK2hPELdaFnrBqNkJFzWO">
    <rdfs:isDefinedBy rdf:resource="https://public.tableau.com/app/profile/the.atticus.project/viz/ABADealPointsStudy/Home"/>
    <skos:altLabel xml:lang="fr-fr">Fusion</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Zusammenschluss</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מיזוג</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Fusión</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">合并</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Fusão</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Fusión</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">合併</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">विलय</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Merger</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R7Rdvjz7Q76QLZXnSJ66z40"/>
    <skos:definition>The concept of "Merger" refers to a type of M&amp;A deal structure where two or more companies combine into a single entity, with one surviving entity and the others being absorbed.</skos:definition>
    <rdfs:label>Merger</rdfs:label>
    <dc:source>ABA M&amp;A Deal Points Study</dc:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
