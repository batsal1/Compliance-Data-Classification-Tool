  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8sf2WxI32nduJxQLmrUXTq">
    <skos:altLabel xml:lang="en-gb">Lead Plaintiff</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תובע ראשי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Autor líder</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">首席原告</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लीड प्लेंटिफ</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Leitkläger</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Demandante principal</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">リードプレインティフ</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Plaignant principal</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Demandante líder</skos:altLabel>
    <skos:definition>A plaintiff, usually among a group of plaintiffs (e.g., class action), who leads the plaintiff group.</skos:definition>
    <skos:definition>From U.S. District Court PACER</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9tyJmIM3Lx7OItGji5zPXN"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Lead Plaintiff</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBnnUGl8ihPMJL1oEIbNGBD">
    <skos:altLabel xml:lang="de-de">Umwandlungsanspruch</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">转换索赔</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Reivindicação de conversão</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">転換請求</skos:altLabel>
    <skos:altLabel>Civil Theft</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Revendication de conversion</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDqSn32zsjxExcBFzIYxT2D"/>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RHSZPHkLvnB6N4bgIo6kuX"/>
    <rdfs:label>Conversion Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Conversion Claim (Civil Theft) is a civil claim that arises when someone intentionally takes another person's property without permission, and then uses or sells it as their own.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R88qzlkGwBdq4BRktxQ0noK">
    <skos:altLabel xml:lang="es-es">Suicidio de preso</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">囚犯自杀</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">受刑者の自殺</skos:altLabel>
    <skos:altLabel xml:lang="he-il">התאבדות של אסיר</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Suicídio de prisioneiro</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">कैदी आत्महत्या</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Gefängnis-Suizid</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Suicide en prison</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Suicidio de preso</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Prisoner Suicide</skos:altLabel>
    <rdfs:label>Prisoner Suicide</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9gcJW5zpEIb8x5yJrfxBMg"/>
    <rdfs:subClassOf rdf:nodeID="N5a4e7b0cfe1b4ba1b24597f72d498903"/>
    <rdfs:subClassOf rdf:nodeID="Nf81fc437b2cb4cff8b275555946597a0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The concept of "Prisoner Suicide" refers to the act of intentionally taking one's own life by an individual who is incarcerated, and the legal claims related to the right to die in such circumstances.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R77xnTlfaItCdEEx5Ejr0ol">
    <skos:altLabel xml:lang="hi-in">विकास समझौता</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">開発契約</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Acuerdo de Desarrollo</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Acordo de desenvolvimento</skos:altLabel>
    <skos:altLabel xml:lang="he-il">הסכם פיתוח</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Development Agreement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">开发协议</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Contrato de Desarrollo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Accord de développement</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Entwicklungsvertrag</skos:altLabel>
