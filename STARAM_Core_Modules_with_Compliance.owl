  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RWfagTf41k5BuDMRrHd87x">
    <skos:altLabel xml:lang="es-es">Experto médico</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">医学专家</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">चिकित्सा विशेषज्ञ</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">医療専門家</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Medizinischer Experte</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Expert médical</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Medical Expert</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Experto médico</skos:altLabel>
    <skos:altLabel xml:lang="he-il">מומחה רפואי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Especialista médico</skos:altLabel>
    <rdfs:label>Medical Expert</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R8t7u58Bmu2hmFFto8S64nx"/>
    <rdfs:subClassOf rdf:nodeID="Nb6b7090697934965a17d341fe8fd36c0"/>
    <skos:definition>A person who holds a health care professional degree from a university or college, who has engaged in the practice of that profession, and who has knowledge or skill about the subject upon which he is called to testify or provide an opinion. See Fla. Stat. § 766.202(5); Fort Walton Beach Medical Center, Inc. v. Dingler, 697 So.2d 575 (Fla. App. 1997).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/contracts#LegallyCompelledDisclosure">
