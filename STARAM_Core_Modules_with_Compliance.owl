  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R8uVWChGsC92Bmw3gMJD9bg">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe"/>
    <skos:definition>Creativity in copyright law refers to the requirement that a work must display some level of original thought or artistic expression. It distinguishes copyrightable works from mere mechanical reproductions, ensuring protection is afforded only to creations that embody the author's intellectual effort.</skos:definition>
    <rdfs:label>Creativity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
