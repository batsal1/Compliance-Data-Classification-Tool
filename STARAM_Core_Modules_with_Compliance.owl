  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RCC7p40tc21kf22JJDdEwbC">
    <skos:prefLabel>Service Contract Act Claim</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/R9UYGSnWQz2MvNsWUofGb6J"/>
    <rdfs:label>Government Contract Labor Standards Claim</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A Government Contract Labor Standards Claim (in the U.S., a Service Contract Act claim) is a legal assertion that an employer has failed to pay prevailing wages and benefits to employees working on federal service contracts. In the U.S., those are required by the McNamara-O'Hara Service Contract Act. Such claims typically seek compensation for underpaid wages and benefits, as well as enforcement of labor standards.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/aCWANwUGTbmeMfl3j6sQlA">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/vYl5tm7YTduEPX3h-92rmQ"/>
    <rdfs:label>Electrical Contractors and Other Wiring Installation Contractors</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=23821"/>
    <skos:definition>See industry description for 238210.</skos:definition>
  </rdf:Description>
