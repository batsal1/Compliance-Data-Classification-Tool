  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RN2D91ENKaHvvID40zUJvt">
    <skos:altLabel xml:lang="es-mx">Industria de Servicios Empresariales y Administrativos</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">ビジネスおよび行政サービス産業</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Business and Administrative Services Industry</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">商业和行政服务行业</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Industrie des services aux entreprises et à l'administration</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Indústria de serviços empresariais e administrativos</skos:altLabel>
    <skos:altLabel xml:lang="he-il">תעשיית שירותי עסקים ומנהלים</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Branche für Geschäfts- und Verwaltungsdienstleistungen</skos:altLabel>
    <skos:altLabel>Business and Administrative Services</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">व्यावसायिक और प्रशासनिक सेवा उद्योग</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Industria de Servicios Empresariales y Administrativos</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The Business and Administrative Services group comprises establishments performing routine support activities for the day-to-day operations of other organizations. These essential activities are often undertaken in-house by establishments in many sectors of the economy. Activities performed include office administration, hiring and placing of personnel, document preparation and similar clerical services, solicitation, collection, security and surveillance services, cleaning, and waste disposal services.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=56"/>
    <rdfs:label>Business and Administrative Services Industry</rdfs:label>
    <skos:prefLabel>Business and Administrative Services Industry</skos:prefLabel>
    <skos:hiddenLabel>BAM</skos:hiddenLabel>
