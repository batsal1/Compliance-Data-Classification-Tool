  <rdf:Description rdf:about="https://folio.openlegalstandard.org/FU1iai9aRCiAxRE3W8mGEQ">
    <rdfs:label>Inland Water Transportation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>This industry comprises establishments primarily engaged in providing inland water transportation of passengers and/or cargo on lakes, rivers, or intracoastal waterways (except on the Great Lakes System).</skos:definition>
