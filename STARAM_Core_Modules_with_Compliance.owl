  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R74MfMU3dp9biaiPczk4vmp">
    <skos:altLabel xml:lang="hi-in">प्रीपेमेंट क्लॉज</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de prépaiement</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">预付款条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de prepago</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף תשלום מראש</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de pré-pagamento</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">前払い条項</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Prepayment Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Vorauszahlungsklausel</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de prepago</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Prepayment Clause</rdfs:label>
    <skos:definition>A prepayment clause is a provision in a contract that allows the debtor to pay off a debt before it is due without incurring a penalty.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9zWF65PbWGpFFIBMPL74Oo">
    <skos:altLabel xml:lang="he-il">סעיף מקומות ממושכים</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">लीज़ किए गए भूमि की शर्त</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">租赁物业条款</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de Locais Alugados</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de Locales Arrendados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause de locaux loués</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de Locales Arrendados</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Leased Premises Clause</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zu gemieteten Räumlichkeiten</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">賃貸物件条項</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Leased Premises Clause</rdfs:label>
    <skos:definition>A Leased Premises Clause is a provision in a contract that outlines the terms and conditions of a lease agreement for a specific property.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://staram.in/ontology/epc#DraftingDefectType">
    <rdfs:label xml:lang="en">Drafting Defect Type</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://staram.in/ontology/epc#EPCContractRiskModule"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">The failure mode in the drafting itself: omission, ambiguity, internal inconsistency, one-sided or onerous term, uncapped exposure, formality gap, cross-reference error.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
