  <rdf:Description rdf:about="https://folio.openlegalstandard.org/R9FildgjyxMM2NLx29ns403">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en-gb">Exclusive Use Clause</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">独占使用条款</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Cláusula de uso exclusivo</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Clause d'utilisation exclusive</skos:altLabel>
    <skos:altLabel xml:lang="he-il">סעיף שימוש בלעדי</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Cláusula de uso exclusivo</skos:altLabel>
    <skos:altLabel xml:lang="es-es">Cláusula de uso exclusivo</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">専有使用条項</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Klausel zur ausschließlichen Nutzung</skos:altLabel>
    <skos:altLabel xml:lang="hi-in">एक्सक्लूसिव उपयोग शर्त</skos:altLabel>
    <skos:definition>An Exclusive Use Clause is a provision in a contract that grants one party the sole right to use a particular property or asset, prohibiting others from using it for a specified period of time.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RDgEiiX23zftUP0Mggfc68n"/>
    <rdfs:label>Exclusive Use Clause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://folio.openlegalstandard.org/OzAy9YxBQruwvZ372pqxKw">
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/xAFyzx8FSfiwZX2Mmm2YaQ"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Hunting and Trapping</rdfs:label>
    <skos:definition>This industry comprises establishments primarily engaged in one or more of the following: (1) commercial hunting and trapping; (2) operating commercial game preserves, such as game retreats; and (3) operating hunting preserves.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://www.naics.com/six-digit-naics/?code=114210"/>
  </rdf:Description>
