  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RDMvlybB2Ds3VpLsrk7GpCp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>Mootness refers to a legal principle where a case is deemed irrelevant because it no longer presents an ongoing issue, or the parties involved no longer have a legally recognizable interest in the outcome. When a case becomes moot, courts generally dismiss it, as there is no longer a "live" controversy to resolve</skos:definition>
    <rdfs:label>Mootness</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/RB7BB00LuJawNLM8CZW6z7U"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbace8c084d664ef8ab42737c026537af">
