  <rdf:Description rdf:about="https://folio.openlegalstandard.org/RBQZfWGxOZnZAvQ3ghLRvae">
    <skos:altLabel xml:lang="hi-in">मोटर वाहन के भाग / सहायक उपकरणों की चोरी</skos:altLabel>
    <skos:altLabel xml:lang="es-mx">Robo de partes/accesorios de vehículos motorizados</skos:altLabel>
    <skos:altLabel xml:lang="fr-fr">Vol de pièces/accessoires de véhicules à moteur</skos:altLabel>
    <skos:altLabel xml:lang="zh-cn">机动车零部件/配件盗窃</skos:altLabel>
    <skos:altLabel xml:lang="ja-jp">自動車部品/アクセサリーの盗難</skos:altLabel>
    <skos:altLabel xml:lang="en-gb">Theft of Motor Vehicle Parts/Accessories</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Diebstahl von Kraftfahrzeugteilen/-zubehör</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Roubo de peças/acessórios de veículos automotores</skos:altLabel>
