    <skos:altLabel xml:lang="ja-jp">第三者に損害を与える契約違反の回復</skos:altLabel>
    <skos:altLabel xml:lang="de-de">Rückforderung bei Vertragsbruch, der einem Außenstehenden schadet</skos:altLabel>
    <skos:altLabel xml:lang="pt-br">Recuperação por violação contratual prejudicando terceiros</skos:altLabel>
