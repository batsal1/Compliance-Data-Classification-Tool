    <skos:prefLabel>Wellness Segment</skos:prefLabel>
    <rdfs:label>Health-Conscious Market Segment</rdfs:label>
    <skos:example>Health Supplements</skos:example>
    <skos:example>Preventive Healthcare Products</skos:example>
    <skos:example>Organic Foods</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>The health-conscious segment refers to a portion of the market that is characterized by consumers who prioritize health and wellness in their purchasing decisions. This segment includes products and services that are designed to promote physical, mental, and emotional well-being, catering to individuals who seek a healthy lifestyle.</skos:definition>
  </rdf:Description>
